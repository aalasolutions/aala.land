{{! Always rendered, so the drawer stays mounted through its leave transition. }}
<span
  hidden
  {{dialog-transition
    @open
    onOpen=this.onOpen
    onVisible=this.onVisible
    onHide=this.onHide
    onHidden=this.onHidden
    durationFrom=this.getDialogElement
  }}
></span>
{{#if this.isMounted}}
  <dialog
    class={{this.drawerClasses}}
    aria-labelledby={{if (or (has-block "header") @title) this.titleId}}
    data-test-wu-drawer
    {{did-insert this.registerDialog}}
    {{dialog
      this.isVisible
      onClose=this.onClose
      closeOnEsc=@closeOnEsc
      closeOnBackdrop=this.closeOnBackdrop
    }}
    ...attributes
  >
    {{#if (has-block "header")}}
      <header class="wu-drawer-header">
        {{yield this.titleId to="header"}}
      </header>
    {{else if @title}}
      <header class="wu-drawer-header">
        <h2 id={{this.titleId}} class="wu-drawer-title" data-test-wu-drawer-title>
          {{@title}}
        </h2>
        <button
          type="button"
          class="wu-drawer-close"
          aria-label="Close"
          data-test-wu-drawer-close
          {{on "click" this.onClose}}
        ></button>
      </header>
    {{/if}}

    <div class="wu-drawer-body" data-test-wu-drawer-body>
      {{#if (has-block "body")}}
        {{yield to="body"}}
      {{else}}
        {{yield}}
      {{/if}}
    </div>

    {{#if (has-block "footer")}}
      <footer class="wu-drawer-footer" data-test-wu-drawer-footer>
        {{yield to="footer"}}
      </footer>
    {{/if}}

    {{! Menus and tooltips opened inside the dialog render here; outside it they would be inert. }}
    <div class="wu-layer"></div>
  </dialog>
{{/if}}
