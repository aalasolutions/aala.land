{{#if @open}}
  <dialog
    class={{this.modalClasses}}
    aria-labelledby={{if (or (has-block "header") @title) this.titleId}}
    data-test-wu-modal
    {{dialog
      true
      onClose=this.onClose
      closeOnEsc=@closeOnEsc
      closeOnBackdrop=this.closeOnBackdrop
    }}
    ...attributes
  >
    {{#if (has-block "header")}}
      <header class="wu-modal-header">
        {{yield this.titleId to="header"}}
      </header>
    {{else if @title}}
      <header class="wu-modal-header">
        <div class="flex col gap-1 min-w-0">
          <h2 id={{this.titleId}} class="wu-modal-title" data-test-wu-modal-title>
            {{@title}}
          </h2>
          {{#if @subtitle}}
            <Woven::Text
              @text={{@subtitle}}
              @size="sm"
              @muted={{true}}
              data-test-wu-modal-subtitle
            />
          {{/if}}
        </div>
        {{#if this.showClose}}
          <button
            type="button"
            class="wu-modal-close"
            aria-label="Close"
            data-test-wu-modal-close
            {{on "click" this.onClose}}
          ></button>
        {{/if}}
      </header>
    {{/if}}

    <div class="wu-modal-body" data-test-wu-modal-body>
      {{#if (has-block "body")}}
        {{yield to="body"}}
      {{else}}
        {{yield}}
      {{/if}}
    </div>

    {{#if (has-block "footer")}}
      <footer class="wu-modal-footer" data-test-wu-modal-footer>
        {{yield to="footer"}}
      </footer>
    {{/if}}

    {{! Menus and tooltips opened inside the dialog render here; outside it they would be inert. }}
    <div class="wu-layer"></div>
  </dialog>
{{/if}}
