<li
  class={{this.classes}}
  aria-current={{if @active "step"}}
  data-test-wu-timeline-item
  ...attributes
>
  {{#if (or @title (has-block "icon"))}}
    <p class="wu-timeline-title" data-test-wu-timeline-title>
      {{#if (has-block "icon")}}
        <span aria-hidden="true">{{yield to="icon"}}</span>
      {{/if}}
      {{@title}}
    </p>
  {{/if}}

  {{#if @timestamp}}
    <span class="wu-timeline-time" data-test-wu-timeline-timestamp>{{@timestamp}}</span>
  {{/if}}

  {{#if (has-block)}}
    {{yield}}
  {{else if @description}}
    <p class="wu-timeline-text" data-test-wu-timeline-description>{{@description}}</p>
  {{/if}}

  {{#if @meta}}
    <span class="wu-timeline-time" data-test-wu-timeline-meta>{{@meta}}</span>
  {{/if}}
</li>
