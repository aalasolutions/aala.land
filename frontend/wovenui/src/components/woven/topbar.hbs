{{! The toggle shows below md only, where the sidebar is off-canvas. }}
<header class={{if @sticky "wu-topbar pinned" "wu-topbar"}} data-test-wu-topbar ...attributes>
  {{#if @onToggle}}
    <button
      type="button"
      class="wu-btn quiet icon hidden@md"
      aria-label="Toggle navigation"
      data-test-wu-topbar-toggle
      {{on "click" this.toggle}}
    >☰</button>
  {{/if}}

  {{#if (has-block "brand")}}
    <div class="wu-topbar-brand">{{yield to="brand"}}</div>
  {{else if @brand}}
    <span class="wu-topbar-brand">{{@brand}}</span>
  {{/if}}

  {{yield to="search"}}

  <div class="wu-topbar-end">
    {{yield to="actions"}}

    {{#if (has-block "user")}}
      <hr class="wu-divider" aria-orientation="vertical" />
      <div class="flex x-center gap-2">{{yield to="user"}}</div>
    {{else if @userName}}
      <hr class="wu-divider" aria-orientation="vertical" />
      <span class="flex col">
        <span class="text-sm">{{@userName}}</span>
        {{#if @userRole}}
          <span class="text-sm text-muted">{{@userRole}}</span>
        {{/if}}
      </span>
    {{/if}}
  </div>
</header>
