<button
  type="button"
  class={{this.classes}}
  data-test-wu-sidebar-link
  {{on "click" this.onClick}}
  ...attributes
>
  {{#if @icon}}
    <span class="wu-sidebar__link-icon" aria-hidden="true">{{@icon}}</span>
  {{/if}}
  <span class="wu-sidebar__link-label">
    {{#if (has-block)}}{{yield}}{{else}}{{@label}}{{/if}}
  </span>
</button>
