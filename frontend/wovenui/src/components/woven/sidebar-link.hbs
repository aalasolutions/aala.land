{{! A button row for an action; route links are LinkTo with class wu-sidebar-link and aria-current. }}
<button
  type="button"
  class="wu-sidebar-link"
  aria-current={{if @active "page"}}
  data-test-wu-sidebar-link
  {{on "click" this.onClick}}
  ...attributes
>
  {{#if @icon}}
    <span aria-hidden="true">{{@icon}}</span>
  {{/if}}
  <span class="wu-sidebar-label">
    {{#if (has-block)}}{{yield}}{{else}}{{@label}}{{/if}}
  </span>
</button>
