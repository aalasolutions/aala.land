{{! Shared body for the div, anchor and LinkTo branches of Woven::Stat. The kit stat has no icon or content part, so those carry no kit class. }}
{{#if @hasIconBlock}}
  <span aria-hidden="true" data-test-wu-stat-icon>
    {{yield to="icon"}}
  </span>
{{else if @icon}}
  <span aria-hidden="true" data-test-wu-stat-icon>
    {{@icon}}
  </span>
{{/if}}

{{#if @label}}
  <span class="wu-stat-label" data-test-wu-stat-label>{{@label}}</span>
{{/if}}

<span class="wu-stat-value" data-test-wu-stat-value>{{@value}}</span>

{{#if @delta}}
  <span class={{@deltaClass}} data-test-wu-stat-delta>{{@delta}}</span>
{{/if}}

{{#if @hasContentBlock}}
  <div data-test-wu-stat-content>
    {{yield to="content"}}
  </div>
{{/if}}
