<div class={{this.classes}} data-test-wu-input-group ...attributes>
  {{#if this.hasPrepend}}
    <span class="wu-input-group__addon" data-test-wu-input-group-prepend>
      {{@prepend}}
    </span>
  {{/if}}

  {{yield}}

  {{#if this.hasAppend}}
    <span class="wu-input-group__addon" data-test-wu-input-group-append>
      {{@append}}
    </span>
  {{/if}}
</div>
