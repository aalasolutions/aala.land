{{#if this.hasMultipleLines}}
  <div aria-hidden="true" data-test-wu-skeleton-group ...attributes>
    {{#each this.lineItems as |entry|}}
      <div class="wu-skeleton text animated" data-test-wu-skeleton></div>
    {{/each}}
  </div>
{{else}}
  <div
    class={{this.classes}}
    style={{this.style}}
    aria-hidden="true"
    data-test-wu-skeleton
    ...attributes
  ></div>
{{/if}}
