<label class={{this.classes}} data-test-wu-toggle ...attributes>
  <input
    type="checkbox"
    class={{this.inputClasses}}
    checked={{@checked}}
    disabled={{@disabled}}
    aria-invalid={{if this.isInvalid "true"}}
    aria-describedby={{@describedBy}}
    aria-required={{if @required "true"}}
    data-test-wu-toggle-input
    {{on "change" this.handleChange}}
  />
  <span class="wu-toggle__track">
    <span class="wu-toggle__knob"></span>
    {{#if @activeText}}
      <span class="wu-toggle__active-text">{{@activeText}}</span>
    {{/if}}
    {{#if @inactiveText}}
      <span class="wu-toggle__inactive-text">{{@inactiveText}}</span>
    {{/if}}
  </span>
  {{#if (has-block)}}
    <span class="wu-toggle__label">{{yield}}</span>
  {{/if}}
</label>
