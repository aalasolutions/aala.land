<label class={{this.classes}} data-test-wu-toggle ...attributes>
  {{! A native checkbox exposes its own checked state to role="switch"; aria-checked would duplicate it. }}
  {{! template-lint-disable require-mandatory-role-attributes }}
  <input
    type="checkbox"
    role="switch"
    class="wu-toggle-input"
    checked={{@checked}}
    disabled={{@disabled}}
    aria-invalid={{if this.isInvalid "true"}}
    data-wu-status={{this.status}}
    aria-describedby={{@describedBy}}
    aria-required={{if @required "true"}}
    data-test-wu-toggle-input
    {{on "change" this.handleChange}}
  />
  {{#if (has-block)}}
    <span class="wu-toggle-label">{{yield}}</span>
  {{/if}}
</label>
