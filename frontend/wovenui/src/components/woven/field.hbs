<div
  class={{this.classes}}
  data-test-wu-field
  {{this.linkControl}}
  ...attributes
>
  {{#if this.floating}}
    <label
      class="wu-field-label"
      id={{this.floatLabelId}}
      data-test-wu-field-label
    >{{@placeholder}}</label>
  {{else if @label}}
    {{#if @tooltip}}
      {{! The help button sits outside the label, so the label text alone names the control. }}
      <div class="wu-field-label-row">
        <label
          class="wu-field-label"
          id={{this.labelId}}
          data-test-wu-field-label
        >{{@label}}</label>
        <button
          type="button"
          class="wu-field-help"
          popovertarget={{this.helpId}}
          aria-label="More information about {{@label}}"
          data-test-wu-field-help
        ></button>
      </div>
      <div
        class="wu-popover"
        id={{this.helpId}}
        popover
        data-test-wu-field-help-popover
      >{{@tooltip}}</div>
    {{else}}
      <label
        class="wu-field-label"
        id={{this.labelId}}
        data-test-wu-field-label
      >{{@label}}</label>
    {{/if}}
  {{/if}}

  {{yield this.api}}

  <Woven::FieldMessage
    @error={{@error}}
    @hint={{@hint}}
    @status={{this.status}}
    @hintId={{this.hintId}}
    @errorId={{this.errorId}}
  />
</div>
