<textarea
  class={{this.classes}}
  value={{@value}}
  placeholder={{@placeholder}}
  disabled={{@disabled}}
  readonly={{@readonly}}
  maxlength={{@maxlength}}
  rows={{if @rows @rows 3}}
  style={{this.resizeStyle}}
  aria-invalid={{if this.isInvalid "true"}}
  data-test-wu-textarea
  {{on "input" this.handleInput}}
  {{on "change" this.handleChange}}
  ...attributes
></textarea>
