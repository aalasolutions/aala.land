{{! Block param is `entry`, avoiding a shadowing risk with `item`. }}
<div class={{this.classes}} data-test-wu-accordion ...attributes>
  {{#each this.items key="id" as |entry|}}
    <div
      class="wu-accordion__item {{if entry.expanded 'is-expanded'}} {{if entry.disabled 'is-disabled'}}"
      data-test-wu-accordion-item={{entry.id}}
    >
      <button
        type="button"
        class="wu-accordion__trigger {{if entry.disabled 'is-disabled'}}"
        aria-expanded={{if entry.expanded "true" "false"}}
        disabled={{entry.disabled}}
        data-test-wu-accordion-trigger={{entry.id}}
        {{on "click" (fn this.toggle entry)}}
      >
        <span>{{entry.title}}</span>
        <span class="wu-accordion__icon" aria-hidden="true">▸</span>
      </button>

      <div class="wu-accordion__panel" data-test-wu-accordion-panel={{entry.id}}>
        {{! Padding on this clipped layer would keep the collapsed panel visibly tall. }}
        <div>
          <div class="wu-accordion__content">
            {{#if (has-block)}}
              {{yield entry}}
            {{else}}
              {{entry.content}}
            {{/if}}
          </div>
        </div>
      </div>
    </div>
  {{/each}}
</div>
