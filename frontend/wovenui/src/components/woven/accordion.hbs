{{! Block param is `entry`, avoiding a shadowing risk with `item`. }}
<div class={{this.classes}} data-test-wu-accordion ...attributes>
  {{#each this.items key="id" as |entry|}}
    <details
      class="wu-accordion-item"
      open={{entry.expanded}}
      data-test-wu-accordion-item={{entry.id}}
      {{on "toggle" (fn this.onToggle entry)}}
    >
      <summary
        class="wu-accordion-trigger"
        aria-disabled={{if entry.disabled "true"}}
        data-test-wu-accordion-trigger={{entry.id}}
        {{on "click" (fn this.preventDisabledToggle entry)}}
      >
        {{entry.title}}
      </summary>
      <div class="wu-accordion-body" data-test-wu-accordion-panel={{entry.id}}>
        {{#if (has-block)}}
          {{yield entry}}
        {{else}}
          {{entry.content}}
        {{/if}}
      </div>
    </details>
  {{/each}}
</div>
