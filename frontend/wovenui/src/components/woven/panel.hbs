{{! Named blocks take priority; a plain default block renders into the body slot. }}
<div class={{this.classes}} data-test-wu-panel ...attributes>
  {{#if (has-block "header")}}
    <div class="wu-panel__header" data-test-wu-panel-header>
      {{yield to="header"}}
    </div>
  {{else if this.showHeader}}
    <div class="wu-panel__header" data-test-wu-panel-header>
      <h3 class="wu-panel__title" data-test-wu-panel-title>{{@title}}</h3>
    </div>
  {{/if}}

  {{#if (has-block "body")}}
    <div class="wu-panel__body" data-test-wu-panel-body>
      {{yield to="body"}}
    </div>
  {{else if (has-block)}}
    <div class="wu-panel__body" data-test-wu-panel-body>
      {{yield}}
    </div>
  {{/if}}

  {{#if (has-block "footer")}}
    <div class="wu-panel__footer" data-test-wu-panel-footer>
      {{yield to="footer"}}
    </div>
  {{/if}}
</div>
