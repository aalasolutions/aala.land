<span class={{this.classes}} data-test-wu-tag ...attributes>
  {{#if (has-block)}}{{yield}}{{else}}{{@text}}{{/if}}

  {{#if @closable}}
    <button
      type="button"
      class="wu-tag-remove"
      aria-label={{this.removeLabel}}
      disabled={{@disabled}}
      data-test-wu-tag-remove
      {{on "click" this.handleClose}}
    ></button>
  {{/if}}
</span>
