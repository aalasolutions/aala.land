{{! Block param is `row`/`grp`, never `option` - that would shadow <option>. }}
<div
  class="wu-dropdown-wrap"
  data-wu-align={{this.align}}
  data-test-wu-dropdown
  {{did-insert this.registerRoot}}
  {{on "keydown" this.handleKeydown}}
  ...attributes
>
  {{#if (has-block "trigger")}}
    {{yield this.toggle this.isOpen to="trigger"}}
  {{else if @filterable}}
    <Woven::Input
      @value={{this.inputValue}}
      @size={{@size}}
      @disabled={{@disabled}}
      @placeholder={{this.filterPlaceholder}}
      @clearable={{true}}
      @onInput={{this.onFilterInput}}
      @onClear={{this.onFilterClear}}
      @status={{this.status}}
      role="combobox"
      aria-expanded={{if this.isOpen "true" "false"}}
      aria-controls={{this.listboxId}}
      aria-autocomplete="list"
      aria-activedescendant={{this.activeDescendant}}
      data-test-wu-dropdown-filter
      {{on "focus" this.onFilterFocus}}
    />
  {{else}}
    {{! With in-menu search the search input is the one combobox; the trigger stays a button. }}
    <button
      type="button"
      role={{unless this.showSearch "combobox"}}
      class={{this.triggerClasses}}
      disabled={{@disabled}}
      aria-haspopup="listbox"
      aria-expanded={{if this.isOpen "true" "false"}}
      aria-controls={{unless this.showSearch this.listboxId}}
      aria-activedescendant={{unless this.showSearch this.activeDescendant}}
      aria-invalid={{if (eq this.status "error") "true"}}
      data-wu-status={{this.status}}
      title={{this.triggerTitle}}
      data-test-wu-dropdown-trigger
      {{on "click" this.toggle}}
    >
      <span
        class="wu-dropdown-value"
        data-placeholder={{unless this.selectedLabel "true"}}
        data-test-wu-dropdown-value
      >{{this.triggerLabel}}</span>
    </button>
  {{/if}}

  {{! Hosted on the nearest .wu-layer so no ancestor can clip it; mounted only while open. }}
  {{#if this.isOpen}}
    {{#in-element this.layerElement insertBefore=null}}
      {{#if (has-block "trigger")}}
        <div
          class="wu-dropdown"
          id={{this.menuId}}
          role="menu"
          popover="manual"
          data-wu-options-align={{this.optionsAlign}}
          data-wu-menu-block={{if (has-block "menu") "true"}}
          data-test-wu-dropdown-menu
          {{did-insert this.registerMenu}}
          {{will-destroy this.forgetMenu}}
          {{on "keydown" this.handleKeydown}}
          {{on "click" this.onMenuBlockClick}}
          {{anchor
            this.rootElement
            placement=this.anchorPlacement
            align=this.anchorAlign
            matchWidth=this.matchWidth
            onDismiss=this.close
          }}
        >
          {{#if (has-block "menu")}}
            {{yield this.close to="menu"}}
          {{else if this.hasResults}}
            {{#each this.sections key="@index" as |grp|}}
              {{#if grp.group}}
                <div
                  class="wu-dropdown-group"
                  role="presentation"
                >{{grp.group}}</div>
              {{/if}}
              {{#each grp.rows key="@index" as |row|}}
                {{#if row.separator}}
                  <hr class="wu-dropdown-separator" />
                {{else}}
                  <button
                    type="button"
                    id={{row.id}}
                    class="wu-dropdown-item {{if row.option.danger 'danger'}}"
                    role="menuitem"
                    tabindex="-1"
                    title={{row.option.label}}
                    disabled={{row.option.disabled}}
                    data-test-wu-dropdown-item
                    {{on "click" (fn this.select row.option)}}
                  >
                    {{#if row.option.icon}}
                      <span
                        class="wu-dropdown-icon"
                        aria-hidden="true"
                      >{{row.option.icon}}</span>
                    {{/if}}
                    <span class="wu-dropdown-label">{{row.option.label}}</span>
                  </button>
                {{/if}}
              {{/each}}
            {{/each}}
          {{else}}
            <p class="wu-dropdown-empty" role="status">{{this.emptyText}}</p>
          {{/if}}
        </div>
      {{else}}
        {{! Kit autocomplete motion keys on the list being a child of .wu-autocomplete. }}
        <div class="wu-autocomplete">
          <div
            class={{if
              this.emptyOnly
              "wu-autocomplete-empty"
              "wu-autocomplete-list"
            }}
            role={{if this.emptyOnly "status"}}
            data-wu-options-align={{this.optionsAlign}}
            data-test-wu-dropdown-menu
            {{did-insert this.registerMenu}}
            {{will-destroy this.forgetMenu}}
            {{on "keydown" this.handleKeydown}}
            {{! template-lint-disable no-pointer-down-event-binding }}
            {{on "mousedown" this.keepFocus}}
            {{anchor
              this.rootElement
              placement=this.anchorPlacement
              align=this.anchorAlign
              matchWidth=this.matchWidth
              onDismiss=this.close
            }}
          >
            {{#if this.showSearch}}
              {{! No keydown here: bubbles to the root handler; binding both double-steps the highlight. }}
              <div class="wu-dropdown-search">
                <Woven::Input
                  @value={{this.searchText}}
                  @size="sm"
                  @placeholder={{if
                    @searchPlaceholder
                    @searchPlaceholder
                    "Search..."
                  }}
                  @onInput={{this.updateSearch}}
                  role="combobox"
                  aria-expanded="true"
                  aria-controls={{this.listboxId}}
                  aria-autocomplete="list"
                  aria-activedescendant={{this.activeDescendant}}
                  data-test-wu-dropdown-search
                />
              </div>
            {{/if}}

            {{#if this.hasResults}}
              <div id={{this.menuId}} role="listbox">
                {{#each this.sections key="@index" as |grp|}}
                  {{#if grp.group}}
                    <div
                      class="wu-dropdown-group"
                      role="presentation"
                    >{{grp.group}}</div>
                  {{/if}}
                  {{#each grp.rows key="@index" as |row|}}
                    {{#if row.separator}}
                      <hr class="wu-dropdown-separator" />
                    {{else}}
                      <div
                        id={{row.id}}
                        class="wu-autocomplete-option
                          {{if row.option.isCreate 'create'}}"
                        role="option"
                        aria-selected={{if row.highlighted "true" "false"}}
                        aria-checked={{if row.selected "true"}}
                        aria-disabled={{if row.option.disabled "true"}}
                        title={{row.option.label}}
                        data-test-wu-dropdown-item
                        data-test-wu-dropdown-create={{row.option.isCreate}}
                        {{on "click" (fn this.select row.option)}}
                      >
                        {{#if row.option.icon}}
                          <span
                            class="wu-dropdown-icon"
                            aria-hidden="true"
                          >{{row.option.icon}}</span>
                        {{/if}}
                        <span
                          class="wu-dropdown-label"
                        >{{row.option.label}}</span>
                        {{#if row.selected}}
                          <span
                            class="wu-dropdown-check"
                            aria-hidden="true"
                          ></span>
                        {{/if}}
                      </div>
                    {{/if}}
                  {{/each}}
                {{/each}}
              </div>
            {{else if this.emptyOnly}}
              {{this.emptyText}}
            {{else}}
              <p class="wu-dropdown-empty" role="status">{{this.emptyText}}</p>
            {{/if}}
          </div>
        </div>
      {{/if}}
    {{/in-element}}
  {{/if}}
</div>