{{! Block param is `row`/`grp`, never `option` - that would shadow <option>. }}
<div
  class={{this.classes}}
  data-test-wu-dropdown
  {{did-insert this.registerRoot}}
  {{on "keydown" this.handleKeydown}}
  ...attributes
>
  {{#if (has-block "trigger")}}
    {{yield this.toggle this.isOpen to="trigger"}}
  {{else if @filterable}}
    <Woven::Input
      @value={{this.inputValue}}
      @size={{@size}}
      @disabled={{@disabled}}
      @placeholder={{this.filterPlaceholder}}
      @clearable={{true}}
      @onInput={{this.onFilterInput}}
      @onClear={{this.onFilterClear}}
      @status={{this.status}}
      role="combobox"
      aria-expanded={{if this.isOpen "true" "false"}}
      aria-controls={{this.menuId}}
      aria-autocomplete="list"
      data-test-wu-dropdown-filter
      {{on "focus" this.onFilterFocus}}
    />
  {{else}}
    <Woven::Button
      @variant={{if @triggerVariant @triggerVariant "secondary"}}
      @size={{@size}}
      @disabled={{@disabled}}
      @onClick={{this.toggle}}
      aria-haspopup="listbox"
      aria-expanded={{if this.isOpen "true" "false"}}
      aria-invalid={{if (eq this.status "error") "true"}}
      class={{this.triggerStatusClass}}
      title={{this.triggerTitle}}
      data-test-wu-dropdown-trigger
    >
      <span
        class="wu-dropdown__value"
        data-test-wu-dropdown-value
      >{{this.triggerLabel}}</span>
      <span class="wu-dropdown__caret" aria-hidden="true">▾</span>
    </Woven::Button>
  {{/if}}

  {{! Hosted on .wu-layer so no ancestor can clip it; mounted only while open. }}
  {{#if this.isOpen}}
  {{#in-element this.layer.element insertBefore=null}}
  <div
    class={{this.menuClasses}}
    id={{this.menuId}}
    role="listbox"
    data-test-wu-dropdown-menu
    {{did-insert this.registerMenu}}
    {{will-destroy this.forgetMenu}}
    {{on "keydown" this.handleKeydown}}
    {{anchor
      this.rootElement
      placement=this.anchorPlacement
      align=this.anchorAlign
      matchWidth=this.matchWidth
      onDismiss=this.close
    }}
  >
    {{#if this.showSearch}}
      {{! No keydown here: bubbles to the root handler; binding both double-steps the highlight. }}
      <div class="wu-menu__search">
        <Woven::Input
          @value={{this.searchText}}
          @size="sm"
          @placeholder={{if @searchPlaceholder @searchPlaceholder "Search..."}}
          @onInput={{this.updateSearch}}
          data-test-wu-dropdown-search
        />
      </div>
    {{/if}}

    {{#if this.hasResults}}
      {{#if this.flatRows}}
        {{#each this.flatRows key="@index" as |row|}}
          {{#if row.separator}}
            <div class="wu-menu__separator" role="presentation"></div>
          {{else}}
            <button
              type="button"
              class="wu-menu__item
                {{if row.selected 'is-active'}}
                {{if row.highlighted 'is-highlighted'}}
                {{if row.option.disabled 'is-disabled'}}
                {{if row.option.danger 'm-danger'}}
                {{if row.option.isCreate 'm-create'}}"
              role="option"
              aria-selected={{if row.selected "true" "false"}}
              title={{row.option.label}}
              disabled={{row.option.disabled}}
              data-test-wu-dropdown-item
              {{on "click" (fn this.select row.option)}}
            >
              {{#if row.option.icon}}
                <span class="wu-menu__item-icon" aria-hidden="true">
                  {{row.option.icon}}
                </span>
              {{/if}}
              <span class="wu-menu__item-label">{{row.option.label}}</span>
            </button>
          {{/if}}
        {{/each}}
      {{else}}
      {{#each this.groupedOptions key="group" as |grp|}}
        {{#if grp.group}}
          <div class="wu-menu__group-label" role="presentation">
            {{grp.group}}
          </div>
        {{/if}}

        {{#each grp.rows key="index" as |row|}}
          <button
            type="button"
            class="wu-menu__item
              {{if row.selected 'is-active'}}
              {{if row.highlighted 'is-highlighted'}}
              {{if row.option.disabled 'is-disabled'}}
              {{if row.option.danger 'm-danger'}}
              {{if row.option.isCreate 'm-create'}}"
            role="option"
            aria-selected={{if row.selected "true" "false"}}
            title={{row.option.label}}
            disabled={{row.option.disabled}}
            data-test-wu-dropdown-item
            {{on "click" (fn this.select row.option)}}
          >
            {{#if row.option.icon}}
              <span class="wu-menu__item-icon" aria-hidden="true">
                {{row.option.icon}}
              </span>
            {{/if}}
            <span class="wu-menu__item-label">{{row.option.label}}</span>
          </button>
        {{/each}}
      {{/each}}
      {{/if}}
    {{else}}
      <div class="wu-menu__empty">
        {{this.emptyText}}
      </div>
    {{/if}}
  </div>
  {{/in-element}}
  {{/if}}
</div>
