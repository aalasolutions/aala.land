{{! Block param is `tab`, safe (not an HTML element name). }}
<div
  class={{this.classes}}
  data-test-wu-tabs
  {{did-insert this.registerRoot}}
  ...attributes
>
  <div
    class="wu-tabs-list"
    role="tablist"
    aria-orientation={{if @vertical "vertical" "horizontal"}}
    {{on "keydown" this.handleKeydown}}
  >
    {{#each this.tabs key="id" as |tab|}}
      <button
        type="button"
        class="wu-tabs-tab"
        role="tab"
        id="{{this.rootId}}-tab-{{tab.id}}"
        aria-selected={{if tab.active "true" "false"}}
        aria-controls={{if (has-block) this.panelId}}
        disabled={{tab.disabled}}
        tabindex={{if tab.active "0" "-1"}}
        data-tab-id={{tab.id}}
        data-test-wu-tabs-trigger={{tab.id}}
        {{on "click" (fn this.selectTab tab)}}
      >
        {{#if (has-block "icon")}}
          {{yield tab to="icon"}}
        {{else if tab.icon}}
          <Woven::Icon @icon={{tab.icon}} aria-hidden="true" />
        {{/if}}
        <span>{{tab.label}}</span>
        {{#if tab.count}}
          <span class="wu-badge">{{tab.count}}</span>
        {{/if}}
      </button>
    {{/each}}
  </div>

  {{#if (has-block)}}
    <div
      class="wu-tabs-panel"
      id={{this.panelId}}
      role="tabpanel"
      aria-labelledby="{{this.rootId}}-tab-{{this.currentTab}}"
      tabindex="0"
      data-test-wu-tabs-panel={{this.currentTab}}
    >
      {{yield this.currentTab}}
    </div>
  {{/if}}
</div>
