<span
  class={{this.classes}}
  role={{this.role}}
  aria-label={{this.ariaLabel}}
  data-status={{this.dataStatus}}
  data-test-wu-avatar
  ...attributes
>
  {{#if this.hasImage}}
    <img src={{@src}} alt={{this.imageAlt}} data-test-wu-avatar-image />
  {{else if this.hasInitials}}
    <span data-test-wu-avatar-initials>{{@initials}}</span>
  {{else if this.hasIcon}}
    <span aria-hidden="true" data-test-wu-avatar-icon>{{@icon}}</span>
  {{/if}}
</span>
