{{! Block param is `option`, safe (not an HTML element name). }}
<div
  class={{this.classes}}
  role={{if this.multiple "group" "radiogroup"}}
  data-test-wu-segmented
  {{did-insert this.registerRoot}}
  {{on "keydown" this.handleKeydown}}
  ...attributes
>
  {{#each this.options key="id" as |option|}}
    <label
      class="wu-segmented-item gap-2"
      title={{if @iconOnly option.label}}
      data-test-wu-segmented-item={{option.id}}
    >
      <input
        type={{if this.multiple "checkbox" "radio"}}
        class="wu-segmented-input"
        name={{this.name}}
        value={{option.id}}
        checked={{option.active}}
        disabled={{option.disabled}}
        data-segment-id={{option.id}}
        {{on "change" (fn this.select option)}}
      />
      {{#if (has-block "icon")}}
        <span class="wu-segmented-icon" aria-hidden="true">
          {{yield option to="icon"}}
        </span>
      {{else if option.icon}}
        <span class="wu-segmented-icon" aria-hidden="true">
          <Woven::Icon @icon={{option.icon}} />
        </span>
      {{/if}}
      <span
        class="wu-segmented-label{{if @iconOnly ' sr-only'}}"
      >{{option.label}}</span>
    </label>
  {{/each}}
</div>
