{{! Block param is `option`, safe (not an HTML element name). }}
<div
  class={{this.classes}}
  role={{if this.multiple "group" "radiogroup"}}
  data-test-wu-segmented
  {{did-insert this.registerRoot}}
  {{on "keydown" this.handleKeydown}}
  ...attributes
>
  {{#each this.options key="id" as |option|}}
    <button
      type="button"
      class="wu-segmented__item {{if option.active 'is-active'}} {{if option.disabled 'is-disabled'}}"
      role={{if this.multiple "checkbox" "radio"}}
      aria-checked={{if option.active "true" "false"}}
      disabled={{option.disabled}}
      tabindex={{if this.multiple "0" (if option.active "0" "-1")}}
      title={{if @iconOnly option.label}}
      data-segment-id={{option.id}}
      data-test-wu-segmented-item={{option.id}}
      {{on "click" (fn this.select option)}}
    >
      {{#if (has-block "icon")}}
        <span class="wu-segmented__icon" aria-hidden="true">
          {{yield option to="icon"}}
        </span>
      {{else if option.icon}}
        <span class="wu-segmented__icon" aria-hidden="true">
          <Woven::Icon @icon={{option.icon}} />
        </span>
      {{/if}}
      <span class="wu-segmented__label">{{option.label}}</span>
    </button>
  {{/each}}
</div>
