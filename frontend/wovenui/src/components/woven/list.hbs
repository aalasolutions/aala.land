{{#if @ordered}}
  <ol class={{this.classes}} role="list" data-test-wu-list ...attributes>
    {{#if (has-block)}}
      {{yield}}
    {{else}}
      {{#each this.normalizedItems key="key" as |entry|}}
        <li class="wu-list-item" data-test-wu-list-item>
          {{#if entry.icon}}
            <span aria-hidden="true">{{entry.icon}}</span>
          {{/if}}
          <div class="wu-list-body">
            <span class="wu-list-title">{{entry.label}}</span>
          </div>
        </li>
      {{/each}}
    {{/if}}
  </ol>
{{else}}
  <ul class={{this.classes}} role="list" data-test-wu-list ...attributes>
    {{#if (has-block)}}
      {{yield}}
    {{else}}
      {{#each this.normalizedItems key="key" as |entry|}}
        <li class="wu-list-item" data-test-wu-list-item>
          {{#if entry.icon}}
            <span aria-hidden="true">{{entry.icon}}</span>
          {{/if}}
          <div class="wu-list-body">
            <span class="wu-list-title">{{entry.label}}</span>
          </div>
        </li>
      {{/each}}
    {{/if}}
  </ul>
{{/if}}
