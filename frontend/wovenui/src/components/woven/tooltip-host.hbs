{{#if this.tooltip.isVisible}}
  {{#in-element this.layerElement insertBefore=null}}
    <div
      id={{this.tooltipId}}
      class={{this.classes}}
      style={{this.style}}
      {{tooltip-fit this.tooltip.anchor this.tooltip.content this.resolvedPlacement}}
      role="tooltip"
      data-test-wu-tooltip
      ...attributes
    >
      {{this.tooltip.content}}
      <span class="wu-tooltip-arrow" aria-hidden="true"></span>
    </div>
  {{/in-element}}
{{/if}}
