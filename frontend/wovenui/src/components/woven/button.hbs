{{! @route renders LinkTo, @href an anchor, else a button; all share button-inner. }}
{{#if @route}}
  <LinkTo
    @route={{@route}}
    @models={{this.linkModels}}
    @query={{this.linkQuery}}
    @disabled={{this.isDisabled}}
    class={{this.classes}}
    aria-busy={{this.ariaBusy}}
    aria-disabled={{this.ariaDisabled}}
    tabindex={{if this.isDisabled "-1"}}
    data-test-wu-button
    ...attributes
  >
    <Woven::ButtonInner
      @btn={{this}}
      @hasBlock={{has-block}}
      @hasIconBlock={{has-block "icon"}}
      @text={{@text}}
    >
      <:icon>{{yield to="icon"}}</:icon>
      <:default>{{yield}}</:default>
    </Woven::ButtonInner>
  </LinkTo>
{{else if @href}}
  {{! An anchor with href is a link, which supports aria-disabled; the rule cannot see a dynamic href. }}
  {{! template-lint-disable no-unsupported-role-attributes }}
  <a
    href={{@href}}
    class={{this.classes}}
    aria-busy={{this.ariaBusy}}
    aria-disabled={{this.ariaDisabled}}
    tabindex={{if this.isDisabled "-1"}}
    data-test-wu-button
    {{on "click" this.onLinkClick}}
    ...attributes
  >
    <Woven::ButtonInner
      @btn={{this}}
      @hasBlock={{has-block}}
      @hasIconBlock={{has-block "icon"}}
      @text={{@text}}
    >
      <:icon>{{yield to="icon"}}</:icon>
      <:default>{{yield}}</:default>
    </Woven::ButtonInner>
  </a>
{{else}}
  <button
    type={{this.type}}
    class={{this.classes}}
    disabled={{this.isDisabled}}
    aria-pressed={{this.ariaPressed}}
    aria-busy={{this.ariaBusy}}
    data-test-wu-button
    {{on "click" this.onClick}}
    ...attributes
  >
    <Woven::ButtonInner
      @btn={{this}}
      @hasBlock={{has-block}}
      @hasIconBlock={{has-block "icon"}}
      @text={{@text}}
    >
      <:icon>{{yield to="icon"}}</:icon>
      <:default>{{yield}}</:default>
    </Woven::ButtonInner>
  </button>
{{/if}}
