{{! @route renders LinkTo, @href an anchor, else a button; all share button-inner. }}
{{#if @route}}
  <LinkTo
    @route={{@route}}
    @models={{this.linkModels}}
    @query={{this.linkQuery}}
    class={{this.classes}}
    data-test-wu-button
    ...attributes
  >
    <Woven::ButtonInner
      @btn={{this}}
      @hasBlock={{has-block}}
      @hasIconBlock={{has-block "icon"}}
      @text={{@text}}
    >
      <:icon>{{yield to="icon"}}</:icon>
      <:default>{{yield}}</:default>
    </Woven::ButtonInner>
  </LinkTo>
{{else if @href}}
  <a href={{@href}} class={{this.classes}} ...attributes>
    <Woven::ButtonInner
      @btn={{this}}
      @hasBlock={{has-block}}
      @hasIconBlock={{has-block "icon"}}
      @text={{@text}}
    >
      <:icon>{{yield to="icon"}}</:icon>
      <:default>{{yield}}</:default>
    </Woven::ButtonInner>
  </a>
{{else}}
  <button
    type={{this.type}}
    class={{this.classes}}
    disabled={{this.isDisabled}}
    data-test-wu-button
    {{on "click" this.onClick}}
    ...attributes
  >
    <Woven::ButtonInner
      @btn={{this}}
      @hasBlock={{has-block}}
      @hasIconBlock={{has-block "icon"}}
      @text={{@text}}
    >
      <:icon>{{yield to="icon"}}</:icon>
      <:default>{{yield}}</:default>
    </Woven::ButtonInner>
  </button>
{{/if}}
