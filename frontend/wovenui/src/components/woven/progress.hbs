{{! Native progress per the kit; no value attribute means indeterminate. }}
{{#if this.showText}}
  <label class="wu-progress-label" for={{this.id}} data-test-wu-progress-label>
    <span>{{this.displayLabel}}</span>
  </label>
{{/if}}
{{#if @indeterminate}}
  <progress
    id={{this.id}}
    class={{this.classes}}
    max="100"
    data-test-wu-progress
    ...attributes
  ></progress>
{{else}}
  <progress
    id={{this.id}}
    class={{this.classes}}
    value={{this.value}}
    max="100"
    data-test-wu-progress
    ...attributes
  ></progress>
{{/if}}
