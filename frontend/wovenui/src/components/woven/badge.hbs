{{! Count bubbles and capped plain values isolate as LTR so "99+" never reads "+99" under RTL; text labels keep their own direction. }}
{{#if (has-block)}}
  <span class="wu-badge-wrap" data-test-wu-badge-wrap ...attributes>
    {{yield}}

    {{#unless this.isHidden}}
      <span class="{{this.countClasses}} is-fixed" data-test-wu-badge>
        {{#unless @isDot}}
          <bdi dir="ltr">{{this.displayValue}}</bdi>
        {{/unless}}
      </span>
    {{/unless}}
  </span>
{{else if this.isCount}}
  {{! Standalone count bubble, no anchor element. }}
  <span class={{this.countClasses}} data-test-wu-badge ...attributes>
    {{#unless @isDot}}<bdi dir="ltr">{{this.displayValue}}</bdi>{{/unless}}
  </span>
{{else}}
  <span class={{this.classes}} data-test-wu-badge ...attributes>
    {{#if @isDot}}
      <span class="wu-badge__dot"></span>
    {{else if this.isOverflow}}
      <bdi dir="ltr">{{this.displayValue}}</bdi>
    {{else}}
      {{this.displayValue}}
    {{/if}}
  </span>
{{/if}}
