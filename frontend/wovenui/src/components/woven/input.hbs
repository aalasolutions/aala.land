{{#if this.hasAffix}}
  <div class={{this.affixClasses}} data-test-wu-input-affix>
    {{#if @prefixIcon}}
      <span class="wu-input-prefix" aria-hidden="true">{{@prefixIcon}}</span>
    {{/if}}

    <this.InputControl @control={{this}} @class="wu-input" ...attributes />

    {{#if this.showClear}}
      <button
        type="button"
        class="wu-input-clear"
        aria-label="Clear input"
        data-test-wu-input-clear
        {{on "click" this.handleClear}}
      ></button>
    {{else if @suffixIcon}}
      <span class="wu-input-suffix" aria-hidden="true">{{@suffixIcon}}</span>
    {{/if}}
  </div>
{{else}}
  <this.InputControl @control={{this}} @class={{this.classes}} ...attributes />
{{/if}}
