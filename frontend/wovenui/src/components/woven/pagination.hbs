{{! Block param is `entry`, avoids shadowing HTML elements. }}
<nav class={{this.classes}} aria-label="Pagination" data-test-wu-pagination ...attributes>
  <span class="wu-pagination-total" data-test-wu-pagination-status>
    {{this.statusText}}
  </span>

  <ul class="wu-pagination-list">
    <li>
      <button
        type="button"
        class="wu-btn wu-pagination-prev"
        aria-label="Previous page"
        disabled={{this.disablePrevious}}
        data-test-wu-pagination-prev
        {{on "click" this.goToPrevious}}
      ></button>
    </li>

    {{#each this.pages key="@index" as |entry|}}
      {{#if (eq entry.type "ellipsis")}}
        <li>
          <span class="wu-pagination-ellipsis">&hellip;</span>
        </li>
      {{else}}
        <li>
          <button
            type="button"
            class="wu-btn"
            aria-current={{if entry.active "page" false}}
            data-test-wu-pagination-page={{entry.number}}
            {{on "click" (fn this.goToPage entry.number)}}
          >
            {{entry.number}}
          </button>
        </li>
      {{/if}}
    {{/each}}

    <li>
      <button
        type="button"
        class="wu-btn wu-pagination-next"
        aria-label="Next page"
        disabled={{this.disableNext}}
        data-test-wu-pagination-next
        {{on "click" this.goToNext}}
      ></button>
    </li>
  </ul>

  {{#if this.showPerPage}}
    <label class="wu-pagination-size">
      <select
        class="wu-select {{this.perPageSize}}"
        data-test-wu-pagination-select
        {{on "change" this.changePerPage}}
      >
        {{#each this.perPageOptions as |size|}}
          <option value={{size}} selected={{eq size this.perPage}}>{{size}}</option>
        {{/each}}
      </select>
      per page
    </label>
  {{/if}}
</nav>
