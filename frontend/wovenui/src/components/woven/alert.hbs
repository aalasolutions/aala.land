{{! The kit draws the marker shape; the close button stays the last child. }}
<div class={{this.classes}} role="alert" data-test-wu-alert ...attributes>
  {{#if (has-block)}}
    {{yield}}
  {{else}}
    {{#if @title}}
      <strong class="wu-alert-title" data-test-wu-alert-title>{{@title}}</strong>
    {{/if}}
    {{#if @description}}
      <p data-test-wu-alert-description>{{@description}}</p>
    {{/if}}
  {{/if}}

  {{#if (has-block "actions")}}
    <div class="wu-alert-actions" data-test-wu-alert-actions>
      {{yield to="actions"}}
    </div>
  {{/if}}

  {{#if @closable}}
    <button
      type="button"
      class="wu-alert-close"
      aria-label="Dismiss alert"
      data-test-wu-alert-close
      {{on "click" this.handleClose}}
    ></button>
  {{/if}}
</div>
