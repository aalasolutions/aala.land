{{! The main slot holds leading content and text side by side, so it is a growing row, not the kit's column body. }}
<div class="wu-list-item" data-test-wu-list-item ...attributes>
  {{#if (has-block "main")}}
    <div class="flex x-center gap-3 grow min-w-0p" data-test-wu-list-item-main>
      {{yield to="main"}}
    </div>
  {{/if}}

  {{#if (has-block "actions")}}
    <div class="flex x-center gap-2" data-test-wu-list-item-actions>
      {{yield to="actions"}}
    </div>
  {{/if}}
</div>
