<div
  class="relative inline-block"
  data-test-wu-popover
  {{did-insert this.registerRoot}}
  {{on "keydown" this.onKeydown}}
  ...attributes
>
  {{yield this.toggle this.isOpen to="trigger"}}

  {{! Hosted on the nearest .wu-layer so no ancestor can clip it; mounted only while open. }}
  {{#if this.isOpen}}
    {{#in-element this.layerElement insertBefore=null}}
      <div
        class="wu-popover"
        role="dialog"
        popover="manual"
        aria-labelledby={{if @title this.titleId}}
        data-test-wu-popover-content
        {{did-insert this.registerPanel}}
        {{will-destroy this.forgetPanel}}
        {{on "keydown" this.onKeydown}}
        {{anchor
          this.rootElement
          placement=this.anchorPlacement
          align=this.anchorAlign
          gap=8
          onDismiss=this.close
        }}
      >
        {{#if @title}}
          <h3
            id={{this.titleId}}
            class="wu-popover-title"
            data-test-wu-popover-title
          >
            {{@title}}
          </h3>
        {{/if}}

        <div data-test-wu-popover-body>
          {{yield to="body"}}
        </div>

        {{#if (has-block "footer")}}
          <div class="wu-popover-actions" data-test-wu-popover-footer>
            {{yield to="footer"}}
          </div>
        {{/if}}
      </div>
    {{/in-element}}
  {{/if}}
</div>
