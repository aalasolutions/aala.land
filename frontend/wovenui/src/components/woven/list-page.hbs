<div class="flex col gap-4" data-test-wu-list-page ...attributes>
  {{#if (has-block "action")}}
    <Woven::PageHeader @title={{@title}} @subtitle={{@subtitle}}>
      <:actions>{{yield to="action"}}</:actions>
    </Woven::PageHeader>
  {{else}}
    <Woven::PageHeader @title={{@title}} @subtitle={{@subtitle}} />
  {{/if}}

  {{#if (has-block "switcher")}}
    <div
      class="flex between x-center gap-3 wrap"
      data-test-wu-list-page-switcher
    >
      {{yield to="switcher"}}
    </div>
  {{/if}}

  <div class="flex x-center gap-3 wrap" data-test-wu-list-page-toolbar>
    {{#unless @hideCount}}
      <span
        class="text-sm text-muted"
        role="status"
        data-test-wu-list-page-count
      >{{this.countText}}</span>
    {{/unless}}
    {{yield to="toolbar"}}
    <div class="flex x-center gap-3 ms-auto" data-test-wu-list-page-toolbar-end>
      {{yield to="toolbarEnd"}}
      <div data-test-wu-list-page-options {{this.registerOptionsHost}}></div>
    </div>
  </div>

  {{#if @isEmpty}}
    {{yield to="empty"}}
  {{else}}
    {{yield (hash optionsTarget=this.optionsHost) to="body"}}
  {{/if}}

  {{#if (has-block "footer")}}
    {{yield
      (hash Pager=(component "woven/pagination" rangeOnly=true))
      to="footer"
    }}
  {{/if}}
</div>