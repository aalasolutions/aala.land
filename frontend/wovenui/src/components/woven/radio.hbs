<label class={{this.classes}} data-test-wu-radio ...attributes>
  <input
    type="radio"
    class="wu-radio-input"
    checked={{@checked}}
    value={{@value}}
    name={{@name}}
    disabled={{@disabled}}
    data-wu-status={{this.status}}
    aria-describedby={{@describedBy}}
    data-test-wu-radio-input
    {{on "change" this.handleChange}}
  />
  {{#if (has-block)}}
    <span class="wu-radio-label" data-test-wu-radio-label>{{yield}}</span>
  {{else if @label}}
    <span class="wu-radio-label" data-test-wu-radio-label>{{@label}}</span>
  {{/if}}
</label>
