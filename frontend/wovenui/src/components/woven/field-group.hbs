<fieldset
  class="wu-field-group"
  aria-describedby={{this.describedBy}}
  data-test-wu-field-group
  {{this.applyToControls}}
  ...attributes
>
  {{#if @label}}
    <legend
      class="wu-field-group-legend"
      data-test-wu-field-group-legend
    >{{@label}}</legend>
  {{/if}}

  {{yield this.api}}

  <Woven::FieldMessage
    @error={{@error}}
    @hint={{@hint}}
    @status={{this.status}}
    @hintId={{this.hintId}}
    @errorId={{this.errorId}}
  />
</fieldset>
