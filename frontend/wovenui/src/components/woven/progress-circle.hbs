<div
  class={{this.classes}}
  role="progressbar"
  aria-valuenow={{this.value}}
  aria-valuemin="0"
  aria-valuemax="100"
  style={{this.style}}
  data-test-wu-progress-circle
  ...attributes
>
  {{#if this.showText}}
    <span class="wu-progress-circle-label" data-test-wu-progress-circle-label>{{this.displayLabel}}</span>
  {{/if}}
</div>
