{{!-- Use @confirmText/@cancelText/@type, not <:footer>; @showCancel={{false}} is an alert. --}}
<Nuvo::Modal
  @open={{@open}}
  @title={{@title}}
  @subtitle={{@subtitle}}
  @size={{if @size @size "sm"}}
  @showClose={{this.showClose}}
  @closeOnEsc={{this.allowDismiss}}
  @closeOnBackdrop={{this.allowDismiss}}
  @onClose={{this.close}}
  data-test-nu-confirm-modal
  ...attributes
>
  <:body>
    {{#if @message}}
      <Nuvo::Text
        @text={{@message}}
        @muted={{true}}
        data-test-nu-confirm-modal-message
      />
    {{/if}}
    {{yield}}
  </:body>

  <:footer>
    {{#if this.showCancel}}
      <Nuvo::Button
        @variant="secondary"
        @text={{this.cancelText}}
        @disabled={{this.isConfirming}}
        data-test-nu-confirm-modal-cancel
        {{on "click" this.close}}
      />
    {{/if}}
    {{! @loading already implies disabled, see button.js isDisabled. }}
    <Nuvo::Button
      @variant={{this.confirmVariant}}
      @text={{if this.isConfirming this.confirmingText this.confirmText}}
      @loading={{this.isConfirming}}
      data-test-nu-confirm-modal-confirm
      {{on "click" this.confirm}}
    />
  </:footer>
</Nuvo::Modal>
