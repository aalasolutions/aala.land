{{! Column picker for Nuvo::DataTable; rendered by the table, not used on its own. }}
<Nuvo::Popover @title="Columns" @placement="bottom" @align="end">
  <:trigger as |toggle|>
    <Nuvo::Button
      @variant="ghost"
      @size={{if @size @size "sm"}}
      @icon="sliders-horizontal"
      @onClick={{toggle}}
      data-test-data-table-options
    >Options</Nuvo::Button>
  </:trigger>
  <:body>
    <div class="flex col" data-test-data-table-columns>
      {{#each @columns key="key" as |option|}}
        <Nuvo::Checkbox
          @label={{option.name}}
          @checked={{option.visible}}
          @onChange={{fn @onToggle option.key}}
          data-test-data-table-column-toggle={{option.key}}
        />
      {{/each}}
    </div>
  </:body>
  <:footer>
    {{#if @onReset}}
      <Nuvo::Button
        @variant="ghost"
        @size="sm"
        @icon="arrow-counter-clockwise"
        @onClick={{@onReset}}
        data-test-data-table-reset
      >Reset columns</Nuvo::Button>
    {{/if}}
  </:footer>
</Nuvo::Popover>
