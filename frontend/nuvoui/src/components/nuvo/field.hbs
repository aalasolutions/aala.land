<div
  class={{this.classes}}
  data-test-nu-field
  {{this.linkControl}}
  ...attributes
>
  {{#if @label}}
    {{! The tooltip button sits outside the label: label content becomes the control's name. }}
    <span class="nu-field__label-row">
      <label
        class="nu-field__label"
        id={{this.labelId}}
        data-test-nu-field-label
      >
        {{@label}}
        {{#if @required}}
          <span
            class="nu-field__required"
            aria-hidden="true"
            data-test-nu-field-required
          >*</span>
        {{/if}}
      </label>
      {{#if @tooltip}}
        <button
          type="button"
          class="nu-field__info"
          aria-label="More information about {{@label}}"
          data-tooltip={{@tooltip}}
          data-tooltip-position={{if @tooltipPosition @tooltipPosition "top"}}
          data-test-nu-field-tooltip
        >
          <Nuvo::Icon @icon="question" />
        </button>
      {{/if}}
    </span>
  {{/if}}

  {{#if this.floating}}
    <div class="nu-field__control" data-test-nu-field-control>
      {{yield this.api}}
      {{! After the control so it paints over the control's background. }}
      <label
        class="nu-field__float-label"
        id={{this.floatLabelId}}
        data-test-nu-field-label
      >
        {{@placeholder}}
        {{#if @required}}
          <span
            class="nu-field__required"
            aria-hidden="true"
            data-test-nu-field-required
          >*</span>
        {{/if}}
      </label>
    </div>
  {{else if @horizontal}}
    {{! The control and its message share one column beside the label. }}
    <div class="nu-field__body">
      {{yield this.api}}
      <Nuvo::FieldMessage
        @error={{@error}}
        @hint={{@hint}}
        @status={{this.status}}
        @hintId={{this.hintId}}
        @errorId={{this.errorId}}
      />
    </div>
  {{else}}
    {{yield this.api}}
  {{/if}}

  {{#unless this.messageInBody}}
    <Nuvo::FieldMessage
      @error={{@error}}
      @hint={{@hint}}
      @status={{this.status}}
      @hintId={{this.hintId}}
      @errorId={{this.errorId}}
    />
  {{/unless}}
</div>
