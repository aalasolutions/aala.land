<label class={{this.labelClasses}} data-test-nu-checkbox ...attributes>
  <input
    type="checkbox"
    class={{this.classes}}
    checked={{@checked}}
    value={{@value}}
    disabled={{@disabled}}
    data-test-nu-checkbox-input
    {{on "change" this.handleChange}}
    {{did-insert this.syncIndeterminate}}
    {{did-update this.syncIndeterminate @indeterminate}}
  />
  {{#if @label}}
    <span data-test-nu-checkbox-label>{{@label}}</span>
  {{/if}}
</label>
