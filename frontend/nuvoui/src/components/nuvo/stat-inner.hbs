{{! Shared body for the div, anchor and LinkTo branches of Nuvo::Stat. The
    parent forwards its `icon` and `content` named blocks to the matching
    blocks here. `content` trails the value, for a sparkline or a small note.
    `@contentBleed` adds the sheet's `m-bleed` modifier, which cancels the
    card padding so the block reaches the card edge. }}
{{#if @hasIconBlock}}
  <div class="nu-stat__icon" aria-hidden="true" data-test-nu-stat-icon>
    {{yield to="icon"}}
  </div>
{{else if @icon}}
  <div class="nu-stat__icon" aria-hidden="true" data-test-nu-stat-icon>
    {{@icon}}
  </div>
{{/if}}

{{#if @label}}
  <div class="nu-stat__label" data-test-nu-stat-label>{{@label}}</div>
{{/if}}

<div class="nu-stat__value" data-test-nu-stat-value>{{@value}}</div>

{{#if @delta}}
  <div class="nu-stat__delta" data-test-nu-stat-delta>{{@delta}}</div>
{{/if}}

{{#if @hasContentBlock}}
  <div
    class="nu-stat__content{{if @contentBleed ' m-bleed'}}"
    data-test-nu-stat-content
  >
    {{yield to="content"}}
  </div>
{{/if}}
