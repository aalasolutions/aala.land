{{! Shared body for the div, anchor and LinkTo branches of Nuvo::Stat. The
    parent forwards its `icon` named block as this component's default block. }}
{{#if @hasIconBlock}}
  <div class="nu-stat__icon" aria-hidden="true" data-test-nu-stat-icon>
    {{yield}}
  </div>
{{else if @icon}}
  <div class="nu-stat__icon" aria-hidden="true" data-test-nu-stat-icon>
    {{@icon}}
  </div>
{{/if}}

{{#if @label}}
  <div class="nu-stat__label" data-test-nu-stat-label>{{@label}}</div>
{{/if}}

<div class="nu-stat__value" data-test-nu-stat-value>{{@value}}</div>

{{#if @delta}}
  <div class="nu-stat__delta" data-test-nu-stat-delta>{{@delta}}</div>
{{/if}}