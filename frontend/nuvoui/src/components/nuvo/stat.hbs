{{! @route renders LinkTo, @href an anchor, else a div; all share stat-inner. }}
{{#if @route}}
  <LinkTo
    @route={{@route}}
    @models={{this.linkModels}}
    @query={{this.linkQuery}}
    class={{this.classes}}
    data-test-nu-stat
    ...attributes
  >
    <Nuvo::StatInner
      @icon={{@icon}}
      @label={{@label}}
      @value={{@value}}
      @delta={{@delta}}
      @hasIconBlock={{has-block "icon"}}
    >{{yield to="icon"}}</Nuvo::StatInner>
  </LinkTo>
{{else if @href}}
  <a href={{@href}} class={{this.classes}} data-test-nu-stat ...attributes>
    <Nuvo::StatInner
      @icon={{@icon}}
      @label={{@label}}
      @value={{@value}}
      @delta={{@delta}}
      @hasIconBlock={{has-block "icon"}}
    >{{yield to="icon"}}</Nuvo::StatInner>
  </a>
{{else}}
  <div class={{this.classes}} data-test-nu-stat ...attributes>
    <Nuvo::StatInner
      @icon={{@icon}}
      @label={{@label}}
      @value={{@value}}
      @delta={{@delta}}
      @hasIconBlock={{has-block "icon"}}
    >{{yield to="icon"}}</Nuvo::StatInner>
  </div>
{{/if}}
