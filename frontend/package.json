{
  "name": "land",
  "version": "0.1.0",
  "private": true,
  "description": "AALA.LAND - A Property Management SaaS platform.",
  "repository": "",
  "license": "MIT",
  "author": "",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "pnpm --filter @nuvoui/ember build && STRIP_TEST_SELECTORS=true vite build",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "concurrently \"pnpm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "concurrently \"pnpm:start:kit\" \"pnpm:start:app\" --names \"kit,app\" --prefixColors auto",
    "start:app": "vite",
    "start:kit": "pnpm --filter @nuvoui/ember start",
    "test": "concurrently \"pnpm:lint\" \"pnpm:test:*\" --names \"lint,test:\" --prefixColors auto",
    "test:ember": "pnpm --filter @nuvoui/ember build && vite build --mode development && ember test --path dist"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@ember/optional-features": "^3.0.0",
    "@ember/render-modifiers": "^3.0.0",
    "@ember/test-helpers": "^5.4.1",
    "@ember/test-waiters": "^4.1.1",
    "@embroider/compat": "^4.1.25",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.6.7",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.20.5",
    "@embroider/router": "^3.0.6",
    "@embroider/vite": "^1.7.13",
    "@eslint/js": "^9.39.5",
    "@glimmer/component": "^2.0.0",
    "@nuvoui/core": "^1.5.4",
    "@rollup/plugin-babel": "^7.1.0",
    "babel-plugin-ember-template-compilation": "^3.1.0",
    "concurrently": "^9.2.1",
    "decorator-transforms": "^2.3.1",
    "dotenv": "^17.4.2",
    "ember-cli": "~6.12.0",
    "ember-cli-babel": "^8.3.1",
    "ember-cli-deprecation-workflow": "^4.0.1",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.0.4",
    "ember-resolver": "^13.2.0",
    "ember-source": "~6.12.0",
    "ember-template-lint": "^7.9.3",
    "ember-truth-helpers": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-qunit": "^8.2.6",
    "globals": "^16.5.0",
    "prettier": "^3.9.7",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "qunit": "^2.25.0",
    "qunit-dom": "^3.5.0",
    "sass": "^1.97.2",
    "strip-test-selectors": "^0.1.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^38.0.0",
    "testem": "^3.21.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">= 26"
  },
  "ember": {
    "edition": "octane"
  },
  "dependencies": {
    "@ember/string": "^4.0.1",
    "@nuvoui/ember": "workspace:*",
    "ember-lifeline": "^7.1.0",
    "luxon": "3.7.2",
    "socket.io-client": "^4.8.3"
  }
}
