{{page-title "WovenUI UIKit"}}

{{! The documentation shell dogfoods the kit's own sidebar, topbar and collapse. }}
<div class="woven-shell">
  <Woven::Sidebar
    @collapsed={{this.sidebarCollapsed}}
    @pinned={{true}}
    @animated={{true}}
    @open={{this.sidebarOpen}}
    @dismissible={{true}}
    @onDismiss={{this.closeSidebar}}
    @brandTitle="WovenUI"
    @brandSubtitle="Ember kit"
  >
    {{! Named blocks are all-or-nothing: <:footer> forces an explicit <:default>. }}
    <:default>
      {{#each this.navSections as |group|}}
        <div class="wu-sidebar-section">
          <h2 class="wu-sidebar-heading">{{group.label}}</h2>
          <ul class="wu-sidebar-list">
            {{#each group.items as |entry|}}
              <li>
                <LinkTo
                  @route={{entry.route}}
                  class="wu-sidebar-link"
                  aria-current={{if (this.isCurrent entry.route) "page"}}
                  data-test-woven-nav={{entry.route}}
                  {{on "click" this.closeSidebar}}
                >
                  <span aria-hidden="true">{{entry.icon}}</span>
                  <span class="wu-sidebar-label">{{entry.label}}</span>
                </LinkTo>
              </li>
            {{/each}}
          </ul>
        </div>
      {{/each}}
    </:default>

    <:footer>
      <span class="wu-text sm text-subtle">{{this.pageCount}} pages</span>
    </:footer>
  </Woven::Sidebar>

  <div class="woven-shell__main">
    <Woven::Topbar
      @sticky={{true}}
      @onToggle={{this.toggleSidebar}}
      @userName="Test User"
      @userRole="Owner"
    >
      <:brand>
        <Woven::Button
          @variant="ghost"
          @size="sm"
          @icon={{if this.sidebarCollapsed "»" "«"}}
          @shape="square"
          @onClick={{this.toggleCollapsed}}
          aria-label="Collapse sidebar"
          data-tooltip="Collapse sidebar"
          data-test-woven-collapse
        />
        <span class="wu-title sm">UI Kit</span>
      </:brand>

      <:actions>
        <span class="wu-text sm muted">Theme</span>
        {{#each this.themes as |theme|}}
          <Woven::Button
            @variant={{if (eq this.activeTheme theme) "brand" "subtle"}}
            @size="xs"
            @text={{theme}}
            @onClick={{fn this.setTheme theme}}
            data-test-woven-theme={{theme}}
          />
        {{/each}}

        <span class="wu-text sm muted ms-4">Dir</span>
        {{#each this.dirs as |dir|}}
          <Woven::Button
            @variant={{if (eq this.dir dir) "brand" "subtle"}}
            @size="xs"
            @text={{dir}}
            @onClick={{fn this.setDir dir}}
            data-test-woven-dir={{dir}}
          />
        {{/each}}

        <Woven::Badge @variant="danger" @value={{3}}>
          <Woven::Button
            @variant="ghost"
            @shape="square"
            @icon="🔔"
            aria-label="Notifications"
          />
        </Woven::Badge>
      </:actions>
    </Woven::Topbar>

    <div class="woven-page">
      {{outlet}}
    </div>
  </div>
</div>
