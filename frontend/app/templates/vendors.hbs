{{page-title "Vendors"}}

<div data-test-vendors-page class="flex col gap-6">
  <Woven::PageHeader @title="Vendors" @subtitle="Manage service providers and contractors.">
    <:actions>
      <Woven::Button
        data-test-new-vendor
        @variant="primary"
        @icon="plus"
        {{on "click" this.openCreate}}
      >
        New Vendor
      </Woven::Button>
    </:actions>
  </Woven::PageHeader>

  <Woven::Card>
    {{#if @model.vendors.length}}
      <Woven::DataTable
        @columns={{this.columns}}
        @rows={{@model.vendors}}
        @pinColumns={{true}}
        @reorderable={{true}}
        @sortable={{true}}
        @showOptions={{true}}
        @tableId="vendors"
        as |cell|
      >
        {{#if (eq cell.key "name")}}
          <span data-test-vendor-row>{{cell.value}}</span>
        {{else if (eq cell.key "specialties")}}
          <div class="flex gap-2 wrap">
            {{#each cell.value as |sp|}}
              <Woven::Tag class="tag-trade-{{lowercase sp}}" @text={{sp}} />
            {{/each}}
          </div>
        {{else if (eq cell.key "hourlyRate")}}
          <Money @amount={{cell.value}} @currency={{cell.row.currency}} />
        {{else if (eq cell.key "rating")}}
          {{#if cell.value}}
            {{cell.value}}
            / 5
          {{/if}}
        {{else if (eq cell.key "id")}}
          <div class="flex">
            <Woven::Button
              data-test-edit-vendor
              @subtle={{true}}
              @variant="secondary"
              @size="xs"
              @icon="pencil-simple"
              aria-label="Edit {{cell.row.name}}"
              data-tooltip="Edit"
              {{on "click" (fn this.openEdit cell.row)}}
            />
            <Woven::Button
              data-test-delete-vendor
              @subtle={{true}}
              @variant="danger"
              @size="xs"
              @icon="trash"
              aria-label="Delete {{cell.row.name}}"
              data-tooltip="Delete"
              {{on "click" (fn this.openDelete cell.row)}}
            />
          </div>
        {{else}}
          {{cell.value}}
        {{/if}}
      </Woven::DataTable>
    {{else}}
      {{#if @model.total}}
        <Woven::EmptyState
          @description="No vendors on page {{this.page}}. Navigate back to find vendors."
        />
      {{else}}
        <Woven::EmptyState
          @description="No vendors yet. Add your first vendor above."
        />
      {{/if}}
    {{/if}}

    {{#if @model.total}}
      <Woven::Pagination
        @selectId="vendors-limit"
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{@model.total}}
        @onLimitChange={{this.setLimit}}
        @onPrevious={{this.goToPreviousPage}}
        @onNext={{this.goToNextPage}}
        @onPageChange={{this.goToPage}}
      />
    {{/if}}
  </Woven::Card>
</div>

<Vendors::VendorDrawer
  @open={{this.showModal}}
  @vendor={{this.editVendor}}
  @onClose={{this.closeModal}}
  @onClosed={{this.resetDrawer}}
  @onSaved={{this.refresh}}
/>

<ConfirmModal
  @open={{this.showDeleteModal}}
  @title="Delete Vendor"
  @message="Delete {{this.vendorToDelete.name}}? This cannot be undone."
  @confirmText="Delete"
  @confirmVariant="danger"
  @isConfirming={{this.isDeleting}}
  @confirmingText="Deleting..."
  @onClose={{this.closeDeleteModal}}
  @onConfirm={{this.confirmDelete}}
/>
