{{page-title "Vendors"}}

<Woven::ListPage
  @title="Vendors"
  @subtitle="Manage service providers and contractors."
  @isEmpty={{not @model.vendors.length}}
  data-test-vendors-page
>
  <:action>
    <Woven::Button
      data-test-new-vendor
      @variant="brand"
      @icon="plus"
      {{on "click" this.openCreate}}
    >
      New Vendor
    </Woven::Button>
  </:action>

  <:body as |page|>
    <Woven::DataTable
      @columns={{this.columns}}
      @rows={{@model.vendors}}
      @pinColumns={{true}}
      @reorderable={{true}}
      @sortable={{true}}
      @showOptions={{true}}
      @optionsTarget={{page.optionsTarget}}
      @tableId="vendors"
      class="table-stacked"
      data-test-vendors-table
      as |cell|
    >
      <DataTable::StackedLabel
        @columns={{this.columns}}
        @cellKey={{cell.key}}
        @skip={{array "id"}}
      />
      {{#if (eq cell.key "specialties")}}
        {{#if cell.value.length}}
          <div class="flex gap-2 wrap">
            {{#each cell.value as |sp|}}
              <Woven::Tag
                @variant={{tag-variant "trade" sp}}
                @text={{tag-label "trade" sp}}
              />
            {{/each}}
          </div>
        {{else}}
          <Woven::Cell::Empty />
        {{/if}}
      {{else if (eq cell.key "rating")}}
        {{#if cell.value}}
          <span>{{cell.value}} / 5</span>
        {{else}}
          <Woven::Cell::Empty />
        {{/if}}
      {{else if (eq cell.key "id")}}
        <div class="table-stacked__actions">
          <RowActions
            @label={{cell.row.name}}
            @actions={{array
              (hash
                key="edit-vendor"
                label="Edit"
                icon="pencil-simple"
                onSelect=(fn this.openEdit cell.row)
              )
              (hash
                key="delete-vendor"
                label="Delete"
                icon="trash"
                variant="danger"
                onSelect=(fn this.openDelete cell.row)
              )
            }}
          />
        </div>
      {{/if}}
    </Woven::DataTable>
  </:body>

  <:empty>
    {{#if @model.total}}
      <Woven::EmptyState
        @description="No vendors on page {{this.page}}. Navigate back to find vendors."
      />
    {{else}}
      <Woven::EmptyState
        @description="No vendors yet. Add your first vendor above."
      />
    {{/if}}
  </:empty>

  <:footer as |page|>
    {{#if @model.total}}
      <page.Pager
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{@model.total}}
        @onLimitChange={{this.setLimit}}
        @onPrevious={{this.goToPreviousPage}}
        @onNext={{this.goToNextPage}}
        @onPageChange={{this.goToPage}}
      />
    {{/if}}
  </:footer>
</Woven::ListPage>

<Vendors::VendorDrawer
  @open={{this.showModal}}
  @vendor={{this.editVendor}}
  @onClose={{this.closeModal}}
  @onClosed={{this.resetDrawer}}
  @onSaved={{this.refresh}}
/>

<ConfirmModal
  @open={{this.showDeleteModal}}
  @title="Delete Vendor"
  @message="Delete {{this.vendorToDelete.name}}? This cannot be undone."
  @confirmText="Delete"
  @confirmVariant="danger"
  @isConfirming={{this.isDeleting}}
  @confirmingText="Deleting..."
  @onClose={{this.closeDeleteModal}}
  @onConfirm={{this.confirmDelete}}
/>