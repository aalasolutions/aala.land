{{page-title (if @model.contact (contact-name @model.contact) "Contact")}}

<div data-test-contact-detail class="flex col gap-6">
  <Nuvo::PageHeader
    @title={{if @model.contact (contact-name @model.contact) "Contact"}}
    @subtitle="Contact record"
  >
    <:breadcrumb>
      <Nuvo::Button
        @variant="secondary"
        @size="sm"
        @icon="arrow-left"
        @text="Back to Contacts"
        data-test-back-to-contacts
        {{on "click" this.goBack}}
      />
    </:breadcrumb>
    <:meta>
      {{#if this.isLimited}}
        <Nuvo::Badge @text="Limited" data-test-limited-badge />
      {{else if @model.contact}}
        <div class="flex gap-1 flex-wrap">
          {{#each @model.contact.tags as |tag|}}
            <Nuvo::Tag
              class="tag-contact-{{tag}}"
              @text={{contact-tag-label tag}}
            />
          {{else}}
            <Nuvo::Tag class="tag-contact-other" @text="Contact" />
          {{/each}}
        </div>
      {{/if}}
    </:meta>
    <:actions>
      {{#if this.isLimited}}
        <Contact::AccessAction @contact={{@model.contact}} />
      {{else if (and @model.contact (can-edit-contact @model.contact))}}
        <Nuvo::Button
          @variant="secondary"
          @icon="pencil-simple"
          @text="Edit"
          data-test-edit-contact
          {{on "click" this.openEdit}}
        />
      {{/if}}
    </:actions>
  </Nuvo::PageHeader>

  {{#if @model.contact}}
    <RegionNotice @regionCode={{@model.contact.regionCode}} @noun="contact" />
    <div class="contact-detail-grid flex col gap-6">
      {{#if this.isLimited}}
        <Nuvo::Card @title="Contact Information">
          <Nuvo::DescList @horizontal={{true}} data-test-limited-details>
            <div class="nu-desc-list__group">
              <dt class="nu-desc-list__term">Phone</dt>
              <dd class="nu-desc-list__description" data-test-limited-phone><bdi
                  dir="ltr"
                >{{or (contact-phone @model.contact) "-"}}</bdi></dd>
            </div>
            <div class="nu-desc-list__group">
              <dt class="nu-desc-list__term">Region</dt>
              <dd
                class="nu-desc-list__description"
                data-test-limited-region
              >{{or @model.contact.regionCode "-"}}</dd>
            </div>
            <div class="nu-desc-list__group">
              <dt class="nu-desc-list__term">Added by</dt>
              <dd
                class="nu-desc-list__description"
                data-test-contact-added-by
              >{{or @model.contact.createdByName "-"}}</dd>
            </div>
            <div class="nu-desc-list__group">
              <dt class="nu-desc-list__term">Created</dt>
              <dd class="nu-desc-list__description">{{format-date
                  @model.contact.createdAt
                }}</dd>
            </div>
          </Nuvo::DescList>
          <Contact::VerifyPhone
            class="mt-4"
            @contactId={{@model.contact.id}}
            @onVerified={{this.onPhoneVerified}}
          />
        </Nuvo::Card>
      {{else}}
        <Contact::Summary
          @contact={{@model.contact}}
          @units={{@model.units}}
          @leases={{@model.leases}}
          @leads={{@model.leads}}
        />
      {{/if}}

      {{#unless this.isLimited}}
        <Nuvo::Tabs
          @tabs={{this.relatedTabs}}
          @activeTab={{this.currentTab}}
          @onChange={{this.setTab}}
          data-test-contact-tabs
        />

        {{#if (eq this.currentTab "leads")}}
          <Nuvo::Card data-test-contact-leads>
            {{#if @model.leads.length}}
              <div class="flex col gap-3">
                {{#each @model.leads as |lead|}}
                  <Nuvo::Panel
                    @compact={{true}}
                    @interactive={{true}}
                    class="flex col gap-2"
                    data-test-lead-card
                    {{on "click" (fn this.toggleLeadActivity lead.id)}}
                  >
                    <div class="flex between x-center">
                      <div class="flex gap-2 x-center">
                        <Nuvo::Tag
                          class="tag-lead-{{lowercase lead.status}}"
                          @text={{lead.status}}
                        />
                        <Nuvo::Tag
                          class="tag-temp-{{lowercase lead.temperature}}"
                          @text={{lead.temperature}}
                        />
                        {{#if lead.locality}}
                          <span class="text-sm">{{lead.locality.name}}</span>
                        {{/if}}
                      </div>
                      {{! Real button for keyboard/AT; click bubbles to the Panel's handler. }}
                      <Nuvo::Button
                        @variant="secondary"
                        @size="xs"
                        @shape="circle"
                        @icon={{if
                          (eq this.expandedLeadId lead.id)
                          "caret-up"
                          "caret-down"
                        }}
                        aria-label={{if
                          (eq this.expandedLeadId lead.id)
                          "Collapse lead activity"
                          "Expand lead activity"
                        }}
                        aria-expanded={{if
                          (eq this.expandedLeadId lead.id)
                          "true"
                          "false"
                        }}
                        data-test-toggle-lead-activity
                      />
                    </div>
                    <div class="flex gap-4 text-sm text-muted">
                      <span>Source: {{lead.source}}</span>
                      {{#if lead.budgetMin}}
                        <span>Budget:
                          <Money @amount={{lead.budgetMin}} />{{#if
                            lead.budgetMax
                          }}
                            &ndash;
                            <Money @amount={{lead.budgetMax}} />{{/if}}</span>
                      {{/if}}
                      <span>Created {{format-date lead.createdAt}}</span>
                    </div>
                    {{#if (eq this.expandedLeadId lead.id)}}
                      <div class="lead-detail__scroll">
                        {{#if (eq this.loadingActivitiesFor lead.id)}}
                          <Nuvo::Spinner @size="sm" />
                        {{else}}
                          <Nuvo::Timeline @compact={{true}}>
                            {{#each
                              (get this.leadActivities lead.id)
                              as |activity|
                            }}
                              <Nuvo::TimelineItem
                                @title={{activity.type}}
                                @timestamp={{format-date-time
                                  activity.createdAt
                                  region=lead.regionCode
                                }}
                                @description={{activity.notes}}
                                @meta={{if
                                  activity.performedByName
                                  (concat "by " activity.performedByName)
                                }}
                              >
                                <:icon><Ui::Ph
                                    @icon={{get-activity-icon activity.type}}
                                    @size="14px"
                                  /></:icon>
                              </Nuvo::TimelineItem>
                            {{else}}
                              <p class="text-muted text-sm">No activity yet.</p>
                            {{/each}}
                          </Nuvo::Timeline>
                        {{/if}}
                      </div>
                    {{/if}}
                  </Nuvo::Panel>
                {{/each}}
              </div>
            {{else}}
              <Nuvo::EmptyState @description="No lead requirements found." />
            {{/if}}
          </Nuvo::Card>
        {{else if (eq this.currentTab "leases")}}
          <Nuvo::Card data-test-contact-leases>
            {{#if @model.leases.length}}
              <Nuvo::DataTable
                @columns={{this.leaseColumns}}
                @rows={{@model.leases}}
                @pinColumns={{true}}
                @reorderable={{true}}
                @sortable={{true}}
                @showOptions={{true}}
                @tableId="contact-leases"
                as |cell|
              >
                {{#if (eq cell.key "unit.unitNumber")}}
                  <LinkTo
                    @route="leases.detail"
                    @model={{cell.row.id}}
                    class="font-bold text-primary"
                    data-test-lease-row
                  >{{cell.value}}</LinkTo>
                {{else if (eq cell.key "status")}}
                  <div class="flex gap-1 wrap">
                    <Nuvo::Tag
                      class="tag-lease-{{lowercase cell.value}}"
                      @text={{cell.value}}
                    />
                    {{#if cell.row.deletedAt}}
                      <Nuvo::Tag
                        @variant="secondary"
                        @text="Archived"
                        data-test-lease-archived-badge
                      />
                    {{/if}}
                  </div>
                {{else if (eq cell.key "startDate")}}
                  {{format-date cell.value}}
                {{else if (eq cell.key "endDate")}}
                  {{format-date cell.value}}
                {{else if (eq cell.key "monthlyRent")}}
                  <Money
                    @amount={{cell.value}}
                    @currency={{cell.row.currency}}
                  />
                {{else}}
                  <span class="text-muted">{{cell.value}}</span>
                {{/if}}
              </Nuvo::DataTable>
            {{else}}
              <Nuvo::EmptyState
                @description="No leases found for this tenant."
              />
            {{/if}}
          </Nuvo::Card>
        {{else if (eq this.currentTab "properties")}}
          <Nuvo::Card data-test-contact-properties>
            {{#if @model.units.length}}
              <Nuvo::DataTable
                @columns={{this.unitColumns}}
                @rows={{@model.units}}
                @pinColumns={{true}}
                @reorderable={{true}}
                @sortable={{true}}
                @showOptions={{true}}
                @tableId="contact-units"
                as |cell|
              >
                {{#if (eq cell.key "unitNumber")}}
                  <span
                    class="font-bold"
                    data-test-owned-unit-row
                  >{{cell.value}}</span>
                {{else if (eq cell.key "areaName")}}
                  {{cell.value}}
                {{else if (eq cell.key "propertyType")}}
                  {{#if cell.value}}{{property-type-label cell.value}}{{/if}}
                {{else if (eq cell.key "status")}}
                  <Nuvo::Tag
                    class="tag-unit-{{lowercase cell.value}}"
                    @text={{cell.value}}
                  />
                {{else if (eq cell.key "price")}}
                  <Money @amount={{cell.value}} />
                {{else if (eq cell.key "id")}}
                  <Nuvo::Button
                    @variant="secondary"
                    @size="xs"
                    @route="properties.unit"
                    @models={{array cell.row.areaId cell.row.id}}
                    @text="View"
                    data-test-view-owned-unit
                  />
                {{else}}
                  <span class="text-muted">{{cell.value}}</span>
                {{/if}}
              </Nuvo::DataTable>
            {{else}}
              <Nuvo::EmptyState
                @description="No properties found for this owner."
              />
            {{/if}}
          </Nuvo::Card>
        {{else if (eq this.currentTab "history")}}
          <Nuvo::Card data-test-contact-history>
            <RecordHistoryList
              @entityType="Contact"
              @entityId={{@model.contact.id}}
            />
          </Nuvo::Card>
        {{else}}
          <section data-test-contact-documents>
            <Documents::Panel
              @filters={{hash contactId=@model.contact.id}}
              @presetLink={{hash
                type="contact"
                id=@model.contact.id
                label=@model.contact.displayName
              }}
              @compact={{true}}
              @tableId="contact-documents"
            >
              <:header as |panel|>
                <div class="flex between x-center">
                  <h2 class="text-md font-bold">Documents</h2>
                  {{#if panel.canUpload}}
                    <Nuvo::Button
                      @variant="primary"
                      @size="sm"
                      @icon="upload-simple"
                      @text="Upload"
                      data-test-contact-documents-upload
                      {{on "click" panel.openUpload}}
                    />
                  {{/if}}
                </div>
              </:header>
            </Documents::Panel>
          </section>
        {{/if}}
      {{/unless}}
    </div>
    {{#if (and (not this.isLimited) (can-edit-contact @model.contact))}}
      <Contact::ContactDrawer
        @open={{this.showEdit}}
        @contact={{@model.contact}}
        @onClose={{this.closeEdit}}
        @onSaved={{this.refresh}}
      />
    {{/if}}
  {{else}}
    <Nuvo::Card>
      <Nuvo::EmptyState @description="Contact not found." />
    </Nuvo::Card>
  {{/if}}
</div>