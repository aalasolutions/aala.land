{{page-title "Contacts"}}

<div data-test-contacts class="flex col gap-4">
  <Woven::PageHeader
    @title="Contacts"
    @subtitle="Every person you deal with. Owners, tenants, leads and portfolio owners are views into this list, not separate records."
  >
    <:meta>
      <p class="text-muted" data-test-contacts-total>{{format-number @model.scopeTotal unit="contact"}}</p>
    </:meta>
    <:actions>
      <Woven::Button
        @variant="primary"
        @icon="plus"
        data-test-new-contact
        {{on "click" this.openCreate}}
      >
        New Contact
      </Woven::Button>
    </:actions>
  </Woven::PageHeader>

  <div class="flex between x-center gap-3 wrap">
    <Woven::Tabs
      @tabs={{this.pageTabs}}
      @activeTab={{this.currentTab}}
      @onChange={{this.setTab}}
      data-test-contacts-tabs
    />
    {{#unless (eq this.currentTab "requests")}}
      <Woven::Toggle
        @checked={{this.allRegionsOn}}
        @onChange={{this.toggleAllRegions}}
        data-test-all-regions-toggle
      >
        All regions
      </Woven::Toggle>
    {{/unless}}
  </div>

  {{#if (eq this.currentTab "requests")}}
    <AccessRequests::MyRequests />
  {{else if (eq this.currentTab "companies")}}
    <Contact::Companies @allRegions={{this.allRegionsOn}} />
  {{else}}
    <div class="flex x-center gap-3 wrap" data-test-contacts-toolbar>
      <Woven::Segmented
        @options={{this.roleTabs}}
        @value={{this.tag}}
        @onChange={{this.setTag}}
        data-test-role-tabs
      />
      <div class="w-64">
        <Woven::Input
          type="text"
          autocomplete="off"
          placeholder="Search name, email, phone..."
          @size="xs"
          aria-label="Search contacts"
          value={{this.search}}
          {{on "input" (fn this.updateFilter "search")}}
          data-test-contacts-search
        />
      </div>
      <FiltersButton @count={{this.activeFilterCount}}>
        <div class="wu-form">
          <Woven::Field class="grow" @label="Assigned agent">
            <Woven::Dropdown
              id="contacts-agent-filter"
              @align="start"
              @value={{this.agentId}}
              @onSelect={{this.setAgentFilter}}
              @options={{this.agentOptions}}
              data-test-agent-filter
            />
          </Woven::Field>
          <Woven::Field class="grow" @label="Company">
            <Woven::Input
              type="text"
              autocomplete="off"
              placeholder="e.g. Emaar Properties"
              value={{this.company}}
              {{on "input" (fn this.updateFilter "company")}}
              data-test-company-filter
            />
          </Woven::Field>
          <Woven::Field class="grow" @label="Nationality">
            <Woven::Input
              type="text"
              autocomplete="off"
              placeholder="e.g. Emirati"
              value={{this.nationality}}
              {{on "input" (fn this.updateFilter "nationality")}}
              data-test-nationality-filter
            />
          </Woven::Field>
          <div class="flex gap-3">
            <Woven::Field class="grow" @label="Added from">
              <input
                type="date"
                class="wu-input"
                aria-label="Added from"
                value={{this.dateFrom}}
                {{on "change" this.setDateFrom}}
                data-test-date-from-filter
              />
            </Woven::Field>
            <Woven::Field class="grow" @label="Added to">
              <input
                type="date"
                class="wu-input"
                aria-label="Added to"
                value={{this.dateTo}}
                {{on "change" this.setDateTo}}
                data-test-date-to-filter
              />
            </Woven::Field>
          </div>

          <div class="flex gap-3 x-center between">
            <Woven::Toggle
              @checked={{this.isWhatsapp}}
              @onChange={{this.toggleWhatsappFilter}}
              data-test-whatsapp-filter
            >
              Has WhatsApp
            </Woven::Toggle>
            <Woven::Button
              @variant="secondary"
              @size="sm"
              @icon="x"
              @disabled={{not this.hasActiveFilters}}
              {{on "click" this.clearFilters}}
              data-test-clear-filters
            >
              Clear filters
            </Woven::Button>
          </div>
        </div>
      </FiltersButton>
      <div
        class="ms-auto"
        data-test-contacts-table-options
        {{this.registerTableOptionsHost}}
      ></div>
    </div>

    <div class="flex col gap-3" data-test-contacts-list>
      {{#if @model.contacts.length}}
        <Woven::DataTable
          @columns={{this.columns}}
          @rows={{@model.contacts}}
          @pinColumns={{true}}
          @reorderable={{true}}
          @sortable={{true}}
          @showOptions={{true}}
          @optionsSize="xs"
          @optionsTarget={{this.tableOptionsHost}}
          @tableId="contacts"
          data-test-contacts-table
          as |cell|
        >
          {{#if (eq cell.key "displayName")}}
            <span class="flex gap-2 x-center">
              <LinkTo
                @route="contacts.detail"
                @model={{cell.row.id}}
                class="text-brand whitespace-nowrap"
                data-test-view-contact
              >{{contact-name cell.row}}</LinkTo>
              {{#if (is-limited-contact cell.row)}}
                <Woven::Badge
                  @size="sm"
                  @text="Limited"
                  data-test-limited-badge
                />
              {{/if}}
            </span>
          {{else if (eq cell.key "tags")}}
            {{#unless (is-limited-contact cell.row)}}
              <div class="data-table__chips">
                {{#each cell.value as |tag|}}
                  <Woven::Tag
                    class="tag-contact-{{tag}}"
                    @text={{contact-tag-label tag}}
                  />
                {{else}}
                  <Woven::Tag class="tag-contact-other" @text="Contact" />
                {{/each}}
              </div>
            {{/unless}}
          {{else if (eq cell.key "phone")}}
            {{#if (contact-phone cell.row)}}
              <span class="flex gap-2 x-center text-muted">
                <span dir="ltr" data-test-contact-phone>{{contact-phone
                    cell.row
                  }}</span>
                {{#if (can-whatsapp cell.row)}}
                  <a
                    href={{wa-link cell.row.phone}}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="wa-link"
                    title="Open WhatsApp"
                    aria-label="Open WhatsApp chat with {{contact-name
                      cell.row
                    }}"
                    data-test-wa-link
                  ><Ui::Ph @icon="whatsapp-logo" @size="14px" /></a>
                {{/if}}
              </span>
            {{/if}}
          {{else if (eq cell.key "id")}}
            {{#if (is-limited-contact cell.row)}}
              <Contact::AccessAction
                @contact={{cell.row}}
                @size="xs"
                @pending={{includes this.requestedContactIds cell.row.id}}
                @onRequested={{this.markRequested}}
              />
            {{else if (can-edit-contact cell.row)}}
              <Woven::Button
                @subtle={{true}}
                @variant="secondary"
                @size="xs"
                @icon="pencil-simple"
                aria-label="Edit {{contact-name cell.row}}"
                data-tooltip="Edit"
                data-test-edit-contact
                {{on "click" (fn this.openEdit cell.row)}}
              />
            {{/if}}
          {{else}}
            <span class="text-muted">{{cell.value}}</span>
          {{/if}}
        </Woven::DataTable>
      {{else}}
        {{#if @model.total}}
          <Woven::EmptyState
            @description="No contacts on page {{this.page}}. Navigate back or adjust your filters."
          />
        {{else}}
          <Woven::EmptyState @description="No contacts match these filters." />
        {{/if}}
      {{/if}}

      {{#if @model.total}}
        <Woven::Pagination
          @selectId="contacts-limit"
          @page={{this.page}}
          @limit={{this.limit}}
          @total={{@model.total}}
          @perPageOptions={{array 50 100}}
          @onLimitChange={{this.setLimit}}
          @onPrevious={{this.goToPreviousPage}}
          @onNext={{this.goToNextPage}}
          @onPageChange={{this.goToPage}}
        />
      {{/if}}
    </div>
  {{/if}}
</div>

<Contact::ContactDrawer
  @open={{this.showModal}}
  @contact={{this.editContact}}
  @onClose={{this.closeModal}}
  @onClosed={{this.resetDrawer}}
  @onSaved={{this.refresh}}
/>

<ConfirmModal
  @open={{this.showDeleteModal}}
  @title="Delete Contact"
  @message="Delete {{this.contactToDelete.displayName}}? This cannot be undone."
  @confirmText="Delete"
  @confirmVariant="danger"
  @isConfirming={{this.isDeleting}}
  @confirmingText="Deleting..."
  @onClose={{this.closeDeleteModal}}
  @onConfirm={{this.confirmDelete}}
>
  <Woven::Field class="mt-4" @label="Reason" @required={{true}} @error={{this.reasonError}}>
    <Woven::Textarea
      id="contact-delete-reason"
      rows="2"
      maxlength="500"
      placeholder="e.g. Duplicate contact"
      @value={{this.deleteReason}}
      @onInput={{fn this.setFieldValue "deleteReason"}}
      @invalid={{if this.reasonError true false}}
      aria-label="Reason"
      data-test-reason-input
    />
  </Woven::Field>
</ConfirmModal>
