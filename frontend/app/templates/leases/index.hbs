{{page-title "Leases"}}

<div data-test-leases-page class="flex col gap-4">
  <Woven::PageHeader @title="Lease Agreements" @subtitle="Manage tenant lease contracts and renewals.">
    <:meta>
      <p class="text-muted">{{format-number @model.total unit="lease"}}</p>
    </:meta>
    <:actions>
      <Woven::Button
        @variant="primary"
        @icon="plus"
        {{on "click" this.openCreate}}
      >
        New Lease
      </Woven::Button>
    </:actions>
  </Woven::PageHeader>

  <div class="flex x-center gap-3 wrap" data-test-leases-toolbar>
    <Woven::Segmented
      @options={{this.statusTabs}}
      @value={{this.status}}
      @onChange={{this.setStatusTab}}
      data-test-lease-status-tabs
    />
    <FiltersButton @count={{this.activeFilterCount}}>
      <div class="flex col gap-4">
        <div class="flex gap-3 wrap">
          <Woven::Input
            type="text"
            autocomplete="off"
            placeholder="Search tenant, unit number, registration ref..."
            class="grow"
            value={{this.search}}
            {{on "input" (fn this.updateFilter "search")}}
            data-test-leases-search
          />
        </div>

        <div class="flex gap-3 wrap x-end">
          <Woven::Field class="grow" @label="Type">
            <Woven::Dropdown
              id="leases-type-filter"
              @align="start"
              @value={{this.type}}
              @onSelect={{this.setType}}
              @options={{this.typeFilterOptions}}
              data-test-type-filter
            />
          </Woven::Field>
          <Woven::Field @label="Visibility">
            <Woven::Dropdown
              @align="start"
              @value={{this.archived}}
              @onSelect={{this.setArchivedTab}}
              @options={{this.archivedTabs}}
              data-test-archived-filter
            />
          </Woven::Field>
          <Woven::Field @label="Start date from">
            <input
              type="date"
              class="wu-input"
              aria-label="Start date from"
              value={{this.dateFrom}}
              {{on "change" this.setDateFrom}}
              data-test-date-from-filter
            />
          </Woven::Field>
          <Woven::Field @label="Start date to">
            <input
              type="date"
              class="wu-input"
              aria-label="Start date to"
              value={{this.dateTo}}
              {{on "change" this.setDateTo}}
              data-test-date-to-filter
            />
          </Woven::Field>
        </div>

        <div class="flex end">
          <Woven::Button
            @variant="danger"
            @size="sm"
            @icon="x"
            @disabled={{not this.hasActiveFilters}}
            {{on "click" this.clearFilters}}
            data-test-clear-filters
          >
            Clear filters
          </Woven::Button>
        </div>
      </div>
    </FiltersButton>
  </div>

  <div class="flex col gap-3">
    {{#if @model.leases.length}}
      <Woven::DataTable
        @columns={{this.columns}}
        @rows={{@model.leases}}
        @pinColumns={{true}}
        @reorderable={{true}}
        @sortable={{true}}
        @showOptions={{true}}
        @tableId="leases"
        as |cell|
      >
        {{#if (eq cell.key "contact.displayName")}}
          <LinkTo
            @route="leases.detail"
            @model={{cell.row.id}}
            class="text-brand"
            data-test-lease-row
            data-test-lease-detail-link
          >{{or (contact-name cell.row.contact) "Unknown tenant"}}</LinkTo>
        {{else if (eq cell.key "unit.unitNumber")}}
          {{#if cell.row.unit}}
            <Woven::Button
              @variant="secondary"
              @size="xs"
              @route="properties.unit"
              @models={{array cell.row.unit.areaId cell.row.unit.id}}
              @text={{cell.row.unit.unitNumber}}
              data-test-view-lease-unit
            />
          {{/if}}
        {{else if (eq cell.key "monthlyRent")}}
          <span class="text-muted"><Money
              @amount={{cell.value}}
              @currency={{cell.row.currency}}
            />/mo</span>
        {{else if (eq cell.key "startDate")}}
          <span class="text-muted">{{format-date cell.value}} - {{format-date cell.row.endDate}}</span>
        {{else if (eq cell.key "status")}}
          <div class="flex gap-1 wrap">
            <Woven::Tag
              class="tag-lease-{{lowercase cell.value}}"
              @text={{cell.value}}
            />
            {{#if cell.row.deletedAt}}
              <Woven::Tag
                @variant="secondary"
                @text="Archived"
                data-test-lease-archived-badge
              />
            {{/if}}
          </div>
        {{else if (eq cell.key "tenancyRegistrationRef")}}
          <span class="text-muted">{{or cell.value "-"}}</span>
        {{else if (eq cell.key "id")}}
          <div class="flex">
            {{#if this.canViewHistory}}
              <Woven::Button
                @subtle={{true}}
                @variant="secondary"
                @size="xs"
                @icon="clock-counter-clockwise"
                aria-label="History for lease of {{or
                  (contact-name cell.row.contact)
                  'Unknown tenant'
                }}"
                data-tooltip="History"
                data-test-lease-history
                {{on "click" (fn this.openHistory cell.row)}}
              />
            {{/if}}
            {{#if cell.row.deletedAt}}
              {{#if this.canArchiveLease}}
                <Woven::Button
                  data-test-unarchive-lease
                  @subtle={{true}}
                  @variant="secondary"
                  @size="xs"
                  @icon="arrow-counter-clockwise"
                  aria-label="Unarchive lease for {{contact-name
                    cell.row.contact
                  }}"
                  data-tooltip="Unarchive"
                  {{on "click" (fn this.openArchive cell.row "unarchive")}}
                />
              {{/if}}
            {{else}}
              <Woven::Button
                @subtle={{true}}
                @variant="secondary"
                @size="xs"
                @icon="pencil-simple"
                aria-label="Edit lease for {{contact-name cell.row.contact}}"
                data-tooltip="Edit"
                data-test-edit-lease
                {{on "click" (fn this.openEdit cell.row)}}
              />
              {{#if (eq cell.row.status "ACTIVE")}}
                <Woven::Button
                  data-test-renew-lease
                  @subtle={{true}}
                  @variant="secondary"
                  @size="xs"
                  @icon="arrows-clockwise"
                  aria-label="Renew lease for {{contact-name cell.row.contact}}"
                  data-tooltip="Renew"
                  {{on "click" (fn this.renewLease cell.row)}}
                />
                <Woven::Button
                  data-test-terminate-lease
                  @subtle={{true}}
                  @variant="danger"
                  @size="xs"
                  @icon="x-circle"
                  aria-label="Terminate lease for {{contact-name
                    cell.row.contact
                  }}"
                  data-tooltip="Terminate"
                  {{on "click" (fn this.openTerminate cell.row)}}
                />
              {{/if}}
              {{#if (eq cell.row.status "EXPIRED")}}
                <Woven::Button
                  data-test-renew-lease
                  @subtle={{true}}
                  @variant="secondary"
                  @size="xs"
                  @icon="arrows-clockwise"
                  aria-label="Renew lease for {{contact-name cell.row.contact}}"
                  data-tooltip="Renew"
                  {{on "click" (fn this.renewLease cell.row)}}
                />
              {{/if}}
              {{#if (eq cell.row.status "DRAFT")}}
                {{#if this.canDeleteLease}}
                  <Woven::Button
                    @subtle={{true}}
                    @variant="danger"
                    @size="xs"
                    @icon="trash"
                    aria-label="Delete lease for {{contact-name
                      cell.row.contact
                    }}"
                    data-tooltip="Delete"
                    data-test-delete-lease
                    {{on "click" (fn this.openDelete cell.row)}}
                  />
                {{/if}}
              {{else if this.canArchiveLease}}
                {{#unless (eq cell.row.status "ACTIVE")}}
                  <Woven::Button
                    data-test-archive-lease
                    @subtle={{true}}
                    @variant="secondary"
                    @size="xs"
                    @icon="archive"
                    aria-label="Archive lease for {{contact-name
                      cell.row.contact
                    }}"
                    data-tooltip="Archive"
                    {{on "click" (fn this.openArchive cell.row "archive")}}
                  />
                {{/unless}}
              {{/if}}
            {{/if}}
          </div>
        {{else}}
          <span class="text-muted">{{cell.value}}</span>
        {{/if}}
      </Woven::DataTable>
    {{else}}
      {{#if @model.total}}
        <Woven::EmptyState
          @description="No leases on page {{this.page}}. Navigate back or adjust your filters."
        />
      {{else}}
        <Woven::EmptyState
          @description="No leases yet. Create your first lease agreement."
        />
      {{/if}}
    {{/if}}

    {{#if @model.total}}
      <Woven::Pagination
        @selectId="leases-limit"
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{@model.total}}
        @onLimitChange={{this.setLimit}}
        @onPrevious={{this.goToPreviousPage}}
        @onNext={{this.goToNextPage}}
        @onPageChange={{this.goToPage}}
      />
    {{/if}}
  </div>
</div>

<Leases::LeaseDrawer
  @open={{this.showModal}}
  @mode={{this.drawerMode}}
  @lease={{this.drawerLease}}
  @onClose={{this.closeModal}}
  @onClosed={{this.resetDrawer}}
  @onSaved={{this.refresh}}
/>

<Leases::TerminateModal
  @open={{this.showTerminateModal}}
  @lease={{this.leaseToTerminate}}
  @onClose={{this.closeTerminateModal}}
  @onTerminated={{this.refresh}}
/>

<ConfirmModal
  @open={{this.showDeleteModal}}
  @title="Delete Lease"
  @message="Delete the lease for {{or
    (contact-name this.leaseToDelete.contact)
    'this tenant'
  }}? This cannot be undone."
  @confirmText="Delete"
  @cancelText="I changed my mind"
  @confirmVariant="danger"
  @isConfirming={{this.isDeleting}}
  @confirmingText="Deleting..."
  @onClose={{this.closeDeleteModal}}
  @onConfirm={{this.confirmDelete}}
>
  <Woven::Field class="mt-4" @label="Reason" @required={{true}} @error={{this.reasonError}}>
    <Woven::Textarea
      id="lease-delete-reason"
      rows="2"
      maxlength="500"
      placeholder="e.g. Created by mistake"
      @value={{this.deleteReason}}
      @onInput={{fn this.setFieldValue "deleteReason"}}
      @invalid={{if this.reasonError true false}}
      aria-label="Reason"
      data-test-reason-input
    />
  </Woven::Field>
</ConfirmModal>

<ConfirmModal
  @open={{this.showArchiveModal}}
  @title={{if (eq this.archiveMode "archive") "Archive Lease" "Unarchive Lease"}}
  @message={{concat
    (if
      (eq this.archiveMode "archive")
      "Archive the lease for "
      "Unarchive the lease for "
    )
    (or (contact-name this.leaseToArchive.contact) "this tenant")
    (if
      (eq this.archiveMode "archive")
      "? It becomes read-only and hidden from lists. You can unarchive it later."
      "? It becomes active and editable again."
    )
  }}
  @confirmText={{if (eq this.archiveMode "archive") "Archive" "Unarchive"}}
  @cancelText="I changed my mind"
  @confirmVariant="primary"
  @isConfirming={{this.isArchiving}}
  @confirmingText={{if (eq this.archiveMode "archive") "Archiving..." "Unarchiving..."}}
  @onClose={{this.closeArchiveModal}}
  @onConfirm={{this.confirmArchive}}
>
  <Woven::Field
    class="mt-4"
    @label={{if (eq this.archiveMode "archive") "Reason" "Reason (optional)"}}
    @required={{eq this.archiveMode "archive"}}
    @error={{this.reasonError}}
  >
    <Woven::Textarea
      id="lease-archive-reason"
      rows="2"
      maxlength="500"
      placeholder="e.g. Contract closed"
      @value={{this.archiveReason}}
      @onInput={{fn this.setFieldValue "archiveReason"}}
      @invalid={{if this.reasonError true false}}
      aria-label="Reason"
      data-test-reason-input
    />
  </Woven::Field>
</ConfirmModal>

<Woven::Drawer
  @open={{if this.historyLease true false}}
  @title="Lease History"
  @placement="end"
  @size="lg"
  @onClose={{this.closeHistory}}
>
  <:body>
    {{#if this.historyLease}}
      <RecordHistoryList @entityType="Lease" @entityId={{this.historyLease.id}} />
    {{/if}}
  </:body>
</Woven::Drawer>
