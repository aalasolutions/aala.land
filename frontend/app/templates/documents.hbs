{{page-title "Documents"}}

<div data-test-documents class="flex col gap-6">
  <Nuvo::PageHeader
    @title="Documents"
    @subtitle="Store and organise property paperwork."
  >
    <:meta>
      <p class="text-muted">{{format-number @model.total unit="document"}}</p>
    </:meta>
    <:actions>
      <Nuvo::Button
        @variant="primary"
        data-test-upload-btn
        @icon="upload-simple"
        {{on "click" this.openCreate}}
      >
        Upload Document
      </Nuvo::Button>
    </:actions>
  </Nuvo::PageHeader>

  <div class="flex gap-3">
    <Nuvo::Dropdown
      id="document-category-filter"
      @align="start"
      @value={{this.category}}
      @onSelect={{this.setCategory}}
      @options={{this.categories}}
      @placeholder="All Categories"
      data-test-category-filter
    />
  </div>

  {{#if @model.documents.length}}
    <Nuvo::Card>
      <div class="nu-table-wrapper">
        <table class="nu-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Category</th>
              <th>Access</th>
              <th>Property</th>
              <th>Size</th>
              <th>Uploaded By</th>
              <th>Uploaded</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each @model.documents as |doc|}}
              <tr data-test-document-row>
                <td>
                  <div class="flex x-center gap-2">
                    <Ui::Ph @icon="file-text" />
                    <span class="font-bold">{{doc.name}}</span>
                  </div>
                </td>
                <td><Nuvo::Tag
                    class="tag-doc-{{lowercase doc.category}}"
                    @text={{doc.category}}
                  /></td>
                <td><Nuvo::Tag
                    class="tag-access-{{lowercase doc.accessLevel}}"
                    @text={{doc.accessLevel}}
                  /></td>
                <td class="text-sm" data-test-document-property>
                  {{#if doc.unit}}
                    <LinkTo
                      @route="properties.unit"
                      @models={{array doc.unit.areaId doc.unit.id}}
                      class="text-primary"
                    >{{doc.unit.assetName}}
                      -
                      {{doc.unit.unitNumber}}</LinkTo>
                  {{else}}
                    <span class="text-muted">—</span>
                  {{/if}}
                </td>
                <td class="text-sm text-muted">{{format-bytes
                    doc.fileSize
                  }}</td>
                <td class="text-sm text-muted" data-test-document-uploader>{{if
                    doc.uploadedByName
                    doc.uploadedByName
                    "—"
                  }}</td>
                <td class="text-sm text-muted">{{format-date
                    doc.createdAt
                  }}</td>
                <td>
                  <div class="flex gap-2">
                    <Nuvo::Button
                      @variant="secondary"
                      @size="xs"
                      data-test-download-btn
                      @icon="download-simple"
                      {{on "click" (fn this.downloadDocument doc)}}
                    />
                    <Nuvo::Button
                      @variant="secondary"
                      @size="xs"
                      data-test-edit-btn
                      @icon="pencil-simple"
                      {{on "click" (fn this.openEdit doc)}}
                    />
                    <Nuvo::Button
                      @variant="danger"
                      @size="xs"
                      data-test-delete-btn
                      @icon="trash"
                      {{on "click" (fn this.openDelete doc)}}
                    />
                  </div>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      <Nuvo::Pagination
        @selectId="documents-limit"
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{@model.total}}
        @onLimitChange={{this.setLimit}}
        @onPrevious={{this.goToPreviousPage}}
        @onNext={{this.goToNextPage}}
      />
    </Nuvo::Card>
  {{else}}
    {{#if @model.total}}
      <Nuvo::Card>
        <Nuvo::EmptyState
          @description="No documents on page {{this.page}}. Navigate back to find documents."
        />
      </Nuvo::Card>
      <Nuvo::Pagination
        @selectId="documents-limit"
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{@model.total}}
        @onLimitChange={{this.setLimit}}
        @onPrevious={{this.goToPreviousPage}}
        @onNext={{this.goToNextPage}}
      />
    {{else}}
      <Nuvo::Card>
        <div class="flex col x-center gap-2 py-8" data-test-documents-empty>
          <Ui::Ph @icon="file-arrow-up" @size="48px" @color="var(--text-muted)" />
          <p class="text-muted">No documents yet. Upload your first document
            above.</p>
        </div>
      </Nuvo::Card>
    {{/if}}
  {{/if}}
</div>

<Nuvo::Modal
  @open={{this.showModal}}
  @title={{if this.editDocument "Update Document" "Upload Document"}}
  @onClose={{this.closeModal}}
>
  <form class="flex col gap-4" {{on "submit" this.saveDocument}}>
    <div class="flex col gap-2">
      <label class="text-sm text-muted" for="d-file">File
        {{unless this.editDocument "*"}}</label>
      <input
        id="d-file"
        type="file"
        class="nu-input"
        data-test-file-input
        accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.rtf,.txt,.md,.csv,.jpg,.jpeg,.png,.webp,.gif"
        {{on "change" this.onFileSelect}}
      />
      {{#if this.selectedFile}}
        <p class="text-xs text-muted" data-test-selected-file>
          Selected:
          {{this.selectedFile.name}}
          ({{format-bytes this.selectedFile.size}})
        </p>
      {{/if}}
    </div>

    <Nuvo::Field @label="Document Name" @required={{true}}>
      <Nuvo::Input
        id="d-name"
        type="text"
        placeholder="Lease Agreement Q1 2026"
        @value={{this.formName}}
        @onInput={{fn this.setFieldValue "formName"}}
        required={{true}}
        data-test-field-name
      />
    </Nuvo::Field>

    <div class="flex gap-4">
      <Nuvo::Field class="grow" @label="Category">
        <Nuvo::Dropdown
          id="d-category"
          @align="start"
          @value={{this.formCategory}}
          @onSelect={{fn this.setFieldValue "formCategory"}}
          @options={{this.categoryOptions}}
          @placeholder="Select category..."
          data-test-field-category
        />
      </Nuvo::Field>
      <Nuvo::Field class="grow" @label="Access Level">
        <Nuvo::Dropdown
          id="d-access"
          @align="start"
          @value={{this.formAccessLevel}}
          @onSelect={{fn this.setFieldValue "formAccessLevel"}}
          @options={{this.accessLevels}}
          @placeholder="Select access level..."
          data-test-field-access
        />
      </Nuvo::Field>
    </div>

    {{#if this.uploadProgress}}
      <p
        class="text-sm text-muted"
        data-test-upload-progress
      >{{this.uploadProgress}}</p>
    {{/if}}

    {{#if this.errorMsg}}
      <p class="text-sm text-danger" data-test-error>{{this.errorMsg}}</p>
    {{/if}}

    <Nuvo::FormActions @align="end">
      <Nuvo::Button
        @variant="secondary"
        @onClick={{this.closeModal}}
      >Cancel</Nuvo::Button>
      <Nuvo::Button
        @variant="primary"
        @type="submit"
        @loading={{this.isSaving}}
        data-test-save-btn
      >{{if
          this.isSaving
          "Uploading..."
          (if this.editDocument "Update" "Upload")
        }}</Nuvo::Button>
    </Nuvo::FormActions>
  </form>
</Nuvo::Modal>

<ConfirmModal
  @open={{this.showDeleteModal}}
  @title="Delete Document"
  @message="Are you sure you want to delete {{this.documentToDelete.name}}? This action cannot be undone."
  @confirmText="Delete"
  @cancelText="Cancel"
  @confirmVariant="danger"
  @isConfirming={{this.isDeleting}}
  @confirmingText="Deleting..."
  @onClose={{this.closeDeleteModal}}
  @onConfirm={{this.confirmDelete}}
/>
