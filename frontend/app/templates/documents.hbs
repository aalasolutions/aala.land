{{page-title "Documents"}}

<div data-test-documents class="flex col gap-6">
  <Documents::Panel
    @tableId="documents"
    @filters={{this.panelFilters}}
    @filtered={{this.hasActiveFilters}}
    @page={{this.page}}
    @pageSize={{this.limit}}
    @onPageChange={{this.setPage}}
    @onPageSizeChange={{this.setLimit}}
  >
    <:header as |panel|>
      <Nuvo::PageHeader
        @title="Documents"
        @subtitle="Store and organise property paperwork."
      >
        <:meta>
          <p class="text-muted">{{format-number
              panel.total
              unit="document"
            }}</p>
        </:meta>
        <:actions>
          {{#if panel.canUpload}}
            <Nuvo::Button
              @variant="primary"
              data-test-upload-btn
              @icon="upload-simple"
              {{on "click" panel.openUpload}}
            >
              Upload Document
            </Nuvo::Button>
          {{/if}}
        </:actions>
      </Nuvo::PageHeader>

      <Nuvo::Accordion
        @items={{array
          (hash
            id="filters"
            title=(if this.hasActiveFilters "Filters · active" "Filters")
          )
        }}
        data-test-filters-accordion
      >
        <div class="flex col gap-4">
          <div class="flex gap-3 wrap">
            <Nuvo::Input
              type="text"
              autocomplete="off"
              placeholder="Search document name..."
              class="grow"
              value={{this.search}}
              {{on "input" (fn this.updateFilter "search")}}
              data-test-documents-search
            />
          </div>

          <div class="flex gap-3 wrap x-end">
            <Nuvo::Field
              class="grow"
              @label="Related To"
              @tooltip="Filter by the kind of record a file is linked to. Library only means no link."
            >
              <Nuvo::Dropdown
                id="document-related-filter"
                @align="start"
                @value={{this.related}}
                @onSelect={{this.setRelated}}
                @options={{this.relatedTypes}}
                data-test-related-filter
              />
            </Nuvo::Field>
            <Nuvo::Field class="grow" @label="Category">
              <Nuvo::Dropdown
                id="document-category-filter"
                @align="start"
                @value={{this.category}}
                @onSelect={{this.setCategory}}
                @options={{this.categories}}
                @placeholder="All Categories"
                data-test-category-filter
              />
            </Nuvo::Field>
            <Nuvo::Field
              class="grow"
              @label="Access Level"
              @tooltip="Filter by who can open a file. Team files are open to all staff, Admin files only to admins."
            >
              <Nuvo::Dropdown
                id="document-access-filter"
                @align="start"
                @value={{this.accessLevel}}
                @onSelect={{this.setAccessLevelFilter}}
                @options={{this.accessLevelFilterOptions}}
                data-test-access-filter
              />
            </Nuvo::Field>
            <Nuvo::Field @label="Uploaded from">
              <input
                type="date"
                class="nu-input"
                aria-label="Uploaded from"
                value={{this.dateFrom}}
                {{on "change" this.setDateFrom}}
                data-test-date-from-filter
              />
            </Nuvo::Field>
            <Nuvo::Field @label="Uploaded to">
              <input
                type="date"
                class="nu-input"
                aria-label="Uploaded to"
                value={{this.dateTo}}
                {{on "change" this.setDateTo}}
                data-test-date-to-filter
              />
            </Nuvo::Field>
          </div>

          {{#if this.hasActiveFilters}}
            <div class="flex end">
              <Nuvo::Button
                @variant="danger"
                @size="sm"
                @icon="x"
                {{on "click" this.clearFilters}}
                data-test-clear-filters
              >
                Clear filters
              </Nuvo::Button>
            </div>
          {{/if}}
        </div>
      </Nuvo::Accordion>
    </:header>
  </Documents::Panel>
</div>