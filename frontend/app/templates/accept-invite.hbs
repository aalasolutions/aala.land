{{page-title "Accept Invitation"}}

<div class="login-page">
  <Woven::Card class="login-card flex col gap-8">
    <div class="text-center">
      <h1 class="auth-brand-title">AALA.LAND</h1>
      <p class="text-muted text-sm mt-2">Set your password to activate your
        account</p>
    </div>

    {{#if this.done}}
      <div class="flex col gap-4 text-center">
        <p class="text-success text-sm">Your password has been set. You can now
          sign in.</p>
        <Woven::Button @variant="primary" {{on "click" this.goToLogin}}>
          Go to Login
        </Woven::Button>
      </div>
    {{else}}
      <form class="wu-form" novalidate {{on "submit" this.submit}}>
        <Woven::Field
          @label="New Password"
          @required={{true}}
          @error={{this.fieldErrors.password}}
        >
          <Woven::Input
            id="ai-password"
            type="password"
            placeholder="At least 8 characters"
            @value={{this.password}}
            @onInput={{fn this.setFieldValue "password"}}
            required={{true}}
          />
        </Woven::Field>

        <Woven::Field
          @label="Confirm Password"
          @required={{true}}
          @error={{this.fieldErrors.confirmPassword}}
        >
          <Woven::Input
            id="ai-confirm"
            type="password"
            placeholder="Repeat your password"
            @value={{this.confirmPassword}}
            @onInput={{fn this.setFieldValue "confirmPassword"}}
            required={{true}}
          />
        </Woven::Field>

        {{#if this.errorMsg}}
          <Woven::Alert @variant="danger" @description={{this.errorMsg}} />
        {{/if}}

        <Woven::Button
          type="submit"
          @variant="primary"
          @disabled={{this.isSubmitting}}
          @loading={{this.isSubmitting}}
        >
          {{if this.isSubmitting "Setting password..." "Activate Account"}}
        </Woven::Button>
      </form>

      <div class="text-center">
        <p class="text-sm text-muted">
          Already have an account?
          <LinkTo @route="login" class="text-brand">Sign in</LinkTo>
        </p>
      </div>
    {{/if}}
  </Woven::Card>
</div>