{{page-title "Accept Invitation"}}

<div class="login-page">
  <Nuvo::Card class="login-card flex col gap-8">
    <div class="text-center">
      <h1 class="auth-brand-title">AALA.LAND</h1>
      <p class="text-muted text-sm mt-2">Set your password to activate your
        account</p>
    </div>

    {{#if this.done}}
      <div class="flex col gap-4 text-center">
        <p class="text-success text-sm">Your password has been set. You can now
          sign in.</p>
        <Nuvo::Button @variant="primary" {{on "click" this.goToLogin}}>
          Go to Login
        </Nuvo::Button>
      </div>
    {{else}}
      <form class="flex col gap-4" {{on "submit" this.submit}}>
        <Nuvo::Field @label="New Password" @required={{true}}>
          <Nuvo::Input
            id="ai-password"
            type="password"
            placeholder="At least 8 characters"
            @value={{this.password}}
            @onInput={{fn this.setFieldValue "password"}}
            required={{true}}
          />
        </Nuvo::Field>

        <Nuvo::Field @label="Confirm Password" @required={{true}}>
          <Nuvo::Input
            id="ai-confirm"
            type="password"
            placeholder="Repeat your password"
            @value={{this.confirmPassword}}
            @onInput={{fn this.setFieldValue "confirmPassword"}}
            required={{true}}
          />
        </Nuvo::Field>

        {{#if this.errorMsg}}
          <Nuvo::Alert @variant="danger" @message={{this.errorMsg}} />
        {{/if}}

        <Nuvo::Button
          type="submit"
          @variant="primary"
          @disabled={{this.isSubmitting}}
          @loading={{this.isSubmitting}}
        >
          {{if this.isSubmitting "Setting password..." "Activate Account"}}
        </Nuvo::Button>
      </form>

      <div class="text-center">
        <p class="text-sm text-muted">
          Already have an account?
          <LinkTo @route="login" class="text-primary">Sign in</LinkTo>
        </p>
      </div>
    {{/if}}
  </Nuvo::Card>
</div>