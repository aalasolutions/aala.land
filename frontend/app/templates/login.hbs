{{page-title "Sign In"}}

<div data-test-login-page class="login-page">
  <Nuvo::Card class="login-card">
    <div class="flex col gap-8">
      <div class="text-center">
        <Nuvo::Title @tag="h1" @size="2xl" @text="AALA.LAND" />
        <p class="text-muted text-sm mt-2">Sign in to your command center</p>
      </div>

      <LoginForm />
      <div class="text-center">
        <p class="text-sm text-muted">
          Don't have an account?
          <LinkTo @route="signup" class="text-primary">Create one</LinkTo>
        </p>
      </div>
    </div>
  </Nuvo::Card>
</div>