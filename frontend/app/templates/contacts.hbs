{{page-title "Contacts"}}

<div data-test-contacts class="flex col gap-6">
  <Nuvo::PageHeader @title="Contacts">
    <:meta>
      <p class="text-muted">({{format-number @model.total}} total)</p>
    </:meta>
    <:actions>
      <Nuvo::Button
        @variant="primary"
        @icon="+"
        {{on "click" this.openCreate}}
      >
        New Contact
      </Nuvo::Button>
    </:actions>
  </Nuvo::PageHeader>

  <div class="flex gap-3">
    <Nuvo::Input
      type="text"
      autocomplete="off"
      placeholder="Search contacts..."
      class="grow"
      value={{this.search}}
      {{on "input" this.updateSearch}}
    />
  </div>

  <Nuvo::Card>
    {{#if @model.contacts.length}}
      <div class="nu-table-wrapper">
        <table class="nu-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Type</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Company</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each @model.contacts as |contact|}}
              <tr data-test-contact-row>
                <td class="font-bold">{{contact.firstName}} {{contact.lastName}}</td>
                <td>
                  <Nuvo::Tag
                    class="badge-contact-{{lowercase contact.type}}"
                    @text={{contact.type}}
                  />
                </td>
                <td class="text-muted">{{contact.email}}</td>
                <td class="text-muted">{{contact.phone}}</td>
                <td class="text-muted">{{contact.contactCompany}}</td>
                <td>
                  <div class="flex gap-2">
                    <Nuvo::Button
                      @variant="secondary"
                      @size="xs"
                      @icon="✎"
                      {{on "click" (fn this.openEdit contact)}}
                    >
                      Edit
                    </Nuvo::Button>
                    <Nuvo::Button
                      @variant="danger"
                      @size="xs"
                      @icon="✕"
                      {{on "click" (fn this.openDelete contact)}}
                    />
                  </div>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      <Nuvo::Pagination
        @selectId="contacts-limit"
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{@model.total}}
        @onLimitChange={{this.setLimit}}
        @onPrevious={{this.goToPreviousPage}}
        @onNext={{this.goToNextPage}}
      />
    {{else}}
      {{#if @model.total}}
        <p class="text-muted text-center py-8">No contacts on page
          {{this.page}}. Navigate back to find contacts or adjust your search.</p>
        <Nuvo::Pagination
          @selectId="contacts-limit"
          @page={{this.page}}
          @limit={{this.limit}}
          @total={{@model.total}}
          @onLimitChange={{this.setLimit}}
          @onPrevious={{this.goToPreviousPage}}
          @onNext={{this.goToNextPage}}
        />
      {{else}}
        <Nuvo::EmptyState
          @icon="👤"
          @description="No contacts yet. Add your first contact above."
        />
      {{/if}}
    {{/if}}
  </Nuvo::Card>
</div>

<Nuvo::Modal
  @open={{this.showModal}}
  @title={{if this.editContact "Edit Contact" "New Contact"}}
  @onClose={{this.closeModal}}
>
  <form class="flex col gap-4" {{on "submit" this.saveContact}}>
    <div class="flex gap-4">
      <Nuvo::Field class="grow" @label="First Name" @required={{true}}>
        <Nuvo::Input
          id="c-fname"
          type="text"
          placeholder="Ahmed"
          @value={{this.formFirstName}}
          @onInput={{fn this.setFieldValue "formFirstName"}}
          required={{true}}
          data-test-input-first-name
        />
      </Nuvo::Field>
      <Nuvo::Field class="grow" @label="Last Name">
        <Nuvo::Input
          id="c-lname"
          type="text"
          placeholder="Al-Rashid"
          @value={{this.formLastName}}
          @onInput={{fn this.setFieldValue "formLastName"}}
          data-test-input-last-name
        />
      </Nuvo::Field>
    </div>

    <div class="flex gap-4">
      <Nuvo::Field class="grow" @label="Email">
        <Nuvo::Input
          id="c-email"
          type="email"
          placeholder="ahmed@example.com"
          @value={{this.formEmail}}
          @onInput={{fn this.setFieldValue "formEmail"}}
          data-test-input-email
        />
      </Nuvo::Field>
      <Nuvo::Field class="grow" @label="Type">
        <Nuvo::Dropdown
          id="c-type"
          @align="start"
          @value={{this.formType}}
          @onSelect={{fn this.setFieldValue "formType"}}
          @options={{this.contactTypes}}
          @placeholder="Select type..."
          data-test-input-type
        />
      </Nuvo::Field>
    </div>

    <div class="flex gap-4">
      <Nuvo::Field class="grow" @label="Phone">
        <Nuvo::Input
          id="c-phone"
          type="text"
          placeholder="+971501234567"
          @value={{this.formPhone}}
          @onInput={{fn this.setFieldValue "formPhone"}}
          data-test-input-phone
        />
      </Nuvo::Field>
      <Nuvo::Field class="grow" @label="WhatsApp">
        <Nuvo::Input
          id="c-whatsapp"
          type="text"
          placeholder="+971501234567"
          @value={{this.formWhatsappNumber}}
          @onInput={{fn this.setFieldValue "formWhatsappNumber"}}
          data-test-input-whatsapp
        />
      </Nuvo::Field>
    </div>

    <div class="flex gap-4">
      <Nuvo::Field class="grow" @label="Company">
        <Nuvo::Input
          id="c-company"
          type="text"
          placeholder="Emaar Properties"
          @value={{this.formContactCompany}}
          @onInput={{fn this.setFieldValue "formContactCompany"}}
          data-test-input-company
        />
      </Nuvo::Field>
      <Nuvo::Field class="grow" @label="Job Title">
        <Nuvo::Input
          id="c-job"
          type="text"
          placeholder="Property Manager"
          @value={{this.formJobTitle}}
          @onInput={{fn this.setFieldValue "formJobTitle"}}
          data-test-input-job-title
        />
      </Nuvo::Field>
    </div>

    <Nuvo::Field @label="Address">
      <Nuvo::Input
        id="c-address"
        type="text"
        placeholder="e.g. Gulberg, Lahore"
        @value={{this.formAddress}}
        @onInput={{fn this.setFieldValue "formAddress"}}
        data-test-input-address
      />
    </Nuvo::Field>

    <Nuvo::Field @label="Notes">
      <Nuvo::Textarea
        id="c-notes"
        placeholder="Additional notes..."
        rows="3"
        @value={{this.formNotes}}
        @onInput={{fn this.setFieldValue "formNotes"}}
        data-test-input-notes
      />
    </Nuvo::Field>

    {{#if this.errorMsg}}
      <p class="text-sm text-danger" data-test-error>{{this.errorMsg}}</p>
    {{/if}}

    <Nuvo::FormActions @align="end">
      <Nuvo::Button
        @variant="secondary"
        @onClick={{this.closeModal}}
      >Cancel</Nuvo::Button>
      <Nuvo::Button
        @variant="primary"
        @type="submit"
        @loading={{this.isSaving}}
      >{{if
          this.isSaving
          "Saving..."
          (if this.editContact "Update" "Create Contact")
        }}</Nuvo::Button>
    </Nuvo::FormActions>
  </form>
</Nuvo::Modal>

<ConfirmModal
  @open={{this.showDeleteModal}}
  @title="Delete Contact"
  @message="Are you sure you want to delete {{this.contactToDelete.firstName}} {{this.contactToDelete.lastName}}? This action cannot be undone."
  @confirmText="Delete"
  @cancelText="Cancel"
  @confirmVariant="danger"
  @isConfirming={{this.isDeleting}}
  @confirmingText="Deleting..."
  @onClose={{this.closeDeleteModal}}
  @onConfirm={{this.confirmDelete}}
/>
