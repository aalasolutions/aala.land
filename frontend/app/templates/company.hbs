{{page-title "Company Settings"}}

<div data-test-company-page class="flex col gap-6">
  <Nuvo::PageHeader
    @title="Company Settings"
    @subtitle="Manage your company information."
  />

  {{#if this.company}}
    <div class="plan-banner tag-plan-{{lowercase (or this.company.subscriptionTier "FREE")}}">
      <div>
        <div class="plan-banner__name">{{or
            this.company.subscriptionTier
            "FREE"
          }}</div>
        <div class="plan-banner__limits">{{this.planLimits}}</div>
      </div>
      {{#if this.company.subscriptionExpiresAt}}
        <div class="plan-banner__expiry">
          Expires
          {{format-date this.company.subscriptionExpiresAt}}
        </div>
      {{/if}}
    </div>

    {{#if this.isCompanyAdmin}}
      <Nuvo::Tabs
        @tabs={{this.settingsTabs}}
        @activeTab={{this.activeTab}}
        @onChange={{this.setTab}}
      />
    {{/if}}

  {{#if (eq this.activeTab "ai")}}
    {{#if this.creditUsageLabel}}
      <Nuvo::Card class="max-w-lg text-muted text-sm">
        <div data-test-ai-credit-usage>{{this.creditUsageLabel}}</div>
        <div class="text-xs mt-1">1 credit covers 24 hours of unlimited replies
          with one lead.</div>
      </Nuvo::Card>
    {{/if}}

    {{#if this.hasCreditAgents}}
      <Nuvo::Card class="max-w-lg">
        <div class="text-sm font-bold mb-2">AI credits by agent</div>
        <div class="nu-table-wrapper">
          <table class="nu-table" data-test-credit-agents>
            <thead>
              <tr>
                <th>Agent</th>
                <th>Credits</th>
                <th>Leads</th>
                <th>AI turns</th>
              </tr>
            </thead>
            <tbody>
              {{#each this.creditAgents as |agent|}}
                <tr data-test-credit-agent-row={{agent.userId}}>
                  <td>{{agent.name}}</td>
                  <td>{{agent.credits}}</td>
                  <td>{{agent.leads}}</td>
                  <td>{{agent.aiTurns}}</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </Nuvo::Card>
    {{/if}}

    <Nuvo::Card class="max-w-lg">
      <form aria-label="AI Settings" {{on "submit" this.saveAISettings}}>
        <Nuvo::Field @label="AI System Prompt">
          <Nuvo::Textarea
            id="company-ai-prompt"
            data-test-ai-prompt
            rows="10"
            placeholder="Leave empty to use the default prompt"
            @value={{this.aiPrompt}}
            @onInput={{this.setAIPrompt}}
          />
          <p class="text-muted text-sm mt-1">
            This prompt tells the AI how to respond on behalf of your company.
            Leave blank to use the built-in default.
          </p>
        </Nuvo::Field>

        {{#if this.aiSuccessMsg}}
          <p class="text-success text-sm">{{this.aiSuccessMsg}}</p>
        {{/if}}
        {{#if this.aiErrorMsg}}
          <p class="text-danger text-sm">{{this.aiErrorMsg}}</p>
        {{/if}}

        <Nuvo::FormActions>
          <Nuvo::Button
            @variant="primary"
            @type="submit"
            @loading={{this.isSavingAI}}
            data-test-save-prompt
          >
            {{if this.isSavingAI "Saving…" "Save"}}
          </Nuvo::Button>
          <Nuvo::Button
            @variant="secondary"
            @disabled={{this.isSavingAI}}
            data-test-restore-prompt
            {{on "click" this.restoreDefaultPrompt}}
          >
            Restore Default
          </Nuvo::Button>
        </Nuvo::FormActions>
      </form>
    </Nuvo::Card>
  {{else if (eq this.activeTab "billing")}}
    <Nuvo::Card class="max-w-lg" data-test-billing-panel>
      <h3 class="text-lg font-bold mb-4">Plan and Billing</h3>

      {{#if this.billing}}
        {{#if this.isScheduledToCancel}}
          <Nuvo::Alert
            @variant="warning"
            class="mb-4"
            data-test-cancel-scheduled
          >
            <div class="font-bold">Scheduled to move to the Free plan</div>
            <p class="text-sm mt-1">
              Your paid plan is set to end on
              <strong>{{this.cancelDateLabel}}</strong>. You have already paid
              through that date, so you keep full access until then. It
              switches to Free automatically. Changed your mind? Reactivate
              below.
            </p>
          </Nuvo::Alert>
        {{/if}}
        <div class="billing-plan-card mb-4" data-test-plan-card>
          <div class="flex between x-center">
            <div
              class="text-xl font-bold"
              data-test-plan-name
            >{{this.billing.tier}}</div>
            {{#if this.billing.billingStatus}}
              <Nuvo::Tag
                class="tag-sub-{{this.billingStatusBadgeValue}}"
                @text={{this.billing.billingStatus}}
                data-test-billing-status
              />
            {{/if}}
          </div>
          <p class="text-sm text-muted mt-2" data-test-seat-count>
            {{this.seatSummaryLabel}}
          </p>
          {{#if this.seatPriceLabel}}
            <p
              class="text-sm text-muted"
              data-test-seat-price
            >{{this.seatPriceLabel}}</p>
          {{/if}}
          {{#if this.purchasedCurrency}}
            <p class="text-sm text-muted" data-test-billed-currency>
              Billed in
              {{this.purchasedCurrency}}, locked to your account.
            </p>
          {{/if}}
        </div>

        {{#if this.isFreeTier}}
          {{#if this.paymentCurrencyOptions.length}}
            <Nuvo::Field
              @label="Select your Payment currency"
              class="mb-3"
              data-test-currency-select
            >
              <Nuvo::Dropdown
                @align="start"
                @value={{this.selectedCurrency}}
                @onSelect={{fn this.setFieldValue "selectedCurrency"}}
                @options={{this.paymentCurrencyOptions}}
              />
              <p
                class="text-sm text-muted mt-1"
                data-test-currency-lock-note
              >Locked to your account once you subscribe.</p>
            </Nuvo::Field>
          {{/if}}
          <Nuvo::Button
            @variant="primary"
            @loading={{this.isBillingBusy}}
            data-test-upgrade-pro
            {{on "click" this.upgradeToPro}}
          >
            {{if this.isBillingBusy "Starting checkout..." "Upgrade to Pro"}}
          </Nuvo::Button>
          <p class="text-sm text-muted mt-3">
            Every Pro seat adds 5 GB of storage. Need white-label, ERP
            integration, or dedicated infrastructure?
            <a
              href="mailto:info@aalasolutions.com?subject=AALA%20Enterprise"
              data-test-contact-enterprise
            >Contact us about Enterprise</a>.
          </p>
        {{else if this.billing.hasSubscription}}
          {{#if this.isScheduledToCancel}}
            <Nuvo::Button
              @variant="primary"
              @loading={{this.isBillingBusy}}
              data-test-reactivate-pro
              {{on "click" this.reactivatePro}}
            >
              {{if this.isBillingBusy "Working..." "Reactivate plan"}}
            </Nuvo::Button>
          {{else}}
            <Nuvo::Button
              @variant="danger"
              @disabled={{this.isDowngradeDisabled}}
              data-test-downgrade-free
              {{on "click" this.openDowngradeConfirm}}
            >
              Downgrade to Free
            </Nuvo::Button>
            {{#unless this.billing.canDowngradeToFree}}
              <p
                class="text-sm text-muted mt-2"
                data-test-downgrade-blocked-hint
              >
                Downgrading requires exactly 1 active user. You currently have
                {{this.billing.activeUsers}}. Deactivate the other team members
                first.
              </p>
            {{/unless}}
          {{/if}}
        {{else}}
          <p class="text-sm text-muted" data-test-billing-managed>
            Your plan is managed by AALA. Contact support to make changes.
          </p>
        {{/if}}
      {{else}}
        <p class="text-muted" data-test-billing-unavailable>Billing information
          is unavailable right now.</p>
      {{/if}}
    </Nuvo::Card>

    {{#if this.isCompanyAdmin}}
      <Nuvo::Card class="mt-4" data-test-billing-history-panel>
        <h3 class="text-lg font-bold mb-4">Billing History</h3>
        {{#if this.billingHistory.length}}
          <div class="nu-table-wrapper">
            <table class="nu-table">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Amount</th>
                  <th>Status</th>
                  <th>Invoice</th>
                </tr>
              </thead>
              <tbody>
                {{#each this.billingHistory as |record|}}
                  <tr data-test-billing-history-row>
                    <td>{{format-date record.occurredAt}}</td>
                    <td class="font-bold">{{format-money
                        record.amount
                        record.currency
                      }}</td>
                    <td>
                      {{#if (eq record.type "payment_succeeded")}}
                        <Nuvo::Tag
                          class="tag-txn-completed"
                          @text="Paid"
                          data-test-history-status
                        />
                      {{else}}
                        <Nuvo::Tag
                          class="tag-txn-failed"
                          @text="Failed"
                          data-test-history-status
                        />
                      {{/if}}
                    </td>
                    <td>
                      {{#if record.hostedInvoiceUrl}}
                        <a
                          href={{record.hostedInvoiceUrl}}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="link"
                          data-test-history-invoice-link
                        >
                          <Ui::Ph @icon="receipt" />
                          View
                        </a>
                      {{else}}
                        <span class="text-muted">&mdash;</span>
                      {{/if}}
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
          <Nuvo::Pagination
            @selectId="billing-history-limit"
            @page={{this.billingHistoryPage}}
            @limit={{this.billingHistoryLimit}}
            @total={{this.billingHistoryTotal}}
            @onLimitChange={{this.setBillingHistoryLimit}}
            @onPrevious={{this.billingHistoryPrevious}}
            @onNext={{this.billingHistoryNext}}
          />
        {{else}}
          <p class="text-muted" data-test-billing-history-empty>No payments yet.
            Invoices appear here after your first charge.</p>
        {{/if}}
      </Nuvo::Card>
    {{/if}}

    <ConfirmModal
      @open={{this.showDowngradeConfirm}}
      @title="Downgrade to Free"
      @message="Your subscription will be canceled at the end of the current billing period. Paid features, extra seats, and per-seat storage go away when it ends. Nothing is deleted, but uploads beyond the Free 2 GB quota will be blocked."
      @confirmText="Downgrade to Free"
      @confirmingText="Canceling..."
      @confirmVariant="danger"
      @cancelText="Keep my plan"
      @isConfirming={{this.isBillingBusy}}
      @onClose={{this.closeDowngradeConfirm}}
      @onConfirm={{this.confirmDowngrade}}
    />
  {{else}}
    <div class="company-settings-grid">
      {{! Left: Company Info }}
      <Nuvo::Card>
        <h3 class="text-lg font-bold mb-4">Company Information</h3>
        <form
          aria-label="Company Information"
          class="flex col gap-4"
          {{on "submit" this.saveCompany}}
        >
          <Nuvo::Field @label="Company Name" @required={{true}}>
            <Nuvo::Input
              id="company-name"
              type="text"
              @value={{or this.formName this.company.name}}
              @onInput={{fn this.setFieldValue "formName"}}
              required={{true}}
              readonly={{not this.isAdmin}}
            />
          </Nuvo::Field>

          {{#if this.company.adminEmail}}
            <Nuvo::Field @label="Admin Email">
              <Nuvo::Input
                id="company-email"
                type="email"
                @value={{this.company.adminEmail}}
                disabled={{true}}
              />
            </Nuvo::Field>
          {{/if}}

          <Nuvo::Field @label="Plan">
            <Nuvo::Input
              id="company-plan"
              type="text"
              @value={{or this.company.subscriptionTier "FREE"}}
              disabled={{true}}
            />
          </Nuvo::Field>

          {{#unless this.isAdmin}}
            <p class="text-sm text-muted">Only company admins and super admins
              can change these settings.</p>
          {{/unless}}

          {{#if this.errorMsg}}
            <p class="text-danger">{{this.errorMsg}}</p>
          {{/if}}

          {{#if this.storageUsage}}
            <div data-test-storage-usage>
              <h3 class="text-sm font-bold uppercase text-muted mb-2">Storage
                Usage</h3>
              <p class="text-sm mb-2" data-test-storage-label>
                {{format-bytes this.storageUsage.usedBytes}}
                of
                {{format-bytes this.storageUsage.quotaBytes}}
                used ({{this.storageUsage.percentUsed}}%)
              </p>
              <Nuvo::Progress
                @value={{this.storageUsage.percentUsed}}
                @variant={{if this.isStorageWarning "danger" "primary"}}
                data-test-storage-bar
              />
              <p class="text-xs text-muted mt-1">
                Tier:
                {{this.storageUsage.tier}}
                /
                {{this.storageUsage.purchasedSeats}}
                {{this.seatLabel}}
              </p>
            </div>
          {{/if}}

          <Nuvo::FormActions>
            <Nuvo::Button
              @variant="primary"
              @type="submit"
              @loading={{this.isSaving}}
              @disabled={{not this.isAdmin}}
            >
              {{if this.isSaving "Saving..." "Save Changes"}}
            </Nuvo::Button>
          </Nuvo::FormActions>
        </form>
      </Nuvo::Card>

      {{! Right: Operating Regions }}
      {{#if this.model.regions.length}}
        <Nuvo::Card
          class="{{unless this.isAdmin 'region-settings-readonly'}}"
          data-test-region-settings
        >
          <h3 class="text-lg font-bold mb-2">Operating Regions</h3>
          <p class="text-sm text-muted mb-4">
            Select regions where your company operates. Your
            {{or this.company.subscriptionTier "FREE"}}
            plan includes
            {{if
              (eq this.maxRegions 999)
              "unlimited regions"
              (if
                (eq this.maxRegions 1)
                "1 region"
                (concat this.maxRegions " regions")
              )
            }}.
          </p>

          {{! Default Region (above the list) }}
          {{#if this.formActiveRegions.length}}
            <Nuvo::Field @label="Default Region" class="mb-4">
              <Nuvo::Dropdown
                @align="start"
                @value={{this.formDefaultRegionCode}}
                @onSelect={{fn this.setFieldValue "formDefaultRegionCode"}}
                @options={{this.activeRegionOptions}}
                @placeholder="Select default region..."
                @disabled={{not this.isAdmin}}
                data-test-default-region
              />
            </Nuvo::Field>
          {{/if}}

          <p class="text-sm font-bold text-muted uppercase mb-3">Available
            Regions</p>

          {{#each this.model.groupedRegions as |group|}}
            <div
              class="region-country-group mb-2
                {{unless this.isAdmin 'is-readonly'}}"
              data-test-country-group={{group.country}}
            >
              <button
                type="button"
                class="region-country-header"
                {{on "click" (fn this.toggleCountry group.country)}}
              >
                <span class="country-name">{{group.countryName}}</span>
                <span class="country-meta">
                  {{#let (this.selectedCountInGroup group.regions) as |count|}}
                    {{#if count}}
                      <span class="region-selected-badge">{{count}}
                        selected</span>
                    {{/if}}
                  {{/let}}
                  <span class="region-total">{{group.regions.length}}
                    regions</span>
                </span>
                <Ui::Ph
                  @icon={{if
                    (includes this.expandedCountries group.country)
                    "caret-up"
                    "caret-down"
                  }}
                  @size="16"
                />
              </button>
              {{#if (includes this.expandedCountries group.country)}}
                <div class="region-grid mt-2 mb-2 ms-2">
                  {{#each group.regions as |r|}}
                    <div
                      class="region-checkbox
                        {{unless this.isAdmin 'is-readonly'}}"
                      data-test-region-checkbox={{r.code}}
                    >
                      <Nuvo::Checkbox
                        id={{r.code}}
                        @checked={{includes this.formActiveRegions r.code}}
                        @disabled={{not this.isAdmin}}
                        @label={{r.name}}
                        @onChange={{fn this.toggleRegionChecked r.code}}
                      />
                      <span class="text-muted text-xs">({{r.currency}})</span>
                    </div>
                  {{/each}}
                </div>
              {{/if}}
            </div>
          {{/each}}
        </Nuvo::Card>
      {{/if}}
    </div>
  {{/if}}
{{else}}
  <Nuvo::EmptyState
    @title="No Company Data"
    @description="Super Admins are not associated with any company. To view a specific company's settings, impersonate a Company Admin."
  >
    <:icon><Ui::Ph @icon="buildings" /></:icon>
    <:actions>
      <Nuvo::Button @variant="primary" @icon="users" @route="team">
        Go to Team
      </Nuvo::Button>
    </:actions>
  </Nuvo::EmptyState>
{{/if}}
</div>