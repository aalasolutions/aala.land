{{page-title "Owners"}}
<div data-test-owners-page class="flex col gap-6">
  <Nuvo::PageHeader
    @title="Property Owners"
    @subtitle="Contacts who own one or more units. Assign ownership on a unit; edit person details on the Contacts page."
  >
    <:meta>
      <p class="text-muted">{{format-number @model.total unit="owner"}}</p>
    </:meta>
  </Nuvo::PageHeader>

  <div class="owners-list">
    {{#each this.model.owners as |owner|}}
      <Nuvo::Card class="owners-list__row" data-test-owner-id={{owner.id}}>
        <div class="owners-list__info">
          <Nuvo::Avatar @initials={{uc-first owner.displayName}} />
          <div class="owners-list__details">
            <p class="owners-list__name">{{owner.displayName}}</p>
            <p class="owners-list__contact">{{owner.phone}}</p>
            <p class="owners-list__contact">{{owner.email}}</p>
          </div>
        </div>
        <div class="owners-list__actions">
          <Nuvo::Button
            @variant="secondary"
            @icon="eye"
            @text="View"
            data-test-view-owner
            {{on "click" (fn this.viewOwner owner)}}
          />
        </div>
      </Nuvo::Card>
    {{else}}
      <Nuvo::Card>
        <Nuvo::EmptyState
          @description="No owners yet. Assign an owner to a unit and they will appear here."
        />
      </Nuvo::Card>
    {{/each}}
  </div>

  <Nuvo::Pagination
    @page={{this.page}}
    @limit={{this.limit}}
    @total={{@model.total}}
    @onLimitChange={{this.setLimit}}
    @onPrevious={{this.goToPreviousPage}}
    @onNext={{this.goToNextPage}}
  />
</div>
