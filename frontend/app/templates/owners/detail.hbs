{{page-title "Owner Detail"}}
<Nuvo::PageHeader
  @title={{this.model.owner.displayName}}
  @subtitle="Property Owner Details"
>
  <:breadcrumb>
    <Nuvo::Button
      @variant="secondary"
      @size="sm"
      @icon="arrow-left"
      @text="Back"
      {{on "click" this.goBack}}
    />
  </:breadcrumb>
</Nuvo::PageHeader>

{{#if this.model.owner}}
  <div class="owner-detail-grid">
    <Nuvo::Card @title="Contact Information">
      <Nuvo::DescList @horizontal={{true}}>
        <div class="nu-desc-list__group">
          <dt class="nu-desc-list__term">Email</dt>
          <dd class="nu-desc-list__description">{{if
              this.model.owner.email
              this.model.owner.email
              "N/A"
            }}</dd>
        </div>
        <div class="nu-desc-list__group">
          <dt class="nu-desc-list__term">Phone</dt>
          <dd class="nu-desc-list__description">{{if
              this.model.owner.phone
              this.model.owner.phone
              "N/A"
            }}</dd>
        </div>
        <div class="nu-desc-list__group">
          <dt class="nu-desc-list__term">Nationality</dt>
          <dd class="nu-desc-list__description">{{if
              this.model.owner.nationality
              this.model.owner.nationality
              "N/A"
            }}</dd>
        </div>
        <div class="nu-desc-list__group">
          <dt class="nu-desc-list__term">National ID</dt>
          <dd class="nu-desc-list__description">{{if
              this.model.owner.nationalId
              this.model.owner.nationalId
              "N/A"
            }}</dd>
        </div>
        <div class="nu-desc-list__group">
          <dt class="nu-desc-list__term">Address</dt>
          <dd class="nu-desc-list__description">{{if
              this.model.owner.address
              this.model.owner.address
              "N/A"
            }}</dd>
        </div>
      </Nuvo::DescList>
    </Nuvo::Card>

    {{#if this.model.owner.notes}}
      <Nuvo::Card @title="Notes">
        <p class="owner-detail__notes">{{this.model.owner.notes}}</p>
      </Nuvo::Card>
    {{/if}}
  </div>
{{else}}
  <Nuvo::Card>
    <Nuvo::EmptyState @description="Owner not found." />
  </Nuvo::Card>
{{/if}}
