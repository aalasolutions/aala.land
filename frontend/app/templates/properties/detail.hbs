{{page-title
  (if
    @model.assets.length
    (get (get @model.assets "0") "locality.name")
    "Location Detail"
  )
}}

<div data-test-property-detail class="flex col gap-6">
  <Nuvo::PageHeader
    @title={{if
      @model.assets.length
      (get (get @model.assets "0") "locality.name")
      "Location"
    }}
  >
    <:breadcrumb>
      <LinkTo
        @route="properties"
        class="text-muted text-sm"
        data-test-breadcrumb-properties
      >Properties</LinkTo>
      <span class="text-muted">/</span>
    </:breadcrumb>
    <:actions>
      <Nuvo::Button
        @variant="primary"
        data-test-new-asset
        @icon="plus"
        {{on "click" this.openCreateAsset}}
      >
        New Asset
      </Nuvo::Button>
    </:actions>
  </Nuvo::PageHeader>

  <div class="flex end x-center gap-3 wrap" data-test-detail-toolbar>
    <Nuvo::Dropdown
      @size="xs"
      @value={{this.archivedFilterValue}}
      @onSelect={{this.setArchivedFilter}}
      @options={{this.archivedFilterOptions}}
      data-test-archived-filter
    />
    <Nuvo::Segmented
      @options={{this.detailViewOptions}}
      @value={{this.currentDetailView}}
      @onChange={{this.switchDetailView}}
      @iconOnly={{true}}
      aria-label="Layout"
      data-test-detail-view
    />
  </div>

  {{#if this.assetsWithHistory.length}}
    {{#if (eq this.currentDetailView "cards")}}
      <div class="flex col gap-4">
        {{#each this.assetsWithHistory as |asset|}}
          <Nuvo::Card data-test-asset-card>
            <div class="flex between x-center">
              <div class="flex col gap-1">
                <h4 class="text-lg font-bold flex x-center gap-2"><Ui::Ph
                    @icon="buildings"
                    class="text-primary"
                  />
                  {{asset.name}}</h4>
                <p class="text-muted text-sm">{{asset.units.length}} Properties</p>
              </div>
              <div class="flex gap-2">
                <Nuvo::Button
                  data-test-edit-asset
                  @variant="secondary"
                  @size="sm"
                  @icon="pencil-simple"
                  {{on "click" (fn this.openEditAsset asset)}}
                >
                  Edit
                </Nuvo::Button>
                <Nuvo::Button
                  data-test-add-unit
                  @variant="primary"
                  @size="sm"
                  @icon="plus"
                  {{on "click" (fn this.openCreateUnit asset.id)}}
                >
                  Add Property
                </Nuvo::Button>
              </div>
            </div>
            {{#if asset.units.length}}
              <div class="grid-cols-3">
                {{#each asset.units as |unit|}}
                  <div
                    data-test-unit-card
                    data-test-unit-id={{unit.id}}
                    class="unit-card-premium flex col gap-3"
                  >
                    <div
                      class="flex between x-center border-b pb-2"
                    >
                      <div class="flex x-center gap-2">
                        <div class="unit-card-icon-box">
                          <Ui::Ph @icon="door" />
                        </div>
                        <p class="font-bold text-md">{{unit.unitNumber}}</p>
                      </div>
                      <Nuvo::Tag
                        class="tag-proptype-{{lowercase unit.propertyType}}"
                        @text={{property-type-label unit.propertyType}}
                      />
                    </div>

                    <div class="flex between x-center">
                      <p class="text-muted text-sm flex x-center gap-1">
                        {{#if unit.deletedAt}}
                          <Nuvo::Tag
                            @variant="secondary"
                            @text="Archived"
                            data-test-archived-badge
                          />
                        {{/if}}
                        <Nuvo::Tag
                          class="tag-unit-{{lowercase unit.status}}"
                          @text={{capitalize unit.status}}
                        />
                      </p>
                      {{#if unit.price}}
                        <p
                          class="text-success font-bold text-md"
                        ><Money @amount={{unit.price}} /></p>
                      {{/if}}
                    </div>

                    <div class="unit-amenities-strip">
                      <span
                        class="flex x-center gap-1 {{unless (has-value unit.bedrooms) 'opacity-50'}}"
                      >
                        <Ui::Ph @icon="bed" />
                        {{if (has-value unit.bedrooms) unit.bedrooms "-"}}
                      </span>
                      <span
                        class="flex x-center gap-1 {{unless (has-value unit.bathrooms) 'opacity-50'}}"
                      >
                        <Ui::Ph @icon="bathtub" />
                        {{if (has-value unit.bathrooms) unit.bathrooms "-"}}
                      </span>
                      <span
                        class="flex x-center gap-1 {{unless (has-value unit.sqFt) 'opacity-50'}}"
                      >
                        <Ui::Ph @icon="ruler" />
                        {{if
                          (has-value unit.sqFt)
                          (format-number unit.sqFt)
                          "-"
                        }}
                      </span>
                    </div>

                    <Unit::AmenitiesPrint @amenities={{unit.amenities}} />

                    <div class="flex gap-2 pt-1">
                      <Nuvo::Button
                        @variant="primary"
                        @size="sm"
                        @route="properties.unit"
                        @models={{array @model.localityId unit.id}}
                        class="grow justify-center"
                        data-test-view-unit
                      >
                        View Details
                      </Nuvo::Button>
                      {{#unless unit.deletedAt}}
                        <Nuvo::Button
                          @variant="secondary"
                          @size="sm"
                          aria-label="Edit property"
                          data-tooltip="Edit property"
                          @icon="pencil"
                          data-test-edit-unit
                          {{on "click" (fn this.openEditUnit unit asset.id)}}
                        />
                      {{/unless}}
                    </div>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <Nuvo::EmptyState
                @title="No properties yet"
                @description="Start by adding the first property to this asset."
              >
                <:icon><Ui::Ph @icon="house-line" /></:icon>
                <:actions>
                  <Nuvo::Button
                    data-test-add-unit
                    @variant="primary"
                    @size="sm"
                    @icon="plus"
                    {{on "click" (fn this.openCreateUnit asset.id)}}
                  >
                    Add First Property
                  </Nuvo::Button>
                </:actions>
              </Nuvo::EmptyState>
            {{/if}}
          </Nuvo::Card>
        {{/each}}
      </div>
    {{else}}
      <Nuvo::DataTable
        @columns={{this.unitColumns}}
        @rows={{this.unitRows}}
        @tree={{true}}
        @pinColumns={{true}}
        @reorderable={{true}}
        @sortable={{true}}
        @showOptions={{true}}
        @tableId="properties-detail-units"
        data-test-units-table
        as |cell|
      >
        {{#if (eq cell.key "assetName")}}
          {{#unless cell.depth}}
            <span class="font-bold">{{cell.value}}</span>
          {{/unless}}
        {{else if (eq cell.key "unitNumber")}}
          {{#if cell.depth}}
            {{cell.value}}
          {{else}}
            <span class="text-muted">{{cell.row.unitCount}}</span>
          {{/if}}
        {{else if (eq cell.key "status")}}
          {{#if cell.depth}}
            <div class="flex x-center gap-1">
              {{#if cell.row.deletedAt}}
                <Nuvo::Tag
                  @variant="secondary"
                  @text="Archived"
                  data-test-archived-badge
                />
              {{/if}}
              <Nuvo::Tag
                class="tag-unit-{{lowercase cell.value}}"
                @text={{capitalize cell.value}}
              />
            </div>
          {{/if}}
        {{else if (eq cell.key "propertyType")}}
          {{#if cell.value}}
            <Nuvo::Tag
              class="tag-proptype-{{lowercase cell.value}}"
              @text={{property-type-label cell.value}}
            />
          {{/if}}
        {{else if (eq cell.key "sqFt")}}
          {{if cell.value (concat (format-number cell.value) " sqft") ""}}
        {{else if (eq cell.key "price")}}
          <span class="text-success">{{if
              cell.value
              (format-money cell.value)
              ""
            }}</span>
        {{else if (eq cell.key "id")}}
          {{#if cell.depth}}
            <div class="flex gap-1">
              <Nuvo::Button
                data-test-view-unit
                @variant="primary"
                @size="xs"
                @route="properties.unit"
                @models={{array @model.localityId cell.row.id}}
              >View</Nuvo::Button>
              {{#unless cell.row.deletedAt}}
                <Nuvo::Button
                  @variant="secondary"
                  @size="xs"
                  data-test-edit-unit
                  {{on
                    "click"
                    (fn this.openEditUnit cell.row.unit cell.row.assetId)
                  }}
                >Edit</Nuvo::Button>
              {{/unless}}
            </div>
          {{else if (eq cell.row.unitCount 0)}}
            <Nuvo::Button
              data-test-add-unit
              @variant="primary"
              @size="xs"
              @icon="plus"
              {{on "click" (fn this.openCreateUnit cell.row.assetId)}}
            >Add First Property</Nuvo::Button>
          {{/if}}
        {{else}}
          {{cell.value}}
        {{/if}}
      </Nuvo::DataTable>
    {{/if}}
  {{else}}
    <Nuvo::EmptyState
      @title="No assets found"
      @description="There are no assets or properties in this location yet."
    >
      <:icon><Ui::Ph @icon="buildings" /></:icon>
      <:actions>
        <Nuvo::Button
          data-test-new-asset-empty
          @variant="primary"
          @icon="plus"
          {{on "click" this.openCreateAsset}}
        >
          Create First Asset
        </Nuvo::Button>
      </:actions>
    </Nuvo::EmptyState>
  {{/if}}
</div>

<Nuvo::Drawer
  @open={{this.showAssetModal}}
  @title={{if this.editAsset "Edit Asset" "New Asset"}}
  @placement="end"
  @size="lg"
  @onClose={{this.closeAssetModal}}
  @onClosed={{this.resetAssetDrawer}}
>
  <:body>
    <form
      id="asset-form"
      class="flex col gap-4"
      {{on "submit" this.saveAsset}}
    >
      {{#unless this.editAsset}}
        <Nuvo::Field @label="City" @required={{true}}>
          <RemoteAutocomplete
            @listUrl={{this.cityListUrl}}
            @searchUrl={{this.citySearchUrl}}
            @createUrl="/locations/cities"
            @createPayload={{this.cityCreatePayload}}
            @placeholder="Search city..."
            @selectedName={{this.selectedCity.name}}
            @onSelect={{this.selectCity}}
            @onClear={{this.clearCity}}
          />
        </Nuvo::Field>
        {{#if this.selectedCity}}
          <Nuvo::Field @label="Location / Area" @required={{true}}>
            <RemoteAutocomplete
              @listUrl={{this.localityListUrl}}
              @searchUrl={{this.localitySearchUrl}}
              @createUrl="/locations/localities"
              @createPayload={{this.localityCreatePayload}}
              @placeholder="Search location..."
              @selectedName={{this.selectedLocality.name}}
              @onSelect={{this.selectLocality}}
              @onClear={{this.clearLocality}}
            />
          </Nuvo::Field>
        {{/if}}
      {{/unless}}
      <Nuvo::Field @label="Asset Name" @required={{true}}>
        <Nuvo::Input
          data-test-asset-name
          id="b-name"
          @type="text"
          @placeholder="e.g. Tower A"
          @value={{this.formAssetName}}
          @onInput={{fn this.setFieldValue "formAssetName"}}
          required={{true}}
        />
      </Nuvo::Field>
      <Nuvo::Field @label="Address">
        <Nuvo::Input
          data-test-asset-address
          id="b-address"
          @type="text"
          @placeholder="e.g. 123 Sheikh Zayed Road"
          @value={{this.formAssetAddress}}
          @onInput={{fn this.setFieldValue "formAssetAddress"}}
        />
      </Nuvo::Field>
      {{#if this.assetError}}
        <p class="text-sm text-danger">{{this.assetError}}</p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Nuvo::Button
      data-test-asset-cancel
      @variant="secondary"
      {{on "click" this.closeAssetModal}}
    >Cancel</Nuvo::Button>
    <Nuvo::Button
      data-test-asset-save
      @type="submit"
      form="asset-form"
      @variant="primary"
      @disabled={{this.isSavingAsset}}
      @loading={{this.isSavingAsset}}
    >
      {{if
        this.isSavingAsset
        "Saving..."
        (if this.editAsset "Update" "Create Asset")
      }}
    </Nuvo::Button>
  </:footer>
</Nuvo::Drawer>

<Nuvo::Drawer
  @open={{this.showUnitModal}}
  @title={{if this.editUnit "Edit Property" "New Property"}}
  @placement="end"
  @size="lg"
  @onClose={{this.closeUnitModal}}
  @onClosed={{this.resetUnitDrawer}}
>
  <:body>
    <form id="unit-form" class="flex col gap-4" {{on "submit" this.saveUnit}}>
      <div class="flex gap-4">
        <div class="flex col gap-2 grow">
          <Nuvo::Field @label="Property Number" @required={{true}}>
            <Nuvo::Input
              data-test-unit-number
              id="u-number"
              @type="text"
              @placeholder="e.g. 101"
              @value={{this.formUnitNumber}}
              @onInput={{fn this.setFieldValue "formUnitNumber"}}
              required={{true}}
            />
          </Nuvo::Field>
        </div>
        <div class="flex col gap-2 grow">
          <Nuvo::Field @label="Status">
            <Nuvo::Dropdown
              data-test-unit-status
              id="u-status"
              @align="start"
              @value={{this.formUnitStatus}}
              @onSelect={{fn this.setFieldValue "formUnitStatus"}}
              @options={{this.statusOptions}}
              @placeholder="Select status..."
            />
          </Nuvo::Field>
        </div>
      </div>
      <Nuvo::Field
        @label="Property Kind"
        @required={{true}}
        @tooltip="Sets the lease type: homes take residential leases; offices, shops and warehouses take commercial ones."
      >
        <Nuvo::Dropdown
          id="u-sub-type"
          @align="start"
          @value={{this.formUnitSubType}}
          @onSelect={{fn this.setFieldValue "formUnitSubType"}}
          @options={{this.subTypeOptions}}
          @placeholder="Select kind..."
          data-test-unit-kind
        />
      </Nuvo::Field>
      <Nuvo::Field
        @label="Property Listing Type"
        @tooltip="Choose how this property is listed. For Rent and For Sale make it searchable. Not Listed keeps it hidden."
      >
        <Nuvo::Dropdown
          data-test-unit-listing-type
          id="u-property-type"
          @align="start"
          @value={{this.formUnitPropertyType}}
          @onSelect={{fn this.setFieldValue "formUnitPropertyType"}}
          @options={{this.propertyTypeOptions}}
          @placeholder="Not Listed"
        />
      </Nuvo::Field>
      <div class="flex gap-4">
        <div class="flex col gap-2 grow">
          <Nuvo::Field
            @label="Price"
            @tooltip="For a rental, enter the rent per month. For a sale, enter the full asking price."
          >
            <Nuvo::Input
              data-test-unit-price
              id="u-price"
              @type="number"
              @placeholder="e.g. 150000"
              @value={{this.formUnitPrice}}
              @onInput={{fn this.setFieldValue "formUnitPrice"}}
              min="0"
            />
          </Nuvo::Field>
        </div>
        <div class="flex col gap-2 grow">
          <Nuvo::Field @label="Sq Ft">
            <Nuvo::Input
              data-test-unit-sqft
              id="u-sqft"
              @type="number"
              @placeholder="e.g. 850"
              @value={{this.formUnitSqFt}}
              @onInput={{fn this.setFieldValue "formUnitSqFt"}}
              min="0"
            />
          </Nuvo::Field>
        </div>
      </div>
      <div class="flex gap-4">
        <div class="flex col gap-2 grow">
          <Nuvo::Field @label="Bedrooms">
            <Nuvo::Input
              data-test-unit-beds
              id="u-beds"
              @type="number"
              @placeholder="e.g. 2"
              @value={{this.formUnitBedrooms}}
              @onInput={{fn this.setFieldValue "formUnitBedrooms"}}
              min="0"
            />
          </Nuvo::Field>
        </div>
        <div class="flex col gap-2 grow">
          <Nuvo::Field @label="Bathrooms">
            <Nuvo::Input
              data-test-unit-baths
              id="u-baths"
              @type="number"
              @placeholder="e.g. 2"
              @value={{this.formUnitBathrooms}}
              @onInput={{fn this.setFieldValue "formUnitBathrooms"}}
              min="0"
              step="0.5"
            />
          </Nuvo::Field>
        </div>
      </div>
      <Contact::Picker
        @label="Owner"
        @required={{true}}
        @contact={{this.ownerSelection.contact}}
        @identity={{this.ownerSelection.identity}}
        @onSelectContact={{this.ownerSelection.attach}}
        @onClear={{this.ownerSelection.clear}}
        @onIdentityChange={{this.ownerSelection.setField}}
        @conflict={{this.ownerSelection.conflict}}
        @verifyPhone={{this.ownerSelection.verifyPhone}}
        @onVerifyPhoneChange={{this.ownerSelection.setVerifyPhone}}
      />
      <div class="flex col gap-2">
        <span id="unit-amenities-label" class="text-sm text-muted">Amenities</span>
        <div
          class="flex wrap gap-2"
          role="group"
          aria-labelledby="unit-amenities-label"
        >
          {{#each this.amenityOptions as |opt|}}
            <button
              type="button"
              class="nu-tag m-pill m-selectable {{if (includes this.formUnitAmenities opt.key) 'is-selected'}}"
              data-test-amenity={{opt.key}}
              aria-pressed={{if
                (includes this.formUnitAmenities opt.key)
                "true"
                "false"
              }}
              {{on "click" (fn this.toggleAmenity opt.key)}}
            >
              <Ui::Ph @icon={{opt.icon}} />
              {{opt.label}}
            </button>
          {{/each}}
        </div>
      </div>
      {{#if this.unitError}}
        <p class="text-sm text-danger">{{this.unitError}}</p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Nuvo::Button
      data-test-unit-cancel
      @variant="secondary"
      {{on "click" this.closeUnitModal}}
    >Cancel</Nuvo::Button>
    <Nuvo::Button
      data-test-unit-save
      @type="submit"
      form="unit-form"
      @variant="primary"
      @disabled={{this.isSavingUnit}}
      @loading={{this.isSavingUnit}}
    >
      {{if
        this.isSavingUnit
        "Saving..."
        (if this.editUnit "Update" "Create Property")
      }}
    </Nuvo::Button>
  </:footer>
</Nuvo::Drawer>