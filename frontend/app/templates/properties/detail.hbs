{{page-title
  (if
    @model.assets.length
    (get (get @model.assets "0") "locality.name")
    "Location Detail"
  )
}}

<div data-test-property-detail class="flex col gap-6">
  <Nuvo::PageHeader
    @title={{if
      @model.assets.length
      (get (get @model.assets "0") "locality.name")
      "Location"
    }}
  >
    <:breadcrumb>
      <LinkTo @route="properties" class="text-muted text-sm">Properties</LinkTo>
      <span class="text-muted">/</span>
    </:breadcrumb>
    <:actions>
      <Nuvo::BtnGroup @attached={{true}}>
        <Nuvo::Button
          @variant={{if (eq this.currentDetailView "cards") "primary" "secondary"}}
          @size="sm"
          data-test-view-cards
          {{on "click" (fn this.switchDetailView "cards")}}
        >
          <Ui::Ph @icon="squares-four" />
          Cards
        </Nuvo::Button>
        <Nuvo::Button
          @variant={{if (eq this.currentDetailView "list") "primary" "secondary"}}
          @size="sm"
          data-test-view-list
          {{on "click" (fn this.switchDetailView "list")}}
        >
          <Ui::Ph @icon="list" />
          List
        </Nuvo::Button>
      </Nuvo::BtnGroup>
      <Nuvo::Button
        @variant="primary"
        data-test-new-asset
        {{on "click" this.openCreateAsset}}
      >
        <Ui::Ph @icon="plus" />
        New Asset
      </Nuvo::Button>
    </:actions>
  </Nuvo::PageHeader>

  {{#if this.assetsWithHistory.length}}
    {{#if (eq this.currentDetailView "cards")}}
      {{! CARDS VIEW }}
      <div class="flex col gap-4">
        {{#each this.assetsWithHistory as |asset|}}
          <Nuvo::Card data-test-asset-card>
            <div class="flex between x-center">
              <div class="flex col gap-1">
                <h4 class="text-lg font-bold flex x-center gap-2"><Ui::Ph
                    @icon="buildings"
                    class="text-primary"
                  />
                  {{asset.name}}</h4>
                <p class="text-muted text-sm">{{asset.units.length}} Properties</p>
              </div>
              <div class="flex gap-2">
                <Nuvo::Button
                  @variant="secondary"
                  @size="sm"
                  {{on "click" (fn this.openEditAsset asset)}}
                >
                  <Ui::Ph @icon="pencil-simple" />
                  Edit
                </Nuvo::Button>
                <Nuvo::Button
                  @variant="primary"
                  @size="sm"
                  {{on "click" (fn this.openCreateUnit asset.id)}}
                >
                  <Ui::Ph @icon="plus" />
                  Add Property
                </Nuvo::Button>
              </div>
            </div>
            {{#if asset.units.length}}
              <div class="grid-cols-3">
                {{#each asset.units as |unit|}}
                  <div
                    data-test-unit-card
                    data-test-unit-id={{unit.id}}
                    class="unit-card-premium flex col gap-3"
                  >
                    <div
                      class="flex between x-center border-b pb-2"
                    >
                      <div class="flex x-center gap-2">
                        <div class="unit-card-icon-box">
                          <Ui::Ph @icon="door" />
                        </div>
                        <p class="font-bold text-md">Property
                          {{unit.unitNumber}}</p>
                      </div>
                      {{#if unit.propertyType}}
                        <Nuvo::Tag
                          class="tag-proptype-{{lowercase unit.propertyType}}"
                          @text={{if
                            (eq unit.propertyType "FOR_SALE")
                            "For Sale"
                            (if
                              (eq unit.propertyType "RENTAL")
                              "For Rent"
                              "Not Listed"
                            )
                          }}
                        />
                      {{/if}}
                    </div>

                    <div class="flex between x-center">
                      <p class="text-muted text-sm flex x-center gap-1">
                        <Nuvo::Tag
                          class="tag-unit-{{lowercase unit.status}}"
                          @text={{capitalize unit.status}}
                        />
                      </p>
                      {{#if unit.price}}
                        <p
                          class="text-success font-bold text-md"
                        >{{format-currency unit.price}}</p>
                      {{/if}}
                    </div>

                    <div class="unit-amenities-strip">
                      <span
                        class="flex x-center gap-1
                          {{unless (has-value unit.bedrooms) 'opacity-50'}}"
                      >
                        <Ui::Ph @icon="bed" />
                        {{if (has-value unit.bedrooms) unit.bedrooms "-"}}
                      </span>
                      <span
                        class="flex x-center gap-1
                          {{unless (has-value unit.bathrooms) 'opacity-50'}}"
                      >
                        <Ui::Ph @icon="bathtub" />
                        {{if (has-value unit.bathrooms) unit.bathrooms "-"}}
                      </span>
                      <span
                        class="flex x-center gap-1
                          {{unless (has-value unit.sqFt) 'opacity-50'}}"
                      >
                        <Ui::Ph @icon="selection" />
                        {{if
                          (has-value unit.sqFt)
                          (format-number unit.sqFt)
                          "-"
                        }}
                      </span>
                    </div>

                    <Unit::AmenitiesPrint @amenities={{unit.amenities}} />

                    <div class="flex gap-2 pt-1">
                      <LinkTo
                        @route="properties.unit"
                        @models={{array @model.localityId unit.id}}
                        class="nu-btn m-primary m-sm grow justify-center"
                        data-test-view-unit
                      >
                        View Details
                      </LinkTo>
                      <Nuvo::Button
                        @variant="secondary"
                        @size="sm"
                        aria-label="Edit property"
                        title="Edit property"
                        {{on "click" (fn this.openEditUnit unit asset.id)}}
                      >
                        <Ui::Ph @icon="pencil" />
                      </Nuvo::Button>
                    </div>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <Nuvo::EmptyState
                @title="No properties yet"
                @description="Start by adding the first property to this asset."
              >
                <:icon><Ui::Ph @icon="house-line" /></:icon>
                <:actions>
                  <Nuvo::Button
                    @variant="primary"
                    @size="sm"
                    {{on "click" (fn this.openCreateUnit asset.id)}}
                  >
                    <Ui::Ph @icon="plus" />
                    Add First Property
                  </Nuvo::Button>
                </:actions>
              </Nuvo::EmptyState>
            {{/if}}
          </Nuvo::Card>
        {{/each}}
      </div>
    {{else}}
      {{! LIST VIEW }}
      <div class="nu-table-wrapper">
        <table class="nu-table">
          <thead>
            <tr>
              <th>Asset</th>
              <th>Property</th>
              <th>Status</th>
              <th>Type</th>
              <th>Beds</th>
              <th>Baths</th>
              <th>Size</th>
              <th>Price</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {{#each this.assetsWithHistory as |asset|}}
              {{#each asset.units as |unit|}}
                <tr>
                  <td class="font-bold">{{asset.name}}</td>
                  <td>{{unit.unitNumber}}</td>
                  <td><Nuvo::Tag
                      class="tag-unit-{{lowercase unit.status}}"
                      @text={{capitalize unit.status}}
                    /></td>
                  <td>
                    {{#if unit.propertyType}}
                      <Nuvo::Tag
                        class="tag-proptype-{{lowercase unit.propertyType}}"
                        @text={{if
                          (eq unit.propertyType "FOR_SALE")
                          "For Sale"
                          (if
                            (eq unit.propertyType "RENTAL")
                            "For Rent"
                            "Not Listed"
                          )
                        }}
                      />
                    {{/if}}
                  </td>
                  <td>{{unit.bedrooms}}</td>
                  <td>{{unit.bathrooms}}</td>
                  <td>{{if
                      unit.sqFt
                      (concat (format-number unit.sqFt) " sqft")
                      ""
                    }}</td>
                  <td class="text-success">{{if
                      unit.price
                      (format-currency unit.price)
                      ""
                    }}</td>
                  <td class="text-end">
                    <div class="flex gap-1">
                      <LinkTo
                        @route="properties.unit"
                        @models={{array @model.localityId unit.id}}
                        class="nu-btn m-primary m-xs"
                      >View</LinkTo>
                      <Nuvo::Button
                        @variant="secondary"
                        @size="xs"
                        {{on "click" (fn this.openEditUnit unit asset.id)}}
                      >Edit</Nuvo::Button>
                    </div>
                  </td>
                </tr>
              {{else}}
                <tr>
                  <td colspan="9" class="p-0">
                    <Nuvo::EmptyState
                      @title="No properties in {{asset.name}}"
                      @description="Add your first property to start managing this asset."
                    >
                      <:icon><Ui::Ph @icon="door" /></:icon>
                      <:actions>
                        <Nuvo::Button
                          @variant="primary"
                          @size="xs"
                          {{on "click" (fn this.openCreateUnit asset.id)}}
                        >
                          <Ui::Ph @icon="plus" />
                          Add First Property
                        </Nuvo::Button>
                      </:actions>
                    </Nuvo::EmptyState>
                  </td>
                </tr>
              {{/each}}
            {{/each}}
          </tbody>
        </table>
      </div>
    {{/if}}
  {{else}}
    <Nuvo::EmptyState
      @title="No assets found"
      @description="There are no assets or properties in this location yet."
    >
      <:icon><Ui::Ph @icon="buildings" /></:icon>
      <:actions>
        <Nuvo::Button
          @variant="primary"
          {{on "click" this.openCreateAsset}}
        >
          <Ui::Ph @icon="plus" />
          Create First Asset
        </Nuvo::Button>
      </:actions>
    </Nuvo::EmptyState>
  {{/if}}
</div>

<Nuvo::Modal
  @open={{this.showAssetModal}}
  @title={{if this.editAsset "Edit Asset" "New Asset"}}
  @onClose={{this.closeAssetModal}}
>
  <form class="flex col gap-4" {{on "submit" this.saveAsset}}>
    {{#unless this.editAsset}}
      <div class="flex col gap-2">
        <label class="text-sm text-muted">City *</label>
        <LocationTypeahead
          @searchUrl={{this.citySearchUrl}}
          @createUrl="/locations/cities"
          @createPayload={{this.cityCreatePayload}}
          @placeholder="Search city..."
          @selectedName={{this.selectedCity.name}}
          @onSelect={{this.selectCity}}
          @onClear={{this.clearCity}}
        />
      </div>
      {{#if this.selectedCity}}
        <div class="flex col gap-2">
          <label class="text-sm text-muted">Location / Area *</label>
          <LocationTypeahead
            @searchUrl={{this.localitySearchUrl}}
            @createUrl="/locations/localities"
            @createPayload={{this.localityCreatePayload}}
            @placeholder="Search location..."
            @selectedName={{this.selectedLocality.name}}
            @onSelect={{this.selectLocality}}
            @onClear={{this.clearLocality}}
          />
        </div>
      {{/if}}
    {{/unless}}
    <Nuvo::Field @label="Asset Name" @required={{true}}>
      <Nuvo::Input
        id="b-name"
        @type="text"
        @placeholder="e.g. Tower A"
        @value={{this.formAssetName}}
        @onInput={{fn this.setFieldValue "formAssetName"}}
        required={{true}}
      />
    </Nuvo::Field>
    <Nuvo::Field @label="Address">
      <Nuvo::Input
        id="b-address"
        @type="text"
        @placeholder="e.g. 123 Sheikh Zayed Road"
        @value={{this.formAssetAddress}}
        @onInput={{fn this.setFieldValue "formAssetAddress"}}
      />
    </Nuvo::Field>
    {{#if this.assetError}}
      <p class="text-sm text-danger">{{this.assetError}}</p>
    {{/if}}
    <div class="flex gap-3 mt-2">
      <Nuvo::Button
        @variant="secondary"
        {{on "click" this.closeAssetModal}}
      >Cancel</Nuvo::Button>
      <Nuvo::Button
        @type="submit"
        @variant="primary"
        @disabled={{this.isSavingAsset}}
        @loading={{this.isSavingAsset}}
      >
        {{if
          this.isSavingAsset
          "Saving..."
          (if this.editAsset "Update" "Create Asset")
        }}
      </Nuvo::Button>
    </div>
  </form>
</Nuvo::Modal>

<Nuvo::Modal
  @open={{this.showUnitModal}}
  @title={{if this.editUnit "Edit Property" "New Property"}}
  @onClose={{this.closeUnitModal}}
>
  <form class="flex col gap-4" {{on "submit" this.saveUnit}}>
    <div class="flex gap-4">
      <div class="flex col gap-2 grow">
        <Nuvo::Field @label="Property Number" @required={{true}}>
          <Nuvo::Input
            id="u-number"
            @type="text"
            @placeholder="e.g. 101"
            @value={{this.formUnitNumber}}
            @onInput={{fn this.setFieldValue "formUnitNumber"}}
            required={{true}}
          />
        </Nuvo::Field>
      </div>
      <div class="flex col gap-2 grow">
        <Nuvo::Field @label="Status">
          <Nuvo::Dropdown
            id="u-status"
            @align="start"
            @value={{this.formUnitStatus}}
            @onSelect={{fn this.setFieldValue "formUnitStatus"}}
            @options={{this.statusOptions}}
            @placeholder="Select status..."
          />
        </Nuvo::Field>
      </div>
    </div>
    <Nuvo::Field @label="Property Type">
      <Nuvo::Dropdown
        id="u-property-type"
        @align="start"
        @value={{this.formUnitPropertyType}}
        @onSelect={{fn this.setFieldValue "formUnitPropertyType"}}
        @options={{this.propertyTypeOptions}}
        @placeholder="Select type..."
      />
    </Nuvo::Field>
    <div class="flex gap-4">
      <div class="flex col gap-2 grow">
        <Nuvo::Field @label="Price">
          <Nuvo::Input
            id="u-price"
            @type="number"
            @placeholder="e.g. 150000"
            @value={{this.formUnitPrice}}
            @onInput={{fn this.setFieldValue "formUnitPrice"}}
            min="0"
          />
        </Nuvo::Field>
      </div>
      <div class="flex col gap-2 grow">
        <Nuvo::Field @label="Sq Ft">
          <Nuvo::Input
            id="u-sqft"
            @type="number"
            @placeholder="e.g. 850"
            @value={{this.formUnitSqFt}}
            @onInput={{fn this.setFieldValue "formUnitSqFt"}}
            min="0"
          />
        </Nuvo::Field>
      </div>
    </div>
    <div class="flex gap-4">
      <div class="flex col gap-2 grow">
        <Nuvo::Field @label="Bedrooms">
          <Nuvo::Input
            id="u-beds"
            @type="number"
            @placeholder="e.g. 2"
            @value={{this.formUnitBedrooms}}
            @onInput={{fn this.setFieldValue "formUnitBedrooms"}}
            min="0"
          />
        </Nuvo::Field>
      </div>
      <div class="flex col gap-2 grow">
        <Nuvo::Field @label="Bathrooms">
          <Nuvo::Input
            id="u-baths"
            @type="number"
            @placeholder="e.g. 2"
            @value={{this.formUnitBathrooms}}
            @onInput={{fn this.setFieldValue "formUnitBathrooms"}}
            min="0"
          />
        </Nuvo::Field>
      </div>
    </div>
    <Nuvo::Field @label="Owner">
      <Nuvo::Dropdown
        id="u-owner"
        @align="start"
        @value={{this.formUnitOwnerId}}
        @onSelect={{fn this.setFieldValue "formUnitOwnerId"}}
        @options={{this.ownerOptions}}
      />
    </Nuvo::Field>
    <div class="flex col gap-2">
      <label class="text-sm text-muted">Amenities</label>
      <div class="flex wrap gap-2">
        {{#each this.amenityOptions as |opt|}}
          <button
            type="button"
            class="nu-tag m-pill m-selectable
              {{if
                (includes this.formUnitAmenities opt.key)
                'is-selected'
              }}"
            {{on "click" (fn this.toggleAmenity opt.key)}}
          >
            <Ui::Ph @icon={{opt.icon}} />
            {{opt.label}}
          </button>
        {{/each}}
      </div>
    </div>
    {{#if this.unitError}}
      <p class="text-sm text-danger">{{this.unitError}}</p>
    {{/if}}
    <div class="flex gap-3 mt-2">
      <Nuvo::Button
        @variant="secondary"
        {{on "click" this.closeUnitModal}}
      >Cancel</Nuvo::Button>
      <Nuvo::Button
        @type="submit"
        @variant="primary"
        @disabled={{this.isSavingUnit}}
        @loading={{this.isSavingUnit}}
      >
        {{if
          this.isSavingUnit
          "Saving..."
          (if this.editUnit "Update" "Create Property")
        }}
      </Nuvo::Button>
    </div>
  </form>
</Nuvo::Modal>