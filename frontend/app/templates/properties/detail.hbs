{{page-title
  (if
    @model.assets.length
    (get (get @model.assets "0") "locality.name")
    "Location Detail"
  )
}}

<div data-test-property-detail class="flex col gap-6">
  <Woven::PageHeader
    @title={{if
      @model.assets.length
      (get (get @model.assets "0") "locality.name")
      "Location"
    }}
  >
    <:breadcrumb>
      <Woven::Breadcrumb
        @items={{array (hash label="Properties" route="properties")}}
        @compact={{true}}
        @parentsOnly={{true}}
        data-test-breadcrumb-properties
      />
    </:breadcrumb>
    <:actions>
      <Woven::Button
        @variant="brand"
        data-test-new-asset
        @icon="plus"
        {{on "click" this.openCreateAsset}}
      >
        New Asset
      </Woven::Button>
    </:actions>
  </Woven::PageHeader>

  <div class="flex end x-center gap-3 wrap" data-test-detail-toolbar>
    <Woven::Dropdown
      @size="xs"
      @value={{this.archivedFilterValue}}
      @onSelect={{this.setArchivedFilter}}
      @options={{this.archivedFilterOptions}}
      data-test-archived-filter
    />
    <Woven::Segmented
      @options={{this.detailViewOptions}}
      @value={{this.currentDetailView}}
      @onChange={{this.switchDetailView}}
      @iconOnly={{true}}
      aria-label="Layout"
      data-test-detail-view
    />
  </div>

  {{#if this.assetsWithHistory.length}}
    {{#if (eq this.currentDetailView "cards")}}
      <div class="flex col gap-4">
        {{#each this.assetsWithHistory as |asset|}}
          <Woven::Card data-test-asset-card>
            <:header>
              <div class="flex col gap-1">
                <h3 class="wu-card-title flex x-center gap-2"><Ui::Ph
                    @icon="buildings"
                    class="text-brand"
                  />
                  {{asset.name}}</h3>
                <p class="text-muted text-sm mb-0">{{asset.units.length}} Properties</p>
              </div>
              <div class="flex gap-2">
                <Woven::Button
                  data-test-edit-asset
                  @variant="subtle"
                  @size="sm"
                  @icon="pencil-simple"
                  {{on "click" (fn this.openEditAsset asset)}}
                >
                  Edit
                </Woven::Button>
                <Woven::Button
                  data-test-add-unit
                  @variant="brand"
                  @size="sm"
                  @icon="plus"
                  {{on "click" (fn this.openCreateUnit asset.id)}}
                >
                  Add Property
                </Woven::Button>
              </div>
            </:header>
            <:body>
              {{#if asset.units.length}}
                <div class="grid cols-1 cols-2@sm cols-3@lg gap-4">
                  {{#each asset.units as |unit|}}
                    <Woven::Card
                      data-test-unit-card
                      data-test-unit-id={{unit.id}}
                    >
                      <div class="flex col gap-3">
                        <div
                          class="flex between x-center border-b pb-2"
                        >
                          <div class="flex x-center gap-2">
                            <div class="flex x-center center p-2 rounded-lg bg-alternate text-brand">
                              <Ui::Ph @icon="door" />
                            </div>
                            <p class="font-bold text-md mb-0">{{unit.unitNumber}}</p>
                          </div>
                          <Woven::Tag
                            @variant={{tag-variant "proptype" unit.propertyType}}
                            @text={{property-type-label unit.propertyType}}
                          />
                        </div>

                        <div class="flex between x-center">
                          <div class="flex x-center gap-1">
                            {{#if unit.deletedAt}}
                              <Woven::Tag
                                @variant="secondary"
                                @text="Archived"
                                data-test-archived-badge
                              />
                            {{/if}}
                            <Woven::Tag
                              @variant={{tag-variant "unit" unit.status}}
                              @text={{capitalize unit.status}}
                            />
                          </div>
                          {{#if unit.price}}
                            <p
                              class="text-success font-bold text-md mb-0"
                            ><Money @amount={{unit.price}} /></p>
                          {{/if}}
                        </div>

                        <div class="flex around gap-4 p-2 rounded-lg bg-alternate text-sm text-muted">
                          <span
                            class="flex x-center gap-1 {{unless (has-value unit.bedrooms) 'opacity-50'}}"
                          >
                            <Ui::Ph @icon="bed" />
                            {{if (has-value unit.bedrooms) unit.bedrooms "-"}}
                          </span>
                          <span
                            class="flex x-center gap-1 {{unless (has-value unit.bathrooms) 'opacity-50'}}"
                          >
                            <Ui::Ph @icon="bathtub" />
                            {{if (has-value unit.bathrooms) unit.bathrooms "-"}}
                          </span>
                          <span
                            class="flex x-center gap-1 {{unless (has-value unit.sqFt) 'opacity-50'}}"
                          >
                            <Ui::Ph @icon="ruler" />
                            {{if
                              (has-value unit.sqFt)
                              (format-number unit.sqFt)
                              "-"
                            }}
                          </span>
                        </div>

                        <Unit::AmenitiesPrint @amenities={{unit.amenities}} />

                        <div class="flex gap-2 pt-1">
                          <Woven::Button
                            @variant="brand"
                            @size="sm"
                            @route="properties.unit"
                            @models={{array @model.localityId unit.id}}
                            class="grow justify-center"
                            data-test-view-unit
                          >
                            View Details
                          </Woven::Button>
                          {{#unless unit.deletedAt}}
                            <Woven::Button
                              @variant="subtle"
                              @size="sm"
                              aria-label="Edit property"
                              data-tooltip="Edit property"
                              @icon="pencil"
                              data-test-edit-unit
                              {{on "click" (fn this.openEditUnit unit asset.id)}}
                            />
                          {{/unless}}
                        </div>
                      </div>
                    </Woven::Card>
                  {{/each}}
                </div>
              {{else}}
                <Woven::EmptyState
                  @title="No properties yet"
                  @description="Start by adding the first property to this asset."
                >
                  <:icon><Ui::Ph @icon="house-line" /></:icon>
                  <:actions>
                    <Woven::Button
                      data-test-add-unit
                      @variant="brand"
                      @size="sm"
                      @icon="plus"
                      {{on "click" (fn this.openCreateUnit asset.id)}}
                    >
                      Add First Property
                    </Woven::Button>
                  </:actions>
                </Woven::EmptyState>
              {{/if}}
            </:body>
          </Woven::Card>
        {{/each}}
      </div>
    {{else}}
      <Woven::DataTable
        @columns={{this.unitColumns}}
        @rows={{this.unitRows}}
        @tree={{true}}
        @pinColumns={{true}}
        @reorderable={{true}}
        @sortable={{true}}
        @showOptions={{true}}
        @tableId="properties-detail-units"
        data-test-units-table
        as |cell|
      >
        {{#if (eq cell.key "assetName")}}
          {{#unless cell.depth}}
            <span>{{cell.value}}</span>
          {{/unless}}
        {{else if (eq cell.key "unitNumber")}}
          {{#if cell.depth}}
            {{cell.value}}
          {{else}}
            <span class="text-muted">{{cell.row.unitCount}}</span>
          {{/if}}
        {{else if (eq cell.key "status")}}
          {{#if cell.depth}}
            <div class="flex x-center gap-1">
              {{#if cell.row.deletedAt}}
                <Woven::Tag
                  @variant="secondary"
                  @text="Archived"
                  data-test-archived-badge
                />
              {{/if}}
              <Woven::Tag
                @variant={{tag-variant "unit" cell.value}}
                @text={{capitalize cell.value}}
              />
            </div>
          {{/if}}
        {{else if (eq cell.key "propertyType")}}
          {{#if cell.value}}
            <Woven::Tag
              @variant={{tag-variant "proptype" cell.value}}
              @text={{property-type-label cell.value}}
            />
          {{/if}}
        {{else if (eq cell.key "sqFt")}}
          {{if cell.value (concat (format-number cell.value) " sqft") ""}}
        {{else if (eq cell.key "price")}}
          <span class="text-success">{{if
              cell.value
              (format-money cell.value)
              ""
            }}</span>
        {{else if (eq cell.key "id")}}
          {{#if cell.depth}}
            <RowActions
              @label={{cell.row.unitNumber}}
              @actions={{array
                (hash
                  key="view-unit"
                  label="View"
                  icon="eye"
                  variant="brand"
                  route="properties.unit"
                  models=(array @model.localityId cell.row.id)
                )
                (hash
                  key="edit-unit"
                  label="Edit"
                  icon="pencil-simple"
                  onSelect=(fn this.openEditUnit cell.row.unit cell.row.assetId)
                  hidden=cell.row.deletedAt
                )
              }}
            />
          {{else if (eq cell.row.unitCount 0)}}
            <RowActions
              @label={{cell.row.assetName}}
              @actions={{array
                (hash
                  key="add-unit"
                  label="Add first property"
                  icon="plus"
                  variant="brand"
                  onSelect=(fn this.openCreateUnit cell.row.assetId)
                )
              }}
            />
          {{/if}}
        {{else}}
          {{cell.value}}
        {{/if}}
      </Woven::DataTable>
    {{/if}}
  {{else}}
    <Woven::EmptyState
      @title="No assets found"
      @description="There are no assets or properties in this location yet."
    >
      <:icon><Ui::Ph @icon="buildings" /></:icon>
      <:actions>
        <Woven::Button
          data-test-new-asset-empty
          @variant="brand"
          @icon="plus"
          {{on "click" this.openCreateAsset}}
        >
          Create First Asset
        </Woven::Button>
      </:actions>
    </Woven::EmptyState>
  {{/if}}
</div>

<Properties::AssetDrawer
  @open={{this.showAssetModal}}
  @asset={{this.editAsset}}
  @defaultLocality={{this.defaultLocality}}
  @onClose={{this.closeAssetModal}}
  @onClosed={{this.resetAssetDrawer}}
  @onSaved={{this.refresh}}
/>

<Properties::PropertyDrawer
  @open={{this.showUnitModal}}
  @variant="asset"
  @unit={{this.editUnit}}
  @assetId={{this.activeAssetId}}
  @onClose={{this.closeUnitModal}}
  @onClosed={{this.resetUnitDrawer}}
  @onSaved={{this.refresh}}
/>