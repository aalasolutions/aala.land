{{page-title "Properties"}}

<div data-test-properties-page class="flex col gap-6">
  <Nuvo::PageHeader
    @title="Properties"
    @subtitle="Locations, assets, and properties."
  >
    <:meta>
      {{#if (eq this.currentView "browse")}}
        <p class="text-muted" data-test-browse-count>{{format-number
            this.browseTotal
            unit="property"
            plural="properties"
          }}</p>
      {{/if}}
    </:meta>
    <:actions>
      <Nuvo::Button
        @variant="primary"
        data-test-new-unit
        @icon="plus"
        {{on "click" this.openNewUnitModal}}
      >
        New Property
      </Nuvo::Button>
    </:actions>
  </Nuvo::PageHeader>

  {{#if (eq this.currentView "cards")}}
    {{#if @model.length}}
      <div class="flex col gap-3">
        {{#each @model as |loc|}}
          <LinkTo
            data-test-locality-card
            @route="properties.detail"
            @model={{loc.id}}
            class="nu-card m-interactive flex between x-center"
          >
            <div class="flex gap-6">
              <div>
                <h4 class="text-md font-bold">{{loc.name}}</h4>
                <p class="text-muted text-xs mt-1">{{loc.cityName}}</p>
              </div>
              <div class="flex gap-4 text-sm">
                <span class="text-muted">{{loc.assetCount}} Assets</span>
                <span class="text-muted">{{loc.unitCount}} Properties</span>
              </div>
            </div>
            <Ui::Ph @icon="caret-right" @size="20" />
          </LinkTo>
        {{/each}}
      </div>
    {{else}}
      <Nuvo::EmptyState
        @title="No assets yet"
        @description="Click New Property to add your first property."
      />
    {{/if}}
  {{else if (eq this.currentView "list")}}
    {{#if @model.length}}
      <Nuvo::DataTable
        @columns={{this.columns}}
        @rows={{@model}}
        @pinColumns={{true}}
        @reorderable={{true}}
        @sortable={{true}}
        @showOptions={{true}}
        @tableId="properties-localities"
        data-test-localities-table
        as |cell|
      >
        {{#if (eq cell.key "name")}}
          <span class="font-bold">{{cell.value}}</span>
        {{else if (eq cell.key "cityName")}}
          <span class="text-muted">{{cell.value}}</span>
        {{else if (eq cell.key "id")}}
          <Nuvo::Button
            data-test-view-locality
            @variant="primary"
            @size="xs"
            @route="properties.detail"
            @model={{cell.value}}
          >View</Nuvo::Button>
        {{else}}
          {{cell.value}}
        {{/if}}
      </Nuvo::DataTable>
    {{else}}
      <Nuvo::EmptyState
        @title="No assets yet"
        @description="Click New Property to add your first property."
      />
    {{/if}}
  {{else}}
    <Nuvo::Accordion
      @items={{array
        (hash
          id="filters"
          title=(if this.hasActiveFilters "Filters · active" "Filters")
        )
      }}
      data-test-filters-accordion
    >
      <div class="flex col gap-4" data-test-browse-filters>
        <div class="nu-filter-row">
          <Nuvo::Field @label="Type">
            <Nuvo::Dropdown
              @align="start"
              @value={{this.filterType}}
              @onSelect={{this.setFilterType}}
              @options={{this.filterTypeOptions}}
              @placeholder="All"
              data-test-filter-type
            />
          </Nuvo::Field>
          <Nuvo::Field @label="Status">
            <Nuvo::Dropdown
              @align="start"
              @value={{this.filterStatus}}
              @onSelect={{this.setFilterStatus}}
              @options={{this.filterStatusOptions}}
              @placeholder="All"
              data-test-filter-status
            />
          </Nuvo::Field>
          <Nuvo::Field @label="Bedrooms">
            <Nuvo::Dropdown
              @align="start"
              @value={{this.filterBeds}}
              @onSelect={{this.setFilterBeds}}
              @options={{this.filterBedsOptions}}
              @placeholder="Any"
              data-test-filter-beds
            />
          </Nuvo::Field>
          <Nuvo::Field
            @label="Visibility"
            @tooltip="Shows active properties, archived ones, or both. It does not change whether a property is listed."
          >
            <Nuvo::Dropdown
              @align="start"
              @value={{this.archivedFilterValue}}
              @onSelect={{this.setArchivedFilter}}
              @options={{this.archivedFilterOptions}}
              data-test-archived-filter
            />
          </Nuvo::Field>
          <Nuvo::Field @label="Min Price">
            <Nuvo::Input
              type="number"
              placeholder="Min"
              @value={{this.filterMinPrice}}
              @onInput={{fn this.setFieldValue "filterMinPrice"}}
              data-test-filter-min-price
              {{on "change" this.applyFilters}}
            />
          </Nuvo::Field>
          <Nuvo::Field @label="Max Price">
            <Nuvo::Input
              type="number"
              placeholder="Max"
              @value={{this.filterMaxPrice}}
              @onInput={{fn this.setFieldValue "filterMaxPrice"}}
              data-test-filter-max-price
              {{on "change" this.applyFilters}}
            />
          </Nuvo::Field>
        </div>

        <div>
          <span id="amenity-filter-label" class="text-xs text-muted mb-1">Amenities</span>
          <div
            class="flex gap-2 wrap"
            role="group"
            aria-labelledby="amenity-filter-label"
          >
            {{#each this.amenityOptions as |opt|}}
              <button
                type="button"
                class="nu-tag m-pill m-selectable {{if (includes this.filterAmenities opt.key) 'is-selected'}}"
                data-test-amenity-filter={{opt.key}}
                aria-pressed={{if
                  (includes this.filterAmenities opt.key)
                  "true"
                  "false"
                }}
                {{on "click" (fn this.toggleBrowseAmenity opt.key)}}
              >
                <Ui::Ph @icon={{opt.icon}} />
                {{opt.label}}
              </button>
            {{/each}}
          </div>
        </div>

        {{#if this.hasActiveFilters}}
          <div class="flex end">
            <Nuvo::Button
              @variant="danger"
              @size="sm"
              @icon="x"
              {{on "click" this.clearFilters}}
              data-test-clear-filters
            >
              Clear filters
            </Nuvo::Button>
          </div>
        {{/if}}
      </div>
    </Nuvo::Accordion>

    <div class="browse-toolbar" data-test-browse-toolbar>
      <p
        class="text-sm text-muted"
        data-test-browse-result-count
      >{{format-number
          this.browseTotal
          unit="property"
          plural="properties"
        }}</p>
      <div class="browse-toolbar__sort">
        <span class="browse-toolbar__sort-label" id="browse-sort-label">Sort by</span>
        <Nuvo::BtnGroup
          @attached={{true}}
          role="group"
          aria-labelledby="browse-sort-label"
        >
          <Nuvo::Dropdown
            id="browse-sort-field"
            @align="end"
            @value={{this.sortField}}
            @onSelect={{this.setSortField}}
            @options={{this.sortFieldOptions}}
            data-test-sort-field
          />
          {{! Tooltip on a wrapper: a disabled button receives no pointer events. }}
          <span
            data-tooltip={{if
              (eq this.sortDirection "desc")
              "Descending, click for ascending"
              "Ascending, click for descending"
            }}
            data-tooltip-position="start"
          >
            <Nuvo::Button
              @variant="secondary"
              @icon={{if
                (eq this.sortDirection "desc")
                "sort-descending"
                "sort-ascending"
              }}
              @shape="square"
              @disabled={{not this.sortField}}
              aria-label="Toggle sort direction"
              {{on "click" this.toggleSortDirection}}
              data-test-sort-direction
            />
          </span>
        </Nuvo::BtnGroup>
      </div>
    </div>

    {{#if this.isLoadingBrowse}}
      <Nuvo::Card class="text-center">
        <Nuvo::Spinner />
        <p class="text-muted mt-2">Loading...</p>
      </Nuvo::Card>
    {{else if this.browseUnits.length}}
      <div class="browse-unit-grid" data-test-browse-grid>
        {{#each this.browseUnits as |unit|}}
          <LinkTo
            @route="properties.unit"
            @models={{array unit.areaId unit.id}}
            class="unit-browse-card nu-card m-interactive"
            data-test-browse-unit={{unit.id}}
          >
            <div class="unit-card-photo">
              {{#if unit.photos.length}}
                <img
                  src={{object-at unit.photos 0}}
                  alt="Property {{unit.unitNumber}}"
                  width="1600"
                  height="1000"
                  loading="lazy"
                />
              {{else}}
                <div class="unit-card-photo-empty"><Ui::Ph
                    @icon="buildings"
                  /></div>
              {{/if}}
            </div>
            <div class="pt-4 flex col gap-2">
              <div class="flex between x-center">
                <p class="font-bold">Property {{unit.unitNumber}}</p>
                <div class="flex gap-1 x-center">
                  {{#if unit.deletedAt}}
                    <Nuvo::Tag
                      @variant="secondary"
                      @text="Archived"
                      data-test-archived-badge
                    />
                  {{/if}}
                  <Nuvo::Tag
                    class="tag-unit-{{lowercase unit.status}}"
                    @text={{capitalize unit.status}}
                  />
                </div>
              </div>
              <p class="text-xs text-muted">{{unit.assetName}}
                &middot;
                {{unit.areaName}}</p>
              {{#if unit.price}}
                <p class="text-lg font-bold text-success">{{format-currency
                    unit.price
                  }}</p>
              {{/if}}
              {{! Missing value shows a dash so the row never collapses and stays sortable. }}
              <div class="flex gap-3 text-xs text-muted">
                <span
                  class="unit-stat {{unless (has-value unit.bedrooms) 'is-unset'}}"
                  data-test-unit-beds
                ><Ui::Ph @icon="bed" />
                  {{#if (has-value unit.bedrooms)}}
                    {{unit.bedrooms}}
                  {{else}}-{{/if}}
                  bed
                </span>
                <span
                  class="unit-stat {{unless (has-value unit.bathrooms) 'is-unset'}}"
                  data-test-unit-baths
                ><Ui::Ph @icon="bathtub" />
                  {{#if (has-value unit.bathrooms)}}
                    {{unit.bathrooms}}
                  {{else}}-{{/if}}
                  bath
                </span>
                <span
                  class="unit-stat {{unless (has-value unit.sqFt) 'is-unset'}}"
                  data-test-unit-area
                ><Ui::Ph @icon="ruler" />
                  {{#if (has-value unit.sqFt)}}
                    {{format-number unit.sqFt}}
                  {{else}}-{{/if}}
                  sqft
                </span>
              </div>
              {{#if unit.ownerName}}
                <p class="text-xs text-muted"><Ui::Ph @icon="user" />
                  {{unit.ownerName}}</p>
              {{/if}}
              {{#if unit.propertyType}}
                <Nuvo::Tag
                  class="tag-proptype-{{lowercase unit.propertyType}}"
                  @text={{property-type-label unit.propertyType}}
                />
              {{/if}}
            </div>
          </LinkTo>
        {{/each}}
      </div>

      {{#if this.browseHasNextPage}}
        <div class="flex center gap-4" data-test-browse-pagination>
          <Nuvo::Button
            data-test-browse-prev
            @variant="secondary"
            @size="sm"
            @disabled={{eq this.browsePage 1}}
            {{on "click" this.browsePrevPage}}
          >Previous</Nuvo::Button>
          <span class="text-sm text-muted">Page {{this.browsePage}}</span>
          <Nuvo::Button
            data-test-browse-next
            @variant="secondary"
            @size="sm"
            {{on "click" this.browseNextPage}}
          >Next</Nuvo::Button>
        </div>
      {{else if (gt this.browsePage 1)}}
        <div class="flex center gap-4" data-test-browse-pagination>
          <Nuvo::Button
            data-test-browse-prev-empty
            @variant="secondary"
            @size="sm"
            {{on "click" this.browsePrevPage}}
          >Previous</Nuvo::Button>
          <span class="text-sm text-muted">Page {{this.browsePage}}</span>
        </div>
      {{/if}}
    {{else}}
      <Nuvo::EmptyState
        @title="No properties found"
        @description="No properties match your filters."
      >
        <:icon><Ui::Ph @icon="magnifying-glass" /></:icon>
      </Nuvo::EmptyState>
    {{/if}}
  {{/if}}
</div>

<Nuvo::Drawer
  @open={{this.showNewUnitModal}}
  @title="New Property"
  @placement="end"
  @size="lg"
  @onClose={{this.closeNewUnitModal}}
>
  <:body>
    <form
      id="new-property-form"
      class="flex col gap-4"
      {{on "submit" this.saveNewUnit}}
    >
      <Nuvo::Field @label="City" @required={{true}}>
        <RemoteAutocomplete
          @searchUrl={{this.citySearchUrl}}
          @createUrl="/locations/cities"
          @createPayload={{this.cityCreatePayload}}
          @placeholder="Search city..."
          @selectedName={{this.selectedCity.name}}
          @onSelect={{this.selectCity}}
          @onClear={{this.clearCity}}
        />
      </Nuvo::Field>
      {{#if this.selectedCity}}
        <Nuvo::Field @label="Location / Area" @required={{true}}>
          <RemoteAutocomplete
            @searchUrl={{this.localitySearchUrl}}
            @createUrl="/locations/localities"
            @createPayload={{this.localityCreatePayload}}
            @placeholder="Search location..."
            @selectedName={{this.selectedLocality.name}}
            @onSelect={{this.selectLocality}}
            @onClear={{this.clearLocality}}
          />
        </Nuvo::Field>
      {{/if}}
      {{#if this.selectedLocality}}
        <Nuvo::Field @label="Asset" @required={{true}}>
          <RemoteAutocomplete
            @searchUrl={{this.assetSearchUrl}}
            @createUrl="/properties/assets"
            @createPayload={{this.assetCreatePayload}}
            @placeholder="Search asset (tower, villa, mall...)"
            @selectedName={{this.selectedAsset.name}}
            @onSelect={{this.selectAsset}}
            @onClear={{this.clearAsset}}
          />
        </Nuvo::Field>
      {{/if}}
      {{#if this.selectedAsset}}
        <hr class="border-t border-light" />
        <Nuvo::Field @label="Property Number" @required={{true}}>
          <Nuvo::Input
            data-test-new-unit-number
            id="nu-number"
            @type="text"
            @placeholder="e.g. 101, Villa A"
            @value={{this.newUnitNumber}}
            @onInput={{fn this.setFieldValue "newUnitNumber"}}
            required={{true}}
          />
        </Nuvo::Field>

        <div class="flex gap-4">
          <div class="flex col gap-2 grow">
            <Nuvo::Field
              @label="Property Listing Type"
              @tooltip="Choose how this property is listed. For Rent and For Sale make it searchable. Not Listed keeps it hidden."
            >
              <Nuvo::Dropdown
                data-test-new-unit-listing-type
                id="nu-type"
                @align="start"
                @value={{this.newUnitType}}
                @onSelect={{fn this.setFieldValue "newUnitType"}}
                @options={{this.unitTypeOptions}}
                @placeholder="Not Listed"
              />
            </Nuvo::Field>
          </div>
          <div class="flex col gap-2 grow">
            <Nuvo::Field @label="Status">
              <Nuvo::Dropdown
                data-test-new-unit-status
                id="nu-status"
                @align="start"
                @value={{this.newUnitStatus}}
                @onSelect={{fn this.setFieldValue "newUnitStatus"}}
                @options={{this.unitStatusOptions}}
                @placeholder="Select status..."
              />
            </Nuvo::Field>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="flex col gap-2 grow">
            <Nuvo::Field
              @label="Price"
              @tooltip="For a rental, enter the rent per month. For a sale, enter the full asking price."
            >
              <Nuvo::Input
                data-test-new-unit-price
                id="nu-price"
                @type="number"
                @placeholder="0"
                @value={{this.newUnitPrice}}
                @onInput={{fn this.setFieldValue "newUnitPrice"}}
                min="0"
              />
            </Nuvo::Field>
          </div>
          <div class="flex col gap-2 grow">
            <Nuvo::Field @label="Bedrooms">
              <Nuvo::Input
                data-test-new-unit-beds
                id="nu-beds"
                @type="number"
                @placeholder="0"
                @value={{this.newUnitBedrooms}}
                @onInput={{fn this.setFieldValue "newUnitBedrooms"}}
                min="0"
              />
            </Nuvo::Field>
          </div>
        </div>

        <Nuvo::Field @label="Bathrooms">
          <Nuvo::Input
            data-test-new-unit-baths
            id="nu-baths"
            @type="number"
            @placeholder="0"
            @value={{this.newUnitBathrooms}}
            @onInput={{fn this.setFieldValue "newUnitBathrooms"}}
            min="0"
          />
        </Nuvo::Field>

        <hr class="border-t border-light" />
        <Contact::Picker
          @label="Owner"
          @required={{true}}
          @contact={{this.ownerSelection.contact}}
          @identity={{this.ownerSelection.identity}}
          @onSelectContact={{this.ownerSelection.attach}}
          @onClear={{this.ownerSelection.clear}}
          @onIdentityChange={{this.ownerSelection.setField}}
        />
      {{/if}}
      {{#if this.newUnitError}}
        <p class="text-sm text-danger">{{this.newUnitError}}</p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Nuvo::Button
      data-test-new-unit-cancel
      @variant="secondary"
      @text="Cancel"
      @onClick={{this.closeNewUnitModal}}
    />
    {{#if this.selectedAsset}}
      <Nuvo::Button
        data-test-new-unit-save
        @variant="primary"
        @type="submit"
        form="new-property-form"
        @text={{if this.isSavingNewUnit "Creating..." "Create Property"}}
        @loading={{this.isSavingNewUnit}}
      />
    {{/if}}
  </:footer>
</Nuvo::Drawer>