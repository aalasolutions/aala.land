{{page-title
  (if @model.unit (concat "Property " @model.unit.unitNumber) "Property Detail")
}}

<div data-test-unit-detail class="flex col gap-6">
  <div data-test-breadcrumb class="flex x-center gap-2 text-sm text-muted">
    <LinkTo
      @route="properties"
      data-test-breadcrumb-properties
    >Properties</LinkTo>
    <span>/</span>
    {{#if @model.unit.asset.locality}}
      <LinkTo
        @route="properties.detail"
        @model={{@model.areaId}}
        data-test-breadcrumb-area
      >{{@model.unit.asset.locality.name}}</LinkTo>
      <span>/</span>
    {{/if}}
    {{#if @model.unit.asset}}
      <LinkTo
        data-test-breadcrumb-location
        @route="properties.detail"
        @model={{@model.areaId}}
      >{{@model.unit.asset.name}}</LinkTo>
      <span>/</span>
    {{/if}}
    <span class="font-bold text-primary">Property
      {{@model.unit.unitNumber}}</span>
  </div>

  {{#if @model.unit}}
    {{#if this.isArchived}}
      <Nuvo::Alert
        @variant="warning"
        @title="Archived"
        @description="This property is archived and read-only. Photos and documents can still be removed."
        data-test-archived-banner
      >
        <:actions>
          {{#if this.canArchiveUnit}}
            <Nuvo::Button
              @variant="secondary"
              @size="sm"
              @icon="arrow-counter-clockwise"
              data-test-unarchive-unit
              {{on "click" (fn this.openUnitAction "unarchive")}}
            >
              Unarchive
            </Nuvo::Button>
          {{/if}}
        </:actions>
      </Nuvo::Alert>
    {{/if}}

    <div class="unit-detail-grid">
      <div class="flex col gap-4">
        <Nuvo::Card class="flex col gap-3">
          <div class="flex between x-center">
            <h1 data-test-unit-title class="text-2xl font-bold">Property
              {{@model.unit.unitNumber}}</h1>
            <div class="flex gap-2 wrap">
              {{#unless this.isArchived}}
                <Nuvo::Button
                  @variant="secondary"
                  @size="sm"
                  @icon="pencil-simple"
                  data-test-edit-btn
                  {{on "click" this.openEdit}}
                >
                  Edit
                </Nuvo::Button>
                {{#if this.canArchiveUnit}}
                  <Nuvo::Button
                    @variant="secondary"
                    @size="sm"
                    @icon="archive"
                    data-test-archive-unit
                    {{on "click" (fn this.openUnitAction "archive")}}
                  >
                    Archive
                  </Nuvo::Button>
                {{/if}}
              {{/unless}}
              {{#if this.canDeleteUnit}}
                <Nuvo::Button
                  @variant="danger"
                  @size="sm"
                  @icon="trash"
                  data-test-delete-unit
                  {{on "click" (fn this.openUnitAction "delete")}}
                >
                  Delete
                </Nuvo::Button>
              {{/if}}
            </div>
          </div>

          {{#if @model.unit.asset}}
            <p class="text-muted text-sm">
              {{@model.unit.asset.name}}
              {{#if @model.unit.asset.locality}}
                &middot;
                {{@model.unit.asset.locality.name}}
              {{/if}}
            </p>
          {{/if}}

          {{#if @model.unit.price}}
            <p
              data-test-unit-price
              class="text-2xl font-bold text-success"
            >{{format-currency @model.unit.price}}</p>
          {{/if}}

          <div class="flex gap-4 text-sm flex wrap" data-test-unit-specs>
            {{#if @model.unit.bedrooms}}
              <span class="flex x-center gap-1"><Ui::Ph @icon="bed" />
                {{@model.unit.bedrooms}}
                Beds</span>
            {{/if}}
            {{#if @model.unit.bathrooms}}
              <span class="flex x-center gap-1"><Ui::Ph @icon="bathtub" />
                {{@model.unit.bathrooms}}
                Baths</span>
            {{/if}}
            {{#if @model.unit.sqFt}}
              <span class="flex x-center gap-1"><Ui::Ph @icon="ruler" />
                {{format-number @model.unit.sqFt}}
                sqft</span>
            {{/if}}
            {{#if @model.unit.floor}}
              <span class="flex x-center gap-1"><Ui::Ph @icon="stairs" />
                Floor
                {{@model.unit.floor}}</span>
            {{/if}}
          </div>

          <div class="flex gap-3 x-center" data-test-unit-badges>
            <Nuvo::Tag class="tag-unit-{{lowercase @model.unit.status}}">
              {{capitalize @model.unit.status}}
            </Nuvo::Tag>
            {{#if @model.unit.propertyType}}
              <Nuvo::Tag
                class="tag-proptype-{{lowercase @model.unit.propertyType}}"
              >
                {{property-type-label @model.unit.propertyType}}
              </Nuvo::Tag>
            {{/if}}
          </div>

          {{#if @model.unit.owner}}
            <div class="flex x-center gap-2 text-sm" data-test-unit-owner>
              <Ui::Ph @icon="user" />
              <span class="text-muted">Owner:</span>
              <LinkTo
                data-test-owner-link
                @route="contacts.detail"
                @model={{@model.unit.owner.id}}
                class="text-primary owner-link"
              >
                {{@model.unit.owner.displayName}}
              </LinkTo>
            </div>
          {{/if}}
        </Nuvo::Card>

        {{#if @model.unit.amenities.length}}
          <Nuvo::Card data-test-amenities-card>
            <h2
              class="text-sm font-bold uppercase text-muted mb-3"
            >Amenities</h2>
            <Unit::AmenitiesPrint @amenities={{@model.unit.amenities}} />
          </Nuvo::Card>
        {{/if}}
      </div>


      <Nuvo::Card class="flex col gap-4">
        <div class="flex between x-center mb-2">
          <h2 class="text-sm font-bold uppercase text-muted">Photos</h2>
          {{#unless this.isArchived}}
            <label
              class="nu-btn m-primary m-sm {{if this.isUploading 'is-disabled'}}"
              data-test-upload-photo-btn
            >
              <Ui::Ph @icon="camera-plus" />
              <span class="nu-btn__label">{{if
                  this.isUploading
                  this.uploadStatus
                  "Add Photo"
                }}</span>
              <input
                data-test-photo-upload-input
                type="file"
                class="sr-only"
                accept="image/jpeg,image/png,image/webp"
                {{on "change" this.uploadPhoto}}
              />
            </label>
          {{/unless}}
        </div>

        {{#if this.isUploading}}
          <div class="upload-progress" data-test-upload-progress>
            <div class="upload-progress-bar">
              <div class="upload-progress-bar__track"></div>
            </div>
          </div>
        {{/if}}

        {{#if @model.media.length}}
          <div class="unit-main-photo" data-test-main-photo>
            <img
              src={{this.activePhoto.url}}
              alt={{or this.activePhoto.fileName "Property photo"}}
              width="1600"
              height="1000"
            />
          </div>
          <div class="flex gap-2 wrap">
            {{#each @model.media as |media|}}
              <div
                class="unit-thumb {{if media.isPrimary 'unit-thumb-primary'}} {{if (eq media.id this.activePhoto.id) 'is-active'}}"
                data-test-photo-thumb
              >
                <img
                  src={{or media.thumbnailUrl media.url}}
                  alt={{media.fileName}}
                  width="80"
                  height="60"
                  loading="lazy"
                />
                <button
                  type="button"
                  class="unit-thumb__select"
                  aria-label="View {{media.fileName}}"
                  data-test-photo-thumb-select={{media.id}}
                  {{on "click" (fn this.selectPhoto media)}}
                ></button>
                <div class="unit-thumb-actions">
                  {{#unless (or media.isPrimary this.isArchived)}}
                    <Nuvo::Button
                      @variant="secondary"
                      @shape="circle"
                      @size="xs"
                      @icon="star"
                      aria-label="Set {{media.fileName}} as the primary photo"
                      data-tooltip="Set as primary"
                      data-test-set-primary-photo-btn={{media.id}}
                      {{on "click" (fn this.setPrimaryPhoto media)}}
                    />
                  {{/unless}}
                  <Nuvo::Button
                    @variant="danger"
                    @shape="circle"
                    @size="xs"
                    @icon="trash"
                    aria-label="Delete {{media.fileName}}"
                    data-tooltip="Delete photo"
                    data-test-delete-photo-btn={{media.id}}
                    {{on "click" (fn this.openDeletePhoto media)}}
                  />
                </div>
              </div>
            {{/each}}

            {{#if this.previewUrl}}
              <div
                class="unit-thumb upload-preview-thumb"
                data-test-upload-preview
              >
                <img
                  src={{this.previewUrl}}
                  alt="Uploading preview"
                  width="80"
                  height="60"
                />
              </div>
            {{/if}}
          </div>
        {{else if this.previewUrl}}
          <div
            class="unit-main-photo upload-preview-active"
            data-test-upload-preview
          >
            <img
              src={{this.previewUrl}}
              alt="Uploading preview"
              width="1600"
              height="1000"
            />
          </div>
        {{else}}
          <div class="unit-photo-placeholder" data-test-photo-placeholder>
            <Ui::Ph @icon="image" />
            <p class="text-muted mt-2 text-sm">No photos uploaded yet</p>
          </div>
        {{/if}}
      </Nuvo::Card>
    </div>

    {{#if @model.unit.description}}
      <Nuvo::Card data-test-description>
        <h2 class="text-md font-bold mb-3"><Ui::Ph @icon="text-align-left" />
          Description</h2>
        <p class="text-muted">{{@model.unit.description}}</p>
      </Nuvo::Card>
    {{/if}}

    <Nuvo::Card data-test-unit-documents>
      <div class="flex between x-center mb-3">
        <h2 class="text-md font-bold"><Ui::Ph @icon="file-text" />
          Documents</h2>
        {{#unless this.isArchived}}
          <Nuvo::Button
            @variant="primary"
            @size="sm"
            data-test-upload-document-btn
            @icon="upload-simple"
            {{on "click" this.openDocumentCreate}}
          >
            Upload
          </Nuvo::Button>
        {{/unless}}
      </div>

      {{#if @model.documents.length}}
        <DataTable
          @columns={{this.documentColumns}}
          @rows={{@model.documents}}
          @pinColumns={{true}}
          @reorderable={{true}}
          @sortable={{true}}
          @showOptions={{true}}
          @tableId="unit-documents"
          as |cell|
        >
          {{#if (eq cell.key "name")}}
            <span class="font-bold" data-test-document-row>{{cell.value}}</span>
          {{else if (eq cell.key "fileSize")}}
            <span class="text-sm text-muted">{{format-bytes cell.value}}</span>
          {{else if (eq cell.key "category")}}
            <Nuvo::Tag class="tag-doc-{{lowercase cell.value}}">
              {{cell.value}}
            </Nuvo::Tag>
          {{else if (eq cell.key "uploadedByName")}}
            <span
              class="text-sm text-muted"
              data-test-document-uploader
            >{{if cell.value cell.value "-"}}</span>
          {{else if (eq cell.key "id")}}
            <div class="flex gap-2">
              <Nuvo::Button
                @variant="secondary"
                @size="xs"
                data-tooltip="Download"
                aria-label="Download {{cell.row.name}}"
                data-test-download-document-btn
                @icon="download-simple"
                {{on "click" (fn this.downloadDocument cell.row)}}
              />
              {{#unless this.isArchived}}
                <Nuvo::Button
                  @variant="secondary"
                  @size="xs"
                  data-tooltip="Edit"
                  aria-label="Edit {{cell.row.name}}"
                  data-test-edit-document-btn
                  @icon="pencil-simple"
                  {{on "click" (fn this.openDocumentEdit cell.row)}}
                />
              {{/unless}}
              <Nuvo::Button
                @variant="danger"
                @size="xs"
                data-tooltip="Delete"
                aria-label="Delete {{cell.row.name}}"
                data-test-delete-document-btn
                @icon="trash"
                {{on "click" (fn this.openDeleteDocument cell.row)}}
              />
            </div>
          {{else}}
            <span class="text-muted">{{cell.value}}</span>
          {{/if}}
        </DataTable>
      {{else}}
        <p class="text-muted text-sm">No documents uploaded for this property.</p>
      {{/if}}
    </Nuvo::Card>

    <Nuvo::Card data-test-lease-history>
      <h2 class="text-md font-bold mb-3"><Ui::Ph @icon="file-text" />
        Lease History</h2>
      {{#if @model.leases.length}}
        <DataTable
          @columns={{this.leaseColumns}}
          @rows={{@model.leases}}
          @pinColumns={{true}}
          @reorderable={{true}}
          @sortable={{true}}
          @showOptions={{true}}
          @tableId="unit-leases"
          as |cell|
        >
          {{#if (eq cell.key "contact.displayName")}}
            <span data-test-lease-row>{{or cell.value "Unknown tenant"}}</span>
          {{else if (eq cell.key "startDate")}}
            {{format-date cell.value}}
          {{else if (eq cell.key "endDate")}}
            {{format-date cell.value}}
          {{else if (eq cell.key "monthlyRent")}}
            {{format-currency cell.value}}
          {{else if (eq cell.key "status")}}
            <div class="flex gap-1 wrap">
              <Nuvo::Tag class="tag-lease-{{lowercase cell.value}}">
                {{cell.value}}
              </Nuvo::Tag>
              {{#if cell.row.deletedAt}}
                <Nuvo::Tag
                  @variant="secondary"
                  @text="Archived"
                  data-test-lease-archived-badge
                />
              {{/if}}
            </div>
          {{else}}
            <span class="text-muted">{{cell.value}}</span>
          {{/if}}
        </DataTable>
      {{else}}
        <p class="text-muted text-sm">No lease history for this property.</p>
      {{/if}}
    </Nuvo::Card>

    {{#if this.canViewHistory}}
      <Nuvo::Card data-test-unit-history>
        <h2 class="text-md font-bold mb-3"><Ui::Ph
            @icon="clock-counter-clockwise"
          />
          History</h2>
        <RecordHistoryList
          @entityType="Unit"
          @entityId={{@model.unit.id}}
          @reloadKey={{this.isArchived}}
        />
      </Nuvo::Card>
    {{/if}}
  {{else}}
    <Nuvo::EmptyState
      @title="Property not found"
      data-test-unit-not-found
    >
      <:icon><Ui::Ph @icon="warning" /></:icon>
      <:actions>
        <Nuvo::Button
          @variant="primary"
          @route="properties"
          data-test-not-found-back
        >Back to Properties</Nuvo::Button>
      </:actions>
    </Nuvo::EmptyState>
  {{/if}}
</div>

<Nuvo::Drawer
  @open={{this.showEditModal}}
  @title="Edit Property"
  @placement="end"
  @size="lg"
  @onClose={{this.closeEdit}}
>
  <:body>
    <form id="unit-edit-form" class="flex col gap-4" {{on "submit" this.save}}>
      <div class="flex gap-4">
        <Nuvo::Field @label="Property Number" @required={{true}} class="grow">
          <Nuvo::Input
            type="text"
            placeholder="e.g. 101"
            @value={{this.formUnitNumber}}
            @onInput={{fn this.setFieldValue "formUnitNumber"}}
            data-test-field-unit-number
          />
        </Nuvo::Field>
        <Nuvo::Field @label="Status" class="grow">
          <Nuvo::Dropdown
            @align="start"
            @value={{this.formStatus}}
            @onSelect={{fn this.setFieldValue "formStatus"}}
            @options={{this.statusOptions}}
            @placeholder="Select status..."
            data-test-field-status
          />
        </Nuvo::Field>
      </div>

      <Nuvo::Field
        @label="Property Listing Type"
        @tooltip="Choose how this property is listed. For Rent and For Sale make it searchable. Not Listed keeps it hidden."
      >
        <Nuvo::Dropdown
          @align="start"
          @value={{this.formPropertyType}}
          @onSelect={{fn this.setFieldValue "formPropertyType"}}
          @options={{this.propertyTypeOptions}}
          @placeholder="Not Listed"
          data-test-field-property-type
        />
      </Nuvo::Field>

      <div class="flex gap-4">
        <Nuvo::Field
          @label="Price"
          class="grow"
          @tooltip="For a rental, enter the rent per month. For a sale, enter the full asking price."
        >
          <Nuvo::Input
            type="number"
            min="0"
            placeholder="e.g. 150000"
            @value={{this.formPrice}}
            @onInput={{fn this.setFieldValue "formPrice"}}
            data-test-field-price
          />
        </Nuvo::Field>
        <Nuvo::Field @label="Sq Ft" class="grow">
          <Nuvo::Input
            type="number"
            min="0"
            placeholder="e.g. 850"
            @value={{this.formSqFt}}
            @onInput={{fn this.setFieldValue "formSqFt"}}
            data-test-field-sqft
          />
        </Nuvo::Field>
      </div>

      <div class="flex gap-4">
        <Nuvo::Field @label="Bedrooms" class="grow">
          <Nuvo::Input
            type="number"
            min="0"
            placeholder="e.g. 2"
            @value={{this.formBedrooms}}
            @onInput={{fn this.setFieldValue "formBedrooms"}}
            data-test-field-bedrooms
          />
        </Nuvo::Field>
        <Nuvo::Field @label="Bathrooms" class="grow">
          <Nuvo::Input
            type="number"
            min="0"
            placeholder="e.g. 2"
            @value={{this.formBathrooms}}
            @onInput={{fn this.setFieldValue "formBathrooms"}}
            data-test-field-bathrooms
          />
        </Nuvo::Field>
      </div>

      <Nuvo::Field @label="Floor">
        <Nuvo::Input
          type="number"
          min="0"
          placeholder="e.g. 5"
          @value={{this.formFloor}}
          @onInput={{fn this.setFieldValue "formFloor"}}
          data-test-field-floor
        />
      </Nuvo::Field>

      <Nuvo::Field @label="Description">
        <Nuvo::Textarea
          rows="3"
          placeholder="Property description..."
          @value={{this.formDescription}}
          @onInput={{fn this.setFieldValue "formDescription"}}
          data-test-field-description
        />
      </Nuvo::Field>

      <Contact::Picker
        @label="Owner"
        @required={{true}}
        @contact={{this.ownerSelection.contact}}
        @identity={{this.ownerSelection.identity}}
        @onSelectContact={{this.ownerSelection.attach}}
        @onClear={{this.ownerSelection.clear}}
        @onIdentityChange={{this.ownerSelection.setField}}
      />

      <div class="flex col gap-2">
        <span id="unit-form-amenities-label" class="text-sm text-muted">Amenities</span>
        <div
          class="flex gap-2 wrap"
          role="group"
          aria-labelledby="unit-form-amenities-label"
          data-test-amenities-picker
        >
          {{#each this.amenityOptions as |opt|}}
            <button
              type="button"
              class="nu-tag m-pill m-selectable {{if (includes this.formAmenities opt.key) 'is-selected'}}"
              data-test-amenity={{opt.key}}
              aria-pressed={{if
                (includes this.formAmenities opt.key)
                "true"
                "false"
              }}
              {{on "click" (fn this.toggleAmenity opt.key)}}
            >
              <Ui::Ph @icon={{opt.icon}} />
              {{opt.label}}
            </button>
          {{/each}}
        </div>
      </div>

      {{#if this.errorMsg}}
        <p class="text-sm text-danger" data-test-error>{{this.errorMsg}}</p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Nuvo::Button
      @variant="secondary"
      data-test-cancel-btn
      {{on "click" this.closeEdit}}
    >Cancel</Nuvo::Button>
    <Nuvo::Button
      @variant="primary"
      type="submit"
      form="unit-edit-form"
      @loading={{this.isSaving}}
      data-test-save-btn
    >
      {{if this.isSaving "Saving..." "Update Property"}}
    </Nuvo::Button>
  </:footer>
</Nuvo::Drawer>

<ConfirmModal
  @open={{this.showDeleteModal}}
  @title="Delete Photo"
  @message="Delete this photo? This cannot be undone."
  @confirmText="Delete"
  @confirmVariant="danger"
  @isConfirming={{this.isDeleting}}
  @confirmingText="Deleting..."
  @onClose={{this.closeDeleteModal}}
  @onConfirm={{this.confirmDeletePhoto}}
/>

<Nuvo::Drawer
  @open={{this.showDocumentModal}}
  @title={{if this.editDocument "Update Document" "Upload Document"}}
  @placement="end"
  @size="lg"
  @onClose={{this.closeDocumentModal}}
  @onClosed={{this.resetDocumentDrawer}}
>
  <:body>
    <form
      id="unit-document-form"
      class="flex col gap-4"
      {{on "submit" this.saveDocument}}
    >
      <Nuvo::Field @label="File" @required={{unless this.editDocument true false}}>
        <input
          id="ud-file"
          type="file"
          class="nu-input"
          data-test-document-file-input
          accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.rtf,.txt,.md,.csv,.jpg,.jpeg,.png,.webp,.gif"
          {{on "change" this.onDocFileSelect}}
        />
        {{#if this.selectedDocFile}}
          <p class="text-xs text-muted" data-test-selected-document-file>
            Selected:
            {{this.selectedDocFile.name}}
            ({{format-bytes this.selectedDocFile.size}})
          </p>
        {{/if}}
      </Nuvo::Field>

      <Nuvo::Field @label="Document Name" @required={{true}}>
        <Nuvo::Input
          type="text"
          placeholder="Title Deed"
          @value={{this.formDocName}}
          @onInput={{fn this.setFieldValue "formDocName"}}
          data-test-document-field-name
        />
      </Nuvo::Field>

      <div class="flex gap-4">
        <Nuvo::Field @label="Category" class="grow">
          <Nuvo::Dropdown
            @align="start"
            @value={{this.formDocCategory}}
            @onSelect={{fn this.setFieldValue "formDocCategory"}}
            @options={{this.documentCategoryOptions}}
            @placeholder="Select category..."
            data-test-document-field-category
          />
        </Nuvo::Field>
        <Nuvo::Field
          @label="Access Level"
          class="grow"
          @tooltip="Team means every staff member can open this file. Admin means only admins can."
        >
          <Nuvo::Dropdown
            @align="start"
            @value={{this.formDocAccessLevel}}
            @onSelect={{fn this.setFieldValue "formDocAccessLevel"}}
            @options={{this.documentAccessLevelOptions}}
            @placeholder="Select access level..."
            data-test-document-field-access
          />
        </Nuvo::Field>
      </div>

      {{#if this.isSavingDocument}}
        {{#unless this.editDocument}}
          <div data-test-document-upload-progress>
            <Nuvo::Progress
              @value={{this.uploadProgress}}
              @showText={{true}}
            />
          </div>
        {{/unless}}
      {{/if}}

      {{#if this.documentErrorMsg}}
        <p class="text-sm text-danger" data-test-document-error>
          {{this.documentErrorMsg}}
        </p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Nuvo::Button
      data-test-document-cancel
      @variant="secondary"
      {{on "click" this.closeDocumentModal}}
    >Cancel</Nuvo::Button>
    <Nuvo::Button
      @variant="primary"
      type="submit"
      form="unit-document-form"
      @loading={{this.isSavingDocument}}
      data-test-document-save-btn
    >
      {{if
        this.isSavingDocument
        "Uploading..."
        (if this.editDocument "Update" "Upload")
      }}
    </Nuvo::Button>
  </:footer>
</Nuvo::Drawer>

<ConfirmModal
  @open={{this.showDeleteDocumentModal}}
  @title="Delete Document"
  @message="Delete {{this.documentToDelete.name}}? This cannot be undone."
  @confirmText="Delete"
  @confirmVariant="danger"
  @isConfirming={{this.isDeletingDocument}}
  @confirmingText="Deleting..."
  @onClose={{this.closeDeleteDocumentModal}}
  @onConfirm={{this.confirmDeleteDocument}}
/>

<ConfirmModal
  @open={{this.showUnitActionModal}}
  @title={{this.unitActionConfig.title}}
  @message={{this.unitActionConfig.message}}
  @confirmText={{this.unitActionConfig.confirmText}}
  @confirmVariant={{this.unitActionConfig.confirmVariant}}
  @isConfirming={{this.isSubmittingUnitAction}}
  @confirmingText={{this.unitActionConfig.confirmingText}}
  @onClose={{this.closeUnitAction}}
  @onConfirm={{this.confirmUnitAction}}
>
  <Nuvo::Field
    class="mt-4"
    @label={{if
      this.unitActionConfig.reasonRequired
      "Reason"
      "Reason (optional)"
    }}
    @required={{this.unitActionConfig.reasonRequired}}
    @error={{this.reasonError}}
  >
    <Nuvo::Textarea
      rows="2"
      maxlength="500"
      placeholder="e.g. Sold, no longer managed"
      @value={{this.unitActionReason}}
      @onInput={{fn this.setFieldValue "unitActionReason"}}
      @invalid={{if this.reasonError true false}}
      data-test-reason-input
    />
  </Nuvo::Field>
</ConfirmModal>