{{page-title
  (if @model.unit (concat "Property " @model.unit.unitNumber) "Property Detail")
}}

<div data-test-unit-detail class="flex col gap-6">
  {{! Breadcrumb }}
  <div data-test-breadcrumb class="flex x-center gap-2 text-sm text-muted">
    <LinkTo
      @route="properties"
      data-test-breadcrumb-properties
    >Properties</LinkTo>
    <span>/</span>
    {{#if @model.unit.asset.locality}}
      <LinkTo
        @route="properties.detail"
        @model={{@model.areaId}}
        data-test-breadcrumb-area
      >{{@model.unit.asset.locality.name}}</LinkTo>
      <span>/</span>
    {{/if}}
    {{#if @model.unit.asset}}
      <LinkTo
        @route="properties.detail"
        @model={{@model.areaId}}
      >{{@model.unit.asset.name}}</LinkTo>
      <span>/</span>
    {{/if}}
    <span class="font-bold text-primary">Property
      {{@model.unit.unitNumber}}</span>
  </div>

  {{#if @model.unit}}
    {{! Two column: Gallery + Info }}
    <div class="unit-detail-grid">
      {{! Left: Photo gallery }}
      <Nuvo::Card class="flex col gap-4">
        <div class="flex between x-center mb-2">
          <h4 class="text-sm font-bold uppercase text-muted">Photos</h4>
          <label
            class="nu-btn m-primary m-sm {{if this.isUploading 'is-disabled'}}"
            data-test-upload-photo-btn
          >
            <Ui::Ph @icon="camera-plus" />
            <span class="nu-btn__label">{{if
                this.isUploading
                this.uploadStatus
                "Add Photo"
              }}</span>
            <input
              type="file"
              class="sr-only"
              accept="image/jpeg,image/png,image/webp"
              {{on "change" this.uploadPhoto}}
            />
          </label>
        </div>

        {{#if this.isUploading}}
          <div class="upload-progress" data-test-upload-progress>
            <div class="upload-progress-bar">
              <div class="upload-progress-bar__track"></div>
            </div>
          </div>
        {{/if}}

        {{#if @model.media.length}}
          {{#let (object-at @model.media 0) as |primary|}}
            <div class="unit-main-photo" data-test-main-photo>
              <img src={{primary.url}} alt="Property photo" />
            </div>
          {{/let}}
          <div class="flex gap-2 wrap">
            {{#each @model.media as |media|}}
              <div
                class="unit-thumb {{if media.isPrimary 'unit-thumb-primary'}}"
                data-test-photo-thumb
              >
                <img
                  src={{or media.thumbnailUrl media.url}}
                  alt={{media.fileName}}
                />
                <div class="unit-thumb-actions">
                  {{#unless media.isPrimary}}
                    <Nuvo::Button
                      @variant="secondary"
                      @shape="circle"
                      @size="xs"
                      @icon="★"
                      title="Set as primary"
                      {{on "click" (fn this.setPrimaryPhoto media)}}
                    />
                  {{/unless}}
                  <Nuvo::Button
                    @variant="danger"
                    @shape="circle"
                    @size="xs"
                    @icon="🗑"
                    title="Delete"
                    {{on "click" (fn this.openDeletePhoto media)}}
                  />
                </div>
              </div>
            {{/each}}

            {{#if this.previewUrl}}
              <div
                class="unit-thumb upload-preview-thumb"
                data-test-upload-preview
              >
                <img src={{this.previewUrl}} alt="Uploading preview" />
              </div>
            {{/if}}
          </div>
        {{else if this.previewUrl}}
          <div
            class="unit-main-photo upload-preview-active"
            data-test-upload-preview
          >
            <img src={{this.previewUrl}} alt="Uploading preview" />
          </div>
        {{else}}
          <div class="unit-photo-placeholder" data-test-photo-placeholder>
            <Ui::Ph @icon="image" />
            <p class="text-muted mt-2 text-sm">No photos uploaded yet</p>
          </div>
        {{/if}}
      </Nuvo::Card>

      {{! Right: Property info panel }}
      <div class="flex col gap-4">
        <Nuvo::Card class="flex col gap-3">
          <div class="flex between x-center">
            <h2 data-test-unit-title class="text-2xl font-bold">Property
              {{@model.unit.unitNumber}}</h2>
            <Nuvo::Button
              @variant="secondary"
              @size="sm"
              @icon="✎"
              data-test-edit-btn
              {{on "click" this.openEdit}}
            >
              Edit
            </Nuvo::Button>
          </div>

          {{#if @model.unit.asset}}
            <p class="text-muted text-sm">
              {{@model.unit.asset.name}}
              {{#if @model.unit.asset.locality}}
                &middot;
                {{@model.unit.asset.locality.name}}
              {{/if}}
            </p>
          {{/if}}

          {{#if @model.unit.price}}
            <p
              data-test-unit-price
              class="text-2xl font-bold text-success"
            >{{format-currency @model.unit.price}}</p>
          {{/if}}

          {{! Specs row }}
          <div class="flex gap-4 text-sm flex wrap" data-test-unit-specs>
            {{#if @model.unit.bedrooms}}
              <span class="flex x-center gap-1"><Ui::Ph @icon="bed" />
                {{@model.unit.bedrooms}}
                Beds</span>
            {{/if}}
            {{#if @model.unit.bathrooms}}
              <span class="flex x-center gap-1"><Ui::Ph @icon="bathtub" />
                {{@model.unit.bathrooms}}
                Baths</span>
            {{/if}}
            {{#if @model.unit.sqFt}}
              <span class="flex x-center gap-1"><Ui::Ph @icon="ruler" />
                {{format-number @model.unit.sqFt}}
                sqft</span>
            {{/if}}
            {{#if @model.unit.floor}}
              <span class="flex x-center gap-1"><Ui::Ph @icon="stairs" />
                Floor
                {{@model.unit.floor}}</span>
            {{/if}}
          </div>

          {{! Status + Property Type badges }}
          <div class="flex gap-3 x-center" data-test-unit-badges>
            <Nuvo::Tag class="badge-unit-{{lowercase @model.unit.status}}">
              {{capitalize @model.unit.status}}
            </Nuvo::Tag>
            {{#if @model.unit.propertyType}}
              <Nuvo::Tag
                class="badge-proptype-{{lowercase @model.unit.propertyType}}"
              >
                {{if
                  (eq @model.unit.propertyType "FOR_SALE")
                  "For Sale"
                  "For Rent"
                }}
              </Nuvo::Tag>
            {{/if}}
          </div>

          {{! Owner }}
          {{#if @model.unit.owner}}
            <div class="flex x-center gap-2 text-sm" data-test-unit-owner>
              <Ui::Ph @icon="user" />
              <span class="text-muted">Owner:</span>
              <LinkTo
                @route="owners.detail"
                @model={{@model.unit.owner.id}}
                class="text-primary owner-link"
              >
                {{@model.unit.owner.name}}
              </LinkTo>
            </div>
          {{/if}}
        </Nuvo::Card>

        {{! Amenities card }}
        {{#if @model.unit.amenities.length}}
          <Nuvo::Card data-test-amenities-card>
            <h4
              class="text-sm font-bold uppercase text-muted mb-3"
            >Amenities</h4>
            <Unit::AmenitiesPrint @amenities={{@model.unit.amenities}} />
          </Nuvo::Card>
        {{/if}}
      </div>
    </div>

    {{! Description }}
    {{#if @model.unit.description}}
      <Nuvo::Card data-test-description>
        <h4 class="text-md font-bold mb-3"><Ui::Ph @icon="text-align-left" />
          Description</h4>
        <p class="text-muted">{{@model.unit.description}}</p>
      </Nuvo::Card>
    {{/if}}

    {{! Documents }}
    <Nuvo::Card data-test-unit-documents>
      <div class="flex between x-center mb-3">
        <h4 class="text-md font-bold"><Ui::Ph @icon="file-text" />
          Documents</h4>
        <Nuvo::Button
          @variant="primary"
          @size="sm"
          data-test-upload-document-btn
          {{on "click" this.openDocumentCreate}}
        >
          <Ui::Ph @icon="upload-simple" />
          Upload
        </Nuvo::Button>
      </div>

      {{#if @model.documents.length}}
        <div class="nu-table-wrapper">
          <table class="nu-table">
            <thead>
              <tr>
                <th>Title</th>
                <th>Size</th>
                <th>Document Type</th>
                <th>Uploaded By</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {{#each @model.documents as |doc|}}
                <tr data-test-document-row>
                  <td class="font-bold">{{doc.name}}</td>
                  <td class="text-sm text-muted">{{format-bytes
                      doc.fileSize
                    }}</td>
                  <td><Nuvo::Tag class="badge-doc-{{lowercase doc.category}}">
                      {{doc.category}}
                    </Nuvo::Tag></td>
                  <td
                    class="text-sm text-muted"
                    data-test-document-uploader
                  >{{if doc.uploadedByName doc.uploadedByName "—"}}</td>
                  <td>
                    <div class="flex gap-2">
                      <Nuvo::Button
                        @variant="secondary"
                        @size="xs"
                        title="Download"
                        data-test-download-document-btn
                        {{on "click" (fn this.downloadDocument doc)}}
                      >
                        <Ui::Ph @icon="download-simple" />
                      </Nuvo::Button>
                      <Nuvo::Button
                        @variant="secondary"
                        @size="xs"
                        title="Edit"
                        data-test-edit-document-btn
                        {{on "click" (fn this.openDocumentEdit doc)}}
                      >
                        <Ui::Ph @icon="pencil-simple" />
                      </Nuvo::Button>
                      <Nuvo::Button
                        @variant="danger"
                        @size="xs"
                        title="Delete"
                        data-test-delete-document-btn
                        {{on "click" (fn this.openDeleteDocument doc)}}
                      >
                        <Ui::Ph @icon="trash" />
                      </Nuvo::Button>
                    </div>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <p class="text-muted text-sm">No documents uploaded for this property.</p>
      {{/if}}
    </Nuvo::Card>

    {{! Lease History }}
    <Nuvo::Card data-test-lease-history>
      <h4 class="text-md font-bold mb-3"><Ui::Ph @icon="file-text" />
        Lease History</h4>
      {{#if @model.leases.length}}
        <div class="nu-table-wrapper">
          <table class="nu-table">
            <thead>
              <tr>
                <th>Tenant</th>
                <th>Start</th>
                <th>End</th>
                <th>Rent</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {{#each @model.leases as |lease|}}
                <tr data-test-lease-row>
                  <td>{{lease.tenantName}}</td>
                  <td>{{format-date lease.startDate}}</td>
                  <td>{{format-date lease.endDate}}</td>
                  <td>{{format-currency lease.monthlyRent}}</td>
                  <td><Nuvo::Tag class="badge-lease-{{lowercase lease.status}}">
                      {{lease.status}}
                    </Nuvo::Tag></td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <p class="text-muted text-sm">No lease history for this property.</p>
      {{/if}}
    </Nuvo::Card>
  {{else}}
    <Nuvo::EmptyState
      @title="Property not found"
      data-test-unit-not-found
    >
      <:icon><Ui::Ph @icon="warning" /></:icon>
      <:actions>
        <LinkTo @route="properties" class="nu-btn m-primary">Back to
          Properties</LinkTo>
      </:actions>
    </Nuvo::EmptyState>
  {{/if}}
</div>

{{! Edit Modal }}
<Nuvo::Modal
  @open={{this.showEditModal}}
  @title="Edit Property"
  @onClose={{this.closeEdit}}
>
  <form class="flex col gap-4" {{on "submit" this.save}}>
    <div class="flex gap-4">
      <Nuvo::Field @label="Property Number" @required={{true}} class="grow">
        <Nuvo::Input
          type="text"
          placeholder="e.g. 101"
          @value={{this.formUnitNumber}}
          @onInput={{fn this.setFieldValue "formUnitNumber"}}
          data-test-field-unit-number
        />
      </Nuvo::Field>
      <Nuvo::Field @label="Status" class="grow">
        <Nuvo::Dropdown
          @searchable={{true}}
          @align="start"
          @value={{this.formStatus}}
          @onSelect={{fn this.setFieldValue "formStatus"}}
          @options={{this.statusOptions}}
          @placeholder="Select status..."
          data-test-field-status
        />
      </Nuvo::Field>
    </div>

    <Nuvo::Field @label="Listing Type">
      <Nuvo::Dropdown
        @searchable={{true}}
        @align="start"
        @value={{this.formPropertyType}}
        @onSelect={{fn this.setFieldValue "formPropertyType"}}
        @options={{this.propertyTypeOptions}}
        @placeholder="Not Listed"
        data-test-field-property-type
      />
    </Nuvo::Field>

    <div class="flex gap-4">
      <Nuvo::Field @label="Price" class="grow">
        <Nuvo::Input
          type="number"
          min="0"
          placeholder="e.g. 150000"
          @value={{this.formPrice}}
          @onInput={{fn this.setFieldValue "formPrice"}}
          data-test-field-price
        />
      </Nuvo::Field>
      <Nuvo::Field @label="Sq Ft" class="grow">
        <Nuvo::Input
          type="number"
          min="0"
          placeholder="e.g. 850"
          @value={{this.formSqFt}}
          @onInput={{fn this.setFieldValue "formSqFt"}}
          data-test-field-sqft
        />
      </Nuvo::Field>
    </div>

    <div class="flex gap-4">
      <Nuvo::Field @label="Bedrooms" class="grow">
        <Nuvo::Input
          type="number"
          min="0"
          placeholder="e.g. 2"
          @value={{this.formBedrooms}}
          @onInput={{fn this.setFieldValue "formBedrooms"}}
          data-test-field-bedrooms
        />
      </Nuvo::Field>
      <Nuvo::Field @label="Bathrooms" class="grow">
        <Nuvo::Input
          type="number"
          min="0"
          placeholder="e.g. 2"
          @value={{this.formBathrooms}}
          @onInput={{fn this.setFieldValue "formBathrooms"}}
          data-test-field-bathrooms
        />
      </Nuvo::Field>
    </div>

    <Nuvo::Field @label="Floor">
      <Nuvo::Input
        type="number"
        min="0"
        placeholder="e.g. 5"
        @value={{this.formFloor}}
        @onInput={{fn this.setFieldValue "formFloor"}}
        data-test-field-floor
      />
    </Nuvo::Field>

    <Nuvo::Field @label="Description">
      <Nuvo::Textarea
        rows="3"
        placeholder="Property description..."
        @value={{this.formDescription}}
        @onInput={{fn this.setFieldValue "formDescription"}}
        data-test-field-description
      />
    </Nuvo::Field>

    <Nuvo::Field @label="Owner">
      <Nuvo::Dropdown
        @searchable={{true}}
        @align="start"
        @value={{this.formOwnerId}}
        @onSelect={{fn this.setFieldValue "formOwnerId"}}
        @options={{this.ownerOptions}}
        @placeholder="Unassigned"
        data-test-field-owner
      />
    </Nuvo::Field>

    <div class="flex col gap-2">
      <label class="text-sm text-muted">Amenities</label>
      <div class="flex gap-2 wrap" data-test-amenities-picker>
        {{#each this.amenityOptions as |opt|}}
          <button
            type="button"
            class="nu-tag m-pill m-selectable
              {{if
                (includes this.formAmenities opt.key)
                'is-selected'
              }}"
            data-test-amenity={{opt.key}}
            {{on "click" (fn this.toggleAmenity opt.key)}}
          >
            <Ui::Ph @icon={{opt.icon}} />
            {{opt.label}}
          </button>
        {{/each}}
      </div>
    </div>

    {{#if this.errorMsg}}
      <p class="text-sm text-danger" data-test-error>{{this.errorMsg}}</p>
    {{/if}}

    <Nuvo::FormActions>
      <Nuvo::Button
        @variant="secondary"
        data-test-cancel-btn
        {{on "click" this.closeEdit}}
      >Cancel</Nuvo::Button>
      <Nuvo::Button
        @variant="primary"
        type="submit"
        @loading={{this.isSaving}}
        data-test-save-btn
      >
        {{if this.isSaving "Saving..." "Update Property"}}
      </Nuvo::Button>
    </Nuvo::FormActions>
  </form>
</Nuvo::Modal>

<ConfirmModal
  @open={{this.showDeleteModal}}
  @title="Delete Photo"
  @message="Are you sure you want to delete this photo? This action cannot be undone."
  @confirmText="Delete"
  @cancelText="Cancel"
  @confirmVariant="danger"
  @isConfirming={{this.isDeleting}}
  @confirmingText="Deleting..."
  @onClose={{this.closeDeleteModal}}
  @onConfirm={{this.confirmDeletePhoto}}
/>

{{! Upload/Edit Document Modal }}
<Nuvo::Modal
  @open={{this.showDocumentModal}}
  @title={{if this.editDocument "Update Document" "Upload Document"}}
  @onClose={{this.closeDocumentModal}}
>
  <form class="flex col gap-4" {{on "submit" this.saveDocument}}>
    <Nuvo::Field @label="File {{unless this.editDocument '*'}}">
      <input
        id="ud-file"
        type="file"
        class="nu-input"
        data-test-document-file-input
        accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.rtf,.txt,.md,.csv,.jpg,.jpeg,.png,.webp,.gif"
        {{on "change" this.onDocFileSelect}}
      />
      {{#if this.selectedDocFile}}
        <p class="text-xs text-muted" data-test-selected-document-file>
          Selected:
          {{this.selectedDocFile.name}}
          ({{format-bytes this.selectedDocFile.size}})
        </p>
      {{/if}}
    </Nuvo::Field>

    <Nuvo::Field @label="Document Name" @required={{true}}>
      <Nuvo::Input
        type="text"
        placeholder="Title Deed"
        @value={{this.formDocName}}
        @onInput={{fn this.setFieldValue "formDocName"}}
        data-test-document-field-name
      />
    </Nuvo::Field>

    <div class="flex gap-4">
      <Nuvo::Field @label="Category" class="grow">
        <Nuvo::Dropdown
          @searchable={{true}}
          @align="start"
          @value={{this.formDocCategory}}
          @onSelect={{fn this.setFieldValue "formDocCategory"}}
          @options={{this.documentCategoryOptions}}
          @placeholder="Select category..."
          data-test-document-field-category
        />
      </Nuvo::Field>
      <Nuvo::Field @label="Access Level" class="grow">
        <Nuvo::Dropdown
          @searchable={{true}}
          @align="start"
          @value={{this.formDocAccessLevel}}
          @onSelect={{fn this.setFieldValue "formDocAccessLevel"}}
          @options={{this.documentAccessLevelOptions}}
          @placeholder="Select access level..."
          data-test-document-field-access
        />
      </Nuvo::Field>
    </div>

    {{#if this.isSavingDocument}}
      {{#unless this.editDocument}}
        <div data-test-document-upload-progress>
          <Nuvo::Progress
            @value={{this.uploadProgress}}
            @showText={{true}}
          />
        </div>
      {{/unless}}
    {{/if}}

    {{#if this.documentErrorMsg}}
      <p class="text-sm text-danger" data-test-document-error>
        {{this.documentErrorMsg}}
      </p>
    {{/if}}

    <Nuvo::FormActions>
      <Nuvo::Button
        @variant="secondary"
        {{on "click" this.closeDocumentModal}}
      >Cancel</Nuvo::Button>
      <Nuvo::Button
        @variant="primary"
        type="submit"
        @loading={{this.isSavingDocument}}
        data-test-document-save-btn
      >
        {{if
          this.isSavingDocument
          "Uploading..."
          (if this.editDocument "Update" "Upload")
        }}
      </Nuvo::Button>
    </Nuvo::FormActions>
  </form>
</Nuvo::Modal>

<ConfirmModal
  @open={{this.showDeleteDocumentModal}}
  @title="Delete Document"
  @message="Are you sure you want to delete {{this.documentToDelete.name}}? This action cannot be undone."
  @confirmText="Delete"
  @cancelText="Cancel"
  @confirmVariant="danger"
  @isConfirming={{this.isDeletingDocument}}
  @confirmingText="Deleting..."
  @onClose={{this.closeDeleteDocumentModal}}
  @onConfirm={{this.confirmDeleteDocument}}
/>