{{page-title "Maintenance"}}

<div data-test-maintenance-page class="flex col gap-6">
  <Nuvo::PageHeader @title="Maintenance" @subtitle="Track and manage property work orders.">
    <:actions>
      <Nuvo::Button @variant="primary" {{on "click" this.openCreate}} @icon="plus">
        New Work Order
      </Nuvo::Button>
    </:actions>
  </Nuvo::PageHeader>

  {{#if @model.costSummary}}
    <div class="grid cols-4 gap-4">
      <Nuvo::Stat
        @variant="primary"
        @label="Total Estimated"
        @value={{format-currency @model.costSummary.totalEstimated}}
      />
      <Nuvo::Stat
        @variant="primary"
        @label="Total Actual"
        @value={{format-currency @model.costSummary.totalActual}}
      />
      <Nuvo::Stat
        @variant="warning"
        @label="Pending Cost"
        @value={{format-currency @model.costSummary.pendingCost}}
      />
      <Nuvo::Stat
        @variant="secondary"
        @label="Work Orders"
        @value={{@model.costSummary.totalOrders}}
      />
    </div>
  {{/if}}

  <Nuvo::Tabs
    @tabs={{this.sectionTabs}}
    @activeTab={{this.activeSection}}
    @onChange={{this.setSection}}
  />

  {{#if (eq this.activeSection "orders")}}
    <div class="flex gap-4 x-center">
      <Nuvo::Field @label="Status">
        <Nuvo::Dropdown
          id="maintenance-status-filter"
          @align="start"
          @value={{this.filterStatus}}
          @onSelect={{this.setStatusFilter}}
          @options={{this.statusOptions}}
          @placeholder="All"
        />
      </Nuvo::Field>
      <Nuvo::Field @label="Period">
        <Nuvo::Dropdown
          id="maintenance-period-filter"
          @align="start"
          @value={{this.filterMonth}}
          @onSelect={{this.setMonthFilter}}
          @options={{this.monthOptions}}
          @placeholder="All"
        />
      </Nuvo::Field>
    </div>

    <Nuvo::Card>
      {{#if this.filteredWorkOrders.length}}
        <div class="nu-table-wrapper">
          <table class="nu-table" data-test-work-orders-table>
            <thead>
              <tr>
                <th>Title</th>
                <th>Property</th>
                <th>Category</th>
                <th>Priority</th>
                <th>Est. Cost</th>
                <th>Actual Cost</th>
                <th>Scheduled</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {{#each this.filteredWorkOrders as |wo|}}
                <tr data-test-work-order>
                  <td>
                    <p class="text-sm font-bold">{{wo.title}}</p>
                    {{#if wo.vendorId}}<p class="text-muted text-xs"><Ui::Ph
                          @icon="toolbox"
                        />
                        Vendor assigned</p>{{/if}}
                  </td>
                  <td class="text-sm text-muted">
                    {{#if wo.unitNumber}}
                      {{wo.areaName}}
                      /
                      {{wo.assetName}}
                      /
                      {{wo.unitNumber}}
                    {{else}}
                      <span class="text-muted">-</span>
                    {{/if}}
                  </td>
                  <td>
                    <Nuvo::Tag
                      class="tag-trade-{{lowercase wo.category}}"
                      @text={{wo.category}}
                    />
                  </td>
                  <td>
                    <Nuvo::Tag
                      class="tag-priority-{{lowercase wo.priority}}"
                      @text={{wo.priority}}
                    />
                  </td>
                  <td>{{#if wo.estimatedCost}}{{format-currency
                        wo.estimatedCost
                      }}{{else}}-{{/if}}</td>
                  <td>{{#if wo.actualCost}}{{format-currency
                        wo.actualCost
                      }}{{else}}-{{/if}}</td>
                  <td class="text-xs">{{#if wo.scheduledDate}}{{format-date
                        wo.scheduledDate
                      }}{{else}}-{{/if}}</td>
                  <td>
                    <Nuvo::Tag
                      class="tag-wo-{{lowercase wo.status}}"
                      @text={{wo.status}}
                    />
                  </td>
                  <td>
                    <Nuvo::Button
                      @variant="secondary"
                      @size="xs"
                      @icon="pencil-simple"
                      {{on "click" (fn this.openEdit wo)}}
                    >
                      Edit
                    </Nuvo::Button>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <Nuvo::Pagination
          @selectId="maintenance-limit"
          @page={{this.page}}
          @limit={{this.limit}}
          @total={{@model.total}}
          @onLimitChange={{this.setLimit}}
          @onPrevious={{this.goToPreviousPage}}
          @onNext={{this.goToNextPage}}
        />
      {{else}}
        {{#if @model.total}}
          <Nuvo::EmptyState
            @description="No work orders on this page with current filters. Navigate to find orders or adjust filters."
          />
          <Nuvo::Pagination
            @selectId="maintenance-limit"
            @page={{this.page}}
            @limit={{this.limit}}
            @total={{@model.total}}
            @onLimitChange={{this.setLimit}}
            @onPrevious={{this.goToPreviousPage}}
            @onNext={{this.goToNextPage}}
          />
        {{else}}
          <Nuvo::EmptyState
            @title="No work orders"
            @description="No work orders match your filters."
          />
        {{/if}}
      {{/if}}
    </Nuvo::Card>
  {{/if}}

  {{#if (eq this.activeSection "upcoming")}}
    <Nuvo::Card>
      <h4 class="text-lg font-bold mb-3"><Ui::Ph @icon="clock-countdown" />
        Preventive Maintenance (Next 30 Days)</h4>
      {{#if @model.upcoming.length}}
        <div class="flex col gap-3">
          {{#each @model.upcoming as |wo|}}
            <div
              class="flex between x-center p-4 rounded bg-white@02 border border-white@05"
            >
              <div class="flex col gap-1">
                <p class="text-sm font-bold">{{wo.title}}</p>
                <p class="text-muted text-xs">{{wo.category}}
                  - Scheduled:
                  {{format-date wo.scheduledDate}}</p>
              </div>
              <div class="flex x-center gap-3">
                <Nuvo::Tag
                  class="tag-priority-{{lowercase wo.priority}}"
                  @text={{wo.priority}}
                />
                <Nuvo::Button
                  @variant="secondary"
                  @size="xs"
                  @icon="pencil-simple"
                  {{on "click" (fn this.openEdit wo)}}
                >
                  Edit
                </Nuvo::Button>
              </div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <Nuvo::EmptyState
          @description="No preventive maintenance scheduled for the next 30 days."
        />
      {{/if}}
    </Nuvo::Card>
  {{/if}}
</div>

<Nuvo::Modal
  @open={{this.showModal}}
  @title={{if this.editWorkOrder "Edit Work Order" "New Work Order"}}
  @onClose={{this.closeModal}}
>
  <form class="flex col gap-4" {{on "submit" this.saveWorkOrder}}>
    <Nuvo::Field @label="Property" @required={{true}}>
      <Nuvo::Dropdown
        id="wo-unit"
        @align="start"
        @value={{this.formUnitId}}
        @onSelect={{fn this.setFieldValue "formUnitId"}}
        @options={{this.unitOptions}}
        @placeholder="Select a property..."
        data-test-wo-unit
      />
    </Nuvo::Field>

    <Nuvo::Field @label="Title" @required={{true}}>
      <Nuvo::Input
        id="wo-title"
        type="text"
        placeholder="e.g. Fix leaking pipe in property 302"
        @value={{this.formTitle}}
        @onInput={{fn this.setFieldValue "formTitle"}}
        required={{true}}
      />
    </Nuvo::Field>

    <Nuvo::Field @label="Description" @required={{true}}>
      <Nuvo::Textarea
        id="wo-desc"
        placeholder="Describe the issue in detail..."
        rows="3"
        @value={{this.formDescription}}
        @onInput={{fn this.setFieldValue "formDescription"}}
        required={{true}}
      />
    </Nuvo::Field>

    <div class="flex gap-4">
      <div class="grow">
        <Nuvo::Field @label="Priority">
          <Nuvo::Dropdown
            id="wo-priority"
            @align="start"
            @value={{this.formPriority}}
            @onSelect={{fn this.setFieldValue "formPriority"}}
            @options={{this.priorityOptions}}
            @placeholder="Select priority..."
          />
        </Nuvo::Field>
      </div>
      <div class="grow">
        <Nuvo::Field @label="Category">
          <Nuvo::Dropdown
            id="wo-category"
            @align="start"
            @value={{this.formCategory}}
            @onSelect={{fn this.setFieldValue "formCategory"}}
            @options={{this.categoryOptions}}
            @placeholder="Select category..."
          />
        </Nuvo::Field>
      </div>
    </div>

    {{#if this.editWorkOrder}}
      <Nuvo::Field @label="Status">
        <Nuvo::Dropdown
          id="wo-status"
          @align="start"
          @value={{this.formStatus}}
          @onSelect={{fn this.setFieldValue "formStatus"}}
          @options={{this.workOrderStatusOptions}}
          @placeholder="Select status..."
        />
      </Nuvo::Field>
    {{/if}}

    {{#if this.editWorkOrder}}
      <Nuvo::Field @label="Estimated Cost">
        <Nuvo::Input
          id="wo-est-cost"
          type="number"
          placeholder="e.g. 500"
          @value={{this.formEstimatedCost}}
          @onInput={{fn this.setFieldValue "formEstimatedCost"}}
          min="0"
          step="0.01"
        />
      </Nuvo::Field>
    {{else}}
      <div class="flex gap-4">
        <div class="grow">
          <Nuvo::Field @label="Reported By">
            <Nuvo::Input
              id="wo-reported-by"
              type="text"
              placeholder="Tenant or staff name"
              @value={{this.formReportedBy}}
              @onInput={{fn this.setFieldValue "formReportedBy"}}
            />
          </Nuvo::Field>
        </div>
        <div class="grow">
          <Nuvo::Field @label="Estimated Cost">
            <Nuvo::Input
              id="wo-est-cost"
              type="number"
              placeholder="e.g. 500"
              @value={{this.formEstimatedCost}}
              @onInput={{fn this.setFieldValue "formEstimatedCost"}}
              min="0"
              step="0.01"
            />
          </Nuvo::Field>
        </div>
      </div>
    {{/if}}

    <div class="flex gap-4">
      <div class="grow">
        <Nuvo::Field @label="Actual Cost">
          <Nuvo::Input
            id="wo-act-cost"
            type="number"
            placeholder="e.g. 450"
            @value={{this.formActualCost}}
            @onInput={{fn this.setFieldValue "formActualCost"}}
            min="0"
            step="0.01"
          />
        </Nuvo::Field>
      </div>
      <div class="grow">
        <Nuvo::Field @label="Cost Notes">
          <Nuvo::Input
            id="wo-cost-notes"
            type="text"
            placeholder="e.g. Parts + labor"
            @value={{this.formCostNotes}}
            @onInput={{fn this.setFieldValue "formCostNotes"}}
          />
        </Nuvo::Field>
      </div>
    </div>

    <div class="flex gap-4">
      <div class="grow">
        <Nuvo::Field @label="Scheduled Date">
          <Nuvo::Input
            id="wo-scheduled"
            type="date"
            @value={{this.formScheduledDate}}
            @onInput={{fn this.setFieldValue "formScheduledDate"}}
          />
        </Nuvo::Field>
      </div>
      <div class="grow">
        <Nuvo::Field @label="Vendor">
          <Nuvo::Dropdown
            id="wo-vendor"
            @align="start"
            @value={{this.formVendorId}}
            @onSelect={{fn this.setFieldValue "formVendorId"}}
            @options={{this.vendorOptions}}
            @placeholder="No vendor assigned"
          />
        </Nuvo::Field>
      </div>
    </div>

    {{#if this.errorMsg}}
      <p class="text-sm text-danger" data-test-error>{{this.errorMsg}}</p>
    {{/if}}

    <Nuvo::FormActions @align="end">
      <Nuvo::Button @variant="secondary" {{on "click" this.closeModal}}>
        Cancel
      </Nuvo::Button>
      <Nuvo::Button
        @variant="primary"
        @type="submit"
        @loading={{this.isSaving}}
        data-test-save-work-order
      >
        {{if this.editWorkOrder "Update" "Create Work Order"}}
      </Nuvo::Button>
    </Nuvo::FormActions>
  </form>
</Nuvo::Modal>
