{{page-title "Overview"}}

<Nuvo::PageHeader @title="Overview" @subtitle="The business at a glance." />

<Nuvo::Card class="console-hero" data-test-overview-hero>
  {{#if this.hasRevenue}}
    <div class="console-hero__figures">
      <div class="console-hero__figure">
        <p class="kpi-label">MRR</p>
        <h2 class="console-hero__value" data-test-overview-mrr>
          {{format-money this.dominant.mrrMinor this.dominant.currency}}
          <span class="console-hero__unit">/mo</span>
        </h2>
      </div>
      <div class="console-hero__figure">
        <p class="kpi-label">ARR</p>
        <h2 class="console-hero__value" data-test-overview-arr>
          {{format-money this.dominantArrMinor this.dominant.currency}}
          <span class="console-hero__unit">/yr</span>
        </h2>
      </div>
    </div>
    {{#if this.showCurrencyChips}}
      <div class="console-hero__chips">
        {{#each this.mrrCurrencies as |band|}}
          <span
            class="console-chip"
            data-test-overview-currency-chip={{band.currency}}
          >
            <strong class="console-chip__code">{{band.currency}}</strong>
            {{format-money band.mrrMinor band.currency}}
          </span>
        {{/each}}
      </div>
    {{/if}}
  {{else}}
    <div class="console-hero__empty">
      <p class="console-hero__label">MRR</p>
      <h2 class="console-hero__value">No revenue yet</h2>
      <p class="text-sm text-muted mt-1">Close the first deal to light this up.</p>
    </div>
  {{/if}}
</Nuvo::Card>

<div class="console-tiles mt-6">
  {{#each this.tiles as |tile|}}
    <Nuvo::Stat
      @label={{tile.label}}
      @value={{tile.value}}
      data-test-overview-tile={{tile.key}}
    >
      <:icon><Ui::Ph @icon={{tile.icon}} @size="22px" /></:icon>
    </Nuvo::Stat>
  {{/each}}
</div>

<div class="console-rollups mt-6">
  <Nuvo::Card data-test-overview-regions>
    <h3 class="text-lg font-bold mb-4">By region</h3>
    {{#if this.regions.length}}
      <div class="flex col gap-3">
        {{#each this.regions as |region|}}
          <div class="console-region-row">
            <span class="console-region-row__name">{{region.label}}</span>
            <span class="console-region-bar">
              <span
                class="console-region-bar__fill"
                style={{region.barStyle}}
              ></span>
            </span>
            <span class="console-region-row__count">{{region.customers}}</span>
          </div>
        {{/each}}
      </div>
    {{else}}
      <p class="text-muted">No companies yet.</p>
    {{/if}}
  </Nuvo::Card>

  <Nuvo::Card data-test-overview-upcoming-payments>
    <h3 class="text-lg font-bold mb-4">Upcoming manual payments</h3>
    {{#if this.upcomingRows.length}}
      <Nuvo::DataTable
        @columns={{this.upcomingColumns}}
        @rows={{this.upcomingRows}}
        @pinColumns={{true}}
        @reorderable={{true}}
        @sortable={{true}}
        @showOptions={{true}}
        @tableId="admin-overview-upcoming"
        as |cell|
      >
        {{#if (eq cell.key "companyName")}}
          <span data-test-overview-upcoming-row>{{cell.value}}</span>
        {{else if (eq cell.key "amount")}}
          <span class="font-bold">{{format-money
              cell.value
              cell.row.currency
            }}</span>
        {{else if (eq cell.key "coversEnd")}}
          {{#if cell.row.overdue}}
            <Nuvo::Tag class="tag-txn-failed" @text="Overdue" />
          {{else}}
            {{format-date cell.value}}
          {{/if}}
        {{else if (eq cell.key "companyId")}}
          <LinkTo
            @route="admin.companies.company"
            @model={{cell.value}}
            class="link"
          >Open</LinkTo>
        {{else}}
          {{cell.value}}
        {{/if}}
      </Nuvo::DataTable>
    {{else}}
      <p class="text-muted">No manual payments due in the next
        {{this.upcomingDays}}
        days.</p>
    {{/if}}
  </Nuvo::Card>
</div>