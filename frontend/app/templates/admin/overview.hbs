{{page-title "Overview"}}

<div data-test-admin-overview-page class="flex col gap-6">
  <Woven::PageHeader @title="Overview" @subtitle="The business at a glance." />

  <Woven::Card data-test-overview-hero>
    <div class="flex wrap x-center between gap-6">
      {{#if this.hasRevenue}}
        <div class="flex gap-8">
          <div class="console-hero__figure">
            <p class="console-hero__label">MRR</p>
            <h2 class="console-hero__value" data-test-overview-mrr>
              {{format-money
                this.dominant.mrrMinor
                currency=this.dominant.currency
                minor=true
              }}
              <span class="console-hero__unit">/mo</span>
            </h2>
          </div>
          <div class="console-hero__figure">
            <p class="console-hero__label">ARR</p>
            <h2 class="console-hero__value" data-test-overview-arr>
              {{format-money
                this.dominantArrMinor
                currency=this.dominant.currency
                minor=true
              }}
              <span class="console-hero__unit">/yr</span>
            </h2>
          </div>
        </div>
        {{#if this.showCurrencyChips}}
          <div class="flex wrap gap-2">
            {{#each this.mrrCurrencies as |band|}}
              <span
                class="wu-tag"
                data-test-overview-currency-chip={{band.currency}}
              >
                <strong class="uppercase">{{band.currency}}</strong>
                {{format-money band.mrrMinor currency=band.currency minor=true}}
              </span>
            {{/each}}
          </div>
        {{/if}}
      {{else}}
        <div class="console-hero__empty">
          <p class="console-hero__label">MRR</p>
          <h2 class="console-hero__value">No revenue yet</h2>
          <p class="text-sm text-muted mt-1">Close the first deal to light this
            up.</p>
        </div>
      {{/if}}
    </div>
  </Woven::Card>

  <div class="console-tiles">
    {{#each this.tiles as |tile|}}
      <StatCard
        @label={{tile.label}}
        @value={{tile.value}}
        data-test-overview-tile={{tile.key}}
      >
        <:icon><Ui::Ph @icon={{tile.icon}} @size="22px" /></:icon>
      </StatCard>
    {{/each}}
  </div>

  <div class="console-rollups">
    <Woven::Card data-test-overview-regions>
      <h3 class="text-lg font-bold mb-4">By region</h3>
      {{#if this.regions.length}}
        <div class="flex col gap-3">
          {{#each this.regions as |region|}}
            <div class="flex x-center gap-3">
              <span class="console-region-row__name">{{region.label}}</span>
              <progress
                class="wu-progress grow"
                value={{region.customers}}
                max={{region.max}}
                aria-label="{{region.label}} customers"
              ></progress>
              <span
                class="console-region-row__count"
              >{{region.customers}}</span>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="text-muted">No companies yet.</p>
      {{/if}}
    </Woven::Card>

    <Woven::Card data-test-overview-upcoming-payments>
      <h3 class="text-lg font-bold mb-4">Upcoming manual payments</h3>
      {{#if this.upcomingRows.length}}
        <Woven::DataTable
          @columns={{this.upcomingColumns}}
          @rows={{this.upcomingRows}}
          @pinColumns={{true}}
          @reorderable={{true}}
          @sortable={{true}}
          @showOptions={{true}}
          @tableId="admin-overview-upcoming"
          as |cell|
        >
          {{#if (eq cell.key "companyName")}}
            <span data-test-overview-upcoming-row>{{cell.value}}</span>
          {{else if (eq cell.key "amount")}}
            <span>{{format-money
                cell.value
                currency=cell.row.currency
                minor=true
              }}</span>
          {{else if (eq cell.key "coversEnd")}}
            {{#if cell.row.overdue}}
              <Woven::Tag @variant="danger" @text="Overdue" />
            {{else}}
              {{format-date cell.value}}
            {{/if}}
          {{else if (eq cell.key "companyId")}}
            <RowActions
              @label={{cell.row.companyName}}
              @actions={{array
                (hash
                  key="overview-open-company"
                  testValue=cell.value
                  label="Open"
                  icon="caret-right"
                  route="admin.companies.company"
                  models=(array cell.value)
                )
              }}
            />
          {{else}}
            {{cell.value}}
          {{/if}}
        </Woven::DataTable>
      {{else}}
        <p class="text-muted">No manual payments due in the next
          {{this.upcomingDays}}
          days.</p>
      {{/if}}
    </Woven::Card>
  </div>
</div>