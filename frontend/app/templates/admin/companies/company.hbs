{{page-title (if this.company this.company.name "Company")}}

{{#if this.company}}
  <div class="console-detail-header">
    <button
      type="button"
      class="btn btn-secondary btn-back"
      data-test-company-back
      {{on "click" this.goBack}}
    >
      <Ui::Ph @icon="caret-left" @size="16px" />
      Companies
    </button>
    <div class="console-detail-header__title">
      <h1 class="page-title">{{this.company.name}}</h1>
      <span class="plan-badge plan-badge--{{lowercase this.company.tier}}">
        {{this.company.tier}}
      </span>
      {{#if this.railLabel}}
        <span class="console-rail-tag">{{this.railLabel}}</span>
      {{/if}}
      <span class="status-badge {{this.statusView.cls}}">
        {{this.statusView.text}}
      </span>
    </div>
    <div class="console-detail-header__actions">
      {{#if this.adminUser}}
        <button
          type="button"
          class="btn btn-secondary"
          data-test-company-login-as
          {{on "click" this.loginAs}}
        >
          <Ui::Ph @icon="sign-in" @size="16px" />
          Login as admin
        </button>
      {{/if}}
    </div>
  </div>

  {{#if this.showLockCard}}
    {{#if this.isLocked}}
      <div class="alert alert-error console-lock-card" data-test-lock-card>
        <div class="flex col gap-3 w-full">
          <div>
            <div class="font-bold">Locked{{#if this.lock.dealExpiredAt}}, deal
                expired
                {{format-date this.lock.dealExpiredAt}}{{/if}}.</div>
            <p class="text-sm mt-1">Writes are blocked; reads and export stay.
              Their admin sees the "reduce or pay" banner.</p>
          </div>
          <div class="console-lock-actions">
            <span class="text-sm">To unlock permanently:</span>
            <button
              type="button"
              class="btn btn-secondary btn-xs"
              {{on "click" this.openDealModal}}
            >Give a new deal</button>
            <button
              type="button"
              class="btn btn-secondary btn-xs"
              {{on "click" this.openPaymentModal}}
            >Record a payment</button>
          </div>
          <div class="console-lock-actions">
            <span class="text-sm">To let them breathe:</span>
            <input
              type="date"
              aria-label="Lift lock until"
              class="form-input console-lift-date"
              value={{this.liftDate}}
              data-test-lock-lift-date
              {{on "change" this.setLiftDate}}
            />
            <button
              type="button"
              class="btn btn-secondary btn-xs"
              disabled={{this.liftBusy}}
              data-test-lock-lift-submit
              {{on "click" this.submitLift}}
            >{{if this.liftBusy "Lifting…" "Lift"}}</button>
          </div>
        </div>
      </div>
    {{else}}
      <div class="alert alert-warning console-lock-card" data-test-lock-card>
        <div class="flex col gap-3 w-full">
          <div>
            <div class="font-bold">Lock lifted until
              {{format-date this.lock.liftUntil}}.</div>
            <p class="text-sm mt-1">Re-locks automatically then, unless a deal
              or payment lands.</p>
          </div>
          <div class="console-lock-actions">
            <input
              type="date"
              aria-label="Lift lock until"
              class="form-input console-lift-date"
              value={{this.liftDate}}
              data-test-lock-lift-date
              {{on "change" this.setLiftDate}}
            />
            <button
              type="button"
              class="btn btn-secondary btn-xs"
              disabled={{this.liftBusy}}
              data-test-lock-lift-submit
              {{on "click" this.submitLift}}
            >{{if this.liftBusy "Extending…" "Extend lift"}}</button>
            <button
              type="button"
              class="btn btn-danger btn-xs"
              data-test-lock-end-lift
              {{on "click" this.openEndLiftConfirm}}
            >End lift now</button>
          </div>
        </div>
      </div>
    {{/if}}
  {{/if}}

  <Nuvo::Tabs
    @tabs={{this.tabs}}
    @activeTab={{this.activeTab}}
    @onChange={{this.selectTab}}
    class="mt-4 mb-4"
  />

  {{#if (eq this.activeTab "overview")}}
    <div class="console-cards">
      <Nuvo::Panel @title="Billing state" data-test-company-plan-card>
        {{#if this.billing}}
          <dl class="console-kv">
            <dt>Tier</dt>
            <dd>{{this.billing.tier}}</dd>
            {{#if this.billing.billingStatus}}
              <dt>Status</dt>
              <dd><span
                  class="status-badge status-{{lowercase
                      this.billing.billingStatus
                    }}"
                >{{this.billing.billingStatus}}</span></dd>
            {{/if}}
            <dt>Seats</dt>
            <dd>{{this.billing.activeUsers}}
              active /
              {{this.billing.purchasedSeats}}
              purchased</dd>
            <dt>Currency</dt>
            <dd>{{this.billing.currency}}</dd>
            {{#if this.billing.cancelAtPeriodEnd}}
              <dt>Scheduled</dt>
              <dd class="text-warning">Cancels
                {{format-date this.billing.cancelAt}}</dd>
            {{/if}}
          </dl>
        {{else}}
          <p class="text-muted" data-test-company-billing-unavailable>Billing
            state is unavailable right now.</p>
        {{/if}}
      </Nuvo::Panel>

      {{#if this.deal}}
        <Nuvo::Panel @title="Active deal" data-test-company-deal-card>
          <dl class="console-kv">
            <dt>Price</dt>
            <dd>{{this.dealPriceLabel}}</dd>
            <dt>Seats included</dt>
            <dd>{{this.deal.seatCap}}</dd>
            <dt>Until</dt>
            <dd>{{if
                this.deal.lifetime
                "Lifetime"
                (format-date this.deal.untilDate)
              }}</dd>
            <dt>Why</dt>
            <dd>{{this.deal.whyNote}}</dd>
            <dt>Granted by</dt>
            <dd>{{this.deal.grantedBy}}</dd>
          </dl>
        </Nuvo::Panel>
      {{/if}}

      <Nuvo::Panel>
        <:header>
          <h3 class="nu-panel__title">Limits</h3>
          <button
            type="button"
            class="btn btn-secondary btn-xs"
            data-test-company-limits-edit
            {{on "click" this.openLimitsModal}}
          >Edit</button>
        </:header>
        <:body>
          <dl class="console-kv">
            <dt>Max users</dt>
            <dd>{{this.company.limits.maxUsers}}</dd>
            <dt>Max regions</dt>
            <dd>{{this.company.limits.maxRegions}}</dd>
            <dt>Max properties</dt>
            <dd>{{this.company.limits.maxProperties}}</dd>
          </dl>
        </:body>
      </Nuvo::Panel>
    </div>

  {{else if (eq this.activeTab "deal")}}
    {{#if this.deal}}
      <Nuvo::Panel @title="Active deal" data-test-company-deal-card>
        <dl class="console-kv">
          <dt>Price</dt>
          <dd>{{this.dealPriceLabel}}</dd>
          <dt>Seats included</dt>
          <dd>{{this.deal.seatCap}}</dd>
          <dt>Until</dt>
          <dd>{{if
              this.deal.lifetime
              "Lifetime"
              (format-date this.deal.untilDate)
            }}</dd>
          <dt>Why</dt>
          <dd>{{this.deal.whyNote}}</dd>
          <dt>Granted by</dt>
          <dd>{{this.deal.grantedBy}}
            on
            {{format-date this.deal.grantedAt}}</dd>
          {{#if this.deal.updatedBy}}
            <dt>Last edited</dt>
            <dd>{{this.deal.updatedBy}}
              on
              {{format-date this.deal.updatedAt}}</dd>
          {{/if}}
        </dl>
        <div class="flex gap-3 mt-4">
          <button
            type="button"
            class="btn btn-secondary"
            data-test-deal-edit
            {{on "click" this.openDealModal}}
          >Edit</button>
          <button
            type="button"
            class="btn btn-danger"
            data-test-deal-end
            {{on "click" this.openEndDealConfirm}}
          >End deal early</button>
        </div>
      </Nuvo::Panel>
    {{else}}
      <Nuvo::Panel class="console-empty">
        <Ui::Ph @icon="handshake" @size="40px" />
        <p class="text-muted mt-2">No deal on this company yet.</p>
        <button
          type="button"
          class="btn btn-primary mt-3"
          data-test-deal-give
          {{on "click" this.openDealModal}}
        >Give a deal</button>
      </Nuvo::Panel>
    {{/if}}

  {{else if (eq this.activeTab "payments")}}
    <Nuvo::Panel>
      <:header>
        <h3 class="nu-panel__title">Payments</h3>
        <button
          type="button"
          class="btn btn-primary"
          data-test-payment-record
          {{on "click" this.openPaymentModal}}
        >Record a payment</button>
      </:header>
      <:body>
      {{#if this.paymentsLoading}}
        <p class="text-muted">Loading payments…</p>
      {{else if this.paymentRows}}
        <DataTable
          @columns={{this.paymentColumns}}
          @rows={{this.paymentRows}}
          @pinColumns={{true}}
          @reorderable={{true}}
          @sortable={{true}}
          @showOptions={{true}}
          @tableId="console-company-payments"
          data-test-company-payments-table
          as |cell|
        >
          {{#if (eq cell.key "date")}}
            {{format-date cell.value}}
          {{else if (eq cell.key "amount")}}
            <span class="font-bold">{{format-money
                cell.value
                cell.row.currency
              }}</span>
          {{else if (eq cell.key "notes")}}
            <span class="console-notes-cell">{{if cell.value cell.value "-"}}</span>
          {{else if (eq cell.key "hasReceipt")}}
            {{#if cell.value}}
              <button
                type="button"
                class="btn-link"
                {{on "click" (fn this.viewReceipt cell.row.id)}}
              >View</button>
            {{else if cell.row.invoiceUrl}}
              <a
                href={{cell.row.invoiceUrl}}
                target="_blank"
                rel="noopener noreferrer"
                class="link"
              >Invoice</a>
            {{else}}
              <span class="text-muted">-</span>
            {{/if}}
          {{else if (eq cell.key "id")}}
            {{#if cell.row.paid}}
              <button
                type="button"
                class="btn btn-secondary btn-xs"
                data-test-company-make-right={{cell.row.id}}
                {{on "click" (fn this.openRemedy cell.row)}}
              >Make it right</button>
            {{/if}}
          {{else}}
            {{cell.value}}
          {{/if}}
        </DataTable>
      {{else}}
        <p class="text-muted">No payments recorded yet.</p>
      {{/if}}
      </:body>
    </Nuvo::Panel>

  {{else if (eq this.activeTab "history")}}
    <Nuvo::Panel @title="History">
      {{#if this.historyLoading}}
        <p class="text-muted">Loading history…</p>
      {{else if this.historyRows}}
        <DataTable
          @columns={{this.historyColumns}}
          @rows={{this.historyRows}}
          @pinColumns={{true}}
          @reorderable={{true}}
          @sortable={{true}}
          @showOptions={{true}}
          @tableId="console-company-history"
          data-test-company-history-table
          as |cell|
        >
          {{#if (eq cell.key "when")}}
            {{format-date-time cell.value}}
          {{else}}
            {{cell.value}}
          {{/if}}
        </DataTable>
      {{else}}
        <p class="text-muted">No operator events for this company yet.</p>
      {{/if}}
    </Nuvo::Panel>
  {{/if}}

  <Nuvo::Drawer
    @open={{this.dealModalOpen}}
    @title="{{if this.dealEditing 'Edit' 'Give'}} {{this.company.name}} a deal"
    @placement="end"
    @size="lg"
    @onClose={{this.closeDealModal}}
  >
    <:body>
      <div class="flex col gap-4" data-test-deal-form>
        <div class="nu-field-row">
          <Nuvo::Field
            @label="Price"
            @tooltip="Enter the amount that matches the Basis below, either per seat each month or one flat total each month."
            @flush={{true}}
            class="nu-field-row__wide"
          >
            <Nuvo::Input
              id="deal-price"
              type="number"
              min="0"
              step="0.01"
              @value={{this.dealPrice}}
              data-test-deal-price
              {{on "input" (fn this.setDealField "dealPrice")}}
            />
          </Nuvo::Field>
          <Nuvo::Field
            @label="Currency"
            @tooltip="Three letter code such as AED or USD. This is what the company is billed in from now on."
            @flush={{true}}
            class="nu-field-row__narrow"
          >
            <Nuvo::Input
              id="deal-currency"
              type="text"
              maxlength="3"
              class="console-currency-input"
              @value={{this.dealCurrency}}
              data-test-deal-currency
              {{on "input" (fn this.setDealField "dealCurrency")}}
            />
          </Nuvo::Field>
          <Nuvo::Field
            @label="Basis"
            @tooltip="Per seat charges the price for every active user each month. Flat charges the price once each month, whatever the seat count."
            @flush={{true}}
            class="nu-field-row__wide"
          >
            <Nuvo::Dropdown
              id="deal-basis"
              data-test-deal-basis
              @align="start"
              @options={{this.basisOptions}}
              @value={{this.dealBasis}}
              @onSelect={{this.setDealBasis}}
            />
          </Nuvo::Field>
        </div>

        <Nuvo::Field
          @label="Seats included"
          @tooltip="How many active users this price covers. Extra users above this are billed at the normal per seat rate."
          @flush={{true}}
        >
          <Nuvo::Input
            id="deal-seats"
            type="number"
            min="1"
            step="1"
            @value={{this.dealSeatCap}}
            data-test-deal-seats
            {{on "input" (fn this.setDealField "dealSeatCap")}}
          />
        </Nuvo::Field>

        <div class="nu-field-row m-end">
          <Nuvo::Field
            @label="Until"
            @tooltip="The last day this price applies. After it, the company goes back to standard plan pricing."
            @flush={{true}}
            class="nu-field-row__wide"
          >
            <Nuvo::Input
              id="deal-until"
              type="date"
              @value={{this.dealUntil}}
              disabled={{this.dealLifetime}}
              data-test-deal-until
              {{on "input" (fn this.setDealField "dealUntil")}}
            />
          </Nuvo::Field>
          <label class="console-checkbox grow">
            <input
              type="checkbox"
              checked={{this.dealLifetime}}
              data-test-deal-lifetime
              {{on "change" this.toggleDealLifetime}}
            />
            Lifetime
          </label>
        </div>

        <Nuvo::Field @label="Why" @required={{true}} @flush={{true}}>
          <Nuvo::Textarea
            id="deal-why"
            rows="2"
            required={{true}}
            data-test-deal-why
            @value={{this.dealWhy}}
            {{on "input" (fn this.setDealField "dealWhy")}}
          />
        </Nuvo::Field>

        <div class="alert alert-warning" data-test-deal-expiry-preview>
          <div>
            <div class="font-bold">What happens on expiry</div>
            <p class="text-sm mt-1">{{this.expiryPreview}}</p>
          </div>
        </div>
      </div>
    </:body>
    <:footer>
      <button
        type="button"
        class="btn btn-secondary"
        {{on "click" this.closeDealModal}}
      >Cancel</button>
      <button
        type="button"
        class="btn btn-primary"
        disabled={{this.dealBusy}}
        data-test-deal-submit
        {{on "click" this.submitDeal}}
      >{{if
          this.dealBusy
          "Saving…"
          (if this.dealEditing "Save deal" "Give deal")
        }}</button>
    </:footer>
  </Nuvo::Drawer>

  <Nuvo::Drawer
    @open={{this.paymentModalOpen}}
    @title="Record a payment from {{this.company.name}}"
    @placement="end"
    @size="lg"
    @onClose={{this.closePaymentModal}}
  >
    <:body>
      <div class="flex col gap-4" data-test-payment-form>
        <div class="nu-field-row">
          <Nuvo::Field @label="Amount" @flush={{true}} class="nu-field-row__wide">
            <Nuvo::Input
              id="pay-amount"
              type="number"
              min="0"
              step="0.01"
              @value={{this.payAmount}}
              data-test-payment-amount
              {{on "input" (fn this.setPayField "payAmount")}}
            />
          </Nuvo::Field>
          <Nuvo::Field
            @label="Currency"
            @tooltip="Three letter code such as AED or USD. It must match the currency the money actually arrived in."
            @flush={{true}}
            class="nu-field-row__narrow"
          >
            <Nuvo::Input
              id="pay-currency"
              type="text"
              maxlength="3"
              class="console-currency-input"
              @value={{this.payCurrency}}
              data-test-payment-currency
              {{on "input" (fn this.setPayField "payCurrency")}}
            />
          </Nuvo::Field>
        </div>

        <div class="nu-field-row">
          <Nuvo::Field @label="Date received" @flush={{true}} class="grow">
            <Nuvo::Input
              id="pay-received"
              type="date"
              @value={{this.payReceivedAt}}
              data-test-payment-date
              {{on "input" (fn this.setPayField "payReceivedAt")}}
            />
          </Nuvo::Field>
          <Nuvo::Field
            @label="Covers from"
            @tooltip="First day of the period this payment pays for. Paid access runs from here."
            @flush={{true}}
            class="grow"
          >
            <Nuvo::Input
              id="pay-covers-start"
              type="date"
              @value={{this.payCoversStart}}
              data-test-payment-covers
              {{on "input" (fn this.setPayField "payCoversStart")}}
            />
          </Nuvo::Field>
          <Nuvo::Field
            @label="Covers to"
            @tooltip="Last day of the period this payment pays for. Access lapses after this date unless it is renewed."
            @flush={{true}}
            class="grow"
          >
            <Nuvo::Input
              id="pay-covers-end"
              type="date"
              @value={{this.payCoversEnd}}
              data-test-payment-covers-end
              {{on "input" (fn this.setPayField "payCoversEnd")}}
            />
          </Nuvo::Field>
        </div>

        <Nuvo::Field @label="Notes" @flush={{true}}>
          <Nuvo::Textarea
            id="pay-notes"
            rows="2"
            placeholder="JazzCash transfer, txn 8842"
            data-test-payment-notes
            @value={{this.payNotes}}
            {{on "input" (fn this.setPayField "payNotes")}}
          />
        </Nuvo::Field>

        <Nuvo::Field @label="Receipt image" @flush={{true}}>
          <input
            id="pay-receipt"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            class="nu-input"
            data-test-payment-receipt
            {{on "change" this.setPayReceipt}}
          />
          {{#if this.payReceiptName}}
            <span class="text-sm text-muted">{{this.payReceiptName}}</span>
          {{/if}}
        </Nuvo::Field>
        <p class="text-sm text-muted">Document it: notes or a receipt image is
          required.</p>
      </div>
    </:body>
    <:footer>
      <button
        type="button"
        class="btn btn-secondary"
        {{on "click" this.closePaymentModal}}
      >Cancel</button>
      <button
        type="button"
        class="btn btn-primary"
        disabled={{this.payBusy}}
        data-test-payment-submit
        {{on "click" this.submitPayment}}
      >{{if this.payBusy "Recording…" "Record"}}</button>
    </:footer>
  </Nuvo::Drawer>

  <Nuvo::Drawer
    @open={{this.remedyModalOpen}}
    @title="Make it right for {{this.company.name}}"
    @placement="end"
    @size="lg"
    @onClose={{this.closeRemedy}}
  >
    <:body>
      <div class="flex col gap-4" data-test-remedy-form>
        <div class="console-anchor">Payment: {{this.remedyAnchorLabel}}</div>

        <div class="flex col gap-2">
          <label class="console-radio">
            <input
              type="radio"
              name="remedy-kind"
              checked={{eq this.remedyKind "discount_next_bill"}}
              data-test-remedy-discount
              {{on "change" (fn this.setRemedyKind "discount_next_bill")}}
            />
            Discount the next bill
          </label>
          <label class="console-radio">
            <input
              type="radio"
              name="remedy-kind"
              checked={{eq this.remedyKind "refund"}}
              data-test-remedy-refund
              {{on "change" (fn this.setRemedyKind "refund")}}
            />
            Refund this payment
          </label>
        </div>

        {{#if this.remedyIsRefund}}
          <div class="flex gap-4">
            <label class="console-radio">
              <input
                type="radio"
                name="remedy-scope"
                checked={{eq this.remedyScope "partial"}}
                data-test-remedy-scope-partial
                {{on "change" (fn this.setRemedyScope "partial")}}
              />
              Partial
            </label>
            <label class="console-radio">
              <input
                type="radio"
                name="remedy-scope"
                checked={{eq this.remedyScope "full"}}
                data-test-remedy-scope-full
                {{on "change" (fn this.setRemedyScope "full")}}
              />
              Full
            </label>
          </div>
        {{/if}}

        {{#if this.showRemedyAmount}}
          <Nuvo::Field @label="Amount" @flush={{true}}>
            <Nuvo::Input
              id="remedy-amount"
              type="number"
              min="0"
              step="0.01"
              @value={{this.remedyAmount}}
              data-test-remedy-amount
              data-test-remedy-partial-amount={{if this.remedyIsRefund true}}
              {{on "input" (fn this.setRemedyField "remedyAmount")}}
            />
          </Nuvo::Field>
        {{/if}}

        <Nuvo::Field @label="Why" @required={{true}} @flush={{true}}>
          <Nuvo::Textarea
            id="remedy-why"
            rows="2"
            required={{true}}
            data-test-remedy-why
            @value={{this.remedyWhy}}
            {{on "input" (fn this.setRemedyField "remedyWhy")}}
          />
        </Nuvo::Field>

        {{#if this.remedyIsRefund}}
          <div class="alert alert-warning" data-test-remedy-sla-alert>
            <div>
              <p class="text-sm">Refunds are initiated within 24 to 48 hours.
                Money leaves the account. This is not undoable.</p>
            </div>
          </div>
        {{/if}}
      </div>
    </:body>
    <:footer>
      <button
        type="button"
        class="btn btn-secondary"
        {{on "click" this.closeRemedy}}
      >Cancel</button>
      <button
        type="button"
        class="btn {{if this.remedyIsRefund 'btn-danger' 'btn-primary'}}"
        disabled={{this.remedyBusy}}
        data-test-remedy-submit
        {{on "click" this.submitRemedy}}
      >{{if this.remedyBusy "Working…" this.remedyConfirmLabel}}</button>
    </:footer>
  </Nuvo::Drawer>

  <Nuvo::Drawer
    @open={{this.limitsModalOpen}}
    @title="Edit limits"
    @placement="end"
    @size="lg"
    @onClose={{this.closeLimitsModal}}
  >
    <:body>
      <div class="flex col gap-4">
        <Nuvo::Field
          @label="Max users"
          @tooltip="A hard cap on active team members for this company. It overrides the seat limit that comes with their plan."
          @flush={{true}}
        >
          <Nuvo::Input
            id="limit-users"
            type="number"
            min="1"
            step="1"
            @value={{this.limitMaxUsers}}
            {{on "input" (fn this.setLimitField "limitMaxUsers")}}
          />
        </Nuvo::Field>
        <Nuvo::Field
          @label="Max regions"
          @tooltip="A hard cap on how many regions this company can switch on. It overrides the region limit from their plan."
          @flush={{true}}
        >
          <Nuvo::Input
            id="limit-regions"
            type="number"
            min="1"
            step="1"
            @value={{this.limitMaxRegions}}
            {{on "input" (fn this.setLimitField "limitMaxRegions")}}
          />
        </Nuvo::Field>
        <Nuvo::Field
          @label="Max properties"
          @tooltip="A hard cap on how many properties this company can create. It overrides the limit from their plan."
          @flush={{true}}
        >
          <Nuvo::Input
            id="limit-properties"
            type="number"
            min="1"
            step="1"
            @value={{this.limitMaxProperties}}
            {{on "input" (fn this.setLimitField "limitMaxProperties")}}
          />
        </Nuvo::Field>
      </div>
    </:body>
    <:footer>
      <button
        type="button"
        class="btn btn-secondary"
        {{on "click" this.closeLimitsModal}}
      >Cancel</button>
      <button
        type="button"
        class="btn btn-primary"
        disabled={{this.limitsBusy}}
        {{on "click" this.submitLimits}}
      >{{if this.limitsBusy "Saving…" "Save"}}</button>
    </:footer>
  </Nuvo::Drawer>

  <ConfirmModal
    @open={{this.endDealConfirmOpen}}
    @title="End this deal early?"
    @message="{{this.company.name}} returns to standard pricing at the next cycle. This does not lock the account."
    @confirmText="End deal early"
    @confirmingText="Ending…"
    @cancelText="I changed my mind"
    @confirmVariant="danger"
    @isConfirming={{this.endDealBusy}}
    @onConfirm={{this.confirmEndDeal}}
    @onClose={{this.closeEndDealConfirm}}
  />

  <ConfirmModal
    @open={{this.endLiftConfirmOpen}}
    @title="End the lift now?"
    @message="The write lock re-applies immediately. Their admin sees the 'reduce or pay' banner again."
    @confirmText="End lift now"
    @confirmingText="Ending…"
    @cancelText="I changed my mind"
    @confirmVariant="danger"
    @isConfirming={{this.endLiftBusy}}
    @onConfirm={{this.confirmEndLift}}
    @onClose={{this.closeEndLiftConfirm}}
  />

{{else}}
  <Nuvo::Panel class="console-empty">
    <p class="text-muted">This company could not be loaded.</p>
    <button
      type="button"
      class="btn btn-secondary mt-3"
      {{on "click" this.goBack}}
    >Back to Companies</button>
  </Nuvo::Panel>
{{/if}}