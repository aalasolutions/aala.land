{{page-title (if this.company this.company.name "Company")}}

{{#if this.company}}
  <Woven::PageHeader @title={{this.company.name}} class="mb-6">
    <:breadcrumb>
      <Woven::Breadcrumb
        @items={{array (hash label="Companies" route="admin.companies.index")}}
        @compact={{true}}
        @parentsOnly={{true}}
        data-test-breadcrumb-companies
      />
    </:breadcrumb>
    <:meta>
      <Woven::Tag
        @variant={{tag-variant "plan" this.company.tier}}
        @text={{this.company.tier}}
        data-test-company-tier
      />
      {{#if this.railLabel}}
        <Woven::Tag @text={{this.railLabel}} data-test-company-rail />
      {{/if}}
      <Woven::Tag
        @variant={{this.statusView.variant}}
        @text={{this.statusView.text}}
        data-test-company-status
      />
    </:meta>
    <:actions>
      {{#if this.adminUser}}
        <Woven::Button
          @variant="subtle"
          @icon="sign-in"
          data-test-company-login-as
          {{on "click" this.loginAs}}
        >
          Login as admin
        </Woven::Button>
      {{/if}}
    </:actions>
  </Woven::PageHeader>

  {{#if this.showLockCard}}
    {{#if this.isLocked}}
      <Woven::Alert @variant="danger" role="status" data-test-lock-card>
        <strong class="wu-alert-title">Locked{{#if this.lock.dealExpiredAt}},
            deal expired
            {{format-date this.lock.dealExpiredAt}}{{/if}}.</strong>
        <p>Writes are blocked; reads and export stay. Their admin sees the
          "reduce or pay" banner.</p>
        <div class="wu-alert-actions x-center">
          <span>To unlock permanently:</span>
          <Woven::Button
            @variant="subtle"
            @size="sm"
            data-test-lock-give-deal
            {{on "click" this.openDealModal}}
          >Give a new deal</Woven::Button>
          <Woven::Button
            @variant="subtle"
            @size="sm"
            data-test-lock-record-payment
            {{on "click" this.openPaymentModal}}
          >Record a payment</Woven::Button>
        </div>
        <div class="wu-alert-actions x-center">
          <span>To let them breathe:</span>
          <Woven::Input
            type="date"
            aria-label="Lift lock until"
            @size="sm"
            @value={{this.liftDate}}
            data-test-lock-lift-date
            {{on "change" this.setLiftDate}}
          />
          <Woven::Button
            @variant="subtle"
            @size="sm"
            @disabled={{this.liftBusy}}
            data-test-lock-lift-submit
            {{on "click" this.submitLift}}
          >{{if this.liftBusy "Lifting…" "Lift"}}</Woven::Button>
        </div>
      </Woven::Alert>
    {{else}}
      <Woven::Alert @variant="warning" role="status" data-test-lock-card>
        <strong class="wu-alert-title">Lock lifted until
          {{format-date this.lock.liftUntil}}.</strong>
        <p>Re-locks automatically then, unless a deal or payment lands.</p>
        <div class="wu-alert-actions x-center">
          <Woven::Input
            type="date"
            aria-label="Lift lock until"
            @size="sm"
            @value={{this.liftDate}}
            data-test-lock-lift-date
            {{on "change" this.setLiftDate}}
          />
          <Woven::Button
            @variant="subtle"
            @size="sm"
            @disabled={{this.liftBusy}}
            data-test-lock-lift-submit
            {{on "click" this.submitLift}}
          >{{if this.liftBusy "Extending…" "Extend lift"}}</Woven::Button>
          <Woven::Button
            @variant="danger"
            @size="sm"
            data-test-lock-end-lift
            {{on "click" this.openEndLiftConfirm}}
          >End lift now</Woven::Button>
        </div>
      </Woven::Alert>
    {{/if}}
  {{/if}}

  <Woven::Tabs
    @tabs={{this.tabs}}
    @activeTab={{this.activeTab}}
    @onChange={{this.selectTab}}
    class="mt-4 mb-4"
  />

  {{#if (eq this.activeTab "overview")}}
    <div class="grid auto-fit-sm gap-4 align-start">
      <Woven::Panel @title="Billing state" data-test-company-plan-card>
        {{#if this.billing}}
          <dl class="wu-desc-list horizontal">
            <dt>Tier</dt>
            <dd>{{this.billing.tier}}</dd>
            {{#if this.billing.billingStatus}}
              <dt>Status</dt>
              <dd><Woven::Tag
                  @variant={{tag-variant "sub" this.billing.billingStatus}}
                  @text={{this.billing.billingStatus}}
                  data-test-company-billing-status
                /></dd>
            {{/if}}
            <dt>Seats</dt>
            <dd>{{this.billing.activeUsers}}
              active /
              {{this.billing.purchasedSeats}}
              purchased</dd>
            <dt>Currency</dt>
            <dd>{{this.billing.currency}}</dd>
            {{#if this.billing.downgradeEffectiveAt}}
              <dt>Scheduled</dt>
              <dd class="text-warning" data-test-company-downgrade-pending>Downgrade
                requested, plan ends
                {{this.downgradeDateLabel}}</dd>
            {{else if this.billing.cancelAtPeriodEnd}}
              <dt>Scheduled</dt>
              <dd class="text-warning">Cancels
                {{format-date this.billing.cancelAt}}</dd>
            {{/if}}
          </dl>
        {{else}}
          <p class="text-muted" data-test-company-billing-unavailable>Billing
            state is unavailable right now.</p>
        {{/if}}
      </Woven::Panel>

      {{#if this.deal}}
        <Woven::Panel @title="Active deal" data-test-company-deal-card>
          <dl class="wu-desc-list horizontal">
            <dt>Price</dt>
            <dd>{{this.dealPriceLabel}}</dd>
            <dt>Seats included</dt>
            <dd>{{this.deal.seatCap}}</dd>
            <dt>Until</dt>
            <dd>{{if
                this.deal.lifetime
                "Lifetime"
                (format-date this.deal.untilDate)
              }}</dd>
            <dt>Why</dt>
            <dd>{{this.deal.whyNote}}</dd>
            <dt>Granted by</dt>
            <dd>{{this.deal.grantedBy}}</dd>
          </dl>
        </Woven::Panel>
      {{/if}}

      <Woven::Panel>
        <:header>
          <h3 class="wu-panel-title">Limits</h3>
          <Woven::Button
            @variant="subtle"
            @size="sm"
            data-test-company-limits-edit
            {{on "click" this.openLimitsModal}}
          >Edit</Woven::Button>
        </:header>
        <:body>
          <dl class="wu-desc-list horizontal">
            <dt>Max users</dt>
            <dd>{{this.company.limits.maxUsers}}</dd>
            <dt>Max regions</dt>
            <dd>{{this.company.limits.maxRegions}}</dd>
            <dt>Max properties</dt>
            <dd>{{this.company.limits.maxProperties}}</dd>
          </dl>
        </:body>
      </Woven::Panel>
    </div>

  {{else if (eq this.activeTab "deal")}}
    {{#if this.deal}}
      <Woven::Panel @title="Active deal" data-test-company-deal-card>
        <dl class="wu-desc-list horizontal">
          <dt>Price</dt>
          <dd>{{this.dealPriceLabel}}</dd>
          <dt>Seats included</dt>
          <dd>{{this.deal.seatCap}}</dd>
          <dt>Until</dt>
          <dd>{{if
              this.deal.lifetime
              "Lifetime"
              (format-date this.deal.untilDate)
            }}</dd>
          <dt>Why</dt>
          <dd>{{this.deal.whyNote}}</dd>
          <dt>Granted by</dt>
          <dd>{{this.deal.grantedBy}}
            on
            {{format-date this.deal.grantedAt}}</dd>
          {{#if this.deal.updatedBy}}
            <dt>Last edited</dt>
            <dd>{{this.deal.updatedBy}}
              on
              {{format-date this.deal.updatedAt}}</dd>
          {{/if}}
        </dl>
        <div class="flex gap-3 mt-4">
          <Woven::Button
            @variant="subtle"
            data-test-deal-edit
            {{on "click" this.openDealModal}}
          >Edit</Woven::Button>
          <Woven::Button
            @variant="danger"
            data-test-deal-end
            {{on "click" this.openEndDealConfirm}}
          >End deal early</Woven::Button>
        </div>
      </Woven::Panel>
    {{else}}
      <Woven::Panel>
        <div class="flex col x-center gap-3 py-6 text-center">
          <Ui::Ph @icon="handshake" @size="40px" />
          <p class="text-muted">No deal on this company yet.</p>
          <Woven::Button
            @variant="brand"
            data-test-deal-give
            {{on "click" this.openDealModal}}
          >Give a deal</Woven::Button>
        </div>
      </Woven::Panel>
    {{/if}}

  {{else if (eq this.activeTab "payments")}}
    <Woven::Panel>
      <:header>
        <h3 class="wu-panel-title">Payments</h3>
        <Woven::Button
          @variant="brand"
          data-test-payment-record
          {{on "click" this.openPaymentModal}}
        >Record a payment</Woven::Button>
      </:header>
      <:body>
      {{#if this.paymentsLoading}}
        <p class="text-muted">Loading payments…</p>
      {{else if this.paymentRows}}
        <Woven::DataTable
          @columns={{this.paymentColumns}}
          @rows={{this.paymentRows}}
          @pinColumns={{true}}
          @reorderable={{true}}
          @sortable={{true}}
          @showOptions={{true}}
          @tableId="console-company-payments"
          data-test-company-payments-table
          as |cell|
        >
          {{#if (eq cell.key "date")}}
            {{format-date cell.value}}
          {{else if (eq cell.key "amount")}}
            <span>{{format-money
                cell.value
                currency=cell.row.currency
                minor=true
              }}</span>
          {{else if (eq cell.key "creditAmount")}}
            {{#let (billing-history-status cell.row) as |status|}}
              {{#if status.creditAmount}}
                <span data-test-payment-credit>{{format-money
                    status.creditAmount
                    currency=cell.row.currency
                    minor=true
                  }}</span>
                <span class="text-muted text-sm">{{status.creditNote}}</span>
              {{else}}
                <span class="text-muted">-</span>
              {{/if}}
            {{/let}}
          {{else if (eq cell.key "type")}}
            {{#let (billing-history-status cell.row) as |status|}}
              <Woven::Tag
                @variant={{status.tagVariant}}
                @text={{status.label}}
                data-test-payment-status
              />
            {{/let}}
          {{else if (eq cell.key "notes")}}
            <span class="console-notes-cell">{{if cell.value cell.value "-"}}</span>
          {{else if (eq cell.key "hasReceipt")}}
            {{#if cell.value}}
              <Woven::Button
                @variant="link"
                @size="sm"
                data-test-company-view-receipt={{cell.row.id}}
                {{on "click" (fn this.viewReceipt cell.row.id)}}
              >View</Woven::Button>
            {{else if cell.row.invoiceUrl}}
              <a
                href={{cell.row.invoiceUrl}}
                target="_blank"
                rel="noopener noreferrer"
                class="link"
              >Invoice</a>
            {{else}}
              <span class="text-muted">-</span>
            {{/if}}
          {{else if (eq cell.key "id")}}
            <RowActions
              @actions={{array
                (hash
                  key="company-make-right"
                  testValue=cell.row.id
                  label="Refund or discount"
                  icon="receipt-x"
                  onSelect=(fn this.openRemedy cell.row)
                  hidden=(not cell.row.paid)
                )
              }}
            />
          {{else}}
            {{cell.value}}
          {{/if}}
        </Woven::DataTable>
      {{else}}
        <p class="text-muted">No payments recorded yet.</p>
      {{/if}}
      </:body>
    </Woven::Panel>

  {{else if (eq this.activeTab "history")}}
    <Woven::Panel @title="History">
      {{#if this.historyLoading}}
        <p class="text-muted">Loading history…</p>
      {{else if this.historyRows}}
        <Woven::DataTable
          @columns={{this.historyColumns}}
          @rows={{this.historyRows}}
          @pinColumns={{true}}
          @reorderable={{true}}
          @sortable={{true}}
          @showOptions={{true}}
          @tableId="console-company-history"
          data-test-company-history-table
          as |cell|
        >
          {{#if (eq cell.key "when")}}
            {{format-date-time cell.value}}
          {{else}}
            {{cell.value}}
          {{/if}}
        </Woven::DataTable>
      {{else}}
        <p class="text-muted">No operator events for this company yet.</p>
      {{/if}}
    </Woven::Panel>
  {{/if}}

  <Woven::Drawer
    @open={{this.dealModalOpen}}
    @title="{{if this.dealEditing 'Edit' 'Give'}} {{this.company.name}} a deal"
    @placement="end"
    @size="lg"
    @onClose={{this.closeDealModal}}
  >
    <:body>
      <div class="wu-form" data-test-deal-form>
        <div class="wu-field-row">
          <Woven::Field
            @label="Price"
            @tooltip="Enter the amount that matches the Basis below, either per seat each month or one flat total each month."
            @error={{this.dealErrors.dealPrice}}
          >
            <Woven::Input
              id="deal-price"
              type="number"
              min="0"
              step="0.01"
              @value={{this.dealPrice}}
              data-test-deal-price
              {{on "input" (fn this.setDealField "dealPrice")}}
            />
          </Woven::Field>
          <Woven::Field
            class="narrow"
            @label="Currency"
            @tooltip="Three letter code such as AED or USD. This is what the company is billed in from now on."
            @error={{this.dealErrors.dealCurrency}}
          >
            <Woven::Input
              id="deal-currency"
              type="text"
              maxlength="3"
              class="console-currency-input"
              @value={{this.dealCurrency}}
              data-test-deal-currency
              {{on "input" (fn this.setDealField "dealCurrency")}}
            />
          </Woven::Field>
          <Woven::Field
            class="wide"
            @label="Basis"
            @tooltip="Per seat charges the price for every active user each month. Flat charges the price once each month, whatever the seat count."
          >
            <Woven::Dropdown
              id="deal-basis"
              data-test-deal-basis
              @align="start"
              @options={{this.basisOptions}}
              @value={{this.dealBasis}}
              @onSelect={{this.setDealBasis}}
            />
          </Woven::Field>
        </div>

        <Woven::Field
          @label="Seats included"
          @tooltip="How many active users this price covers. Extra users above this are billed at the normal per seat rate."
          @error={{this.dealErrors.dealSeatCap}}
        >
          <Woven::Input
            id="deal-seats"
            type="number"
            min="1"
            step="1"
            @value={{this.dealSeatCap}}
            data-test-deal-seats
            {{on "input" (fn this.setDealField "dealSeatCap")}}
          />
        </Woven::Field>

        <div class="wu-field-row">
          <Woven::Field
            class="wide"
            @label="Until"
            @tooltip="The last day this price applies. After it, the company goes back to standard plan pricing."
            @error={{this.dealErrors.dealUntil}}
          >
            <Woven::Input
              id="deal-until"
              type="date"
              @value={{this.dealUntil}}
              disabled={{this.dealLifetime}}
              data-test-deal-until
              {{on "input" (fn this.setDealField "dealUntil")}}
            />
          </Woven::Field>
          <Woven::Checkbox
            class="check"
            @label="Lifetime"
            @checked={{this.dealLifetime}}
            @onChange={{this.toggleDealLifetime}}
            data-test-deal-lifetime
          />
        </div>

        <Woven::Field
          @label="Why"
          @required={{true}}
          @error={{this.dealErrors.dealWhy}}
        >
          <Woven::Textarea
            id="deal-why"
            rows="2"
            required={{true}}
            data-test-deal-why
            @value={{this.dealWhy}}
            {{on "input" (fn this.setDealField "dealWhy")}}
          />
        </Woven::Field>

        <Woven::Alert
          @variant="warning"
          @title="What happens on expiry"
          @description={{this.expiryPreview}}
          role="status"
          data-test-deal-expiry-preview
        />
      </div>
    </:body>
    <:footer>
      <Woven::Button
        @variant="subtle"
        data-test-deal-cancel
        {{on "click" this.closeDealModal}}
      >Cancel</Woven::Button>
      <Woven::Button
        @variant="brand"
        @disabled={{this.dealBusy}}
        data-test-deal-submit
        {{on "click" this.submitDeal}}
      >{{if
          this.dealBusy
          "Saving…"
          (if this.dealEditing "Save deal" "Give deal")
        }}</Woven::Button>
    </:footer>
  </Woven::Drawer>

  <Woven::Drawer
    @open={{this.paymentModalOpen}}
    @title="Record a payment from {{this.company.name}}"
    @placement="end"
    @size="lg"
    @onClose={{this.closePaymentModal}}
  >
    <:body>
      <div class="wu-form" data-test-payment-form>
        <div class="wu-field-row">
          <Woven::Field
            class="wide"
            @label="Amount"
            @error={{this.payErrors.payAmount}}
          >
            <Woven::Input
              id="pay-amount"
              type="number"
              min="0"
              step="0.01"
              @value={{this.payAmount}}
              data-test-payment-amount
              {{on "input" (fn this.setPayField "payAmount")}}
            />
          </Woven::Field>
          <Woven::Field
            class="narrow"
            @label="Currency"
            @tooltip="Three letter code such as AED or USD. It must match the currency the money actually arrived in."
            @error={{this.payErrors.payCurrency}}
          >
            <Woven::Input
              id="pay-currency"
              type="text"
              maxlength="3"
              class="console-currency-input"
              @value={{this.payCurrency}}
              data-test-payment-currency
              {{on "input" (fn this.setPayField "payCurrency")}}
            />
          </Woven::Field>
        </div>

        <div class="wu-field-row">
          <Woven::Field
            @label="Date received"
            @error={{this.payErrors.payReceivedAt}}
          >
            <Woven::Input
              id="pay-received"
              type="date"
              @value={{this.payReceivedAt}}
              data-test-payment-date
              {{on "input" (fn this.setPayField "payReceivedAt")}}
            />
          </Woven::Field>
          <Woven::Field
            @label="Covers from"
            @tooltip="First day of the period this payment pays for. Paid access runs from here."
            @error={{this.payErrors.payCoversStart}}
          >
            <Woven::Input
              id="pay-covers-start"
              type="date"
              @value={{this.payCoversStart}}
              data-test-payment-covers
              {{on "input" (fn this.setPayField "payCoversStart")}}
            />
          </Woven::Field>
          <Woven::Field
            @label="Covers to"
            @tooltip="Last day of the period this payment pays for. Access lapses after this date unless it is renewed."
            @error={{this.payErrors.payCoversEnd}}
          >
            <Woven::Input
              id="pay-covers-end"
              type="date"
              @value={{this.payCoversEnd}}
              data-test-payment-covers-end
              {{on "input" (fn this.setPayField "payCoversEnd")}}
            />
          </Woven::Field>
        </div>

        <Woven::Field @label="Notes">
          <Woven::Textarea
            id="pay-notes"
            rows="2"
            placeholder="JazzCash transfer, txn 8842"
            data-test-payment-notes
            @value={{this.payNotes}}
            {{on "input" (fn this.setPayField "payNotes")}}
          />
        </Woven::Field>

        <Woven::Field @label="Receipt image">
          <input
            id="pay-receipt"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            class="wu-input"
            data-test-payment-receipt
            {{on "change" this.setPayReceipt}}
          />
          {{#if this.payReceiptName}}
            <span class="text-sm text-muted">{{this.payReceiptName}}</span>
          {{/if}}
        </Woven::Field>
        <p class="text-sm text-muted">Document it: notes or a receipt image is
          required.</p>
        {{#if this.payDocError}}
          <p class="text-sm text-danger" data-test-payment-doc-error>{{this.payDocError}}</p>
        {{/if}}
      </div>
    </:body>
    <:footer>
      <Woven::Button
        @variant="subtle"
        data-test-payment-cancel
        {{on "click" this.closePaymentModal}}
      >Cancel</Woven::Button>
      <Woven::Button
        @variant="brand"
        @disabled={{this.payBusy}}
        data-test-payment-submit
        {{on "click" this.submitPayment}}
      >{{if this.payBusy "Recording…" "Record"}}</Woven::Button>
    </:footer>
  </Woven::Drawer>

  <Woven::Drawer
    @open={{this.remedyModalOpen}}
    @title="Refund or discount for {{this.company.name}}"
    @placement="end"
    @size="lg"
    @onClose={{this.closeRemedy}}
  >
    <:body>
      <div class="wu-form" data-test-remedy-form>
        <div class="console-anchor">Payment: {{this.remedyAnchorLabel}}</div>

        <div class="flex col gap-2">
          <Woven::Radio
            @name="remedy-kind"
            @value="discount_next_bill"
            @label="Discount the next bill"
            @checked={{eq this.remedyKind "discount_next_bill"}}
            @onChange={{this.setRemedyKind}}
            data-test-remedy-discount
          />
          <Woven::Radio
            @name="remedy-kind"
            @value="refund"
            @label="Refund this payment"
            @checked={{eq this.remedyKind "refund"}}
            @onChange={{this.setRemedyKind}}
            data-test-remedy-refund
          />
        </div>

        {{#if this.remedyIsRefund}}
          <div class="flex gap-4">
            <Woven::Radio
              @name="remedy-scope"
              @value="partial"
              @label="Partial"
              @checked={{eq this.remedyScope "partial"}}
              @onChange={{this.setRemedyScope}}
              data-test-remedy-scope-partial
            />
            <Woven::Radio
              @name="remedy-scope"
              @value="full"
              @label="Full"
              @checked={{eq this.remedyScope "full"}}
              @onChange={{this.setRemedyScope}}
              data-test-remedy-scope-full
            />
          </div>
        {{/if}}

        {{#if this.showRemedyAmount}}
          <Woven::Field
            @label="Amount"
            @error={{this.remedyErrors.remedyAmount}}
          >
            <Woven::Input
              id="remedy-amount"
              type="number"
              min="0"
              step="0.01"
              @value={{this.remedyAmount}}
              data-test-remedy-amount
              data-test-remedy-partial-amount={{if this.remedyIsRefund true}}
              {{on "input" (fn this.setRemedyField "remedyAmount")}}
            />
          </Woven::Field>
        {{/if}}

        <Woven::Field
          @label="Why"
          @required={{true}}
          @error={{this.remedyErrors.remedyWhy}}
        >
          <Woven::Textarea
            id="remedy-why"
            rows="2"
            required={{true}}
            data-test-remedy-why
            @value={{this.remedyWhy}}
            {{on "input" (fn this.setRemedyField "remedyWhy")}}
          />
        </Woven::Field>

        {{#if this.remedyIsRefund}}
          <Woven::Alert
            @variant="warning"
            @description="Refunds are initiated within 24 to 48 hours. Money leaves the account. This is not undoable."
            role="status"
            data-test-remedy-sla-alert
          />
        {{/if}}
      </div>
    </:body>
    <:footer>
      <Woven::Button
        @variant="subtle"
        data-test-remedy-cancel
        {{on "click" this.closeRemedy}}
      >Cancel</Woven::Button>
      <Woven::Button
        @variant={{if this.remedyIsRefund "danger" "brand"}}
        @disabled={{this.remedyBusy}}
        data-test-remedy-submit
        {{on "click" this.submitRemedy}}
      >{{if this.remedyBusy "Working…" this.remedyConfirmLabel}}</Woven::Button>
    </:footer>
  </Woven::Drawer>

  <Woven::Drawer
    @open={{this.limitsModalOpen}}
    @title="Edit limits"
    @placement="end"
    @size="lg"
    @onClose={{this.closeLimitsModal}}
  >
    <:body>
      <div class="wu-form">
        <Woven::Field
          @label="Max users"
          @tooltip="A hard cap on active team members for this company. It overrides the seat limit that comes with their plan."
          @error={{this.limitErrors.limitMaxUsers}}
        >
          <Woven::Input
            id="limit-users"
            type="number"
            min="1"
            step="1"
            @value={{this.limitMaxUsers}}
            {{on "input" (fn this.setLimitField "limitMaxUsers")}}
          />
        </Woven::Field>
        <Woven::Field
          @label="Max regions"
          @tooltip="A hard cap on how many regions this company can switch on. It overrides the region limit from their plan."
          @error={{this.limitErrors.limitMaxRegions}}
        >
          <Woven::Input
            id="limit-regions"
            type="number"
            min="1"
            step="1"
            @value={{this.limitMaxRegions}}
            {{on "input" (fn this.setLimitField "limitMaxRegions")}}
          />
        </Woven::Field>
        <Woven::Field
          @label="Max properties"
          @tooltip="A hard cap on how many properties this company can create. It overrides the limit from their plan."
          @error={{this.limitErrors.limitMaxProperties}}
        >
          <Woven::Input
            id="limit-properties"
            type="number"
            min="1"
            step="1"
            @value={{this.limitMaxProperties}}
            {{on "input" (fn this.setLimitField "limitMaxProperties")}}
          />
        </Woven::Field>
      </div>
    </:body>
    <:footer>
      <Woven::Button
        @variant="subtle"
        data-test-limits-cancel
        {{on "click" this.closeLimitsModal}}
      >Cancel</Woven::Button>
      <Woven::Button
        @variant="brand"
        @disabled={{this.limitsBusy}}
        data-test-limits-submit
        {{on "click" this.submitLimits}}
      >{{if this.limitsBusy "Saving…" "Save"}}</Woven::Button>
    </:footer>
  </Woven::Drawer>

  <ConfirmModal
    @open={{this.endDealConfirmOpen}}
    @title="End this deal early?"
    @message="{{this.company.name}} returns to standard pricing at the next cycle. This does not lock the account."
    @confirmText="End deal early"
    @confirmingText="Ending…"
    @cancelText="I changed my mind"
    @confirmVariant="danger"
    @isConfirming={{this.endDealBusy}}
    @onConfirm={{this.confirmEndDeal}}
    @onClose={{this.closeEndDealConfirm}}
  />

  <ConfirmModal
    @open={{this.endLiftConfirmOpen}}
    @title="End the lift now?"
    @message="The write lock re-applies immediately. Their admin sees the 'reduce or pay' banner again."
    @confirmText="End lift now"
    @confirmingText="Ending…"
    @cancelText="I changed my mind"
    @confirmVariant="danger"
    @isConfirming={{this.endLiftBusy}}
    @onConfirm={{this.confirmEndLift}}
    @onClose={{this.closeEndLiftConfirm}}
  />

{{else}}
  <Woven::Panel>
    <div class="flex col x-center gap-3 py-6 text-center">
      <p class="text-muted">This company could not be loaded.</p>
      <Woven::Button
        @variant="subtle"
        data-test-company-back
        {{on "click" this.goBack}}
      >Back to Companies</Woven::Button>
    </div>
  </Woven::Panel>
{{/if}}