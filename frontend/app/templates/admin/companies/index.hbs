{{page-title "Companies"}}

<Nuvo::PageHeader
  @title="Companies"
  @subtitle="Every account, its rail, its deal, its lock state."
/>

<Nuvo::Card>
  <div class="console-list-filters mb-4">
    <Nuvo::Input
      class="console-list-filters__search"
      type="text"
      placeholder="Search companies..."
      aria-label="Search companies"
      @value={{this.search}}
      @onInput={{this.setSearch}}
      data-test-companies-search
    />
    <Nuvo::Dropdown
      class="console-list-filters__select"
      aria-label="Filter by rail"
      @align="start"
      @value={{this.railFilter}}
      @options={{this.railOptions}}
      @onSelect={{this.setRail}}
      data-test-companies-rail-filter
    />
    <Nuvo::Dropdown
      class="console-list-filters__select"
      aria-label="Filter by status"
      @align="start"
      @value={{this.statusFilter}}
      @options={{this.statusOptions}}
      @onSelect={{this.setStatus}}
      data-test-companies-status-filter
    />
  </div>

  <div class="nu-table-wrapper">
    <table class="nu-table">
      <thead>
        <tr>
          <th>Company</th>
          <th>Plan</th>
          <th>Rail</th>
          <th>Seats</th>
          <th>MRR</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each this.rows as |row|}}
          {{! Whole-row click is the ratified affordance (design section 3);
          keyboard users reach the detail via the company-name link below. }}
          {{! template-lint-disable no-invalid-interactive }}
          <tr
            class="console-row"
            data-test-companies-row={{row.id}}
            {{on "click" (fn this.openCompany row.id)}}
          >
            <td class="font-bold">
              <LinkTo
                @route="admin.companies.company"
                @model={{row.id}}
                class="console-row__name-link"
              >{{row.name}}</LinkTo>
            </td>
            <td>
              <Nuvo::Tag
                class="badge-plan-{{lowercase row.tier}}"
                @text={{row.tier}}
              />
            </td>
            <td>{{if row.rail row.rail "—"}}</td>
            <td>{{row.seatsUsed}}/{{row.seatCap}}</td>
            <td>
              {{#if row.mrr}}
                {{format-money row.mrr.amountMinor row.mrr.currency}}
              {{else}}
                <span class="text-muted">—</span>
              {{/if}}
            </td>
            <td data-test-companies-status={{row.id}}>
              {{#if (eq row.status "locked")}}
                <Nuvo::Tag class="badge-account-locked" @text="LOCKED" />
              {{else if (eq row.status "lifted")}}
                <Nuvo::Tag class="badge-account-lifted">
                  lifted until
                  {{format-date row.lockState.liftUntil}}
                </Nuvo::Tag>
              {{else if (eq row.status "deal")}}
                <Nuvo::Tag class="badge-account-on_deal">
                  {{#if row.deal.lifetime}}
                    lifetime deal
                  {{else}}
                    deal until
                    {{format-date row.deal.untilDate}}
                  {{/if}}
                </Nuvo::Tag>
              {{else}}
                <Nuvo::Tag class="badge-account-active" @text="active" />
              {{/if}}
            </td>
            <td class="text-end">
              <Ui::Ph @icon="caret-right" @size="18px" />
            </td>
          </tr>
        {{else}}
          <tr>
            <td colspan="7" class="text-muted text-center p-4">
              No companies found.
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <Nuvo::Pagination
    @selectId="console-companies-limit"
    @page={{this.page}}
    @limit={{this.limit}}
    @total={{this.total}}
    @onPrevious={{this.previousPage}}
    @onNext={{this.nextPage}}
    @onLimitChange={{this.changeLimit}}
  />
</Nuvo::Card>