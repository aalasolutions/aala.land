{{page-title "Marketers"}}

<div class="flex col gap-6">
  <Nuvo::PageHeader @title="Marketers" @subtitle="MRR by referral code. Numbers only.">
  </Nuvo::PageHeader>

  <Nuvo::Card>
    {{#if this.rows.length}}
      <DataTable
        @columns={{this.columns}}
        @rows={{this.rows}}
        @tree={{true}}
        @pinColumns={{true}}
        @reorderable={{true}}
        @sortable={{true}}
        @showOptions={{true}}
        @tableId="console-marketers"
        data-test-marketers-table
        as |cell|
      >
        {{#if (eq cell.key "code")}}
          {{#if cell.depth}}
            <LinkTo
              @route="admin.companies.company"
              @model={{cell.row.companyId}}
            >{{cell.value}}</LinkTo>
          {{else}}
            <span
              class="font-bold"
              data-test-marketers-row={{cell.row.key}}
            >{{cell.value}}</span>
          {{/if}}
        {{else if cell.depth}}
          {{! Child rows carry only the company link in the first column. }}
        {{else if (eq cell.key "mrr")}}
          {{#if cell.value}}
            <span class="console-chip-row">
              {{#each cell.value as |band|}}
                <span class="console-chip">
                  <strong class="console-chip__code">{{band.currency}}</strong>
                  {{format-money band.mrrMinor band.currency}}
                </span>
              {{/each}}
            </span>
          {{else}}
            <span class="text-muted">—</span>
          {{/if}}
        {{else if (eq cell.key "lastSignupAt")}}
          {{if cell.value (format-date cell.value) "—"}}
        {{else}}
          {{cell.value}}
        {{/if}}
      </DataTable>
    {{else}}
      <p class="text-muted text-center p-4">No companies yet.</p>
    {{/if}}
  </Nuvo::Card>
</div>
