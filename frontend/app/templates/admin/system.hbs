{{page-title "System"}}

<div class="flex col gap-6">
  <Nuvo::PageHeader @title="System" @subtitle="Billing health and price catalogue.">
  </Nuvo::PageHeader>

  <Nuvo::Card data-test-system-price-health>
    <div class="flex between x-center mb-4">
      <div class="flex x-center gap-3">
        <h3 class="text-lg font-bold">Price catalogue</h3>
        <Nuvo::Tag
          class={{this.healthBadge.cls}}
          @text={{this.healthBadge.text}}
          data-test-system-price-status
        />
      </div>
      {{#if this.needsFix}}
        <Nuvo::Button
          @variant="secondary"
          @loading={{this.fixing}}
          data-test-system-price-fix
          {{on "click" this.fix}}
        >{{if this.fixing "Syncing…" "Fix"}}</Nuvo::Button>
      {{/if}}
    </div>

    {{#if this.data.checkedAt}}
      <p class="text-sm text-muted mb-4">Last checked
        {{format-date-time this.data.checkedAt}}
        (automatic).</p>
    {{/if}}

    {{#if this.rows.length}}
      <DataTable
        @columns={{this.columns}}
        @rows={{this.rows}}
        @pinColumns={{true}}
        @reorderable={{true}}
        @sortable={{true}}
        @showOptions={{true}}
        @tableId="console-system-prices"
        data-test-system-prices-table
        as |cell|
      >
        {{#if (eq cell.key "label")}}
          <span
            class="font-bold"
            data-test-system-price-row={{cell.row.id}}
          >{{cell.value}}</span>
        {{else if (eq cell.key "unitAmount")}}
          {{format-money cell.value cell.row.currency}}
        {{else if (eq cell.key "status")}}
          {{#if (eq cell.value "registered")}}
            <Nuvo::Tag class="tag-sub-active" @text="Registered" />
          {{else if (eq cell.value "missing")}}
            <Nuvo::Tag class="tag-sub-incomplete" @text="Not yet registered" />
          {{else}}
            <div class="flex col gap-2">
              <Nuvo::Tag class="tag-sub-unpaid" @text="Failed" />
              {{#if cell.row.lastError}}
                <Nuvo::Alert @variant="danger" data-test-system-price-error>
                  <p class="text-sm">{{cell.row.lastError}}</p>
                  {{#if cell.row.lastErrorAt}}
                    <p class="text-xs text-muted mt-1">Failed
                      {{format-date-time cell.row.lastErrorAt}}</p>
                  {{/if}}
                </Nuvo::Alert>
              {{/if}}
            </div>
          {{/if}}
        {{else}}
          {{cell.value}}
        {{/if}}
      </DataTable>
    {{else}}
      <p class="text-muted">No active price rows.</p>
    {{/if}}
  </Nuvo::Card>
</div>
