{{page-title "System"}}

<div class="flex col gap-6">
  <Woven::PageHeader @title="System" @subtitle="Billing health and price catalogue.">
  </Woven::PageHeader>

  <Woven::Card data-test-system-price-health>
    <div class="flex between x-center mb-4">
      <div class="flex x-center gap-3">
        <h3 class="text-lg font-bold">Price catalogue</h3>
        <Woven::Tag
          class={{this.healthBadge.cls}}
          @text={{this.healthBadge.text}}
          data-test-system-price-status
        />
      </div>
      <div class="flex x-center gap-2">
        {{#if this.needsFix}}
          <Woven::Button
            @variant="secondary"
            @loading={{this.fixing}}
            data-test-system-price-fix
            {{on "click" this.fix}}
          >{{if this.fixing "Syncing…" "Fix"}}</Woven::Button>
        {{/if}}
        <Woven::Button
          @variant="primary"
          data-test-system-price-add
          {{on "click" this.openAdd}}
        >Add price</Woven::Button>
      </div>
    </div>

    {{#if this.data.checkedAt}}
      <p class="text-sm text-muted mb-4">Last checked
        {{format-date-time this.data.checkedAt}}
        (automatic).</p>
    {{/if}}

    {{#if this.rows.length}}
      <Woven::DataTable
        @columns={{this.columns}}
        @rows={{this.rows}}
        @pinColumns={{true}}
        @reorderable={{true}}
        @sortable={{true}}
        @showOptions={{true}}
        @tableId="console-system-prices"
        data-test-system-prices-table
        as |cell|
      >
        {{#if (eq cell.key "label")}}
          <span
            data-test-system-price-row={{cell.row.id}}
          >{{cell.value}}</span>
        {{else if (eq cell.key "countries")}}
          <span
            data-test-system-price-countries={{cell.row.id}}
          >{{cell.value}}</span>
        {{else if (eq cell.key "unitAmount")}}
          {{format-money cell.value currency=cell.row.currency minor=true}}
        {{else if (eq cell.key "status")}}
          {{#if (eq cell.value "registered")}}
            <Woven::Tag class="tag-sub-active" @text="Registered" />
          {{else if (eq cell.value "missing")}}
            <Woven::Tag class="tag-sub-incomplete" @text="Not yet registered" />
          {{else if (eq cell.value "pending")}}
            <div class="flex col gap-2" data-test-system-price-pending>
              <Woven::Tag class="tag-sub-incomplete" @text="Change pending" />
              <p class="text-sm text-muted">Still selling at the previous price
                until the provider registers this one. Use Fix to retry.</p>
              {{#if cell.row.lastError}}
                <Woven::Alert @variant="danger" data-test-system-price-error>
                  <p class="text-sm">{{cell.row.lastError}}</p>
                </Woven::Alert>
              {{/if}}
            </div>
          {{else}}
            <div class="flex col gap-2">
              <Woven::Tag class="tag-sub-unpaid" @text="Failed" />
              {{#if cell.row.lastError}}
                <Woven::Alert @variant="danger" data-test-system-price-error>
                  <p class="text-sm">{{cell.row.lastError}}</p>
                  {{#if cell.row.lastErrorAt}}
                    <p class="text-xs text-muted mt-1">Failed
                      {{format-date-time cell.row.lastErrorAt}}</p>
                  {{/if}}
                </Woven::Alert>
              {{/if}}
            </div>
          {{/if}}
        {{else if (eq cell.key "id")}}
          <div class="flex gap-2">
            <button
              type="button"
              class="btn btn-secondary btn-xs"
              data-test-system-price-change-amount={{cell.row.id}}
              {{on "click" (fn this.openAmount cell.row)}}
            >Change price</button>
            <button
              type="button"
              class="btn btn-danger btn-xs"
              data-test-system-price-deactivate={{cell.row.id}}
              {{on "click" (fn this.openDeactivate cell.row)}}
            >Deactivate</button>
          </div>
        {{else}}
          {{cell.value}}
        {{/if}}
      </Woven::DataTable>
    {{else}}
      <p class="text-muted">No active price rows.</p>
    {{/if}}
  </Woven::Card>

  <Woven::Modal
    @open={{this.addOpen}}
    @title="Add price"
    @onClose={{this.closePriceModal}}
    data-test-system-price-add-modal
  >
    <:body>
      <div class="wu-form">
        <Woven::Field @label="Kind" @flush={{true}}>
          <Woven::Select
            @value={{this.addKind}}
            @options={{this.kindOptions}}
            @onChange={{this.setAddKind}}
            data-test-system-price-kind
          />
        </Woven::Field>
        <div class="wu-field-row">
          <Woven::Field
            @label="Currency"
            @tooltip="Three letter code such as USD."
            @error={{this.fieldErrors.addCurrency}}
            @flush={{true}}
            class="wu-field-row__narrow"
          >
            <Woven::Input
              id="price-currency"
              type="text"
              maxlength="3"
              class="console-currency-input"
              @value={{this.addCurrency}}
              data-test-system-price-currency
              {{on "input" (fn this.setPriceField "addCurrency")}}
            />
          </Woven::Field>
          <Woven::Field
            @label="Monthly amount"
            @error={{this.fieldErrors.addAmount}}
            @flush={{true}}
            class="grow"
          >
            <Woven::Input
              id="price-amount"
              type="number"
              min="1"
              step="0.01"
              @value={{this.addAmount}}
              data-test-system-price-amount
              {{on "input" (fn this.setPriceField "addAmount")}}
            />
          </Woven::Field>
        </div>
        <Woven::Field
          @label="Countries"
          @tooltip="Leave empty for the base price. For a custom price, list 2-letter country codes separated by commas, such as PK, IN."
          @error={{this.fieldErrors.addCountries}}
          @flush={{true}}
        >
          <Woven::Input
            id="price-countries"
            type="text"
            placeholder="PK, IN"
            @value={{this.addCountries}}
            data-test-system-price-countries-input
            {{on "input" (fn this.setPriceField "addCountries")}}
          />
        </Woven::Field>
        {{#if this.showTax}}
          {{#if this.addIsBase}}
            <div class="flex col gap-1">
              <Woven::Checkbox
                id="price-tax-inclusive"
                @checked={{this.addTaxInclusive}}
                @label="Price includes tax"
                @onChange={{fn this.setTaxInclusive "addTaxInclusive"}}
                data-test-system-price-tax-inclusive
              />
              <p class="text-sm text-muted">Not selected: tax is added on top at
                checkout. Custom prices for this kind follow the same setting.</p>
            </div>
          {{else}}
            <p class="text-sm text-muted">A custom price follows the tax setting
              of its base price.</p>
          {{/if}}
        {{/if}}
        <p class="text-sm text-muted">The price syncs to the billing provider
          immediately.</p>
        {{#if this.priceError}}
          <Woven::Alert
            @variant="danger"
            @description={{this.priceError}}
            data-test-system-price-modal-error
          />
        {{/if}}
      </div>
    </:body>
    <:footer>
      <Woven::Button
        @variant="secondary"
        data-test-system-price-add-cancel
        {{on "click" this.closePriceModal}}
      >Cancel</Woven::Button>
      <Woven::Button
        @variant="primary"
        @loading={{this.priceBusy}}
        @disabled={{this.priceBusy}}
        data-test-system-price-add-submit
        {{on "click" this.submitAdd}}
      >{{if this.priceBusy "Saving…" "Add price"}}</Woven::Button>
    </:footer>
  </Woven::Modal>

  <Woven::Modal
    @open={{if this.amountRow true false}}
    @title="Change price for {{this.amountRow.label}}"
    @onClose={{this.closePriceModal}}
    data-test-system-price-amount-modal
  >
    <:body>
      <div class="wu-form">
        <p class="text-sm">Current amount:
          {{format-money
            this.amountRow.unitAmount
            currency=this.amountRow.currency
            minor=true
            compact=false
          }}</p>
        <Woven::Field
          @label="New monthly amount"
          @error={{this.fieldErrors.newAmount}}
          @flush={{true}}
        >
          <Woven::Input
            id="price-new-amount"
            type="number"
            min="1"
            step="0.01"
            @value={{this.newAmount}}
            data-test-system-price-new-amount
            {{on "input" (fn this.setPriceField "newAmount")}}
          />
        </Woven::Field>
        {{#if this.showNewTax}}
          <div class="flex col gap-1">
            <Woven::Checkbox
              id="price-new-tax-inclusive"
              @checked={{this.newTaxInclusive}}
              @label="Price includes tax"
              @onChange={{fn this.setTaxInclusive "newTaxInclusive"}}
              data-test-system-price-new-tax-inclusive
            />
            <p class="text-sm text-muted">Not selected: tax is added on top at
              checkout. Applies to this price and its custom prices. Current
              setting:
              {{this.amountRow.tax}}.</p>
          </div>
        {{/if}}
        <div class="alert alert-warning">
          <div>
            <p class="text-sm">Existing subscribers keep their current price
              until they are migrated. New checkouts use the new price. The
              change syncs to the billing provider immediately.</p>
          </div>
        </div>
        {{#if this.priceError}}
          <Woven::Alert
            @variant="danger"
            @description={{this.priceError}}
            data-test-system-price-modal-error
          />
        {{/if}}
      </div>
    </:body>
    <:footer>
      <Woven::Button
        @variant="secondary"
        data-test-system-price-amount-cancel
        {{on "click" this.closePriceModal}}
      >Cancel</Woven::Button>
      <Woven::Button
        @variant="primary"
        @loading={{this.priceBusy}}
        @disabled={{this.priceBusy}}
        data-test-system-price-amount-submit
        {{on "click" this.submitAmount}}
      >{{if this.priceBusy "Saving…" "Change price"}}</Woven::Button>
    </:footer>
  </Woven::Modal>

  <ConfirmModal
    @open={{if this.deactivateRow true false}}
    @title="Deactivate {{this.deactivateRow.label}}?"
    @message="New checkouts stop using this price. Existing subscribers keep their current price until they are migrated. The change syncs to the billing provider immediately."
    @confirmText="Deactivate"
    @confirmingText="Deactivating…"
    @confirmVariant="danger"
    @isConfirming={{this.priceBusy}}
    @onConfirm={{this.submitDeactivate}}
    @onClose={{this.closePriceModal}}
  >
    {{#if this.priceError}}
      <Woven::Alert
        @variant="danger"
        @description={{this.priceError}}
        class="mt-3"
        data-test-system-price-modal-error
      />
    {{/if}}
  </ConfirmModal>
</div>
