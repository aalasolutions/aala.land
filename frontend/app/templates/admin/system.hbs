{{page-title "System"}}

<div class="flex col gap-6">
  <Nuvo::PageHeader @title="System" @subtitle="Billing health and price catalogue.">
  </Nuvo::PageHeader>

  <Nuvo::Card data-test-system-price-health>
    <div class="flex between x-center mb-4">
      <div class="flex x-center gap-3">
        <h3 class="text-lg font-bold">Price catalogue</h3>
        <Nuvo::Tag
          class={{this.healthBadge.cls}}
          @text={{this.healthBadge.text}}
          data-test-system-price-status
        />
      </div>
      {{#if this.needsFix}}
        <Nuvo::Button
          @variant="secondary"
          @loading={{this.fixing}}
          data-test-system-price-fix
          {{on "click" this.fix}}
        >{{if this.fixing "Syncing…" "Fix"}}</Nuvo::Button>
      {{/if}}
    </div>

    {{#if this.data.checkedAt}}
      <p class="text-sm text-muted mb-4">Last checked
        {{format-date-time this.data.checkedAt}}
        (automatic).</p>
    {{/if}}

    {{#if this.rows.length}}
      <div class="nu-table-wrapper">
        <table class="nu-table">
          <thead>
            <tr>
              <th>Price</th>
              <th>Amount</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {{#each this.rows as |row|}}
              <tr data-test-system-price-row="{{row.kind}}-{{row.currency}}">
                <td class="font-bold">{{row.label}}</td>
                <td>{{format-money row.unitAmount row.currency}}</td>
                <td>
                  {{#if (eq row.status "registered")}}
                    <Nuvo::Tag class="tag-sub-active" @text="Registered" />
                  {{else if (eq row.status "missing")}}
                    <Nuvo::Tag
                      class="tag-sub-incomplete"
                      @text="Not yet registered"
                    />
                  {{else}}
                    <div class="flex col gap-2">
                      <Nuvo::Tag class="tag-sub-unpaid" @text="Failed" />
                      {{#if row.lastError}}
                        <Nuvo::Alert
                          @variant="danger"
                          data-test-system-price-error
                        >
                          <p class="text-sm">{{row.lastError}}</p>
                          {{#if row.lastErrorAt}}
                            <p class="text-xs text-muted mt-1">Failed
                              {{format-date-time row.lastErrorAt}}</p>
                          {{/if}}
                        </Nuvo::Alert>
                      {{/if}}
                    </div>
                  {{/if}}
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <p class="text-muted">No active price rows.</p>
    {{/if}}
  </Nuvo::Card>
</div>
