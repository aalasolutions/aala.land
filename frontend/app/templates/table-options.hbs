{{page-title "Table Options"}}

{{! Development-only copy of the contacts list: every DataTable option in one place. }}
<div data-test-table-options class="flex col gap-4">
  <Woven::PageHeader
    @title="Table Options"
    @subtitle="DataTable showcase on live contacts. A: all options on. B: defaults. C: RTL with fake rows and every editor type."
  >
    <:meta>
      <p class="text-muted">{{format-number @model.total unit="contact"}}{{#if this.selection.length}}
          · {{this.selection.length}} selected{{/if}}</p>
    </:meta>
    <:actions>
      <Woven::Button
        @variant="primary"
        @icon="plus"
        data-test-new-contact
        {{on "click" this.openCreate}}
      >
        New Contact
      </Woven::Button>
    </:actions>
  </Woven::PageHeader>

  <div class="flex x-center gap-3 wrap" data-test-table-options-toolbar>
    <Woven::Segmented
      @options={{this.roleTabs}}
      @value={{this.tag}}
      @onChange={{this.setTag}}
      data-test-role-tabs
    />
    <FiltersButton @count={{this.activeFilterCount}}>
      <div class="flex col gap-4">
        <div class="flex gap-3 wrap">
          <Woven::Field class="grow" @label="Search">
            <Woven::Input
              type="text"
              autocomplete="off"
              placeholder="Search name, email, phone..."
              class="grow"
              value={{this.search}}
              {{on "input" (fn this.updateFilter "search")}}
              data-test-contacts-search
            />
          </Woven::Field>
        </div>

        <div class="flex gap-3 wrap x-end">
          <Woven::Field class="grow" @label="Assigned agent">
            <Woven::Dropdown
              id="contacts-agent-filter"
              @align="start"
              @value={{this.agentId}}
              @onSelect={{this.setAgentFilter}}
              @options={{this.agentOptions}}
              data-test-agent-filter
            />
          </Woven::Field>
          <Woven::Field class="grow" @label="Company">
            <Woven::Input
              type="text"
              autocomplete="off"
              placeholder="e.g. Emaar Properties"
              value={{this.company}}
              {{on "input" (fn this.updateFilter "company")}}
              data-test-company-filter
            />
          </Woven::Field>
          <Woven::Field class="grow" @label="Nationality">
            <Woven::Input
              type="text"
              autocomplete="off"
              placeholder="e.g. Emirati"
              value={{this.nationality}}
              {{on "input" (fn this.updateFilter "nationality")}}
              data-test-nationality-filter
            />
          </Woven::Field>
          <Woven::Field @label="Added from">
            <input
              type="date"
              class="wu-input"
              aria-label="Added from"
              value={{this.dateFrom}}
              {{on "change" this.setDateFrom}}
              data-test-date-from-filter
            />
          </Woven::Field>
          <Woven::Field @label="Added to">
            <input
              type="date"
              class="wu-input"
              aria-label="Added to"
              value={{this.dateTo}}
              {{on "change" this.setDateTo}}
              data-test-date-to-filter
            />
          </Woven::Field>
        </div>

        <div class="flex gap-3 x-center between">
          <Woven::Toggle
            @checked={{this.isWhatsapp}}
            @onChange={{this.toggleWhatsappFilter}}
            data-test-whatsapp-filter
          >
            Has WhatsApp
          </Woven::Toggle>
          <Woven::Button
            @variant="secondary"
            @size="sm"
            @icon="x"
            @disabled={{not this.hasActiveFilters}}
            {{on "click" this.clearFilters}}
            data-test-clear-filters
          >
            Clear filters
          </Woven::Button>
        </div>
      </div>
    </FiltersButton>
  </div>

  <Woven::Card @compact={{true}}>
    {{#if @model.contacts.length}}
      <Woven::DataTable
        @columns={{this.columns}}
        @rows={{@model.contacts}}
        @selection={{this.selection}}
        @onSelect={{this.setSelection}}
        @selectOnRowClick={{true}}
        @pinColumns={{true}}
        @reorderable={{true}}
        @showOptions={{true}}
        @tableId="table-options-a"
        @onCellEdit={{this.saveCell}}
        data-test-contacts-table
        as |cell|
      >
        {{#if (eq cell.key "displayName")}}
          <LinkTo
            @route="contacts.detail"
            @model={{cell.row.id}}
            class="text-brand whitespace-nowrap"
            data-test-view-contact
          >{{cell.value}}</LinkTo>
        {{else if (eq cell.key "tags")}}
          <div class="data-table__chips">
            {{#each cell.value as |tag|}}
              <Woven::Tag class="tag-contact-{{tag}}" @text={{contact-tag-label tag}} />
            {{else}}
              <span class="text-muted text-sm">Contact</span>
            {{/each}}
          </div>
        {{else if (eq cell.key "phone")}}
          {{#if cell.value}}
            <span class="flex gap-2 x-center text-muted">
              <span>{{cell.value}}</span>
              {{#if cell.row.isWhatsapp}}
                <a
                  href={{wa-link cell.value}}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="wa-link"
                  title="Open WhatsApp"
                  aria-label="Open WhatsApp chat with {{cell.row.displayName}}"
                  data-test-wa-link
                ><Ui::Ph @icon="whatsapp-logo" @size="14px" /></a>
              {{/if}}
            </span>
          {{/if}}
        {{else if (eq cell.key "id")}}
          <Woven::Button
            @variant="secondary"
            @size="xs"
            @icon="pencil-simple"
            data-test-edit-contact
            {{on "click" (fn this.openEdit cell.row)}}
          >
            Edit
          </Woven::Button>
        {{else}}
          <span class="text-muted">{{cell.value}}</span>
        {{/if}}
      </Woven::DataTable>
    {{else}}
      {{#if @model.total}}
        <Woven::EmptyState
          @description="No contacts on page {{this.page}}. Navigate back or adjust your filters."
        />
      {{else}}
        <Woven::EmptyState
          @description="No contacts match these filters."
        />
      {{/if}}
    {{/if}}

    {{#if @model.total}}
      <Woven::Pagination
        @selectId="contacts-limit"
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{@model.total}}
        @onLimitChange={{this.setLimit}}
        @onPrevious={{this.goToPreviousPage}}
        @onNext={{this.goToNextPage}}
        @onPageChange={{this.goToPage}}
      />
    {{/if}}
  </Woven::Card>

  {{! TEMP DataTable variation demo, remove after review. }}
