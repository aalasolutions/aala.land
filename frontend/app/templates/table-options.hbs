</div>

<Woven::Drawer
  @open={{this.showModal}}
  @title={{if this.editContact "Edit Contact" "New Contact"}}
  @placement="end"
  @size="lg"
  @onClose={{this.closeModal}}
  @onClosed={{this.resetDrawer}}
>
  <:body>
    <form
      id="contact-form"
      class="wu-form"
      {{on "submit" this.saveContact}}
    >
      <div class="flex gap-4">
        <Woven::Field class="grow" @label="First Name">
          <Woven::Input
            id="c-fname"
            type="text"
            placeholder="Ahmed"
            @value={{this.formFirstName}}
            @onInput={{fn this.setFieldValue "formFirstName"}}
            data-test-input-first-name
          />
        </Woven::Field>
        <Woven::Field class="grow" @label="Last Name">
          <Woven::Input
            id="c-lname"
            type="text"
            placeholder="Al-Rashid"
            @value={{this.formLastName}}
            @onInput={{fn this.setFieldValue "formLastName"}}
            data-test-input-last-name
          />
        </Woven::Field>
      </div>

      <div class="flex gap-4">
        <Woven::Field class="grow" @label="Email">
          <Woven::Input
            id="c-email"
            type="email"
            placeholder="ahmed@example.com"
            @value={{this.formEmail}}
            @onInput={{fn this.setFieldValue "formEmail"}}
            data-test-input-email
          />
        </Woven::Field>
        <Woven::Field class="grow" @label="Nationality">
          <Woven::Input
            id="c-nationality"
            type="text"
            placeholder="e.g. Emirati"
            @value={{this.formNationality}}
            @onInput={{fn this.setFieldValue "formNationality"}}
            data-test-input-nationality
          />
        </Woven::Field>
      </div>

      <div class="flex gap-4">
        <Woven::Field class="grow" @label="Phone">
          <Woven::Input
            id="c-phone"
            type="text"
            placeholder="+971501234567"
            @value={{this.formPhone}}
            @onInput={{fn this.setFieldValue "formPhone"}}
            data-test-input-phone
          />
        </Woven::Field>
        <Woven::Field class="grow" @label="National ID">
          <Woven::Input
            id="c-national-id"
            type="text"
            placeholder="EID / passport number"
            @value={{this.formNationalId}}
            @onInput={{fn this.setFieldValue "formNationalId"}}
            data-test-input-national-id
          />
        </Woven::Field>
      </div>

      <Woven::Checkbox
        @checked={{this.formIsWhatsapp}}
        @label="This phone number is on WhatsApp"
        @onChange={{fn this.setFieldValue "formIsWhatsapp"}}
        data-test-input-is-whatsapp
      />

      <div class="flex gap-4">
        <Woven::Field class="grow" @label="Company">
          <Woven::Input
            id="c-company"
            type="text"
            placeholder="Emaar Properties"
            @value={{this.formContactCompany}}
            @onInput={{fn this.setFieldValue "formContactCompany"}}
            data-test-input-company
          />
        </Woven::Field>
        <Woven::Field class="grow" @label="Job Title">
          <Woven::Input
            id="c-job"
            type="text"
            placeholder="Property Manager"
            @value={{this.formJobTitle}}
            @onInput={{fn this.setFieldValue "formJobTitle"}}
            data-test-input-job-title
          />
        </Woven::Field>
      </div>

      <Woven::Field @label="Address">
        <Woven::Input
          id="c-address"
          type="text"
          placeholder="e.g. Gulberg, Lahore"
          @value={{this.formAddress}}
          @onInput={{fn this.setFieldValue "formAddress"}}
          data-test-input-address
        />
      </Woven::Field>

      <Woven::Field @label="Notes">
        <Woven::Textarea
          id="c-notes"
          placeholder="Additional notes..."
          rows="3"
          @value={{this.formNotes}}
          @onInput={{fn this.setFieldValue "formNotes"}}
          data-test-input-notes
        />
      </Woven::Field>

      {{#if this.errorMsg}}
        <p class="text-sm text-danger" data-test-error>{{this.errorMsg}}</p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Woven::Button
      @variant="secondary"
      @onClick={{this.closeModal}}
      data-test-cancel-contact-form
    >Cancel</Woven::Button>
    <Woven::Button
      @variant="primary"
      @type="submit"
      form="contact-form"
      @loading={{this.isSaving}}
      data-test-save-contact
    >{{if
        this.isSaving
        "Saving..."
        (if this.editContact "Update" "Create Contact")
      }}</Woven::Button>
  </:footer>
</Woven::Drawer>

<ConfirmModal
  @open={{this.showDeleteModal}}
  @title="Delete Contact"
  @message="Delete {{this.contactToDelete.displayName}}? This cannot be undone."
  @confirmText="Delete"
  @confirmVariant="danger"
  @isConfirming={{this.isDeleting}}
  @confirmingText="Deleting..."
  @onClose={{this.closeDeleteModal}}
  @onConfirm={{this.confirmDelete}}
>
  <Woven::Field class="mt-4" @label="Reason" @required={{true}} @error={{this.reasonError}}>
    <Woven::Textarea
      id="contact-delete-reason"
      rows="2"
      maxlength="500"
      placeholder="e.g. Duplicate contact"
      @value={{this.deleteReason}}
      @onInput={{fn this.setFieldValue "deleteReason"}}
      @invalid={{if this.reasonError true false}}
      aria-label="Reason"
      data-test-reason-input
    />
  </Woven::Field>
</ConfirmModal>
