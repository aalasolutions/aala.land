  <Nuvo::Card>
    <h3 class="nu-text m-sm font-bold">C: RTL, fake Arabic data, row click on</h3>
    <Nuvo::DataTable
      @columns={{this.demoColumns}}
      @rows={{this.demoRtlRows}}
      @onCellEdit={{this.saveDemoCell}}
      @selection={{this.demoSelectionRtl}}
      @onSelect={{this.setDemoSelectionRtl}}
      @selectOnRowClick={{true}}
      @pinColumns={{true}}
      @reorderable={{true}}
      @showOptions={{true}}
      @tableId="demo-rtl"
      @sortable={{true}}
      @dir="rtl"
      data-test-demo-table-rtl
      as |cell|
    >
