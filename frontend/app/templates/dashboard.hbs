{{page-title "Dashboard"}}

<div data-test-dashboard class="dashboard-page">
  {{! Header }}
  <Nuvo::PageHeader class="dashboard-header" @title="Command Center" @subtitle="Live overview of your property operation.">
    <:actions>
      <Nuvo::Tag class="dashboard-region-badge">
        <Ui::Ph @icon="globe" @size="14px" />
        {{this.regionLabel}}
      </Nuvo::Tag>
    </:actions>
  </Nuvo::PageHeader>

  {{! KPI Cards }}
  {{#if @model.kpis}}
    <div class="kpi-grid">
      <Nuvo::Stat data-test-kpi="total-units" @variant="primary" @label="Total Properties" @value={{format-number @model.kpis.totalUnits}} />
      <Nuvo::Stat data-test-kpi="total-leads" @variant="secondary" @label="Active Leads" @value={{format-number @model.kpis.totalLeads}} />
      <Nuvo::Stat data-test-kpi="monthly-revenue" @variant="primary" @label="Monthly Revenue" @value={{format-currency @model.kpis.monthlyRevenue}} />
      <Nuvo::Stat data-test-kpi="occupancy" @variant="success" @label="Occupancy Rate" @value="{{if @model.kpis.totalUnits this.occupancyRate 0}}%" />
    </div>

    {{! Second row: Won + Leases + Cheques }}
    <div class="kpi-grid kpi-grid-3">
      <Nuvo::Stat data-test-kpi="won-leads" @variant="success" @label="Deals Won" @value={{format-number @model.kpis.wonLeads}} />
      <Nuvo::Stat data-test-kpi="active-leases" @variant="primary" @label="Active Leases" @value={{format-number @model.kpis.activeLeases}} />
      <Nuvo::Stat data-test-kpi="pending-cheques" @variant="warning" @label="Pending Cheques" @value={{format-number @model.kpis.pendingCheques}} />
    </div>
  {{else}}
    <Nuvo::Panel class="p-8 text-center">
      <p class="text-muted">Loading KPIs...</p>
    </Nuvo::Panel>
  {{/if}}

  {{! Bottom row: Activity Feed + Pipeline }}
  <div class="dashboard-panels">
    {{! Activity Feed }}
    <Nuvo::Panel class="dashboard-panel">
      <:header>
        <h3 class="nu-panel__title"><Ui::Ph @icon="lightning" @size="18px" />
          Recent Activity</h3>
      </:header>
      <:body>
        <div class="activity-feed">
          {{#each @model.activity as |item|}}
            <div class="dashboard-activity-item">
              <Nuvo::Dot @variant={{this.activityColor item.entityType}} />
              <div class="dashboard-activity-content">
                <span class="dashboard-activity-text">{{item.action}}
                  {{item.entityType}}</span>
                <span class="dashboard-activity-time">{{this.timeAgo
                    item.createdAt
                  }}</span>
              </div>
            </div>
          {{else}}
            <Nuvo::EmptyState @icon="⏱" @description="No recent activity" />
          {{/each}}
        </div>
      </:body>
    </Nuvo::Panel>

    {{! Pipeline Funnel }}
    <Nuvo::Panel class="dashboard-panel">
      <:header>
        <h3 class="nu-panel__title"><Ui::Ph @icon="funnel" @size="18px" />
          Lead Pipeline</h3>
      </:header>
      <:body>
        <div class="pipeline-bars">
          {{#each @model.pipeline as |stage|}}
            <div class="pipeline-stage">
              <div class="pipeline-stage-header">
                <span class="pipeline-stage-name">{{stage.stage}}</span>
                <span class="pipeline-stage-count">{{stage.count}}</span>
              </div>
              <div class="pipeline-bar-track">
                <div
                  class="pipeline-bar-fill pipeline-bar-{{this.pipelineColor
                      stage.stage
                    }}"
                  style={{this.pipelineBarStyle stage.count}}
                ></div>
              </div>
            </div>
          {{else}}
            <Nuvo::EmptyState @icon="⏱" @description="No leads in pipeline" />
          {{/each}}
        </div>
      </:body>
    </Nuvo::Panel>
  </div>
</div>
