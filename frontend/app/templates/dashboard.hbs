{{page-title "Dashboard"}}

<div data-test-dashboard class="dashboard-page">
  <Nuvo::PageHeader class="dashboard-header" @title="Command Center" @subtitle="Live overview of your property operation.">
    <:actions>
      <Nuvo::Tag class="dashboard-region-badge">
        <Ui::Ph @icon="globe" @size="14px" />
        {{this.regionLabel}}
      </Nuvo::Tag>
    </:actions>
  </Nuvo::PageHeader>

  {{#if @model.kpis}}
    {{! Three tiers: what needs acting on, what it earned, what is merely true. }}
    <div class="kpi-layout">
      <div class="kpi-action">
        <Nuvo::Stat
          data-test-kpi="pending-cheques"
          @route="cheques"
          @variant="warning"
          @size="lg"
          @label="Pending Cheques"
          @value={{format-number @model.kpis.pendingCheques}}
          @delta="Needs action"
        />
        <Nuvo::Stat
          data-test-kpi="total-leads"
          @route="leads"
          @variant="secondary"
          @size="lg"
          @label="Active Leads"
          @value={{format-number @model.kpis.totalLeads}}
          @delta="In pipeline"
        />
      </div>

      <Nuvo::Stat
        class="kpi-outcome"
        data-test-kpi="monthly-revenue"
        @label="Monthly Revenue"
        @value={{format-currency @model.kpis.monthlyRevenue}}
      >
        <:content>
          <StatSparkline
            @points={{this.revenuePoints}}
            @color="--primary"
            @caption="Completed revenue by month"
          />
        </:content>
      </Nuvo::Stat>

      <div class="kpi-status">
        <Nuvo::Stat data-test-kpi="total-units" @row={{true}} @label="Total Properties" @value={{format-number @model.kpis.totalUnits}} />
        <Nuvo::Stat data-test-kpi="occupancy" @row={{true}} @label="Occupancy Rate" @value="{{if @model.kpis.totalUnits this.occupancyRate 0}}%" />
        <Nuvo::Stat data-test-kpi="won-leads" @row={{true}} @label="Deals Won" @value={{format-number @model.kpis.wonLeads}} />
        <Nuvo::Stat data-test-kpi="active-leases" @row={{true}} @label="Active Leases" @value={{format-number @model.kpis.activeLeases}} />
      </div>
    </div>
  {{else}}
    <Nuvo::Panel class="p-8 text-center">
      <p class="text-muted">Loading KPIs...</p>
    </Nuvo::Panel>
  {{/if}}

  <div class="dashboard-panels">
    <Nuvo::Panel class="dashboard-panel">
      <:header>
        <div class="ownership-header">
          <h3 class="nu-panel__title">
            Lead Pipeline</h3>
          <p class="ownership-caption">All open leads by stage.</p>
        </div>
      </:header>
      <:body>
        <div class="pipeline-bars">
          {{#each this.pipelineStages as |stage|}}
            <div class="pipeline-stage">
              <div class="pipeline-stage-header">
                <span class="pipeline-stage-name">{{stage.stage}}</span>
                <span class="pipeline-stage-count">{{stage.count}}</span>
              </div>
              <div class="pipeline-bar-track">
                <div
                  class="pipeline-bar-fill pipeline-bar-{{this.pipelineColor
                      stage.stage
                    }}"
                  style={{this.pipelineBarStyle stage.count}}
                ></div>
              </div>
            </div>
          {{else}}
            <Nuvo::EmptyState @description="No leads in pipeline" />
          {{/each}}
        </div>

        <div class="closed-block" data-test-closed-leads>
          <span class="closed-head">
            <span class="closed-label">Closed</span>
            <span class="closed-counts">{{this.closedText}}</span>
          </span>
          <p class="ownership-caption">Won and lost from the last 30 days.</p>
          {{#if this.closedSegments}}
            <span class="ownership-bar" aria-hidden="true">
              {{#each this.closedSegments as |segment|}}
                <span
                  class="ownership-segment pipeline-bar-{{segment.variant}}"
                  style={{segment.style}}
                  data-tooltip={{segment.tooltip}}
                ></span>
              {{/each}}
            </span>
          {{/if}}
        </div>

        <LinkTo
          @route="leads"
          class="dashboard-panel-strip"
          data-test-unassigned-leads
        >
          <span class="dashboard-strip-label">
            <strong>{{format-number this.unassignedOpen}}</strong>
            unassigned
          </span>
          <span class="dashboard-strip-action">Assign</span>
        </LinkTo>
      </:body>
    </Nuvo::Panel>

    <Nuvo::Panel class="dashboard-panel">
      <:header>
        <div class="ownership-header">
          <h3 class="nu-panel__title">
            Lead Ownership</h3>
          <p class="ownership-caption">Open leads by agent. Won and lost from
            the last 30 days.</p>
        </div>
      </:header>
      <:body>
        {{#if this.ownershipAgents.length}}
          <div class="ownership-rows" data-test-ownership-rows>
            {{#each this.agentRows as |agent|}}
              <LinkTo
                @route="leads"
                class="ownership-row"
                data-test-ownership-agent={{agent.agentId}}
                aria-label={{agent.label}}
              >
                <span class="ownership-row-head">
                  <Nuvo::Avatar @initials={{agent.initials}} @size="sm" />
                  <span class="ownership-name">{{agent.agentName}}</span>
                  <span class="ownership-open">{{format-number agent.openTotal}}
                    open</span>
                </span>
                <span class="ownership-bar" aria-hidden="true">
                  {{#each agent.segments as |segment|}}
                    <span
                      class="ownership-segment pipeline-bar-{{segment.variant}}"
                      style={{segment.style}}
                      data-tooltip={{segment.tooltip}}
                    ></span>
                  {{/each}}
                </span>
              </LinkTo>
            {{/each}}
          </div>

          {{#if this.hiddenAgentCount}}
            <p class="ownership-more" data-test-ownership-more>
              {{this.hiddenAgentCount}}
              more carrying leads
            </p>
          {{/if}}

          {{#if this.idleAgents.length}}
            <LinkTo
              @route="leads"
              class="dashboard-panel-strip"
              data-test-ownership-idle
              aria-label={{this.idleLabel}}
            >
              <span class="dashboard-strip-label">
                <Nuvo::AvatarGroup>
                  {{#each this.visibleIdleAgents as |agent|}}
                    <Nuvo::Avatar
                      @initials={{agent.initials}}
                      @size="xs"
                      data-tooltip={{agent.agentName}}
                    />
                  {{/each}}
                </Nuvo::AvatarGroup>
                {{#if this.hiddenIdleCount}}
                  <span class="idle-overflow">+{{this.hiddenIdleCount}}</span>
                {{/if}}
                {{this.idleAgents.length}}
                with no leads
              </span>
              <span class="dashboard-strip-action">Assign</span>
            </LinkTo>
          {{/if}}
          <div class="closed-block" data-test-assignment>
            <span class="closed-head">
              <span class="closed-label">Assignment</span>
              <span class="closed-counts">{{this.assignmentText}}</span>
            </span>
            <p class="ownership-caption">Every open lead, held or waiting.</p>
            {{#if this.assignmentSegments}}
              <span class="ownership-bar" aria-hidden="true">
                {{#each this.assignmentSegments as |segment|}}
                  <span
                    class="ownership-segment pipeline-bar-{{segment.variant}}"
                    style={{segment.style}}
                    data-tooltip={{segment.tooltip}}
                  ></span>
                {{/each}}
              </span>
            {{/if}}
          </div>

        {{else}}
          <Nuvo::EmptyState @description="No agents yet" />
        {{/if}}
      </:body>
    </Nuvo::Panel>
  </div>
</div>