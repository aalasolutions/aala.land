{{page-title "Email Templates"}}

<div data-test-email-templates class="flex col gap-6">
  <Nuvo::PageHeader @title="Email Templates">
    <:meta>
      <p class="text-muted">{{format-number @model.total}} templates</p>
    </:meta>
    <:actions>
      <Nuvo::Button
        @variant="primary"
        @icon="+"
        data-test-new-template
        {{on "click" this.openCreate}}
      >
        New Template
      </Nuvo::Button>
    </:actions>
  </Nuvo::PageHeader>

  <div class="flex gap-3">
    <Nuvo::Dropdown
      id="email-template-category-filter"
      @align="start"
      @value={{this.category}}
      @onSelect={{this.filterCategory}}
      @options={{this.filterCategories}}
      @placeholder="All Categories"
      data-test-category-filter
    />
  </div>

  {{#if @model.templates.length}}
    <div class="grid cols-2 gap-4">
      {{#each @model.templates as |template|}}
        <Nuvo::Card data-test-template-card class="flex col gap-3">
          <div class="flex between x-center">
            <div class="flex x-center gap-2">
              <Ui::Ph @icon="envelope-simple" />
              <h4 class="font-bold">{{template.name}}</h4>
            </div>
            <div class="flex gap-1 x-center">
              {{#unless template.isActive}}
                <Nuvo::Tag class="badge-enabled-inactive" @text="Inactive" />
              {{/unless}}
              <Nuvo::Tag
                class="badge-email-{{lowercase template.category}}"
                @text={{template.category}}
              />
            </div>
          </div>
          <p class="text-muted text-sm">Subject: {{template.subject}}</p>
          {{#if template.variables.length}}
            <div class="flex gap-1 wrap">
              {{#each template.variables as |v|}}
                <Nuvo::Tag @text={{v}} />
              {{/each}}
            </div>
          {{/if}}
          <div class="flex gap-2 email-template-card__actions">
            <Nuvo::Button
              @variant="secondary"
              @size="sm"
              @icon="👁"
              data-test-preview-template
              {{on "click" (fn this.openPreview template)}}
            >
              Preview
            </Nuvo::Button>
            <Nuvo::Button
              @variant="secondary"
              @size="sm"
              @icon="✎"
              data-test-edit-template
              {{on "click" (fn this.openEdit template)}}
            >
              Edit
            </Nuvo::Button>
            <Nuvo::Button
              @variant="danger"
              @size="sm"
              @icon="✕"
              data-test-delete-template
              {{on "click" (fn this.openDelete template)}}
            />
          </div>
        </Nuvo::Card>
      {{/each}}
    </div>
  {{else}}
    <Nuvo::Card class="text-center">
      <Ui::Ph @icon="envelope-simple" @size="48px" @color="var(--text-muted)" />
      <p class="text-muted mt-3">No email templates yet. Create your first
        template above.</p>
    </Nuvo::Card>
  {{/if}}
</div>

<Nuvo::Modal
  @open={{this.showModal}}
  @title={{if this.editTemplate "Edit Template" "New Template"}}
  @onClose={{this.closeModal}}
>
  <form class="flex col gap-4" {{on "submit" this.saveTemplate}}>
    <div class="flex gap-4">
      <Nuvo::Field class="grow" @label="Template Name" @required={{true}}>
        <Nuvo::Input
          id="t-name"
          type="text"
          placeholder="Welcome New Tenant"
          @value={{this.formName}}
          @onInput={{fn this.setFieldValue "formName"}}
          required={{true}}
          data-test-input-name
        />
      </Nuvo::Field>
      <Nuvo::Field class="grow" @label="Category">
        <Nuvo::Dropdown
          id="t-category"
          @align="start"
          @value={{this.formCategory}}
          @onSelect={{fn this.setFieldValue "formCategory"}}
          @options={{this.categories}}
          @placeholder="Select category..."
          data-test-input-category
        />
      </Nuvo::Field>
    </div>

    <Nuvo::Field @label="Subject" @required={{true}}>
      <Nuvo::Input
        id="t-subject"
        type="text"
        placeholder="Welcome to your new home!"
        @value={{this.formSubject}}
        @onInput={{fn this.setFieldValue "formSubject"}}
        required={{true}}
        data-test-input-subject
      />
    </Nuvo::Field>

    <Nuvo::Field @label="Body (HTML)" @required={{true}}>
      <Nuvo::Textarea
        id="t-body"
        placeholder="Use curly braces for variables, e.g. first name"
        rows="8"
        @value={{this.formBody}}
        @onInput={{fn this.setFieldValue "formBody"}}
        required={{true}}
        data-test-input-body
      />
    </Nuvo::Field>

    <Nuvo::Field
      @label="Variables (comma-separated)"
      @hint="Use double curly braces in subject/body to reference variables."
    >
      <Nuvo::Input
        id="t-vars"
        type="text"
        placeholder="firstName, lastName, propertyName"
        @value={{this.formVariables}}
        @onInput={{fn this.setFieldValue "formVariables"}}
        data-test-input-variables
      />
    </Nuvo::Field>

    <Nuvo::Checkbox
      @checked={{this.formIsActive}}
      @label="Active"
      @onChange={{fn this.setFieldValue "formIsActive"}}
      data-test-input-active
    />

    {{#if this.errorMsg}}
      <p class="text-sm text-danger" data-test-error>{{this.errorMsg}}</p>
    {{/if}}

    <Nuvo::FormActions @align="end">
      <Nuvo::Button
        @variant="secondary"
        @onClick={{this.closeModal}}
      >Cancel</Nuvo::Button>
      <Nuvo::Button
        @variant="primary"
        @type="submit"
        @loading={{this.isSaving}}
        data-test-save-template
      >{{if
          this.isSaving
          "Saving..."
          (if this.editTemplate "Update" "Create Template")
        }}</Nuvo::Button>
    </Nuvo::FormActions>
  </form>
</Nuvo::Modal>

<Nuvo::Modal
  @open={{this.showPreview}}
  @title="Template Preview"
  @onClose={{this.closePreview}}
>
  <div class="flex col gap-3">
    <div class="flex col gap-1">
      <p class="text-sm text-muted">Subject:</p>
      <p class="font-bold">{{this.previewSubject}}</p>
    </div>
    {{#if this.previewVars}}
      <p class="text-xs text-muted">Variables: {{this.previewVars}}</p>
    {{/if}}
    <div class="flex col gap-1">
      <p class="text-sm text-muted">Body:</p>
      <pre
        class="p-4 rounded-lg border text-xs whitespace-pre-wrap"
        data-test-preview-body
      >{{this.previewBody}}</pre>
    </div>
  </div>
  <Nuvo::FormActions @align="end">
    <Nuvo::Button
      @variant="secondary"
      {{on "click" this.closePreview}}
    >Close</Nuvo::Button>
  </Nuvo::FormActions>
</Nuvo::Modal>

<ConfirmModal
  @open={{this.showDeleteModal}}
  @title="Delete Template"
  @message="Are you sure you want to delete {{this.templateToDelete.name}}? This action cannot be undone."
  @confirmText="Delete"
  @cancelText="Cancel"
  @confirmVariant="danger"
  @isConfirming={{this.isDeleting}}
  @confirmingText="Deleting..."
  @onClose={{this.closeDeleteModal}}
  @onConfirm={{this.confirmDelete}}
/>
