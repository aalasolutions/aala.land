{{page-title "Email Templates"}}

<div data-test-email-templates class="flex col gap-6">
  <Woven::PageHeader
    @title="Email Templates"
    @subtitle="Reusable email content for client communication."
  >
    <:meta>
      <p class="text-muted">{{format-number @model.total unit="template"}}</p>
    </:meta>
    <:actions>
      <Woven::Button
        @variant="primary"
        @icon="plus"
        data-test-new-template
        {{on "click" this.openCreate}}
      >
        New Template
      </Woven::Button>
    </:actions>
  </Woven::PageHeader>

  <div class="flex gap-3">
    <Woven::Dropdown
      id="email-template-category-filter"
      @align="start"
      @value={{this.category}}
      @onSelect={{this.filterCategory}}
      @options={{this.filterCategories}}
      @placeholder="All Categories"
      data-test-category-filter
    />
  </div>

  {{#if @model.templates.length}}
    <div class="grid cols-2 gap-4">
      {{#each @model.templates as |template|}}
        <Woven::Card data-test-template-card class="flex col gap-3">
          <div class="flex between x-center">
            <div class="flex x-center gap-2">
              <Ui::Ph @icon="envelope-simple" />
              <h4 class="font-bold">{{template.name}}</h4>
            </div>
            <div class="flex gap-1 x-center">
              {{#unless template.isActive}}
                <Woven::Tag class="tag-enabled-inactive" @text="Inactive" />
              {{/unless}}
              <Woven::Tag
                class="tag-email-{{lowercase template.category}}"
                @text={{template.category}}
              />
            </div>
          </div>
          <p class="text-muted text-sm">Subject: {{template.subject}}</p>
          {{#if template.variables.length}}
            <div class="flex gap-1 wrap">
              {{#each template.variables as |v|}}
                <Woven::Tag @text={{v}} />
              {{/each}}
            </div>
          {{/if}}
          <div class="flex gap-2 email-template-card__actions">
            <Woven::Button
              @variant="secondary"
              @size="sm"
              @icon="eye"
              data-test-preview-template
              {{on "click" (fn this.openPreview template)}}
            >
              Preview
            </Woven::Button>
            <Woven::Button
              @variant="secondary"
              @size="sm"
              @icon="pencil-simple"
              data-test-edit-template
              {{on "click" (fn this.openEdit template)}}
            >
              Edit
            </Woven::Button>
            <Woven::Button
              @variant="danger"
              @size="sm"
              @icon="trash"
              data-test-delete-template
              {{on "click" (fn this.openDelete template)}}
            />
          </div>
        </Woven::Card>
      {{/each}}
    </div>
  {{else}}
    <Woven::Card class="text-center">
      <Ui::Ph @icon="envelope-simple" @size="48px" @color="var(--wu-text-muted)" />
      <p class="text-muted mt-3">No email templates yet. Create your first
        template above.</p>
    </Woven::Card>
  {{/if}}
</div>

<EmailTemplates::TemplateDrawer
  @open={{this.showModal}}
  @template={{this.editTemplate}}
  @onClose={{this.closeModal}}
  @onClosed={{this.resetDrawer}}
  @onSaved={{this.refresh}}
/>

<Woven::Modal
  @open={{this.showPreview}}
  @title="Template Preview"
  @onClose={{this.closePreview}}
>
  <div class="flex col gap-3">
    <div class="flex col gap-1">
      <p class="text-sm text-muted">Subject:</p>
      <p class="font-bold">{{this.previewSubject}}</p>
    </div>
    {{#if this.previewVars}}
      <p class="text-xs text-muted">Variables: {{this.previewVars}}</p>
    {{/if}}
    <div class="flex col gap-1">
      <p class="text-sm text-muted">Body:</p>
      <pre
        class="p-4 rounded-lg border text-xs whitespace-pre-wrap"
        data-test-preview-body
      >{{this.previewBody}}</pre>
    </div>
  </div>
  <Woven::FormActions @align="end">
    <Woven::Button
      @variant="secondary"
      {{on "click" this.closePreview}}
    >Close</Woven::Button>
  </Woven::FormActions>
</Woven::Modal>

<ConfirmModal
  @open={{this.showDeleteModal}}
  @title="Delete Template"
  @message="Delete {{this.templateToDelete.name}}? This cannot be undone."
  @confirmText="Delete"
  @confirmVariant="danger"
  @isConfirming={{this.isDeleting}}
  @confirmingText="Deleting..."
  @onClose={{this.closeDeleteModal}}
  @onConfirm={{this.confirmDelete}}
/>
