{{page-title "AALA.LAND"}}

{{#if this.session.isAuthenticated}}
  <div
    class="app-shell {{if this.desktopCollapsed 'is-collapsed'}}"
  >
    {{! Sidebar }}
    <aside
      class="nu-sidebar m-plain
        {{if this.desktopCollapsed 'is-collapsed'}}
        {{if this.sidebarMobileOpen 'is-open'}}"
      data-test-sidebar
    >
      <div class="nu-sidebar__brand">
        <img src="/logo.png" alt="AALA.LAND" class="app-shell__brand-mark" />
        <div class="app-shell__brand-text">
          <h1 class="nu-sidebar__brand-title">AALA<span
              class="app-shell__brand-dot"
            >.</span>LAND</h1>
          <p class="nu-sidebar__brand-subtitle">Property Management</p>
        </div>
      </div>

      <nav data-test-sidebar-nav class="nu-sidebar__nav">
        {{! Dashboard (direct link) }}
        <LinkTo @route="dashboard" class="nu-sidebar__link" data-test-nav-dashboard>
          <Ui::Ph @icon="gauge" />
          <span class="nu-sidebar__link-label">Dashboard</span>
        </LinkTo>

        {{! Properties Group }}
        {{#if this.sidebarGroups.properties}}
          <div
            class="nu-sidebar__group
              {{if
                (or
                  (eq this.expandedGroup 'properties')
                  (eq this.activeGroup 'properties')
                )
                'is-expanded'
              }}"
          >
            <button
              type="button"
              class="nu-sidebar__group-toggle
                {{if
                  (eq this.activeGroup 'properties')
                  'is-active'
                }}"
              {{on "click" (fn this.toggleGroup "properties")}}
            >
              <Ui::Ph @icon="buildings" />
              <span class="nu-sidebar__link-label">Properties</span>
              <Ui::Ph @icon="caret-down" class="nu-sidebar__chevron" />
            </button>
            <div class="nu-sidebar__group-items">
              <div>
                <LinkTo
                  @route="properties"
                  class="nu-sidebar__sublink"
                  data-test-nav-properties
                >
                  <span class="nu-sidebar__link-label">All Properties</span>
                </LinkTo>
                <LinkTo
                  @route="owners"
                  class="nu-sidebar__sublink"
                  data-test-nav-owners
                >
                  <span class="nu-sidebar__link-label">Owners</span>
                </LinkTo>
                <LinkTo
                  @route="leases"
                  class="nu-sidebar__sublink"
                  data-test-nav-leases
                >
                  <span class="nu-sidebar__link-label">Leases</span>
                </LinkTo>
              </div>
            </div>
          </div>
        {{/if}}

        {{! Leads / CRM Group }}
        {{#if this.sidebarGroups.crm}}
          <div
            class="nu-sidebar__group
              {{if
                (or (eq this.expandedGroup 'crm') (eq this.activeGroup 'crm'))
                'is-expanded'
              }}"
          >
            <button
              type="button"
              class="nu-sidebar__group-toggle
                {{if (eq this.activeGroup 'crm') 'is-active'}}"
              {{on "click" (fn this.toggleGroup "crm")}}
            >
              <Ui::Ph @icon="funnel" />
              <span class="nu-sidebar__link-label">Leads</span>
              <Ui::Ph @icon="caret-down" class="nu-sidebar__chevron" />
            </button>
            <div class="nu-sidebar__group-items">
              <div>
                <LinkTo
                  @route="leads"
                  class="nu-sidebar__sublink"
                  data-test-nav-leads
                >
                  <span class="nu-sidebar__link-label">Pipeline</span>
                </LinkTo>
                <LinkTo
                  @route="contacts"
                  class="nu-sidebar__sublink"
                  data-test-nav-contacts
                >
                  <span class="nu-sidebar__link-label">Contacts</span>
                </LinkTo>
              </div>
            </div>
          </div>
        {{/if}}

        {{! Documents (direct link) }}
        {{#if this.sidebarGroups.documents}}
          <LinkTo
            @route="documents"
            class="nu-sidebar__link"
            data-test-nav-documents
          >
            <Ui::Ph @icon="files" />
            <span class="nu-sidebar__link-label">Documents</span>
          </LinkTo>
        {{/if}}

        {{! Finance Group }}
        {{#if this.sidebarGroups.finance}}
          <div
            class="nu-sidebar__group
              {{if
                (or
                  (eq this.expandedGroup 'finance')
                  (eq this.activeGroup 'finance')
                )
                'is-expanded'
              }}"
          >
            <button
              type="button"
              class="nu-sidebar__group-toggle
                {{if (eq this.activeGroup 'finance') 'is-active'}}"
              {{on "click" (fn this.toggleGroup "finance")}}
            >
              <Ui::Ph @icon="currency-circle-dollar" />
              <span class="nu-sidebar__link-label">Finance</span>
              <Ui::Ph @icon="caret-down" class="nu-sidebar__chevron" />
            </button>
            <div class="nu-sidebar__group-items">
              <div>
                <LinkTo
                  @route="financials"
                  class="nu-sidebar__sublink"
                  data-test-nav-financials
                >
                  <span class="nu-sidebar__link-label">Transactions</span>
                </LinkTo>
                <LinkTo
                  @route="cheques"
                  class="nu-sidebar__sublink"
                  data-test-nav-cheques
                >
                  <span class="nu-sidebar__link-label">Cheques</span>
                </LinkTo>
                <LinkTo
                  @route="commissions"
                  class="nu-sidebar__sublink"
                  data-test-nav-commissions
                >
                  <span class="nu-sidebar__link-label">Commissions</span>
                </LinkTo>
              </div>
            </div>
          </div>
        {{/if}}

        {{! WhatsApp (direct link) }}
        {{#if this.sidebarGroups.outreach}}
          <LinkTo @route="whatsapp" class="nu-sidebar__link" data-test-nav-whatsapp>
            <Ui::Ph @icon="whatsapp-logo" />
            <span class="nu-sidebar__link-label">WhatsApp</span>
          </LinkTo>
        {{/if}}

        {{! Operations Group }}
        {{#if this.sidebarGroups.operations}}
          <div
            class="nu-sidebar__group
              {{if
                (or
                  (eq this.expandedGroup 'operations')
                  (eq this.activeGroup 'operations')
                )
                'is-expanded'
              }}"
          >
            <button
              type="button"
              class="nu-sidebar__group-toggle
                {{if
                  (eq this.activeGroup 'operations')
                  'is-active'
                }}"
              {{on "click" (fn this.toggleGroup "operations")}}
            >
              <Ui::Ph @icon="wrench" />
              <span class="nu-sidebar__link-label">Operations</span>
              <Ui::Ph @icon="caret-down" class="nu-sidebar__chevron" />
            </button>
            <div class="nu-sidebar__group-items">
              <div>
                <LinkTo
                  @route="maintenance"
                  class="nu-sidebar__sublink"
                  data-test-nav-maintenance
                >
                  <span class="nu-sidebar__link-label">Maintenance</span>
                </LinkTo>
                <LinkTo
                  @route="vendors"
                  class="nu-sidebar__sublink"
                  data-test-nav-vendors
                >
                  <span class="nu-sidebar__link-label">Vendors</span>
                </LinkTo>
              </div>
            </div>
          </div>
        {{/if}}

        {{! Reports (direct link) }}
        {{#if this.sidebarGroups.reports}}
          <LinkTo @route="reports" class="nu-sidebar__link" data-test-nav-reports>
            <Ui::Ph @icon="chart-bar" />
            <span class="nu-sidebar__link-label">Reports</span>
          </LinkTo>
        {{/if}}

        {{! Team (direct link for Company Admin and Admin) }}
        {{#if this.sidebarGroups.team}}
          {{#unless this.isSuperAdmin}}
            <LinkTo @route="team" class="nu-sidebar__link" data-test-nav-team>
              <Ui::Ph @icon="users-three" />
              <span class="nu-sidebar__link-label">Team</span>
            </LinkTo>
          {{/unless}}
        {{/if}}

        {{! Admin Group (Super Admin only) }}
        {{#if this.sidebarGroups.admin}}
          <div
            class="nu-sidebar__group
              {{if
                (or
                  (eq this.expandedGroup 'admin') (eq this.activeGroup 'admin')
                )
                'is-expanded'
              }}"
          >
            <button
              type="button"
              class="nu-sidebar__group-toggle
                {{if (eq this.activeGroup 'admin') 'is-active'}}"
              {{on "click" (fn this.toggleGroup "admin")}}
            >
              <Ui::Ph @icon="gear" />
              <span class="nu-sidebar__link-label">Admin</span>
              <Ui::Ph @icon="caret-down" class="nu-sidebar__chevron" />
            </button>
            <div class="nu-sidebar__group-items">
              <div>
                <LinkTo
                  @route="admin.overview"
                  class="nu-sidebar__sublink"
                  data-test-nav-overview
                >
                  <span class="nu-sidebar__link-label">Overview</span>
                </LinkTo>
                <LinkTo
                  @route="admin.companies"
                  class="nu-sidebar__sublink"
                  data-test-nav-companies
                >
                  <span class="nu-sidebar__link-label">Companies</span>
                </LinkTo>
                <LinkTo
                  @route="admin.marketers"
                  class="nu-sidebar__sublink"
                  data-test-nav-marketers
                >
                  <span class="nu-sidebar__link-label">Marketers</span>
                </LinkTo>
                <LinkTo @route="team" class="nu-sidebar__sublink" data-test-nav-team>
                  <span class="nu-sidebar__link-label">Team</span>
                </LinkTo>
                <LinkTo
                  @route="documents"
                  class="nu-sidebar__sublink"
                  data-test-nav-documents
                >
                  <span class="nu-sidebar__link-label">Documents</span>
                </LinkTo>
                <LinkTo
                  @route="audit"
                  class="nu-sidebar__sublink"
                  data-test-nav-audit
                >
                  <span class="nu-sidebar__link-label">Audit Log</span>
                </LinkTo>
                <LinkTo
                  @route="admin.system"
                  class="nu-sidebar__sublink"
                  data-test-nav-system
                >
                  <span class="nu-sidebar__link-label">System</span>
                </LinkTo>
              </div>
            </div>
          </div>
        {{/if}}
      </nav>

      <div class="app-shell__spacer"></div>

      {{! Collapse toggle }}
      <button
        type="button"
        class="app-shell__collapse"
        aria-label="Toggle sidebar"
        {{on "click" this.toggleSidebar}}
      >
        <Ui::Ph
          @icon={{if
            this.sidebarRailed
            "caret-double-right"
            "caret-double-left"
          }}
        />
      </button>
    </aside>

    {{#if this.sidebarMobileOpen}}
      <button
        type="button"
        class="nu-sidebar-backdrop"
        aria-label="Close menu"
        data-test-sidebar-backdrop
        {{on "click" this.closeMobileSidebar}}
      ></button>
    {{/if}}

    {{! Main Content }}
    <main class="app-shell__main">
      {{#if this.session.isImpersonating}}
        <div class="impersonation-banner" data-test-impersonation-banner>
          <span>
            Impersonating
            <strong>{{this.session.data.authenticated.user.name}}</strong>
            ({{this.session.data.authenticated.user.email}})
          </span>
          <button
            type="button"
            class="btn btn-warning btn-sm"
            data-test-exit-impersonation
            {{on "click" this.exitImpersonation}}
          >
            Exit Impersonation
          </button>
        </div>
      {{/if}}
      <TenantLockBanner @lockState={{this.session.lockState}} />
      {{! Top Bar }}
      <header class="nu-topbar m-sticky m-plain">
        <button
          type="button"
          class="nu-topbar__toggle"
          aria-label="Open navigation"
          aria-expanded={{if this.sidebarMobileOpen "true" "false"}}
          data-test-nav-toggle
          {{on "click" this.toggleSidebar}}
        >
          <Ui::Ph @icon="list" @size="20px" />
        </button>
        <div class="nu-topbar__search">
          <input
            type="text"
            autocomplete="off"
            aria-label="Search"
            placeholder="Search..."
            class="nu-topbar__search-input"
            aria-autocomplete="list"
            aria-haspopup="listbox"
            aria-expanded={{if this.showSearchDropdown "true" "false"}}
            aria-controls="search-results"
            aria-activedescendant={{this.activeSearchResultId}}
            value={{this.searchQuery}}
            {{on "input" this.onSearchInput}}
            {{on "keydown" this.onSearchKeydown}}
          />
          {{#if this.showSearchDropdown}}
            <SearchDropdown
              @results={{this.searchResults}}
              @isSearching={{this.isSearching}}
              @onSelect={{this.onSearchSelect}}
              @activeIndex={{this.activeSearchIndex}}
            />
          {{/if}}
        </div>
        {{#if this.showSearchDropdown}}
          <div
            class="search-overlay"
            tabindex="-1"
            aria-hidden="true"
            {{on "click" this.closeSearch}}
          ></div>
        {{/if}}
        <div class="nu-topbar__actions">
          {{#if this.showRegionSwitcher}}
            <div class="region-switcher" data-test-region-switcher>
              <button
                type="button"
                class="app-shell__region-btn"
                {{on "click" this.toggleRegionDropdown}}
              >
                <Ui::Ph @icon="globe" @size="18px" />
                <span
                  class="region-name"
                >{{this.region.activeRegion.name}}</span>
                <Ui::Ph @icon="caret-down" @size="12px" />
              </button>
              {{#if this.showRegionDropdown}}
                <button
                  type="button"
                  class="region-overlay"
                  {{on "click" this.closeRegionDropdown}}
                ></button>
                <div class="nu-topbar-menu" data-test-region-dropdown>
                  {{#each this.groupedRegions as |grp|}}
                    <div
                      class="app-shell__menu-label"
                      data-test-region-group={{grp.countryName}}
                    >{{grp.countryName}}</div>
                    {{#each grp.regions as |r|}}
                      <button
                        type="button"
                        class="nu-topbar-menu__item
                          {{if
                            (eq r.code this.region.activeRegion.code)
                            'is-active'
                          }}"
                        data-test-region-option={{r.code}}
                        {{on "click" (fn this.selectRegion r)}}
                      >
                        <span>{{r.name}}</span>
                        <span class="region-currency-tag">{{r.currency}}</span>
                      </button>
                    {{/each}}
                  {{/each}}
                </div>
              {{/if}}
            </div>
          {{else if this.showRegionLabel}}
            <div class="region-label" data-test-region-label>
              <Ui::Ph @icon="globe" @size="18px" />
              <span class="region-name">{{this.region.activeRegion.name}}</span>
            </div>
          {{/if}}
          <div class="notification-wrapper">
            <button
              type="button"
              class="nu-topbar__icon-btn"
              aria-label="Notifications"
              {{on "click" this.toggleNotifications}}
            >
              <Ui::Ph @icon="bell" @size="22px" />
              {{#if this.unreadCount}}
                <span class="nu-topbar__badge">{{this.unreadCount}}</span>
              {{/if}}
            </button>

            {{#if this.showNotifications}}
              <button
                type="button"
                class="notification-overlay"
                aria-label="Close notifications"
                {{on "click" this.closeNotifications}}
              ></button>
              <div class="nu-topbar-menu">
                <div class="nu-topbar-menu__header">
                  <span class="text-sm font-bold">Notifications</span>
                  {{#if this.unreadCount}}
                    <button
                      type="button"
                      class="btn-link text-xs"
                      {{on "click" this.markAllRead}}
                    >Mark all read</button>
                  {{/if}}
                </div>
                <div class="app-shell__menu-list">
                  {{#each this.notifications as |notif|}}
                    <button
                      type="button"
                      class="nu-topbar-menu__item
                        {{unless notif.isRead 'unread'}}"
                      {{on "click" (fn this.markAsRead notif)}}
                    >
                      <div class="notification-icon {{notif.type}}">
                        <Ui::Ph
                          @icon={{get-notification-icon notif.type}}
                          @size="18px"
                        />
                      </div>
                      <div class="notification-content">
                        <span class="notification-title">{{notif.title}}</span>
                        <span
                          class="notification-message"
                        >{{notif.message}}</span>
                        <span class="notification-time">{{format-date-time
                            notif.createdAt
                          }}</span>
                      </div>
                    </button>
                  {{else}}
                    <div class="nu-topbar-menu__empty">
                      <Ui::Ph
                        @icon="bell-slash"
                        @size="24px"
                        @color="var(--text-muted)"
                      />
                      <p class="text-xs text-muted mt-2">No notifications</p>
                    </div>
                  {{/each}}
                </div>
              </div>
            {{/if}}
          </div>
          {{#unless this.isSuperAdmin}}
            <LinkTo
              @route="company"
              class="nu-topbar__icon-btn"
              aria-label="Company settings"
            >
              <Ui::Ph @icon="building-office" @size="20px" />
            </LinkTo>
          {{/unless}}
          <LinkTo
            @route="profile"
            class="nu-topbar__icon-btn"
            aria-label="My profile"
          >
            <Ui::Ph @icon="user" @size="20px" />
          </LinkTo>
          <button
            data-test-logout-button
            type="button"
            class="nu-topbar__icon-btn topbar-logout"
            aria-label="Logout"
            {{on "click" this.logout}}
          >
            <Ui::Ph @icon="sign-out" @size="20px" />
          </button>
        </div>
      </header>

      {{! Route Outlet }}
      <section class="content-area">
        {{outlet}}
      </section>
    </main>
  </div>
{{else}}
  {{outlet}}
{{/if}}

<Nuvo::ToastRegion />

<ConfirmModal
  @open={{this.showLogoutModal}}
  @title="Logout"
  @message="Are you sure you want to logout?"
  @confirmText="Logout"
  @cancelText="Cancel"
  @confirmVariant="danger"
  @onClose={{this.closeLogoutModal}}
  @onConfirm={{this.confirmLogout}}
/>