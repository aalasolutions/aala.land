{{page-title "AALA.LAND"}}

{{#if this.session.isAuthenticated}}
  <div class="app-shell">
    <Woven::Sidebar
      @pinned={{true}}
      @animated={{true}}
      @collapsed={{this.desktopCollapsed}}
      @dismissible={{true}}
      @open={{this.sidebarMobileOpen}}
      @onDismiss={{this.closeMobileSidebar}}
      data-test-sidebar
    >
      <:brand>
        <LinkTo
          @route="profile"
          class="app-shell__user-full"
          aria-label="My profile: {{this.session.data.authenticated.user.name}}, {{format-role
            this.session.data.authenticated.user.role
          }}"
          data-test-sidebar-user
        >
          <Woven::Avatar
            @initials={{initials this.session.data.authenticated.user.name}}
          />
          <span class="app-shell__user-details" aria-hidden="true">
            <span
              class="app-shell__user-name"
              data-test-sidebar-user-name
            >{{this.session.data.authenticated.user.name}}</span>
            <span
              class="app-shell__user-role"
              data-test-sidebar-user-role
            >{{format-role this.session.data.authenticated.user.role}}</span>
          </span>
        </LinkTo>

        <div class="app-shell__user-compact">
          <Woven::Popover
            @placement="end"
            @open={{this.userMenuOpen}}
            @onToggle={{this.setUserMenuOpen}}
            @onClose={{this.closeUserMenu}}
          >
            <:trigger as |toggle|>
              <button
                type="button"
                class="app-shell__user-trigger"
                aria-label="Account: {{this.session.data.authenticated.user.name}}"
                aria-expanded={{if this.userMenuOpen "true" "false"}}
                data-test-sidebar-user-trigger
                {{on "click" toggle}}
              >
                <Woven::Avatar
                  @initials={{initials this.session.data.authenticated.user.name}}
                />
              </button>
            </:trigger>
            <:body>
              <div class="app-shell__user-menu" data-test-sidebar-user-menu>
                <p
                  class="app-shell__user-menu-name"
                >{{this.session.data.authenticated.user.name}}</p>
                <p class="app-shell__user-menu-meta">{{format-role
                    this.session.data.authenticated.user.role
                  }}</p>
                <p
                  class="app-shell__user-menu-meta"
                >{{this.session.data.authenticated.user.email}}</p>
                <LinkTo
                  @route="profile"
                  class="app-shell__user-menu-link"
                  data-test-sidebar-user-profile
                  {{on "click" this.closeUserMenu}}
                >My profile</LinkTo>
              </div>
            </:body>
          </Woven::Popover>
        </div>
      </:brand>
      <:default>
        <ul class="wu-sidebar-list" data-test-sidebar-nav>
          <Shell::NavLink
            @route="dashboard"
            @icon="gauge"
            @label="Dashboard"
            @current={{this.isNavCurrent "dashboard"}}
            data-test-nav-dashboard
          />

          {{#if this.sidebarGroups.properties}}
            <Shell::NavGroup
              @group="properties"
              @icon="buildings"
              @label="Properties"
              @open={{this.isGroupOpen "properties"}}
              @onToggle={{fn this.toggleGroup "properties" "properties"}}
            >
              <Shell::NavLink
                @route="properties"
                @icon="house-line"
                @label="All Properties"
                @current={{this.isNavCurrent "properties"}}
                data-test-nav-properties
              />
              <Shell::NavLink
                @route="leases"
                @icon="file-text"
                @label="Leases"
                @current={{this.isNavCurrent "leases"}}
                data-test-nav-leases
              />
            </Shell::NavGroup>
          {{/if}}

          {{#if this.sidebarGroups.crm}}
            <Shell::NavGroup
              @group="crm"
              @icon="address-book"
              @label="People"
              @open={{this.isGroupOpen "crm"}}
              @onToggle={{fn this.toggleGroup "crm" "contacts"}}
            >
              <Shell::NavLink
                @route="contacts"
                @icon="users"
                @label="Contacts"
                @current={{this.isNavCurrent "contacts"}}
                data-test-nav-contacts
              />
              <Shell::NavLink
                @route="leads"
                @icon="kanban"
                @label="Lead Pipeline"
                @current={{this.isNavCurrent "leads"}}
                data-test-nav-leads
              />
              {{#if this.sidebarGroups.accessRequests}}
                <Shell::NavLink
                  @route="access-requests"
                  @icon="key"
                  @label="Access Requests"
                  @current={{this.isNavCurrent "access-requests"}}
                  data-test-nav-access-requests
                >
                  {{#if this.pendingAccessCount}}
                    <Woven::Badge
                      @count={{true}}
                      @value={{this.pendingAccessCount}}
                      @max={{99}}
                      data-test-nav-access-requests-pending
                    />
                  {{/if}}
                </Shell::NavLink>
              {{/if}}
            </Shell::NavGroup>
          {{/if}}

          {{#if this.sidebarGroups.documents}}
            <Shell::NavLink
              @route="documents"
              @icon="files"
              @label="Documents"
              @current={{this.isNavCurrent "documents"}}
              data-test-nav-documents
            />
          {{/if}}

          {{#if this.sidebarGroups.finance}}
            <Shell::NavGroup
              @group="finance"
              @icon="currency-circle-dollar"
              @label="Finance"
              @open={{this.isGroupOpen "finance"}}
              @onToggle={{fn this.toggleGroup "finance" "financials"}}
            >
              <Shell::NavLink
                @route="financials"
                @icon="receipt"
                @label="Transactions"
                @current={{this.isNavCurrent "financials"}}
                data-test-nav-financials
              />
              <Shell::NavLink
                @route="cheques"
                @icon="money"
                @label="Cheques Received"
                @current={{this.isNavCurrent "cheques"}}
                data-test-nav-cheques
              />
              <Shell::NavLink
                @route="commissions"
                @icon="percent"
                @label="Commissions"
                @current={{this.isNavCurrent "commissions"}}
                data-test-nav-commissions
              />
            </Shell::NavGroup>
          {{/if}}

          {{#if this.sidebarGroups.outreach}}
            {{#if this.whatsappDisabled}}
              <li>
                <span
                  class="wu-sidebar-link"
                  role="link"
                  aria-disabled="true"
                  tabindex="0"
                  data-tooltip={{this.whatsappTooltip}}
                  data-tooltip-position="end"
                  data-tooltip-light
                  data-test-nav-whatsapp
                  data-test-nav-whatsapp-disabled
                >
                  <Ui::Ph @icon="whatsapp-logo" />
                  <span class="wu-sidebar-label">WhatsApp</span>
                </span>
              </li>
            {{else}}
              <Shell::NavLink
                @route="whatsapp"
                @icon="whatsapp-logo"
                @label="WhatsApp"
                @current={{this.isNavCurrent "whatsapp"}}
                data-test-nav-whatsapp
              >
                {{#if this.whatsappUnreadCount}}
                  <Woven::Badge
                    @count={{true}}
                    @value={{this.whatsappUnreadCount}}
                    @max={{99}}
                    data-test-nav-whatsapp-unread
                  />
                {{/if}}
              </Shell::NavLink>
            {{/if}}
          {{/if}}

          {{#if this.sidebarGroups.operations}}
            <Shell::NavGroup
              @group="operations"
              @icon="wrench"
              @label="Operations"
              @open={{this.isGroupOpen "operations"}}
              @onToggle={{fn this.toggleGroup "operations" "maintenance"}}
            >
              <Shell::NavLink
                @route="maintenance"
                @icon="toolbox"
                @label="Maintenance"
                @current={{this.isNavCurrent "maintenance"}}
                data-test-nav-maintenance
              />
              <Shell::NavLink
                @route="vendors"
                @icon="storefront"
                @label="Vendors"
                @current={{this.isNavCurrent "vendors"}}
                data-test-nav-vendors
              />
            </Shell::NavGroup>
          {{/if}}

          {{#if this.sidebarGroups.reports}}
            <Shell::NavLink
              @route="reports"
              @icon="chart-bar"
              @label="Reports"
              @current={{this.isNavCurrent "reports"}}
              data-test-nav-reports
            />
          {{/if}}

          {{#if this.sidebarGroups.team}}
            {{#unless this.isSuperAdmin}}
              <Shell::NavLink
                @route="team"
                @icon="users-three"
                @label="Team"
                @current={{this.isNavCurrent "team"}}
                data-test-nav-team
              />
            {{/unless}}
          {{/if}}

          {{#if this.sidebarGroups.history}}
            {{#unless this.isSuperAdmin}}
              <Shell::NavLink
                @route="history"
                @icon="clock-counter-clockwise"
                @label="History"
                @current={{this.isNavCurrent "history"}}
                data-test-nav-history
              />
            {{/unless}}
          {{/if}}

          {{#if this.sidebarGroups.admin}}
            <Shell::NavGroup
              @group="admin"
              @icon="gear"
              @label="Admin"
              @open={{this.isGroupOpen "admin"}}
              @onToggle={{fn this.toggleGroup "admin" "admin.overview"}}
            >
              <Shell::NavLink
                @route="admin.overview"
                @icon="squares-four"
                @label="Overview"
                @current={{this.isNavCurrent "admin.overview"}}
                data-test-nav-overview
              />
              <Shell::NavLink
                @route="admin.companies"
                @icon="buildings"
                @label="Companies"
                @current={{this.isNavCurrent "admin.companies"}}
                data-test-nav-companies
              />
              <Shell::NavLink
                @route="admin.marketers"
                @icon="megaphone"
                @label="Marketers"
                @current={{this.isNavCurrent "admin.marketers"}}
                data-test-nav-marketers
              />
              <Shell::NavLink
                @route="team"
                @icon="users-three"
                @label="Team"
                @current={{this.isNavCurrent "team"}}
                data-test-nav-team
              />
              <Shell::NavLink
                @route="documents"
                @icon="files"
                @label="Documents"
                @current={{this.isNavCurrent "documents"}}
                data-test-nav-documents
              />
              <Shell::NavLink
                @route="audit"
                @icon="list-checks"
                @label="Audit Log"
                @current={{this.isNavCurrent "audit"}}
                data-test-nav-audit
              />
              <Shell::NavLink
                @route="admin.system"
                @icon="sliders"
                @label="System"
                @current={{this.isNavCurrent "admin.system"}}
                data-test-nav-system
              />
            </Shell::NavGroup>
          {{/if}}
        </ul>
      </:default>
      <:footer>
        <button
          type="button"
          class="wu-sidebar-link"
          aria-label="Toggle sidebar"
          data-test-sidebar-collapse
          {{on "click" this.toggleSidebar}}
        >
          <Ui::Ph
            @icon={{if
              this.sidebarRailed
              "caret-double-right"
              "caret-double-left"
            }}
          />
        </button>
      </:footer>
    </Woven::Sidebar>

    {{! tabindex so a dialog can hand focus back here when its trigger is gone. }}
    <main class="app-shell__main" tabindex="-1">
      {{#if this.session.isImpersonating}}
        <Woven::Alert
          @variant="warning"
          role="status"
          class="impersonation-banner"
          data-test-impersonation-banner
        >
          <:default>
            <p>
              Impersonating
              <strong>{{this.session.data.authenticated.user.name}}</strong>
              ({{this.session.data.authenticated.user.email}})
            </p>
          </:default>
          <:actions>
            <Woven::Button
              @variant="subtle"
              @size="sm"
              data-test-exit-impersonation
              {{on "click" this.exitImpersonation}}
            >
              Exit Impersonation
            </Woven::Button>
          </:actions>
        </Woven::Alert>
      {{/if}}
      <TenantLockBanner @lockState={{this.session.lockState}} />
      <header class="wu-topbar">
        <Woven::Button
          @variant="ghost"
          @shape="square"
          @icon="list"
          class="hidden@md"
          aria-label="Open navigation"
          aria-expanded={{if this.sidebarMobileOpen "true" "false"}}
          data-test-nav-toggle
          @onClick={{this.toggleSidebar}}
        />
        {{!-- Global search hidden until it covers contacts, leads and units.
        <div class="wu-topbar__search">
          {{! Explicit combobox is the ARIA pattern for a text box that owns a listbox. }}
          {{! template-lint-disable no-redundant-role }}
          <input
            type="text"
            role="combobox"
            autocomplete="off"
            aria-label="Search"
            placeholder="Search..."
            class="wu-topbar__search-input"
            aria-autocomplete="list"
            data-test-global-search
            aria-expanded={{if this.showSearchDropdown "true" "false"}}
            aria-controls="search-results"
            aria-activedescendant={{this.activeSearchResultId}}
            value={{this.searchQuery}}
            {{on "input" this.onSearchInput}}
            {{on "keydown" this.onSearchKeydown}}
          />
          {{! template-lint-enable no-redundant-role }}
          {{#if this.showSearchDropdown}}
            <SearchDropdown
              @results={{this.searchResults}}
              @isSearching={{this.isSearching}}
              @onSelect={{this.onSearchSelect}}
              @activeIndex={{this.activeSearchIndex}}
            />
          {{/if}}
        </div>
        {{#if this.showSearchDropdown}}
          <button
            type="button"
            class="search-overlay"
            tabindex="-1"
            aria-hidden="true"
            aria-label="Close search"
            data-test-search-overlay
            {{on "click" this.closeSearch}}
          ></button>
        {{/if}}
        --}}
        <div class="wu-topbar-end">
          {{#if this.showRegionSwitcher}}
            <Woven::Dropdown
              @placement="end"
              @onOpen={{this.loadRegionMenu}}
              data-test-region-switcher
            >
              <:trigger as |toggle|>
                <button
                  type="button"
                  class="wu-btn round caret"
                  aria-haspopup="menu"
                  data-test-region-trigger
                  {{on "click" toggle}}
                >
                  <Ui::Ph @icon="globe" @size="18px" />
                  <span class="region-name">{{this.region.activeRegion.name}}</span>
                </button>
              </:trigger>
              <:menu>
                <div role="group" aria-label="Regions" data-test-region-dropdown>
                  {{#each this.groupedRegions as |grp|}}
                    <div
                      class="wu-dropdown-group"
                      role="presentation"
                      data-test-region-group={{grp.countryName}}
                    >{{grp.countryName}}</div>
                    {{#each grp.regions as |r|}}
                      <button
                        type="button"
                        class="wu-dropdown-item"
                        role="menuitemradio"
                        aria-checked={{if
                          (eq r.code this.region.activeRegion.code)
                          "true"
                          "false"
                        }}
                        tabindex="-1"
                        data-test-region-option={{r.code}}
                        {{on "click" (fn this.selectRegion r)}}
                      >
                        <span class="wu-dropdown-label">{{r.name}}</span>
                        <span class="region-meta">
                          {{#unless (eq r.unitCount null)}}
                            <span
                              class="wu-badge {{if r.unitCount 'brand'}}"
                              data-test-region-unit-count={{r.code}}
                            >{{r.unitCount}}</span>
                          {{/unless}}
                          <span class="region-currency-tag">{{r.currency}}</span>
                        </span>
                        <span class="wu-dropdown-check {{unless (eq r.code this.region.activeRegion.code) 'invisible'}}" aria-hidden="true"></span>
                      </button>
                    {{/each}}
                  {{/each}}
                  {{#if this.canManageRegions}}
                    <hr class="wu-dropdown-separator" />
                    <LinkTo
                      @route="company"
                      @query={{hash tab="regions"}}
                      class="wu-dropdown-item"
                      role="menuitem"
                      tabindex="-1"
                      data-test-region-manage
                    >
                      Manage regions
                    </LinkTo>
                  {{/if}}
                </div>
              </:menu>
            </Woven::Dropdown>
          {{else if this.showRegionLabel}}
            <div class="wu-tag" data-test-region-label>
              <Ui::Ph @icon="globe" @size="16px" />
              <span class="region-name">{{this.region.activeRegion.name}}</span>
            </div>
          {{/if}}
          <Woven::Dropdown @placement="end" @onOpen={{this.loadNotifications}}>
            <:trigger as |toggle|>
              <Woven::Badge
                @value={{this.unreadCount}}
                @hidden={{not this.unreadCount}}
                @max={{99}}
              >
                <Woven::Button
                  @variant="ghost"
                  @shape="square"
                  @icon="bell"
                  aria-label="Notifications"
                  aria-haspopup="menu"
                  data-test-notifications-trigger
                  @onClick={{toggle}}
                />
              </Woven::Badge>
            </:trigger>
            <:menu>
              <div class="app-shell__notifications" role="group" aria-label="Notifications">
                <div class="flex between x-center gap-3 px-3 py-2">
                  <span class="text-sm font-bold">Notifications</span>
                  {{#if this.unreadCount}}
                    <Woven::Button
                      @variant="link"
                      @size="sm"
                      data-test-mark-all-read
                      {{on "click" this.markAllRead}}
                    >Mark all read</Woven::Button>
                  {{/if}}
                </div>
                <hr class="wu-dropdown-separator" />
                {{#each this.notifications as |notif|}}
                  <button
                    data-test-notification-item={{notif.id}}
                    type="button"
                    class="wu-dropdown-item {{unless notif.isRead 'unread'}}"
                    role="menuitem"
                    tabindex="-1"
                    {{on "click" (fn this.markAsRead notif)}}
                  >
                    <div class="notification-icon {{notif.type}}">
                      <Ui::Ph
                        @icon={{get-notification-icon notif.type}}
                        @size="18px"
                      />
                    </div>
                    <div class="notification-content">
                      <span class="notification-title">{{notif.title}}</span>
                      <span
                        class="notification-message"
                      >{{notif.message}}</span>
                      {{#if notif.regionName}}
                        <span
                          class="notification-region"
                          data-test-notification-region
                        >Region: {{notif.regionName}}</span>
                      {{/if}}
                      <span class="notification-time">{{format-date-time
                          notif.createdAt
                          region=notif.regionCode
                        }}</span>
                    </div>
                  </button>
                {{else}}
                  <div class="wu-dropdown-empty flex col x-center gap-2 py-6">
                    <Ui::Ph
                      @icon="bell-slash"
                      @size="24px"
                      @color="var(--wu-text-muted)"
                    />
                    <span class="text-xs">No notifications</span>
                  </div>
                {{/each}}
              </div>
            </:menu>
          </Woven::Dropdown>
          {{#if this.isCompanyAdmin}}
            <Woven::Button
              @route="company"
              @variant="ghost"
              @shape="square"
              @icon="building-office"
              aria-label="Company settings"
              data-test-nav-company
            />
          {{/if}}
          <Woven::Button
            @variant="ghost"
            @shape="square"
            @icon="sign-out"
            aria-label="Logout"
            data-test-logout-button
            @onClick={{this.logout}}
          />
        </div>
      </header>

      <section class="content-area">
        {{outlet}}
      </section>
    </main>
  </div>
{{else}}
  {{outlet}}
{{/if}}

<Woven::ToastRegion />

<Woven::LayerHost />
<Woven::TooltipHost />
<Woven::DialogHost />

<ConfirmModal
  @open={{this.showLogoutModal}}
  @title="Logout"
  @message="Are you sure you want to logout?"
  @confirmText="Logout"
  @confirmVariant="danger"
  @onClose={{this.closeLogoutModal}}
  @onConfirm={{this.confirmLogout}}
/>