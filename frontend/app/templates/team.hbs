{{page-title "Team"}}

<div data-test-team-page class="flex col gap-6">
  <Nuvo::PageHeader @title="Team" @subtitle="Manage your team members and their roles.">
    <:actions>
      {{#unless this.isSuperAdmin}}
        <div class="flex gap-3">
          {{#if this.canTrim}}
            <Nuvo::Button
              @variant="secondary"
              @icon="trend-down"
              data-test-trim-users
              {{on "click" this.openTrim}}
            >
              Prepare Downgrade
            </Nuvo::Button>
          {{/if}}
          <Nuvo::Button
            @variant="secondary"
            @icon="envelope-simple"
            data-test-invite-member
            {{on "click" this.openInvite}}
          >
            Invite
          </Nuvo::Button>
          <Nuvo::Button
            @variant="primary"
            @icon="plus"
            data-test-add-member
            {{on "click" this.openCreate}}
          >
            Add Member
          </Nuvo::Button>
        </div>
      {{/unless}}
    </:actions>
  </Nuvo::PageHeader>

  <Nuvo::Card>
    {{#if this.model.users.length}}
      <Nuvo::DataTable
        @columns={{this.columns}}
        @rows={{this.model.users}}
        @pinColumns={{true}}
        @reorderable={{true}}
        @sortable={{true}}
        @showOptions={{true}}
        @tableId="team"
        as |cell|
      >
        {{#if (eq cell.key "name")}}
          <span class="font-bold" data-test-user-id={{cell.row.id}}>{{cell.value}}</span>
        {{else if (eq cell.key "email")}}
          <span class="text-muted">{{cell.value}}</span>
        {{else if (eq cell.key "role")}}
          <Nuvo::Tag @text={{format-role cell.value}} />
        {{else if (eq cell.key "regionCodes")}}
          {{#if cell.value.length}}
            <div class="flex gap-1 wrap" data-test-user-regions={{cell.row.id}}>
              {{#each cell.value as |code|}}
                <Nuvo::Tag @text={{code}} @size="sm" />
              {{/each}}
            </div>
          {{else}}
            <span
              class="text-xs text-muted"
              data-test-user-regions-empty={{cell.row.id}}
            >None</span>
          {{/if}}
        {{else if (eq cell.key "company.name")}}
          <span class="text-muted">{{or cell.value "—"}}</span>
        {{else if (eq cell.key "isActive")}}
          {{#if cell.value}}
            <Nuvo::Tag class="tag-enabled-active" @text="Active" />
          {{else}}
            <Nuvo::Tag class="tag-enabled-inactive" @text="Inactive" />
          {{/if}}
        {{else if (eq cell.key "id")}}
          <div class="flex">
            <Nuvo::Button
              @subtle={{true}}
              @variant="secondary"
              @size="xs"
              @icon="pencil-simple"
              aria-label="Edit {{cell.row.name}}"
              data-tooltip="Edit"
              data-test-edit-user
              {{on "click" (fn this.openEdit cell.row)}}
            />
            {{! Removal needs a company context; backend rejects users with no companyId. }}
            {{#if cell.row.companyId}}
              {{#if cell.row.isActive}}
                <Nuvo::Button
                  @subtle={{true}}
                  @variant="danger"
                  @size="xs"
                  @icon="user-minus"
                  aria-label="Remove {{cell.row.name}}"
                  data-tooltip="Remove"
                  data-test-remove-user
                  {{on "click" (fn this.openRemove cell.row)}}
                />
              {{else}}
                <Nuvo::Button
                  @subtle={{true}}
                  @variant="secondary"
                  @size="xs"
                  @icon="user-plus"
                  @loading={{eq this.reactivatingUserId cell.row.id}}
                  @disabled={{this.isReactivating}}
                  aria-label="Reactivate {{cell.row.name}}"
                  data-tooltip="Reactivate"
                  data-test-reactivate-user
                  {{on "click" (fn this.openReactivate cell.row)}}
                />
                <Nuvo::Button
                  @subtle={{true}}
                  @variant="danger"
                  @size="xs"
                  @icon="trash"
                  aria-label="Delete {{cell.row.name}}"
                  data-tooltip="Delete"
                  data-test-delete-user
                  {{on "click" (fn this.openRemove cell.row)}}
                />
              {{/if}}
            {{/if}}
            {{#if this.isSuperAdmin}}
              {{#unless (eq cell.row.role "super_admin")}}
                <Nuvo::Button
                  @subtle={{true}}
                  @variant="secondary"
                  @size="xs"
                  @icon="user-switch"
                  @loading={{eq this.impersonatingUserId cell.row.id}}
                  @disabled={{or
                    (eq cell.row.isActive false)
                    this.isImpersonating
                    (eq this.impersonatingUserId cell.row.id)
                  }}
                  aria-label="Impersonate {{cell.row.name}}"
                  data-tooltip="Impersonate"
                  data-test-impersonate-user
                  {{on "click" (fn this.impersonateUser cell.row)}}
                />
              {{/unless}}
            {{/if}}
          </div>
        {{else}}
          <span class="text-muted">{{cell.value}}</span>
        {{/if}}
      </Nuvo::DataTable>
    {{else}}
      {{#if @model.total}}
        <Nuvo::EmptyState
          @description="No team members on page {{this.page}}. Navigate back to find members."
        />
      {{else}}
        <Nuvo::EmptyState
          @description="No team members yet. Add your first team member to get started."
        />
      {{/if}}
    {{/if}}

    {{#if @model.total}}
      <Nuvo::Pagination
        @selectId="team-limit"
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{@model.total}}
        @onLimitChange={{this.setLimit}}
        @onPrevious={{this.goToPreviousPage}}
        @onNext={{this.goToNextPage}}
        @onPageChange={{this.goToPage}}
      />
    {{/if}}
  </Nuvo::Card>
</div>

<Nuvo::Drawer
  @open={{this.showModal}}
  @title={{if this.editUser "Edit Team Member" "Add Team Member"}}
  @placement="end"
  @size="lg"
  @onClose={{this.closeModal}}
  @onClosed={{this.resetDrawer}}
>
  <:body>
    {{#unless this.editUser}}
      <SeatNote @seatInfo={{this.model.seatInfo}} />
    {{/unless}}
    <form
      id="team-member-form"
      class="flex col gap-4"
      {{on "submit" this.saveUser}}
    >
      <Nuvo::Field @label="Name" @required={{true}}>
        <Nuvo::Input
          id="t-name"
          type="text"
          @value={{this.formName}}
          @onInput={{fn this.setFieldValue "formName"}}
          required={{true}}
          data-test-input-name
        />
      </Nuvo::Field>

      <Nuvo::Field @label="Email" @required={{true}}>
        <Nuvo::Input
          id="t-email"
          type="email"
          @value={{this.formEmail}}
          @onInput={{fn this.setFieldValue "formEmail"}}
          required={{true}}
          data-test-input-email
        />
      </Nuvo::Field>

      {{#unless this.editUser}}
        <Nuvo::Field @label="Password" @required={{true}}>
          <Nuvo::Input
            id="t-password"
            type="password"
            @value={{this.formPassword}}
            @onInput={{fn this.setFieldValue "formPassword"}}
            required={{true}}
            data-test-input-password
          />
        </Nuvo::Field>
      {{/unless}}

      <Nuvo::Field
        @label="Role"
        @tooltip="What this person can do. Company admins manage billing, team and settings. Agents work only on their own records."
      >
        <Nuvo::Dropdown
          id="t-role"
          @align="start"
          @value={{this.formRole}}
          @onSelect={{fn this.setFieldValue "formRole"}}
          @options={{this.roles}}
          @placeholder="Select role..."
          data-test-input-role
        />
      </Nuvo::Field>

      <div class="nu-field">
        <span id="team-regions-label" class="nu-field__label">Regions</span>
        <div
          class="flex gap-2 wrap"
          role="group"
          aria-labelledby="team-regions-label"
          data-test-region-picker
        >
          {{#each this.assignableRegions as |r|}}
            <button
              type="button"
              class="nu-tag m-pill m-selectable {{if (includes this.selectedRegionCodes r.code) 'is-selected'}}"
              data-test-region-choice={{r.code}}
              aria-pressed={{if
                (includes this.selectedRegionCodes r.code)
                "true"
                "false"
              }}
              {{on "click" (fn this.toggleRegion r.code)}}
            >
              <Ui::Ph @icon="map-pin" />
              {{r.name}}
            </button>
          {{/each}}
        </div>
        <span class="nu-field__hint">Which regions this member can work in.
          Selecting more than one lets them switch.</span>
      </div>

      {{#if this.hasNoRegionsSelected}}
        <Nuvo::Alert
          @variant="warning"
          @title="No regions selected"
          @description="This member will fall back to the company default region rather than one you picked. Select at least one to control what they can read."
          data-test-regions-empty-warning
        />
      {{/if}}

      {{#if this.errorMsg}}
        <p class="text-sm text-danger" data-test-error>{{this.errorMsg}}</p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Nuvo::Button
      @variant="secondary"
      @onClick={{this.closeModal}}
    >Cancel</Nuvo::Button>
    <Nuvo::Button
      @variant="primary"
      @type="submit"
      form="team-member-form"
      @loading={{this.isSaving}}
    >{{if
        this.isSaving
        "Saving..."
        (if this.editUser "Update" "Create")
      }}</Nuvo::Button>
  </:footer>
</Nuvo::Drawer>

<Nuvo::Drawer
  @open={{this.showInviteModal}}
  @title="Invite Team Member"
  @placement="end"
  @size="lg"
  @onClose={{this.closeInvite}}
>
  <:body>
    <p class="text-muted text-sm">Send an invitation with a temporary password.
      The new member will receive login credentials.</p>
    <SeatNote @seatInfo={{this.model.seatInfo}} />
    <form
      id="team-invite-form"
      class="flex col gap-4"
      {{on "submit" this.sendInvite}}
    >
      <div class="flex gap-4">
        <Nuvo::Field class="grow" @label="First Name" @required={{true}}>
          <Nuvo::Input
            id="i-fname"
            type="text"
            placeholder="e.g. Jane"
            @value={{this.inviteFirstName}}
            @onInput={{fn this.setFieldValue "inviteFirstName"}}
            required={{true}}
            data-test-invite-first
          />
        </Nuvo::Field>
        <Nuvo::Field class="grow" @label="Last Name" @required={{true}}>
          <Nuvo::Input
            id="i-lname"
            type="text"
            placeholder="e.g. Smith"
            @value={{this.inviteLastName}}
            @onInput={{fn this.setFieldValue "inviteLastName"}}
            required={{true}}
            data-test-invite-last
          />
        </Nuvo::Field>
      </div>

      <Nuvo::Field @label="Email" @required={{true}}>
        <Nuvo::Input
          id="i-email"
          type="email"
          placeholder="e.g. jane@company.com"
          @value={{this.inviteEmail}}
          @onInput={{fn this.setFieldValue "inviteEmail"}}
          required={{true}}
          data-test-invite-email
        />
      </Nuvo::Field>

      <Nuvo::Field
        @label="Role"
        @tooltip="What this person can do. Company admins manage billing, team and settings. Agents work only on their own records."
      >
        <Nuvo::Dropdown
          id="i-role"
          @align="start"
          @value={{this.inviteRole}}
          @onSelect={{fn this.setFieldValue "inviteRole"}}
          @options={{this.roles}}
          @placeholder="Select role..."
          data-test-invite-role
        />
      </Nuvo::Field>

      {{#if this.inviteErrorMsg}}
        <p
          class="text-sm text-danger"
          data-test-invite-error
        >{{this.inviteErrorMsg}}</p>
        {{#if this.inviteExistingUser}}
          <Nuvo::Button
            @variant="secondary"
            @size="xs"
            @disabled={{this.isReactivating}}
            data-test-invite-reactivate
            {{on "click" this.reactivateFromInvite}}
          >
            {{if
              this.isReactivating
              "Reactivating..."
              "Reactivate this user instead"
            }}
          </Nuvo::Button>
        {{/if}}
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Nuvo::Button
      @variant="secondary"
      {{on "click" this.closeInvite}}
    >Cancel</Nuvo::Button>
    <Nuvo::Button
      @variant="primary"
      @type="submit"
      form="team-invite-form"
      @disabled={{or this.isInviting this.isReactivating}}
      @loading={{this.isInviting}}
      data-test-send-invite
    >{{if this.isInviting "Sending..." "Send Invitation"}}</Nuvo::Button>
  </:footer>
</Nuvo::Drawer>

<Nuvo::Modal
  @open={{this.showRemoveModal}}
  @title={{if (eq this.removeStep 1) "Remove Team Member" "Confirm Removal"}}
  @onClose={{this.closeRemoveModal}}
>
  {{#if (eq this.removeStep 1)}}
    <div class="flex col gap-4" data-test-remove-step-1>
      <p class="text-muted text-sm">
        Removing
        <strong>{{this.userToRemove.name}}</strong>. Their leads, documents,
        owners, pending commissions, work orders, and contacts must be handed to
        another active team member first.
      </p>

      <div class="flex col gap-2">
        <span class="text-sm text-muted">Action</span>
        <label class="flex gap-2 x-center">
          <input
            type="radio"
            name="remove-mode"
            value="deactivate"
            checked={{eq this.removeMode "deactivate"}}
            disabled={{not this.userToRemove.isActive}}
            data-test-remove-mode-deactivate
            {{on "change" (fn this.setRemoveMode "deactivate")}}
          />
          <span><strong>Deactivate</strong>
            (recommended): the member loses access and frees the seat. Their
            email address stays reserved for them. Reversible.</span>
        </label>
        <label class="flex gap-2 x-center">
          <input
            type="radio"
            name="remove-mode"
            value="delete"
            checked={{eq this.removeMode "delete"}}
            data-test-remove-mode-delete
            {{on "change" (fn this.setRemoveMode "delete")}}
          />
          <span><strong>Delete</strong>: the member is removed for good and
            their email address is freed, so they can be invited elsewhere.
            Their history stays in the audit log. Irreversible.</span>
        </label>
      </div>

      <Nuvo::Field
        @label="Reassign records to"
        @required={{true}}
        @tooltip="Who takes over this person's leads, documents, commissions and work orders. Someone must be chosen."
      >
        <Nuvo::Dropdown
          id="remove-target"
          @align="start"
          @value={{this.removeTargetId}}
          @onSelect={{fn this.setFieldValue "removeTargetId"}}
          @options={{this.reassignOptions}}
          @placeholder="Select a team member..."
          data-test-remove-target
        />
      </Nuvo::Field>

      <Nuvo::Field
        @label="Reason"
        @required={{true}}
        @error={{this.removeReasonError}}
      >
        <Nuvo::Textarea
          id="remove-reason"
          rows="2"
          placeholder="e.g. Agent left the company"
          @value={{this.removeReason}}
          @onInput={{fn this.setFieldValue "removeReason"}}
          @invalid={{if this.removeReasonError true false}}
          required={{true}}
          aria-label="Reason"
          data-test-remove-reason
        />
      </Nuvo::Field>

      {{#if this.removeError}}
        <p
          class="text-sm text-danger"
          data-test-remove-error
        >{{this.removeError}}</p>
      {{/if}}

      <Nuvo::FormActions @align="end">
        <Nuvo::Button
          @variant="secondary"
          @onClick={{this.closeRemoveModal}}
        >Cancel</Nuvo::Button>
        <Nuvo::Button
          @variant="primary"
          @onClick={{this.continueRemove}}
          data-test-remove-continue
        >Continue</Nuvo::Button>
      </Nuvo::FormActions>
    </div>
  {{else}}
    <div class="flex col gap-4" data-test-remove-step-2>
      <p>
        You are about to
        <strong>{{if
            (eq this.removeMode "delete")
            "delete"
            "deactivate"
          }}</strong>
        <strong>{{this.userToRemove.name}}</strong>. Everything they own
        transfers to
        <strong>{{this.removeTargetName}}</strong>.
        {{#if (eq this.removeMode "delete")}}
          Their email address is freed for reuse and they cannot be reactivated.
          This cannot be undone.
        {{else}}
          You can reactivate them later; transferred records stay with the new
          owner.
        {{/if}}
      </p>

      {{#if this.removeError}}
        <p
          class="text-sm text-danger"
          data-test-remove-error
        >{{this.removeError}}</p>
      {{/if}}

      <Nuvo::FormActions @align="end">
        <Nuvo::Button
          @variant="secondary"
          @onClick={{this.backToRemoveOptions}}
          data-test-remove-back
        >Back</Nuvo::Button>
        <Nuvo::Button
          @variant="danger"
          @disabled={{this.isRemoving}}
          data-test-remove-confirm
          {{on "click" this.confirmRemove}}
        >
          {{if
            this.isRemoving
            "Working..."
            (if
              (eq this.removeMode "delete") "Delete Member" "Deactivate Member"
            )
          }}
        </Nuvo::Button>
      </Nuvo::FormActions>
    </div>
  {{/if}}
</Nuvo::Modal>

<Nuvo::Modal
  @open={{this.showTrimModal}}
  @title={{if (eq this.trimStep 1) "Prepare Downgrade" "Confirm Trim"}}
  @onClose={{this.closeTrimModal}}
>
  {{#if (eq this.trimStep 1)}}
    <div class="flex col gap-4" data-test-trim-step-1>
      <p class="text-muted text-sm">
        Downgrading to the Free plan requires exactly one active user. Every
        other member will be deactivated and their records handed to the member
        who stays.
      </p>

      <Nuvo::Field
        @label="Member who stays active (must be a company admin)"
        @tooltip="The Free plan allows one user. Everyone else loses access as soon as you confirm."
        @required={{true}}
      >
        <Nuvo::Dropdown
          id="trim-keep"
          @align="start"
          @value={{this.trimKeepId}}
          @onSelect={{fn this.setFieldValue "trimKeepId"}}
          @options={{this.trimKeepOptions}}
          @placeholder="Select a company admin..."
          data-test-trim-keep
        />
      </Nuvo::Field>

      <Nuvo::Field
        @label="Reason"
        @required={{true}}
        @error={{this.trimReasonError}}
      >
        <Nuvo::Textarea
          id="trim-reason"
          rows="2"
          @value={{this.trimReason}}
          @onInput={{fn this.setFieldValue "trimReason"}}
          @invalid={{if this.trimReasonError true false}}
          required={{true}}
          aria-label="Reason"
          data-test-trim-reason
        />
      </Nuvo::Field>

      {{#if this.trimError}}
        <p
          class="text-sm text-danger"
          data-test-trim-error
        >{{this.trimError}}</p>
      {{/if}}

      <Nuvo::FormActions @align="end">
        <Nuvo::Button
          @variant="secondary"
          @onClick={{this.closeTrimModal}}
        >Cancel</Nuvo::Button>
        <Nuvo::Button
          @variant="primary"
          @onClick={{this.continueTrim}}
          data-test-trim-continue
        >Continue</Nuvo::Button>
      </Nuvo::FormActions>
    </div>
  {{else}}
    <div class="flex col gap-4" data-test-trim-step-2>
      <p>
        <strong>{{this.trimOthersCount}}</strong>
        member{{if (eq this.trimOthersCount 1) "" "s"}}
        will be deactivated. All of their records transfer to
        <strong>{{this.trimKeepName}}</strong>.
      </p>
      {{#if this.trimKeeperIsNotMe}}
        <p class="text-sm text-danger">
          Warning: you selected someone else to stay. Your own account will be
          deactivated and you will be signed out immediately.
        </p>
      {{/if}}

      {{#if this.trimError}}
        <p
          class="text-sm text-danger"
          data-test-trim-error
        >{{this.trimError}}</p>
      {{/if}}

      <Nuvo::FormActions @align="end">
        <Nuvo::Button
          @variant="secondary"
          @onClick={{this.backToTrimOptions}}
          data-test-trim-back
        >Back</Nuvo::Button>
        <Nuvo::Button
          @variant="danger"
          @disabled={{this.isTrimming}}
          data-test-trim-confirm
          {{on "click" this.confirmTrim}}
        >
          {{if this.isTrimming "Trimming..." "Deactivate Everyone Else"}}
        </Nuvo::Button>
      </Nuvo::FormActions>
    </div>
  {{/if}}
</Nuvo::Modal>

<ConfirmModal
  @open={{this.showReactivateModal}}
  @title="Reactivate User"
  @message="Restore access for this team member?"
  @confirmText="Reactivate"
  @confirmVariant="primary"
  @isConfirming={{this.isReactivating}}
  @confirmingText="Reactivating..."
  @onClose={{this.closeReactivateModal}}
  @onConfirm={{this.confirmReactivate}}
>
  <Nuvo::Field class="mt-4" @label="Reason (optional)">
    <Nuvo::Textarea
      id="team-reactivate-reason"
      rows="2"
      maxlength="500"
      placeholder="e.g. Returned from leave"
      @value={{this.reactivateReason}}
      @onInput={{fn this.setFieldValue "reactivateReason"}}
      aria-label="Reason"
      data-test-reason-input
    />
  </Nuvo::Field>
</ConfirmModal>
