{{page-title "Team"}}

<div data-test-team-page class="flex col gap-4">
  <Woven::PageHeader @title="Team" @subtitle="Manage your team members and their roles.">
    <:actions>
      {{#unless this.isSuperAdmin}}
        <div class="flex gap-3">
          {{#if this.canTrim}}
            <Woven::Button
              @variant="subtle"
              @icon="trend-down"
              data-test-trim-users
              {{on "click" this.openTrim}}
            >
              Prepare Downgrade
            </Woven::Button>
          {{/if}}
          <Woven::Button
            @variant="subtle"
            @icon="envelope-simple"
            data-test-invite-member
            {{on "click" this.openInvite}}
          >
            Invite
          </Woven::Button>
          <Woven::Button
            @variant="brand"
            @icon="plus"
            data-test-add-member
            {{on "click" this.openCreate}}
          >
            Add Member
          </Woven::Button>
        </div>
      {{/unless}}
    </:actions>
  </Woven::PageHeader>

  <div class="flex col gap-3">
    {{#if this.model.users.length}}
      <Woven::DataTable
        @columns={{this.columns}}
        @rows={{this.model.users}}
        @pinColumns={{true}}
        @reorderable={{true}}
        @sortable={{true}}
        @showOptions={{true}}
        @tableId="team"
        as |cell|
      >
        {{#if (eq cell.key "name")}}
          <span data-test-user-id={{cell.row.id}}>{{cell.value}}</span>
        {{else if (eq cell.key "email")}}
          <span class="text-muted">{{cell.value}}</span>
        {{else if (eq cell.key "role")}}
          <Woven::Tag @text={{format-role cell.value}} />
        {{else if (eq cell.key "regionCodes")}}
          {{#if cell.value.length}}
            <div class="flex gap-1 wrap" data-test-user-regions={{cell.row.id}}>
              {{#each cell.value as |code|}}
                <Woven::Tag @text={{code}} />
              {{/each}}
            </div>
          {{else}}
            <span
              class="text-xs text-muted"
              data-test-user-regions-empty={{cell.row.id}}
            >None</span>
          {{/if}}
        {{else if (eq cell.key "company.name")}}
          <span class="text-muted">{{or cell.value "—"}}</span>
        {{else if (eq cell.key "isActive")}}
          {{#if cell.value}}
            <Woven::Tag @variant="success" @text="Active" />
          {{else}}
            <Woven::Tag @variant="secondary" @text="Inactive" />
          {{/if}}
        {{else if (eq cell.key "id")}}
          {{! Removal needs a company context; backend rejects users with no companyId. }}
          <RowActions
            @label={{cell.row.name}}
            @actions={{array
              (hash
                key="edit-user"
                label="Edit"
                icon="pencil-simple"
                onSelect=(fn this.openEdit cell.row)
              )
              (hash
                key="remove-user"
                label="Remove"
                icon="user-minus"
                variant="danger"
                onSelect=(fn this.openRemove cell.row)
                hidden=(not (and cell.row.companyId cell.row.isActive))
              )
              (hash
                key="reactivate-user"
                label="Reactivate"
                icon="user-plus"
                loading=(eq this.reactivatingUserId cell.row.id)
                disabled=this.isReactivating
                onSelect=(fn this.openReactivate cell.row)
                hidden=(not (and cell.row.companyId (not cell.row.isActive)))
              )
              (hash
                key="delete-user"
                label="Delete"
                icon="trash"
                variant="danger"
                onSelect=(fn this.openRemove cell.row)
                hidden=(not (and cell.row.companyId (not cell.row.isActive)))
              )
              (hash
                key="impersonate-user"
                label="Impersonate"
                icon="user-switch"
                loading=(eq this.impersonatingUserId cell.row.id)
                disabled=(or
                  (eq cell.row.isActive false)
                  this.isImpersonating
                  (eq this.impersonatingUserId cell.row.id)
                )
                onSelect=(fn this.impersonateUser cell.row)
                hidden=(or (not this.isSuperAdmin) (eq cell.row.role "super_admin"))
              )
            }}
          />
        {{else}}
          <span class="text-muted">{{cell.value}}</span>
        {{/if}}
      </Woven::DataTable>
    {{else}}
      {{#if @model.total}}
        <Woven::EmptyState
          @description="No team members on page {{this.page}}. Navigate back to find members."
        />
      {{else}}
        <Woven::EmptyState
          @description="No team members yet. Add your first team member to get started."
        />
      {{/if}}
    {{/if}}

    {{#if @model.total}}
      <Woven::Pagination
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{@model.total}}
        @onLimitChange={{this.setLimit}}
        @onPrevious={{this.goToPreviousPage}}
        @onNext={{this.goToNextPage}}
        @onPageChange={{this.goToPage}}
      />
    {{/if}}
  </div>
</div>

<Team::MemberDrawer
  @open={{this.showModal}}
  @user={{this.editUser}}
  @seatInfo={{this.seatInfo}}
  @onClose={{this.closeModal}}
  @onClosed={{this.resetDrawer}}
  @onSaved={{this.refresh}}
/>

<Team::InviteDrawer
  @open={{this.showInviteModal}}
  @seatInfo={{this.seatInfo}}
  @isReactivating={{this.isReactivating}}
  @onReactivate={{this.reactivateUser}}
  @onClose={{this.closeInvite}}
  @onSaved={{this.refresh}}
/>

<Woven::Modal
  @open={{this.showRemoveModal}}
  @title={{if (eq this.removeStep 1) "Remove Team Member" "Confirm Removal"}}
  @onClose={{this.closeRemoveModal}}
>
  {{#if (eq this.removeStep 1)}}
    <div class="wu-form" data-test-remove-step-1>
      <p class="text-muted text-sm">
        Removing
        <strong>{{this.userToRemove.name}}</strong>. Their leads, documents,
        owners, pending commissions, work orders, and contacts must be handed to
        another active team member first.
      </p>

      <div class="flex col gap-2">
        <span class="text-sm text-muted">Action</span>
        <Woven::Radio
          @name="remove-mode"
          @value="deactivate"
          @checked={{eq this.removeMode "deactivate"}}
          @disabled={{not this.userToRemove.isActive}}
          @onChange={{this.setRemoveMode}}
          data-test-remove-mode-deactivate
        ><strong>Deactivate</strong>
          (recommended): the member loses access{{#unless this.hasPaidSeats}}
            and frees the seat{{/unless}}. Their email address stays reserved
          for them. Reversible.</Woven::Radio>
        <Woven::Radio
          @name="remove-mode"
          @value="delete"
          @checked={{eq this.removeMode "delete"}}
          @onChange={{this.setRemoveMode}}
          data-test-remove-mode-delete
        ><strong>Delete</strong>: the member is removed for good and their email
          address is freed, so they can be invited elsewhere. Their history
          stays in the audit log. Irreversible.</Woven::Radio>
        {{#if this.hasPaidSeats}}
          <p class="text-muted text-sm" data-test-seat-removal-note>
            This frees one seat. The unused part of this billing period is
            credited on your next bill.
          </p>
        {{/if}}
      </div>

      <Woven::Field
        @label="Reassign records to"
        @required={{true}}
        @tooltip="Who takes over this person's leads, documents, commissions and work orders. Someone must be chosen."
        @error={{this.removeTargetError}}
      >
        <Woven::Dropdown
          id="remove-target"
          @align="start"
          @value={{this.removeTargetId}}
          @onSelect={{fn this.setFieldValue "removeTargetId"}}
          @options={{this.reassignOptions}}
          @placeholder="Select a team member..."
          data-test-remove-target
        />
      </Woven::Field>

      <Woven::Field
        @label="Reason"
        @required={{true}}
        @error={{this.removeReasonError}}
      >
        <Woven::Textarea
          id="remove-reason"
          rows="2"
          placeholder="e.g. Agent left the company"
          @value={{this.removeReason}}
          @onInput={{fn this.setFieldValue "removeReason"}}
          @invalid={{if this.removeReasonError true false}}
          required={{true}}
          aria-label="Reason"
          data-test-remove-reason
        />
      </Woven::Field>

      {{#if this.removeError}}
        <p
          class="text-sm text-danger"
          data-test-remove-error
        >{{this.removeError}}</p>
      {{/if}}

      <Woven::FormActions @align="end">
        <Woven::Button
          data-test-remove-cancel
          @variant="subtle"
          @onClick={{this.closeRemoveModal}}
        >Cancel</Woven::Button>
        <Woven::Button
          @variant="brand"
          @onClick={{this.continueRemove}}
          data-test-remove-continue
        >Continue</Woven::Button>
      </Woven::FormActions>
    </div>
  {{else}}
    <div class="flex col gap-4" data-test-remove-step-2>
      <p>
        You are about to
        <strong>{{if
            (eq this.removeMode "delete")
            "delete"
            "deactivate"
          }}</strong>
        <strong>{{this.userToRemove.name}}</strong>. Everything they own
        transfers to
        <strong>{{this.removeTargetName}}</strong>.
        {{#if (eq this.removeMode "delete")}}
          Their email address is freed for reuse and they cannot be reactivated.
          This cannot be undone.
        {{else}}
          You can reactivate them later; transferred records stay with the new
          owner.
        {{/if}}
      </p>

      {{#if this.removeError}}
        <p
          class="text-sm text-danger"
          data-test-remove-error
        >{{this.removeError}}</p>
      {{/if}}

      <Woven::FormActions @align="end">
        <Woven::Button
          @variant="subtle"
          @onClick={{this.backToRemoveOptions}}
          data-test-remove-back
        >Back</Woven::Button>
        <Woven::Button
          @variant="danger"
          @disabled={{this.isRemoving}}
          data-test-remove-confirm
          {{on "click" this.confirmRemove}}
        >
          {{if
            this.isRemoving
            "Working..."
            (if
              (eq this.removeMode "delete") "Delete Member" "Deactivate Member"
            )
          }}
        </Woven::Button>
      </Woven::FormActions>
    </div>
  {{/if}}
</Woven::Modal>

<Woven::Modal
  @open={{this.showTrimModal}}
  @title={{if (eq this.trimStep 1) "Prepare Downgrade" "Confirm Trim"}}
  @onClose={{this.closeTrimModal}}
>
  {{#if (eq this.trimStep 1)}}
    <div class="wu-form" data-test-trim-step-1>
      <p class="text-muted text-sm">
        Downgrading to the Free plan requires exactly one active user. Every
        other member will be deactivated and their records handed to the member
        who stays.
      </p>

      <Woven::Field
        @label="Member who stays active (must be a company admin)"
        @tooltip="The Free plan allows one user. Everyone else loses access as soon as you confirm."
        @required={{true}}
        @error={{this.trimKeepError}}
      >
        <Woven::Dropdown
          id="trim-keep"
          @align="start"
          @value={{this.trimKeepId}}
          @onSelect={{fn this.setFieldValue "trimKeepId"}}
          @options={{this.trimKeepOptions}}
          @placeholder="Select a company admin..."
          data-test-trim-keep
        />
      </Woven::Field>

      <Woven::Field
        @label="Reason"
        @required={{true}}
        @error={{this.trimReasonError}}
      >
        <Woven::Textarea
          id="trim-reason"
          rows="2"
          @value={{this.trimReason}}
          @onInput={{fn this.setFieldValue "trimReason"}}
          @invalid={{if this.trimReasonError true false}}
          required={{true}}
          aria-label="Reason"
          data-test-trim-reason
        />
      </Woven::Field>

      {{#if this.trimError}}
        <p
          class="text-sm text-danger"
          data-test-trim-error
        >{{this.trimError}}</p>
      {{/if}}

      <Woven::FormActions @align="end">
        <Woven::Button
          data-test-trim-cancel
          @variant="subtle"
          @onClick={{this.closeTrimModal}}
        >Cancel</Woven::Button>
        <Woven::Button
          @variant="brand"
          @onClick={{this.continueTrim}}
          data-test-trim-continue
        >Continue</Woven::Button>
      </Woven::FormActions>
    </div>
  {{else}}
    <div class="flex col gap-4" data-test-trim-step-2>
      <p>
        <strong>{{this.trimOthersCount}}</strong>
        member{{if (eq this.trimOthersCount 1) "" "s"}}
        will be deactivated. All of their records transfer to
        <strong>{{this.trimKeepName}}</strong>.
      </p>
      {{#if this.trimKeeperIsNotMe}}
        <p class="text-sm text-danger">
          Warning: you selected someone else to stay. Your own account will be
          deactivated and you will be signed out immediately.
        </p>
      {{/if}}

      {{#if this.trimError}}
        <p
          class="text-sm text-danger"
          data-test-trim-error
        >{{this.trimError}}</p>
      {{/if}}

      <Woven::FormActions @align="end">
        <Woven::Button
          @variant="subtle"
          @onClick={{this.backToTrimOptions}}
          data-test-trim-back
        >Back</Woven::Button>
        <Woven::Button
          @variant="danger"
          @disabled={{this.isTrimming}}
          data-test-trim-confirm
          {{on "click" this.confirmTrim}}
        >
          {{if this.isTrimming "Trimming..." "Deactivate Everyone Else"}}
        </Woven::Button>
      </Woven::FormActions>
    </div>
  {{/if}}
</Woven::Modal>

<ConfirmModal
  @open={{this.showReactivateModal}}
  @title="Reactivate User"
  @message="Restore access for this team member?"
  @confirmText="Reactivate"
  @confirmVariant="brand"
  @isConfirming={{this.isReactivating}}
  @confirmingText="Reactivating..."
  @onClose={{this.closeReactivateModal}}
  @onConfirm={{this.confirmReactivate}}
>
  <Woven::Field class="mt-4" @label="Reason (optional)">
    <Woven::Textarea
      id="team-reactivate-reason"
      rows="2"
      maxlength="500"
      placeholder="e.g. Returned from leave"
      @value={{this.reactivateReason}}
      @onInput={{fn this.setFieldValue "reactivateReason"}}
      aria-label="Reason"
      data-test-reason-input
    />
  </Woven::Field>
</ConfirmModal>
