{{page-title "Leads"}}

<div data-test-leads-page class="flex col gap-6">
  <div class="flex between x-center">
    <div>
      <h2 class="text-3xl font-bold"><Ui::Ph @icon="funnel" @size="28px" />
        Lead Pipeline</h2>
      <p class="text-muted mt-1">Track and manage your leads through the
        pipeline.</p>
    </div>
    <div class="flex gap-3 x-center">
      {{! View Toggle }}
      <Nuvo::Tabs
        @tabs={{this.viewTabs}}
        @activeTab={{this.viewMode}}
        @onChange={{this.setViewMode}}
        data-test-view-toggle
      />
      <button
        type="button"
        class="btn btn-primary"
        data-test-add-lead
        {{on "click" this.openCreate}}
      >
        <Ui::Ph @icon="plus" />
        New Lead
      </button>
    </div>
  </div>

  {{! Agent board columns are already the ownership breakdown }}
  {{#unless (eq this.viewMode "agent")}}
    <Nuvo::Tabs
      @tabs={{this.filterTabs}}
      @activeTab={{this.filterType}}
      @onChange={{this.setFilter}}
      data-test-lead-filters
    />
  {{/unless}}

  {{! PIPELINE KANBAN VIEW }}
  {{#if (eq this.viewMode "pipeline")}}
    <div class="kanban-board kanban-board--pipeline">
      {{#each this.columns as |column|}}
        <div
          data-test-kanban-column
          data-test-column-status={{column.status}}
          class="kanban-column flex col gap-3"
          role="button"
          draggable="true"
          {{on "dragover" (fn this.handleDragOver column.status)}}
          {{on "drop" (fn this.handleDrop column.status)}}
        >
          <div class="flex between x-center px-3 py-2 rounded-lg bg-surface">
            <span class="text-sm font-bold">{{column.label}}</span>
            <span class="text-xs text-muted">{{column.leads.length}}</span>
          </div>

          {{#each column.leads as |lead|}}
            <Nuvo::Panel
              @compact={{true}}
              class="flex col gap-2 lead-card-clickable"
              data-test-lead-card
              data-test-lead-id={{lead.id}}
              draggable="true"
              {{on "dragstart" (fn this.handleDragStart lead)}}
              {{on "click" (fn this.openDetailModal lead)}}
            >
              <div class="flex between x-center">
                <p class="text-sm font-bold">{{lead.firstName}}{{#if
                    lead.lastName
                  }} {{lead.lastName}}{{/if}}</p>
                <span
                  class="temp-badge temp-{{lowercase lead.temperature}}"
                >{{lead.temperature}}</span>
              </div>
              <div class="flex gap-2 x-center">
                <p class="text-muted text-xs">{{lead.phone}}</p>
                {{#if lead.phone}}
                  <a
                    href={{wa-link lead.phone}}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="wa-link"
                    data-test-wa-link
                    {{on "click" this.stopPropagation}}
                  >
                    <Ui::Ph @icon="whatsapp-logo" @size="14px" />
                  </a>
                {{/if}}
              </div>
              <p class="text-muted text-xs">{{lead.email}}</p>
              {{#if lead.property}}
                <p class="text-primary text-xs flex gap-1 x-center"><Ui::Ph
                    @icon="buildings"
                  />
                  {{lead.property.name}}</p>
              {{/if}}
              {{#if lead.unit}}
                <p class="text-info text-xs flex gap-1 x-center"><Ui::Ph
                    @icon="house"
                  />
                  Property
                  {{lead.unit.unitNumber}}</p>
              {{/if}}
              {{#if lead.assignedAgentName}}
                <p class="assign-badge">{{lead.assignedAgentName}}</p>
              {{/if}}
              <div class="flex between x-center mt-1">
                <span class="text-xs text-muted">{{format-date
                    lead.createdAt
                  }}</span>
                <div class="flex gap-2" {{on "click" this.stopPropagation}}>
                  <button
                    type="button"
                    class="btn btn-secondary btn-xs"
                    {{on "click" (fn this.openEdit lead)}}
                  >
                    Edit
                  </button>
                  <button
                    type="button"
                    class="btn btn-secondary btn-xs"
                    {{on "click" (fn this.openAssignModal lead)}}
                  >
                    Assign
                  </button>
                </div>
              </div>
            </Nuvo::Panel>
          {{else}}
            <div class="p-4 rounded-xl border border-white@05 text-center">
              <p class="text-muted text-xs">No leads</p>
            </div>
          {{/each}}
        </div>
      {{/each}}
    </div>
  {{/if}}

  {{! TEMPERATURE BOARD VIEW }}
  {{#if (eq this.viewMode "temperature")}}
    <div
      data-test-temperature-board
      class="kanban-board kanban-board--temperature"
    >
      {{#each this.temperatureColumns as |column|}}
        <div
          data-test-kanban-column
          data-test-column-temp={{column.temperature}}
          class="kanban-column flex col gap-3"
          {{on "dragover" (fn this.handleTempDragOver column.temperature)}}
          {{on "drop" (fn this.handleTempDrop column.temperature)}}
        >
          <div
            class="flex between x-center px-3 py-2 rounded-lg temp-column-header temp-column-{{lowercase
                column.temperature
              }}"
          >
            <span class="text-sm font-bold flex gap-2 x-center">
              <Ui::Ph @icon={{column.icon}} />
              {{column.label}}
            </span>
            <span
              class="text-xs temp-column-count"
            >{{column.leads.length}}</span>
          </div>

          {{#each column.leads as |lead|}}
            <Nuvo::Panel
              @compact={{true}}
              class="flex col gap-2 lead-card-clickable"
              data-test-lead-card
              data-test-lead-id={{lead.id}}
              draggable="true"
              {{on "dragstart" (fn this.handleDragStart lead)}}
              {{on "click" (fn this.openDetailModal lead)}}
            >
              <div class="flex between x-center">
                <p class="text-sm font-bold">{{lead.firstName}}{{#if
                    lead.lastName
                  }} {{lead.lastName}}{{/if}}</p>
                <span
                  class="status-badge status-{{lowercase lead.status}}"
                >{{lead.status}}</span>
              </div>
              <div class="flex gap-2 x-center">
                <p class="text-muted text-xs">{{lead.phone}}</p>
                {{#if lead.phone}}
                  <a
                    href={{wa-link lead.phone}}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="wa-link"
                    data-test-wa-link
                    {{on "click" this.stopPropagation}}
                  >
                    <Ui::Ph @icon="whatsapp-logo" @size="14px" />
                  </a>
                {{/if}}
              </div>
              <p class="text-muted text-xs">{{lead.email}}</p>
              {{#if lead.property}}
                <p class="text-primary text-xs flex gap-1 x-center"><Ui::Ph
                    @icon="buildings"
                  />
                  {{lead.property.name}}</p>
              {{/if}}
              {{#if lead.assignedAgentName}}
                <p class="assign-badge">{{lead.assignedAgentName}}</p>
              {{/if}}
              <div class="flex between x-center mt-1">
                <span class="text-xs text-muted">{{format-date
                    lead.createdAt
                  }}</span>
                <div class="flex gap-2" {{on "click" this.stopPropagation}}>
                  <button
                    type="button"
                    class="btn btn-secondary btn-xs"
                    {{on "click" (fn this.openEdit lead)}}
                  >
                    Edit
                  </button>
                  <button
                    type="button"
                    class="btn btn-secondary btn-xs"
                    {{on "click" (fn this.openAssignModal lead)}}
                  >
                    Assign
                  </button>
                </div>
              </div>
            </Nuvo::Panel>
          {{else}}
            <div class="p-4 rounded-xl border border-white@05 text-center">
              <p class="text-muted text-xs">No leads</p>
            </div>
          {{/each}}
        </div>
      {{/each}}
    </div>
  {{/if}}

  {{! AGENT BOARD VIEW }}
  {{#if (eq this.viewMode "agent")}}
    <div data-test-agent-board class="kanban-board kanban-board--agent">
      {{#each this.agentColumns as |column|}}
        <div
          data-test-kanban-column
          data-test-column-agent={{or column.agentId "unassigned"}}
          class="kanban-column flex col gap-3"
          {{on "dragover" (fn this.handleAgentDragOver column.agentId)}}
          {{on "drop" (fn this.handleAgentDrop column.agentId)}}
        >
          <div
            class="flex between x-center px-3 py-2 rounded-lg agent-column-header"
          >
            <span class="text-sm font-bold flex gap-2 x-center">
              <Ui::Ph @icon={{if column.agentId "user" "user-minus"}} />
              {{column.agentName}}
            </span>
            <span class="agent-load-count">{{column.leads.length}}</span>
          </div>

          {{! Load indicator bar }}
          <div class="agent-load-bar">
            <div
              class="agent-load-fill
                {{if
                  (gt column.leads.length 8)
                  'load-high'
                  (if (gt column.leads.length 4) 'load-medium' 'load-low')
                }}"
            ></div>
          </div>

          {{#each column.leads as |lead|}}
            <Nuvo::Panel
              @compact={{true}}
              class="flex col gap-2 lead-card-clickable"
              data-test-lead-card
              data-test-lead-id={{lead.id}}
              draggable="true"
              {{on "dragstart" (fn this.handleDragStart lead)}}
              {{on "click" (fn this.openDetailModal lead)}}
            >
              <div class="flex between x-center">
                <p class="text-sm font-bold">{{lead.firstName}}{{#if
                    lead.lastName
                  }} {{lead.lastName}}{{/if}}</p>
                <span
                  class="temp-badge temp-{{lowercase lead.temperature}}"
                >{{lead.temperature}}</span>
              </div>
              <div class="flex gap-2 x-center">
                <p class="text-muted text-xs">{{lead.phone}}</p>
                {{#if lead.phone}}
                  <a
                    href={{wa-link lead.phone}}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="wa-link"
                    data-test-wa-link
                    {{on "click" this.stopPropagation}}
                  >
                    <Ui::Ph @icon="whatsapp-logo" @size="14px" />
                  </a>
                {{/if}}
              </div>
              <span
                class="status-badge status-{{lowercase lead.status}}"
              >{{lead.status}}</span>
              {{#if lead.property}}
                <p class="text-primary text-xs flex gap-1 x-center"><Ui::Ph
                    @icon="buildings"
                  />
                  {{lead.property.name}}</p>
              {{/if}}
              <div class="flex between x-center mt-1">
                <span class="text-xs text-muted">{{format-date
                    lead.createdAt
                  }}</span>
                <div class="flex gap-2" {{on "click" this.stopPropagation}}>
                  <button
                    type="button"
                    class="btn btn-secondary btn-xs"
                    {{on "click" (fn this.openEdit lead)}}
                  >
                    Edit
                  </button>
                </div>
              </div>
            </Nuvo::Panel>
          {{else}}
            <div class="p-4 rounded-xl border border-white@05 text-center">
              <p class="text-muted text-xs">No leads</p>
            </div>
          {{/each}}
        </div>
      {{/each}}
    </div>
  {{/if}}

  {{! LIST VIEW }}
  {{#if (eq this.viewMode "list")}}
    <div class="nu-table-wrapper">
      <table class="nu-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Contact</th>
            <th>Status</th>
            <th>Temperature</th>
            <th>Property</th>
            <th>Assigned</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each this.filteredLeads as |lead|}}
            <tr
              data-test-lead-row
              data-test-lead-id={{lead.id}}
              class="lead-row-clickable"
              {{on "click" (fn this.openDetailModal lead)}}
            >
              <td>
                <span class="font-bold">{{lead.firstName}}{{#if lead.lastName}}
                    {{lead.lastName}}{{/if}}</span>
              </td>
              <td>
                <div class="flex col gap-1">
                  <div class="flex gap-2 x-center">
                    <span class="text-xs">{{lead.phone}}</span>
                    {{#if lead.phone}}
                      <a
                        href={{wa-link lead.phone}}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="wa-link"
                        data-test-wa-link
                        {{on "click" this.stopPropagation}}
                      >
                        <Ui::Ph @icon="whatsapp-logo" @size="14px" />
                      </a>
                    {{/if}}
                  </div>
                  <span class="text-xs text-muted">{{lead.email}}</span>
                </div>
              </td>
              <td>
                <span
                  class="status-badge status-{{lowercase lead.status}}"
                >{{lead.status}}</span>
              </td>
              <td>
                <span
                  class="temp-badge temp-{{lowercase lead.temperature}}"
                >{{lead.temperature}}</span>
              </td>
              <td>
                {{#if lead.property}}
                  <span>{{lead.property.name}}</span>
                  {{#if lead.unit}}
                    <span class="text-muted text-xs">
                      - Property
                      {{lead.unit.unitNumber}}</span>
                  {{/if}}
                {{else}}
                  <span class="text-muted">-</span>
                {{/if}}
              </td>
              <td>
                {{#if lead.assignedAgentName}}
                  <span
                    class="assign-badge-sm"
                  >{{lead.assignedAgentName}}</span>
                {{else}}
                  <span class="text-muted">Unassigned</span>
                {{/if}}
              </td>
              <td>
                <span class="text-xs text-muted">{{format-date
                    lead.createdAt
                  }}</span>
              </td>
              <td>
                <div class="flex gap-2" {{on "click" this.stopPropagation}}>
                  <button
                    type="button"
                    class="btn btn-secondary btn-xs"
                    {{on "click" (fn this.openEdit lead)}}
                  >
                    Edit
                  </button>
                  <button
                    type="button"
                    class="btn btn-secondary btn-xs"
                    {{on "click" (fn this.openAssignModal lead)}}
                  >
                    Assign
                  </button>
                </div>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="8" class="text-center text-muted py-8">
                No leads found
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{/if}}
</div>

{{! Edit Modal }}
<Nuvo::Modal
  @open={{this.showModal}}
  @title={{if this.editLead "Edit Lead" "New Lead"}}
  @onClose={{this.closeModal}}
>
  <form class="flex col gap-4" {{on "submit" this.saveLead}}>
    {{#if this.showRegionField}}
      <Nuvo::Field @label="Region">
        <Nuvo::Dropdown
          id="lead-region"
          @align="start"
          @value={{this.formRegionCode}}
          @onSelect={{this.setRegionCode}}
          @options={{this.regionOptions}}
          @placeholder="Select region..."
          data-test-region-select
        />
      </Nuvo::Field>
    {{/if}}
    <div class="flex gap-4">
      <div class="grow">
        <Nuvo::Field @label="First Name" @required={{true}}>
          <Nuvo::Input
            id="lead-first-name"
            @type="text"
            @placeholder="e.g. Ahmed"
            @value={{this.formFirstName}}
            @onInput={{fn this.setFieldValue "formFirstName"}}
            required={{true}}
          />
        </Nuvo::Field>
      </div>
      <div class="grow">
        <Nuvo::Field @label="Last Name">
          <Nuvo::Input
            id="lead-last-name"
            @type="text"
            @placeholder="e.g. Al Mansouri"
            @value={{this.formLastName}}
            @onInput={{fn this.setFieldValue "formLastName"}}
          />
        </Nuvo::Field>
      </div>
    </div>
    <Nuvo::Field @label="Email">
      <Nuvo::Input
        id="lead-email"
        @type="email"
        @placeholder="ahmed@example.com"
        @value={{this.formEmail}}
        @onInput={{fn this.setFieldValue "formEmail"}}
      />
    </Nuvo::Field>
    <Nuvo::Field @label="Phone">
      <Nuvo::Input
        id="lead-phone"
        @type="text"
        @placeholder="+971501234567"
        @value={{this.formPhone}}
        @onInput={{fn this.setFieldValue "formPhone"}}
      />
    </Nuvo::Field>
    <div class="flex gap-4">
      <div class="grow">
        <Nuvo::Field @label="Status">
          <Nuvo::Dropdown
            id="lead-status"
            @align="start"
            @value={{this.formStatus}}
            @onSelect={{fn this.setFieldValue "formStatus"}}
            @options={{this.statusOptions}}
            @placeholder="Select status..."
          />
        </Nuvo::Field>
      </div>
      <div class="grow">
        <Nuvo::Field @label="Temperature">
          <Nuvo::Dropdown
            id="lead-temp"
            @align="start"
            @value={{this.formTemperature}}
            @onSelect={{fn this.setFieldValue "formTemperature"}}
            @options={{this.temperatureOptions}}
            @placeholder="Select temperature..."
          />
        </Nuvo::Field>
      </div>
    </div>
    <Nuvo::Field @label="Source">
      <Nuvo::Dropdown
        id="lead-source"
        @align="start"
        @value={{this.formSource}}
        @onSelect={{fn this.setFieldValue "formSource"}}
        @options={{this.sourceOptions}}
        @placeholder="Select source..."
      />
    </Nuvo::Field>
    <Nuvo::Field @label="Property Area">
      <Nuvo::Dropdown
        id="lead-property"
        @align="start"
        @value={{this.formPropertyId}}
        @onSelect={{this.setPropertyId}}
        @options={{this.propertyOptions}}
      />
    </Nuvo::Field>
    {{#if this.formPropertyId}}
      <Nuvo::Field @label="Property">
        <Nuvo::Dropdown
          id="lead-unit"
          @align="start"
          @value={{this.formUnitId}}
          @onSelect={{fn this.setFieldValue "formUnitId"}}
          @options={{this.unitOptions}}
        />
      </Nuvo::Field>
    {{/if}}
    {{#if this.errorMsg}}
      <p class="text-danger">{{this.errorMsg}}</p>
    {{/if}}
    <div class="flex gap-3 mt-2">
      <Nuvo::Button
        @variant="secondary"
        @text="Cancel"
        @onClick={{this.closeModal}}
      />
      <Nuvo::Button
        @variant="primary"
        @type="submit"
        @text={{if
          this.isSaving
          "Saving..."
          (if this.editLead "Update" "Create Lead")
        }}
        @loading={{this.isSaving}}
      />
    </div>
  </form>
</Nuvo::Modal>

{{! Assign Modal }}
<Nuvo::Modal
  @open={{this.showAssignModal}}
  @title="Assign Lead"
  @onClose={{this.closeAssignModal}}
>
  <form class="flex col gap-4" {{on "submit" this.assignToAgent}}>
    <p class="text-muted">Select an agent to assign
      <strong>{{this.assignLead.firstName}}</strong>
      to:</p>
    <Nuvo::Field @label="Agent">
      <Nuvo::Dropdown
        id="agent-select"
        @align="start"
        @value={{this.selectedAgentId}}
        @onSelect={{fn this.setFieldValue "selectedAgentId"}}
        @options={{this.agentOptions}}
      />
    </Nuvo::Field>
    <div class="flex gap-3 mt-2">
      <Nuvo::Button
        @variant="secondary"
        @text="Cancel"
        @onClick={{this.closeAssignModal}}
      />
      <Nuvo::Button @variant="primary" @type="submit" @text="Assign" />
    </div>
  </form>
</Nuvo::Modal>

{{! Lead Detail Modal }}
<Nuvo::Modal
  @open={{this.showDetailModal}}
  @title={{if
    this.detailLead
    (concat
      this.detailLead.firstName
      (if this.detailLead.lastName (concat " " this.detailLead.lastName) "")
    )
    "Lead Details"
  }}
  @onClose={{this.closeDetailModal}}
  @size="lg"
>
  <div class="flex gap-4 x-center">
    <span
      class="temp-badge temp-{{lowercase this.detailLead.temperature}}"
    >{{this.detailLead.temperature}}</span>
    <span
      class="status-badge status-{{lowercase this.detailLead.status}}"
    >{{this.detailLead.status}}</span>
  </div>

  {{! Content }}
  <div class="detail-modal-content flex gap-6">
    {{! Left: Lead Info }}
    <div class="detail-info flex col gap-4">
      <div class="info-section">
        <h4 class="text-sm font-bold text-muted mb-2">Contact Info</h4>
        <div class="flex col gap-2">
          <div class="flex gap-2 x-center">
            <span><Ui::Ph @icon="phone" /></span>
            <span>{{or this.detailLead.phone "N/A"}}</span>
            {{#if this.detailLead.phone}}
              <a
                href={{wa-link this.detailLead.phone}}
                target="_blank"
                rel="noopener noreferrer"
                class="wa-link"
                data-test-wa-link
                title="Open WhatsApp"
              >
                <Ui::Ph @icon="whatsapp-logo" @size="16px" />
              </a>
            {{/if}}
          </div>
          <div class="flex gap-2 x-center">
            <span><Ui::Ph @icon="envelope" /></span>
            <span>{{or this.detailLead.email "N/A"}}</span>
          </div>
          {{#if this.detailLead.whatsappNumber}}
            <div class="flex gap-2 x-center">
              <span><Ui::Ph @icon="whatsapp-logo" /></span>
              <a
                href={{wa-link this.detailLead.whatsappNumber}}
                target="_blank"
                rel="noopener noreferrer"
                class="wa-link-text"
                data-test-wa-link
              >
                {{this.detailLead.whatsappNumber}}
              </a>
            </div>
          {{/if}}
        </div>
      </div>

      <div class="info-section">
        <h4 class="text-sm font-bold text-muted mb-2">Property Interest</h4>
        {{#if this.detailLead.property}}
          <div class="flex gap-2 x-center">
            <span><Ui::Ph @icon="buildings" /></span>
            <span>{{this.detailLead.property.name}}</span>
          </div>
          {{#if this.detailLead.unit}}
            <div class="flex gap-2 x-center mt-1">
              <span><Ui::Ph @icon="house" /></span>
              <span>Property {{this.detailLead.unit.unitNumber}}</span>
            </div>
          {{/if}}
        {{else}}
          <span class="text-muted">No property selected</span>
        {{/if}}
      </div>

      <div class="info-section">
        <h4 class="text-sm font-bold text-muted mb-2">Budget</h4>
        {{#if this.detailLead.budgetMin}}
          <span>{{format-currency this.detailLead.budgetMin}}</span>
          {{#if this.detailLead.budgetMax}}
            <span> - {{format-currency this.detailLead.budgetMax}}</span>
          {{/if}}
        {{else}}
          <span class="text-muted">Not specified</span>
        {{/if}}
      </div>

      <div class="info-section">
        <h4 class="text-sm font-bold text-muted mb-2">Notes</h4>
        <p class="text-sm">{{or this.detailLead.notes "No notes"}}</p>
      </div>

      <div class="info-section">
        <h4 class="text-sm font-bold text-muted mb-2">Source</h4>
        <span>{{or this.detailLead.source "Unknown"}}</span>
      </div>

      <div class="flex gap-2 mt-2">
        <button
          type="button"
          class="btn btn-secondary btn-sm grow"
          {{on "click" (fn this.openEdit this.detailLead)}}
        >
          Edit
        </button>
        <button
          type="button"
          class="btn btn-secondary btn-sm grow"
          {{on "click" (fn this.openAssignModal this.detailLead)}}
        >
          Assign
        </button>
      </div>
    </div>

    {{! Right: Activity Timeline }}
    <div class="detail-timeline grow">
      <h4 class="text-sm font-bold text-muted mb-4">Activity History</h4>
      <div class="activity-timeline flex col gap-3">
        {{#each this.leadActivities as |activity|}}
          <div class="activity-item" data-test-activity-id={{activity.id}}>
            <div class="activity-side">
              <div class="activity-icon">
                <Ui::Ph
                  @icon={{get-activity-icon activity.type}}
                  @size="16px"
                />
              </div>
              <div class="activity-summary">
                <span class="activity-type">{{activity.type}}</span>
                <span class="activity-date">{{format-date-time
                    activity.createdAt
                  }}</span>
              </div>
            </div>
            <div class="activity-content">
              <p class="activity-notes">{{activity.notes}}</p>
              {{#if activity.performedByName}}
                <p class="activity-meta">by {{activity.performedByName}}</p>
              {{/if}}
            </div>
          </div>
        {{else}}
          <div class="text-center text-muted py-8">
            <p>No activity recorded yet</p>
          </div>
        {{/each}}
      </div>
    </div>
  </div>
</Nuvo::Modal>