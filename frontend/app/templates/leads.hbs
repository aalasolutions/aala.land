{{page-title "Leads"}}

<div data-test-leads-page class="flex col gap-6">
  <Nuvo::PageHeader
    @icon="funnel"
    @title="Lead Pipeline"
    @subtitle="Track and manage your leads through the pipeline."
  >
    <:actions>
      <Nuvo::Segmented
        @options={{this.viewTabs}}
        @value={{this.viewMode}}
        @onChange={{this.setViewMode}}
        data-test-view-toggle
      />
      <Nuvo::Button
        @variant="primary"
        @icon="plus"
        data-test-add-lead
        {{on "click" this.openCreate}}
      >
        New Lead
      </Nuvo::Button>
    </:actions>
  </Nuvo::PageHeader>

  {{! Agent board columns are already the ownership breakdown }}
  {{#unless (eq this.viewMode "agent")}}
    <Nuvo::Tabs
      @tabs={{this.filterTabs}}
      @activeTab={{this.filterType}}
      @onChange={{this.setFilter}}
      data-test-lead-filters
    />
  {{/unless}}

  {{! PIPELINE KANBAN VIEW }}
  {{#if (eq this.viewMode "pipeline")}}
    <div class="nu-kanban {{if this.draggedLead 'is-dragging'}}">
      {{#each this.columns as |column|}}
        <div
          data-test-kanban-column
          data-test-column-status={{column.status}}
          class="nu-kanban__column
            {{if (eq this.dropTargetStatus column.status) 'is-drag-over'}}"
          role="button"
          draggable="true"
          {{on "dragover" (fn this.handleDragOver column.status)}}
          {{on "dragleave" (fn this.clearDropTarget "dropTargetStatus")}}
          {{on "drop" (fn this.handleDrop column.status)}}
        >
          <div class="nu-kanban__column-header">
            <span class="nu-kanban__column-title">{{column.label}}</span>
            <span class="nu-kanban__column-count">{{column.leads.length}}</span>
          </div>

          {{#each column.leads as |lead|}}
            <Nuvo::Panel
              @compact={{true}}
              class="flex col gap-2 lead-card-clickable"
              data-test-lead-card
              data-test-lead-id={{lead.id}}
              draggable="true"
              {{on "dragstart" (fn this.handleDragStart lead)}}
              {{on "dragend" this.handleDragEnd}}
              {{on "click" (fn this.openDetailModal lead)}}
            >
              <div class="flex between x-center">
                <p class="text-sm font-bold">{{lead.contact.displayName}}</p>
                <Nuvo::Tag class="tag-temp-{{lowercase lead.temperature}}" @text={{lead.temperature}} />
              </div>
              <div class="flex gap-2 x-center">
                <p class="text-muted text-xs">{{lead.contact.phone}}</p>
                {{#if lead.contact.phone}}
                  <a
                    href={{wa-link lead.contact.phone}}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="wa-link"
                    data-test-wa-link
                    {{on "click" this.stopPropagation}}
                  >
                    <Ui::Ph @icon="whatsapp-logo" @size="14px" />
                  </a>
                {{/if}}
              </div>
              <p class="text-muted text-xs">{{lead.contact.email}}</p>
              {{#if lead.locality}}
                <p class="text-primary text-xs flex gap-1 x-center"><Ui::Ph
                    @icon="buildings"
                  />
                  {{lead.locality.name}}</p>
              {{/if}}
              {{#if lead.unit}}
                <p class="text-info text-xs flex gap-1 x-center"><Ui::Ph
                    @icon="house"
                  />
                  Property
                  {{lead.unit.unitNumber}}</p>
              {{/if}}
              {{#if lead.assignedAgentName}}
                <p class="lead-assign">{{lead.assignedAgentName}}</p>
              {{/if}}
              <div class="flex between x-center mt-1">
                <span class="text-xs text-muted">{{format-date
                    lead.createdAt
                  }}</span>
                <Nuvo::BtnGroup @attached={{true}} {{on "click" this.stopPropagation}}>
                  <Nuvo::Button
                    @variant="secondary"
                    @size="xs"
                    {{on "click" (fn this.openEdit lead)}}
                  >
                    Edit
                  </Nuvo::Button>
                  <Nuvo::Button
                    @variant="secondary"
                    @size="xs"
                    {{on "click" (fn this.openAssignModal lead)}}
                  >
                    Assign
                  </Nuvo::Button>
                </Nuvo::BtnGroup>
              </div>
            </Nuvo::Panel>
          {{else}}
            <div class="p-4 rounded-xl border border-white@05 text-center">
              <p class="text-muted text-xs">No leads</p>
            </div>
          {{/each}}
        </div>
      {{/each}}
    </div>
  {{/if}}

  {{! TEMPERATURE BOARD VIEW }}
  {{#if (eq this.viewMode "temperature")}}
    <div
      data-test-temperature-board
      class="nu-kanban {{if this.draggedLead 'is-dragging'}}"
    >
      {{#each this.temperatureColumns as |column|}}
        <div
          data-test-kanban-column
          data-test-column-temp={{column.temperature}}
          class="nu-kanban__column column-temp-{{lowercase column.temperature}}
            {{if
              (eq this.dropTargetTemp column.temperature)
              'is-drag-over'
            }}"
          {{on "dragover" (fn this.handleTempDragOver column.temperature)}}
          {{on "dragleave" (fn this.clearDropTarget "dropTargetTemp")}}
          {{on "drop" (fn this.handleTempDrop column.temperature)}}
        >
          <div class="nu-kanban__column-header">
            <span class="nu-kanban__column-title">
              <span class="nu-kanban__column-accent"></span>
              <Ui::Ph @icon={{column.icon}} />
              {{column.label}}
            </span>
            <span class="nu-kanban__column-count">{{column.leads.length}}</span>
          </div>

          {{#each column.leads as |lead|}}
            <Nuvo::Panel
              @compact={{true}}
              class="flex col gap-2 lead-card-clickable"
              data-test-lead-card
              data-test-lead-id={{lead.id}}
              draggable="true"
              {{on "dragstart" (fn this.handleDragStart lead)}}
              {{on "dragend" this.handleDragEnd}}
              {{on "click" (fn this.openDetailModal lead)}}
            >
              <div class="flex between x-center">
                <p class="text-sm font-bold">{{lead.contact.displayName}}</p>
                <Nuvo::Tag class="tag-lead-{{lowercase lead.status}}" @text={{lead.status}} />
              </div>
              <div class="flex gap-2 x-center">
                <p class="text-muted text-xs">{{lead.contact.phone}}</p>
                {{#if lead.contact.phone}}
                  <a
                    href={{wa-link lead.contact.phone}}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="wa-link"
                    data-test-wa-link
                    {{on "click" this.stopPropagation}}
                  >
                    <Ui::Ph @icon="whatsapp-logo" @size="14px" />
                  </a>
                {{/if}}
              </div>
              <p class="text-muted text-xs">{{lead.contact.email}}</p>
              {{#if lead.locality}}
                <p class="text-primary text-xs flex gap-1 x-center"><Ui::Ph
                    @icon="buildings"
                  />
                  {{lead.locality.name}}</p>
              {{/if}}
              {{#if lead.assignedAgentName}}
                <p class="lead-assign">{{lead.assignedAgentName}}</p>
              {{/if}}
              <div class="flex between x-center mt-1">
                <span class="text-xs text-muted">{{format-date
                    lead.createdAt
                  }}</span>
                <Nuvo::BtnGroup @attached={{true}} {{on "click" this.stopPropagation}}>
                  <Nuvo::Button
                    @variant="secondary"
                    @size="xs"
                    {{on "click" (fn this.openEdit lead)}}
                  >
                    Edit
                  </Nuvo::Button>
                  <Nuvo::Button
                    @variant="secondary"
                    @size="xs"
                    {{on "click" (fn this.openAssignModal lead)}}
                  >
                    Assign
                  </Nuvo::Button>
                </Nuvo::BtnGroup>
              </div>
            </Nuvo::Panel>
          {{else}}
            <div class="p-4 rounded-xl border border-white@05 text-center">
              <p class="text-muted text-xs">No leads</p>
            </div>
          {{/each}}
        </div>
      {{/each}}
    </div>
  {{/if}}

  {{! AGENT BOARD VIEW }}
  {{#if (eq this.viewMode "agent")}}
    <div data-test-agent-board class="nu-kanban {{if this.draggedLead 'is-dragging'}}">
      {{#each this.agentColumns as |column|}}
        <div
          data-test-kanban-column
          data-test-column-agent={{or column.agentId "unassigned"}}
          class="nu-kanban__column
            {{if
              (eq this.dropTargetAgent (or column.agentId "unassigned"))
              'is-drag-over'
            }}"
          {{on "dragover" (fn this.handleAgentDragOver column.agentId)}}
          {{on "dragleave" (fn this.clearDropTarget "dropTargetAgent")}}
          {{on "drop" (fn this.handleAgentDrop column.agentId)}}
        >
          <div class="nu-kanban__column-header">
            <span class="nu-kanban__column-title">
              <Ui::Ph @icon={{if column.agentId "user" "user-minus"}} />
              {{column.agentName}}
            </span>
            <span class="nu-kanban__column-count">{{column.leads.length}}</span>
          </div>

          {{! Load indicator bar }}
          <div class="agent-load-bar">
            <div
              class="agent-load-fill
                {{if
                  (gt column.leads.length 8)
                  'load-high'
                  (if (gt column.leads.length 4) 'load-medium' 'load-low')
                }}"
            ></div>
          </div>

          {{#each column.leads as |lead|}}
            <Nuvo::Panel
              @compact={{true}}
              class="flex col gap-2 lead-card-clickable"
              data-test-lead-card
              data-test-lead-id={{lead.id}}
              draggable="true"
              {{on "dragstart" (fn this.handleDragStart lead)}}
              {{on "dragend" this.handleDragEnd}}
              {{on "click" (fn this.openDetailModal lead)}}
            >
              <div class="flex between x-center">
                <p class="text-sm font-bold">{{lead.contact.displayName}}</p>
                <Nuvo::Tag class="tag-temp-{{lowercase lead.temperature}}" @text={{lead.temperature}} />
              </div>
              <div class="flex gap-2 x-center">
                <p class="text-muted text-xs">{{lead.contact.phone}}</p>
                {{#if lead.contact.phone}}
                  <a
                    href={{wa-link lead.contact.phone}}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="wa-link"
                    data-test-wa-link
                    {{on "click" this.stopPropagation}}
                  >
                    <Ui::Ph @icon="whatsapp-logo" @size="14px" />
                  </a>
                {{/if}}
              </div>
              <Nuvo::Tag class="tag-lead-{{lowercase lead.status}}" @text={{lead.status}} />
              {{#if lead.locality}}
                <p class="text-primary text-xs flex gap-1 x-center"><Ui::Ph
                    @icon="buildings"
                  />
                  {{lead.locality.name}}</p>
              {{/if}}
              <div class="flex between x-center mt-1">
                <span class="text-xs text-muted">{{format-date
                    lead.createdAt
                  }}</span>
                <Nuvo::BtnGroup @attached={{true}} {{on "click" this.stopPropagation}}>
                  <Nuvo::Button
                    @variant="secondary"
                    @size="xs"
                    {{on "click" (fn this.openEdit lead)}}
                  >
                    Edit
                  </Nuvo::Button>
                </Nuvo::BtnGroup>
              </div>
            </Nuvo::Panel>
          {{else}}
            <div class="p-4 rounded-xl border border-white@05 text-center">
              <p class="text-muted text-xs">No leads</p>
            </div>
          {{/each}}
        </div>
      {{/each}}
    </div>
  {{/if}}

  {{! LIST VIEW }}
  {{#if (eq this.viewMode "list")}}
    <div class="nu-table-wrapper">
      <table class="nu-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Contact</th>
            <th>Status</th>
            <th>Temperature</th>
            <th>Property</th>
            <th>Assigned</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each this.filteredLeads as |lead|}}
            <tr
              data-test-lead-row
              data-test-lead-id={{lead.id}}
              class="lead-row-clickable"
              {{on "click" (fn this.openDetailModal lead)}}
            >
              <td>
                <span class="font-bold">{{lead.contact.displayName}}</span>
              </td>
              <td>
                <div class="flex col gap-1">
                  <div class="flex gap-2 x-center">
                    <span class="text-xs">{{lead.contact.phone}}</span>
                    {{#if lead.contact.phone}}
                      <a
                        href={{wa-link lead.contact.phone}}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="wa-link"
                        data-test-wa-link
                        {{on "click" this.stopPropagation}}
                      >
                        <Ui::Ph @icon="whatsapp-logo" @size="14px" />
                      </a>
                    {{/if}}
                  </div>
                  <span class="text-xs text-muted">{{lead.contact.email}}</span>
                </div>
              </td>
              <td>
                <Nuvo::Tag class="tag-lead-{{lowercase lead.status}}" @text={{lead.status}} />
              </td>
              <td>
                <Nuvo::Tag class="tag-temp-{{lowercase lead.temperature}}" @text={{lead.temperature}} />
              </td>
              <td>
                {{#if lead.locality}}
                  <span>{{lead.locality.name}}</span>
                  {{#if lead.unit}}
                    <span class="text-muted text-xs">
                      - Property
                      {{lead.unit.unitNumber}}</span>
                  {{/if}}
                {{else}}
                  <span class="text-muted">-</span>
                {{/if}}
              </td>
              <td>
                {{#if lead.assignedAgentName}}
                  <span
                    class="lead-assign m-sm"
                  >{{lead.assignedAgentName}}</span>
                {{else}}
                  <span class="text-muted">Unassigned</span>
                {{/if}}
              </td>
              <td>
                <span class="text-xs text-muted">{{format-date
                    lead.createdAt
                  }}</span>
              </td>
              <td>
                <Nuvo::BtnGroup @attached={{true}} {{on "click" this.stopPropagation}}>
                  <Nuvo::Button
                    @variant="secondary"
                    @size="xs"
                    {{on "click" (fn this.openEdit lead)}}
                  >
                    Edit
                  </Nuvo::Button>
                  <Nuvo::Button
                    @variant="secondary"
                    @size="xs"
                    {{on "click" (fn this.openAssignModal lead)}}
                  >
                    Assign
                  </Nuvo::Button>
                </Nuvo::BtnGroup>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="8" class="text-center text-muted py-8">
                No leads found
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{/if}}
</div>

{{! Edit Modal }}
<Nuvo::Drawer
  @open={{this.showModal}}
  @title={{if this.editLead "Edit Lead" "New Lead"}}
  @placement="end"
  @size="lg"
  @onClose={{this.closeModal}}
>
  <:body>
    <form id="lead-form" class="flex col gap-4" {{on "submit" this.saveLead}}>
      {{#if this.showRegionField}}
        <Nuvo::Field @label="Region">
          <Nuvo::Dropdown
            id="lead-region"
            @align="start"
            @value={{this.formRegionCode}}
            @onSelect={{this.setRegionCode}}
            @options={{this.regionOptions}}
            @placeholder="Select region..."
            data-test-region-select
          />
        </Nuvo::Field>
      {{/if}}
      {{#if this.editLead}}
        {{! Identity lives on the contact; edit it on the Contacts page. }}
        <Nuvo::Field @label="Contact">
          <p class="text-sm">
            {{this.editLead.contact.displayName}}
            {{#if this.editLead.contact.email}}
              <span class="text-muted">- {{this.editLead.contact.email}}</span>
            {{/if}}
            {{#if this.editLead.contact.phone}}
              <span class="text-muted">- {{this.editLead.contact.phone}}</span>
            {{/if}}
          </p>
        </Nuvo::Field>
      {{else}}
        <div class="flex gap-4">
          <div class="grow">
            <Nuvo::Field @label="First Name" @required={{true}}>
              <Nuvo::Input
                id="lead-first-name"
                @type="text"
                @placeholder="e.g. Ahmed"
                @value={{this.formFirstName}}
                @onInput={{fn this.setFieldValue "formFirstName"}}
                required={{true}}
              />
            </Nuvo::Field>
          </div>
          <div class="grow">
            <Nuvo::Field @label="Last Name">
              <Nuvo::Input
                id="lead-last-name"
                @type="text"
                @placeholder="e.g. Al Mansouri"
                @value={{this.formLastName}}
                @onInput={{fn this.setFieldValue "formLastName"}}
              />
            </Nuvo::Field>
          </div>
        </div>
        <Nuvo::Field @label="Email">
          <Nuvo::Input
            id="lead-email"
            @type="email"
            @placeholder="ahmed@example.com"
            @value={{this.formEmail}}
            @onInput={{fn this.setFieldValue "formEmail"}}
          />
        </Nuvo::Field>
        <Nuvo::Field @label="Phone">
          <Nuvo::Input
            id="lead-phone"
            @type="text"
            @placeholder="+971501234567"
            @value={{this.formPhone}}
            @onInput={{fn this.setFieldValue "formPhone"}}
          />
        </Nuvo::Field>
      {{/if}}
      <div class="flex gap-4">
        <div class="grow">
          <Nuvo::Field @label="Status">
            <Nuvo::Dropdown
              id="lead-status"
              @align="start"
              @value={{this.formStatus}}
              @onSelect={{fn this.setFieldValue "formStatus"}}
              @options={{this.statusOptions}}
              @placeholder="Select status..."
            />
          </Nuvo::Field>
        </div>
        <div class="grow">
          <Nuvo::Field @label="Temperature">
            <Nuvo::Dropdown
              id="lead-temp"
              @align="start"
              @value={{this.formTemperature}}
              @onSelect={{fn this.setFieldValue "formTemperature"}}
              @options={{this.temperatureOptions}}
              @placeholder="Select temperature..."
            />
          </Nuvo::Field>
        </div>
      </div>
      <Nuvo::Field @label="Source">
        <Nuvo::Dropdown
          id="lead-source"
          @align="start"
          @value={{this.formSource}}
          @onSelect={{fn this.setFieldValue "formSource"}}
          @options={{this.sourceOptions}}
          @placeholder="Select source..."
        />
      </Nuvo::Field>
      <Nuvo::Field @label="Location / Area">
        <Nuvo::Dropdown
          id="lead-locality"
          @align="start"
          @value={{this.formLocalityId}}
          @onSelect={{this.setLocalityId}}
          @options={{this.localityOptions}}
        />
      </Nuvo::Field>
      {{#if this.formLocalityId}}
        <Nuvo::Field @label="Property">
          <Nuvo::Dropdown
            id="lead-unit"
            @align="start"
            @value={{this.formUnitId}}
            @onSelect={{fn this.setFieldValue "formUnitId"}}
            @options={{this.unitOptions}}
          />
        </Nuvo::Field>
      {{/if}}
      {{#if this.errorMsg}}
        <p class="text-danger">{{this.errorMsg}}</p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Nuvo::Button
      @variant="secondary"
      @text="Cancel"
      @onClick={{this.closeModal}}
    />
    <Nuvo::Button
      @variant="primary"
      @type="submit"
      form="lead-form"
      @text={{if
        this.isSaving
        "Saving..."
        (if this.editLead "Update" "Create Lead")
      }}
      @loading={{this.isSaving}}
    />
  </:footer>
</Nuvo::Drawer>

{{! Assign Modal }}
<Nuvo::Modal
  @open={{this.showAssignModal}}
  @title="Assign Lead"
  @onClose={{this.closeAssignModal}}
>
  <form class="flex col gap-4" {{on "submit" this.assignToAgent}}>
    <p class="text-muted">Select an agent to assign
      <strong>{{this.assignLead.contact.displayName}}</strong>
      to:</p>
    <Nuvo::Field @label="Agent">
      <Nuvo::Dropdown
        id="agent-select"
        @align="start"
        @value={{this.selectedAgentId}}
        @onSelect={{fn this.setFieldValue "selectedAgentId"}}
        @options={{this.agentOptions}}
      />
    </Nuvo::Field>
    <div class="flex gap-3 mt-2">
      <Nuvo::Button
        @variant="secondary"
        @text="Cancel"
        @onClick={{this.closeAssignModal}}
      />
      <Nuvo::Button @variant="primary" @type="submit" @text="Assign" />
    </div>
  </form>
</Nuvo::Modal>

{{! Lead Detail Modal }}
<Nuvo::Modal
  @open={{this.showDetailModal}}
  @title={{if this.detailLead this.detailLead.contact.displayName "Lead Details"}}
  @onClose={{this.closeDetailModal}}
  @size="xl"
>
  <:header as |titleId|>
    <div class="flex col gap-2 grow min-w-0">
      <div class="flex gap-3 x-center wrap">
        <h2 id={{titleId}} class="nu-modal__title" data-test-nu-modal-title>
          {{this.detailLead.contact.displayName}}
        </h2>
        <Nuvo::Tag
          class="tag-temp-{{lowercase this.detailLead.temperature}}"
          @text={{this.detailLead.temperature}}
        />
        <Nuvo::Tag
          class="tag-lead-{{lowercase this.detailLead.status}}"
          @text={{this.detailLead.status}}
        />
      </div>
    </div>
    <button
      type="button"
      class="nu-modal__close"
      aria-label="Close"
      data-test-nu-modal-close
      {{on "click" this.closeDetailModal}}
    >
      ✕
    </button>
  </:header>

  <:body>
    <div class="lead-detail flex gap-6 x-stretch">
      {{! Left: Lead Info }}
      <div class="lead-detail__info flex col gap-4 min-w-0">
        <section class="flex col">
          <h4 class="nu-title m-xs text-muted mb-1">Contact</h4>
          <Nuvo::InfoRow @label="Phone">
            {{#if this.detailLead.contact.phone}}
              <span class="flex gap-2 x-center">
                <span>{{this.detailLead.contact.phone}}</span>
                {{#if this.detailLead.contact.isWhatsapp}}
                  <a
                    href={{wa-link this.detailLead.contact.phone}}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="wa-link"
                    data-test-wa-link
                    title="Open WhatsApp"
                  >
                    <Ui::Ph @icon="whatsapp-logo" @size="16px" />
                  </a>
                {{/if}}
              </span>
            {{else}}
              <span class="text-muted">N/A</span>
            {{/if}}
          </Nuvo::InfoRow>
          <Nuvo::InfoRow class="m-stacked" @label="Email">
            {{#if this.detailLead.contact.email}}
              {{this.detailLead.contact.email}}
            {{else}}
              <span class="text-muted">N/A</span>
            {{/if}}
          </Nuvo::InfoRow>
          {{#if this.detailLead.contact.isWhatsapp}}
            <Nuvo::InfoRow @label="WhatsApp">
              <a
                href={{wa-link this.detailLead.contact.phone}}
                target="_blank"
                rel="noopener noreferrer"
                class="wa-link-text"
                data-test-wa-link
              >
                {{this.detailLead.contact.phone}}
              </a>
            </Nuvo::InfoRow>
          {{/if}}
          <Nuvo::InfoRow @label="Source">
            {{#if this.detailLead.source}}
              {{this.detailLead.source}}
            {{else}}
              <span class="text-muted">Unknown</span>
            {{/if}}
          </Nuvo::InfoRow>
        </section>

        <section class="flex col">
          <h4 class="nu-title m-xs text-muted mb-1">Requirement</h4>
          <Nuvo::InfoRow @label="Location / Area">
            {{#if this.detailLead.locality}}
              {{this.detailLead.locality.name}}
            {{else}}
              <span class="text-muted">No area selected</span>
            {{/if}}
          </Nuvo::InfoRow>
          {{#if this.detailLead.unit}}
            <Nuvo::InfoRow @label="Property">
              {{this.detailLead.unit.unitNumber}}
            </Nuvo::InfoRow>
          {{/if}}
          <Nuvo::InfoRow @label="Budget">
            {{#if this.detailLead.budgetMin}}
              {{format-currency this.detailLead.budgetMin}}
              {{#if this.detailLead.budgetMax}}
                &ndash;
                {{format-currency this.detailLead.budgetMax}}
              {{/if}}
            {{else}}
              <span class="text-muted">Not specified</span>
            {{/if}}
          </Nuvo::InfoRow>
        </section>

        <section class="flex col">
          <h4 class="nu-title m-xs text-muted mb-1">Notes</h4>
          {{#if this.detailLead.notes}}
            <p class="nu-text m-sm">{{this.detailLead.notes}}</p>
          {{else}}
            <p class="nu-text m-sm text-muted">No notes</p>
          {{/if}}
        </section>
      </div>

      {{! Right: Activity Timeline }}
      <div class="lead-detail__timeline flex col grow min-w-0">
        <h4 class="nu-title m-xs text-muted mb-1">Activity History</h4>
        <div class="lead-detail__scroll grow">
          {{#if this.leadActivities}}
            <Nuvo::Timeline @compact={{true}}>
              {{#each this.leadActivities as |activity|}}
                <Nuvo::TimelineItem
                  @title={{activity.type}}
                  @timestamp={{format-date-time activity.createdAt}}
                  @description={{activity.notes}}
                  @meta={{if
                    activity.performedByName
                    (concat "by " activity.performedByName)
                  }}
                  data-test-activity-id={{activity.id}}
                >
                  <:icon>
                    <Ui::Ph
                      @icon={{get-activity-icon activity.type}}
                      @size="14px"
                    />
                  </:icon>
                </Nuvo::TimelineItem>
              {{/each}}
            </Nuvo::Timeline>
          {{else}}
            <Nuvo::EmptyState
              @title="No activity yet"
              @description="Activity on this lead will appear here."
            >
              <:icon><Ui::Ph @icon="clock-counter-clockwise" @size="28px" /></:icon>
            </Nuvo::EmptyState>
          {{/if}}
        </div>
      </div>
    </div>
  </:body>

  <:footer>
    <Nuvo::Button
      @variant="secondary"
      @size="sm"
      {{on "click" (fn this.openAssignModal this.detailLead)}}
    >
      Assign
    </Nuvo::Button>
    <Nuvo::Button
      @variant="primary"
      @size="sm"
      {{on "click" (fn this.openEdit this.detailLead)}}
    >
      Edit
    </Nuvo::Button>
  </:footer>
</Nuvo::Modal>