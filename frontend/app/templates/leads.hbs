{{page-title "Leads"}}

<div data-test-leads-page class="flex col gap-4">
  <Woven::PageHeader
    @title="Lead Pipeline"
    @subtitle="Track and manage your leads through the pipeline."
  >
    <:actions>
      <Woven::Button
        @variant="primary"
        @icon="plus"
        data-test-add-lead
        {{on "click" this.openCreate}}
      >
        New Lead
      </Woven::Button>
    </:actions>
  </Woven::PageHeader>

  {{! Agent board columns are already the ownership breakdown }}
  {{#unless (eq this.viewMode "agent")}}
    <Woven::Tabs
      @tabs={{this.filterTabs}}
      @activeTab={{this.filterType}}
      @onChange={{this.setFilter}}
      data-test-lead-filters
    />
  {{/unless}}
  <div class="flex end" data-test-leads-toolbar>
    <Woven::Segmented
      @options={{this.viewTabs}}
      @value={{this.viewMode}}
      @onChange={{this.setViewMode}}
      data-test-view-toggle
    />
  </div>
  {{#if (eq this.viewMode "pipeline")}}
    <div
      class="wu-kanban
        {{if this.draggedLead 'is-dragging'}}
        {{if this.suppressHover 'is-hover-suppressed'}}"
      {{on "pointermove" this.releaseHover}}
    >
      {{#each this.columns as |column|}}
        <div
          data-test-kanban-column
          data-test-column-status={{column.status}}
          class="wu-kanban__column
            {{if (this.isDropTarget 'pipeline' column.status) 'is-drag-over'}}
            {{if (this.isGapAt 'pipeline' column.status 'end') 'is-drop-end'}}
            {{if column.collapsed 'is-collapsed'}}"
          {{on "dragover" (fn this.handleDragOver "pipeline" column.status)}}
          {{on "dragleave" this.clearDropTarget}}
          {{on "drop" (fn this.handleDrop "pipeline" column.status)}}
        >
          <Leads::KanbanColumnHeader
            @collapsed={{column.collapsed}}
            @count={{column.leads.length}}
            @onToggle={{fn this.toggleColumn "pipeline" column.status}}
          >
            {{column.label}}
          </Leads::KanbanColumnHeader>

          {{#each column.leads as |lead|}}
            <Leads::KanbanCard
              @lead={{lead}}
              @board="pipeline"
              @dragClass={{this.cardDragClass "pipeline" column.status lead.id}}
              @onDragStart={{this.handleDragStart}}
              @onDragEnd={{this.handleDragEnd}}
              @onOpen={{this.openDetailModal}}
              @onEdit={{this.openEdit}}
              @onAssign={{this.openAssignModal}}
            />
          {{else}}
            <div class="p-4 rounded-xl border border-white@05 text-center">
              <p class="text-muted text-xs">No leads</p>
            </div>
          {{/each}}
        </div>
      {{/each}}
    </div>
  {{/if}}

  {{#if (eq this.viewMode "temperature")}}
    <div
      data-test-temperature-board
      class="wu-kanban
        {{if this.draggedLead 'is-dragging'}}
        {{if this.suppressHover 'is-hover-suppressed'}}"
      {{on "pointermove" this.releaseHover}}
    >
      {{#each this.temperatureColumns as |column|}}
        <div
          data-test-kanban-column
          data-test-column-temp={{column.temperature}}
          class="wu-kanban__column column-temp-{{lowercase column.temperature}}
            {{if
              (this.isDropTarget 'temperature' column.temperature)
              'is-drag-over'
            }}
            {{if
              (this.isGapAt 'temperature' column.temperature 'end')
              'is-drop-end'
            }}
            {{if column.collapsed 'is-collapsed'}}"
          {{on
            "dragover"
            (fn this.handleDragOver "temperature" column.temperature)
          }}
          {{on "dragleave" this.clearDropTarget}}
          {{on "drop" (fn this.handleDrop "temperature" column.temperature)}}
        >
          <Leads::KanbanColumnHeader
            @collapsed={{column.collapsed}}
            @count={{column.leads.length}}
            @onToggle={{fn this.toggleColumn "temperature" column.temperature}}
          >
            <span class="wu-kanban__column-accent"></span>
            <Ui::Ph @icon={{column.icon}} />
            {{column.label}}
          </Leads::KanbanColumnHeader>

          {{#each column.leads as |lead|}}
            <Leads::KanbanCard
              @lead={{lead}}
              @board="temperature"
              @dragClass={{this.cardDragClass
                "temperature"
                column.temperature
                lead.id
              }}
              @onDragStart={{this.handleDragStart}}
              @onDragEnd={{this.handleDragEnd}}
              @onOpen={{this.openDetailModal}}
              @onEdit={{this.openEdit}}
              @onAssign={{this.openAssignModal}}
            />
          {{else}}
            <div class="p-4 rounded-xl border border-white@05 text-center">
              <p class="text-muted text-xs">No leads</p>
            </div>
          {{/each}}
        </div>
      {{/each}}
    </div>
  {{/if}}

  {{#if (eq this.viewMode "agent")}}
    <div
      data-test-agent-board
      class="wu-kanban
        {{if this.draggedLead 'is-dragging'}}
        {{if this.suppressHover 'is-hover-suppressed'}}"
      {{on "pointermove" this.releaseHover}}
    >
      {{#each this.agentColumns as |column|}}
        <div
          data-test-kanban-column
          data-test-column-agent={{column.key}}
          class="wu-kanban__column
            {{if (this.isDropTarget 'agent' column.agentId) 'is-drag-over'}}
            {{if (this.isGapAt 'agent' column.agentId 'end') 'is-drop-end'}}
            {{if column.collapsed 'is-collapsed'}}"
          {{on "dragover" (fn this.handleDragOver "agent" column.agentId)}}
          {{on "dragleave" this.clearDropTarget}}
          {{on "drop" (fn this.handleDrop "agent" column.agentId)}}
        >
          <Leads::KanbanColumnHeader
            @collapsed={{column.collapsed}}
            @count={{column.leads.length}}
            @onToggle={{fn this.toggleColumn "agent" column.key}}
          >
            <Ui::Ph @icon={{if column.agentId "user" "user-minus"}} />
            {{column.agentName}}
          </Leads::KanbanColumnHeader>

          <div class="agent-load-bar">
            <div class="agent-load-fill {{column.loadClass}}"></div>
          </div>

          {{#each column.leads as |lead|}}
            <Leads::KanbanCard
              @lead={{lead}}
              @board="agent"
              @dragClass={{this.cardDragClass "agent" column.agentId lead.id}}
              @onDragStart={{this.handleDragStart}}
              @onDragEnd={{this.handleDragEnd}}
              @onOpen={{this.openDetailModal}}
              @onEdit={{this.openEdit}}
            />
          {{else}}
            <div class="p-4 rounded-xl border border-white@05 text-center">
              <p class="text-muted text-xs">No leads</p>
            </div>
          {{/each}}
        </div>
      {{/each}}
    </div>
  {{/if}}

  {{#if (eq this.viewMode "list")}}
    {{#if this.filteredLeads.length}}
      <Woven::DataTable
        @columns={{this.listColumns}}
        @rows={{this.filteredLeads}}
        @onRowClick={{this.openDetailModal}}
        @pinColumns={{true}}
        @reorderable={{true}}
        @sortable={{true}}
        @showOptions={{true}}
        @tableId="leads-list"
        data-test-leads-table
        as |cell|
      >
        {{#if (eq cell.key "contact.displayName")}}
          <span class="flex gap-2 x-center">
            <span
              data-test-lead-row
              data-test-lead-id={{cell.row.id}}
            >{{contact-name cell.row.contact}}</span>
            {{#if (is-limited-contact cell.row.contact)}}
              <Woven::Badge @size="sm" @text="Limited" data-test-limited-badge />
            {{/if}}
          </span>
        {{else if (eq cell.key "contact.phone")}}
          <div class="flex col gap-1">
            <div class="flex gap-2 x-center">
              <span
                class="text-xs"
                dir="ltr"
                data-test-lead-phone
              >{{contact-phone cell.row.contact}}</span>
              {{#if (can-whatsapp cell.row.contact)}}
                <a
                  href={{wa-link cell.row.contact.phone}}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="wa-link"
                  aria-label="Open WhatsApp chat with {{contact-name
                    cell.row.contact
                  }}"
                  data-test-wa-link
                >
                  <Ui::Ph @icon="whatsapp-logo" @size="14px" />
                </a>
              {{/if}}
            </div>
            <span
              class="text-xs text-muted"
              data-test-lead-email
            >{{contact-email cell.row.contact}}</span>
          </div>
        {{else if (eq cell.key "status")}}
          <Woven::Tag
            class="tag-lead-{{lowercase cell.value}}"
            @text={{cell.value}}
          />
        {{else if (eq cell.key "temperature")}}
          <Woven::Tag
            class="tag-temp-{{lowercase cell.value}}"
            @text={{cell.value}}
          />
        {{else if (eq cell.key "locality.name")}}
          {{#if cell.row.locality}}
            <span>{{cell.value}}</span>
            {{#if cell.row.unit}}
              <span class="text-muted text-xs">
                - Property
                {{cell.row.unit.unitNumber}}</span>
            {{/if}}
          {{else}}
            <span class="text-muted">-</span>
          {{/if}}
        {{else if (eq cell.key "assignedAgentName")}}
          {{#if cell.value}}
            <span class="lead-assign m-sm">{{cell.value}}</span>
          {{else}}
            <span class="text-muted">Unassigned</span>
          {{/if}}
        {{else if (eq cell.key "createdAt")}}
          <span class="text-xs text-muted">{{format-date
              cell.value
              zone="region"
            }}</span>
        {{else if (eq cell.key "id")}}
          <div class="flex">
            <Woven::Button
              @subtle={{true}}
              @variant="secondary"
              @size="xs"
              @icon="pencil-simple"
              aria-label="Edit lead {{contact-name cell.row.contact}}"
              data-tooltip="Edit"
              data-test-edit-lead
              {{on "click" (fn this.openEdit cell.row)}}
            />
            <Woven::Button
              @subtle={{true}}
              @variant="secondary"
              @size="xs"
              @icon="user-switch"
              aria-label="Assign lead {{contact-name cell.row.contact}}"
              data-tooltip="Assign"
              data-test-assign-lead
              {{on "click" (fn this.openAssignModal cell.row)}}
            />
          </div>
        {{else}}
          {{cell.value}}
        {{/if}}
      </Woven::DataTable>
    {{else}}
      <p class="text-center text-muted py-8">No leads found</p>
    {{/if}}
  {{/if}}
</div>

<Leads::LeadDrawer
  @open={{this.showModal}}
  @lead={{this.editLead}}
  @onClose={{this.closeModal}}
  @onClosed={{this.resetDrawer}}
  @onSaved={{this.refresh}}
/>

<Woven::Modal
  @open={{this.showAssignModal}}
  @title="Assign Lead"
  @onClose={{this.closeAssignModal}}
>
  <form class="wu-form" {{on "submit" this.assignToAgent}}>
    <p class="text-muted">Select an agent to assign
      <strong>{{contact-name this.assignLead.contact}}</strong>
      to:</p>
    <Woven::Field @label="Agent">
      <Woven::Dropdown
        id="agent-select"
        @align="start"
        @value={{this.selectedAgentId}}
        @onSelect={{fn this.setFieldValue "selectedAgentId"}}
        @options={{this.agentOptions}}
      />
    </Woven::Field>
    <div class="flex gap-3 mt-2">
      <Woven::Button
        @variant="secondary"
        @text="Cancel"
        @onClick={{this.closeAssignModal}}
      />
      <Woven::Button @variant="primary" @type="submit" @text="Assign" />
    </div>
  </form>
</Woven::Modal>

<Woven::Modal
  @open={{this.showDetailModal}}
  @title={{if
    this.detailLead
    (contact-name this.detailLead.contact)
    "Lead Details"
  }}
  @onClose={{this.closeDetailModal}}
  @size="xl"
>
  <:header as |titleId|>
    <div class="flex col gap-2 grow min-w-0">
      <div class="flex gap-3 x-center wrap">
        <h2 id={{titleId}} class="wu-modal__title" data-test-wu-modal-title>
          {{contact-name this.detailLead.contact}}
        </h2>
        {{#if (is-limited-contact this.detailLead.contact)}}
          <Woven::Badge @text="Limited" data-test-limited-badge />
        {{/if}}
        <Woven::Tag
          class="tag-temp-{{lowercase this.detailLead.temperature}}"
          @text={{this.detailLead.temperature}}
        />
        <Woven::Tag
          class="tag-lead-{{lowercase this.detailLead.status}}"
          @text={{this.detailLead.status}}
        />
      </div>
    </div>
    <button
      type="button"
      class="wu-modal__close"
      aria-label="Close"
      data-test-wu-modal-close
      {{on "click" this.closeDetailModal}}
    >
      ✕
    </button>
  </:header>

  <:body>
    <div class="lead-detail flex gap-6 x-stretch">
      <div class="lead-detail__info flex col gap-4 min-w-0">
        <section class="flex col">
          <h4 class="wu-title m-xs text-muted mb-1">Contact</h4>
          <Woven::InfoRow @label="Phone">
            {{#if (contact-phone this.detailLead.contact)}}
              <span class="flex gap-2 x-center">
                <span dir="ltr" data-test-lead-phone>{{contact-phone
                    this.detailLead.contact
                  }}</span>
                {{#if (can-whatsapp this.detailLead.contact)}}
                  <a
                    href={{wa-link this.detailLead.contact.phone}}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="wa-link"
                    data-test-wa-link
                    title="Open WhatsApp"
                    aria-label="Open WhatsApp chat with {{contact-name
                      this.detailLead.contact
                    }}"
                  >
                    <Ui::Ph @icon="whatsapp-logo" @size="16px" />
                  </a>
                {{/if}}
              </span>
            {{else}}
              <span class="text-muted">N/A</span>
            {{/if}}
          </Woven::InfoRow>
          {{#unless (is-limited-contact this.detailLead.contact)}}
            <Woven::InfoRow class="m-stacked" @label="Email">
              {{#if (contact-email this.detailLead.contact)}}
                <span data-test-lead-email>{{contact-email
                    this.detailLead.contact
                  }}</span>
              {{else}}
                <span class="text-muted">N/A</span>
              {{/if}}
            </Woven::InfoRow>
          {{/unless}}
          {{#if (can-whatsapp this.detailLead.contact)}}
            <Woven::InfoRow @label="WhatsApp">
              <a
                href={{wa-link this.detailLead.contact.phone}}
                target="_blank"
                rel="noopener noreferrer"
                class="wa-link-text"
                data-test-wa-link
              >
                {{this.detailLead.contact.phone}}
              </a>
            </Woven::InfoRow>
          {{/if}}
          <Woven::InfoRow @label="Source">
            {{#if this.detailLead.source}}
              {{this.detailLead.source}}
            {{else}}
              <span class="text-muted">Unknown</span>
            {{/if}}
          </Woven::InfoRow>
        </section>

        <section class="flex col">
          <h4 class="wu-title m-xs text-muted mb-1">Requirement</h4>
          <Woven::InfoRow @label="Location / Area">
            {{#if this.detailLead.locality}}
              {{this.detailLead.locality.name}}
            {{else}}
              <span class="text-muted">No area selected</span>
            {{/if}}
          </Woven::InfoRow>
          {{#if this.detailLead.unit}}
            <Woven::InfoRow @label="Property">
              {{this.detailLead.unit.unitNumber}}
            </Woven::InfoRow>
          {{/if}}
          <Woven::InfoRow @label="Budget">
            {{#if this.detailLead.budgetMin}}
              <Money @amount={{this.detailLead.budgetMin}} />
              {{#if this.detailLead.budgetMax}}
                &ndash;
                <Money @amount={{this.detailLead.budgetMax}} />
              {{/if}}
            {{else}}
              <span class="text-muted">Not specified</span>
            {{/if}}
          </Woven::InfoRow>
        </section>

        <section class="flex col">
          <h4 class="wu-title m-xs text-muted mb-1">Notes</h4>
          {{#if this.detailLead.notes}}
            <p class="wu-text m-sm">{{this.detailLead.notes}}</p>
          {{else}}
            <p class="wu-text m-sm text-muted">No notes</p>
          {{/if}}
        </section>
      </div>

      <div class="lead-detail__timeline flex col grow min-w-0">
        <h4 class="wu-title m-xs text-muted mb-1">Activity History</h4>
        <div class="lead-detail__scroll grow">
          {{#if this.leadActivities}}
            <Woven::Timeline @compact={{true}}>
              {{#each this.leadActivities as |activity|}}
                <Woven::TimelineItem
                  @title={{activity.type}}
                  @timestamp={{format-date-time
                    activity.createdAt
                    region=this.detailLead.regionCode
                  }}
                  @description={{activity.notes}}
                  @meta={{if
                    activity.performedByName
                    (concat "by " activity.performedByName)
                  }}
                  data-test-activity-id={{activity.id}}
                >
                  <:icon>
                    <Ui::Ph
                      @icon={{get-activity-icon activity.type}}
                      @size="14px"
                    />
                  </:icon>
                </Woven::TimelineItem>
              {{/each}}
            </Woven::Timeline>
          {{else}}
            <Woven::EmptyState
              @title="No activity yet"
              @description="Activity on this lead will appear here."
            >
              <:icon><Ui::Ph @icon="clock-counter-clockwise" @size="28px" /></:icon>
            </Woven::EmptyState>
          {{/if}}
        </div>
      </div>
    </div>
  </:body>

  <:footer>
    <Woven::Button
      @variant="secondary"
      @size="sm"
      {{on "click" (fn this.openAssignModal this.detailLead)}}
    >
      Assign
    </Woven::Button>
    <Woven::Button
      @variant="primary"
      @size="sm"
      {{on "click" (fn this.openEdit this.detailLead)}}
    >
      Edit
    </Woven::Button>
  </:footer>
</Woven::Modal>