{{page-title "Cheques"}}

<div data-test-cheques-page class="flex col gap-6">
  <Nuvo::PageHeader
    @title="Cheque Management"
    @subtitle="Track post-dated cheques and payment schedules."
  >
    <:meta>
      <p class="text-muted">{{format-number @model.total unit="cheque record"}}</p>
    </:meta>
    <:actions>
      {{#if this.canWriteCheques}}
        <Nuvo::Button
          @variant="primary"
          data-test-new-cheque
          @icon="plus"
          {{on "click" this.openCreate}}
        >
          New Cheque
        </Nuvo::Button>
      {{/if}}
    </:actions>
  </Nuvo::PageHeader>

  <Nuvo::Segmented
    @options={{this.tabs}}
    @value={{this.activeTab}}
    @onChange={{this.setTab}}
  />

  {{#if (eq this.activeTab "cheques")}}
    <Nuvo::Card>
      {{#if @model.cheques.length}}
        <Nuvo::DataTable
          @columns={{this.columns}}
          @rows={{@model.cheques}}
          @pinColumns={{true}}
          @reorderable={{true}}
          @sortable={{true}}
          @showOptions={{true}}
          @tableId="cheques"
          data-test-cheques-table
          as |cell|
        >
          {{#if (eq cell.key "chequeNumber")}}
            <span class="font-bold" data-test-cheque-row>{{cell.value}}</span>
          {{else if (eq cell.key "unit.unitNumber")}}
            <span data-test-cheque-unit>
              {{#if cell.row.unit}}
                {{cell.row.unit.unitNumber}}
              {{else}}
                <span class="text-muted">No Unit</span>
              {{/if}}
            </span>
          {{else if (eq cell.key "amount")}}
            <span class="font-bold">{{format-currency cell.value}}</span>
          {{else if (eq cell.key "dueDate")}}
            {{format-date cell.value}}
          {{else if (eq cell.key "type")}}
            <Nuvo::Tag
              class="tag-cheque-{{lowercase cell.value}}"
              @text={{cell.value}}
            />
          {{else if (eq cell.key "status")}}
            <Nuvo::Tag
              class="tag-chequestate-{{lowercase cell.value}}"
              @text={{cell.value}}
            />
          {{else if (eq cell.key "id")}}
            <div class="flex gap-2">
              {{#if this.canWriteCheques}}
                <Nuvo::Button
                  @variant="secondary"
                  @size="xs"
                  @icon="pencil-simple"
                  {{on "click" (fn this.openEdit cell.row)}}
                >
                  Edit
                </Nuvo::Button>
                {{#if (eq cell.row.status "PENDING")}}
                  <Nuvo::Button
                    @variant="success"
                    @size="xs"
                    @icon="bank"
                    {{on "click" (fn this.updateStatus cell.row "DEPOSITED")}}
                  >
                    Deposit
                  </Nuvo::Button>
                  <Nuvo::Button
                    @variant="danger"
                    @size="xs"
                    data-test-bounce
                    @icon="x-circle"
                    {{on "click" (fn this.openBounceModal cell.row)}}
                  >
                    Bounce
                  </Nuvo::Button>
                {{/if}}
                {{#if (eq cell.row.status "DEPOSITED")}}
                  <Nuvo::Button
                    @variant="success"
                    @size="xs"
                    @icon="check-circle"
                    {{on "click" (fn this.updateStatus cell.row "CLEARED")}}
                  >
                    Clear
                  </Nuvo::Button>
                  <Nuvo::Button
                    @variant="danger"
                    @size="xs"
                    data-test-bounce
                    @icon="x-circle"
                    {{on "click" (fn this.openBounceModal cell.row)}}
                  >
                    Bounce
                  </Nuvo::Button>
                {{/if}}
                {{#if (eq cell.row.status "BOUNCED")}}
                  <Nuvo::Button
                    @variant="secondary"
                    @size="xs"
                    @icon="arrows-clockwise"
                    {{on "click" (fn this.updateStatus cell.row "REPLACED")}}
                  >
                    Replace
                  </Nuvo::Button>
                {{/if}}
                {{#if
                  (or
                    (eq cell.row.status "PENDING")
                    (eq cell.row.status "DEPOSITED")
                    (eq cell.row.status "BOUNCED")
                  )
                }}
                  <Nuvo::Button
                    @variant="secondary"
                    @size="xs"
                    @icon="prohibit"
                    data-test-cancel-cheque
                    {{on "click" (fn this.openCancel cell.row)}}
                  >
                    Cancel cheque
                  </Nuvo::Button>
                {{/if}}
              {{/if}}
              {{#if
                (and this.canDeleteCheque (not (eq cell.row.status "CLEARED")))
              }}
                <Nuvo::Button
                  @variant="danger"
                  @size="xs"
                  @icon="trash"
                  data-test-delete-cheque
                  {{on "click" (fn this.openDelete cell.row)}}
                >
                  Delete
                </Nuvo::Button>
              {{/if}}
            </div>
          {{else}}
            {{cell.value}}
          {{/if}}
        </Nuvo::DataTable>
      {{else}}
        {{#if @model.total}}
          <Nuvo::EmptyState
            @description="No cheques on this page. Navigate to find cheques or adjust filters."
          />
        {{else}}
          <Nuvo::EmptyState
            @description="No cheques yet. Add your first cheque record."
          />
        {{/if}}
      {{/if}}

      {{#if @model.total}}
        <Nuvo::Pagination
          @selectId="cheques-limit"
          @page={{this.page}}
          @limit={{this.limit}}
          @total={{@model.total}}
          @onLimitChange={{this.setLimit}}
          @onPrevious={{this.goToPreviousPage}}
          @onNext={{this.goToNextPage}}
          @onPageChange={{this.goToPage}}
        />
      {{/if}}
    </Nuvo::Card>
  {{/if}}

  {{#if (eq this.activeTab "schedule")}}
    <Nuvo::Card>
      <h4 class="text-lg font-bold mb-4"><Ui::Ph @icon="calendar" />
        Collection Schedule</h4>
      {{#if @model.collectionSchedule.length}}
        <div class="flex col gap-4">
          {{#each @model.collectionSchedule as |group|}}
            <Nuvo::Panel @title={{group.period}}>
              <div class="flex col gap-2">
                {{#each group.cheques as |cheque|}}
                  <Nuvo::ListItem>
                    <:main>
                      <p class="text-sm font-bold">{{cheque.chequeNumber}}
                        -
                        {{cheque.bankName}}</p>
                      <p class="text-muted text-xs">{{cheque.accountHolder}}
                        - Due:
                        {{format-date cheque.dueDate}}</p>
                    </:main>
                    <:actions>
                      <p class="text-sm font-bold">{{format-currency
                          cheque.amount
                        }}</p>
                    </:actions>
                  </Nuvo::ListItem>
                {{/each}}
              </div>
              {{#if group.totalAmount}}
                <p class="text-sm font-bold text-end mt-2">Total:
                  {{format-currency group.totalAmount}}</p>
              {{/if}}
            </Nuvo::Panel>
          {{/each}}
        </div>
      {{else}}
        <Nuvo::EmptyState
          @description="No upcoming cheques in the collection schedule."
        />
      {{/if}}
    </Nuvo::Card>
  {{/if}}
</div>

<Nuvo::Drawer
  @open={{this.showModal}}
  @title={{if this.editCheque "Edit Cheque" "New Cheque"}}
  @placement="end"
  @size="lg"
  @onClose={{this.closeModal}}
  @onClosed={{this.resetDrawer}}
>
  <:body>
    <form
      id="cheque-form"
      class="flex col gap-4"
      {{on "submit" this.saveCheque}}
    >
      <div class="flex gap-4">
        <Nuvo::Field @label="Cheque Number" @required={{true}} class="grow">
          <Nuvo::Input
            id="chq-number"
            type="text"
            placeholder="e.g. 000123"
            @value={{this.formChequeNumber}}
            @onInput={{fn this.setFieldValue "formChequeNumber"}}
            required={{true}}
            data-test-input-cheque-number
          />
        </Nuvo::Field>
        <Nuvo::Field @label="Type" class="grow">
          <Nuvo::Dropdown
            id="chq-type"
            @align="start"
            @value={{this.formType}}
            @onSelect={{fn this.setFieldValue "formType"}}
            @options={{this.chequeTypeOptions}}
            @placeholder="Select type..."
            data-test-input-type
          />
        </Nuvo::Field>
      </div>
      <Nuvo::Field @label="Bank Name" @required={{true}}>
        <Nuvo::Input
          id="chq-bank"
          type="text"
          placeholder="e.g. Emirates NBD"
          @value={{this.formBankName}}
          @onInput={{fn this.setFieldValue "formBankName"}}
          required={{true}}
          data-test-input-bank
        />
      </Nuvo::Field>
      <Nuvo::Field @label="Account Holder" @required={{true}}>
        <Nuvo::Input
          id="chq-holder"
          type="text"
          placeholder="e.g. Ahmed Al Mansouri"
          @value={{this.formAccountHolder}}
          @onInput={{fn this.setFieldValue "formAccountHolder"}}
          required={{true}}
          data-test-input-holder
        />
      </Nuvo::Field>
      <Nuvo::Field @label="Property">
        <Nuvo::Dropdown
          id="chq-unit"
          @align="start"
          @value={{this.formUnitId}}
          @onSelect={{fn this.setFieldValue "formUnitId"}}
          @options={{this.unitOptions}}
          @placeholder="No property linked"
          data-test-input-unit
        />
      </Nuvo::Field>
      <div class="flex gap-4">
        <Nuvo::Field @label="Amount" @required={{true}} class="grow">
          <Nuvo::Input
            id="chq-amount"
            type="number"
            min="0"
            step="0.01"
            placeholder="e.g. 8500"
            @value={{this.formAmount}}
            @onInput={{fn this.setFieldValue "formAmount"}}
            required={{true}}
            data-test-input-amount
          />
        </Nuvo::Field>
        <Nuvo::Field @label="Due Date" @required={{true}} class="grow">
          <input
            id="chq-due"
            type="date"
            class="nu-input"
            value={{this.formDueDate}}
            required
            data-test-input-due-date
            {{on "input" (fn this.setField "formDueDate")}}
          />
        </Nuvo::Field>
      </div>
      {{#if this.errorMsg}}
        <p class="text-sm text-danger" data-test-error>{{this.errorMsg}}</p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Nuvo::Button
      @variant="secondary"
      @onClick={{this.closeModal}}
    >Cancel</Nuvo::Button>
    <Nuvo::Button
      @variant="primary"
      @type="submit"
      form="cheque-form"
      @loading={{this.isSaving}}
      data-test-save-cheque
    >{{if this.editCheque "Update" "Create Cheque"}}</Nuvo::Button>
  </:footer>
</Nuvo::Drawer>

<Nuvo::Modal
  @open={{this.showBounceModal}}
  @title="Bounce Cheque"
  @onClose={{this.closeBounceModal}}
>
  <p class="text-muted">Mark cheque
    {{this.bounceChequeItem.chequeNumber}}
    as bounced?</p>
  <Nuvo::Field @label="Reason (optional)">
    <Nuvo::Input
      id="bounce-reason"
      type="text"
      placeholder="e.g. Insufficient funds"
      @value={{this.formBounceReason}}
      @onInput={{fn this.setFieldValue "formBounceReason"}}
      data-test-input-bounce-reason
    />
  </Nuvo::Field>
  <Nuvo::FormActions @align="end">
    <Nuvo::Button
      @variant="secondary"
      @onClick={{this.closeBounceModal}}
    >Cancel</Nuvo::Button>
    <Nuvo::Button
      @variant="danger"
      data-test-confirm-bounce
      {{on "click" this.confirmBounce}}
    >Confirm Bounce</Nuvo::Button>
  </Nuvo::FormActions>
</Nuvo::Modal>

<ConfirmModal
  @open={{this.showCancelModal}}
  @title="Cancel Cheque"
  @message="Cancel this cheque? It stays in history as cancelled."
  @confirmText="Cancel cheque"
  @confirmVariant="danger"
  @isConfirming={{this.isCancelling}}
  @confirmingText="Cancelling..."
  @onClose={{this.closeCancelModal}}
  @onConfirm={{this.confirmCancel}}
>
  <Nuvo::Field class="mt-4" @label="Reason" @required={{true}} @error={{this.reasonError}}>
    <Nuvo::Textarea
      id="cheque-cancel-reason"
      rows="2"
      maxlength="500"
      placeholder="e.g. Tenant replaced payment method"
      @value={{this.cancelReason}}
      @onInput={{fn this.setFieldValue "cancelReason"}}
      @invalid={{if this.reasonError true false}}
      aria-label="Reason"
      data-test-reason-input
    />
  </Nuvo::Field>
</ConfirmModal>

<ConfirmModal
  @open={{this.showDeleteModal}}
  @title="Delete Cheque"
  @message="Delete this cheque? This cannot be undone."
  @confirmText="Delete"
  @confirmVariant="danger"
  @isConfirming={{this.isDeleting}}
  @confirmingText="Deleting..."
  @onClose={{this.closeDeleteModal}}
  @onConfirm={{this.confirmDelete}}
>
  <Nuvo::Field class="mt-4" @label="Reason" @required={{true}} @error={{this.reasonError}}>
    <Nuvo::Textarea
      id="cheque-delete-reason"
      rows="2"
      maxlength="500"
      placeholder="e.g. Entered by mistake"
      @value={{this.deleteReason}}
      @onInput={{fn this.setFieldValue "deleteReason"}}
      @invalid={{if this.reasonError true false}}
      aria-label="Reason"
      data-test-reason-input
    />
  </Nuvo::Field>
</ConfirmModal>