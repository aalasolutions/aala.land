{{page-title "Cheques Received"}}

<div data-test-cheques-page class="flex col gap-4">
  <Woven::PageHeader
    @title="Cheques Received"
    @subtitle="Track incoming post-dated cheques and their collection schedule."
  >
    <:meta>
      <p class="text-muted">{{format-number
          @model.total
          unit="cheque record"
        }}</p>
    </:meta>
    <:actions>
      {{#if this.canWriteCheques}}
        <Woven::Button
          @variant="brand"
          data-test-new-cheque
          @icon="plus"
          {{on "click" this.openCreate}}
        >
          New Cheque
        </Woven::Button>
      {{/if}}
    </:actions>
  </Woven::PageHeader>

  <Woven::Segmented
    @options={{this.tabs}}
    @value={{this.activeTab}}
    @onChange={{this.setTab}}
  />

  {{#if (eq this.activeTab "cheques")}}
    <div class="flex col gap-3">
      {{#if @model.cheques.length}}
        <Woven::DataTable
          @columns={{this.columns}}
          @rows={{@model.cheques}}
          @pinColumns={{true}}
          @reorderable={{true}}
          @sortable={{true}}
          @showOptions={{true}}
          @tableId="cheques"
          data-test-cheques-table
          as |cell|
        >
          {{#if (eq cell.key "chequeNumber")}}
            <span data-test-cheque-row>{{cell.value}}</span>
          {{else if (eq cell.key "unit.unitNumber")}}
            <span data-test-cheque-unit>
              {{#if cell.row.unit}}
                {{cell.row.unit.unitNumber}}
              {{else}}
                <span class="text-muted">No Unit</span>
              {{/if}}
            </span>
          {{else if (eq cell.key "amount")}}
            <span><Money
                @amount={{cell.value}}
                @currency={{cell.row.currency}}
              /></span>
          {{else if (eq cell.key "dueDate")}}
            {{format-date cell.value}}
          {{else if (eq cell.key "type")}}
            <Woven::Tag
              @variant={{tag-variant "cheque" cell.value}}
              @text={{cell.value}}
            />
          {{else if (eq cell.key "status")}}
            <Woven::Tag
              @variant={{tag-variant "chequestate" cell.value}}
              @text={{cell.value}}
            />
          {{else if (eq cell.key "id")}}
            <RowActions
              @label="cheque {{cell.row.chequeNumber}}"
              @actions={{array
                (hash
                  key="edit-cheque"
                  label="Edit"
                  icon="pencil-simple"
                  onSelect=(fn this.openEdit cell.row)
                  hidden=(not this.canWriteCheques)
                )
                (hash
                  key="deposit-cheque"
                  label="Deposit"
                  icon="bank"
                  onSelect=(fn this.updateStatus cell.row "DEPOSITED")
                  hidden=(not
                    (and this.canWriteCheques (eq cell.row.status "PENDING"))
                  )
                )
                (hash
                  key="clear-cheque"
                  label="Clear"
                  icon="check-circle"
                  onSelect=(fn this.openClear cell.row)
                  hidden=(not
                    (and
                      this.canWriteCheques
                      (or
                        (eq cell.row.status "PENDING")
                        (eq cell.row.status "DEPOSITED")
                      )
                    )
                  )
                )
                (hash
                  key="bounce"
                  label="Bounce"
                  icon="x-circle"
                  variant="danger"
                  onSelect=(fn this.openBounceModal cell.row)
                  hidden=(not
                    (and
                      this.canWriteCheques
                      (or
                        (eq cell.row.status "PENDING")
                        (eq cell.row.status "DEPOSITED")
                      )
                    )
                  )
                )
                (hash
                  key="replace-cheque"
                  label="Replace"
                  icon="arrows-clockwise"
                  onSelect=(fn this.updateStatus cell.row "REPLACED")
                  hidden=(not
                    (and this.canWriteCheques (eq cell.row.status "BOUNCED"))
                  )
                )
                (hash
                  key="unclear-cheque"
                  label="Un-clear"
                  icon="arrow-counter-clockwise"
                  onSelect=(fn this.openUnclear cell.row)
                  hidden=(not
                    (and
                      this.canWriteCheques
                      this.canDeleteCheque
                      (eq cell.row.status "CLEARED")
                    )
                  )
                )
                (hash
                  key="cancel-cheque"
                  label="Cancel cheque"
                  icon="prohibit"
                  onSelect=(fn this.openCancel cell.row)
                  hidden=(not
                    (and
                      this.canWriteCheques
                      (or
                        (eq cell.row.status "PENDING")
                        (eq cell.row.status "DEPOSITED")
                        (eq cell.row.status "BOUNCED")
                      )
                    )
                  )
                )
                (hash
                  key="delete-cheque"
                  label="Delete"
                  icon="trash"
                  variant="danger"
                  onSelect=(fn this.openDelete cell.row)
                  hidden=(not
                    (and
                      this.canDeleteCheque (not (eq cell.row.status "CLEARED"))
                    )
                  )
                )
              }}
            />
          {{else}}
            {{cell.value}}
          {{/if}}
        </Woven::DataTable>
      {{else}}
        {{#if @model.total}}
          <Woven::EmptyState
            @description="No cheques on this page. Navigate to find cheques or adjust filters."
          />
        {{else}}
          <Woven::EmptyState
            @description="No cheques yet. Add your first cheque record."
          />
        {{/if}}
      {{/if}}

      {{#if @model.total}}
        <Woven::Pagination
          @page={{this.page}}
          @limit={{this.limit}}
          @total={{@model.total}}
          @onLimitChange={{this.setLimit}}
          @onPrevious={{this.goToPreviousPage}}
          @onNext={{this.goToNextPage}}
          @onPageChange={{this.goToPage}}
        />
      {{/if}}
    </div>
  {{/if}}

  {{#if (eq this.activeTab "schedule")}}
    <Cheques::CollectionSchedule @groups={{@model.collectionSchedule}} />
  {{/if}}
</div>

<Cheques::ChequeDrawer
  @open={{this.showModal}}
  @cheque={{this.editCheque}}
  @onClose={{this.closeModal}}
  @onClosed={{this.resetDrawer}}
  @onSaved={{this.refresh}}
/>

<Woven::Modal
  @open={{this.showBounceModal}}
  @title="Bounce Cheque"
  @onClose={{this.closeBounceModal}}
>
  <p class="text-muted">Mark cheque
    {{this.bounceChequeItem.chequeNumber}}
    as bounced?</p>
  <Woven::Field @label="Reason (optional)">
    <Woven::Input
      id="bounce-reason"
      type="text"
      placeholder="e.g. Insufficient funds"
      @value={{this.formBounceReason}}
      @onInput={{fn this.setFieldValue "formBounceReason"}}
      data-test-input-bounce-reason
    />
  </Woven::Field>
  <Woven::FormActions @align="end">
    <Woven::Button
      @variant="subtle"
      data-test-cancel-bounce
      @onClick={{this.closeBounceModal}}
    >Cancel</Woven::Button>
    <Woven::Button
      @variant="danger"
      data-test-confirm-bounce
      {{on "click" this.confirmBounce}}
    >Confirm Bounce</Woven::Button>
  </Woven::FormActions>
</Woven::Modal>

<Woven::Modal
  @open={{this.showClearModal}}
  @title="Clear Cheque"
  @onClose={{this.closeClearModal}}
>
  <p class="text-muted">Cheque
    {{this.clearChequeItem.chequeNumber}}
    for
    {{this.clearChequeItem.amount}}
    {{this.clearChequeItem.currency}}. This records the payment as income on the
    day it cleared.</p>
  {{#if this.clearWindowUnusable}}
    <Woven::Alert
      @variant="warning"
      @description={{this.clearBlockedMessage}}
      data-test-clear-blocked
    />
  {{else}}
    <div class="flex gap-4">
      <Woven::Field @label="Added" class="grow">
        <Woven::Input
          id="cheque-added-date"
          type="date"
          readonly={{true}}
          @value={{this.chequeAddedDate}}
          data-test-input-added-date
        />
      </Woven::Field>
      <Woven::Field @label="Deposited" class="grow">
        <Woven::Input
          id="cheque-deposit-date"
          type="date"
          readonly={{this.depositDateReadonly}}
          min={{this.depositDateWindow.earliest}}
          max={{this.depositDateWindow.latest}}
          @value={{this.clearDepositDate}}
          @onInput={{fn this.setFieldValue "clearDepositDate"}}
          data-test-input-deposit-date
        />
      </Woven::Field>
    </div>
    <Woven::Field
      @label="Date it cleared"
      @required={{true}}
      @error={{this.clearError}}
    >
      <Woven::Input
        id="cheque-cleared-date"
        type="date"
        min={{this.clearDateWindow.earliest}}
        max={{this.clearDateWindow.latest}}
        @value={{this.clearedDate}}
        @onInput={{this.setClearedDate}}
        @invalid={{if this.clearError true false}}
        data-test-input-cleared-date
      />
    </Woven::Field>
  {{/if}}
  <Woven::FormActions @align="end">
    <Woven::Button
      @variant="subtle"
      data-test-cancel-clear
      @onClick={{this.closeClearModal}}
    >Cancel</Woven::Button>
    <Woven::Button
      @variant="success"
      @loading={{this.isClearing}}
      @disabled={{this.clearWindowUnusable}}
      data-test-confirm-clear
      {{on "click" this.confirmClear}}
    >Clear and record payment</Woven::Button>
  </Woven::FormActions>
</Woven::Modal>

<ConfirmModal
  @open={{this.showUnclearModal}}
  @title="Reverse Cheque Clearing"
  @message="Reverse this clearing? The payment it recorded is cancelled and stops counting as income."
  @confirmText="Reverse clearing"
  @confirmVariant="danger"
  @isConfirming={{this.isUnclearing}}
  @confirmingText="Reversing..."
  @onClose={{this.closeUnclearModal}}
  @onConfirm={{this.confirmUnclear}}
>
  <Woven::Field
    class="mt-4"
    @label="Reason"
    @required={{true}}
    @error={{this.reasonError}}
  >
    <Woven::Textarea
      id="cheque-unclear-reason"
      rows="2"
      maxlength="500"
      placeholder="e.g. Bank reversed the credit"
      @value={{this.unclearReason}}
      @onInput={{fn this.setFieldValue "unclearReason"}}
      @invalid={{if this.reasonError true false}}
      aria-label="Reason"
      data-test-unclear-reason-input
    />
  </Woven::Field>
</ConfirmModal>

<ConfirmModal
  @open={{this.showCancelModal}}
  @title="Cancel Cheque"
  @message="Cancel this cheque? It stays in history as cancelled."
  @confirmText="Cancel cheque"
  @confirmVariant="danger"
  @isConfirming={{this.isCancelling}}
  @confirmingText="Cancelling..."
  @onClose={{this.closeCancelModal}}
  @onConfirm={{this.confirmCancel}}
>
  <Woven::Field
    class="mt-4"
    @label="Reason"
    @required={{true}}
    @error={{this.reasonError}}
  >
    <Woven::Textarea
      id="cheque-cancel-reason"
      rows="2"
      maxlength="500"
      placeholder="e.g. Tenant replaced payment method"
      @value={{this.cancelReason}}
      @onInput={{fn this.setFieldValue "cancelReason"}}
      @invalid={{if this.reasonError true false}}
      aria-label="Reason"
      data-test-reason-input
    />
  </Woven::Field>
</ConfirmModal>

<ConfirmModal
  @open={{this.showDeleteModal}}
  @title="Delete Cheque"
  @message="Delete this cheque? This cannot be undone."
  @confirmText="Delete"
  @confirmVariant="danger"
  @isConfirming={{this.isDeleting}}
  @confirmingText="Deleting..."
  @onClose={{this.closeDeleteModal}}
  @onConfirm={{this.confirmDelete}}
>
  <Woven::Field
    class="mt-4"
    @label="Reason"
    @required={{true}}
    @error={{this.reasonError}}
  >
    <Woven::Textarea
      id="cheque-delete-reason"
      rows="2"
      maxlength="500"
      placeholder="e.g. Entered by mistake"
      @value={{this.deleteReason}}
      @onInput={{fn this.setFieldValue "deleteReason"}}
      @invalid={{if this.reasonError true false}}
      aria-label="Reason"
      data-test-reason-input
    />
  </Woven::Field>
</ConfirmModal>