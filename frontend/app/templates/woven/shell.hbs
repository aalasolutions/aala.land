<WovenDocs::Page
  @id="shell"
  @title="Shell"
  @subtitle="Sidebar, sidebar links and topbar: the frame around every authenticated route."
  @components="Woven::Sidebar, Woven::SidebarLink, Woven::Topbar"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      The frame around this documentation is the live example: a pinned
      sidebar that collapses to an icon rail and slides in on small screens,
      and a pinned topbar with a hamburger toggle, brand, actions and user
      block. Both render the CSS kit markup (wu-sidebar, wu-topbar); the
      buttons below drive the real sidebar on the left.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Collapsed icon rail: each wu-sidebar-label shows as a tooltip on hover or focus.</span></li>
      <li class="wu-list-item"><span>Mobile open state with a dismiss backdrop.</span></li>
      <li class="wu-list-item"><span>Sections with headings, link lists and nested group lists; router links and button links share wu-sidebar-link.</span></li>
      <li class="wu-list-item"><span>Topbar with toggle, brand, search, end group and user slots.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Sidebar" @id="sidebar">
    <WovenDocs::Example
      @title="Brand and links"
      @note="brandTitle and brandSubtitle render the wu-sidebar-header; the default block holds wu-sidebar-section groups with a wu-sidebar-heading and a wu-sidebar-list. Router links are LinkTo elements with the wu-sidebar-link class and aria-current=page on the current one."
      @layout="block"
      @code={{this.code.sidebar}}
    >
      <Woven::Text @size="sm" @muted={{true}} @text="The sidebar on the left of this page is this snippet, with one link per documented page." />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Collapsed rail"
      @note="collapsed reduces the sidebar to icons. Each wu-sidebar-label is visually hidden and shows as a tooltip on hover or focus. Use it on dense screens where the content needs the width."
      @layout="block"
      @code={{this.code.collapsed}}
    >
      <Woven::Button @size="sm" @text="Toggle the collapsed rail" @onClick={{this.collapseLayout}} data-test-woven-shell-collapse />
      <span class="wu-text sm muted">Collapsed: {{this.layout.sidebarCollapsed}}</span>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Mobile open with backdrop"
      @note="With dismissible, below the md breakpoint the sidebar is off-canvas; open slides it in, the backdrop calls onDismiss, and the topbar's hamburger toggles it. Narrow the window, then press this."
      @layout="block"
      @code={{this.code.mobile}}
    >
      <Woven::Button @size="sm" @text="Toggle mobile sidebar" @onClick={{this.openLayoutMobile}} data-test-woven-shell-mobile />
      <span class="wu-text sm muted">Open: {{this.layout.sidebarOpen}}</span>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Brand block"
      @note="The brand block replaces the title and subtitle with your own markup, for a logo image."
      @layout="block"
      @code={{this.code.brandBlock}}
    >
      <Woven::Text @size="sm" @muted={{true}} @text="Named blocks are all-or-nothing: with a brand or footer block the navigation goes in an explicit default block." />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Footer block"
      @note="Pinned to the bottom of the sidebar, for a version, a plan badge or a sign-out. This site shows the page count."
      @layout="block"
      @code={{this.code.footer}}
    >
      <Woven::Text @size="sm" @muted={{true}} @text="See the bottom of the sidebar on this page." />
    </WovenDocs::Example>

    <h3 class="woven-subtitle">Sidebar arguments</h3>
    <WovenDocs::Table @kind="args" @rows={{this.sidebarArgRows}} />
    <h3 class="woven-subtitle">Sidebar callbacks</h3>
    <WovenDocs::Table @kind="callbacks" @rows={{this.sidebarCallbackRows}} />
    <h3 class="woven-subtitle">Sidebar blocks</h3>
    <WovenDocs::Table @kind="blocks" @rows={{this.sidebarBlockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Sidebar link" @id="sidebar-link">
    <p class="woven-note">A button form of wu-sidebar-link for an action rather than a route transition. It is styled inside a sidebar, so the snippets show the shapes.</p>

    <WovenDocs::Example
      @title="Link"
      @note="Icon, label and an active flag (aria-current), for an action such as opening a switcher. For routes use LinkTo with class wu-sidebar-link so the URL and middle-click work."
      @layout="block"
      @code={{this.code.link}}
    >
      <Woven::Text @size="sm" @muted={{true}} @text="Renders button.wu-sidebar-link with the icon and a wu-sidebar-label span." />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Nested group"
      @note="Nesting is structural: put links in a wu-sidebar-list inside a wu-sidebar-group, which indents them."
      @layout="block"
      @code={{this.code.sublink}}
    >
      <Woven::Text @size="sm" @muted={{true}} @text="A details.wu-sidebar-group with a summary.wu-sidebar-toggle, or a button toggle with aria-expanded." />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Block label"
      @note="A block replaces the label, for a count badge beside the text."
      @layout="block"
      @code={{this.code.linkBlock}}
    >
      <Woven::Text @size="sm" @muted={{true}} @text="The block renders inside wu-sidebar-label." />
    </WovenDocs::Example>

    <h3 class="woven-subtitle">Sidebar link arguments</h3>
    <WovenDocs::Table @kind="args" @rows={{this.linkArgRows}} />
    <h3 class="woven-subtitle">Sidebar link callbacks</h3>
    <WovenDocs::Table @kind="callbacks" @rows={{this.linkCallbackRows}} />
    <h3 class="woven-subtitle">Sidebar link blocks</h3>
    <WovenDocs::Table @kind="blocks" @rows={{this.linkBlockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Topbar" @id="topbar">
    <WovenDocs::Example
      @title="Toggle, brand block, actions, user"
      @note="Inline, non-pinned instance. The hamburger renders only because onToggle is passed and shows below md only; userName and userRole render the trailing user block."
      @layout="block"
      @code={{this.code.topbar}}
    >
      <Woven::Topbar @onToggle={{this.countToggle}} @userName="Test User" @userRole="Owner">
        <:brand>
          <span class="wu-title sm">UI Kit</span>
        </:brand>
        <:actions>
          <span class="wu-text sm muted" data-test-woven-topbar-toggles>Toggled {{this.toggleCount}} times</span>
          <Woven::Button @size="xs" @text="Action" />
        </:actions>
      </Woven::Topbar>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Brand argument"
      @note="brand renders plain text when no brand block is given. Without onToggle there is no hamburger."
      @layout="block"
      @code={{this.code.topbarBrandArg}}
    >
      <Woven::Topbar @brand="AALA.LAND">
        <:actions></:actions>
      </Woven::Topbar>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Search slot"
      @note="The search block renders between the brand and the end group, unwrapped."
      @layout="block"
      @code={{this.code.topbarSearch}}
    >
      <Woven::Topbar @brand="AALA.LAND">
        <:search>
          <Woven::Input @size="sm" @prefixIcon="⌕" @placeholder="Search" />
        </:search>
        <:actions>
          <Woven::Button @variant="ghost" @shape="square" @icon="bell" aria-label="Notifications" />
        </:actions>
      </Woven::Topbar>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="User block"
      @note="The user block replaces the name and role text with custom markup such as an avatar."
      @layout="block"
      @code={{this.code.topbarUserBlock}}
    >
      <Woven::Topbar @brand="AALA.LAND">
        <:actions></:actions>
        <:user>
          <Woven::Avatar @initials="TU" @size="sm" />
          <span class="wu-text sm">Test User</span>
        </:user>
      </Woven::Topbar>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Sticky"
      @note="sticky adds the kit pinned modifier: the bar sticks to the top of its scroll container with a shadow once stuck. The topbar of this site is pinned."
      @layout="block"
      @code={{this.code.topbarSticky}}
    >
      <Woven::Text @size="sm" @muted={{true}} @text="Scroll this page: the topbar stays in view." />
    </WovenDocs::Example>

    <h3 class="woven-subtitle">Topbar arguments</h3>
    <WovenDocs::Table @kind="args" @rows={{this.topbarArgRows}} />
    <h3 class="woven-subtitle">Topbar callbacks</h3>
    <WovenDocs::Table @kind="callbacks" @rows={{this.topbarCallbackRows}} />
    <h3 class="woven-subtitle">Topbar blocks</h3>
    <WovenDocs::Table @kind="blocks" @rows={{this.topbarBlockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>The sidebar renders a nav labeled by @label (default "Main"); the topbar renders a header. The toggle is a button labeled "Toggle navigation".</span></li>
      <li class="wu-list-item"><span>Mark the current link with aria-current="page". In the collapsed rail the label stays in the accessibility tree and shows as a tooltip on hover and focus.</span></li>
      <li class="wu-list-item"><span>SidebarLink is a native button; LinkTo links are anchors with hrefs, so middle-click and copy-link work.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>The sidebar is a flex sibling at the inline start, so the whole shell mirrors under dir="rtl". The mobile slide animates inset-inline-start.</span></li>
      <li class="wu-list-item"><span>Rail tooltips and the group chevron are inline-logical and mirror under dir="rtl".</span></li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
