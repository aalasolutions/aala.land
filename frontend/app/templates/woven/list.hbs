<WovenDocs::Page
  @id="list"
  @title="List and Description list"
  @subtitle="Ordered, unordered and term/description lists from data or markup."
  @components="Woven::List, Woven::DescList"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      Both components render from an
      <code class="wu-code">@items</code>
      array or from a block of hand-written items. The data form is quickest
      for plain text; the block form is for items that hold badges, links or
      other components. They render the CSS kit
      <code class="wu-code">wu-list</code>
      and
      <code class="wu-code">wu-desc-list</code>. For rows with actions use
      ListItem.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Ordered or unordered rows without markers; compact and divided styles.</span></li>
      <li class="wu-list-item"><span>Items as strings or label/icon objects.</span></li>
      <li class="wu-list-item"><span>Description list stacked, horizontal, divided, bordered or in columns.</span></li>
      <li class="wu-list-item"><span>Block form for custom item markup.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="List: data" @id="list-data">
    <WovenDocs::Example
      @title="Strings"
      @note="An array of strings becomes one row per string. The quickest way to show a few facts."
      @layout="stack"
      @code={{this.code.strings}}
    >
      <Woven::List @items={{this.unitList}} />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Objects with icons"
      @note="Objects with label and icon put an aria-hidden glyph before each title."
      @layout="stack"
      @code={{this.code.icons}}
    >
      <Woven::List @items={{this.iconList}} />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Block items"
      @note="Write the li elements yourself with the kit parts when items need a second line, a tag or a link. wu-list-body grows between leading and trailing content."
      @layout="stack"
      @code={{this.code.block}}
    >
      <Woven::List class="divided">
        <li class="wu-list-item">
          <div class="wu-list-body">
            <p class="wu-list-title">March rent</p>
            <p class="wu-list-text">Unit 1204, AED 8,500</p>
          </div>
          <Woven::Tag @variant="success" @text="Paid" />
        </li>
        <li class="wu-list-item">
          <div class="wu-list-body">
            <p class="wu-list-title">April rent</p>
            <p class="wu-list-text">Unit 1204, AED 8,500</p>
          </div>
          <Woven::Tag @variant="warning" @text="Due" />
        </li>
      </Woven::List>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="List: styles" @id="list-styles">
    <WovenDocs::Example
      @title="Ordered"
      @note="Rendered as an ol so the order is announced; the kit shows no numbers."
      @layout="stack"
      @code={{this.code.ordered}}
    >
      <Woven::List @items={{this.unitList}} @ordered={{true}} />
    </WovenDocs::Example>



    <WovenDocs::Example
      @title="Divided"
      @note="The kit divided modifier has no argument; pass it as a class for a line between rows."
      @layout="stack"
      @code={{this.code.divided}}
    >
      <Woven::List @items={{this.unitList}} class="divided" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Compact"
      @note="Kit sm: tighter row padding for sidebars and dense summaries."
      @layout="stack"
      @code={{this.code.compact}}
    >
      <Woven::List @items={{this.unitList}} @compact={{true}} />
    </WovenDocs::Example>

    <h3 class="woven-subtitle">List arguments</h3>
    <WovenDocs::Table @kind="args" @rows={{this.listArgRows}} />
    <h3 class="woven-subtitle">List blocks</h3>
    <WovenDocs::Table @kind="blocks" @rows={{this.listBlockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Description list" @id="desc-list">
    <WovenDocs::Example
      @title="Stacked"
      @note="Term above description, for detail panels read top to bottom."
      @layout="stack"
      @code={{this.code.desc}}
    >
      <Woven::DescList @items={{this.leaseDescItems}} />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Horizontal"
      @note="Term beside description in two columns, for wider summaries."
      @layout="stack"
      @code={{this.code.descHorizontal}}
    >
      <Woven::DescList @items={{this.leaseDescItems}} @horizontal={{true}} />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Bordered"
      @note="The kit bordered modifier, passed as a class: a table look with terms on the alternate background."
      @layout="stack"
      @code={{this.code.descBordered}}
    >
      <Woven::DescList @items={{this.leaseDescItems}} class="bordered" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Columns"
      @note="The kit columns modifier, passed as a class: several pairs per row."
      @layout="block"
      @code={{this.code.descColumns}}
    >
      <Woven::DescList @items={{this.leaseDescItems}} class="columns" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Block groups"
      @note="Write the groups yourself when a description holds a tag or a link; wrap each pair in a div."
      @layout="stack"
      @code={{this.code.descBlock}}
    >
      <Woven::DescList @horizontal={{true}} class="divided">
        <div>
          <dt>Status</dt>
          <dd><Woven::Tag @variant="success" @text="Active" /></dd>
        </div>
      </Woven::DescList>
    </WovenDocs::Example>

    <h3 class="woven-subtitle">Description list arguments</h3>
    <WovenDocs::Table @kind="args" @rows={{this.descArgRows}} />
    <h3 class="woven-subtitle">Description list blocks</h3>
    <WovenDocs::Table @kind="blocks" @rows={{this.descBlockRows}} />
    <h3 class="woven-subtitle">Raw classes</h3>
    <WovenDocs::Table @kind="classes" @rows={{this.classRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Real ul, ol and dl elements; lists carry role="list" so semantics survive without markers.</span></li>
      <li class="wu-list-item"><span>Item icons are aria-hidden; the label carries the meaning.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Rows are flex containers and the horizontal description layout is a grid, so both mirror with the reading direction.</span></li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
