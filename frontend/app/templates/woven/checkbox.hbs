<WovenDocs::Page
  @id="checkbox"
  @title="Checkbox, Radio, Toggle"
  @subtitle="Boolean and single-choice controls built on native inputs."
  @components="Woven::Checkbox, Woven::Radio, Woven::Toggle"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      Each control is a label element wrapping a native input, so clicking
      the text toggles the control and screen readers read the label
      without extra wiring. They render the CSS kit
      <code class="wu-code">wu-checkbox</code>,
      <code class="wu-code">wu-radio</code>
      and
      <code class="wu-code">wu-toggle</code>
      (a checkbox with role switch). Use a checkbox for a choice that is saved with
      the form, a toggle for a setting that applies at once, and radios for
      one pick out of a few. Radios are individual components; the caller
      owns the group value and derives each
      <code class="wu-code">@checked</code>
      from it.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Native inputs inside labels; disabled sets the real attribute.</span></li>
      <li class="wu-list-item"><span>Checkbox indeterminate state synced to the DOM property.</span></li>
      <li class="wu-list-item"><span>Radio reports its own value only when it becomes checked.</span></li>
      <li class="wu-list-item"><span>Three kit sizes on all three controls (sm, default, lg); xs renders sm.</span></li>
      <li class="wu-list-item"><span>Toggle with a brand track and a trailing label; the kit has no track colors or in-track text.</span></li>
      <li class="wu-list-item"><span>wu-check-group lays out a run of controls.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Checkbox" @id="checkbox-examples">
    <WovenDocs::Example
      @title="Controlled"
      @note="onChange reports the new boolean; store it and pass it back as checked. The label text is the click target."
      @code={{this.code.checkbox}}
    >
      <Woven::Checkbox @checked={{this.checkboxValue}} @label="Include archived units" @onChange={{this.updateCheckbox}} />
      <span class="wu-text sm muted" data-test-woven-checkbox-echo>Checked: {{this.checkboxValue}}</span>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Indeterminate"
      @note="The mixed state of a parent whose children are partly selected, such as a select-all header. It is a DOM property, synced on insert and on change."
      @code={{this.code.indeterminate}}
    >
      <Woven::Checkbox @indeterminate={{true}} @label="Some selected" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Disabled, checked"
      @note="A choice that is on and cannot be changed here, such as a permission inherited from a role."
      @code={{this.code.disabledChecked}}
    >
      <Woven::Checkbox @checked={{true}} @disabled={{true}} @label="Disabled checked" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Disabled, unchecked"
      @note="A choice that is off and not available on the current plan."
      @code={{this.code.disabledUnchecked}}
    >
      <Woven::Checkbox @disabled={{true}} @label="Disabled unchecked" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Without a visible label"
      @note="In a table cell the row is the label; pass aria-label through the attributes so the control still has a name."
      @code={{this.code.unlabeled}}
    >
      <Woven::Checkbox @checked={{true}} aria-label="Select row" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Sizes"
      @note="Kit sm, default and lg scale the font and so the box; xs renders sm. Pick the step that matches the inputs and buttons in the same row."
      @code={{this.code.checkboxSizes}}
    >
      <Woven::Checkbox @size="sm" @checked={{true}} @label="Small" data-test-woven-checkbox-size="sm" />
      <Woven::Checkbox @checked={{true}} @label="Default" data-test-woven-checkbox-size="md" />
      <Woven::Checkbox @size="lg" @checked={{true}} @label="Large" data-test-woven-checkbox-size="lg" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Group layout"
      @note="wu-check-group spaces a run of controls and wraps them on narrow screens. Use it for any set of checkboxes or radios."
      @layout="block"
      @code={{this.code.group}}
    >
      <div class="wu-check-group">
        <Woven::Checkbox @label="Parking" />
        <Woven::Checkbox @label="Pool" />
        <Woven::Checkbox @label="Gym" />
      </div>
    </WovenDocs::Example>

    <h3 class="woven-subtitle">Checkbox arguments</h3>
    <WovenDocs::Table @kind="args" @rows={{this.checkboxArgRows}} />
    <h3 class="woven-subtitle">Checkbox callbacks</h3>
    <WovenDocs::Table @kind="callbacks" @rows={{this.checkboxCallbackRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Radio" @id="radio">
    <WovenDocs::Example
      @title="Group with a shared name"
      @note="Each radio derives checked from the group value and reports its own value when chosen. The shared name makes arrow keys move between them natively."
      @layout="block"
      @code={{this.code.radio}}
    >
      <div class="wu-check-group">
        <Woven::Radio
          @name="property-type"
          @value="apartment"
          @checked={{eq this.radioValue "apartment"}}
          @label="Apartment"
          @onChange={{this.updateRadio}}
        />
        <Woven::Radio
          @name="property-type"
          @value="villa"
          @checked={{eq this.radioValue "villa"}}
          @label="Villa"
          @onChange={{this.updateRadio}}
        />
        <Woven::Radio
          @name="property-type"
          @value="townhouse"
          @checked={{eq this.radioValue "townhouse"}}
          @label="Townhouse"
          @onChange={{this.updateRadio}}
        />
      </div>
      <span class="wu-text sm muted" data-test-woven-radio-value>Selected: {{this.radioValue}}</span>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Disabled"
      @note="An option that exists but is not available, kept visible so the user knows it is there."
      @code={{this.code.radioDisabled}}
    >
      <Woven::Radio @name="property-type-disabled" @disabled={{true}} @label="Disabled" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Sizes"
      @note="The same three steps as Checkbox, so a radio set lines up with checkboxes of the same size."
      @code={{this.code.radioSizes}}
    >
      <Woven::Radio @name="radio-size-sm" @size="sm" @checked={{true}} @label="Small" data-test-woven-radio-size="sm" />
      <Woven::Radio @name="radio-size-md" @checked={{true}} @label="Default" data-test-woven-radio-size="md" />
      <Woven::Radio @name="radio-size-lg" @size="lg" @checked={{true}} @label="Large" data-test-woven-radio-size="lg" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Block label"
      @note="A block replaces the label text, for a title with a muted description beside it."
      @code={{this.code.radioBlock}}
    >
      <Woven::Radio @name="plan" @value="growth" @checked={{true}}>
        <strong>Growth</strong> <span class="wu-text sm muted">multi-region</span>
      </Woven::Radio>
    </WovenDocs::Example>

    <h3 class="woven-subtitle">Radio arguments</h3>
    <WovenDocs::Table @kind="args" @rows={{this.radioArgRows}} />
    <h3 class="woven-subtitle">Radio callbacks</h3>
    <WovenDocs::Table @kind="callbacks" @rows={{this.radioCallbackRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Toggle" @id="toggle">
    <WovenDocs::Example
      @title="Controlled"
      @note="A switch for a setting that applies as soon as it flips. onChange reports the new boolean."
      @code={{this.code.toggle}}
    >
      <Woven::Toggle @checked={{this.toggleValue}} @onChange={{this.updateToggle}} aria-label="Demo toggle" />
      <span class="wu-text sm muted" data-test-woven-toggle-echo>On: {{this.toggleValue}}</span>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Sizes"
      @note="Kit sm for settings lists and table cells, the default, and lg for a single prominent setting; xs renders sm."
      @code={{this.code.toggleSizes}}
    >
      <Woven::Toggle @checked={{this.toggleValue}} @size="sm" @onChange={{this.updateToggle}} data-test-woven-toggle-size="sm">Small</Woven::Toggle>
      <Woven::Toggle @checked={{this.toggleValue}} @onChange={{this.updateToggle}} data-test-woven-toggle-size="md">Default</Woven::Toggle>
      <Woven::Toggle @checked={{this.toggleValue}} @size="lg" @onChange={{this.updateToggle}} data-test-woven-toggle-size="lg">Large</Woven::Toggle>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Disabled"
      @note="Shows the current state without allowing a change, for settings locked by plan or role."
      @code={{this.code.toggleDisabled}}
    >
      <Woven::Toggle @disabled={{true}} @checked={{true}} aria-label="Disabled toggle" />
    </WovenDocs::Example>


    <WovenDocs::Example
      @title="Trailing label"
      @note="A block renders the label beside the track inside the label element, so it is the accessible name and the click target."
      @code={{this.code.toggleLabel}}
    >
      <Woven::Toggle @checked={{this.toggleValue}} @onChange={{this.updateToggle}}>
        Auto-assign leads
      </Woven::Toggle>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Toggle reference" @id="toggle-variants">
    <h3 class="woven-subtitle">Toggle arguments</h3>
    <WovenDocs::Table @kind="args" @rows={{this.toggleArgRows}} />
    <h3 class="woven-subtitle">Toggle callbacks</h3>
    <WovenDocs::Table @kind="callbacks" @rows={{this.toggleCallbackRows}} />
    <h3 class="woven-subtitle">Toggle blocks</h3>
    <WovenDocs::Table @kind="blocks" @rows={{this.toggleBlockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Raw classes" @id="classes">
    <WovenDocs::Table @kind="classes" @rows={{this.classRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>The input sits inside its label, so the label text is the accessible name and the click target.</span></li>
      <li class="wu-list-item"><span>A toggle without a block has no name; pass aria-label through ...attributes or wrap it in Woven::Field.</span></li>
      <li class="wu-list-item"><span>Radios in one set share @name so arrow keys move between them natively.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Label spacing uses inline gaps, so the control sits on the leading side in both directions.</span></li>
      <li class="wu-list-item"><span>The kit moves the toggle thumb toward the inline end when on, so it travels to the left under dir="rtl".</span></li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
