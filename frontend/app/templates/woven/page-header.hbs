<WovenDocs::Page
  @id="page-header"
  @title="Page header"
  @subtitle="Title block with breadcrumb, meta and actions slots."
  @components="Woven::PageHeader"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      The header at the top of a route. It owns the page h1 and gives the
      breadcrumb, supporting facts and primary actions fixed places so every
      page lines up. It renders the CSS kit
      <code class="wu-code">wu-page-header</code>. The header of this
      documentation page is one. Use it once per route, never inside a
      card.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Title and subtitle; the title carries no icon.</span></li>
      <li class="wu-list-item"><span>Breadcrumb, meta and actions slots.</span></li>
      <li class="wu-list-item"><span>Divided option: a rule under the header.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Title area" @id="title">
    <WovenDocs::Example
      @title="Title"
      @note="The h1 alone, for simple list pages."
      @layout="block"
      @code={{this.code.title}}
    >
      <Woven::PageHeader @title="Properties" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Subtitle"
      @note="A line of context under the title: a count, a location, a period."
      @layout="block"
      @code={{this.code.subtitle}}
    >
      <Woven::PageHeader @title="Marina Tower" @subtitle="42 units - Dubai Marina" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Bordered"
      @note="bordered adds the kit divided modifier: a rule under the header separates it from content that starts without its own surface."
      @layout="block"
      @code={{this.code.bordered}}
    >
      <Woven::PageHeader @title="Bordered" @subtitle="A rule under the header" @bordered={{true}} />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Slots" @id="slots">
    <WovenDocs::Example
      @title="Breadcrumb"
      @note="Detail pages only: a compact, parents-only Woven::Breadcrumb above the title. The current page is the title, never the last crumb. List pages have no breadcrumb."
      @layout="block"
      @code={{this.code.breadcrumb}}
    >
      <Woven::PageHeader @title="Marina Tower">
        <:breadcrumb>
          <Woven::Breadcrumb @items={{this.crumbs}} @compact={{true}} @parentsOnly={{true}} />
        </:breadcrumb>
      </Woven::PageHeader>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Meta"
      @note="Tags, badges and short facts beside the title: a status, a count, occupancy."
      @layout="block"
      @code={{this.code.meta}}
    >
      <Woven::PageHeader @title="Marina Tower" @subtitle="42 units - Dubai Marina">
        <:meta>
          <Woven::Tag @variant="success" @text="Active" />
          <span>Occupancy 91%</span>
        </:meta>
      </Woven::PageHeader>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Actions"
      @note="Primary and secondary page actions at the inline end. Keep it to two or three; move the rest into a dropdown."
      @layout="block"
      @code={{this.code.actions}}
    >
      <Woven::PageHeader @title="Marina Tower">
        <:actions>
          <Woven::Button @size="sm" @text="Export" />
          <Woven::Button @variant="brand" @size="sm" @text="Add Unit" />
        </:actions>
      </Woven::PageHeader>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Arguments" @id="arguments">
    <WovenDocs::Table @kind="args" @rows={{this.argRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Blocks" @id="blocks">
    <WovenDocs::Table @kind="blocks" @rows={{this.blockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Renders a header element with the title as h1. Use it once per route.</span></li>
      <li class="wu-list-item"><span>Use Woven::Breadcrumb in the breadcrumb slot for a navigable, labeled trail.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Actions sit at the inline end, so the layout mirrors with the reading direction.</span></li>
      <li class="wu-list-item"><span>Actions wrap below the title on narrow screens.</span></li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
