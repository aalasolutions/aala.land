<WovenDocs::Page
  @id="tag"
  @title="Tag"
  @subtitle="Compact label for categories and filters, optionally removable or selectable."
  @components="Woven::Tag"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      A tag renders the CSS kit
      <code class="wu-code">wu-tag</code>
      span with an optional
      <code class="wu-code">wu-tag-remove</code>
      button. Selection is not part of the component: a selectable chip is a
      real
      <code class="wu-code">button.wu-tag</code>
      with
      <code class="wu-code">aria-pressed</code>, so it stays keyboard-operable.
      Use tags for words a user attaches to a record or a status word; use a
      Badge for a count.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Five role colors (brand, success, warning, danger, info), a gray secondary and a neutral default.</span></li>
      <li class="wu-list-item"><span>One size; the kit has no tag sizes or outline style.</span></li>
      <li class="wu-list-item"><span>Closable form with a labeled remove button.</span></li>
      <li class="wu-list-item"><span>Disabled state disables the remove button and blocks the remove callback.</span></li>
      <li class="wu-list-item"><span>Checkable chip groups on native buttons with aria-pressed.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Variants" @id="variants">
    {{#each this.variantExamples as |example|}}
      <WovenDocs::Example @title={{example.title}} @note={{example.note}} @code={{example.code}}>
        <Woven::Tag @variant={{example.variant}} @text={{example.title}} />
      </WovenDocs::Example>
    {{/each}}
  </WovenDocs::Section>

  <WovenDocs::Section @title="Content" @id="content">
    <WovenDocs::Example
      @title="Block content"
      @note="A block replaces text, for an icon before the label."
      @code={{this.code.block}}
    >
      <Woven::Tag @variant="brand">
        <Woven::Icon @icon="car" /> Parking
      </Woven::Tag>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Removal" @id="removal">
    <WovenDocs::Example
      @title="Closable"
      @note="Adds a labeled remove button and reports through onClose; the caller drops the tag from its list. For editable attribute sets and active filter chips."
      @code={{this.code.closable}}
    >
      <Woven::Tag
        @variant="info"
        @closable={{true}}
        @text="Closable"
        @onClose={{fn this.noteClose "Closable"}}
      />
      <span class="wu-text sm muted" data-test-woven-tag-closed>Last closed: {{this.lastClosed}}</span>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Disabled"
      @note="Keeps the tag visible but disables the remove button and blocks the callback, for tags the current user may not change."
      @code={{this.code.disabled}}
    >
      <Woven::Tag @variant="danger" @disabled={{true}} @closable={{true}} @text="Disabled" />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Selectable chips" @id="chips">
    <WovenDocs::Example
      @title="Chip group"
      @note="Multi-select filters built on native button.wu-tag elements; aria-pressed drives both the kit selected look (brand tint, ring and check mark) and the announced state. Choose this over checkboxes when the choices are short words."
      @code={{this.code.chips}}
    >
      {{#each this.chipOptions as |chip|}}
        <button
          type="button"
          class="wu-tag"
          aria-pressed={{if (includes this.selectedChips chip) "true" "false"}}
          data-test-woven-chip={{chip}}
          {{on "click" (fn this.toggleChip chip)}}
        >{{chip}}</button>
      {{/each}}
    </WovenDocs::Example>
    <WovenDocs::Table @kind="classes" @rows={{this.classRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Arguments" @id="arguments">
    <WovenDocs::Table @kind="args" @rows={{this.argRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Callbacks" @id="callbacks">
    <WovenDocs::Table @kind="callbacks" @rows={{this.callbackRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Blocks" @id="blocks">
    <WovenDocs::Table @kind="blocks" @rows={{this.blockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>The remove control is a native button labeled "Remove tag" and carries the disabled attribute when the tag is disabled.</span></li>
      <li class="wu-list-item"><span>Selectable chips are native buttons; aria-pressed is the only selected state.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Label and remove button sit in a flex row spaced by gap, so the button trails the label in both directions.</span></li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
