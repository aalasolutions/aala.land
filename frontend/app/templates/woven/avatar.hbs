<WovenDocs::Page
  @id="avatar"
  @title="Avatar"
  @subtitle="Image, initials or icon representing a person, with an optional status dot."
  @components="Woven::Avatar, Woven::AvatarGroup"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      The avatar picks its content by precedence: image, then initials, then
      icon, so one invocation can be given all three and degrade on its own.
      It renders the CSS kit
      <code class="wu-code">wu-avatar</code>; AvatarGroup renders
      <code class="wu-code">wu-avatar-group</code>, which overlaps a run of
      avatars into one stack for assignees and participants. AvatarGroup takes
      no arguments.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Image, initials and icon sources with a fixed precedence.</span></li>
      <li class="wu-list-item"><span>Three sizes (sm, default, lg); circle or square tile.</span></li>
      <li class="wu-list-item"><span>Kit status dot: online, away, busy or offline.</span></li>
      <li class="wu-list-item"><span>Stacked groups with a ring between avatars.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Sources" @id="sources">
    <WovenDocs::Example
      @title="Image"
      @note="A photo wins over every other source. Always pass alt; an empty alt is right only when the name is already visible beside it."
      @code={{this.code.image}}
    >
      <Woven::Avatar @src="https://i.pravatar.cc/100?img=12" @alt="User avatar" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Initials"
      @note="Two letters on the kit avatar surface when there is no photo. The usual default for people records."
      @code={{this.code.initials}}
    >
      <Woven::Avatar @initials="AM" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Icon"
      @note="A glyph when neither photo nor initials exist: an anonymous user, a system actor, a placeholder before data loads."
      @code={{this.code.icon}}
    >
      <Woven::Avatar @icon="👤" />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Shape" @id="shape">
    <WovenDocs::Example
      @title="Square"
      @note="Rounded square instead of a circle. Use it for organizations and properties so they read differently from people."
      @code={{this.code.square}}
    >
      <Woven::Avatar @initials="SQ" @square={{true}} />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Sizes" @id="sizes">
    {{#each this.sizeExamples as |example|}}
      <WovenDocs::Example @title={{example.title}} @note={{example.note}} @code={{example.code}}>
        <Woven::Avatar @initials={{example.title}} @size={{example.size}} />
      </WovenDocs::Example>
    {{/each}}
  </WovenDocs::Section>

  <WovenDocs::Section @title="Status" @id="status">
    {{#each this.statusExamples as |example|}}
      <WovenDocs::Example @title={{example.title}} @note={{example.note}} @code={{example.code}}>
        <Woven::Avatar @initials="AM" @status={{example.status}} />
      </WovenDocs::Example>
    {{/each}}
  </WovenDocs::Section>

  <WovenDocs::Section @title="Groups" @id="groups">
    <WovenDocs::Example
      @title="Stacked"
      @note="Overlaps avatars into one row for assignees or participants. Order them by relevance; the first stays fully visible."
      @code={{this.code.group}}
    >
      <Woven::AvatarGroup>
        <Woven::Avatar @initials="AM" />
        <Woven::Avatar @initials="SQ" />
        <Woven::Avatar @initials="ON" />
        <Woven::Avatar @src="https://i.pravatar.cc/100?img=12" @alt="User avatar" />
      </Woven::AvatarGroup>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Overflow count"
      @note="Put the overflow count in a last avatar as real text. Give the group role group and a label so the stack reads as one unit."
      @code={{this.code.groupOverflow}}
    >
      <Woven::AvatarGroup role="group" aria-label="Assignees">
        <Woven::Avatar @initials="AM" @size="sm" />
        <Woven::Avatar @initials="SQ" @size="sm" />
        <Woven::Avatar @initials="+3" @size="sm" />
      </Woven::AvatarGroup>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Arguments" @id="arguments">
    <h3 class="woven-subtitle">Woven::Avatar</h3>
    <WovenDocs::Table @kind="args" @rows={{this.argRows}} />
    <p class="woven-note">Woven::AvatarGroup takes no arguments; attributes pass through to the wu-avatar-group element.</p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Always pass @alt with @src. Initials render as visible text; the icon fallback is aria-hidden.</span></li>
      <li class="wu-list-item"><span>The status dot is decorative and the avatar carries no role. State the presence in text, or pass role="img" and an aria-label that includes it.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>The status dot and the group overlap use logical insets and margins, so the stack mirrors with the reading direction.</span></li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
