<WovenDocs::Page
  @id="avatar"
  @title="Avatar"
  @subtitle="Image, initials or icon representing a person, with an optional status dot."
  @components="Woven::Avatar, Woven::AvatarGroup"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      The avatar picks its content by precedence: image, then initials, then
      icon, so one invocation can be given all three and degrade on its own.
      AvatarGroup overlaps a run of avatars into one stack for assignees and
      participants.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list">
      <li class="wu-list__item">Image, initials and icon sources with a fixed precedence.</li>
      <li class="wu-list__item">Five sizes; circle or square.</li>
      <li class="wu-list__item">Status dot in any of the six colours.</li>
      <li class="wu-list__item">Stacked groups, regular or compact.</li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Sources" @id="sources">
    <WovenDocs::Example
      @title="Image"
      @note="A photo wins over every other source. Always pass alt; an empty alt is right only when the name is already visible beside it."
      @code={{this.code.image}}
    >
      <Woven::Avatar @src="https://i.pravatar.cc/100?img=12" @alt="User avatar" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Initials"
      @note="Two letters on the variant surface when there is no photo. The usual default for people records."
      @code={{this.code.initials}}
    >
      <Woven::Avatar @initials="AM" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Icon"
      @note="A glyph when neither photo nor initials exist: an anonymous user, a system actor, a placeholder before data loads."
      @code={{this.code.icon}}
    >
      <Woven::Avatar @icon="👤" />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Shape" @id="shape">
    <WovenDocs::Example
      @title="Square"
      @note="Rounded square instead of a circle. Use it for organisations and properties so they read differently from people."
      @code={{this.code.square}}
    >
      <Woven::Avatar @initials="SQ" @square={{true}} />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Sizes" @id="sizes">
    {{#each this.sizeExamples as |example|}}
      <WovenDocs::Example @title={{example.title}} @note={{example.note}} @code={{example.code}}>
        <Woven::Avatar @initials={{example.title}} @size={{example.size}} />
      </WovenDocs::Example>
    {{/each}}
  </WovenDocs::Section>

  <WovenDocs::Section @title="Status" @id="status">
    {{#each this.statusExamples as |example|}}
      <WovenDocs::Example @title={{example.title}} @note={{example.note}} @code={{example.code}}>
        <Woven::Avatar @initials="AM" @status={{example.status}} />
      </WovenDocs::Example>
    {{/each}}
  </WovenDocs::Section>

  <WovenDocs::Section @title="Groups" @id="groups">
    <WovenDocs::Example
      @title="Stacked"
      @note="Overlaps avatars into one row for assignees or participants. Order them by relevance; the first stays fully visible."
      @code={{this.code.group}}
    >
      <Woven::AvatarGroup>
        <Woven::Avatar @initials="AM" />
        <Woven::Avatar @initials="SQ" />
        <Woven::Avatar @initials="ON" />
        <Woven::Avatar @src="https://i.pravatar.cc/100?img=12" @alt="User avatar" />
      </Woven::AvatarGroup>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Compact"
      @note="Tighter overlap for table cells and small sizes, where the regular spacing would take too much width."
      @code={{this.code.groupCompact}}
    >
      <Woven::AvatarGroup @compact={{true}}>
        <Woven::Avatar @initials="AM" @size="sm" />
        <Woven::Avatar @initials="SQ" @size="sm" />
        <Woven::Avatar @initials="ON" @size="sm" />
      </Woven::AvatarGroup>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Arguments" @id="arguments">
    <h3 class="woven-subtitle">Woven::Avatar</h3>
    <WovenDocs::Table @kind="args" @rows={{this.argRows}} />
    <h3 class="woven-subtitle">Woven::AvatarGroup</h3>
    <WovenDocs::Table @kind="args" @rows={{this.groupArgRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list">
      <li class="wu-list__item">Always pass @alt with @src. Initials render as visible text; the icon fallback is aria-hidden.</li>
      <li class="wu-list__item">The status dot is decorative. State the presence in text or a tooltip on the surrounding control.</li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list">
      <li class="wu-list__item">The status dot and the group overlap use logical insets and margins, so the stack mirrors with the reading direction.</li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
