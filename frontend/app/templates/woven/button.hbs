<WovenDocs::Page
  @id="button"
  @title="Button"
  @subtitle="Triggers an action, submits a form, or links to a route."
  @components="Woven::Button, Woven::BtnGroup"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      One component renders a native button, an anchor or a LinkTo depending
      on the arguments, and all three share the same inner layout so they
      cannot drift apart. Loading folds into the icon slot and implies
      disabled. Pick the variant by what the action means, the size by the
      density of its surroundings.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list">
      <li class="wu-list__item">Eight variants, four sizes, outline and block forms.</li>
      <li class="wu-list__item">Icon at the start or end; Phosphor names or literal glyphs.</li>
      <li class="wu-list__item">Square and circle icon-only shapes that drop the label.</li>
      <li class="wu-list__item">Loading state swaps the icon for a spinner and disables the control.</li>
      <li class="wu-list__item">Route and href modes render a LinkTo or an anchor with the same classes.</li>
      <li class="wu-list__item">BtnGroup joins buttons, attached or spaced.</li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Variants" @id="variants">
    {{#each this.variantExamples as |example|}}
      <WovenDocs::Example @title={{example.title}} @note={{example.note}} @code={{example.code}}>
        <Woven::Button @variant={{example.variant}} @text={{example.title}} />
      </WovenDocs::Example>
    {{/each}}

    <WovenDocs::Example
      @title="Outline"
      @note="Transparent fill with the variant's border and text colour. Use it for the second action beside a filled button of the same colour, or for a set of equal-weight choices."
      @code={{this.code.outline}}
    >
      <Woven::Button @variant="primary" @outline={{true}} @text="Outline" />
      <Woven::Button @variant="danger" @outline={{true}} @text="Outline" />
      <Woven::Button @variant="success" @outline={{true}} @text="Outline" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Subtle"
      @note="No border or fill and a muted colour at rest; the variant colour and a light tint appear on hover. Use it for dense rows of icon actions, such as table-row actions."
      @code={{this.code.subtle}}
    >
      <Woven::Button @variant="secondary" @subtle={{true}} @icon="pencil-simple" aria-label="Edit" />
      <Woven::Button @variant="success" @subtle={{true}} @icon="check" aria-label="Approve" />
      <Woven::Button @variant="danger" @subtle={{true}} @icon="trash" aria-label="Delete" />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Sizes" @id="sizes">
    {{#each this.sizeExamples as |example|}}
      <WovenDocs::Example @title={{example.title}} @note={{example.note}} @code={{example.code}}>
        <Woven::Button @variant="primary" @size={{example.size}} @text={{example.title}} />
      </WovenDocs::Example>
    {{/each}}
  </WovenDocs::Section>

  <WovenDocs::Section @title="Shapes" @id="shapes">
    <WovenDocs::Example
      @title="Square"
      @note="Icon-only, same height as a text button, square corners. For toolbar and table-row actions that line up with text buttons. The label is dropped, so aria-label carries the name."
      @code={{this.code.square}}
    >
      <Woven::Button @variant="primary" @shape="square" @icon="plus" aria-label="Add" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Circle"
      @note="Icon-only, fully round. For floating or standalone controls such as close, dismiss and avatar actions."
      @code={{this.code.circle}}
    >
      <Woven::Button @variant="secondary" @shape="circle" @icon="x" aria-label="Close" />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Icons" @id="icons">
    <WovenDocs::Example
      @title="Icon before the label"
      @note="A lowercase kebab-case name is a Phosphor icon. Lead with an icon when the glyph is recognised faster than the word: add, search, filter."
      @code={{this.code.iconStart}}
    >
      <Woven::Button @variant="primary" @icon="plus" @text="Add unit" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Icon after the label"
      @note="iconPosition end suits forward motion: next, continue, open in new tab. Directional icons mirror under RTL automatically."
      @code={{this.code.iconEnd}}
    >
      <Woven::Button @variant="secondary" @icon="arrow-right" @iconPosition="end" @text="Next" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Literal glyph"
      @note="Anything that is not a kebab-case name renders as text in the icon slot. Use it for a character that has no icon, or in a fixture that must not load the font."
      @code={{this.code.glyph}}
    >
      <Woven::Button @variant="secondary" @icon="+" @text="Literal glyph" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Custom loading icon"
      @note="loadingIcon replaces the default spinner-gap while loading. Keep the default unless the brand asks for a specific spinner."
      @code={{this.code.loadingIcon}}
    >
      <Woven::Button @variant="secondary" @loading={{true}} @loadingIcon="circle-notch" @text="Custom spinner" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Custom icon with the :icon slot"
      @note="The :icon block replaces the built-in icon entirely, so a host can pass its own SVG or icon component instead of a Phosphor name. Supplying the block means the label moves into :default. @icon keeps working when no block is given."
      @code={{this.code.iconSlot}}
    >
      <Woven::Button @variant="primary">
        <:icon>
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <circle cx="7" cy="7" r="6" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
        </:icon>
        <:default>Custom icon</:default>
      </Woven::Button>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Loading still wins over the slot"
      @note="A supplied :icon never replaces the spinner. While @loading is set the button shows its spinner and stays disabled, so a caller's icon cannot hide the busy state."
      @code={{this.code.iconSlotLoading}}
    >
      <Woven::Button @variant="primary" @loading={{true}}>
        <:icon>
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <circle cx="7" cy="7" r="6" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
        </:icon>
        <:default>Saving</:default>
      </Woven::Button>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="States" @id="states">
    <WovenDocs::Example
      @title="Disabled"
      @note="Sets the real disabled attribute and drops onClick. Use it when the action is impossible right now; explain why nearby, because a disabled button receives no tooltip on its own."
      @code={{this.code.disabled}}
    >
      <Woven::Button @variant="primary" @disabled={{true}} @text="Disabled" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Loading"
      @note="The icon slot becomes a spinner and the button disables itself, so a double submit is impossible. Swap the label to the in-progress verb while it runs."
      @code={{this.code.loading}}
    >
      <Woven::Button
        @variant="primary"
        @loading={{this.loadingDemo}}
        @text={{if this.loadingDemo "Saving" "Click to load"}}
        @onClick={{this.toggleLoading}}
        data-test-woven-loading-demo
      />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Active"
      @note="Pressed appearance without changing the variant. For toggles and the selected member of an attached group; set aria-pressed alongside it."
      @code={{this.code.active}}
    >
      <Woven::Button @variant="secondary" @active={{true}} @text="Active" aria-pressed="true" />
      <Woven::Button @variant="secondary" @text="Inactive" aria-pressed="false" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Block"
      @note="Full width of its container, for mobile forms and stacked dialog footers. The argument is @block; this demo applies the resulting is-block class because the project lint reserves the name."
      @layout="stack"
      @code={{this.code.block}}
    >
      <Woven::Button @variant="secondary" @text="Full width" class="is-block" />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Modes" @id="modes">
    <WovenDocs::Example
      @title="Submit"
      @note="type submit inside a form triggers the form's submit handler on click and on Enter in any field. Every other button defaults to type button so it never submits by accident."
      @code={{this.code.submit}}
    >
      <Woven::Button @type="submit" @variant="primary" @text="Save" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Route"
      @note="route renders a LinkTo with the button classes, so navigation stays a real link: hover shows the URL, middle-click opens a tab. model, models and query pass through."
      @code={{this.code.route}}
    >
      <Woven::Button @route="woven.index" @variant="link" @text="Overview" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Href"
      @note="href renders an anchor for external or in-page links that are outside the router."
      @code={{this.code.href}}
    >
      <Woven::Button @href="#examples" @variant="secondary" @text="Anchor to this section" />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Button group" @id="group">
    <WovenDocs::Example
      @title="Spaced"
      @note="A row of related buttons with a consistent gap. Use it for independent actions that belong together, such as export and print."
      @code={{this.code.groupSpaced}}
    >
      <Woven::BtnGroup>
        <Woven::Button @variant="secondary" @text="Left" />
        <Woven::Button @variant="secondary" @text="Middle" />
        <Woven::Button @variant="secondary" @text="Right" />
      </Woven::BtnGroup>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Attached"
      @note="Shared borders make one segmented bar. Use it for mutually exclusive choices and mark the current one with active; for a value-setting control prefer Segmented."
      @code={{this.code.groupAttached}}
    >
      <Woven::BtnGroup @attached={{true}}>
        <Woven::Button @variant="secondary" @text="Day" />
        <Woven::Button @variant="secondary" @active={{true}} @text="Week" />
        <Woven::Button @variant="secondary" @text="Month" />
      </Woven::BtnGroup>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Attached icon pair"
      @note="Two square icon buttons joined into a stepper. The caret icons mirror under RTL so previous always points backwards in reading order."
      @code={{this.code.groupIcons}}
    >
      <Woven::BtnGroup @attached={{true}}>
        <Woven::Button @variant="secondary" @shape="square" @icon="caret-left" aria-label="Previous" />
        <Woven::Button @variant="secondary" @shape="square" @icon="caret-right" aria-label="Next" />
      </Woven::BtnGroup>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Arguments" @id="arguments">
    <h3 class="woven-subtitle">Woven::Button</h3>
    <WovenDocs::Table @kind="args" @rows={{this.argRows}} />
    <h3 class="woven-subtitle">Woven::BtnGroup</h3>
    <WovenDocs::Table @kind="args" @rows={{this.groupArgRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Callbacks" @id="callbacks">
    <WovenDocs::Table @kind="callbacks" @rows={{this.callbackRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Blocks" @id="blocks">
    <WovenDocs::Table @kind="blocks" @rows={{this.blockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list">
      <li class="wu-list__item">Button mode renders a native button with an explicit type; disabled and loading set the real disabled attribute.</li>
      <li class="wu-list__item">Icons are aria-hidden. Square and circle shapes drop the label, so pass aria-label for the accessible name.</li>
      <li class="wu-list__item">A tooltip on a disabled button never fires because disabled buttons receive no pointer events; wrap the button in a span carrying data-tooltip.</li>
      <li class="wu-list__item">Keyboard focus shows the kit focus ring; it is never removed without a replacement.</li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list">
      <li class="wu-list__item">Icon spacing uses inline margins, so start and end positions mirror with the reading direction.</li>
      <li class="wu-list__item">Phosphor icons named left or right (caret-left, arrow-right) are mirrored automatically under dir="rtl".</li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
