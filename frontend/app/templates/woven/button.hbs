<WovenDocs::Page
  @id="button"
  @title="Button"
  @subtitle="Triggers an action, submits a form, or links to a route."
  @components="Woven::Button, Woven::BtnGroup"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      One component renders a native button, an anchor or a LinkTo depending
      on the arguments, and all three share the same inner layout so they
      cannot drift apart. Loading folds into the icon slot and implies
      disabled. Pick the variant by what the action means, the size by the
      density of its surroundings.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Renders the CSS kit wu-btn: default, brand, danger, quiet and link looks, a subtle tint for brand and danger, sm and lg sizes.</span></li>
      <li class="wu-list-item"><span>Icon at the start or end; Phosphor names or literal glyphs.</span></li>
      <li class="wu-list-item"><span>Square and circle icon-only shapes that drop the label.</span></li>
      <li class="wu-list-item"><span>Loading shows a kit spinner, sets aria-busy and disables the control.</span></li>
      <li class="wu-list-item"><span>Route and href modes render a LinkTo or an anchor with the same classes.</span></li>
      <li class="wu-list-item"><span>BtnGroup joins buttons, attached or spaced.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Variants" @id="variants">
    {{#each this.variantExamples as |example|}}
      <WovenDocs::Example @title={{example.title}} @note={{example.note}} @code={{example.code}}>
        <Woven::Button @variant={{example.variant}} @text={{example.title}} />
      </WovenDocs::Example>
    {{/each}}

    <WovenDocs::Example
      @title="Subtle"
      @note="The subtle argument adds the kit subtle modifier: with brand or danger it gives a tinted fill and border that turns solid on hover. Use it for a second action of the same role beside a solid one."
      @code={{this.code.subtle}}
    >
      <Woven::Button @variant="brand" @subtle={{true}} @text="Approve" />
      <Woven::Button @variant="danger" @subtle={{true}} @icon="trash" @text="Delete" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Secondary"
      @note="Kept for older callers: secondary maps to the kit subtle modifier, which has no rule without brand or danger, so it renders the default look. success, warning and info have no kit button and render the default look too."
      @code={{this.code.secondary}}
    >
      <Woven::Button @variant="secondary" @text="Secondary" />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Sizes" @id="sizes">
    {{#each this.sizeExamples as |example|}}
      <WovenDocs::Example @title={{example.title}} @note={{example.note}} @code={{example.code}}>
        <Woven::Button @variant="brand" @size={{example.size}} @text={{example.title}} />
      </WovenDocs::Example>
    {{/each}}
  </WovenDocs::Section>

  <WovenDocs::Section @title="Shapes" @id="shapes">
    <WovenDocs::Example
      @title="Square"
      @note="Icon-only, same height as a text button, square corners. For toolbar and table-row actions that line up with text buttons. The label is dropped, so aria-label carries the name."
      @code={{this.code.square}}
    >
      <Woven::Button @variant="brand" @shape="square" @icon="plus" aria-label="Add" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Circle"
      @note="Icon-only, fully round. For floating or standalone controls such as close, dismiss and avatar actions."
      @code={{this.code.circle}}
    >
      <Woven::Button @shape="circle" @icon="x" aria-label="Close" />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Icons" @id="icons">
    <WovenDocs::Example
      @title="Icon before the label"
      @note="A lowercase kebab-case name is a Phosphor icon. Lead with an icon when the glyph is recognized faster than the word: add, search, filter."
      @code={{this.code.iconStart}}
    >
      <Woven::Button @variant="brand" @icon="plus" @text="Add unit" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Icon after the label"
      @note="iconPosition end suits forward motion: next, continue, open in new tab. Directional icons mirror under RTL automatically."
      @code={{this.code.iconEnd}}
    >
      <Woven::Button @icon="arrow-right" @iconPosition="end" @text="Next" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Literal glyph"
      @note="Anything that is not a kebab-case name renders as text in the icon slot. Use it for a character that has no icon, or in a fixture that must not load the font."
      @code={{this.code.glyph}}
    >
      <Woven::Button @icon="+" @text="Literal glyph" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Custom icon with the :icon slot"
      @note="The :icon block replaces the built-in icon entirely, so a host can pass its own SVG or icon component instead of a Phosphor name. Supplying the block means the label moves into :default. @icon keeps working when no block is given."
      @code={{this.code.iconSlot}}
    >
      <Woven::Button @variant="brand">
        <:icon>
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <circle cx="7" cy="7" r="6" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
        </:icon>
        <:default>Custom icon</:default>
      </Woven::Button>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Loading still wins over the slot"
      @note="A supplied :icon never replaces the spinner. While @loading is set the button shows its spinner and stays disabled, so a caller's icon cannot hide the busy state."
      @code={{this.code.iconSlotLoading}}
    >
      <Woven::Button @variant="brand" @loading={{true}}>
        <:icon>
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <circle cx="7" cy="7" r="6" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
        </:icon>
        <:default>Saving</:default>
      </Woven::Button>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="States" @id="states">
    <WovenDocs::Example
      @title="Disabled"
      @note="Sets the real disabled attribute and drops onClick. Use it when the action is impossible right now; explain why nearby, because a disabled button receives no tooltip on its own."
      @code={{this.code.disabled}}
    >
      <Woven::Button @variant="brand" @disabled={{true}} @text="Disabled" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Loading"
      @note="The icon slot becomes a kit spinner, aria-busy is set and the button disables itself, so a double submit is impossible. Swap the label to the in-progress verb while it runs."
      @code={{this.code.loading}}
    >
      <Woven::Button
        @variant="brand"
        @loading={{this.loadingDemo}}
        @text={{if this.loadingDemo "Saving" "Click to load"}}
        @onClick={{this.toggleLoading}}
        data-test-woven-loading-demo
      />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Active"
      @note="The active argument sets aria-pressed, which the kit styles as pressed. For toggles and the selected member of an attached group. Leave it unset on plain buttons so they carry no toggle state."
      @code={{this.code.active}}
    >
      <Woven::Button @active={{true}} @text="Active" />
      <Woven::Button @active={{false}} @text="Inactive" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Block"
      @note="Full width of its container through the core w-full utility, for mobile forms and stacked dialog footers. This demo passes the class because the project template lint reserves the block argument name."
      @layout="block"
      @code={{this.code.block}}
    >
      <Woven::Button @text="Full width" class="w-full" />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Modes" @id="modes">
    <WovenDocs::Example
      @title="Submit"
      @note="type submit inside a form triggers the form's submit handler on click and on Enter in any field. Every other button defaults to type button so it never submits by accident."
      @code={{this.code.submit}}
    >
      <Woven::Button @type="submit" @variant="brand" @text="Save" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Route"
      @note="route renders a LinkTo with the button classes, so navigation stays a real link: hover shows the URL, middle-click opens a tab. model, models and query pass through."
      @code={{this.code.route}}
    >
      <Woven::Button @route="woven.index" @variant="link" @text="Overview" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Href"
      @note="href renders an anchor for external or in-page links that are outside the router."
      @code={{this.code.href}}
    >
      <Woven::Button @href="#variants" @text="Jump to variants" />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Button group" @id="group">
    <WovenDocs::Example
      @title="Spaced"
      @note="A row of related buttons with a consistent gap. Use it for independent actions that belong together, such as export and print."
      @code={{this.code.groupSpaced}}
    >
      <Woven::BtnGroup>
        <Woven::Button @text="Left" />
        <Woven::Button @text="Middle" />
        <Woven::Button @text="Right" />
      </Woven::BtnGroup>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Attached"
      @note="Shared borders make one segmented bar. Use it for mutually exclusive choices and mark the current one with active; for a value-setting control prefer Segmented."
      @code={{this.code.groupAttached}}
    >
      <Woven::BtnGroup @attached={{true}}>
        <Woven::Button @text="Day" />
        <Woven::Button @active={{true}} @text="Week" />
        <Woven::Button @text="Month" />
      </Woven::BtnGroup>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Attached icon pair"
      @note="Two square icon buttons joined into a stepper. The caret icons mirror under RTL so previous always points backwards in reading order."
      @code={{this.code.groupIcons}}
    >
      <Woven::BtnGroup @attached={{true}}>
        <Woven::Button @shape="square" @icon="caret-left" aria-label="Previous" />
        <Woven::Button @shape="square" @icon="caret-right" aria-label="Next" />
      </Woven::BtnGroup>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Arguments" @id="arguments">
    <h3 class="woven-subtitle">Woven::Button</h3>
    <WovenDocs::Table @kind="args" @rows={{this.argRows}} />
    <h3 class="woven-subtitle">Woven::BtnGroup</h3>
    <WovenDocs::Table @kind="args" @rows={{this.groupArgRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Callbacks" @id="callbacks">
    <WovenDocs::Table @kind="callbacks" @rows={{this.callbackRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Blocks" @id="blocks">
    <WovenDocs::Table @kind="blocks" @rows={{this.blockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Button mode renders a native button with an explicit type; disabled and loading set the real disabled attribute.</span></li>
      <li class="wu-list-item"><span>Icons are aria-hidden. Square and circle shapes drop the label, so pass aria-label for the accessible name.</span></li>
      <li class="wu-list-item"><span>A tooltip on a disabled button never fires because disabled buttons receive no pointer events; wrap the button in a span carrying data-tooltip.</span></li>
      <li class="wu-list-item"><span>Keyboard focus shows the kit focus ring; it is never removed without a replacement.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Icon spacing uses inline margins, so start and end positions mirror with the reading direction.</span></li>
      <li class="wu-list-item"><span>Phosphor icons named left or right (caret-left, arrow-right) are mirrored automatically under dir="rtl".</span></li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
