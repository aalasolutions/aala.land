<WovenDocs::Page
  @id="card"
  @title="Card, Stat, Info row, List item"
  @subtitle="Surfaces and rows that group related content."
  @components="Woven::Card, Woven::Stat, Woven::InfoRow, Woven::ListItem"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      Card renders the CSS kit
      <code class="wu-code">wu-card</code>
      with optional header, body and footer parts. Stat is one figure
      (<code class="wu-code">wu-stat</code>), InfoRow a label and value line
      (<code class="wu-code">wu-info-row</code>), and ListItem a
      <code class="wu-code">wu-list-item</code>
      row with main content and trailing actions. Kit parts are thin: a stat
      is not a card, so pages put a stat inside a card. Reach for Panel
      instead of Card for a flat settings or data region.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Card header from arguments or a named block; body from a named or default block; footer slot.</span></li>
      <li class="wu-list-item"><span>One card look; the kit has no compact, flat, raised, accent or selected styles.</span></li>
      <li class="wu-list-item"><span>Stat with label, value and change line; success or danger change line; three value sizes; link modes.</span></li>
      <li class="wu-list-item"><span>InfoRow value from an argument or a block.</span></li>
      <li class="wu-list-item"><span>ListItem with main and actions slots.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Card: header and slots" @id="card-slots">
    <WovenDocs::Example
      @title="Title"
      @note="A title alone renders the header; the default block becomes the body. The everyday card."
      @code={{this.code.title}}
    >
      <Woven::Card @title="Marina Tower">
        <p class="wu-text sm muted">Sea-facing unit, fully furnished.</p>
      </Woven::Card>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Title and subtitle"
      @note="The subtitle carries a secondary fact under the title, such as the unit or the period."
      @code={{this.code.subtitle}}
    >
      <Woven::Card @title="Marina Tower" @subtitle="Unit 204 · 2BR">
        <p class="wu-text sm muted">
          Sea-facing unit, fully furnished, tenant on a 12-month lease.
        </p>
      </Woven::Card>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Header block"
      @note="Replaces the title area with your own markup when the header needs a badge, an avatar or a menu."
      @code={{this.code.headerBlock}}
    >
      <Woven::Card>
        <:header>
          <h3 class="wu-card-title">Custom header</h3>
          <Woven::Tag @variant="success" @text="Active" />
        </:header>
        <:body>Body content.</:body>
      </Woven::Card>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Body and footer blocks"
      @note="Named body and footer slots give actions a fixed place at the bottom; the footer aligns them to the end."
      @code={{this.code.slots}}
    >
      <Woven::Card @title="Occupancy" @subtitle="This month">
        <:body>
          <p class="wu-text sm muted">Named-block body content.</p>
        </:body>
        <:footer>
          <Woven::Button @size="sm" @text="View report" />
        </:footer>
      </Woven::Card>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Card: link and reference" @id="card-link">
    <WovenDocs::Example
      @title="Whole card as a link"
      @note="Put the kit wu-card-link class on the one real link, usually in the title; it stretches over the whole card while other controls stay clickable above it."
      @code={{this.code.linked}}
    >
      <Woven::Card>
        <h3 class="wu-card-title">
          <a class="wu-card-link" href="#card-slots">Marina Tower</a>
        </h3>
        <p class="wu-text sm muted">The whole card is one link target.</p>
      </Woven::Card>
    </WovenDocs::Example>

    <h3 class="woven-subtitle">Card arguments</h3>
    <WovenDocs::Table @kind="args" @rows={{this.cardArgRows}} />
    <h3 class="woven-subtitle">Card blocks</h3>
    <WovenDocs::Table @kind="blocks" @rows={{this.cardBlockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Stat" @id="stat">
    {{#each this.statExamples as |example|}}
      <WovenDocs::Example @title={{example.title}} @note={{example.note}} @code={{example.code}}>
        <Woven::Stat @variant={{example.variant}} @label="Occupied units" @value="184" @delta="+4 this month" />
      </WovenDocs::Example>
    {{/each}}

    <WovenDocs::Example
      @title="Stat inside a card"
      @note="The kit stat is a value and a label, not a tile. Compose it inside a Card for a KPI tile."
      @code={{this.code.statInCard}}
    >
      <Woven::Card>
        <Woven::Stat @variant="success" @label="Occupancy rate" @value="94%" @delta="+2.1% this month" />
      </Woven::Card>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Sizes"
      @note="Kit sm and lg change the value size."
      @code={{this.code.statSizes}}
    >
      <Woven::Stat @size="sm" @label="Small" @value="37" />
      <Woven::Stat @label="Default" @value="37" />
      <Woven::Stat @size="lg" @label="Large" @value="37" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Link"
      @note="route renders the stat as a LinkTo and href as an anchor, for a figure that opens its list."
      @code={{this.code.statRoute}}
    >
      <Woven::Stat @route="woven.card" @label="Open leases" @value="37" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Label and value only"
      @note="Icon and delta are optional; the value is always rendered."
      @code={{this.code.statBare}}
    >
      <Woven::Stat @label="Leases" @value="37" />
    </WovenDocs::Example>

    <h3 class="woven-subtitle">Stat arguments</h3>
    <WovenDocs::Table @kind="args" @rows={{this.statArgRows}} />
    <h3 class="woven-subtitle">Stat blocks</h3>
    <WovenDocs::Table @kind="blocks" @rows={{this.statBlockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Info row" @id="info-row">
    <WovenDocs::Example
      @title="Label and value"
      @note="One fact per row inside a card, for summaries and detail panels."
      @layout="block"
      @code={{this.code.infoRow}}
    >
      <Woven::Card @title="Lease Summary">
        <Woven::InfoRow @label="Tenant" @value="Ahmed Khalid" />
        <Woven::InfoRow @label="Unit" @value="Marina Tower, 204" />
        <Woven::InfoRow @label="Rent" @value="AED 8,500/mo" />
      </Woven::Card>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Block value"
      @note="A block replaces the plain value with a badge, a link or a button."
      @layout="block"
      @code={{this.code.infoRowBlock}}
    >
      <Woven::Card @title="Lease">
        <Woven::InfoRow @label="Lease ends">
          <Woven::Badge @variant="warning" @text="42 days left" />
        </Woven::InfoRow>
      </Woven::Card>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Total row"
      @note="The total modifier has no argument: a strong line above and a larger value."
      @layout="block"
      @code={{this.code.infoRowClasses}}
    >
      <Woven::Card @title="Modifiers">
        <Woven::InfoRow @label="Rent" @value="AED 120,000" />
        <Woven::InfoRow @label="Total" @value="AED 129,600" class="total" />
      </Woven::Card>
    </WovenDocs::Example>

    <h3 class="woven-subtitle">Info row arguments</h3>
    <WovenDocs::Table @kind="args" @rows={{this.infoRowArgRows}} />
    <h3 class="woven-subtitle">Info row blocks</h3>
    <WovenDocs::Table @kind="blocks" @rows={{this.infoRowBlockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="List item" @id="list-item">
    <WovenDocs::Example
      @title="Main and actions"
      @note="A row with content that fills and controls that trail, for pick lists and assignment panels."
      @layout="block"
      @code={{this.code.listItem}}
    >
      {{#each this.units as |unit|}}
        <Woven::ListItem>
          <:main>
            <div>
              <p class="wu-text sm">{{unit.name}}</p>
              <p class="wu-text sm muted">{{unit.tenant}} · {{unit.rent}}</p>
            </div>
          </:main>
          <:actions>
            <Woven::Button
              @variant={{if (eq this.selectedUnitId unit.id) "brand"}}
              @size="sm"
              @text={{if (eq this.selectedUnitId unit.id) "Selected" "Select"}}
              @onClick={{fn this.selectUnit unit.id}}
              data-test-woven-select-unit={{unit.id}}
            />
          </:actions>
        </Woven::ListItem>
      {{/each}}
    </WovenDocs::Example>

    <h3 class="woven-subtitle">List item blocks</h3>
    <WovenDocs::Table @kind="blocks" @rows={{this.listItemBlockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Raw classes" @id="classes">
    <p class="woven-note">Modifiers the stylesheets ship with no matching argument. Pass them through <code>class</code>.</p>
    <WovenDocs::Table @kind="classes" @rows={{this.classRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>The card title is an h3. Keep one h2 above a group of cards so the heading outline stays in order.</span></li>
      <li class="wu-list-item"><span>A linked card keeps one real link (wu-card-link), so keyboard and screen reader users get a single named target.</span></li>
      <li class="wu-list-item"><span>Keep the signed number as text in the stat change line; color never replaces it.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Header, InfoRow and ListItem are flex rows with logical gaps, so labels lead and actions trail in both directions.</span></li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
