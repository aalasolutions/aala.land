<WovenDocs::Page
  @id="modal"
  @title="Modal"
  @subtitle="Native dialog with backdrop, focus trap and scroll lock."
  @components="Woven::Modal"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      The modal is a native dialog, rendered where it is used and opened
      with showModal() only while @open is true. The dialog modifier locks
      page scroll, traps Tab, focuses the first control, turns Escape (the
      cancel event) into onClose, and restores focus to the opener on close.
      It renders the CSS kit
      <code class="wu-code">wu-modal</code>
      and ends with its own empty
      <code class="wu-code">wu-layer</code>: menus, popovers and tooltips
      opened inside it resolve the nearest open dialog's layer through the
      layer service and render there, because a modal dialog makes the rest
      of the page inert. Use a
      modal for a task that must finish before the page continues; use a
      drawer for a side task that keeps the page in view.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Kit sm, default and lg widths plus full; the body scrolls under a pinned header and footer.</span></li>
      <li class="wu-list-item"><span>Backdrop click, Escape and close button, each individually switchable.</span></li>
      <li class="wu-list-item"><span>Kit animated modifier on by default: fades and scales in when the user allows motion, resting at scale none so overlays inside are not clipped. @animated false turns it off.</span></li>
      <li class="wu-list-item"><span>Custom header block that receives the title id.</span></li>
      <li class="wu-list-item"><span>Stacked dialogs: Escape and the Tab trap apply to the topmost only.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Basic" @id="basic">
    <WovenDocs::Example
      @title="Header, body, footer"
      @note="Title and subtitle in the header, body content, and an action row. The opener sets open; every close path reports through onClose."
      @code={{this.code.basic}}
    >
      <Woven::Button @text="Open modal" @onClick={{this.openModal}} data-test-open-modal />

      <Woven::Modal
        @open={{this.modalOpen}}
        @title="Cancel lease?"
        @subtitle="Unit 1204, Marina Tower"
        @size="md"
        @onClose={{this.closeModal}}
      >
        <:body>
          <Woven::Text @text="This will end the lease for Ahmed Khalid effective today. Post-dated cheques on file will need to be voided manually." />
        </:body>
        <:footer>
          <Woven::Button @text="Keep lease" @onClick={{this.closeModal}} />
          <Woven::Button @text="Cancel lease" @variant="danger" @onClick={{this.closeModal}} />
        </:footer>
      </Woven::Modal>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Sizes" @id="sizes">
    {{#each this.sizeExamples as |example|}}
      <WovenDocs::Example @title={{example.title}} @note={{example.note}} @code={{example.code}}>
        <Woven::Button
          @text="Open {{example.size}}"
          @onClick={{fn this.openSizedModal example.size}}
          data-test-woven-modal-size={{example.size}}
        />
      </WovenDocs::Example>
    {{/each}}

    <Woven::Modal
      @open={{this.sizedModal}}
      @title="Size: {{this.sizedModal}}"
      @size={{this.sizedModal}}
      @onClose={{this.closeSizedModal}}
    >
      <:body>
        {{#each this.fillerRows as |variant|}}
          <p>Row for {{variant}}, repeated so a small panel overflows and scrolls.</p>
        {{/each}}
      </:body>
      <:footer>
        <Woven::Button @text="Close" @onClick={{this.closeSizedModal}} />
      </:footer>
    </Woven::Modal>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Body" @id="body">
    <WovenDocs::Example
      @title="Scrollable"
      @note="The body scrolls while header and footer stay pinned, so the actions never leave the screen on long content."
      @code={{this.code.scrollable}}
    >
      <Woven::Button
        @text="Open scrollable"
        @onClick={{fn this.setOpen "scrollableOpen" true}}
        data-test-woven-open-scrollable
      />
      <Woven::Modal
        @open={{this.scrollableOpen}}
        @title="Scrollable body"
        @size="sm"
        @onClose={{fn this.setOpen "scrollableOpen" false}}
      >
        <:body>
          {{#each this.fillerRows as |variant|}}
            <p>Row for {{variant}}.</p>
            <p>Second row for {{variant}}.</p>
            <p>Third row for {{variant}}.</p>
          {{/each}}
        </:body>
        <:footer>
          <Woven::Button @text="Close" @onClick={{fn this.setOpen "scrollableOpen" false}} />
        </:footer>
      </Woven::Modal>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Dismissal" @id="dismissal">
    <WovenDocs::Example
      @title="No close button"
      @note="showClose false removes the header X, for dialogs that must end through their own buttons."
      @code={{this.code.noClose}}
    >
      <Woven::Button
        @text="Open without close button"
        @onClick={{fn this.setOpen "noCloseOpen" true}}
        data-test-woven-open-no-close
      />
      <Woven::Modal @open={{this.noCloseOpen}} @title="No close button" @showClose={{false}} @onClose={{fn this.setOpen "noCloseOpen" false}}>
        <:body><Woven::Text @text="Use the footer button, the backdrop or Escape." /></:body>
        <:footer><Woven::Button @text="Done" @onClick={{fn this.setOpen "noCloseOpen" false}} /></:footer>
      </Woven::Modal>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Backdrop click ignored"
      @note="closeOnBackdrop false keeps a half-filled form from vanishing on a stray click outside it."
      @code={{this.code.noBackdrop}}
    >
      <Woven::Button
        @text="Open, backdrop locked"
        @onClick={{fn this.setOpen "noBackdropOpen" true}}
        data-test-woven-open-no-backdrop
      />
      <Woven::Modal @open={{this.noBackdropOpen}} @title="Backdrop click ignored" @closeOnBackdrop={{false}} @onClose={{fn this.setOpen "noBackdropOpen" false}}>
        <Woven::Text @text="Click outside: nothing happens. Escape or the X still close it." />
      </Woven::Modal>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Escape ignored"
      @note="closeOnEsc false for a dialog that owns an in-progress request; pair it with a disabled close while busy."
      @code={{this.code.noEsc}}
    >
      <Woven::Button
        @text="Open, Escape locked"
        @onClick={{fn this.setOpen "noEscOpen" true}}
        data-test-woven-open-no-esc
      />
      <Woven::Modal @open={{this.noEscOpen}} @title="Escape ignored" @closeOnEsc={{false}} @onClose={{fn this.setOpen "noEscOpen" false}}>
        <Woven::Text @text="Press Escape: nothing happens. The X and the backdrop still close it." />
      </Woven::Modal>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Custom header" @id="header">
    <WovenDocs::Example
      @title="Header block"
      @note="The header block receives the generated title id; put it on your heading so the dialog keeps its accessible name. The block replaces the whole header, close button included, so close from the footer, the backdrop or Escape."
      @code={{this.code.header}}
    >
      <Woven::Button
        @text="Open custom header"
        @onClick={{fn this.setOpen "headerOpen" true}}
        data-test-woven-open-header
      />
      <Woven::Modal @open={{this.headerOpen}} @onClose={{fn this.setOpen "headerOpen" false}}>
        <:header as |titleId|>
          <h2 id={{titleId}} class="wu-modal-title">Custom header</h2>
          <Woven::Tag @variant="warning" @text="Draft" />
        </:header>
        <:body><Woven::Text @text="The heading above carries the yielded id." /></:body>
        <:footer><Woven::Button @text="Close" @onClick={{fn this.setOpen "headerOpen" false}} /></:footer>
      </Woven::Modal>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Arguments" @id="arguments">
    <WovenDocs::Table @kind="args" @rows={{this.argRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Callbacks" @id="callbacks">
    <WovenDocs::Table @kind="callbacks" @rows={{this.callbackRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Blocks" @id="blocks">
    <WovenDocs::Table @kind="blocks" @rows={{this.blockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>A native dialog opened with showModal(), labeled by the title or the header block's heading; the rest of the page is inert while it is open.</span></li>
      <li class="wu-list-item"><span>Tab is trapped inside the topmost dialog; the first meaningful control is focused on open, skipping the close button; focus returns to the opener on close.</span></li>
      <li class="wu-list-item"><span>Body scroll is locked while any dialog is open and restored when the last one closes.</span></li>
      <li class="wu-list-item"><span>Escape arrives as the dialog's cancel event, which is always canceled and reported through onClose. A click outside the dialog's box closes it unless closeOnBackdrop is false.</span></li>
      <li class="wu-list-item"><span>Menus, popovers and tooltips opened inside the dialog render into its own layer, so they stay interactive.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>The panel is centered with inset and auto margins rather than a translate, so it needs no direction-specific rule; header and footer use logical gaps.</span></li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
