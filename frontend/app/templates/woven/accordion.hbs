<WovenDocs::Page
  @id="accordion"
  @title="Accordion"
  @subtitle="Stacked disclosure panels, single or multiple open."
  @components="Woven::Accordion"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      Each item is a native
      <code class="wu-code">details</code>
      element with a
      <code class="wu-code">summary</code>
      trigger. The accordion keeps its expanded state in sync with the
      native toggle. Pass the items, optionally the ids to start open, and
      either let each item render its
      <code class="wu-code">content</code>
      string or supply a block that receives the item. Use it for optional
      detail the user opens on demand; use Tabs when one panel must always
      be visible. It renders the CSS kit
      <code class="wu-code">wu-accordion</code>.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Single-open by default; multiple with one flag.</span></li>
      <li class="wu-list-item"><span>Initial expansion by id or list of ids.</span></li>
      <li class="wu-list-item"><span>Disabled items stay closed and skip the toggle.</span></li>
      <li class="wu-list-item"><span>Animated chevron and panel height, reduced motion respected; opt out per accordion.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Behavior" @id="behavior">
    <WovenDocs::Example
      @title="Single open"
      @note="Opening one panel closes the others, so the list stays short. The last item is disabled and cannot open."
      @layout="block"
      @code={{this.code.basic}}
    >
      <Woven::Accordion @items={{this.accordionItems}} />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Multiple open"
      @note="Panels open independently, for reference content the user compares side by side."
      @layout="block"
      @code={{this.code.multiple}}
    >
      <Woven::Accordion @items={{this.accordionItems}} @multiple={{true}} />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Default expanded, one id"
      @note="Start with the most relevant panel open so the page is not a wall of closed headings."
      @layout="block"
      @code={{this.code.defaultExpanded}}
    >
      <Woven::Accordion @items={{this.accordionItems}} @defaultExpanded="lease-terms" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Default expanded, several ids"
      @note="An array of ids opens several panels at first render; it only makes sense with multiple."
      @layout="block"
      @code={{this.code.defaultExpandedMany}}
    >
      <Woven::Accordion
        @items={{this.accordionItems}}
        @multiple={{true}}
        @defaultExpanded={{array "unit-details" "cheque-schedule"}}
      />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Motion" @id="motion">
    <WovenDocs::Example
      @title="Without animation"
      @note="Animation is on by default: the chevron turns and the panel height glides when the user allows motion. Pass false to open and close instantly."
      @layout="block"
      @code={{this.code.static}}
    >
      <Woven::Accordion @items={{this.accordionItems}} @animated={{false}} />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Content" @id="content">
    <WovenDocs::Example
      @title="Block content"
      @note="The block receives each item and replaces its content string, for panels that hold components rather than text."
      @layout="block"
      @code={{this.code.block}}
    >
      <Woven::Accordion @items={{this.accordionItems}} as |entry|>
        <Woven::Text @size="sm" @text={{entry.content}} />
        <Woven::Tag @variant="info" @text={{entry.id}} />
      </Woven::Accordion>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Arguments" @id="arguments">
    <WovenDocs::Table @kind="args" @rows={{this.argRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Blocks" @id="blocks">
    <WovenDocs::Table @kind="blocks" @rows={{this.blockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Native details and summary give the disclosure role, expanded state and Enter and Space keys without extra ARIA.</span></li>
      <li class="wu-list-item"><span>Disabled items carry aria-disabled on the summary and ignore activation; the summary stays in the Tab order.</span></li>
      <li class="wu-list-item"><span>The chevron is drawn in CSS. Collapsed content stays in the DOM and is found by in-page search, which opens its item.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>The trigger uses flex layout, so the title and chevron swap sides under dir="rtl". The chevron points down and up, so it needs no mirroring.</span></li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
