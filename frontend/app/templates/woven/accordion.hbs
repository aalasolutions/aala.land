<WovenDocs::Page
  @id="accordion"
  @title="Accordion"
  @subtitle="Stacked disclosure panels, single or multiple open."
  @components="Woven::Accordion"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      The accordion owns its expanded state. Pass the items, optionally the
      ids to start open, and either let each item render its
      <code class="wu-code">content</code>
      string or supply a block that receives the item. Use it for optional
      detail the user opens on demand; use Tabs when one panel must always
      be visible.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list">
      <li class="wu-list__item">Single-open by default; multiple with one flag.</li>
      <li class="wu-list__item">Initial expansion by id or list of ids.</li>
      <li class="wu-list__item">Disabled items stay closed and skip the toggle.</li>
      <li class="wu-list__item">Bordered, flush and compact styles.</li>
      <li class="wu-list__item">Animated panel height with reduced-motion respected.</li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Behaviour" @id="behaviour">
    <WovenDocs::Example
      @title="Single open"
      @note="Opening one panel closes the others, so the list stays short. The last item is disabled and cannot open."
      @layout="block"
      @code={{this.code.basic}}
    >
      <Woven::Accordion @items={{this.accordionItems}} />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Multiple open"
      @note="Panels open independently, for reference content the user compares side by side."
      @layout="block"
      @code={{this.code.multiple}}
    >
      <Woven::Accordion @items={{this.accordionItems}} @multiple={{true}} />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Default expanded, one id"
      @note="Start with the most relevant panel open so the page is not a wall of closed headings."
      @layout="block"
      @code={{this.code.defaultExpanded}}
    >
      <Woven::Accordion @items={{this.accordionItems}} @defaultExpanded="lease-terms" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Default expanded, several ids"
      @note="An array of ids opens several panels at first render; it only makes sense with multiple."
      @layout="block"
      @code={{this.code.defaultExpandedMany}}
    >
      <Woven::Accordion
        @items={{this.accordionItems}}
        @multiple={{true}}
        @defaultExpanded={{array "unit-details" "cheque-schedule"}}
      />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Styles" @id="styles">
    <WovenDocs::Example
      @title="Bordered"
      @note="A border around the whole accordion when it stands alone on the page background."
      @layout="block"
      @code={{this.code.bordered}}
    >
      <Woven::Accordion @items={{this.accordionItems}} @bordered={{true}} />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Flush"
      @note="No outer border or radius, for an accordion inside a card that already has both."
      @layout="block"
      @code={{this.code.flush}}
    >
      <Woven::Card @title="Inside a card">
        <Woven::Accordion @items={{this.accordionItems}} @flush={{true}} />
      </Woven::Card>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Compact"
      @note="Tighter trigger and panel padding for sidebars and filter groups."
      @layout="block"
      @code={{this.code.compact}}
    >
      <Woven::Accordion @items={{this.accordionItems}} @compact={{true}} />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Content" @id="content">
    <WovenDocs::Example
      @title="Block content"
      @note="The block receives each item and replaces its content string, for panels that hold components rather than text."
      @layout="block"
      @code={{this.code.block}}
    >
      <Woven::Accordion @items={{this.accordionItems}} as |entry|>
        <Woven::Text @size="sm" @text={{entry.content}} />
        <Woven::Tag @size="sm" @variant="info" @text={{entry.id}} />
      </Woven::Accordion>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Arguments" @id="arguments">
    <WovenDocs::Table @kind="args" @rows={{this.argRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Blocks" @id="blocks">
    <WovenDocs::Table @kind="blocks" @rows={{this.blockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list">
      <li class="wu-list__item">Each trigger is a native button with aria-expanded; disabled items carry the disabled attribute.</li>
      <li class="wu-list__item">The chevron is aria-hidden. Panels stay in the DOM while collapsed, so content is only visually hidden.</li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list">
      <li class="wu-list__item">The chevron glyph is not bidi-mirrored, so the stylesheet flips it with scaleX(-1) under dir="rtl"; the expanded rotation is adjusted to match.</li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
