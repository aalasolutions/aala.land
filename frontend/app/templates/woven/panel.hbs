<WovenDocs::Page
  @id="panel"
  @title="Panel and Toolbar"
  @subtitle="Bordered content region and a horizontal control bar."
  @components="Woven::Panel, Woven::Toolbar"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      Panel renders the CSS kit
      <code class="wu-code">wu-panel</code>: the same slot shape as Card with
      a flat bordered surface, for filters, settings groups and page
      sections. Toolbar renders
      <code class="wu-code">wu-toolbar</code>, a wrapping row; its groups,
      separators and end group are bare elements with kit classes. Put a toolbar above a list and a panel around a form.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Panel header from a title or a block; body and footer slots.</span></li>
      <li class="wu-list-item"><span>One flat panel look; the kit has no compact, raised or interactive styles.</span></li>
      <li class="wu-list-item"><span>Toolbar with a boxed style, a smaller gap, separators and an end group.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Panel: header and slots" @id="panel-slots">
    <WovenDocs::Example
      @title="Title"
      @note="A title renders the header; the default block is the body. The usual form container."
      @code={{this.code.title}}
    >
      <Woven::Panel @title="Property Filters">
        <p class="wu-text sm muted">Default padded panel with a title.</p>
      </Woven::Panel>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="No header"
      @note="Without a title there is no header at all, just the padded surface, for a block of related controls."
      @code={{this.code.plain}}
    >
      <Woven::Panel>
        <p class="wu-text sm muted">No title, no header: just the surface.</p>
      </Woven::Panel>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Header block"
      @note="Custom header markup when the title needs a count or a control beside it."
      @code={{this.code.headerBlock}}
    >
      <Woven::Panel>
        <:header>
          <h3 class="wu-panel-title">Custom header</h3>
          <Woven::Badge @variant="info" @value={{3}} />
        </:header>
        <:body>Body content.</:body>
      </Woven::Panel>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Body and footer blocks"
      @note="Named slots give a form its action row at the bottom of the panel."
      @layout="block"
      @code={{this.code.slots}}
    >
      <Woven::Panel @title="Unit Maintenance">
        <:body>
          <p class="wu-text sm muted">Named-block body/footer, same shape as card.</p>
        </:body>
        <:footer>
          <Woven::Button @size="sm" @text="Cancel" />
          <Woven::Button @variant="brand" @size="sm" @text="Save" />
        </:footer>
      </Woven::Panel>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Panel: reference" @id="panel-styles">
    <h3 class="woven-subtitle">Panel arguments</h3>
    <WovenDocs::Table @kind="args" @rows={{this.panelArgRows}} />
    <h3 class="woven-subtitle">Panel blocks</h3>
    <WovenDocs::Table @kind="blocks" @rows={{this.panelBlockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Toolbar" @id="toolbar">
    <WovenDocs::Example
      @title="Default"
      @note="A wrapping row of controls of one height. Group related buttons; wu-toolbar-end pushes itself and what follows to the end."
      @layout="block"
      @code={{this.code.toolbar}}
    >
      <Woven::Toolbar>
        <div class="wu-toolbar-group">
          <Woven::Button @size="sm" @text="All Units" />
          <Woven::Button @variant="ghost" @size="sm" @text="Occupied" />
        </div>
        <div class="wu-toolbar-end">
          <Woven::Button @variant="brand" @size="sm" @text="Add Unit" />
        </div>
      </Woven::Toolbar>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Boxed"
      @note="Border, padding and the alternate background. A separator splits groups; status displays such as badges go outside the row."
      @layout="block"
      @code={{this.code.toolbarBordered}}
    >
      <Woven::Toolbar @bordered={{true}}>
        <div class="wu-toolbar-group">
          <Woven::Button @size="sm" @text="All Units" />
          <Woven::Button @variant="ghost" @size="sm" @text="Occupied" />
          <Woven::Button @variant="ghost" @size="sm" @text="Vacant" />
        </div>
        <span class="wu-toolbar-separator" aria-hidden="true"></span>
        <Woven::Button @variant="ghost" @size="sm" @text="Export" />
        <div class="wu-toolbar-end">
          <Woven::Button @variant="brand" @size="sm" @text="Add Unit" />
        </div>
      </Woven::Toolbar>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Search input"
      @note="size sm gives the kit smaller gap. A bare input with an aria-label sizes to its content, up to 16rem. Never wrap it in a field: the label line pushes it below its neighbors."
      @layout="block"
      @code={{this.code.toolbarSearch}}
    >
      <Woven::Toolbar @bordered={{true}} @size="sm">
        <Woven::Input
          @size="sm"
          @prefixIcon="⌕"
          @placeholder="Search units"
          aria-label="Search units"
        />
        <div class="wu-toolbar-end">
          <Woven::Button @size="sm" @icon="funnel" @text="Filters" />
        </div>
      </Woven::Toolbar>
    </WovenDocs::Example>

    <h3 class="woven-subtitle">Toolbar arguments</h3>
    <WovenDocs::Table @kind="args" @rows={{this.toolbarArgRows}} />
    <h3 class="woven-subtitle">Toolbar raw classes</h3>
    <WovenDocs::Table @kind="classes" @rows={{this.toolbarClassRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>The panel title is an h3; keep a heading above a run of panels.</span></li>
      <li class="wu-list-item"><span>Toolbar is a plain div. Add role="toolbar" only with a script that provides arrow-key focus.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>The toolbar end group sits at the inline end, so trailing actions sit on the left under dir="rtl".</span></li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
