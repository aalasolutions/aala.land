<WovenDocs::Page
  @id="badge"
  @title="Badge"
  @subtitle="Inline status label, standalone count bubble, or a corner bubble anchored to wrapped content."
  @components="Woven::Badge"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      The same component renders three shapes decided by how it is invoked:
      a pill when standing alone, a count bubble with
      <code class="wu-code">@count</code>, and a fixed corner bubble when it
      wraps a block. A numeric
      <code class="wu-code">@max</code>
      caps the display at "max+". It renders the CSS kit
      <code class="wu-code">wu-badge</code>
      (or
      <code class="wu-code">wu-dot</code>
      for dots). Use a badge for counts; use a Tag for status words and
      categories.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Five role colors plus a neutral default; secondary renders the neutral badge.</span></li>
      <li class="wu-list-item"><span>Tinted by default, solid for emphasis; one size, no outline, pill or quiet style in the kit.</span></li>
      <li class="wu-list-item"><span>Dot form for presence without a value.</span></li>
      <li class="wu-list-item"><span>Overflow cap: value 120 with max 99 renders 99+.</span></li>
      <li class="wu-list-item"><span>Zero displays; null and undefined hide a corner bubble.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Variants" @id="variants">
    {{#each this.variantExamples as |example|}}
      <WovenDocs::Example @title={{example.title}} @note={{example.note}} @code={{example.code}}>
        <Woven::Badge @variant={{example.variant}} @value={{example.title}} />
      </WovenDocs::Example>
    {{/each}}
  </WovenDocs::Section>

  <WovenDocs::Section @title="Styles" @id="styles">
    <WovenDocs::Example
      @title="Solid"
      @note="Kit solid modifier: filled with the role color and inverted text, gray without a role. Higher contrast for a badge that must be read at a glance, such as a status column."
      @code={{this.code.solid}}
    >
      <Woven::Badge @variant="brand" @solid={{true}} @value="Solid" />
    </WovenDocs::Example>




    <WovenDocs::Example
      @title="Text alias"
      @note="text is an alias of value that reads naturally for labels; value wins when both are given."
      @code={{this.code.text}}
    >
      <Woven::Badge @variant="success" @text="Active" />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Values" @id="values">
    <WovenDocs::Example
      @title="Zero"
      @note="0 is a real value and displays. On a corner bubble only null or undefined hides it, so an empty count never renders an empty bubble; an inline badge always renders, so leave it out when there is nothing to show."
      @code={{this.code.zero}}
    >
      <Woven::Badge @variant="warning" @value={{0}} />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Overflow cap"
      @note="max caps a numeric value at max+. Use it for unread counts and anything that can grow past two digits."
      @code={{this.code.max}}
    >
      <Woven::Badge @variant="danger" @value={{120}} @max={{99}} />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Dot"
      @note="Presence without a number: online, has unread, needs attention. Renders a kit wu-dot, never hidden for lacking a value."
      @code={{this.code.dot}}
    >
      <Woven::Badge @variant="secondary" @isDot={{true}} />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Count bubbles" @id="counts">
    <WovenDocs::Example
      @title="Standalone count"
      @note="count renders the round bubble inline, without an anchor. For tab labels and list rows that show a number beside text."
      @code={{this.code.count}}
    >
      <Woven::Badge @count={{true}} @value={{3}} />
      <Woven::Badge @count={{true}} @variant="brand" @value={{12}} />
      <Woven::Badge @count={{true}} @variant="success" @value={{99}} />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Count with cap"
      @note="The same overflow rule applies to bubbles."
      @code={{this.code.countMax}}
    >
      <Woven::Badge @count={{true}} @variant="info" @value={{250}} @max={{99}} />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Count dot"
      @note="A bubble reduced to a dot, for a compact unread marker."
      @code={{this.code.countDot}}
    >
      <Woven::Badge @count={{true}} @variant="danger" @isDot={{true}} />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Wrapped content" @id="wrapped">
    <WovenDocs::Example
      @title="Corner count"
      @note="A block wraps the content in kit wu-badge-host and pins a solid corner badge to its corner. The classic unread marker on an icon button."
      @code={{this.code.wrapped}}
    >
      <Woven::Badge @variant="danger" @value={{5}}>
        <Woven::Button @icon="envelope" @shape="square" aria-label="Messages" />
      </Woven::Badge>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Corner dot"
      @note="Presence on a control without a number: a kit wu-dot corner."
      @code={{this.code.wrappedDot}}
    >
      <Woven::Badge @variant="success" @isDot={{true}}>
        <Woven::Button @icon="bell" @shape="square" aria-label="Notifications" />
      </Woven::Badge>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Corner zero"
      @note="Zero still renders on a wrapped badge, so a count that dropped to none stays visible as 0 until you hide it."
      @code={{this.code.wrappedZero}}
    >
      <Woven::Badge @variant="brand" @value={{0}}>
        <Woven::Button @icon="star" @shape="square" aria-label="Favorites" />
      </Woven::Badge>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Hidden"
      @note="hidden removes the bubble but keeps the wrapped control in place, so the layout does not shift when a count clears."
      @code={{this.code.hidden}}
    >
      <Woven::Badge @variant="danger" @value={{7}} @hidden={{true}}>
        <Woven::Button @icon="chat-circle" @shape="square" aria-label="Chats" />
      </Woven::Badge>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Arguments" @id="arguments">
    <WovenDocs::Table @kind="args" @rows={{this.argRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Blocks" @id="blocks">
    <WovenDocs::Table @kind="blocks" @rows={{this.blockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>The badge is a plain span; it carries no role and is read as part of the surrounding text.</span></li>
      <li class="wu-list-item"><span>A dot badge has no text. Convey the state in the wrapped control's label or a tooltip.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>The kit pins a corner badge to the top inline-end corner, so it stays on the trailing corner under dir="rtl".</span></li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
