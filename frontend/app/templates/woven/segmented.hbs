<WovenDocs::Page
  @id="segmented"
  @title="Segmented"
  @subtitle="Single- or multi-choice control rendered as one joined switch."
  @components="Woven::Segmented"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      A segmented control sets a value. Unlike Tabs, which navigate between
      panels, it behaves as a radio group in single mode and as a set of
      checkboxes in multiple mode, and announces itself that way. It renders
      the CSS kit
      <code class="wu-code">wu-segmented</code>
      with a native radio or checkbox in every segment. Use it for two to five
      short choices that change a view or a filter at once.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Icon plus label, icon only, or label only per option.</span></li>
      <li class="wu-list-item"><span>Single or multiple selection; controlled or uncontrolled.</span></li>
      <li class="wu-list-item"><span>Kit sm and lg sizes and a full-width layout.</span></li>
      <li class="wu-list-item"><span>Arrow, Home and End keys; disabled options are skipped.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Options" @id="options">
    <WovenDocs::Example
      @title="Icon and label"
      @note="Each option carries a Phosphor icon and a label. The richest form, for view switchers at the top of a page."
      @layout="block"
      @code={{this.code.icons}}
    >
      <Woven::Segmented
        @options={{this.segmentedViews}}
        @value={{this.segmentedView}}
        @onChange={{this.updateSegmentedView}}
      />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Custom icons with the :icon slot"
      @note="Icons come from the option objects, so the :icon block yields the option back and the host draws what it likes per option. Without the block, option.icon renders as a Phosphor name."
      @layout="block"
      @code={{this.code.iconSlot}}
    >
      <Woven::Segmented
        @options={{this.segmentedViews}}
        @value={{this.segmentedView}}
        @onChange={{this.updateSegmentedView}}
      >
        <:icon as |option|>
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" data-icon={{option.icon}}>
            <rect x="1" y="1" width="10" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
        </:icon>
      </Woven::Segmented>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Icon only"
      @note="Labels move to a visually hidden span, so they stay the accessible names, and each segment gets a title; for toolbars where the icons are universally understood."
      @layout="block"
      @code={{this.code.iconOnly}}
    >
      <Woven::Segmented
        @options={{this.segmentedViews}}
        @value={{this.segmentedView}}
        @onChange={{this.updateSegmentedView}}
        @iconOnly={{true}}
      />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Label only with a disabled option"
      @note="Plain text segments; a disabled option stays visible so the user knows the choice exists."
      @layout="block"
      @code={{this.code.plain}}
    >
      <Woven::Segmented
        @options={{this.segmentedPlain}}
        @value={{this.segmentedPeriod}}
        @onChange={{this.updateSegmentedPeriod}}
      />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="value keys"
      @note="Options keyed by value instead of id work the same, so an existing options array drops in unchanged."
      @layout="block"
      @code={{this.code.valueKeyed}}
    >
      <Woven::Segmented
        @options={{this.segmentedValueKeyed}}
        @value={{this.segmentedPeriod}}
        @onChange={{this.updateSegmentedPeriod}}
      />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Modes" @id="modes">
    <WovenDocs::Example
      @title="Uncontrolled"
      @note="Without value the control starts on the first enabled option and keeps its own state."
      @layout="block"
      @code={{this.code.uncontrolled}}
    >
      <Woven::Segmented @options={{this.segmentedPlain}} />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Multiple"
      @note="Several segments raised at once; the value is an array and each segment is a checkbox. For filters such as amenities."
      @layout="block"
      @code={{this.code.multiple}}
    >
      <Woven::Segmented
        @options={{this.segmentedAmenityOptions}}
        @value={{this.segmentedAmenities}}
        @onChange={{this.updateSegmentedAmenities}}
        @multiple={{true}}
      />
      <span class="wu-text sm muted" data-test-woven-segmented-values>Selected: {{this.segmentedAmenities}}</span>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Sizes and layout" @id="sizes">
    <WovenDocs::Example
      @title="Small"
      @note="Kit sm. Matches sm buttons in toolbars and card headers; size xs renders the same."
      @layout="block"
      @code={{this.code.sm}}
    >
      <Woven::Segmented
        @options={{this.segmentedPlain}}
        @value={{this.segmentedPeriod}}
        @onChange={{this.updateSegmentedPeriod}}
        @size="sm"
      />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Large"
      @note="Kit lg. For a prominent mode switch at the top of a screen; size xl renders the same."
      @layout="block"
      @code={{this.code.lg}}
    >
      <Woven::Segmented
        @options={{this.segmentedPlain}}
        @value={{this.segmentedPeriod}}
        @onChange={{this.updateSegmentedPeriod}}
        @size="lg"
      />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Fill"
      @note="The kit has no fill modifier; fill adds the core w-full utility and the segments share the width, for phones and narrow cards."
      @layout="block"
      @code={{this.code.fill}}
    >
      <Woven::Segmented
        @options={{this.segmentedPlain}}
        @value={{this.segmentedPeriod}}
        @onChange={{this.updateSegmentedPeriod}}
        @fill={{true}}
      />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Arguments" @id="arguments">
    <WovenDocs::Table @kind="args" @rows={{this.argRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Blocks" @id="blocks">
    <WovenDocs::Table @kind="blocks" @rows={{this.blockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Callbacks" @id="callbacks">
    <WovenDocs::Table @kind="callbacks" @rows={{this.callbackRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Single mode renders role="radiogroup" with native radios sharing one name; multiple mode renders role="group" with native checkboxes. The checked state is native.</span></li>
      <li class="wu-list-item"><span>Arrow keys, Home and End move between enabled segments. Single mode moves the value with focus; multiple mode only moves focus, so Space toggles.</span></li>
      <li class="wu-list-item"><span>Icon-only segments keep their label in a visually hidden span and a title attribute; icons are aria-hidden.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Arrow keys follow the reading direction, as in Tabs.</span></li>
      <li class="wu-list-item"><span>The kit draws the joined segments with logical properties, so the rounded ends stay on the outer segments in both directions.</span></li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
