<WovenDocs::Page
  @id="timeline"
  @title="Timeline"
  @subtitle="Vertical sequence of events with colored markers."
  @components="Woven::Timeline, Woven::TimelineItem"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      Timeline renders the CSS kit
      <code class="wu-code">wu-timeline</code>
      ordered list; each TimelineItem is a
      <code class="wu-code">wu-timeline-item</code>
      with a marker, a rail to the next item, a title, a time line and text.
      Titles are paragraphs, not headings. Use it for activity logs and lead
      histories. Woven::Timeline takes no arguments.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Five marker role colors; success, warning and danger also change the shape.</span></li>
      <li class="wu-list-item"><span>Progress rail from one active item.</span></li>
      <li class="wu-list-item"><span>Title, timestamp, description and meta line per item.</span></li>
      <li class="wu-list-item"><span>Block content and icon slot per item.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Items" @id="items">
    <WovenDocs::Example
      @title="Title, timestamp, description, meta"
      @note="The full item: a heading row with the time, body text, and a small meta line for the actor."
      @layout="block"
      @code={{this.code.basic}}
    >
      <Woven::Timeline>
        <Woven::TimelineItem
          @title="Created"
          @timestamp="09:14"
          @description="Lead captured from the website form."
          @meta="by Sara"
        />
        <Woven::TimelineItem @title="Contacted" @timestamp="11:02" @description="First WhatsApp message sent." />
      </Woven::Timeline>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Icon and block content"
      @note="The icon slot puts a glyph before the title; block content replaces the description for tags and links."
      @layout="block"
      @code={{this.code.blocks}}
    >
      <Woven::Timeline>
        <Woven::TimelineItem @title="Payment received" @timestamp="Today">
          <:icon><Woven::Icon @icon="check" /></:icon>
          <:default><Woven::Tag @variant="success" @text="AED 8,500" /></:default>
        </Woven::TimelineItem>
      </Woven::Timeline>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="States" @id="states">
    <WovenDocs::Example
      @title="Progress rail"
      @note="active sets aria-current step on one item, and the kit turns the list into a progress rail: earlier items filled, the current one ringed, later ones hollow. Say completed in the item text too, since the fill is visual only."
      @layout="block"
      @code={{this.code.progress}}
    >
      <Woven::Timeline>
        <Woven::TimelineItem @title="Offer accepted (completed)" @timestamp="Mon" />
        <Woven::TimelineItem
          @title="Site visit"
          @timestamp="Thu"
          @active={{true}}
          @description="Scheduled for Thursday."
        />
        <Woven::TimelineItem @title="Lease signed" />
      </Woven::Timeline>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Marker variants" @id="variants">
    {{#each this.variantExamples as |example|}}
      <WovenDocs::Example @title={{example.title}} @note={{example.note}} @layout="block" @code={{example.code}}>
        <Woven::Timeline>
          <Woven::TimelineItem
            @title={{example.title}}
            @variant={{example.variant}}
            @timestamp="12:00"
            @description="{{example.title}} marker."
          />
        </Woven::Timeline>
      </WovenDocs::Example>
    {{/each}}
  </WovenDocs::Section>


  <WovenDocs::Section @title="Arguments" @id="arguments">
    <h3 class="woven-subtitle">Woven::TimelineItem</h3>
    <WovenDocs::Table @kind="args" @rows={{this.itemArgRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Blocks" @id="blocks">
    <WovenDocs::Table @kind="blocks" @rows={{this.itemBlockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Renders an ol of li items, so order and count are announced.</span></li>
      <li class="wu-list-item"><span>Marker and rail are drawn in CSS and the icon is aria-hidden; state is conveyed by the title and description text. The active item carries aria-current="step".</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>The kit places the rail and markers on the inline-start edge, so the timeline hangs from the right under dir="rtl".</span></li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
