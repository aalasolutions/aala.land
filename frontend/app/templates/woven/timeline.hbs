<WovenDocs::Page
  @id="timeline"
  @title="Timeline"
  @subtitle="Vertical sequence of events with coloured markers."
  @components="Woven::Timeline, Woven::TimelineItem"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      Timeline is an ordered list; each TimelineItem is a list item with a
      marker, a connector to the next item, and a heading row of title,
      timestamp and optional icon. Item titles render as h5, so place the
      timeline under an h4 to keep the heading order. Use it for activity
      logs and lead histories.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list">
      <li class="wu-list__item">Marker colours in six variants, plus active and complete states.</li>
      <li class="wu-list__item">Title, timestamp, description and meta line per item.</li>
      <li class="wu-list__item">Compact and alternating layouts.</li>
      <li class="wu-list__item">Block content and icon slot per item.</li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Items" @id="items">
    <WovenDocs::Example
      @title="Title, timestamp, description, meta"
      @note="The full item: a heading row with the time, body text, and a small meta line for the actor."
      @layout="block"
      @code={{this.code.basic}}
    >
      <Woven::Timeline>
        <Woven::TimelineItem
          @title="Created"
          @timestamp="09:14"
          @description="Lead captured from the website form."
          @meta="by Sara"
        />
        <Woven::TimelineItem @title="Contacted" @timestamp="11:02" @description="First WhatsApp message sent." />
      </Woven::Timeline>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Icon and block content"
      @note="The icon slot puts a glyph in the heading row; block content replaces the description for badges and links."
      @layout="block"
      @code={{this.code.blocks}}
    >
      <Woven::Timeline>
        <Woven::TimelineItem @title="Payment received" @timestamp="Today">
          <:icon><Woven::Icon @icon="check" /></:icon>
          <:default><Woven::Badge @variant="success" @text="AED 8,500" /></:default>
        </Woven::TimelineItem>
      </Woven::Timeline>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="States" @id="states">
    <WovenDocs::Example
      @title="Complete"
      @note="Marks a step as done; past events in a process such as a lease signing."
      @layout="block"
      @code={{this.code.complete}}
    >
      <Woven::Timeline>
        <Woven::TimelineItem
          @title="Created"
          @timestamp="09:14"
          @complete={{true}}
          @description="Lead captured from the website form."
        />
      </Woven::Timeline>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Active"
      @note="Highlights the current step so the eye lands on what happens next."
      @layout="block"
      @code={{this.code.active}}
    >
      <Woven::Timeline>
        <Woven::TimelineItem
          @title="Site visit"
          @timestamp="14:30"
          @active={{true}}
          @variant="warning"
          @description="Scheduled for Thursday."
        />
      </Woven::Timeline>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Marker variants" @id="variants">
    {{#each this.variantExamples as |example|}}
      <WovenDocs::Example @title={{example.title}} @note={{example.note}} @layout="block" @code={{example.code}}>
        <Woven::Timeline @compact={{true}}>
          <Woven::TimelineItem
            @title={{example.title}}
            @variant={{example.variant}}
            @timestamp="12:00"
            @description="{{example.title}} marker."
          />
        </Woven::Timeline>
      </WovenDocs::Example>
    {{/each}}
  </WovenDocs::Section>

  <WovenDocs::Section @title="Layouts" @id="layouts">
    <WovenDocs::Example
      @title="Compact"
      @note="Tighter rows for long activity logs in a sidebar."
      @layout="block"
      @code={{this.code.compact}}
    >
      <Woven::Timeline @compact={{true}}>
        <Woven::TimelineItem @title="Created" @timestamp="09:14" @description="Compact row." />
        <Woven::TimelineItem @title="Contacted" @timestamp="11:02" @description="Compact row." />
      </Woven::Timeline>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Alternate"
      @note="Items alternate sides of a centred line, for a wide overview of a process."
      @layout="block"
      @code={{this.code.alternate}}
    >
      <Woven::Timeline @alternate={{true}}>
        <Woven::TimelineItem @title="First" @description="Alternating layout." />
        <Woven::TimelineItem @title="Second" @description="Second item flips." />
        <Woven::TimelineItem @title="Third" @description="Third returns." />
      </Woven::Timeline>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Arguments" @id="arguments">
    <h3 class="woven-subtitle">Woven::Timeline</h3>
    <WovenDocs::Table @kind="args" @rows={{this.timelineArgRows}} />
    <h3 class="woven-subtitle">Woven::TimelineItem</h3>
    <WovenDocs::Table @kind="args" @rows={{this.itemArgRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Blocks" @id="blocks">
    <WovenDocs::Table @kind="blocks" @rows={{this.itemBlockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list">
      <li class="wu-list__item">Renders an ol of li items, so order and count are announced.</li>
      <li class="wu-list__item">Marker, connector and icon are aria-hidden; state is conveyed by the title and description text.</li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list">
      <li class="wu-list__item">The line and markers sit on the inline-start edge using logical insets, so the timeline hangs from the right under dir="rtl"; the alternate layout mirrors likewise.</li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
