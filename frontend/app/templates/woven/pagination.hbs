<WovenDocs::Page
  @id="pagination"
  @title="Pagination"
  @subtitle="Page list with status text and an optional per-page select."
  @components="Woven::Pagination"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      The component derives the page list from page, per-page and total: up
      to seven pages in full, otherwise first, last, the current page and
      one neighbor on each side with ellipses between. It reports only
      valid whole page numbers, so a controller can trust what it receives.
      The application's paginated controllers pass
      <code class="wu-code">@limit</code>
      with a default of 50. It renders the CSS kit
      <code class="wu-code">wu-pagination</code>: page buttons are kit
      <code class="wu-code">wu-btn</code> in a
      <code class="wu-code">wu-pagination-list</code>, and the page size is
      a native
      <code class="wu-code">wu-select</code>.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Compact page list with ellipses for long ranges.</span></li>
      <li class="wu-list-item"><span>Status text ("1-50 of 430") derived from the inputs.</span></li>
      <li class="wu-list-item"><span>Per-page select rendered only when a per-page callback is given; 50, 100 and 250 by default.</span></li>
      <li class="wu-list-item"><span>Kit sm, default and lg sizes; previous and next overrides for step-only controllers.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Examples" @id="examples">
    <WovenDocs::Example
      @title="Default"
      @note="Page list and status only. Choose this when the page size is fixed by the route."
      @layout="block"
      @code={{this.code.basic}}
    >
      <Woven::Pagination
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{this.total}}
        @onPageChange={{this.setPage}}
      />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Per-page select"
      @note="Passing a limit callback renders the select with the default choices 50, 100 and 250; reset the page to 1 when the size changes. This is the shape every server-paged list uses."
      @layout="block"
      @code={{this.code.perPage}}
    >
      <Woven::Pagination
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{this.total}}
        @onPageChange={{this.setPage}}
        @onLimitChange={{this.setLimit}}
      />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Custom choices, small"
      @note="perPageOptions replaces the default choices; sm shrinks the controls for a card footer or a drawer."
      @layout="block"
      @code={{this.code.perPageOptions}}
    >
      <Woven::Pagination
        @page={{this.smallPage}}
        @perPage={{10}}
        @total={{this.smallTotal}}
        @perPageOptions={{array 10 20 30}}
        @onPageChange={{this.setSmallPage}}
        @onPerPageChange={{this.setSmallLimit}}
        @size="sm"
      />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Sizes"
      @note="Kit sm, default and lg: buttons, ellipsis, total text and the page size select scale together. xs renders sm, since the kit has no smaller step."
      @layout="stack"
      @code={{this.code.sizes}}
    >
      <Woven::Pagination @page={{this.page}} @limit={{this.limit}} @total={{this.total}} @onPageChange={{this.setPage}} @onLimitChange={{this.setLimit}} @size="xs" data-test-woven-pagination-size="xs" />
      <Woven::Pagination @page={{this.page}} @limit={{this.limit}} @total={{this.total}} @onPageChange={{this.setPage}} @onLimitChange={{this.setLimit}} @size="sm" data-test-woven-pagination-size="sm" />
      <Woven::Pagination @page={{this.page}} @limit={{this.limit}} @total={{this.total}} @onPageChange={{this.setPage}} @onLimitChange={{this.setLimit}} data-test-woven-pagination-size="md" />
      <Woven::Pagination @page={{this.page}} @limit={{this.limit}} @total={{this.total}} @onPageChange={{this.setPage}} @onLimitChange={{this.setLimit}} @size="lg" data-test-woven-pagination-size="lg" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Long range"
      @note="Past seven pages the list collapses to first, the current page with one neighbor on each side, and last, with ellipses between."
      @layout="block"
      @code={{this.code.longRange}}
    >
      <Woven::Pagination
        @page={{this.longPage}}
        @perPage={{10}}
        @total={{240}}
        @onPageChange={{this.setLongPage}}
      />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Step overrides"
      @note="onPrevious and onNext replace the step logic for a controller that only knows how to move one page at a time, for example a cursor-based API."
      @layout="block"
      @code={{this.code.steps}}
    >
      <Woven::Pagination
        @page={{this.stepPage}}
        @perPage={{10}}
        @total={{90}}
        @onPrevious={{this.stepPrevious}}
        @onNext={{this.stepNext}}
        @onPageChange={{this.setStepPage}}
      />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Empty"
      @note="A total of 0 reports 0 results with both steps disabled; keep the component mounted so the layout does not jump when rows arrive."
      @layout="block"
      @code={{this.code.empty}}
    >
      <Woven::Pagination @page={{1}} @perPage={{50}} @total={{0}} @onPageChange={{this.setPage}} />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Arguments" @id="arguments">
    <WovenDocs::Table @kind="args" @rows={{this.argRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Callbacks" @id="callbacks">
    <WovenDocs::Table @kind="callbacks" @rows={{this.callbackRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Renders a nav labeled "Pagination". Previous and next are icon buttons labeled "Previous page" and "Next page" and carry the disabled attribute at the range ends.</span></li>
      <li class="wu-list-item"><span>The current page button has aria-current="page".</span></li>
      <li class="wu-list-item"><span>The per-page select sits inside the kit wu-pagination-size label, so its visible "per page" text names it.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>The kit draws the previous and next arrows to follow the reading direction, so they mirror under dir="rtl" with no flip rule; the list reads right to left.</span></li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
