<WovenDocs::Page
  @id="indicators"
  @title="Dot, Spinner, Skeleton"
  @subtitle="Presence, loading and placeholder indicators."
  @components="Woven::Dot, Woven::Spinner, Woven::Skeleton"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      Three stateless indicators on the CSS kit
      <code class="wu-code">wu-dot</code>,
      <code class="wu-code">wu-spinner</code>
      and
      <code class="wu-code">wu-skeleton</code>. A dot marks presence or status beside
      text, a spinner marks an in-flight request, and a skeleton holds the
      shape of content that has not arrived yet. Use a skeleton when the
      layout is known and a spinner when it is not.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Dot: five role colors with a shape per status, one size, optional pulse.</span></li>
      <li class="wu-list-item"><span>Spinner: current text color, three sizes, announced as a status region.</span></li>
      <li class="wu-list-item"><span>Skeleton: text, circle and block shapes, fractional widths, multi-line groups, always shimmering.</span></li>
      <li class="wu-list-item"><span>Every animation honors prefers-reduced-motion.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Dot variants" @id="dot-variants">
    {{#each this.dotVariantExamples as |example|}}
      <WovenDocs::Example @title={{example.title}} @note={{example.note}} @code={{example.code}}>
        <Woven::Dot @variant={{example.variant}} />
        <span class="wu-text sm">{{example.title}}</span>
      </WovenDocs::Example>
    {{/each}}
  </WovenDocs::Section>

  <WovenDocs::Section @title="Dot decoration" @id="dot-sizes">
    <WovenDocs::Example
      @title="Pulse"
      @note="A fading ring for live activity: recording, streaming, an incoming call. Only plays when the user allows motion."
      @code={{this.code.pulse}}
    >
      <Woven::Dot @variant="danger" @pulse={{true}} />
    </WovenDocs::Example>

    <h3 class="woven-subtitle">Dot arguments</h3>
    <WovenDocs::Table @kind="args" @rows={{this.dotArgRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Spinner color" @id="spinner-variants">
    <WovenDocs::Example
      @title="Current text color"
      @note="The kit spinner has no color argument; it draws in the current text color, so set the color on a wrapper."
      @code={{this.code.color}}
    >
      <Woven::Spinner />
      <span class="text-brand"><Woven::Spinner /></span>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Spinner sizes" @id="spinner-sizes">
    {{#each this.spinnerSizeExamples as |example|}}
      <WovenDocs::Example @title={{example.title}} @note={{example.note}} @code={{example.code}}>
        <Woven::Spinner @size={{example.size}} />
      </WovenDocs::Example>
    {{/each}}

    <h3 class="woven-subtitle">Spinner arguments</h3>
    <WovenDocs::Table @kind="args" @rows={{this.spinnerArgRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Skeleton shapes" @id="skeleton-shapes">
    {{#each this.shapeExamples as |example|}}
      <WovenDocs::Example @title={{example.title}} @note={{example.note}} @layout="stack" @code={{example.code}}>
        <Woven::Skeleton @shape={{example.shape}} />
      </WovenDocs::Example>
    {{/each}}
  </WovenDocs::Section>

  <WovenDocs::Section @title="Skeleton widths and lines" @id="skeleton-widths">
    {{#each this.widthExamples as |example|}}
      <WovenDocs::Example @title={{example.title}} @note={{example.note}} @layout="block" @code={{example.code}}>
        <Woven::Skeleton @shape="text" @width={{example.width}} />
      </WovenDocs::Example>
    {{/each}}

    <WovenDocs::Example
      @title="Multiple lines"
      @note="lines above 1 renders a group of kit text lines; the kit makes the last one shorter, standing in for a paragraph."
      @layout="block"
      @code={{this.code.lines}}
    >
      <Woven::Skeleton @lines={{3}} />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Composed placeholder"
      @note="Combine shapes to mirror the real layout: a circle for the avatar, a short line, then text lines. Mark the loading region aria-busy with hidden Loading text, and swap it for the content in place so nothing jumps."
      @layout="block"
      @code={{this.code.composed}}
    >
      <div class="flex col gap-3" aria-busy="true">
        <span class="sr-only">Loading</span>
        <div class="woven-row">
          <Woven::Skeleton @shape="circle" />
          <Woven::Skeleton @shape="text" @width="50" />
        </div>
        <Woven::Skeleton @lines={{2}} />
      </div>
    </WovenDocs::Example>

    <h3 class="woven-subtitle">Skeleton arguments</h3>
    <WovenDocs::Table @kind="args" @rows={{this.skeletonArgRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Spinner renders role="status" with the label "Loading"; pass aria-label to describe what is loading.</span></li>
      <li class="wu-list-item"><span>Dot is a span with no role; pass aria-hidden="true" and pair it with visible text. Skeleton is aria-hidden; set aria-busy on the loading region and remove the skeleton once real content renders.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Dot and spinner are symmetric. The skeleton shimmer and the shorter last text line come from the kit.</span></li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
