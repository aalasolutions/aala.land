<WovenDocs::Page
  @id="progress"
  @title="Progress"
  @subtitle="Linear bar and circular ring for determinate and indeterminate progress."
  @components="Woven::Progress, Woven::ProgressCircle"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      Both components clamp the value to 0..100. The bar is the CSS kit
      <code class="wu-code">wu-progress</code>
      on a native
      <code class="wu-code">progress</code>
      element; the ring is
      <code class="wu-code">wu-progress-circle</code>
      with
      <code class="wu-code">role="progressbar"</code>
      and its value in the
      <code class="wu-code">--wu-progress-circle--Value</code>
      variable. Use the bar inside rows and forms, the ring in KPI tiles.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Default fill plus four role colors; three bar heights and three ring sizes.</span></li>
      <li class="wu-list-item"><span>Indeterminate bar with the kit sliding segment.</span></li>
      <li class="wu-list-item"><span>Optional label, default "{value}%" or custom text.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Bar: value" @id="bar-value">
    <WovenDocs::Example
      @title="Live value"
      @note="The bar follows a tracked value; the tooltip on the button reads the same value live. Update it as the underlying work reports progress."
      @layout="stack"
      @code={{this.code.live}}
    >
      <Woven::Progress @value={{this.progressValue}} @showText={{true}} />
      <div>
        <Woven::Button
          @size="sm"
          @text="Bump progress"
          @onClick={{this.bumpProgress}}
          data-tooltip="Now at {{this.progressValue}}%"
          data-test-woven-bump-progress
        />
      </div>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Custom label"
      @note="label replaces the percentage with a count, for quotas where the numbers mean more than the ratio."
      @layout="stack"
      @code={{this.code.label}}
    >
      <Woven::Progress @value={{35}} @showText={{true}} @label="7 of 20 units" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Clamped"
      @note="Values outside 0..100 are clamped, so an over-quota figure renders as full rather than overflowing."
      @layout="stack"
      @code={{this.code.clamp}}
    >
      <Woven::Progress @value={{140}} @showText={{true}} />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Bar: variants" @id="bar-variants">
    {{#each this.barVariantExamples as |example|}}
      <WovenDocs::Example @title={{example.title}} @note={{example.note}} @layout="stack" @code={{example.code}}>
        <Woven::Progress @value={{60}} @variant={{example.variant}} @showText={{true}} />
      </WovenDocs::Example>
    {{/each}}
  </WovenDocs::Section>

  <WovenDocs::Section @title="Bar: sizes and states" @id="bar-styles">
    <WovenDocs::Example
      @title="Small"
      @note="A thin track for table cells and list rows."
      @layout="stack"
      @code={{this.code.sm}}
    >
      <Woven::Progress @value={{50}} @size="sm" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Default"
      @note="The standard track for cards and forms."
      @layout="stack"
      @code={{this.code.md}}
    >
      <Woven::Progress @value={{50}} />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Large"
      @note="A tall track for a page-level upload or import."
      @layout="stack"
      @code={{this.code.lg}}
    >
      <Woven::Progress @value={{50}} @size="lg" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Indeterminate"
      @note="No value attribute, so the kit slides a segment across the track. Prefer a real value as soon as one exists."
      @layout="stack"
      @code={{this.code.indeterminate}}
    >
      <Woven::Progress @indeterminate={{true}} aria-label="Loading" />
    </WovenDocs::Example>


    <h3 class="woven-subtitle">Bar arguments</h3>
    <WovenDocs::Table @kind="args" @rows={{this.barArgRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Circle: variants" @id="circle-variants">
    {{#each this.circleVariantExamples as |example|}}
      <WovenDocs::Example @title={{example.title}} @note={{example.note}} @code={{example.code}}>
        <Woven::ProgressCircle @value={{60}} @variant={{example.variant}} @showText={{true}} />
      </WovenDocs::Example>
    {{/each}}
  </WovenDocs::Section>

  <WovenDocs::Section @title="Circle: sizes" @id="circle-styles">
    <WovenDocs::Example
      @title="Small"
      @note="A ring beside a value in a stat tile or a table row."
      @code={{this.code.circleSm}}
    >
      <Woven::ProgressCircle @value={{45}} @variant="success" @showText={{true}} @size="sm" />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Default"
      @note="The standard ring for cards."
      @code={{this.code.circleMd}}
    >
      <Woven::ProgressCircle @value={{75}} @showText={{true}} />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Large"
      @note="A hero ring for a dashboard headline."
      @code={{this.code.circleLg}}
    >
      <Woven::ProgressCircle @value={{90}} @variant="danger" @showText={{true}} @size="lg" />
    </WovenDocs::Example>


    <WovenDocs::Example
      @title="Without text"
      @note="The ring alone, when the value is printed elsewhere. Pass aria-label so the progressbar has a name."
      @code={{this.code.circleNoText}}
    >
      <Woven::ProgressCircle @value={{30}} aria-label="Storage used" />
    </WovenDocs::Example>

    <h3 class="woven-subtitle">Circle arguments</h3>
    <WovenDocs::Table @kind="args" @rows={{this.circleArgRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>The bar is a native progress element; with @showText its label element names it through for. Otherwise pass aria-label.</span></li>
      <li class="wu-list-item"><span>The ring renders role="progressbar" with aria-valuenow, aria-valuemin="0" and aria-valuemax="100"; pass aria-label to name it.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>The native bar fills from the inline start, so it mirrors under dir="rtl".</span></li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
