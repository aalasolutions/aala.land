<WovenDocs::Page
  @id="divider"
  @title="Divider"
  @subtitle="Horizontal or vertical rule, plain, dashed or labeled."
  @components="Woven::Divider"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      A separator with an optional label, on the CSS kit
      <code class="wu-code">wu-divider</code>: a bare divider is an
      <code class="wu-code">hr</code>, a labeled one a div whose text sits
      between two lines. The horizontal form takes the
      full inline size and splits groups of content; the vertical form
      stretches to the height of its flex row and splits controls in a
      toolbar. Prefer spacing over a divider when the groups are already
      visually distinct.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Solid or dashed line.</span></li>
      <li class="wu-list-item"><span>Centered label from an argument or a block.</span></li>
      <li class="wu-list-item"><span>Vertical variant for toolbars and inline groups.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Line styles" @id="styles">
    <WovenDocs::Example
      @title="Solid"
      @note="The default rule between sections of a card or form."
      @layout="stack"
      @code={{this.code.plain}}
    >
      <Woven::Divider />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Dashed"
      @note="A softer break for optional or draft content, such as between saved and unsaved items."
      @layout="stack"
      @code={{this.code.dashed}}
    >
      <Woven::Divider @dashed={{true}} />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Labels" @id="labels">
    <WovenDocs::Example
      @title="Centered label"
      @note="Short text on the line, for alternatives such as OR between two sign-in methods."
      @layout="stack"
      @code={{this.code.label}}
    >
      <Woven::Divider @label="OR" />
    </WovenDocs::Example>



    <WovenDocs::Example
      @title="Block label"
      @note="A block replaces the label text, for an icon beside the words."
      @layout="stack"
      @code={{this.code.block}}
    >
      <Woven::Divider><Woven::Icon @icon="clock" /> Earlier today</Woven::Divider>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Orientation" @id="orientation">
    <WovenDocs::Example
      @title="Vertical"
      @note="An hr with aria-orientation vertical, which the kit stretches to the height of a flex row to split inline items. It has no label form."
      @layout="block"
      @code={{this.code.vertical}}
    >
      <div class="woven-row woven-row--full-height">
        <span class="wu-text sm">Start</span>
        <Woven::Divider @vertical={{true}} />
        <span class="wu-text sm">End</span>
      </div>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Arguments" @id="arguments">
    <WovenDocs::Table @kind="args" @rows={{this.argRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Blocks" @id="blocks">
    <WovenDocs::Table @kind="blocks" @rows={{this.blockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>A bare divider is an hr, which has the separator role; vertical sets aria-orientation. A labeled divider is a div whose label is read as page text.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>The label is centered and the lines are drawn on both sides, so nothing changes with direction.</span></li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
