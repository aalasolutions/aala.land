<WovenDocs::Page
  @id="breadcrumb"
  @title="Breadcrumb"
  @subtitle="Navigable trail to the current page."
  @components="Woven::Breadcrumb"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      By default the last item is the current page and renders as plain text
      with
      <code class="wu-code">aria-current="page"</code>. Other items render
      as router links when they carry a route, anchors when they carry an
      href, or buttons when they carry an onClick. In a page header, pass
      <code class="wu-code">@parentsOnly</code>
      so every item is a parent link and the header title names the current
      page. It renders the CSS kit
      <code class="wu-code">wu-breadcrumb</code>.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Router link, anchor or button items from one items array.</span></li>
      <li class="wu-list-item"><span>Current page derived from position, or none with parentsOnly.</span></li>
      <li class="wu-list-item"><span>Compact size and a slash separator.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Items" @id="items">
    <WovenDocs::Example
      @title="Links"
      @note="Items with href render as anchors, so the trail works with the browser: hover shows the target, middle-click opens a tab."
      @layout="block"
      @code={{this.code.basic}}
    >
      <Woven::Breadcrumb @items={{this.breadcrumbItems}} />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Routes, parents only"
      @note="Items with route (plus model or models) render as router links, so navigation stays in the app. parentsOnly links every item and marks none current: the form a detail page header uses."
      @layout="block"
      @code={{this.code.routes}}
    >
      <Woven::Breadcrumb @items={{this.routeItems}} @compact={{true}} @parentsOnly={{true}} />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Click handlers"
      @note="Items with onClick render as buttons, for trails that drive in-app state such as a folder tree or a wizard."
      @layout="block"
      @code={{this.code.click}}
    >
      <Woven::Breadcrumb @items={{this.clickItems}} />
      <span class="wu-text sm muted" data-test-woven-crumb-clicked>Last clicked: {{this.lastCrumb}}</span>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Single item"
      @note="One item is the current page alone; render it so the header layout stays stable on top-level pages."
      @layout="block"
      @code={{this.code.single}}
    >
      <Woven::Breadcrumb @items={{this.singleItem}} />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Styles" @id="styles">
    <WovenDocs::Example
      @title="Compact"
      @note="compact adds the kit sm modifier: smaller type, the form used inside a page header."
      @layout="block"
      @code={{this.code.compact}}
    >
      <Woven::Breadcrumb @items={{this.breadcrumbItems}} @compact={{true}} />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Slash separator"
      @note="separator slash adds the kit slash modifier instead of the default chevron. Any other value keeps the chevron."
      @layout="block"
      @code={{this.code.slash}}
    >
      <Woven::Breadcrumb @items={{this.breadcrumbItems}} @separator="slash" />
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Arguments" @id="arguments">
    <WovenDocs::Table @kind="args" @rows={{this.argRows}} />
    <h3 class="woven-subtitle">Item shape</h3>
    <WovenDocs::Table @kind="args" @rows={{this.itemRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Renders a nav labeled "Breadcrumb" wrapping an ordered list.</span></li>
      <li class="wu-list-item"><span>The current item carries aria-current="page"; separators are drawn by CSS and not read aloud.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Item spacing is inline-logical and the chevron separator mirrors, so the trail reads right to left under dir="rtl".</span></li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
