<WovenDocs::Page
  @id="empty-state"
  @title="Empty state"
  @subtitle="Placeholder for a list or region with nothing to show yet."
  @components="Woven::EmptyState"
>
  <WovenDocs::Section @title="Overview" @id="overview">
    <p class="woven-doc__intro">
      An empty state explains why a region is empty and what to do next. It
      renders the CSS kit
      <code class="wu-code">wu-empty-state</code>: an icon slot, title,
      description and an actions row, centered in its container. Show it in place of the list, never beside it, and give
      it the primary next step whenever one exists.
    </p>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Features" @id="features">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Icon from an argument or a block.</span></li>
      <li class="wu-list-item"><span>Default and small sizes; dashed border.</span></li>
      <li class="wu-list-item"><span>Actions slot for the next step.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Content" @id="content">
    <WovenDocs::Example
      @title="Icon, title, description"
      @note="The base form for a first-run screen: what is missing and why."
      @layout="block"
      @code={{this.code.basic}}
    >
      <Woven::EmptyState
        @icon="🏢"
        @title="No properties yet"
        @description="Add your first property to start tracking units, tenants, and leases."
      />
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="With an action"
      @note="The actions slot holds the next step, so an empty list becomes the place where the first record is created."
      @layout="block"
      @code={{this.code.actions}}
    >
      <Woven::EmptyState
        @icon="🏢"
        @title="No properties yet"
        @description="Add your first property to start tracking units, tenants, and leases."
      >
        <:actions>
          <Woven::Button @variant="brand" @size="sm" @text="Add Property" />
        </:actions>
      </Woven::EmptyState>
    </WovenDocs::Example>

    <WovenDocs::Example
      @title="Icon block"
      @note="A block in the kit wu-empty-state-icon slot for a Phosphor icon instead of a glyph. Without @icon or a block the slot is not rendered."
      @layout="block"
      @code={{this.code.iconBlock}}
    >
      <Woven::EmptyState @title="Nothing to review" @description="Documents you upload will appear here.">
        <:icon><Woven::Icon @icon="tray" /></:icon>
      </Woven::EmptyState>
    </WovenDocs::Example>
  </WovenDocs::Section>

  <WovenDocs::Section @title="Sizes" @id="sizes">
    <WovenDocs::Example
      @title="Small"
      @note="Kit sm, for use inside a card, panel or table: a filtered list with no matches, where the surrounding controls stay visible. @size xs renders the same; any other size renders the default."
      @layout="block"
      @code={{this.code.sm}}
    >
      <Woven::EmptyState @icon="🔍" @size="sm" @title="No results" @description="No units match this filter." />
    </WovenDocs::Example>

  </WovenDocs::Section>

  <WovenDocs::Section @title="Layouts" @id="layouts">
    <WovenDocs::Example
      @title="Bordered"
      @note="Kit dashed: a dashed border marks the region the content will occupy, for drop zones and card bodies."
      @layout="block"
      @code={{this.code.bordered}}
    >
      <Woven::EmptyState @icon="🔍" @title="No results" @description="No units match this filter." @bordered={{true}} />
    </WovenDocs::Example>

  </WovenDocs::Section>

  <WovenDocs::Section @title="Arguments" @id="arguments">
    <WovenDocs::Table @kind="args" @rows={{this.argRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Blocks" @id="blocks">
    <WovenDocs::Table @kind="blocks" @rows={{this.blockRows}} />
  </WovenDocs::Section>

  <WovenDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>The icon slot is aria-hidden; title and description are paragraphs and carry the message. The title is not a heading.</span></li>
      <li class="wu-list-item"><span>Put the primary next step in the actions slot so it is reachable in reading order.</span></li>
    </ul>
  </WovenDocs::Section>

  <WovenDocs::Section @title="RTL" @id="rtl">
    <ul class="wu-list sm" role="list">
      <li class="wu-list-item"><span>Content is centered, so nothing changes with direction. Icons named left or right in the icon block mirror automatically.</span></li>
    </ul>
  </WovenDocs::Section>
</WovenDocs::Page>
