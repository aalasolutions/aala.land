{{page-title "Financials"}}

<div data-test-financials-page class="flex col gap-6">
  <Nuvo::PageHeader
    @title="Financial Overview"
    @subtitle="Transactions, revenue, and payment tracking."
  >
    <:actions>
      <Nuvo::Button
        @variant="primary"
        @icon="plus"
        {{on "click" this.openCreate}}
      >
        New Transaction
      </Nuvo::Button>
    </:actions>
  </Nuvo::PageHeader>

  {{#unless @model.forbidden}}
    <Nuvo::Card
      @title="Cheques to chase"
      @subtitle="Overdue and due this week, as of today. The period below does not filter this list."
      data-test-financials-queue
    >
      <div class="flex col gap-3">
        {{#if this.queueFailed}}
          <Financials::LoadError
            @title="Could not load everything that is due"
            @description="Cheques or payments may be missing from this list."
            @onRetry={{this.retryLoad}}
            data-test-queue-error
          />
        {{/if}}

        {{#if this.queue.count}}
          {{#if this.queue.overdueCount}}
            <p class="text-sm font-bold text-danger" data-test-queue-overdue>
              <Money @amount={{this.queue.overdueTotal}} />
              overdue across
              {{format-number this.queue.overdueCount unit="item"}}
            </p>
          {{/if}}

          <ul class="finance-queue">
            {{#each this.queue.rows key="key" as |row|}}
              <li class="finance-queue__row" data-test-queue-row={{row.kind}}>
                <Nuvo::Tag
                  @size="sm"
                  @variant={{if row.isOverdue "danger"}}
                  @text={{row.dueLabel}}
                  data-test-queue-due
                />
                <div class="finance-queue__what">
                  <p class="text-sm font-bold"><DueLabel
                      @label={{row.title}}
                      @word={{row.dueWord}}
                      @dueDate={{row.dueDate}}
                    /></p>
                  <p class="text-muted text-xs">
                    {{#if (eq row.kind "cheque")}}
                      {{row.holder}},
                      {{row.detail}}
                    {{else}}
                      Payment due
                    {{/if}}
                    &middot;
                    {{format-date row.dueDate}}
                  </p>
                </div>
                <div class="finance-queue__links">
                  {{#if (eq row.kind "cheque")}}
                    <LinkTo
                      @route="cheques"
                      class="text-primary"
                      data-test-queue-cheque-link={{row.id}}
                    >Open in Cheques</LinkTo>
                  {{else}}
                    {{#if row.areaId}}
                      <LinkTo
                        @route="properties.unit"
                        @models={{array row.areaId row.unitId}}
                        class="text-primary"
                        data-test-reminder-unit-link={{row.unitId}}
                      >Unit {{row.unitNumber}}</LinkTo>
                    {{/if}}
                    {{#if row.tenantContactId}}
                      <LinkTo
                        @route="contacts.detail"
                        @model={{row.tenantContactId}}
                        class="text-primary"
                        data-test-reminder-tenant-link={{row.tenantContactId}}
                      >{{or row.tenantName "Tenant"}}</LinkTo>
                    {{/if}}
                  {{/if}}
                </div>
                <p class="finance-queue__amount" data-test-queue-amount>
                  <Money @amount={{row.amount}} @currency={{row.currency}} />
                </p>
              </li>
            {{/each}}
          </ul>

          {{#if this.queue.hiddenCount}}
            <LinkTo
              @route="cheques"
              class="text-primary text-sm"
              data-test-queue-view-all
            >View all in Cheques ({{format-number this.queue.hiddenCount}}
              more)</LinkTo>
          {{/if}}
        {{else if (not this.queueFailed)}}
          <Nuvo::EmptyState
            @description="Nothing to chase. No cheque or payment is overdue or due this week."
            data-test-queue-empty
          />
        {{/if}}
      </div>
    </Nuvo::Card>
  {{/unless}}

  <div class="finance-filters" data-test-financials-period>
    <h2 class="text-lg font-bold">{{this.rangeLabel}}</h2>

    <div class="finance-filters__range">
      <Nuvo::Segmented
        @options={{this.rangeOptions}}
        @value={{this.range}}
        @onChange={{this.setRange}}
        data-test-financials-range
      />

      {{#if this.isCustomRange}}
        <div class="finance-filters__dates" data-test-financials-custom-range>
          <Nuvo::Input
            type="date"
            aria-label="From date"
            max={{this.to}}
            @value={{this.from}}
            @invalid={{this.rangeError}}
            @onChange={{fn this.setRangeBound "from"}}
            data-test-financials-from
          />
          <span class="finance-filters__to">to</span>
          <Nuvo::Input
            type="date"
            aria-label="To date"
            min={{this.from}}
            @value={{this.to}}
            @invalid={{this.rangeError}}
            @onChange={{fn this.setRangeBound "to"}}
            data-test-financials-to
          />
        </div>
        {{#if this.rangeError}}
          <p
            class="text-xs text-danger"
            role="alert"
            data-test-financials-range-error
          >{{this.rangeError}}</p>
        {{/if}}
      {{/if}}
    </div>
  </div>

  {{#if this.totals}}
    <div class="grid cols-1 cols-3@md gap-4">
      <Nuvo::Stat
        data-test-summary="total-income"
        @variant="success"
        @label="Collected"
        @value={{format-money this.totals.income}}
        @delta={{this.rangeLabel}}
      />
      <Nuvo::Stat
        data-test-summary="total-expense"
        @variant="danger"
        @label="Spent"
        @value={{format-money this.totals.expense}}
        @delta={{this.rangeLabel}}
      />
      <Nuvo::Stat
        data-test-summary="net"
        @label="Net"
        @value={{format-money this.totals.net}}
        @delta={{this.rangeLabel}}
      />
    </div>
  {{/if}}

  {{#unless @model.forbidden}}
    <div class="grid cols-1 cols-2@lg gap-4">
      <Nuvo::Card
        @title="Cash flow"
        @subtitle="Completed income and expense by {{this.bucketNoun}}, ending with the selected period."
        data-test-financials-cashflow
      >
        {{#if this.cashflowFailed}}
          <Financials::LoadError
            @title="Could not load the cash flow"
            @onRetry={{this.retryLoad}}
            data-test-cashflow-error
          />
        {{else if this.cashflow.length}}
          <CashflowChart @points={{this.cashflow}} />
        {{else}}
          <Nuvo::EmptyState
            @description="No cash flow for this period."
            data-test-cashflow-empty
          />
        {{/if}}
      </Nuvo::Card>

      <Nuvo::Card
        @title="Where the money went"
        @subtitle="Completed expenses by category for the selected period."
        data-test-financials-categories
      >
        {{#if this.categoriesFailed}}
          <Financials::LoadError
            @title="Could not load spending by category"
            @onRetry={{this.retryLoad}}
            data-test-categories-error
          />
        {{else if this.expenseCategories.length}}
          <div class="flex col gap-3">
            {{#each this.expenseCategories key="category" as |row|}}
              <div
                class="flex col gap-1"
                data-test-category-row={{row.category}}
              >
                <div class="flex between x-center gap-2 text-sm">
                  <span>{{transaction-category-label row.category}}</span>
                  <span class="font-bold"><Money @amount={{row.total}} /></span>
                </div>
                <Nuvo::Progress
                  @value={{row.share}}
                  @variant="danger"
                  @size="sm"
                  @showText={{true}}
                  @label="{{row.share}}%"
                />
              </div>
            {{/each}}
          </div>
        {{else}}
          <Nuvo::EmptyState
            @description="No completed expenses in this period."
            data-test-categories-empty
          />
        {{/if}}
      </Nuvo::Card>
    </div>
  {{/unless}}

  <div>
    <Nuvo::Segmented
      @options={{this.transactionTabs}}
      @value={{this.activeTab}}
      @onChange={{this.setTab}}
      data-test-financials-tabs
    />
  </div>

  <Nuvo::Card @title="Transactions">
    {{#if @model.forbidden}}
      <Nuvo::Alert
        @variant="danger"
        @title="No access to financial records"
        @description="Your role or the active region does not allow viewing financial records."
        data-test-financials-forbidden
      />
    {{else if @model.error}}
      <Financials::LoadError
        @title="Could not load financials"
        @description={{@model.error}}
        @onRetry={{this.retryLoad}}
        data-test-financials-error
      />
    {{else if this.filteredTransactions.length}}
      <Nuvo::DataTable
        @columns={{this.columns}}
        @rows={{this.filteredTransactions}}
        @pinColumns={{true}}
        @reorderable={{true}}
        @sortable={{true}}
        @showOptions={{true}}
        @tableId="financials"
        @getRowClass={{this.getRowClass}}
        data-test-financials-table
        as |cell|
      >
        {{#if (eq cell.key "description")}}
          <span data-test-transaction>{{cell.value}}</span>
        {{else if (eq cell.key "amount")}}
          <span
            class="font-bold
              {{if (eq cell.row.type 'INCOME') 'text-success' 'text-danger'}}"
          >
            {{if (eq cell.row.type "INCOME") "+" "-"}}<Money
              @amount={{cell.value}}
              @currency={{cell.row.currency}}
              @compact={{false}}
            />
          </span>
        {{else if (eq cell.key "status")}}
          <Nuvo::Tag
            class="tag-txn-{{lowercase cell.value}}"
            @text={{cell.value}}
          />
        {{else if (eq cell.key "transactionDate")}}
          <span class="text-xs">{{format-date cell.value}}</span>
        {{else if (eq cell.key "id")}}
          {{#if cell.row.chequeId}}
            {{! The cheque owns this row; editing it is refused with a 409. }}
            <span class="text-xs text-muted" data-test-from-cheque>From cheque</span>
          {{else}}
            <Nuvo::Button
              @subtle={{true}}
              @variant="secondary"
              @size="xs"
              @icon="pencil-simple"
              aria-label="Edit {{cell.row.description}}"
              data-tooltip="Edit"
              data-test-edit-transaction
              {{on "click" (fn this.openEdit cell.row)}}
            />
          {{/if}}
        {{else}}
          {{cell.value}}
        {{/if}}
      </Nuvo::DataTable>
    {{else if @model.total}}
      <Nuvo::EmptyState
        data-test-financials-page-empty
        @description="No transactions on this page with current filters. Adjust filters or navigate to find transactions."
      />
    {{else}}
      <Nuvo::EmptyState
        data-test-financials-empty
        @description={{if
          (eq this.activeTab "INCOME")
          "No income transactions."
          (if
            (eq this.activeTab "EXPENSE")
            "No expense transactions."
            "No transactions yet."
          )
        }}
      />
    {{/if}}

    {{#if @model.total}}
      <Nuvo::Pagination
        @selectId="financials-limit"
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{@model.total}}
        @onLimitChange={{this.setLimit}}
        @onPrevious={{this.goToPreviousPage}}
        @onNext={{this.goToNextPage}}
        @onPageChange={{this.goToPage}}
      />
    {{/if}}
  </Nuvo::Card>
</div>

<Nuvo::Drawer
  @open={{this.showModal}}
  @title={{if this.editTransaction "Edit Transaction" "New Transaction"}}
  @placement="end"
  @size="lg"
  @onClose={{this.closeModal}}
  @onClosed={{this.resetDrawer}}
>
  <:body>
    <form
      id="transaction-form"
      class="flex col gap-4"
      {{on "submit" this.saveTx}}
    >
      <div class="flex gap-4">
        <Nuvo::Field
          @label="Payment Method"
          @required={{true}}
          @tooltip="A cheque here is one you paid out. Cheques you receive are recorded on the Cheques Received page."
          class="grow"
        >
          <Nuvo::Dropdown
            id="tx-payment"
            @align="start"
            @value={{this.formPaymentMethod}}
            @onSelect={{this.setPaymentMethod}}
            @options={{this.paymentMethodOptions}}
            @placeholder="Select payment method..."
            data-test-tx-payment
          />
        </Nuvo::Field>
        <Nuvo::Field @label="Category" @required={{true}} class="grow">
          <Nuvo::Dropdown
            id="tx-category"
            @align="start"
            @value={{this.formCategory}}
            @onSelect={{this.setCategory}}
            @options={{this.categoryOptions}}
            @placeholder="Select category..."
            data-test-tx-category
          />
        </Nuvo::Field>
      </div>
      <div class="flex gap-4">
        <Nuvo::Field @label="Payment Type" @required={{true}} class="grow">
          {{! Readonly when the category or the payment method already decides it. }}
          <Nuvo::Dropdown
            id="tx-type"
            @align="start"
            @value={{this.formType}}
            @onSelect={{fn this.setFieldValue "formType"}}
            @options={{this.transactionTypeOptions}}
            @placeholder="Select type..."
            @disabled={{this.typeLocked}}
            data-test-tx-type
          />
        </Nuvo::Field>
        <Nuvo::Field @label="Amount" @required={{true}} class="grow">
          <Nuvo::Input
            id="tx-amount"
            type="number"
            min="0"
            step="0.01"
            placeholder="e.g. 15000"
            @value={{this.formAmount}}
            @onInput={{fn this.setFieldValue "formAmount"}}
            required={{true}}
            data-test-tx-amount
          />
        </Nuvo::Field>
      </div>
      <Nuvo::Field @label="Description">
        <Nuvo::Input
          id="tx-desc"
          type="text"
          placeholder="e.g. Monthly rent payment"
          @value={{this.formDescription}}
          @onInput={{fn this.setFieldValue "formDescription"}}
        />
      </Nuvo::Field>
      <div class="flex gap-4">
        <Nuvo::Field
          @label={{this.dateLabel}}
          @required={{this.dateRequired}}
          class="grow"
        >
          <Nuvo::Input
            id="tx-date"
            type="date"
            min={{this.dateWindow.earliest}}
            max={{this.dateWindow.latest}}
            @value={{this.formDate}}
            @onInput={{fn this.setFieldValue "formDate"}}
          />
        </Nuvo::Field>
        <Nuvo::Field @label="Status" @required={{true}} class="grow">
          <Nuvo::Dropdown
            id="tx-status"
            @align="start"
            @value={{this.formStatus}}
            @onSelect={{fn this.setFieldValue "formStatus"}}
            @options={{this.statusOptions}}
            @placeholder="Select status..."
          />
        </Nuvo::Field>
      </div>
      {{#if this.errorMsg}}
        <p class="text-sm text-danger" data-test-error>{{this.errorMsg}}</p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Nuvo::Button
      @variant="secondary"
      @onClick={{this.closeModal}}
    >Cancel</Nuvo::Button>
    <Nuvo::Button
      @variant="primary"
      @type="submit"
      form="transaction-form"
      @loading={{this.isSaving}}
    >{{if
        this.isSaving
        "Saving..."
        (if this.editTransaction "Update" "Create")
      }}</Nuvo::Button>
  </:footer>
</Nuvo::Drawer>