{{page-title "Financials"}}

<div data-test-financials-page class="flex col gap-6">
  <Nuvo::PageHeader @title="Financial Overview">
    <:meta>
      <p class="text-muted">Transactions, revenue, and payment tracking.</p>
    </:meta>
    <:actions>
      <Nuvo::Button
        @variant="primary"
        {{on "click" this.openCreate}}
      >
        <Ui::Ph @icon="plus" />
        New Transaction
      </Nuvo::Button>
    </:actions>
  </Nuvo::PageHeader>

  {{#if @model.summary}}
    <div class="grid cols-3 gap-4">
      <Nuvo::Stat
        data-test-summary="total-income"
        @variant="success"
        @label="Total Income"
        @value={{format-currency @model.summary.totalIncome}}
      >
        <:icon><Ui::Ph @icon="trend-up" /></:icon>
      </Nuvo::Stat>
      <Nuvo::Stat
        data-test-summary="total-expense"
        @variant="danger"
        @label="Total Expenses"
        @value={{format-currency @model.summary.totalExpense}}
      >
        <:icon><Ui::Ph @icon="trend-down" /></:icon>
      </Nuvo::Stat>
      <Nuvo::Stat
        data-test-summary="net"
        @label="Net Balance"
        @value={{format-currency @model.summary.net}}
      >
        <:icon><Ui::Ph @icon="scale" /></:icon>
      </Nuvo::Stat>
    </div>
  {{/if}}

  {{#if @model.depositReminders.length}}
    <Nuvo::Card @title="Deposit Reminders">
      <div class="flex col gap-2">
        {{#each @model.depositReminders as |reminder|}}
          <Nuvo::ListItem>
            <:main>
              <div>
                <p class="text-sm font-bold">{{reminder.description}}</p>
                <p class="text-muted text-xs">Due:
                  {{format-date reminder.dueDate}}
                  -
                  {{reminder.category}}</p>
              </div>
            </:main>
            <:actions>
              <p class="text-sm font-bold">{{format-currency reminder.amount}}</p>
            </:actions>
          </Nuvo::ListItem>
        {{/each}}
      </div>
    </Nuvo::Card>
  {{/if}}

  <Nuvo::Card @title="Transactions">
    <Nuvo::Tabs
      @tabs={{this.transactionTabs}}
      @activeTab={{this.activeTab}}
      @onChange={{this.setTab}}
    />
    {{#if this.filteredTransactions.length}}
      <div class="nu-table-wrapper">
        <table class="nu-table" data-test-financials-table>
          <thead>
            <tr>
              <th>Description</th>
              <th>Category</th>
              <th>Payment</th>
              <th>Amount</th>
              <th>Status</th>
              <th>Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each this.filteredTransactions as |tx|}}
              <tr data-test-transaction>
                <td>{{tx.description}}</td>
                <td>{{tx.category}}</td>
                <td>{{tx.paymentMethod}}</td>
                <td
                  class="font-bold
                    {{if (eq tx.type 'INCOME') 'text-success' 'text-danger'}}"
                >
                  {{if (eq tx.type "INCOME") "+" "-"}}{{format-currency
                    tx.amount
                  }}
                </td>
                <td>
                  <Nuvo::Tag
                    class="badge-txn-{{lowercase tx.status}}"
                    @text={{tx.status}}
                  />
                </td>
                <td class="text-xs">{{format-date tx.transactionDate}}</td>
                <td>
                  <Nuvo::Button
                    @variant="secondary"
                    @size="xs"
                    {{on "click" (fn this.openEdit tx)}}
                  >
                    <Ui::Ph @icon="pencil-simple" />
                    Edit
                  </Nuvo::Button>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      <Nuvo::Pagination
        @selectId="financials-limit"
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{@model.total}}
        @onLimitChange={{this.setLimit}}
        @onPrevious={{this.goToPreviousPage}}
        @onNext={{this.goToNextPage}}
      />
    {{else}}
      {{#if @model.total}}
        <p class="text-muted text-center py-4">
          No transactions on this page with current filters. Adjust filters or
          navigate to find transactions.
        </p>
        <Nuvo::Pagination
          @selectId="financials-limit"
          @page={{this.page}}
          @limit={{this.limit}}
          @total={{@model.total}}
          @onLimitChange={{this.setLimit}}
          @onPrevious={{this.goToPreviousPage}}
          @onNext={{this.goToNextPage}}
        />
      {{else}}
        <p class="text-muted text-center py-4">
          {{if
            (eq this.activeTab "INCOME")
            "No income transactions."
            (if
              (eq this.activeTab "EXPENSE")
              "No expense transactions."
              "No transactions yet."
            )
          }}
        </p>
      {{/if}}
    {{/if}}
  </Nuvo::Card>
</div>

<Nuvo::Modal
  @open={{this.showModal}}
  @title={{if this.editTransaction "Edit Transaction" "New Transaction"}}
  @onClose={{this.closeModal}}
>
  <form class="flex col gap-4" {{on "submit" this.saveTx}}>
    <div class="flex gap-4">
      <Nuvo::Field @label="Type" @required={{true}} class="grow">
        <Nuvo::Dropdown
          id="tx-type"
          @align="start"
          @value={{this.formType}}
          @onSelect={{fn this.setFieldValue "formType"}}
          @options={{this.transactionTypeOptions}}
          @placeholder="Select type..."
        />
      </Nuvo::Field>
      <Nuvo::Field @label="Category" @required={{true}} class="grow">
        <Nuvo::Dropdown
          id="tx-category"
          @align="start"
          @value={{this.formCategory}}
          @onSelect={{fn this.setFieldValue "formCategory"}}
          @options={{this.categoryOptions}}
          @placeholder="Select category..."
        />
      </Nuvo::Field>
    </div>
    <div class="flex gap-4">
      <Nuvo::Field @label="Amount" @required={{true}} class="grow">
        <Nuvo::Input
          id="tx-amount"
          type="number"
          min="0"
          step="0.01"
          placeholder="e.g. 15000"
          @value={{this.formAmount}}
          @onInput={{fn this.setFieldValue "formAmount"}}
          required={{true}}
        />
      </Nuvo::Field>
      <Nuvo::Field @label="Payment Method" @required={{true}} class="grow">
        <Nuvo::Dropdown
          id="tx-payment"
          @align="start"
          @value={{this.formPaymentMethod}}
          @onSelect={{fn this.setFieldValue "formPaymentMethod"}}
          @options={{this.paymentMethodOptions}}
          @placeholder="Select payment method..."
        />
      </Nuvo::Field>
    </div>
    <Nuvo::Field @label="Description">
      <Nuvo::Input
        id="tx-desc"
        type="text"
        placeholder="e.g. Monthly rent payment"
        @value={{this.formDescription}}
        @onInput={{fn this.setFieldValue "formDescription"}}
      />
    </Nuvo::Field>
    <div class="flex gap-4">
      <Nuvo::Field @label="Date" class="grow">
        <Nuvo::Input
          id="tx-date"
          type="date"
          @value={{this.formDate}}
          @onInput={{fn this.setFieldValue "formDate"}}
        />
      </Nuvo::Field>
      <Nuvo::Field @label="Status" @required={{true}} class="grow">
        <Nuvo::Dropdown
          id="tx-status"
          @align="start"
          @value={{this.formStatus}}
          @onSelect={{fn this.setFieldValue "formStatus"}}
          @options={{this.statusOptions}}
          @placeholder="Select status..."
        />
      </Nuvo::Field>
    </div>
    {{#if this.errorMsg}}
      <p class="text-sm text-danger" data-test-error>{{this.errorMsg}}</p>
    {{/if}}
    <Nuvo::FormActions @align="end">
      <Nuvo::Button
        @variant="secondary"
        @onClick={{this.closeModal}}
      >Cancel</Nuvo::Button>
      <Nuvo::Button
        @variant="primary"
        @type="submit"
        @loading={{this.isSaving}}
      >{{if
          this.isSaving
          "Saving..."
          (if this.editTransaction "Update" "Create")
        }}</Nuvo::Button>
    </Nuvo::FormActions>
  </form>
</Nuvo::Modal>