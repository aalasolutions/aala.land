{{page-title "Reset Password"}}

<div data-test-reset-password-page class="login-page">
  <Woven::Card class="login-card">
    <div class="flex col gap-8">
      <div class="text-center">
        <Woven::Title @tag="h1" @size="2xl" @text="AALA.LAND" />
        <p class="text-muted text-sm mt-2">Reset your password</p>
      </div>

      <ResetPasswordForm @token={{this.model.token}} />
    </div>
  </Woven::Card>
</div>