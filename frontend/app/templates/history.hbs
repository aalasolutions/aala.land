{{page-title "History"}}

<Woven::ListPage
  @title="History"
  @subtitle="Deletes, archives, cancellations and other lifecycle actions"
  @isEmpty={{not this.rows.length}}
  data-test-history-page
>
  <:toolbar>
    <FiltersButton @count={{this.activeFilterCount}}>
      <div class="flex col gap-4">
        <div class="flex gap-3 wrap x-end">
          <Woven::Field class="grow" @label="Action">
            <Woven::Dropdown
              @searchable={{true}}
              @align="start"
              @value={{this.filterAction}}
              @onSelect={{this.setFilterAction}}
              @options={{this.actionOptions}}
              @placeholder="All Actions"
              data-test-history-filter-action
            />
          </Woven::Field>

          <Woven::Field class="grow" @label="Record type">
            <Woven::Dropdown
              @searchable={{true}}
              @align="start"
              @value={{this.filterEntityType}}
              @onSelect={{this.setFilterEntityType}}
              @options={{this.entityTypeOptions}}
              @placeholder="All Entities"
              data-test-history-filter-entity
            />
          </Woven::Field>
        </div>

        <div class="flex end">
          <Woven::Button
            @variant="danger"
            @icon="x"
            @disabled={{not this.hasActiveFilters}}
            {{on "click" this.clearFilters}}
            data-test-clear-filters
          >
            Clear filters
          </Woven::Button>
        </div>
      </div>
    </FiltersButton>
  </:toolbar>

  <:body as |page|>
    <Woven::DataTable
      @columns={{this.columns}}
      @rows={{this.rows}}
      @pinColumns={{true}}
      @reorderable={{true}}
      @sortable={{true}}
      @showOptions={{true}}
      @optionsTarget={{page.optionsTarget}}
      @tableId="history"
      class="table-stacked"
      data-test-history-table
    />
  </:body>

  <:empty>
    {{#if this.model.forbidden}}
      <Woven::Alert @variant="danger" data-test-history-forbidden>
        You don't have permission to view history.
      </Woven::Alert>
    {{else if this.model.error}}
      <Woven::Alert
        @variant="danger"
        @description={{this.model.error}}
        data-test-history-error
      />
    {{else}}
      <Woven::EmptyState @title="No history found" data-test-history-empty />
    {{/if}}
  </:empty>

  <:footer as |page|>
    {{#if this.model.total}}
      <page.Pager
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{this.model.total}}
        @onLimitChange={{this.setLimit}}
        @onPageChange={{this.goToPage}}
        @onPrevious={{this.goToPreviousPage}}
        @onNext={{this.goToNextPage}}
        data-test-history-pagination
      />
    {{/if}}
  </:footer>
</Woven::ListPage>