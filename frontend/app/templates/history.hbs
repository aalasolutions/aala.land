{{page-title "History"}}
<Nuvo::PageHeader
  @title="History"
  @subtitle="Deletes, archives, cancellations and other lifecycle actions"
/>

<Nuvo::Card data-test-history-page>
  <:header>
    <Nuvo::Toolbar class="flex-wrap">
      <Nuvo::Field @label="Action">
        <Nuvo::Dropdown
          @searchable={{true}}
          @align="start"
          @value={{this.filterAction}}
          @onSelect={{this.setFilterAction}}
          @options={{this.actionOptions}}
          @placeholder="All Actions"
          data-test-history-filter-action
        />
      </Nuvo::Field>

      <Nuvo::Field @label="Record type">
        <Nuvo::Dropdown
          @searchable={{true}}
          @align="start"
          @value={{this.filterEntityType}}
          @onSelect={{this.setFilterEntityType}}
          @options={{this.entityTypeOptions}}
          @placeholder="All Entities"
          data-test-history-filter-entity
        />
      </Nuvo::Field>

      {{#if (or this.filterAction this.filterEntityType)}}
        <Nuvo::Button
          @variant="secondary"
          @text="Clear Filters"
          data-test-history-clear-filters
          {{on "click" this.clearFilters}}
        />
      {{/if}}
    </Nuvo::Toolbar>
  </:header>

  <:body>
    {{#if this.model.forbidden}}
      <Nuvo::Alert
        @variant="danger"
        data-test-history-forbidden
      >
        You don't have permission to view history.
      </Nuvo::Alert>
    {{else if this.model.error}}
      <Nuvo::Alert
        @variant="danger"
        @description={{this.model.error}}
        data-test-history-error
      />
    {{else if this.rows.length}}
      <Nuvo::DataTable
        @columns={{this.columns}}
        @rows={{this.rows}}
        @pinColumns={{true}}
        @reorderable={{true}}
        @sortable={{true}}
        @showOptions={{true}}
        @tableId="history"
        data-test-history-table
        as |cell|
      >
        {{#if (eq cell.key "createdAt")}}
          <span
            class="text-sm text-muted"
            data-test-history-row={{cell.row.id}}
          >{{format-date-time cell.value region=cell.row.regionCode}}</span>
        {{else if (eq cell.key "actionLabel")}}
          <Nuvo::Tag
            @variant={{cell.row.actionVariant}}
            @text={{cell.value}}
            data-test-history-action
          />
        {{else if (eq cell.key "entityTypeLabel")}}
          <span class="text-sm">{{cell.value}}</span>
        {{else if (eq cell.key "entityTitle")}}
          <span class="font-bold">{{cell.value}}</span>
        {{else if (eq cell.key "contextTitle")}}
          <span class="text-sm text-muted">{{if cell.value cell.value "-"}}</span>
        {{else if (eq cell.key "reason")}}
          <span class="text-sm">{{if cell.value cell.value "-"}}</span>
        {{else}}
          <span class="text-sm text-muted">{{cell.value}}</span>
        {{/if}}
      </Nuvo::DataTable>

      <Nuvo::Pagination
        @selectId="history-limit"
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{this.model.total}}
        @onLimitChange={{this.setLimit}}
        @onPageChange={{this.goToPage}}
        @onPrevious={{this.goToPreviousPage}}
        @onNext={{this.goToNextPage}}
        data-test-history-pagination
      />
    {{else}}
      <Nuvo::EmptyState @title="No history found" data-test-history-empty />
    {{/if}}
  </:body>
</Nuvo::Card>