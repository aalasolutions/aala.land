{{page-title "WhatsApp"}}

<div data-test-whatsapp-page class="wa-shell">

  <Nuvo::PageHeader
    class="wa-shell__header"
    @icon="whatsapp-logo"
    @title="WhatsApp"
  />

  <div class="wa-page">

    {{! ── Left sidebar ─────────────────────────────────────────────── }}
    <aside class="wa-sidebar">

      <div class="wa-sidebar-header">
        <span>Chats</span>

        <div class="wa-sidebar-actions">
          {{! On a wrapper: a disabled button has pointer-events: none. }}
          <span
            data-tooltip={{if
              this.isCompanyAdmin
              (if
                this.aiKeyConfigured
                "Toggle AI auto-reply"
                "No AI key configured"
              )
              "Only Company Admin can toggle AI"
            }}
            data-tooltip-position="bottom"
          >
            <Nuvo::Button
              @variant={{if this.aiEnabled "info" "secondary"}}
              @size="xs"
              @icon="robot"
              @text={{concat "AI: " (if this.aiEnabled "on" "off")}}
              @disabled={{or
                (not this.isCompanyAdmin)
                (not this.aiKeyConfigured)
              }}
              data-test-ai-toggle
              {{on "click" this.toggleAi}}
            />
          </span>
        </div>
      </div>

      {{#if this.creditUsageLabel}}
        <div class="wa-credit-usage" data-test-ai-credit-usage>
          {{this.creditUsageLabel}}
          {{#if this.openWindows}}
            <span data-test-ai-open-windows>({{this.openWindows}} open)</span>
          {{/if}}
        </div>
      {{/if}}

      {{! Chat list }}
      <div class="wa-chat-list">
        {{#each this.chats as |chat|}}
          <button
            type="button"
            class="wa-chat-item
              {{if (eq this.currentChatId chat.chatId) 'is-active'}}"
            data-test-wa-chat={{chat.chatId}}
            {{on "click" (fn this.selectChat chat.chatId)}}
          >
            <div class="flex between x-center">
              <span class="wa-chat-name">
                {{#if chat.isGroup}}
                  <Nuvo::Tag @size="sm" @text="group" />
                {{/if}}
                {{chat.chatName}}
              </span>
              <span class="wa-chat-time">{{format-date-time chat.lastTs}}</span>
            </div>
            <p class="wa-chat-preview">
              {{#if chat.lastFromMe}}You: {{/if}}{{chat.lastBody}}
            </p>
          </button>
        {{else}}
          <Nuvo::EmptyState @title="No chats yet" />
        {{/each}}
      </div>

    </aside>

    {{! ── Main chat area ────────────────────────────────────────────── }}
    <main class="wa-chat-area">

      {{#if this.currentChatId}}

        <div class="wa-chat-header">
          <div class="wa-chat-header-name">{{this.currentChatName}}</div>
          <div class="wa-chat-header-id">{{this.currentChatId}}</div>
        </div>

        <div class="wa-messages" id="wa-messages-container">
          {{#each this.currentChatMessages as |msg|}}
            <div
              class="wa-message
                {{if msg.fromMe 'm-outgoing' 'm-incoming'}}
                {{if msg.aiGenerated 'm-ai'}}"
              data-test-wa-message
            >
              {{#unless msg.fromMe}}
                <div class="wa-sender-tag">{{msg.senderName}}</div>
              {{/unless}}
              <div class="wa-bubble" dir="auto">{{msg.body}}</div>
              <div class="wa-meta">
                <span>{{format-date-time msg.timestamp}}</span>
                {{#if msg.fromMe}}
                  {{#if msg.aiGenerated}}
                    <Nuvo::Tag @variant="info" @size="sm" @text="AI" />
                  {{else}}
                    <span>You</span>
                  {{/if}}
                {{/if}}
              </div>
            </div>
          {{else}}
            <Nuvo::EmptyState @fill={{true}} @title="No messages in this chat yet" />
          {{/each}}
        </div>

        <div class="wa-input-area">
          <div class="wa-input-row">
            <Nuvo::Textarea
              @value={{this.messageText}}
              @onInput={{this.setMessageText}}
              @placeholder="Type a message..."
              @disabled={{this.composerDisabled}}
              @rows="1"
              data-test-wa-composer-input
              {{on "keydown" this.handleKeydown}}
            />
            <Nuvo::Button
              @variant="primary"
              @icon="paper-plane-tilt"
              @text="Send"
              @disabled={{this.composerDisabled}}
              data-test-wa-composer-send
              {{on "click" this.sendMessage}}
            />
          </div>
        </div>

      {{else}}

        <Nuvo::EmptyState
          @fill={{true}}
          @size="lg"
          @title="Select a chat to view its messages"
        >
          <:icon><Ui::Ph @icon="whatsapp-logo" /></:icon>
        </Nuvo::EmptyState>

      {{/if}}

    </main>

  </div>

</div>
