{{page-title "WhatsApp"}}

<div data-test-whatsapp-page class="wa-shell">

  <Nuvo::PageHeader
    class="wa-shell__header"
    @icon="whatsapp-logo"
    @title="WhatsApp"
  />

  {{! ── Connection status ─────────────────────────────────────────────── }}
  <div
    class="wa-connection is-{{this.connectionStatus}}"
    data-test-wa-connection-status={{this.connectionStatus}}
  >
    <Nuvo::Dot @variant={{this.connectionVariant}} @size="sm" />

    <div class="wa-connection__text">
      <span class="wa-connection__label" data-test-wa-connection-label>
        {{this.connectionLabel}}
      </span>
      {{#if this.connectionDetail}}
        <span class="wa-connection__detail" data-test-wa-connection-detail>
          {{this.connectionDetail}}
        </span>
      {{/if}}
    </div>

    {{#if this.isConnected}}
      <span class="wa-connection__cta">
        <Nuvo::Button
          @variant="ghost"
          @size="xs"
          @icon="plugs-connected"
          @text="Disconnect"
          @loading={{this.isConnecting}}
          @onClick={{this.disconnectWhatsapp}}
          data-test-wa-disconnect
        />
      </span>
    {{else if this.needsConnect}}
      {{! Wrapper: a disabled button swallows its own pointer events, tooltip included. }}
      <span
        class="wa-connection__cta"
        data-tooltip={{this.connectTooltip}}
        data-tooltip-position="bottom"
      >
        <Nuvo::Button
          @variant="secondary"
          @size="xs"
          @icon="plugs"
          @text={{this.connectButtonText}}
          @disabled={{this.connectDisabled}}
          @loading={{this.isConnecting}}
          @onClick={{this.connectWhatsapp}}
          data-test-wa-connect
        />
      </span>
    {{/if}}
  </div>

  <div class="wa-page">

    {{! ── Left sidebar ─────────────────────────────────────────────── }}
    <aside class="wa-sidebar">

      <div class="wa-sidebar-header">
        <span>Chats</span>

        <div class="wa-sidebar-actions">
          {{! On a wrapper: a disabled button has pointer-events: none. }}
          <span
            data-tooltip={{if
              this.isCompanyAdmin
              (if
                this.aiKeyConfigured
                "Toggle AI auto-reply"
                "No AI key configured"
              )
              "Only Company Admin can toggle AI"
            }}
            data-tooltip-position="bottom"
          >
            <Nuvo::Button
              @variant={{if this.aiEnabled "info" "secondary"}}
              @size="xs"
              @icon="robot"
              @text={{concat "AI: " (if this.aiEnabled "on" "off")}}
              @disabled={{or
                (not this.isCompanyAdmin)
                (not this.aiKeyConfigured)
              }}
              data-test-ai-toggle
              {{on "click" this.toggleAi}}
            />
          </span>
        </div>
      </div>

      {{#if this.creditUsageLabel}}
        <div class="wa-credit-usage" data-test-ai-credit-usage>
          {{this.creditUsageLabel}}
          {{#if this.openWindows}}
            <span data-test-ai-open-windows>({{this.openWindows}} open)</span>
          {{/if}}
        </div>
      {{/if}}

      {{! Chat list }}
      <div class="wa-chat-list">
        {{#each this.chats as |chat|}}
          <button
            type="button"
            class="wa-chat-item
              {{if (eq this.currentChatId chat.chatId) 'is-active'}}"
            data-test-wa-chat={{chat.chatId}}
            {{on "click" (fn this.selectChat chat.chatId)}}
          >
            <div class="flex between x-center">
              <span class="wa-chat-name">
                {{#if chat.isGroup}}
                  <Nuvo::Tag @size="sm" @text="group" />
                {{/if}}
                {{chat.chatName}}
              </span>
              <span class="wa-chat-time">{{format-date-time chat.lastTs}}</span>
            </div>
            <p class="wa-chat-preview">
              {{#if chat.lastFromMe}}You: {{/if}}{{chat.lastBody}}
            </p>
          </button>
        {{else}}
          <Nuvo::EmptyState @title="No chats yet" />
        {{/each}}
      </div>

    </aside>

    {{! ── Main chat area ────────────────────────────────────────────── }}
    <main class="wa-chat-area">

      {{#if this.currentChatId}}

        <div class="wa-chat-header">
          <div class="wa-chat-header-name">{{this.currentChatName}}</div>
          <div class="wa-chat-header-id">{{this.currentChatId}}</div>
        </div>

        <div class="wa-messages" id="wa-messages-container">
          {{#each this.currentChatMessages key="id" as |msg|}}
            <div
              class="wa-message
                {{if msg.fromMe 'm-outgoing' 'm-incoming'}}
                {{if msg.aiGenerated 'm-ai'}}
                {{if msg.deletedAt 'm-deleted'}}"
              data-test-wa-message={{msg.id}}
            >
              {{#unless msg.fromMe}}
                <div class="wa-sender-tag">{{msg.senderName}}</div>
              {{/unless}}

              {{#if msg.deletedAt}}
                <div class="wa-bubble is-deleted" data-test-wa-message-deleted>
                  <Ui::Ph @icon="prohibit" />
                  This message was deleted
                </div>
              {{else}}
                <div class="wa-bubble" dir="auto">{{msg.body}}</div>
              {{/if}}

              <div class="wa-meta">
                <span>{{format-date-time msg.timestamp}}</span>

                {{#if msg.editedAt}}
                  <span
                    class="wa-edited"
                    data-test-wa-message-edited
                  >edited</span>
                {{/if}}

                {{#if msg.fromMe}}
                  {{#if msg.aiGenerated}}
                    <Nuvo::Tag @variant="info" @size="sm" @text="AI" />
                  {{else}}
                    <span>You</span>
                  {{/if}}

                  {{! Delivery ladder. No status yet means Meta has taken it but
                      has not called back, so it reads as pending, not failed. }}
                  {{#if (eq msg.status "failed")}}
                    <span
                      class="wa-tick is-failed"
                      data-test-wa-message-status="failed"
                      title={{if
                        msg.errorCode
                        (concat "Not delivered. Meta error " msg.errorCode)
                        "Not delivered"
                      }}
                    ><Ui::Ph @icon="warning-circle" /></span>
                  {{else if (eq msg.status "read")}}
                    <span
                      class="wa-tick is-read"
                      data-test-wa-message-status="read"
                      title="Read"
                    ><Ui::Ph @icon="checks" /></span>
                  {{else if (eq msg.status "delivered")}}
                    <span
                      class="wa-tick"
                      data-test-wa-message-status="delivered"
                      title="Delivered"
                    ><Ui::Ph @icon="checks" /></span>
                  {{else if (eq msg.status "sent")}}
                    <span
                      class="wa-tick"
                      data-test-wa-message-status="sent"
                      title="Sent"
                    ><Ui::Ph @icon="check" /></span>
                  {{else}}
                    <span
                      class="wa-tick"
                      data-test-wa-message-status="pending"
                      title="Waiting for WhatsApp"
                    ><Ui::Ph @icon="clock" /></span>
                  {{/if}}
                {{/if}}
              </div>
            </div>
          {{else}}
            <Nuvo::EmptyState
              @fill={{true}}
              @title="No messages in this chat yet"
            />
          {{/each}}
        </div>

        <div class="wa-input-area">
          {{#if this.replyWindow}}
            <div
              class="wa-window
                {{if this.replyWindow.open 'is-open' 'is-closed'}}"
              data-test-wa-window-state={{if
                this.replyWindow.open
                "open"
                "closed"
              }}
            >
              <Ui::Ph @icon={{if this.replyWindow.open "clock" "prohibit"}} />
              <span data-test-wa-window-label>{{this.replyWindow.label}}</span>
              {{#if this.replyWindow.detail}}
                <span
                  class="wa-window__detail"
                >{{this.replyWindow.detail}}</span>
              {{/if}}
            </div>
          {{/if}}

          <div class="wa-input-row">
            <Nuvo::Textarea
              @value={{this.messageText}}
              @onInput={{this.setMessageText}}
              @placeholder="Type a message..."
              @disabled={{this.composerDisabled}}
              @rows="1"
              data-test-wa-composer-input
              {{on "keydown" this.handleKeydown}}
            />
            <Nuvo::Button
              @variant="primary"
              @icon="paper-plane-tilt"
              @text="Send"
              @disabled={{this.composerDisabled}}
              data-test-wa-composer-send
              {{on "click" this.sendMessage}}
            />
          </div>
        </div>

      {{else}}

        <Nuvo::EmptyState
          @fill={{true}}
          @size="lg"
          @title="Select a chat to view its messages"
        >
          <:icon><Ui::Ph @icon="whatsapp-logo" /></:icon>
        </Nuvo::EmptyState>

      {{/if}}

    </main>

  </div>

</div>
