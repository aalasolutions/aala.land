{{page-title "Audit Log"}}

<div data-test-audit-page class="flex col gap-6">
  <Woven::PageHeader @title="Audit Logs" @subtitle="Track all changes across your account" />

  <Woven::Card>
    <:header>
      <Woven::Toolbar class="flex-wrap">
        <Woven::Field>
          <span class="wu-field__label-spacer" aria-hidden="true"></span>
          <Woven::Dropdown
            @searchable={{true}}
            @align="start"
            @value={{this.filterAction}}
            @onSelect={{this.setFilterAction}}
            @options={{this.model.auditActions}}
            @placeholder="All Actions"
          />
        </Woven::Field>

        <Woven::Field>
          <span class="wu-field__label-spacer" aria-hidden="true"></span>
          <Woven::Dropdown
            @searchable={{true}}
            @align="start"
            @value={{this.filterEntityType}}
            @onSelect={{this.setFilterEntityType}}
            @options={{this.model.entityTypes}}
            @placeholder="All Entities"
          />
        </Woven::Field>

        {{#if (or this.filterAction this.filterEntityType)}}
          <Woven::Button
            @variant="secondary"
            @text="Clear Filters"
            {{on "click" this.clearFilters}}
          />
        {{/if}}

        <Woven::Button
          @variant="danger"
          @icon="trash"
          {{on "click" this.openPurge}}
          data-test-purge-btn
        >
          Purge Old Logs
        </Woven::Button>
      </Woven::Toolbar>
    </:header>

    <:body>
      {{#if this.model.forbidden}}
        <Woven::Alert @variant="danger">
          You don't have permission to view audit logs.
        </Woven::Alert>
      {{else}}
        {{#if (gt this.model.logs.length 0)}}
          <div class="audit-list">
            {{#each this.model.logs as |log|}}
              <div class="audit-item">
                <div
                  class="audit-summary"
                  {{on "click" (fn this.toggleExpand log.id)}}
                >
                  <Woven::Tag
                    class="tag-audit-{{lowercase log.action}}"
                    @text={{log.action}}
                  />
                  <span class="audit-entity">{{log.entityType}}</span>
                  <span class="audit-entity-id">{{log.entityId}}</span>
                  <span class="audit-user">{{log.userEmail}}</span>
                  <span class="audit-date">{{format-date-time
                      log.createdAt
                      withSeconds=true
                      region=log.regionCode
                    }}</span>
                  <Ui::Ph
                    @icon="caret-down"
                    @size="16px"
                    class="chevron
                      {{if (eq this.expandedLogId log.id) 'expanded'}}"
                  />
                </div>
                {{#if (eq this.expandedLogId log.id)}}
                  <div class="audit-details">
                    <Woven::InfoRow @label="IP Address:" @value={{log.ipAddress}} />
                    <Woven::InfoRow @label="User Agent:">
                      <span class="text-muted">{{log.userAgent}}</span>
                    </Woven::InfoRow>
                    {{#if log.oldValue}}
                      <div class="audit-detail-section">
                        <span class="wu-info-row__label">Old Value:</span>
                        <div class="wu-code-block">
                          <pre class="wu-code-block__content">{{this.formatJson
                              log.oldValue
                            }}</pre>
                        </div>
                      </div>
                    {{/if}}
                    {{#if log.newValue}}
                      <div class="audit-detail-section">
                        <span class="wu-info-row__label">New Value:</span>
                        <div class="wu-code-block">
                          <pre class="wu-code-block__content">{{this.formatJson
                              log.newValue
                            }}</pre>
                        </div>
                      </div>
                    {{/if}}
                  </div>
                {{/if}}
              </div>
            {{/each}}
          </div>
        {{else}}
          <Woven::EmptyState @title="No audit logs found" />
        {{/if}}
      {{/if}}
    </:body>
  </Woven::Card>

  <Woven::Modal
    @open={{this.showPurgeModal}}
    @title="Purge Audit Logs"
    @onClose={{this.closePurge}}
    @showClose={{true}}
  >
    <:body>
      <p class="text-muted">Permanently delete audit logs older than the
        specified number of days. Minimum retention is 30 days.</p>

      <Woven::Field @label="Delete logs older than (days)">
        <Woven::Input
          @type="number"
          min="30"
          @value={{this.purgeDays}}
          {{on "input" (fn this.setField "purgeDays")}}
          data-test-purge-days
        />
      </Woven::Field>
    </:body>
    <:footer>
      <Woven::Button
        @variant="secondary"
        @text="Cancel"
        {{on "click" this.closePurge}}
      />
      <Woven::Button
        @variant="danger"
        @text={{if this.isPurging "Purging..." "Purge"}}
        disabled={{this.isPurging}}
        {{on "click" this.confirmPurge}}
        data-test-purge-confirm
      />
    </:footer>
  </Woven::Modal>
</div>
