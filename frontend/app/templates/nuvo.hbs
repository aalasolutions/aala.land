{{page-title "NuvoUI UIKit"}}

{{! The documentation shell dogfoods the kit's own sidebar, topbar and collapse. }}
<div class="nuvo-shell">
  <Nuvo::Sidebar
    @collapsed={{this.sidebarCollapsed}}
    @open={{this.sidebarOpen}}
    @dismissible={{true}}
    @onDismiss={{this.closeSidebar}}
    @brandTitle="NuvoUI"
    @brandSubtitle="Ember kit"
  >
    {{! Named blocks are all-or-nothing: <:footer> forces an explicit <:default>. }}
    <:default>
      {{#each this.navSections as |group|}}
        <div class="nu-sidebar__section-label">{{group.label}}</div>
        {{#each group.items as |entry|}}
          <LinkTo
            @route={{entry.route}}
            class="nu-sidebar__link"
            data-tooltip={{if this.sidebarCollapsed entry.label}}
            data-tooltip-position="end"
            data-test-nuvo-nav={{entry.route}}
            {{on "click" this.closeSidebar}}
          >
            <span class="nu-sidebar__link-icon" aria-hidden="true">{{entry.icon}}</span>
            <span class="nu-sidebar__link-label">{{entry.label}}</span>
          </LinkTo>
        {{/each}}
      {{/each}}
    </:default>

    <:footer>
      <span class="nu-text m-xs m-subtle">{{this.pageCount}} pages</span>
    </:footer>
  </Nuvo::Sidebar>

  <div class="nuvo-shell__main">
    <Nuvo::Topbar
      @sticky={{true}}
      @onToggle={{this.toggleSidebar}}
      @userName="Test User"
      @userRole="Owner"
    >
      <:brand>
        <Nuvo::Button
          @variant="ghost"
          @size="sm"
          @icon={{if this.sidebarCollapsed "»" "«"}}
          @shape="square"
          @onClick={{this.toggleCollapsed}}
          aria-label="Collapse sidebar"
          data-tooltip="Collapse sidebar"
          data-test-nuvo-collapse
        />
        <span class="nu-title m-md">UI Kit</span>
      </:brand>

      <:actions>
        <span class="nu-text m-sm m-muted">Theme</span>
        {{#each this.themes as |theme|}}
          <Nuvo::Button
            @variant={{if (eq this.activeTheme theme) "primary" "secondary"}}
            @size="xs"
            @text={{theme}}
            @onClick={{fn this.setTheme theme}}
            data-test-nuvo-theme={{theme}}
          />
        {{/each}}

        <span class="nu-text m-sm m-muted ms-4">Dir</span>
        {{#each this.dirs as |dir|}}
          <Nuvo::Button
            @variant={{if (eq this.dir dir) "primary" "secondary"}}
            @size="xs"
            @text={{dir}}
            @onClick={{fn this.setDir dir}}
            data-test-nuvo-dir={{dir}}
          />
        {{/each}}

        <Nuvo::Badge @variant="danger" @value={{3}}>
          <Nuvo::Button
            @variant="ghost"
            @shape="square"
            @icon="🔔"
            aria-label="Notifications"
          />
        </Nuvo::Badge>
      </:actions>
    </Nuvo::Topbar>

    <div class="nuvo-page">
      {{outlet}}
    </div>
  </div>
</div>
