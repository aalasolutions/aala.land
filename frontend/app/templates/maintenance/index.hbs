{{page-title "Maintenance"}}

<Woven::ListPage
  @title="Maintenance"
  @subtitle="Track and manage property work orders."
  @isEmpty={{and this.isOrdersSection (not this.filteredWorkOrders.length)}}
  data-test-maintenance-page
>
  <:action>
    <Woven::Button
      @variant="brand"
      @icon="plus"
      data-test-work-order-new
      {{on "click" this.openCreate}}
    >
      New Work Order
    </Woven::Button>
  </:action>

  <:summary>
    {{#if @model.costSummary}}
      <div class="grid cols-1 cols-2@lg cols-4@xl gap-4">
        <StatCard
          @label="Total Estimated"
          @value={{format-money @model.costSummary.totalEstimated}}
        />
        <StatCard
          @label="Total Actual"
          @value={{format-money @model.costSummary.totalActual}}
        />
        <StatCard
          @label="Pending Cost"
          @value={{format-money @model.costSummary.pendingCost}}
        />
        <StatCard
          @label="Work Orders"
          @value={{@model.costSummary.workOrderCount}}
        />
      </div>
    {{/if}}
  </:summary>

  <:switcher>
    <Woven::Tabs
      @tabs={{this.sectionTabs}}
      @activeTab={{this.activeSection}}
      @onChange={{this.setSection}}
      data-test-maintenance-tabs
    />
  </:switcher>

  <:toolbar>
    {{#if this.isOrdersSection}}
      <Woven::Dropdown
        id="maintenance-status-filter"
        @ariaLabel="Status"
        @align="start"
        @value={{this.filterStatus}}
        @onSelect={{this.setStatusFilter}}
        @options={{this.statusOptions}}
        @placeholder="All Statuses"
      />
      <Woven::Dropdown
        id="maintenance-period-filter"
        @ariaLabel="Period"
        @align="start"
        @value={{this.filterMonth}}
        @onSelect={{this.setMonthFilter}}
        @options={{this.monthOptions}}
        @placeholder="All Periods"
      />
    {{/if}}
  </:toolbar>

  <:body as |page|>
    {{#if this.isOrdersSection}}
      <Woven::DataTable
        @columns={{this.columns}}
        @rows={{this.filteredWorkOrders}}
        @pinColumns={{true}}
        @reorderable={{true}}
        @sortable={{true}}
        @showOptions={{true}}
        @optionsTarget={{page.optionsTarget}}
        @tableId="maintenance"
        class="table-stacked"
        data-test-work-orders-table
        as |cell|
      >
        <DataTable::StackedLabel
          @columns={{this.columns}}
          @cellKey={{cell.key}}
          @skip={{array "title" "id"}}
        />
        {{#if (eq cell.key "title")}}
          <p class="text-sm" data-test-work-order><LinkTo
              @route="maintenance.detail"
              @model={{cell.row.id}}
              class="text-brand"
              data-test-work-order-detail-link
            >{{cell.value}}</LinkTo></p>
          {{#if cell.row.vendorId}}<p class="text-muted text-xs"><Ui::Ph
                @icon="toolbox"
              />
              Vendor assigned</p>{{/if}}
        {{else if (eq cell.key "assetName")}}
          {{#if cell.row.unitNumber}}
            <Woven::Cell::Text
              @value={{concat
                cell.row.areaName
                " / "
                cell.row.assetName
                " / "
                cell.row.unitNumber
              }}
            />
          {{else}}
            <Woven::Cell::Empty />
          {{/if}}
        {{else if (eq cell.key "id")}}
          <div class="table-stacked__actions">
            <RowActions
              @label={{cell.row.title}}
              @actions={{array
                (hash
                  key="edit-work-order"
                  label="Edit"
                  icon="pencil-simple"
                  onSelect=(fn this.openEdit cell.row)
                )
                (hash
                  key="delete-work-order"
                  label="Delete"
                  icon="trash"
                  variant="danger"
                  onSelect=(fn this.openDelete cell.row)
                  hidden=(not (this.canDeleteWorkOrder cell.row))
                )
              }}
            />
          </div>
        {{/if}}
      </Woven::DataTable>
    {{else}}
      <Woven::Card>
        <h4 class="text-lg font-bold mb-3"><Ui::Ph @icon="clock-countdown" />
          Preventive Maintenance (Next 30 Days)</h4>
        {{#if @model.upcoming.length}}
          <div class="flex col gap-3">
            {{#each @model.upcoming as |wo|}}
              <div
                class="flex between x-center p-4 rounded bg-white@02 border border-white@05"
              >
                <div class="flex col gap-1">
                  <p class="text-sm font-bold">{{wo.title}}</p>
                  <p class="text-muted text-xs">{{tag-label
                      "trade"
                      wo.category
                    }}
                    - Scheduled:
                    {{format-date wo.scheduledDate}}</p>
                </div>
                <div class="flex x-center gap-3">
                  <Woven::Tag
                    @variant={{tag-variant "priority" wo.priority}}
                    @text={{tag-label "priority" wo.priority}}
                  />
                  <Woven::Button
                    data-test-work-order-edit
                    @variant="subtle"
                    @size="xs"
                    @icon="pencil-simple"
                    {{on "click" (fn this.openEdit wo)}}
                  >
                    Edit
                  </Woven::Button>
                </div>
              </div>
            {{/each}}
          </div>
        {{else}}
          <Woven::EmptyState
            @description="No preventive maintenance scheduled for the next 30 days."
          />
        {{/if}}
      </Woven::Card>
    {{/if}}
  </:body>

  <:empty>
    {{#if @model.total}}
      <Woven::EmptyState
        @description="No work orders on this page with current filters. Navigate to find orders or adjust filters."
      />
    {{else}}
      <Woven::EmptyState
        @title="No work orders"
        @description="No work orders match your filters."
      />
    {{/if}}
  </:empty>

  <:footer as |page|>
    {{#if (and this.isOrdersSection @model.total)}}
      <page.Pager
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{@model.total}}
        @onLimitChange={{this.setLimit}}
        @onPrevious={{this.goToPreviousPage}}
        @onNext={{this.goToNextPage}}
        @onPageChange={{this.goToPage}}
      />
    {{/if}}
  </:footer>
</Woven::ListPage>

<Maintenance::WorkOrderDrawer
  @open={{this.showModal}}
  @workOrder={{this.editWorkOrder}}
  @onClose={{this.closeModal}}
  @onClosed={{this.resetDrawer}}
  @onSaved={{this.refresh}}
/>

<ConfirmModal
  @open={{this.showDeleteModal}}
  @title="Delete Work Order"
  @message="Delete this work order? This cannot be undone."
  @confirmText="Delete"
  @confirmVariant="danger"
  @isConfirming={{this.isDeleting}}
  @confirmingText="Deleting..."
  @onClose={{this.closeDeleteModal}}
  @onConfirm={{this.confirmDelete}}
>
  <Woven::Field class="mt-4" @label="Reason" @required={{true}} @error={{this.reasonError}}>
    <Woven::Textarea
      id="wo-delete-reason"
      rows="2"
      maxlength="500"
      placeholder="e.g. Created by mistake"
      @value={{this.deleteReason}}
      @onInput={{fn this.setFieldValue "deleteReason"}}
      @invalid={{if this.reasonError true false}}
      aria-label="Reason"
      data-test-reason-input
    />
  </Woven::Field>
</ConfirmModal>
