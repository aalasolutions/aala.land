{{page-title "Maintenance"}}

<div data-test-maintenance-page class="flex col gap-6">
  <Nuvo::PageHeader @title="Maintenance" @subtitle="Track and manage property work orders.">
    <:actions>
      <Nuvo::Button @variant="primary" {{on "click" this.openCreate}} @icon="plus">
        New Work Order
      </Nuvo::Button>
    </:actions>
  </Nuvo::PageHeader>

  {{#if @model.costSummary}}
    <div class="grid cols-4 gap-4">
      <Nuvo::Stat
        @variant="primary"
        @label="Total Estimated"
        @value={{format-money @model.costSummary.totalEstimated}}
      />
      <Nuvo::Stat
        @variant="primary"
        @label="Total Actual"
        @value={{format-money @model.costSummary.totalActual}}
      />
      <Nuvo::Stat
        @variant="warning"
        @label="Pending Cost"
        @value={{format-money @model.costSummary.pendingCost}}
      />
      <Nuvo::Stat
        @variant="secondary"
        @label="Work Orders"
        @value={{@model.costSummary.workOrderCount}}
      />
    </div>
  {{/if}}

  <Nuvo::Segmented
    @options={{this.sectionTabs}}
    @value={{this.activeSection}}
    @onChange={{this.setSection}}
  />

  {{#if (eq this.activeSection "orders")}}
    <div class="flex gap-4 x-center">
      <Nuvo::Field @label="Status">
        <Nuvo::Dropdown
          id="maintenance-status-filter"
          @align="start"
          @value={{this.filterStatus}}
          @onSelect={{this.setStatusFilter}}
          @options={{this.statusOptions}}
          @placeholder="All"
        />
      </Nuvo::Field>
      <Nuvo::Field @label="Period">
        <Nuvo::Dropdown
          id="maintenance-period-filter"
          @align="start"
          @value={{this.filterMonth}}
          @onSelect={{this.setMonthFilter}}
          @options={{this.monthOptions}}
          @placeholder="All"
        />
      </Nuvo::Field>
    </div>

    <Nuvo::Card>
      {{#if this.filteredWorkOrders.length}}
        <Nuvo::DataTable
          @columns={{this.columns}}
          @rows={{this.filteredWorkOrders}}
          @pinColumns={{true}}
          @reorderable={{true}}
          @sortable={{true}}
          @showOptions={{true}}
          @tableId="maintenance"
          data-test-work-orders-table
          as |cell|
        >
          {{#if (eq cell.key "title")}}
            <p class="text-sm" data-test-work-order><LinkTo
                @route="maintenance.detail"
                @model={{cell.row.id}}
                class="text-brand"
                data-test-work-order-detail-link
              >{{cell.value}}</LinkTo></p>
            {{#if cell.row.vendorId}}<p class="text-muted text-xs"><Ui::Ph
                  @icon="toolbox"
                />
                Vendor assigned</p>{{/if}}
          {{else if (eq cell.key "assetName")}}
            <span class="text-sm text-muted">
              {{#if cell.row.unitNumber}}
                {{cell.row.areaName}}
                /
                {{cell.row.assetName}}
                /
                {{cell.row.unitNumber}}
              {{else}}
                <span class="text-muted">-</span>
              {{/if}}
            </span>
          {{else if (eq cell.key "category")}}
            <Nuvo::Tag
              class="tag-trade-{{lowercase cell.value}}"
              @text={{cell.value}}
            />
          {{else if (eq cell.key "priority")}}
            <Nuvo::Tag
              class="tag-priority-{{lowercase cell.value}}"
              @text={{cell.value}}
            />
          {{else if (eq cell.key "estimatedCost")}}
            {{#if cell.value}}<Money
                @amount={{cell.value}}
                @currency={{cell.row.currency}}
              />{{else}}-{{/if}}
          {{else if (eq cell.key "actualCost")}}
            {{#if cell.value}}<Money
                @amount={{cell.value}}
                @currency={{cell.row.currency}}
              />{{else}}-{{/if}}
          {{else if (eq cell.key "scheduledDate")}}
            <span class="text-xs">{{#if cell.value}}{{format-date
                  cell.value
                }}{{else}}-{{/if}}</span>
          {{else if (eq cell.key "status")}}
            <Nuvo::Tag
              class="tag-wo-{{lowercase cell.value}}"
              @text={{cell.value}}
            />
          {{else if (eq cell.key "id")}}
            <div class="flex">
              <Nuvo::Button
                @subtle={{true}}
                @variant="secondary"
                @size="xs"
                @icon="pencil-simple"
                aria-label="Edit {{cell.row.title}}"
                data-tooltip="Edit"
                data-test-edit-work-order
                {{on "click" (fn this.openEdit cell.row)}}
              />
              {{#if (this.canDeleteWorkOrder cell.row)}}
                <Nuvo::Button
                  @subtle={{true}}
                  @variant="danger"
                  @size="xs"
                  @icon="trash"
                  aria-label="Delete {{cell.row.title}}"
                  data-tooltip="Delete"
                  data-test-delete-work-order
                  {{on "click" (fn this.openDelete cell.row)}}
                />
              {{/if}}
            </div>
          {{else}}
            <span class="text-muted">{{cell.value}}</span>
          {{/if}}
        </Nuvo::DataTable>
      {{else}}
        {{#if @model.total}}
          <Nuvo::EmptyState
            @description="No work orders on this page with current filters. Navigate to find orders or adjust filters."
          />
        {{else}}
          <Nuvo::EmptyState
            @title="No work orders"
            @description="No work orders match your filters."
          />
        {{/if}}
      {{/if}}

      {{#if @model.total}}
        <Nuvo::Pagination
          @selectId="maintenance-limit"
          @page={{this.page}}
          @limit={{this.limit}}
          @total={{@model.total}}
          @onLimitChange={{this.setLimit}}
          @onPrevious={{this.goToPreviousPage}}
          @onNext={{this.goToNextPage}}
          @onPageChange={{this.goToPage}}
        />
      {{/if}}
    </Nuvo::Card>
  {{/if}}

  {{#if (eq this.activeSection "upcoming")}}
    <Nuvo::Card>
      <h4 class="text-lg font-bold mb-3"><Ui::Ph @icon="clock-countdown" />
        Preventive Maintenance (Next 30 Days)</h4>
      {{#if @model.upcoming.length}}
        <div class="flex col gap-3">
          {{#each @model.upcoming as |wo|}}
            <div
              class="flex between x-center p-4 rounded bg-white@02 border border-white@05"
            >
              <div class="flex col gap-1">
                <p class="text-sm font-bold">{{wo.title}}</p>
                <p class="text-muted text-xs">{{wo.category}}
                  - Scheduled:
                  {{format-date wo.scheduledDate}}</p>
              </div>
              <div class="flex x-center gap-3">
                <Nuvo::Tag
                  class="tag-priority-{{lowercase wo.priority}}"
                  @text={{wo.priority}}
                />
                <Nuvo::Button
                  @variant="secondary"
                  @size="xs"
                  @icon="pencil-simple"
                  {{on "click" (fn this.openEdit wo)}}
                >
                  Edit
                </Nuvo::Button>
              </div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <Nuvo::EmptyState
          @description="No preventive maintenance scheduled for the next 30 days."
        />
      {{/if}}
    </Nuvo::Card>
  {{/if}}
</div>

<Maintenance::WorkOrderDrawer
  @open={{this.showModal}}
  @workOrder={{this.editWorkOrder}}
  @onClose={{this.closeModal}}
  @onClosed={{this.resetDrawer}}
  @onSaved={{this.refresh}}
/>

<ConfirmModal
  @open={{this.showDeleteModal}}
  @title="Delete Work Order"
  @message="Delete this work order? This cannot be undone."
  @confirmText="Delete"
  @confirmVariant="danger"
  @isConfirming={{this.isDeleting}}
  @confirmingText="Deleting..."
  @onClose={{this.closeDeleteModal}}
  @onConfirm={{this.confirmDelete}}
>
  <Nuvo::Field class="mt-4" @label="Reason" @required={{true}} @error={{this.reasonError}}>
    <Nuvo::Textarea
      id="wo-delete-reason"
      rows="2"
      maxlength="500"
      placeholder="e.g. Created by mistake"
      @value={{this.deleteReason}}
      @onInput={{fn this.setFieldValue "deleteReason"}}
      @invalid={{if this.reasonError true false}}
      aria-label="Reason"
      data-test-reason-input
    />
  </Nuvo::Field>
</ConfirmModal>
