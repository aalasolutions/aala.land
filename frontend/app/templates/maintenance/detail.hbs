{{page-title this.title}}

<div data-test-work-order-detail class="flex col gap-6">
  <Nuvo::PageHeader @title={{this.title}} @subtitle={{this.subtitle}}>
    <:breadcrumb>
      <LinkTo
        @route="maintenance.index"
        class="text-muted text-sm"
        data-test-breadcrumb-maintenance
      >Maintenance</LinkTo>
      <span class="text-muted">/</span>
    </:breadcrumb>
    <:meta>
      {{#if @model.workOrder}}
        <div class="flex gap-1 wrap">
          <Nuvo::Tag
            class="tag-wo-{{lowercase @model.workOrder.status}}"
            @text={{@model.workOrder.status}}
            data-test-work-order-status
          />
          <Nuvo::Tag
            class="tag-priority-{{lowercase @model.workOrder.priority}}"
            @text={{@model.workOrder.priority}}
            data-test-work-order-priority
          />
          <Nuvo::Tag
            class="tag-trade-{{lowercase @model.workOrder.category}}"
            @text={{@model.workOrder.category}}
            data-test-work-order-category
          />
        </div>
      {{/if}}
    </:meta>
    <:actions>
      {{#if (and @model.workOrder this.canEdit)}}
        <Nuvo::Button
          @variant="secondary"
          @icon="pencil-simple"
          @text="Edit"
          data-test-edit-work-order
          {{on "click" this.openEdit}}
        />
      {{/if}}
    </:actions>
  </Nuvo::PageHeader>

  {{#if @model.workOrder}}
    <RegionNotice
      @regionCode={{@model.workOrder.regionCode}}
      @noun="work order"
    />
    <Maintenance::Summary
      @workOrder={{@model.workOrder}}
      @unit={{@model.unit}}
      @vendor={{@model.vendor}}
      @assignee={{@model.assignee}}
    />

    <section data-test-work-order-documents>
      <Documents::Panel
        @filters={{this.documentFilters}}
        @presetLink={{this.presetLink}}
        @compact={{true}}
        @tableId="work-order-documents"
      >
        <:header as |panel|>
          <div class="flex between x-center">
            <h2 class="text-md font-bold">Documents</h2>
            {{#if panel.canUpload}}
              <Nuvo::Button
                @variant="primary"
                @size="sm"
                @icon="upload-simple"
                @text="Upload"
                data-test-work-order-documents-upload
                {{on "click" panel.openUpload}}
              />
            {{/if}}
          </div>
        </:header>
      </Documents::Panel>
    </section>

    {{#if this.canViewHistory}}
      <Nuvo::Card @title="History" data-test-work-order-history-card>
        <RecordHistoryList
          @entityType="WorkOrder"
          @entityId={{@model.workOrder.id}}
          @reloadKey={{@model.workOrder}}
        />
      </Nuvo::Card>
    {{/if}}

    {{#if this.canEdit}}
      <Maintenance::WorkOrderDrawer
        @open={{this.showEdit}}
        @workOrder={{@model.workOrder}}
        @onClose={{this.closeEdit}}
        @onSaved={{this.refresh}}
      />
    {{/if}}
  {{else}}
    <Nuvo::Card>
      <Nuvo::EmptyState
        @description="Work order not found."
        data-test-work-order-not-found
      />
    </Nuvo::Card>
  {{/if}}
</div>