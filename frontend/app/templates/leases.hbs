{{page-title "Leases"}}

<div data-test-leases-page class="flex col gap-6">
  <Nuvo::PageHeader @icon="file-text" @title="Lease Agreements" @subtitle="Manage tenant lease contracts and renewals.">
    <:meta>
      <p class="text-muted">{{format-number @model.total unit="lease"}}</p>
    </:meta>
    <:actions>
      <Nuvo::Button
        @variant="primary"
        @icon="plus"
        {{on "click" this.openCreate}}
      >
        New Lease
      </Nuvo::Button>
    </:actions>
  </Nuvo::PageHeader>

  <Nuvo::Segmented
    @options={{this.statusTabs}}
    @value={{this.status}}
    @onChange={{this.setStatusTab}}
    data-test-lease-status-tabs
  />

  <Nuvo::Accordion
    @items={{array
      (hash
        id="filters"
        title=(if this.hasActiveFilters "Filters · active" "Filters")
      )
    }}
    data-test-filters-accordion
  >
    <div class="flex col gap-4">
      <div class="flex gap-3 wrap">
        <Nuvo::Input
          type="text"
          autocomplete="off"
          placeholder="Search tenant, unit number, registration ref..."
          class="grow"
          value={{this.search}}
          {{on "input" (fn this.updateFilter "search")}}
          data-test-leases-search
        />
      </div>

      <div class="flex gap-3 wrap x-end">
        <Nuvo::Field class="grow" @label="Type">
          <Nuvo::Dropdown
            id="leases-type-filter"
            @align="start"
            @value={{this.type}}
            @onSelect={{this.setType}}
            @options={{this.typeFilterOptions}}
            data-test-type-filter
          />
        </Nuvo::Field>
        <Nuvo::Field @label="Visibility">
          <Nuvo::Dropdown
            @align="start"
            @value={{this.archived}}
            @onSelect={{this.setArchivedTab}}
            @options={{this.archivedTabs}}
            data-test-archived-filter
          />
        </Nuvo::Field>
        <Nuvo::Field @label="Start date from">
          <input
            type="date"
            class="nu-input"
            aria-label="Start date from"
            value={{this.dateFrom}}
            {{on "change" this.setDateFrom}}
            data-test-date-from-filter
          />
        </Nuvo::Field>
        <Nuvo::Field @label="Start date to">
          <input
            type="date"
            class="nu-input"
            aria-label="Start date to"
            value={{this.dateTo}}
            {{on "change" this.setDateTo}}
            data-test-date-to-filter
          />
        </Nuvo::Field>
      </div>

      {{#if this.hasActiveFilters}}
        <div class="flex end">
          <Nuvo::Button
            @variant="danger"
            @size="sm"
            @icon="x"
            {{on "click" this.clearFilters}}
            data-test-clear-filters
          >
            Clear filters
          </Nuvo::Button>
        </div>
      {{/if}}
    </div>
  </Nuvo::Accordion>

  <Nuvo::Card>
    {{#if @model.leases.length}}
      <Nuvo::DataTable
        @columns={{this.columns}}
        @rows={{@model.leases}}
        @pinColumns={{true}}
        @reorderable={{true}}
        @sortable={{true}}
        @showOptions={{true}}
        @tableId="leases"
        as |cell|
      >
        {{#if (eq cell.key "contact.displayName")}}
          <span class="font-bold" data-test-lease-row>{{or
              (contact-name cell.row.contact)
              "Unknown tenant"
            }}</span>
        {{else if (eq cell.key "unit.unitNumber")}}
          {{#if cell.row.unit}}
            <Nuvo::Button
              @variant="secondary"
              @size="xs"
              @route="properties.unit"
              @models={{array cell.row.unit.areaId cell.row.unit.id}}
              @text={{cell.row.unit.unitNumber}}
              data-test-view-lease-unit
            />
          {{/if}}
        {{else if (eq cell.key "monthlyRent")}}
          <span class="text-muted">{{format-currency cell.value}}/mo</span>
        {{else if (eq cell.key "startDate")}}
          <span class="text-muted">{{format-date cell.value}} - {{format-date cell.row.endDate}}</span>
        {{else if (eq cell.key "status")}}
          <div class="flex gap-1 wrap">
            <Nuvo::Tag
              class="tag-lease-{{lowercase cell.value}}"
              @text={{cell.value}}
            />
            {{#if cell.row.deletedAt}}
              <Nuvo::Tag
                @variant="secondary"
                @text="Archived"
                data-test-lease-archived-badge
              />
            {{/if}}
          </div>
        {{else if (eq cell.key "tenancyRegistrationRef")}}
          <span class="text-muted">{{or cell.value "-"}}</span>
        {{else if (eq cell.key "id")}}
          <div class="flex">
            {{#if this.canViewHistory}}
              <Nuvo::Button
                @subtle={{true}}
                @variant="secondary"
                @size="xs"
                @icon="clock-counter-clockwise"
                aria-label="History for lease of {{or
                  (contact-name cell.row.contact)
                  'Unknown tenant'
                }}"
                data-tooltip="History"
                data-test-lease-history
                {{on "click" (fn this.openHistory cell.row)}}
              />
            {{/if}}
            {{#if cell.row.deletedAt}}
              {{#if this.canArchiveLease}}
                <Nuvo::Button
                  data-test-unarchive-lease
                  @subtle={{true}}
                  @variant="secondary"
                  @size="xs"
                  @icon="arrow-counter-clockwise"
                  aria-label="Unarchive lease for {{contact-name
                    cell.row.contact
                  }}"
                  data-tooltip="Unarchive"
                  {{on "click" (fn this.openArchive cell.row "unarchive")}}
                />
              {{/if}}
            {{else}}
              <Nuvo::Button
                @subtle={{true}}
                @variant="secondary"
                @size="xs"
                @icon="pencil-simple"
                aria-label="Edit lease for {{contact-name cell.row.contact}}"
                data-tooltip="Edit"
                data-test-edit-lease
                {{on "click" (fn this.openEdit cell.row)}}
              />
              {{#if (eq cell.row.status "ACTIVE")}}
                <Nuvo::Button
                  data-test-renew-lease
                  @subtle={{true}}
                  @variant="secondary"
                  @size="xs"
                  @icon="arrows-clockwise"
                  aria-label="Renew lease for {{contact-name cell.row.contact}}"
                  data-tooltip="Renew"
                  {{on "click" (fn this.renewLease cell.row)}}
                />
                <Nuvo::Button
                  data-test-terminate-lease
                  @subtle={{true}}
                  @variant="danger"
                  @size="xs"
                  @icon="x-circle"
                  aria-label="Terminate lease for {{contact-name
                    cell.row.contact
                  }}"
                  data-tooltip="Terminate"
                  {{on "click" (fn this.openTerminate cell.row)}}
                />
              {{/if}}
              {{#if (eq cell.row.status "EXPIRED")}}
                <Nuvo::Button
                  data-test-renew-lease
                  @subtle={{true}}
                  @variant="secondary"
                  @size="xs"
                  @icon="arrows-clockwise"
                  aria-label="Renew lease for {{contact-name cell.row.contact}}"
                  data-tooltip="Renew"
                  {{on "click" (fn this.renewLease cell.row)}}
                />
              {{/if}}
              {{#if (eq cell.row.status "DRAFT")}}
                {{#if this.canDeleteLease}}
                  <Nuvo::Button
                    @subtle={{true}}
                    @variant="danger"
                    @size="xs"
                    @icon="trash"
                    aria-label="Delete lease for {{contact-name
                      cell.row.contact
                    }}"
                    data-tooltip="Delete"
                    data-test-delete-lease
                    {{on "click" (fn this.openDelete cell.row)}}
                  />
                {{/if}}
              {{else if this.canArchiveLease}}
                {{#unless (eq cell.row.status "ACTIVE")}}
                  <Nuvo::Button
                    data-test-archive-lease
                    @subtle={{true}}
                    @variant="secondary"
                    @size="xs"
                    @icon="archive"
                    aria-label="Archive lease for {{contact-name
                      cell.row.contact
                    }}"
                    data-tooltip="Archive"
                    {{on "click" (fn this.openArchive cell.row "archive")}}
                  />
                {{/unless}}
              {{/if}}
            {{/if}}
          </div>
        {{else}}
          <span class="text-muted">{{cell.value}}</span>
        {{/if}}
      </Nuvo::DataTable>
    {{else}}
      {{#if @model.total}}
        <Nuvo::EmptyState
          @description="No leases on page {{this.page}}. Navigate back or adjust your filters."
        />
      {{else}}
        <Nuvo::EmptyState
          @description="No leases yet. Create your first lease agreement."
        />
      {{/if}}
    {{/if}}

    {{#if @model.total}}
      <Nuvo::Pagination
        @selectId="leases-limit"
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{@model.total}}
        @onLimitChange={{this.setLimit}}
        @onPrevious={{this.goToPreviousPage}}
        @onNext={{this.goToNextPage}}
        @onPageChange={{this.goToPage}}
      />
    {{/if}}
  </Nuvo::Card>
</div>

<Nuvo::Drawer
  @open={{this.showModal}}
  @title={{if
    this.editLease
    "Edit Lease"
    (if this.renewingLeaseId "Renew Lease" "New Lease")
  }}
  @placement="end"
  @size="lg"
  @onClose={{this.closeModal}}
  @onClosed={{this.resetDrawer}}
>
  <:body>
    <form
      id="lease-form"
      class="flex col gap-4"
      {{on "submit" this.saveLease}}
    >
      {{#if this.editLeaseUnitArchivedMessage}}
        <Nuvo::Alert
          @variant="warning"
          @description={{this.editLeaseUnitArchivedMessage}}
          data-test-lease-unit-archived
        />
      {{/if}}
      <Nuvo::Field @label="Property" @required={{true}}>
        <Nuvo::Dropdown
          id="lease-unit-id"
          @align="start"
          @value={{this.formUnitId}}
          @onSelect={{fn this.setFieldValue "formUnitId"}}
          @options={{this.unitOptions}}
          @placeholder="Select a property..."
        />
      </Nuvo::Field>

      {{#if this.editLease}}
        <Nuvo::Field @label="Status">
          <Nuvo::Dropdown
            id="lease-status"
            @align="start"
            @value={{this.formStatus}}
            @onSelect={{fn this.setFieldValue "formStatus"}}
            @options={{this.validNextStatuses}}
          />
        </Nuvo::Field>
      {{/if}}

      <Nuvo::Field @label="Tenant" @required={{true}}>
        <Nuvo::Dropdown
          id="lease-tenant"
          @align="start"
          @value={{this.formTenantContactId}}
          @onSelect={{fn this.setFieldValue "formTenantContactId"}}
          @options={{this.tenantOptions}}
          @placeholder="Select a tenant..."
          data-test-lease-tenant
        />
      </Nuvo::Field>

      <div class="flex gap-4">
        <Nuvo::Field class="grow" @label="Property Type">
          <Nuvo::Dropdown
            id="lease-type"
            @align="start"
            @value={{this.formType}}
            @onSelect={{fn this.setFieldValue "formType"}}
            @options={{this.leaseTypeOptions}}
            @placeholder="Select property type..."
          />
        </Nuvo::Field>
        <Nuvo::Field
          class="grow"
          @label="Number of Cheques"
          @tooltip="How many post-dated rent cheques the tenant gives, such as 4 for quarterly or 12 for monthly. Add each cheque under Cheques."
        >
          <Nuvo::Input
            id="lease-cheques"
            type="number"
            @value={{this.formNumberOfCheques}}
            @onInput={{fn this.setFieldValue "formNumberOfCheques"}}
            min="1"
            max="12"
          />
        </Nuvo::Field>
      </div>

      <div class="flex gap-4">
        <Nuvo::Field class="grow" @label="Start Date" @required={{true}}>
          <input
            id="lease-start"
            type="date"
            class="nu-input"
            value={{this.formStartDate}}
            required
            {{on "input" (fn this.setFieldValueFromEvent "formStartDate")}}
          />
        </Nuvo::Field>
        <Nuvo::Field class="grow" @label="End Date" @required={{true}}>
          <input
            id="lease-end"
            type="date"
            class="nu-input"
            value={{this.formEndDate}}
            required
            {{on "input" (fn this.setFieldValueFromEvent "formEndDate")}}
          />
        </Nuvo::Field>
      </div>

      <div class="flex gap-4">
        <Nuvo::Field class="grow" @label="Monthly Rent" @required={{true}}>
          <Nuvo::Input
            id="lease-rent"
            type="number"
            placeholder="e.g. 8500"
            @value={{this.formMonthlyRent}}
            @onInput={{fn this.setFieldValue "formMonthlyRent"}}
            required={{true}}
            min="0"
            step="0.01"
          />
        </Nuvo::Field>
        <Nuvo::Field class="grow" @label="Security Deposit">
          <Nuvo::Input
            id="lease-deposit"
            type="number"
            placeholder="e.g. 17000"
            @value={{this.formSecurityDeposit}}
            @onInput={{fn this.setFieldValue "formSecurityDeposit"}}
            min="0"
            step="0.01"
          />
        </Nuvo::Field>
      </div>

      <Nuvo::Field
        @label="Tenancy Registration Ref"
        @tooltip="e.g. Ejari in Dubai, Tawtheeq in Abu Dhabi, or your local government lease registry number."
      >
        <Nuvo::Input
          id="lease-tenancy-registration-ref"
          type="text"
          placeholder="e.g. TR-2026-00001"
          @value={{this.formTenancyRegistrationRef}}
          @onInput={{fn this.setFieldValue "formTenancyRegistrationRef"}}
        />
      </Nuvo::Field>

      <Nuvo::Field @label="Notes">
        <Nuvo::Textarea
          id="lease-notes"
          placeholder="Additional notes..."
          rows="3"
          @value={{this.formNotes}}
          @onInput={{fn this.setFieldValue "formNotes"}}
          data-test-input-notes
        />
      </Nuvo::Field>

      {{#if this.errorMsg}}
        <p class="text-sm text-danger">{{this.errorMsg}}</p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Nuvo::Button
      @variant="secondary"
      @onClick={{this.closeModal}}
    >Cancel</Nuvo::Button>
    <Nuvo::Button
      @variant="primary"
      @type="submit"
      form="lease-form"
      @loading={{this.isSaving}}
    >{{if
        this.isSaving
        "Saving..."
        (if
          this.editLease
          "Update"
          (if this.renewingLeaseId "Renew Lease" "Create Lease")
        )
      }}</Nuvo::Button>
  </:footer>
</Nuvo::Drawer>

<ConfirmModal
  @open={{this.showTerminateModal}}
  @title="Terminate lease"
  @message="Terminate the lease for {{or
    (contact-name this.leaseToTerminate.contact)
    'this tenant'
  }}? It ends now and cannot be reactivated."
  @confirmText="Terminate"
  @cancelText="I changed my mind"
  @confirmVariant="danger"
  @isConfirming={{this.isTerminating}}
  @confirmingText="Terminating..."
  @onClose={{this.closeTerminateModal}}
  @onConfirm={{this.confirmTerminate}}
>
  <Nuvo::Field class="mt-4" @label="Reason" @required={{true}} @error={{this.reasonError}}>
    <Nuvo::Textarea
      id="lease-terminate-reason"
      rows="2"
      maxlength="500"
      placeholder="e.g. Tenant moved out early"
      @value={{this.terminateReason}}
      @onInput={{fn this.setFieldValue "terminateReason"}}
      @invalid={{if this.reasonError true false}}
      aria-label="Reason"
      data-test-reason-input
    />
  </Nuvo::Field>
</ConfirmModal>

<ConfirmModal
  @open={{this.showDeleteModal}}
  @title="Delete Lease"
  @message="Delete the lease for {{or
    (contact-name this.leaseToDelete.contact)
    'this tenant'
  }}? This cannot be undone."
  @confirmText="Delete"
  @cancelText="I changed my mind"
  @confirmVariant="danger"
  @isConfirming={{this.isDeleting}}
  @confirmingText="Deleting..."
  @onClose={{this.closeDeleteModal}}
  @onConfirm={{this.confirmDelete}}
>
  <Nuvo::Field class="mt-4" @label="Reason" @required={{true}} @error={{this.reasonError}}>
    <Nuvo::Textarea
      id="lease-delete-reason"
      rows="2"
      maxlength="500"
      placeholder="e.g. Created by mistake"
      @value={{this.deleteReason}}
      @onInput={{fn this.setFieldValue "deleteReason"}}
      @invalid={{if this.reasonError true false}}
      aria-label="Reason"
      data-test-reason-input
    />
  </Nuvo::Field>
</ConfirmModal>

<ConfirmModal
  @open={{this.showArchiveModal}}
  @title={{if (eq this.archiveMode "archive") "Archive Lease" "Unarchive Lease"}}
  @message={{concat
    (if
      (eq this.archiveMode "archive")
      "Archive the lease for "
      "Unarchive the lease for "
    )
    (or (contact-name this.leaseToArchive.contact) "this tenant")
    (if
      (eq this.archiveMode "archive")
      "? It becomes read-only and hidden from lists. You can unarchive it later."
      "? It becomes active and editable again."
    )
  }}
  @confirmText={{if (eq this.archiveMode "archive") "Archive" "Unarchive"}}
  @cancelText="I changed my mind"
  @confirmVariant="primary"
  @isConfirming={{this.isArchiving}}
  @confirmingText={{if (eq this.archiveMode "archive") "Archiving..." "Unarchiving..."}}
  @onClose={{this.closeArchiveModal}}
  @onConfirm={{this.confirmArchive}}
>
  <Nuvo::Field
    class="mt-4"
    @label={{if (eq this.archiveMode "archive") "Reason" "Reason (optional)"}}
    @required={{eq this.archiveMode "archive"}}
    @error={{this.reasonError}}
  >
    <Nuvo::Textarea
      id="lease-archive-reason"
      rows="2"
      maxlength="500"
      placeholder="e.g. Contract closed"
      @value={{this.archiveReason}}
      @onInput={{fn this.setFieldValue "archiveReason"}}
      @invalid={{if this.reasonError true false}}
      aria-label="Reason"
      data-test-reason-input
    />
  </Nuvo::Field>
</ConfirmModal>

<Nuvo::Drawer
  @open={{if this.historyLease true false}}
  @title="Lease History"
  @placement="end"
  @size="lg"
  @onClose={{this.closeHistory}}
>
  <:body>
    {{#if this.historyLease}}
      <RecordHistoryList @entityType="Lease" @entityId={{this.historyLease.id}} />
    {{/if}}
  </:body>
</Nuvo::Drawer>
