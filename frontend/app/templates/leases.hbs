{{page-title "Leases"}}

<div data-test-leases-page class="flex col gap-6">
  <Nuvo::PageHeader @title="Lease Agreements">
    <:meta>
      <p class="text-muted">Manage tenant lease contracts and renewals.</p>
    </:meta>
    <:actions>
      <Nuvo::Button
        @variant="primary"
        @icon="+"
        {{on "click" this.openCreate}}
      >
        New Lease
      </Nuvo::Button>
    </:actions>
  </Nuvo::PageHeader>

  <Nuvo::Card>
    {{#if @model.leases.length}}
      <div class="flex col gap-3">
        {{#each @model.leases as |lease|}}
          <div data-test-lease-row class="flex between x-center p-4 rounded-xl bg-alternate">
            <div class="flex col gap-1">
              <p class="text-sm font-bold">{{lease.tenantName}}</p>
              <p class="text-muted text-xs">{{lease.type}}
                -
                {{format-currency lease.monthlyRent}}/mo</p>
              <p class="text-muted text-xs">{{format-date lease.startDate}}
                to
                {{format-date lease.endDate}}</p>
            </div>
            <div class="flex x-center gap-3">
              <Nuvo::Tag
                class="badge-lease-{{lowercase lease.status}}"
                @text={{lease.status}}
              />
              <Nuvo::Button
                @variant="secondary"
                @size="sm"
                {{on "click" (fn this.openEdit lease)}}
              >
                <Ui::Ph @icon="pencil-simple" />
                Edit
              </Nuvo::Button>
              {{#if (eq lease.status "ACTIVE")}}
                <Nuvo::Button
                  data-test-renew-lease
                  @variant="secondary"
                  @size="sm"
                  {{on "click" (fn this.renewLease lease)}}
                >
                  <Ui::Ph @icon="arrows-clockwise" />
                  Renew
                </Nuvo::Button>
                <Nuvo::Button
                  data-test-terminate-lease
                  @variant="danger"
                  @size="sm"
                  {{on "click" (fn this.openTerminate lease)}}
                >
                  <Ui::Ph @icon="x-circle" />
                  Terminate
                </Nuvo::Button>
              {{/if}}
              {{#if (eq lease.status "EXPIRED")}}
                <Nuvo::Button
                  data-test-renew-lease
                  @variant="secondary"
                  @size="sm"
                  {{on "click" (fn this.renewLease lease)}}
                >
                  <Ui::Ph @icon="arrows-clockwise" />
                  Renew
                </Nuvo::Button>
              {{/if}}
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <p class="text-muted text-center py-8">No leases yet. Create your first
        lease agreement.</p>
    {{/if}}
  </Nuvo::Card>
</div>

<Nuvo::Modal
  @open={{this.showModal}}
  @title={{if
    this.editLease
    "Edit Lease"
    (if this.renewingLeaseId "Renew Lease" "New Lease")
  }}
  @onClose={{this.closeModal}}
>
  <form class="flex col gap-4" {{on "submit" this.saveLease}}>
    <Nuvo::Field @label="Property" @required={{true}}>
      <Nuvo::Select
        id="lease-unit-id"
        @value={{this.formUnitId}}
        @onChange={{fn this.setFieldValue "formUnitId"}}
        @options={{this.unitOptions}}
        @placeholder="Select a property..."
      />
    </Nuvo::Field>

    {{#if this.editLease}}
      <Nuvo::Field @label="Status">
        <Nuvo::Select
          id="lease-status"
          @value={{this.formStatus}}
          @onChange={{fn this.setFieldValue "formStatus"}}
          @options={{this.validNextStatuses}}
        />
      </Nuvo::Field>
    {{/if}}

    <Nuvo::Field @label="Tenant Name" @required={{true}}>
      <Nuvo::Input
        id="lease-tenant-name"
        type="text"
        placeholder="e.g. Ahmed Al Mansouri"
        @value={{this.formTenantName}}
        @onInput={{fn this.setFieldValue "formTenantName"}}
        required={{true}}
      />
    </Nuvo::Field>

    <div class="flex gap-4">
      <Nuvo::Field class="grow" @label="Email">
        <Nuvo::Input
          id="lease-tenant-email"
          type="email"
          placeholder="ahmed@example.com"
          @value={{this.formTenantEmail}}
          @onInput={{fn this.setFieldValue "formTenantEmail"}}
        />
      </Nuvo::Field>
      <Nuvo::Field class="grow" @label="Phone">
        <Nuvo::Input
          id="lease-tenant-phone"
          type="text"
          placeholder="+971501234567"
          @value={{this.formTenantPhone}}
          @onInput={{fn this.setFieldValue "formTenantPhone"}}
        />
      </Nuvo::Field>
    </div>

    <div class="flex gap-4">
      <Nuvo::Field class="grow" @label="Property Type">
        <Nuvo::Select
          id="lease-type"
          @value={{this.formType}}
          @onChange={{fn this.setFieldValue "formType"}}
          @options={{this.leaseTypeOptions}}
          @placeholder="Select property type..."
        />
      </Nuvo::Field>
      <Nuvo::Field class="grow" @label="Number of Cheques">
        <Nuvo::Input
          id="lease-cheques"
          type="number"
          @value={{this.formNumberOfCheques}}
          @onInput={{fn this.setFieldValue "formNumberOfCheques"}}
          min="1"
          max="12"
        />
      </Nuvo::Field>
    </div>

    <div class="flex gap-4">
      <Nuvo::Field class="grow" @label="Start Date" @required={{true}}>
        <input
          id="lease-start"
          type="date"
          class="nu-input"
          value={{this.formStartDate}}
          required
          {{on "input" (fn this.setFieldValueFromEvent "formStartDate")}}
        />
      </Nuvo::Field>
      <Nuvo::Field class="grow" @label="End Date" @required={{true}}>
        <input
          id="lease-end"
          type="date"
          class="nu-input"
          value={{this.formEndDate}}
          required
          {{on "input" (fn this.setFieldValueFromEvent "formEndDate")}}
        />
      </Nuvo::Field>
    </div>

    <div class="flex gap-4">
      <Nuvo::Field class="grow" @label="Monthly Rent" @required={{true}}>
        <Nuvo::Input
          id="lease-rent"
          type="number"
          placeholder="e.g. 8500"
          @value={{this.formMonthlyRent}}
          @onInput={{fn this.setFieldValue "formMonthlyRent"}}
          required={{true}}
          min="0"
          step="0.01"
        />
      </Nuvo::Field>
      <Nuvo::Field class="grow" @label="Security Deposit">
        <Nuvo::Input
          id="lease-deposit"
          type="number"
          placeholder="e.g. 17000"
          @value={{this.formSecurityDeposit}}
          @onInput={{fn this.setFieldValue "formSecurityDeposit"}}
          min="0"
          step="0.01"
        />
      </Nuvo::Field>
    </div>

    <Nuvo::Field @label="Ejari Number">
      <Nuvo::Input
        id="lease-ejari"
        type="text"
        placeholder="e.g. EJARI-2026-00001"
        @value={{this.formEjariNumber}}
        @onInput={{fn this.setFieldValue "formEjariNumber"}}
      />
    </Nuvo::Field>

    {{#if this.errorMsg}}
      <p class="text-sm text-danger">{{this.errorMsg}}</p>
    {{/if}}

    <Nuvo::FormActions @align="end">
      <Nuvo::Button
        @variant="secondary"
        @onClick={{this.closeModal}}
      >Cancel</Nuvo::Button>
      <Nuvo::Button
        @variant="primary"
        @type="submit"
        @loading={{this.isSaving}}
      >{{if
          this.isSaving
          "Saving..."
          (if
            this.editLease
            "Update"
            (if this.renewingLeaseId "Renew Lease" "Create Lease")
          )
        }}</Nuvo::Button>
    </Nuvo::FormActions>
  </form>
</Nuvo::Modal>

<ConfirmModal
  @open={{this.showTerminateModal}}
  @title="Terminate Lease"
  @message="Are you sure you want to terminate this lease? This action cannot be undone."
  @confirmText="Terminate"
  @cancelText="Cancel"
  @confirmVariant="danger"
  @isConfirming={{this.isTerminating}}
  @confirmingText="Terminating..."
  @onClose={{this.closeTerminateModal}}
  @onConfirm={{this.confirmTerminate}}
/>
