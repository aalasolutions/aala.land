{{page-title "Leases"}}

<div data-test-leases-page class="flex col gap-6">
  <Nuvo::PageHeader @icon="file-text" @title="Lease Agreements" @subtitle="Manage tenant lease contracts and renewals.">
    <:meta>
      <p class="text-muted">{{format-number @model.total unit="lease"}}</p>
    </:meta>
    <:actions>
      <Nuvo::Button
        @variant="primary"
        @icon="plus"
        {{on "click" this.openCreate}}
      >
        New Lease
      </Nuvo::Button>
    </:actions>
  </Nuvo::PageHeader>

  <Nuvo::Segmented
    @options={{this.statusTabs}}
    @value={{this.status}}
    @onChange={{this.setStatusTab}}
    data-test-lease-status-tabs
  />

  <Nuvo::Accordion
    @items={{array
      (hash
        id="filters"
        title=(if this.hasActiveFilters "Filters · active" "Filters")
      )
    }}
    data-test-filters-accordion
  >
    <div class="flex col gap-4">
      <div class="flex gap-3 wrap">
        <Nuvo::Input
          type="text"
          autocomplete="off"
          placeholder="Search tenant, unit number, Ejari..."
          class="grow"
          value={{this.search}}
          {{on "input" (fn this.updateFilter "search")}}
          data-test-leases-search
        />
      </div>

      <div class="flex gap-3 wrap x-end">
        <Nuvo::Field class="grow" @label="Type">
          <Nuvo::Dropdown
            id="leases-type-filter"
            @align="start"
            @value={{this.type}}
            @onSelect={{this.setType}}
            @options={{this.typeFilterOptions}}
            data-test-type-filter
          />
        </Nuvo::Field>
        <Nuvo::Field @label="Start date from">
          <input
            type="date"
            class="nu-input"
            aria-label="Start date from"
            value={{this.dateFrom}}
            {{on "change" this.setDateFrom}}
            data-test-date-from-filter
          />
        </Nuvo::Field>
        <Nuvo::Field @label="Start date to">
          <input
            type="date"
            class="nu-input"
            aria-label="Start date to"
            value={{this.dateTo}}
            {{on "change" this.setDateTo}}
            data-test-date-to-filter
          />
        </Nuvo::Field>
      </div>

      {{#if this.hasActiveFilters}}
        <div class="flex end">
          <Nuvo::Button
            @variant="danger"
            @size="sm"
            @icon="x"
            {{on "click" this.clearFilters}}
            data-test-clear-filters
          >
            Clear filters
          </Nuvo::Button>
        </div>
      {{/if}}
    </div>
  </Nuvo::Accordion>

  <Nuvo::Card>
    {{#if @model.leases.length}}
      <div class="nu-table-wrapper">
        <table class="nu-table">
          <thead>
            <tr>
              <th>Tenant</th>
              <th>Unit</th>
              <th>Type</th>
              <th>Rent</th>
              <th>Period</th>
              <th>Status</th>
              <th>Ejari #</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each @model.leases as |lease|}}
              <tr data-test-lease-row>
                <td class="font-bold">{{or lease.contact.displayName "Unknown tenant"}}</td>
                <td class="text-muted">
                  {{#if lease.unit}}
                    <Nuvo::Button
                      @variant="secondary"
                      @size="xs"
                      @route="properties.unit"
                      @models={{array lease.unit.areaId lease.unit.id}}
                      @text={{lease.unit.unitNumber}}
                      data-test-view-lease-unit
                    />
                  {{/if}}
                </td>
                <td class="text-muted">{{lease.type}}</td>
                <td class="text-muted">{{format-currency lease.monthlyRent}}/mo</td>
                <td class="text-muted">{{format-date lease.startDate}} - {{format-date lease.endDate}}</td>
                <td>
                  <Nuvo::Tag
                    class="tag-lease-{{lowercase lease.status}}"
                    @text={{lease.status}}
                  />
                </td>
                <td class="text-muted">{{or lease.ejariNumber "-"}}</td>
                <td>
                  <div class="flex gap-2 wrap">
                    <Nuvo::Button
                      @variant="secondary"
                      @size="xs"
                      @icon="pencil-simple"
                      {{on "click" (fn this.openEdit lease)}}
                    >
                      Edit
                    </Nuvo::Button>
                    {{#if (eq lease.status "ACTIVE")}}
                      <Nuvo::Button
                        data-test-renew-lease
                        @variant="secondary"
                        @size="xs"
                        @icon="arrows-clockwise"
                        {{on "click" (fn this.renewLease lease)}}
                      >
                        Renew
                      </Nuvo::Button>
                      <Nuvo::Button
                        data-test-terminate-lease
                        @variant="danger"
                        @size="xs"
                        @icon="x-circle"
                        {{on "click" (fn this.openTerminate lease)}}
                      >
                        Terminate
                      </Nuvo::Button>
                    {{/if}}
                    {{#if (eq lease.status "EXPIRED")}}
                      <Nuvo::Button
                        data-test-renew-lease
                        @variant="secondary"
                        @size="xs"
                        @icon="arrows-clockwise"
                        {{on "click" (fn this.renewLease lease)}}
                      >
                        Renew
                      </Nuvo::Button>
                    {{/if}}
                    <Nuvo::Button
                      @variant="danger"
                      @size="xs"
                      @icon="trash"
                      aria-label="Delete lease for {{lease.contact.displayName}}"
                      data-test-delete-lease
                      {{on "click" (fn this.openDelete lease)}}
                    />
                  </div>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      <Nuvo::Pagination
        @selectId="leases-limit"
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{@model.total}}
        @onLimitChange={{this.setLimit}}
        @onPrevious={{this.goToPreviousPage}}
        @onNext={{this.goToNextPage}}
      />
    {{else}}
      {{#if @model.total}}
        <Nuvo::EmptyState
          @description="No leases on page {{this.page}}. Navigate back or adjust your filters."
        />
        <Nuvo::Pagination
          @selectId="leases-limit"
          @page={{this.page}}
          @limit={{this.limit}}
          @total={{@model.total}}
          @onLimitChange={{this.setLimit}}
          @onPrevious={{this.goToPreviousPage}}
          @onNext={{this.goToNextPage}}
        />
      {{else}}
        <Nuvo::EmptyState
          @description="No leases yet. Create your first lease agreement."
        />
      {{/if}}
    {{/if}}
  </Nuvo::Card>
</div>

<Nuvo::Drawer
  @open={{this.showModal}}
  @title={{if
    this.editLease
    "Edit Lease"
    (if this.renewingLeaseId "Renew Lease" "New Lease")
  }}
  @placement="end"
  @size="lg"
  @onClose={{this.closeModal}}
>
  <:body>
    <form
      id="lease-form"
      class="flex col gap-4"
      {{on "submit" this.saveLease}}
    >
      <Nuvo::Field @label="Property" @required={{true}}>
        <Nuvo::Dropdown
          id="lease-unit-id"
          @align="start"
          @value={{this.formUnitId}}
          @onSelect={{fn this.setFieldValue "formUnitId"}}
          @options={{this.unitOptions}}
          @placeholder="Select a property..."
        />
      </Nuvo::Field>

      {{#if this.editLease}}
        <Nuvo::Field @label="Status">
          <Nuvo::Dropdown
            id="lease-status"
            @align="start"
            @value={{this.formStatus}}
            @onSelect={{fn this.setFieldValue "formStatus"}}
            @options={{this.validNextStatuses}}
          />
        </Nuvo::Field>
      {{/if}}

      <Nuvo::Field @label="Tenant" @required={{true}}>
        <Nuvo::Dropdown
          id="lease-tenant"
          @align="start"
          @value={{this.formTenantContactId}}
          @onSelect={{fn this.setFieldValue "formTenantContactId"}}
          @options={{this.tenantOptions}}
          @placeholder="Select a tenant..."
          data-test-lease-tenant
        />
      </Nuvo::Field>

      <div class="flex gap-4">
        <Nuvo::Field class="grow" @label="Property Type">
          <Nuvo::Dropdown
            id="lease-type"
            @align="start"
            @value={{this.formType}}
            @onSelect={{fn this.setFieldValue "formType"}}
            @options={{this.leaseTypeOptions}}
            @placeholder="Select property type..."
          />
        </Nuvo::Field>
        <Nuvo::Field class="grow" @label="Number of Cheques">
          <Nuvo::Input
            id="lease-cheques"
            type="number"
            @value={{this.formNumberOfCheques}}
            @onInput={{fn this.setFieldValue "formNumberOfCheques"}}
            min="1"
            max="12"
          />
        </Nuvo::Field>
      </div>

      <div class="flex gap-4">
        <Nuvo::Field class="grow" @label="Start Date" @required={{true}}>
          <input
            id="lease-start"
            type="date"
            class="nu-input"
            value={{this.formStartDate}}
            required
            {{on "input" (fn this.setFieldValueFromEvent "formStartDate")}}
          />
        </Nuvo::Field>
        <Nuvo::Field class="grow" @label="End Date" @required={{true}}>
          <input
            id="lease-end"
            type="date"
            class="nu-input"
            value={{this.formEndDate}}
            required
            {{on "input" (fn this.setFieldValueFromEvent "formEndDate")}}
          />
        </Nuvo::Field>
      </div>

      <div class="flex gap-4">
        <Nuvo::Field class="grow" @label="Monthly Rent" @required={{true}}>
          <Nuvo::Input
            id="lease-rent"
            type="number"
            placeholder="e.g. 8500"
            @value={{this.formMonthlyRent}}
            @onInput={{fn this.setFieldValue "formMonthlyRent"}}
            required={{true}}
            min="0"
            step="0.01"
          />
        </Nuvo::Field>
        <Nuvo::Field class="grow" @label="Security Deposit">
          <Nuvo::Input
            id="lease-deposit"
            type="number"
            placeholder="e.g. 17000"
            @value={{this.formSecurityDeposit}}
            @onInput={{fn this.setFieldValue "formSecurityDeposit"}}
            min="0"
            step="0.01"
          />
        </Nuvo::Field>
      </div>

      <Nuvo::Field @label="Ejari Number">
        <Nuvo::Input
          id="lease-ejari"
          type="text"
          placeholder="e.g. EJARI-2026-00001"
          @value={{this.formEjariNumber}}
          @onInput={{fn this.setFieldValue "formEjariNumber"}}
        />
      </Nuvo::Field>

      <Nuvo::Field @label="Notes">
        <Nuvo::Textarea
          id="lease-notes"
          placeholder="Additional notes..."
          rows="3"
          @value={{this.formNotes}}
          @onInput={{fn this.setFieldValue "formNotes"}}
          data-test-input-notes
        />
      </Nuvo::Field>

      {{#if this.errorMsg}}
        <p class="text-sm text-danger">{{this.errorMsg}}</p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Nuvo::Button
      @variant="secondary"
      @onClick={{this.closeModal}}
    >Cancel</Nuvo::Button>
    <Nuvo::Button
      @variant="primary"
      @type="submit"
      form="lease-form"
      @loading={{this.isSaving}}
    >{{if
        this.isSaving
        "Saving..."
        (if
          this.editLease
          "Update"
          (if this.renewingLeaseId "Renew Lease" "Create Lease")
        )
      }}</Nuvo::Button>
  </:footer>
</Nuvo::Drawer>

<ConfirmModal
  @open={{this.showTerminateModal}}
  @title="Terminate Lease"
  @message="Are you sure you want to terminate this lease? This action cannot be undone."
  @confirmText="Terminate"
  @cancelText="Cancel"
  @confirmVariant="danger"
  @isConfirming={{this.isTerminating}}
  @confirmingText="Terminating..."
  @onClose={{this.closeTerminateModal}}
  @onConfirm={{this.confirmTerminate}}
/>

<ConfirmModal
  @open={{this.showDeleteModal}}
  @title="Delete Lease"
  @message="Are you sure you want to delete this lease agreement? This action cannot be undone."
  @confirmText="Delete"
  @cancelText="Cancel"
  @confirmVariant="danger"
  @isConfirming={{this.isDeleting}}
  @confirmingText="Deleting..."
  @onClose={{this.closeDeleteModal}}
  @onConfirm={{this.confirmDelete}}
/>
