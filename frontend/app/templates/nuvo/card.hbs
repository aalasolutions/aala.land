<NuvoDocs::Page
  @id="card"
  @title="Card, Stat, Info row, List item"
  @subtitle="Surfaces and rows that group related content."
  @components="Nuvo::Card, Nuvo::Stat, Nuvo::InfoRow, Nuvo::ListItem"
>
  <NuvoDocs::Section @title="Overview" @id="overview">
    <p class="nuvo-doc__intro">
      Card is the general surface with optional header, body and footer
      slots. Stat is a KPI tile, InfoRow a label/value line inside a card,
      and ListItem a row with main content and trailing actions. Reach for
      Panel instead of Card when the region is a plain container such as a
      filter block.
    </p>
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Features" @id="features">
    <ul class="nu-list">
      <li class="nu-list__item">Card header from arguments or a named block; body from a named or default block; footer slot.</li>
      <li class="nu-list__item">Compact, flat, raised, interactive, accent and selected styles.</li>
      <li class="nu-list__item">Stat with icon well, label, value and delta in six colours.</li>
      <li class="nu-list__item">InfoRow value from an argument or a block.</li>
      <li class="nu-list__item">ListItem with main and actions slots.</li>
    </ul>
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Card: header and slots" @id="card-slots">
    <NuvoDocs::Example
      @title="Title"
      @note="A title alone renders the header; the default block becomes the body. The everyday card."
      @code={{this.code.title}}
    >
      <Nuvo::Card @title="Marina Tower">
        <p class="nu-text m-sm m-muted">Sea-facing unit, fully furnished.</p>
      </Nuvo::Card>
    </NuvoDocs::Example>

    <NuvoDocs::Example
      @title="Title and subtitle"
      @note="The subtitle carries a secondary fact under the title, such as the unit or the period."
      @code={{this.code.subtitle}}
    >
      <Nuvo::Card @title="Marina Tower" @subtitle="Unit 204 · 2BR">
        <p class="nu-text m-sm m-muted">
          Sea-facing unit, fully furnished, tenant on a 12-month lease.
        </p>
      </Nuvo::Card>
    </NuvoDocs::Example>

    <NuvoDocs::Example
      @title="Header block"
      @note="Replaces the title area with your own markup when the header needs a badge, an avatar or a menu."
      @code={{this.code.headerBlock}}
    >
      <Nuvo::Card>
        <:header>
          <Nuvo::Title @tag="h3" @size="md" @text="Custom header" />
          <Nuvo::Badge @variant="success" @text="Active" />
        </:header>
        <:body>Body content.</:body>
      </Nuvo::Card>
    </NuvoDocs::Example>

    <NuvoDocs::Example
      @title="Body and footer blocks"
      @note="Named body and footer slots give actions a fixed place at the bottom; the footer aligns them to the end."
      @code={{this.code.slots}}
    >
      <Nuvo::Card @title="Occupancy" @subtitle="This month">
        <:body>
          <p class="nu-text m-sm m-muted">Named-block body content.</p>
        </:body>
        <:footer>
          <Nuvo::Button @variant="secondary" @size="sm" @text="View report" />
        </:footer>
      </Nuvo::Card>
    </NuvoDocs::Example>
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Card: density and elevation" @id="card-styles">
    <NuvoDocs::Example
      @title="Compact"
      @note="Tighter padding for dense grids and sidebars."
      @code={{this.code.compact}}
    >
      <Nuvo::Card @title="Compact" @compact={{true}}>
        <p class="nu-text m-sm m-muted">Tighter padding for dense lists.</p>
      </Nuvo::Card>
    </NuvoDocs::Example>

    <NuvoDocs::Example
      @title="Flat"
      @note="Border only, no shadow, for cards nested inside another surface."
      @code={{this.code.flat}}
    >
      <Nuvo::Card @title="Flat" @flat={{true}}>
        <p class="nu-text m-sm m-muted">No shadow, border only.</p>
      </Nuvo::Card>
    </NuvoDocs::Example>

    <NuvoDocs::Example
      @title="Raised"
      @note="Elevated shadow for a card that floats over a busy background, such as a summary above a table."
      @code={{this.code.raised}}
    >
      <Nuvo::Card @title="Raised" @raised={{true}}>
        <p class="nu-text m-sm m-muted">Elevated shadow, stands off the page.</p>
      </Nuvo::Card>
    </NuvoDocs::Example>
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Card: states" @id="card-states">
    <NuvoDocs::Example
      @title="Interactive"
      @note="Hover and focus affordance for a card that is one clickable unit. Style only: wrap it in a link or put the action in the footer."
      @code={{this.code.interactive}}
    >
      <Nuvo::Card @title="Interactive" @interactive={{true}}>
        <p class="nu-text m-sm m-muted">Hover/focus affordance, clickable card.</p>
      </Nuvo::Card>
    </NuvoDocs::Example>

    <NuvoDocs::Example
      @title="Selected"
      @note="Primary ring for the chosen card in a set, such as the current plan."
      @code={{this.code.selected}}
    >
      <Nuvo::Card @title="Selected" @selected={{true}}>
        <p class="nu-text m-sm m-muted">Primary-ring border, chosen state.</p>
      </Nuvo::Card>
    </NuvoDocs::Example>
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Card: accents" @id="card-accents">
    {{#each this.accentExamples as |example|}}
      <NuvoDocs::Example @title={{example.title}} @note={{example.note}} @code={{example.code}}>
        <Nuvo::Card @title={{example.title}} @accent={{example.accent}}>
          <p class="nu-text m-sm m-muted">Tinted surface.</p>
        </Nuvo::Card>
      </NuvoDocs::Example>
    {{/each}}

    <h3 class="nuvo-subtitle">Card arguments</h3>
    <NuvoDocs::Table @kind="args" @rows={{this.cardArgRows}} />
    <h3 class="nuvo-subtitle">Card blocks</h3>
    <NuvoDocs::Table @kind="blocks" @rows={{this.cardBlockRows}} />
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Stat" @id="stat">
    {{#each this.statExamples as |example|}}
      <NuvoDocs::Example @title={{example.title}} @note={{example.note}} @code={{example.code}}>
        <Nuvo::Stat @variant={{example.variant}} @icon="🏠" @label="Occupied units" @value="184" @delta="+4 this month" />
      </NuvoDocs::Example>
    {{/each}}

    <NuvoDocs::Example
      @title="Icon block"
      @note="A block in the icon well for a Phosphor icon instead of a glyph."
      @code={{this.code.statIconBlock}}
    >
      <Nuvo::Stat @variant="primary" @label="Occupancy rate" @value="94%" @delta="+2.1%">
        <:icon><Nuvo::Icon @icon="buildings" /></:icon>
      </Nuvo::Stat>
    </NuvoDocs::Example>

    <NuvoDocs::Example
      @title="Label and value only"
      @note="Icon and delta are optional; the value is always rendered."
      @code={{this.code.statBare}}
    >
      <Nuvo::Stat @label="Leases" @value="37" />
    </NuvoDocs::Example>

    <h3 class="nuvo-subtitle">Stat arguments</h3>
    <NuvoDocs::Table @kind="args" @rows={{this.statArgRows}} />
    <h3 class="nuvo-subtitle">Stat blocks</h3>
    <NuvoDocs::Table @kind="blocks" @rows={{this.statBlockRows}} />
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Info row" @id="info-row">
    <NuvoDocs::Example
      @title="Label and value"
      @note="One fact per row inside a card, for summaries and detail panels."
      @layout="block"
      @code={{this.code.infoRow}}
    >
      <Nuvo::Card @title="Lease Summary">
        <Nuvo::InfoRow @label="Tenant" @value="Ahmed Khalid" />
        <Nuvo::InfoRow @label="Unit" @value="Marina Tower, 204" />
        <Nuvo::InfoRow @label="Rent" @value="AED 8,500/mo" />
      </Nuvo::Card>
    </NuvoDocs::Example>

    <NuvoDocs::Example
      @title="Block value"
      @note="A block replaces the plain value with a badge, a link or a button."
      @layout="block"
      @code={{this.code.infoRowBlock}}
    >
      <Nuvo::Card @title="Lease">
        <Nuvo::InfoRow @label="Lease ends">
          <Nuvo::Badge @variant="warning" @text="42 days left" />
        </Nuvo::InfoRow>
      </Nuvo::Card>
    </NuvoDocs::Example>

    <NuvoDocs::Example
      @title="Stacked and borderless"
      @note="Two stylesheet modifiers with no argument: stacked puts the label above the value for long text, borderless drops the divider for the last row."
      @layout="block"
      @code={{this.code.infoRowClasses}}
    >
      <Nuvo::Card @title="Modifiers">
        <Nuvo::InfoRow @label="Stacked" @value="Label above the value" class="m-stacked" />
        <Nuvo::InfoRow @label="Borderless" @value="No divider" class="m-borderless" />
      </Nuvo::Card>
    </NuvoDocs::Example>

    <h3 class="nuvo-subtitle">Info row arguments</h3>
    <NuvoDocs::Table @kind="args" @rows={{this.infoRowArgRows}} />
    <h3 class="nuvo-subtitle">Info row blocks</h3>
    <NuvoDocs::Table @kind="blocks" @rows={{this.infoRowBlockRows}} />
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="List item" @id="list-item">
    <NuvoDocs::Example
      @title="Main and actions"
      @note="A row with content that fills and controls that trail, for pick lists and assignment panels."
      @layout="block"
      @code={{this.code.listItem}}
    >
      {{#each this.units as |unit|}}
        <Nuvo::ListItem>
          <:main>
            <div>
              <p class="nu-text m-sm">{{unit.name}}</p>
              <p class="nu-text m-xs m-muted">{{unit.tenant}} · {{unit.rent}}</p>
            </div>
          </:main>
          <:actions>
            <Nuvo::Button
              @variant={{if (eq this.selectedUnitId unit.id) "primary" "secondary"}}
              @size="sm"
              @text={{if (eq this.selectedUnitId unit.id) "Selected" "Select"}}
              @onClick={{fn this.selectUnit unit.id}}
              data-test-nuvo-select-unit={{unit.id}}
            />
          </:actions>
        </Nuvo::ListItem>
      {{/each}}
    </NuvoDocs::Example>

    <NuvoDocs::Example
      @title="Hoverable, raised, plain"
      @note="Stylesheet modifiers passed through class: hoverable for clickable rows, raised for a highlighted row, plain for a row inside a card that already has a border."
      @layout="block"
      @code={{this.code.listItemClasses}}
    >
      <Nuvo::ListItem class="m-hoverable"><:main>Hoverable</:main></Nuvo::ListItem>
      <Nuvo::ListItem class="m-raised"><:main>Raised</:main></Nuvo::ListItem>
      <Nuvo::ListItem class="m-plain"><:main>Plain</:main></Nuvo::ListItem>
    </NuvoDocs::Example>

    <h3 class="nuvo-subtitle">List item blocks</h3>
    <NuvoDocs::Table @kind="blocks" @rows={{this.listItemBlockRows}} />
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Raw classes" @id="classes">
    <p class="nuvo-note">Modifiers the stylesheets ship with no matching argument. Pass them through <code>class</code>.</p>
    <NuvoDocs::Table @kind="classes" @rows={{this.classRows}} />
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="nu-list">
      <li class="nu-list__item">The card title is an h3. Keep one h2 above a group of cards so the heading outline stays in order.</li>
      <li class="nu-list__item">An interactive card is styled only; wrap it in a link or button, or put the action in the footer, for keyboard access.</li>
      <li class="nu-list__item">The stat icon well is aria-hidden; the label and value carry the meaning.</li>
    </ul>
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="RTL" @id="rtl">
    <ul class="nu-list">
      <li class="nu-list__item">Header, InfoRow and ListItem are flex rows with logical gaps, so labels lead and actions trail in both directions.</li>
    </ul>
  </NuvoDocs::Section>
</NuvoDocs::Page>
