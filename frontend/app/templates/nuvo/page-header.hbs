<NuvoDocs::Page
  @id="page-header"
  @title="Page header"
  @subtitle="Title block with breadcrumb, meta and actions slots."
  @components="Nuvo::PageHeader"
>
  <NuvoDocs::Section @title="Overview" @id="overview">
    <p class="nuvo-doc__intro">
      The header at the top of a route. It owns the page h1 and gives the
      breadcrumb, supporting facts and primary actions fixed places so every
      page lines up. The header of this documentation page is one. Use it
      once per route, never inside a card.
    </p>
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Features" @id="features">
    <ul class="nu-list">
      <li class="nu-list__item">Title, subtitle and an optional Phosphor icon.</li>
      <li class="nu-list__item">Breadcrumb, meta and actions slots.</li>
      <li class="nu-list__item">Bordered and sticky options.</li>
    </ul>
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Title area" @id="title">
    <NuvoDocs::Example
      @title="Title"
      @note="The h1 alone, for simple list pages."
      @layout="block"
      @code={{this.code.title}}
    >
      <Nuvo::PageHeader @title="Properties" />
    </NuvoDocs::Example>

    <NuvoDocs::Example
      @title="Subtitle"
      @note="A line of context under the title: a count, a location, a period."
      @layout="block"
      @code={{this.code.subtitle}}
    >
      <Nuvo::PageHeader @title="Marina Tower" @subtitle="42 units - Dubai Marina" />
    </NuvoDocs::Example>

    <NuvoDocs::Example
      @title="Icon"
      @note="A Phosphor icon before the title identifies the section at a glance; match the sidebar icon of the route."
      @layout="block"
      @code={{this.code.icon}}
    >
      <Nuvo::PageHeader @icon="buildings" @title="Properties" @subtitle="Every building in the active region" />
    </NuvoDocs::Example>

    <NuvoDocs::Example
      @title="Custom icon with the :icon slot"
      @note="The :icon block replaces @icon, so a host can lead the title with its own artwork. The slot content is wrapped in the element carrying nu-page-header__title-icon, so sizing and RTL mirroring still apply."
      @code={{this.code.iconSlot}}
    >
      <Nuvo::PageHeader @title="Properties" @subtitle="Icon supplied by the host">
        <:icon>
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
            <rect x="3" y="3" width="14" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
        </:icon>
      </Nuvo::PageHeader>
    </NuvoDocs::Example>

    <NuvoDocs::Example
      @title="Bordered"
      @note="A rule under the header separates it from content that starts without its own surface."
      @layout="block"
      @code={{this.code.bordered}}
    >
      <Nuvo::PageHeader @title="Bordered" @subtitle="A rule under the header" @bordered={{true}} />
    </NuvoDocs::Example>
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Slots" @id="slots">
    <NuvoDocs::Example
      @title="Breadcrumb"
      @note="The trail above the title, usually a compact Nuvo::Breadcrumb, on detail pages that sit under a list."
      @layout="block"
      @code={{this.code.breadcrumb}}
    >
      <Nuvo::PageHeader @title="Marina Tower">
        <:breadcrumb>
          <Nuvo::Breadcrumb @items={{this.crumbs}} @compact={{true}} />
        </:breadcrumb>
      </Nuvo::PageHeader>
    </NuvoDocs::Example>

    <NuvoDocs::Example
      @title="Meta"
      @note="Badges and short facts under the subtitle: status, occupancy, owner."
      @layout="block"
      @code={{this.code.meta}}
    >
      <Nuvo::PageHeader @title="Marina Tower" @subtitle="42 units - Dubai Marina">
        <:meta>
          <Nuvo::Badge @variant="success" @text="Active" />
          <span>Occupancy 91%</span>
        </:meta>
      </Nuvo::PageHeader>
    </NuvoDocs::Example>

    <NuvoDocs::Example
      @title="Actions"
      @note="Primary and secondary page actions at the inline end. Keep it to two or three; move the rest into a dropdown."
      @layout="block"
      @code={{this.code.actions}}
    >
      <Nuvo::PageHeader @title="Marina Tower">
        <:actions>
          <Nuvo::Button @variant="secondary" @size="sm" @text="Export" />
          <Nuvo::Button @variant="primary" @size="sm" @text="Add Unit" />
        </:actions>
      </Nuvo::PageHeader>
    </NuvoDocs::Example>
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Sticky" @id="sticky">
    <NuvoDocs::Example
      @title="Pinned in a scroll container"
      @note="Scroll the box: the header stays at the top so the title and actions remain in reach on a long page."
      @layout="block"
      @code={{this.code.sticky}}
    >
      <div class="nuvo-scroll-box" data-test-nuvo-sticky-demo>
        <Nuvo::PageHeader @title="Sticky header" @subtitle="stays pinned in a scroll container" @sticky={{true}} />
        {{#each this.filler as |line|}}
          <Nuvo::Text @size="sm" @muted={{true}} @text={{line}} class="ps-4" />
        {{/each}}
      </div>
    </NuvoDocs::Example>
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Arguments" @id="arguments">
    <NuvoDocs::Table @kind="args" @rows={{this.argRows}} />
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Blocks" @id="blocks">
    <NuvoDocs::Table @kind="blocks" @rows={{this.blockRows}} />
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="nu-list">
      <li class="nu-list__item">Renders a header element with the title as h1. Use it once per route.</li>
      <li class="nu-list__item">The title icon is decorative. Use Nuvo::Breadcrumb in the breadcrumb slot for a navigable, labelled trail.</li>
    </ul>
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="RTL" @id="rtl">
    <ul class="nu-list">
      <li class="nu-list__item">Actions sit at the inline end and the icon leads the title, so the layout mirrors with the reading direction.</li>
    </ul>
  </NuvoDocs::Section>
</NuvoDocs::Page>
