<NuvoDocs::Page
  @id="divider"
  @title="Divider"
  @subtitle="Horizontal or vertical rule, plain, dashed or labelled."
  @components="Nuvo::Divider"
>
  <NuvoDocs::Section @title="Overview" @id="overview">
    <p class="nuvo-doc__intro">
      A separator with an optional label. The horizontal form takes the
      full inline size and splits groups of content; the vertical form
      stretches to the height of its flex row and splits controls in a
      toolbar. Prefer spacing over a divider when the groups are already
      visually distinct.
    </p>
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Features" @id="features">
    <ul class="nu-list">
      <li class="nu-list__item">Solid or dashed line.</li>
      <li class="nu-list__item">Centred, start or end label from an argument or a block.</li>
      <li class="nu-list__item">Vertical variant for toolbars and inline groups.</li>
    </ul>
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Line styles" @id="styles">
    <NuvoDocs::Example
      @title="Solid"
      @note="The default rule between sections of a card or form."
      @layout="stack"
      @code={{this.code.plain}}
    >
      <Nuvo::Divider />
    </NuvoDocs::Example>

    <NuvoDocs::Example
      @title="Dashed"
      @note="A softer break for optional or draft content, such as between saved and unsaved items."
      @layout="stack"
      @code={{this.code.dashed}}
    >
      <Nuvo::Divider @dashed={{true}} />
    </NuvoDocs::Example>
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Labels" @id="labels">
    <NuvoDocs::Example
      @title="Centred label"
      @note="Short text on the line, for alternatives such as OR between two sign-in methods."
      @layout="stack"
      @code={{this.code.label}}
    >
      <Nuvo::Divider @label="OR" />
    </NuvoDocs::Example>

    <NuvoDocs::Example
      @title="Label at the start"
      @note="Reads as a section heading with a rule running to the end, for lists grouped by date or category."
      @layout="stack"
      @code={{this.code.start}}
    >
      <Nuvo::Divider @labelPosition="start" @label="Section start" />
    </NuvoDocs::Example>

    <NuvoDocs::Example
      @title="Label at the end"
      @note="Trailing label, for a count or a status closing a group."
      @layout="stack"
      @code={{this.code.end}}
    >
      <Nuvo::Divider @labelPosition="end" @label="Section end" />
    </NuvoDocs::Example>

    <NuvoDocs::Example
      @title="Block label"
      @note="A block replaces the label text, for an icon beside the words."
      @layout="stack"
      @code={{this.code.block}}
    >
      <Nuvo::Divider><Ui::Ph @icon="clock" /> Earlier today</Nuvo::Divider>
    </NuvoDocs::Example>
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Orientation" @id="orientation">
    <NuvoDocs::Example
      @title="Vertical"
      @note="Fills the height of a flex row to split toolbar groups. It has no label form."
      @layout="block"
      @code={{this.code.vertical}}
    >
      <div class="nuvo-row nuvo-row--full-height">
        <span class="nu-text m-sm">Start</span>
        <Nuvo::Divider @vertical={{true}} />
        <span class="nu-text m-sm">End</span>
      </div>
    </NuvoDocs::Example>
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Arguments" @id="arguments">
    <NuvoDocs::Table @kind="args" @rows={{this.argRows}} />
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Blocks" @id="blocks">
    <NuvoDocs::Table @kind="blocks" @rows={{this.blockRows}} />
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="Accessibility" @id="accessibility">
    <ul class="nu-list">
      <li class="nu-list__item">Renders role="separator". A label is read as part of the page text.</li>
    </ul>
  </NuvoDocs::Section>

  <NuvoDocs::Section @title="RTL" @id="rtl">
    <ul class="nu-list">
      <li class="nu-list__item">Start and end label positions are logical and swap with the reading direction.</li>
    </ul>
  </NuvoDocs::Section>
</NuvoDocs::Page>
