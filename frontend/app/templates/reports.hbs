{{page-title "Reports"}}

<div data-test-reports-page class="flex col gap-6">
  <div>
    <h2 class="text-3xl font-bold"><Ui::Ph @icon="chart-bar" @size="28px" />
      Boss Dashboard</h2>
    <p class="text-muted mt-1">Real-time performance and business intelligence.</p>
  </div>

  {{! KPI Cards }}
  {{#if @model.kpis}}
    <div class="kpi-grid">
      <Nuvo::Panel class="text-center">
        <p class="text-xs text-muted uppercase">Total Leads</p>
        <p class="text-3xl font-bold mt-1">{{format-number
            @model.kpis.totalLeads
          }}</p>
      </Nuvo::Panel>
      <Nuvo::Panel class="text-center">
        <p class="text-xs text-muted uppercase">Won Leads</p>
        <p class="text-3xl font-bold mt-1 text-success">{{format-number
            @model.kpis.wonLeads
          }}</p>
      </Nuvo::Panel>
      <Nuvo::Panel class="text-center">
        <p class="text-xs text-muted uppercase">Total Properties</p>
        <p class="text-3xl font-bold mt-1">{{format-number
            @model.kpis.totalUnits
          }}</p>
      </Nuvo::Panel>
      <Nuvo::Panel class="text-center">
        <p class="text-xs text-muted uppercase">Monthly Revenue</p>
        <p class="text-3xl font-bold mt-1">{{format-currency
            @model.kpis.monthlyRevenue
          }}</p>
      </Nuvo::Panel>
      <Nuvo::Panel class="text-center">
        <p class="text-xs text-muted uppercase">Active Leases</p>
        <p class="text-3xl font-bold mt-1">{{format-number
            @model.kpis.activeLeases
          }}</p>
      </Nuvo::Panel>
      <Nuvo::Panel class="text-center">
        <p class="text-xs text-muted uppercase">Pending Cheques</p>
        <p class="text-3xl font-bold mt-1">{{format-number
            @model.kpis.pendingCheques
          }}</p>
      </Nuvo::Panel>
    </div>
  {{/if}}

  {{! Red Flag Alerts }}
  {{#if @model.redFlags.length}}
    <Nuvo::Panel>
      <:header>
        <h4 class="nu-panel__title"><Ui::Ph @icon="warning" @size="20px" />
          Red Flag Alerts</h4>
      </:header>
      <:body>
      <div class="flex col gap-2">
        {{#each @model.redFlags as |flag|}}
          <div
            class="flex between x-center p-3 rounded-lg red-flag-{{lowercase
                flag.severity
              }}"
          >
            <div class="flex x-center gap-3">
              {{#if (eq flag.severity "HIGH")}}
                <span class="flag-dot flag-dot-high"></span>
              {{else if (eq flag.severity "MEDIUM")}}
                <span class="flag-dot flag-dot-medium"></span>
              {{else}}
                <span class="flag-dot flag-dot-low"></span>
              {{/if}}
              <span class="text-sm">{{flag.message}}</span>
            </div>
            <span
              class="type-badge type-{{lowercase flag.type}}"
            >{{flag.type}}</span>
          </div>
        {{/each}}
      </div>
      </:body>
    </Nuvo::Panel>
  {{/if}}

  {{! Pipeline Funnel }}
  {{#if @model.funnel.length}}
    <Nuvo::Panel>
      <:header>
        <h4 class="nu-panel__title"><Ui::Ph @icon="funnel" @size="20px" />
          Pipeline Funnel</h4>
      </:header>
      <:body>
      <div class="funnel-grid">
        {{#each @model.funnel as |stage|}}
          <div class="funnel-stage text-center">
            <p class="text-2xl font-bold">{{format-number stage.count}}</p>
            <p class="text-xs text-muted uppercase mt-1">{{stage.stage}}</p>
          </div>
        {{/each}}
      </div>
      </:body>
    </Nuvo::Panel>
  {{/if}}

  {{! Agent Performance }}
  {{#if @model.agents.length}}
    <Nuvo::Panel>
      <:header>
        <h4 class="nu-panel__title"><Ui::Ph
            @icon="users-three"
            @size="20px"
          />
          Agent Performance</h4>
      </:header>
      <:body>
      <div class="nu-table-wrapper">
        <table class="nu-table">
          <thead>
            <tr>
              <th>Agent</th>
              <th>Leads</th>
              <th>Won</th>
              <th>Lost</th>
              <th>Conversion</th>
              <th>Commissions</th>
            </tr>
          </thead>
          <tbody>
            {{#each @model.agents as |agent|}}
              <tr data-test-agent-row data-test-agent-id={{agent.agentId}}>
                <td>
                  <div class="flex x-center gap-2">
                    <div class="agent-avatar">{{uc-first agent.agentName}}</div>
                    <span class="text-sm">{{if
                        agent.agentName
                        agent.agentName
                        (truncate-id agent.agentId)
                      }}</span>
                  </div>
                </td>
                <td>{{format-number agent.leadsAssigned}}</td>
                <td class="text-success font-bold">{{format-number
                    agent.leadsWon
                  }}</td>
                <td class="text-danger">{{format-number agent.leadsLost}}</td>
                <td>
                  <span
                    class="font-bold
                      {{if
                        (gt agent.conversionRate 50)
                        'text-success'
                        (if
                          (gt agent.conversionRate 25)
                          'text-warning'
                          'text-danger'
                        )
                      }}"
                  >
                    {{agent.conversionRate}}%
                  </span>
                </td>
                <td class="font-bold">{{format-currency
                    agent.commissionsEarned
                  }}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      </:body>
    </Nuvo::Panel>
  {{else}}
    <Nuvo::Panel class="text-center">
      <p class="text-muted">No agent data available.</p>
    </Nuvo::Panel>
  {{/if}}

  {{! Activity Feed }}
  {{#if @model.activity.length}}
    <Nuvo::Panel>
      <:header>
        <h4 class="nu-panel__title"><Ui::Ph
            @icon="clock-counter-clockwise"
            @size="20px"
          />
          Recent Activity</h4>
      </:header>
      <:body>
      <div class="flex col gap-2">
        {{#each @model.activity as |item|}}
          <div class="flex between x-center p-3 rounded-lg activity-row">
            <div class="flex x-center gap-3">
              <Nuvo::Tag
                class="badge-audit-{{lowercase item.action}}"
                @text={{item.action}}
              />
              <span class="text-sm">{{item.entityType}}</span>
            </div>
            <span class="text-xs text-muted">{{format-date
                item.createdAt
              }}</span>
          </div>
        {{/each}}
      </div>
      </:body>
    </Nuvo::Panel>
  {{/if}}
</div>