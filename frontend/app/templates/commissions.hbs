{{page-title "Commissions"}}

<div data-test-commissions-page class="flex col gap-6">
  <Nuvo::PageHeader @title="Commissions" @subtitle="Track agent commissions and payouts.">
    <:actions>
      <div class="flex gap-3 x-end">
        <Nuvo::Dropdown
          id="commissions-status-filter"
          @align="start"
          @value={{this.filterStatus}}
          @onSelect={{this.setStatusFilter}}
          @options={{this.filterStatusOptions}}
          @placeholder="All"
        />
        <Nuvo::Button
          @variant="primary"
          data-test-add-commission
          @icon="plus"
          {{on "click" this.openCreate}}
        >
          New Commission
        </Nuvo::Button>
      </div>
    </:actions>
  </Nuvo::PageHeader>

  <Nuvo::Card>
    {{#if this.filteredCommissions.length}}
      <Nuvo::DataTable
        @columns={{this.columns}}
        @rows={{this.filteredCommissions}}
        @pinColumns={{true}}
        @reorderable={{true}}
        @sortable={{true}}
        @showOptions={{true}}
        @tableId="commissions"
        data-test-commissions-table
        as |cell|
      >
        {{#if (eq cell.key "agentId")}}
          <span class="text-xs" data-test-commission-row>{{truncate-id
              cell.value
            }}</span>
        {{else if (eq cell.key "leadId")}}
          <span class="text-xs">
            {{#if cell.row.leadId}}
              {{truncate-id cell.row.leadId}}
            {{else if cell.row.transactionId}}
              {{truncate-id cell.row.transactionId}}
            {{else}}
              <span class="text-muted">N/A</span>
            {{/if}}
          </span>
        {{else if (eq cell.key "type")}}
          <Nuvo::Tag
            class="tag-commtype-{{lowercase cell.value}}"
            @text={{cell.value}}
          />
        {{else if (eq cell.key "commissionAmount")}}
          <span class="font-bold">{{format-currency cell.value}}
            /
            {{format-currency cell.row.grossAmount}}</span>
        {{else if (eq cell.key "commissionRate")}}
          {{cell.value}}%
        {{else if (eq cell.key "status")}}
          <Nuvo::Tag
            class="tag-commission-{{lowercase cell.value}}"
            @text={{cell.value}}
          />
        {{else if (eq cell.key "id")}}
          {{#if (eq cell.row.status "PENDING")}}
            <div class="flex">
              <Nuvo::Button
                @subtle={{true}}
                @variant="primary"
                @size="xs"
                data-test-approve-btn
                @icon="check"
                aria-label="Approve commission"
                data-tooltip="Approve"
                {{on "click" (fn this.approveCommission cell.row)}}
              />
              <Nuvo::Button
                @subtle={{true}}
                @variant="secondary"
                @size="xs"
                @icon="prohibit"
                aria-label="Cancel commission"
                data-tooltip="Cancel commission"
                data-test-cancel-commission
                {{on "click" (fn this.openCancel cell.row)}}
              />
            </div>
          {{else if (eq cell.row.status "APPROVED")}}
            <div class="flex">
              <Nuvo::Button
                @subtle={{true}}
                @variant="primary"
                @size="xs"
                data-test-pay-btn
                @icon="currency-dollar"
                aria-label="Mark commission paid"
                data-tooltip="Mark Paid"
                {{on "click" (fn this.payCommission cell.row)}}
              />
              <Nuvo::Button
                @subtle={{true}}
                @variant="secondary"
                @size="xs"
                @icon="prohibit"
                aria-label="Cancel commission"
                data-tooltip="Cancel commission"
                data-test-cancel-commission
                {{on "click" (fn this.openCancel cell.row)}}
              />
            </div>
          {{else if (eq cell.row.status "PAID")}}
            <span class="text-xs text-muted">
              {{#if cell.row.paidAt}}
                Paid
                {{format-date cell.row.paidAt}}
              {{else}}
                Paid
              {{/if}}
            </span>
          {{/if}}
        {{else}}
          {{cell.value}}
        {{/if}}
      </Nuvo::DataTable>
    {{else}}
      {{#if @model.total}}
        <Nuvo::EmptyState
          @description="No commissions on this page with current filters. Navigate to find commissions or adjust filters."
        />
      {{else}}
        <Nuvo::EmptyState @description="No commissions found." />
      {{/if}}
    {{/if}}

    {{#if @model.total}}
      <Nuvo::Pagination
        @selectId="commissions-limit"
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{@model.total}}
        @onLimitChange={{this.setLimit}}
        @onPrevious={{this.goToPreviousPage}}
        @onNext={{this.goToNextPage}}
        @onPageChange={{this.goToPage}}
      />
    {{/if}}
  </Nuvo::Card>
</div>

<Nuvo::Drawer
  @open={{this.showModal}}
  @title="New Commission"
  @placement="end"
  @size="lg"
  @onClose={{this.closeModal}}
>
  <:body>
    {{#if this.errorMsg}}
      <p class="text-danger" data-test-error>{{this.errorMsg}}</p>
    {{/if}}
    <form
      id="commission-form"
      class="flex col gap-4"
      {{on "submit" this.saveCommission}}
    >
      <Nuvo::Field @label="Agent" @required={{true}}>
        <Nuvo::Dropdown
          id="commission-agent"
          @align="start"
          @value={{this.formAgentId}}
          @onSelect={{fn this.setFieldValue "formAgentId"}}
          @options={{this.agentOptions}}
          @placeholder="Select agent..."
          data-test-input-agent
        />
      </Nuvo::Field>

      <Nuvo::Field @label="Type" @required={{true}}>
        <Nuvo::Dropdown
          id="commission-type"
          @align="start"
          @value={{this.formType}}
          @onSelect={{fn this.setFieldValue "formType"}}
          @options={{this.commissionTypeOptions}}
          @placeholder="Select type..."
          data-test-input-type
        />
      </Nuvo::Field>

      <Nuvo::Field
        @label="Gross Amount"
        @required={{true}}
        @tooltip="The full value of the deal before any deductions. The commission is worked out from this, so it is not the payout."
      >
        <Nuvo::Input
          id="commission-gross"
          type="number"
          placeholder="e.g. 50000"
          @value={{this.formGrossAmount}}
          @onInput={{fn this.setFieldValue "formGrossAmount"}}
          required={{true}}
          data-test-input-amount
        />
      </Nuvo::Field>

      <Nuvo::Field
        @label="Commission Rate %"
        @required={{true}}
        @tooltip="The share of the gross amount paid as commission. A rate of 2 on a gross of 100,000 pays 2,000."
      >
        <Nuvo::Input
          id="commission-rate"
          type="number"
          step="0.01"
          min="0"
          max="100"
          placeholder="e.g. 2.5"
          @value={{this.formCommissionRate}}
          @onInput={{fn this.setFieldValue "formCommissionRate"}}
          required={{true}}
          data-test-input-rate
        />
      </Nuvo::Field>

      <Nuvo::Field @label="Notes">
        <Nuvo::Textarea
          id="commission-notes"
          placeholder="Optional notes..."
          @value={{this.formNotes}}
          @onInput={{fn this.setFieldValue "formNotes"}}
          data-test-input-notes
        />
      </Nuvo::Field>
    </form>
  </:body>
  <:footer>
    <Nuvo::Button
      @variant="secondary"
      @onClick={{this.closeModal}}
    >Cancel</Nuvo::Button>
    <Nuvo::Button
      @variant="primary"
      @type="submit"
      form="commission-form"
      @loading={{this.isSaving}}
      data-test-save-commission
    >{{if this.isSaving "Saving..." "Create"}}</Nuvo::Button>
  </:footer>
</Nuvo::Drawer>

<ConfirmModal
  @open={{this.showCancelModal}}
  @title="Cancel Commission"
  @message="Cancel this commission? It stays in history as cancelled."
  @confirmText="Cancel commission"
  @confirmVariant="danger"
  @isConfirming={{this.isCancelling}}
  @confirmingText="Cancelling..."
  @onClose={{this.closeCancelModal}}
  @onConfirm={{this.confirmCancel}}
>
  <Nuvo::Field class="mt-4" @label="Reason" @required={{true}} @error={{this.reasonError}}>
    <Nuvo::Textarea
      id="commission-cancel-reason"
      rows="2"
      maxlength="500"
      placeholder="e.g. Deal fell through"
      @value={{this.cancelReason}}
      @onInput={{fn this.setFieldValue "cancelReason"}}
      @invalid={{if this.reasonError true false}}
      aria-label="Reason"
      data-test-reason-input
    />
  </Nuvo::Field>
</ConfirmModal>
