{{page-title "Commissions"}}

<div data-test-commissions-page class="flex col gap-6">
  <Woven::PageHeader @title="Commissions" @subtitle="Track agent commissions and payouts.">
    <:actions>
      <div class="flex gap-3 x-end">
        <Woven::Dropdown
          id="commissions-status-filter"
          @align="start"
          @value={{this.filterStatus}}
          @onSelect={{this.setStatusFilter}}
          @options={{this.filterStatusOptions}}
          @placeholder="All"
        />
        <Woven::Button
          @variant="primary"
          data-test-add-commission
          @icon="plus"
          {{on "click" this.openCreate}}
        >
          New Commission
        </Woven::Button>
      </div>
    </:actions>
  </Woven::PageHeader>

  <Woven::Card>
    {{#if this.filteredCommissions.length}}
      <Woven::DataTable
        @columns={{this.columns}}
        @rows={{this.filteredCommissions}}
        @pinColumns={{true}}
        @reorderable={{true}}
        @sortable={{true}}
        @showOptions={{true}}
        @tableId="commissions"
        data-test-commissions-table
        as |cell|
      >
        {{#if (eq cell.key "agentId")}}
          {{#let (this.agentName cell.value) as |name|}}
            {{#if name}}
              <span data-test-commission-row>{{name}}</span>
            {{else}}
              <span class="text-xs" data-test-commission-row>{{truncate-id
                  cell.value
                }}</span>
            {{/if}}
          {{/let}}
        {{else if (eq cell.key "leadId")}}
          <span class="text-xs">
            {{#if cell.row.leadId}}
              {{truncate-id cell.row.leadId}}
            {{else if cell.row.transactionId}}
              {{truncate-id cell.row.transactionId}}
            {{else}}
              <span class="text-muted">N/A</span>
            {{/if}}
          </span>
        {{else if (eq cell.key "type")}}
          <Woven::Tag
            class="tag-commtype-{{lowercase cell.value}}"
            @text={{cell.value}}
          />
        {{else if (eq cell.key "commissionAmount")}}
          <span><Money
              @amount={{cell.value}}
              @currency={{cell.row.currency}}
            />
            /
            <Money
              @amount={{cell.row.grossAmount}}
              @currency={{cell.row.currency}}
            /></span>
        {{else if (eq cell.key "commissionRate")}}
          {{cell.value}}%
        {{else if (eq cell.key "status")}}
          <Woven::Tag
            class="tag-commission-{{lowercase cell.value}}"
            @text={{cell.value}}
          />
        {{else if (eq cell.key "id")}}
          {{#if (eq cell.row.status "PENDING")}}
            <div class="flex">
              <Woven::Button
                @subtle={{true}}
                @variant="primary"
                @size="xs"
                data-test-approve-btn
                @icon="check"
                aria-label="Approve commission"
                data-tooltip="Approve"
                {{on "click" (fn this.approveCommission cell.row)}}
              />
              <Woven::Button
                @subtle={{true}}
                @variant="secondary"
                @size="xs"
                @icon="prohibit"
                aria-label="Cancel commission"
                data-tooltip="Cancel commission"
                data-test-cancel-commission
                {{on "click" (fn this.openCancel cell.row)}}
              />
            </div>
          {{else if (eq cell.row.status "APPROVED")}}
            <div class="flex">
              <Woven::Button
                @subtle={{true}}
                @variant="primary"
                @size="xs"
                data-test-pay-btn
                @icon="currency-dollar"
                aria-label="Mark commission paid"
                data-tooltip="Mark Paid"
                {{on "click" (fn this.payCommission cell.row)}}
              />
              <Woven::Button
                @subtle={{true}}
                @variant="secondary"
                @size="xs"
                @icon="prohibit"
                aria-label="Cancel commission"
                data-tooltip="Cancel commission"
                data-test-cancel-commission
                {{on "click" (fn this.openCancel cell.row)}}
              />
            </div>
          {{else if (eq cell.row.status "PAID")}}
            <span class="text-xs text-muted">
              {{#if cell.row.paidAt}}
                Paid
                {{format-date cell.row.paidAt zone="region"}}
              {{else}}
                Paid
              {{/if}}
            </span>
          {{/if}}
        {{else}}
          {{cell.value}}
        {{/if}}
      </Woven::DataTable>
    {{else}}
      {{#if @model.total}}
        <Woven::EmptyState
          @description="No commissions on this page with current filters. Navigate to find commissions or adjust filters."
        />
      {{else}}
        <Woven::EmptyState @description="No commissions found." />
      {{/if}}
    {{/if}}

    {{#if @model.total}}
      <Woven::Pagination
        @selectId="commissions-limit"
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{@model.total}}
        @onLimitChange={{this.setLimit}}
        @onPrevious={{this.goToPreviousPage}}
        @onNext={{this.goToNextPage}}
        @onPageChange={{this.goToPage}}
      />
    {{/if}}
  </Woven::Card>
</div>

<Commissions::CommissionDrawer
  @open={{this.showModal}}
  @agents={{this.model.agents}}
  @onClose={{this.closeModal}}
  @onSaved={{this.refresh}}
/>

<ConfirmModal
  @open={{this.showCancelModal}}
  @title="Cancel Commission"
  @message="Cancel this commission? It stays in history as cancelled."
  @confirmText="Cancel commission"
  @confirmVariant="danger"
  @isConfirming={{this.isCancelling}}
  @confirmingText="Cancelling..."
  @onClose={{this.closeCancelModal}}
  @onConfirm={{this.confirmCancel}}
>
  <Woven::Field class="mt-4" @label="Reason" @required={{true}} @error={{this.reasonError}}>
    <Woven::Textarea
      id="commission-cancel-reason"
      rows="2"
      maxlength="500"
      placeholder="e.g. Deal fell through"
      @value={{this.cancelReason}}
      @onInput={{fn this.setFieldValue "cancelReason"}}
      @invalid={{if this.reasonError true false}}
      aria-label="Reason"
      data-test-reason-input
    />
  </Woven::Field>
</ConfirmModal>
