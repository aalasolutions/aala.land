{{page-title "Commissions"}}

<div data-test-commissions-page class="flex col gap-6">
  <Nuvo::PageHeader @title="Commissions">
    <:meta>
      <p class="text-muted">Track agent commissions and payouts.</p>
    </:meta>
    <:actions>
      <div class="flex gap-3 x-end">
        <Nuvo::Dropdown
          id="commissions-status-filter"
          @align="start"
          @value={{this.filterStatus}}
          @onSelect={{this.setStatusFilter}}
          @options={{this.filterStatusOptions}}
          @placeholder="All"
        />
        <Nuvo::Button
          @variant="primary"
          data-test-add-commission
          {{on "click" this.openCreate}}
        >
          <Ui::Ph @icon="plus" />
          New Commission
        </Nuvo::Button>
      </div>
    </:actions>
  </Nuvo::PageHeader>

  <Nuvo::Card>
    {{#if this.filteredCommissions.length}}
      <div class="nu-table-wrapper">
        <table class="nu-table" data-test-commissions-table>
          <thead>
            <tr>
              <th>Agent</th>
              <th>Deal ID</th>
              <th>Type</th>
              <th>Amount</th>
              <th>Rate</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each this.filteredCommissions as |comm|}}
              <tr data-test-commission-row>
                <td class="text-xs">{{truncate-id comm.agentId}}</td>
                <td class="text-xs">
                  {{#if comm.leadId}}
                    {{truncate-id comm.leadId}}
                  {{else if comm.transactionId}}
                    {{truncate-id comm.transactionId}}
                  {{else}}
                    <span class="text-muted">N/A</span>
                  {{/if}}
                </td>
                <td>
                  <Nuvo::Tag
                    class="badge-commtype-{{lowercase comm.type}}"
                    @text={{comm.type}}
                  />
                </td>
                <td class="font-bold">{{format-currency comm.commissionAmount}}
                  /
                  {{format-currency comm.grossAmount}}</td>
                <td>{{comm.commissionRate}}%</td>
                <td>
                  <Nuvo::Tag
                    class="badge-commission-{{lowercase comm.status}}"
                    @text={{comm.status}}
                  />
                </td>
                <td>
                  {{#if (eq comm.status "PENDING")}}
                    <Nuvo::Button
                      @variant="primary"
                      @size="xs"
                      data-test-approve-btn
                      {{on "click" (fn this.approveCommission comm)}}
                    >
                      <Ui::Ph @icon="check" />
                      Approve
                    </Nuvo::Button>
                  {{else if (eq comm.status "APPROVED")}}
                    <Nuvo::Button
                      @variant="primary"
                      @size="xs"
                      data-test-pay-btn
                      {{on "click" (fn this.payCommission comm)}}
                    >
                      <Ui::Ph @icon="currency-dollar" />
                      Mark Paid
                    </Nuvo::Button>
                  {{else if (eq comm.status "PAID")}}
                    <span class="text-xs text-muted">
                      {{#if comm.paidAt}}
                        Paid
                        {{format-date comm.paidAt}}
                      {{else}}
                        Paid
                      {{/if}}
                    </span>
                  {{/if}}
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      {{#if @model.total}}
        <p class="text-muted text-center py-8">No commissions on this page
          with current filters. Navigate to find commissions or adjust
          filters.</p>
      {{else}}
        <div class="text-center py-8">
          <Ui::Ph
            @icon="hand-coins"
            @size="32px"
            @color="var(--text-muted)"
          />
          <p class="text-muted mt-2">No commissions found.</p>
        </div>
      {{/if}}
    {{/if}}

    {{#if @model.total}}
      <Nuvo::Pagination
        @selectId="commissions-limit"
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{@model.total}}
        @onLimitChange={{this.setLimit}}
        @onPrevious={{this.goToPreviousPage}}
        @onNext={{this.goToNextPage}}
      />
    {{/if}}
  </Nuvo::Card>
</div>

<Nuvo::Modal
  @open={{this.showModal}}
  @title="New Commission"
  @onClose={{this.closeModal}}
>
  {{#if this.errorMsg}}
    <p class="text-danger" data-test-error>{{this.errorMsg}}</p>
  {{/if}}
  <form class="flex col gap-4" {{on "submit" this.saveCommission}}>
    <Nuvo::Field @label="Agent" @required={{true}}>
      <Nuvo::Dropdown
        id="commission-agent"
        @align="start"
        @value={{this.formAgentId}}
        @onSelect={{fn this.setFieldValue "formAgentId"}}
        @options={{this.agentOptions}}
        @placeholder="Select agent..."
        data-test-input-agent
      />
    </Nuvo::Field>

    <Nuvo::Field @label="Type" @required={{true}}>
      <Nuvo::Dropdown
        id="commission-type"
        @align="start"
        @value={{this.formType}}
        @onSelect={{fn this.setFieldValue "formType"}}
        @options={{this.commissionTypeOptions}}
        @placeholder="Select type..."
        data-test-input-type
      />
    </Nuvo::Field>

    <Nuvo::Field @label="Gross Amount" @required={{true}}>
      <Nuvo::Input
        id="commission-gross"
        type="number"
        placeholder="e.g. 50000"
        @value={{this.formGrossAmount}}
        @onInput={{fn this.setFieldValue "formGrossAmount"}}
        required={{true}}
        data-test-input-amount
      />
    </Nuvo::Field>

    <Nuvo::Field @label="Commission Rate %" @required={{true}}>
      <Nuvo::Input
        id="commission-rate"
        type="number"
        step="0.01"
        min="0"
        max="100"
        placeholder="e.g. 2.5"
        @value={{this.formCommissionRate}}
        @onInput={{fn this.setFieldValue "formCommissionRate"}}
        required={{true}}
        data-test-input-rate
      />
    </Nuvo::Field>

    <Nuvo::Field @label="Notes">
      <Nuvo::Textarea
        id="commission-notes"
        placeholder="Optional notes..."
        @value={{this.formNotes}}
        @onInput={{fn this.setFieldValue "formNotes"}}
        data-test-input-notes
      />
    </Nuvo::Field>

    <Nuvo::FormActions @align="end">
      <Nuvo::Button
        @variant="secondary"
        @onClick={{this.closeModal}}
      >Cancel</Nuvo::Button>
      <Nuvo::Button
        @variant="primary"
        @type="submit"
        @loading={{this.isSaving}}
        data-test-save-commission
      >{{if this.isSaving "Saving..." "Create"}}</Nuvo::Button>
    </Nuvo::FormActions>
  </form>
</Nuvo::Modal>
