<Woven::Drawer
  @open={{@open}}
  @title={{if this.isEdit "Edit Template" "New Template"}}
  @placement="end"
  @size="lg"
  @onClose={{this.close}}
  @onClosed={{this.reset}}
>
  <:body>
    <form
      id="email-template-form"
      class="wu-form"
      novalidate
      {{on "submit" this.save}}
    >
      <div class="flex gap-4">
        <Woven::Field
          class="grow"
          @label="Template Name"
          @required={{true}}
          @error={{this.fieldErrors.formName}}
        >
          <Woven::Input
            id="t-name"
            type="text"
            placeholder="Welcome New Tenant"
            @value={{this.form.formName}}
            @onInput={{fn this.setField "formName"}}
            data-test-input-name
          />
        </Woven::Field>
        <Woven::Field class="grow" @label="Category">
          <Woven::Dropdown
            id="t-category"
            @align="start"
            @value={{this.form.formCategory}}
            @onSelect={{fn this.setField "formCategory"}}
            @options={{this.categories}}
            @placeholder="Select category..."
            data-test-input-category
          />
        </Woven::Field>
      </div>

      <Woven::Field
        @label="Subject"
        @required={{true}}
        @error={{this.fieldErrors.formSubject}}
      >
        <Woven::Input
          id="t-subject"
          type="text"
          placeholder="Welcome to your new home!"
          @value={{this.form.formSubject}}
          @onInput={{fn this.setField "formSubject"}}
          data-test-input-subject
        />
      </Woven::Field>

      <Woven::Field
        @label="Body (HTML)"
        @required={{true}}
        @error={{this.fieldErrors.formBody}}
      >
        <Woven::Textarea
          id="t-body"
          placeholder="Use curly braces for variables, e.g. first name"
          rows="8"
          @value={{this.form.formBody}}
          @onInput={{fn this.setField "formBody"}}
          data-test-input-body
        />
      </Woven::Field>

      <Woven::Field
        @label="Variables (comma-separated)"
        @hint="Use double curly braces in subject/body to reference variables."
      >
        <Woven::Input
          id="t-vars"
          type="text"
          placeholder="firstName, lastName, propertyName"
          @value={{this.form.formVariables}}
          @onInput={{fn this.setField "formVariables"}}
          data-test-input-variables
        />
      </Woven::Field>

      <Woven::Checkbox
        @checked={{this.form.formIsActive}}
        @label="Active"
        @onChange={{fn this.setField "formIsActive"}}
        data-test-input-active
      />

      {{#if this.errorMsg}}
        <p class="text-sm text-danger" data-test-error>{{this.errorMsg}}</p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Woven::Button
      @variant="secondary"
      @onClick={{this.close}}
      data-test-cancel-template-form
    >Cancel</Woven::Button>
    <Woven::Button
      @variant="primary"
      @type="submit"
      form="email-template-form"
      @loading={{this.isSaving}}
      data-test-save-template
    >{{this.submitLabel}}</Woven::Button>
  </:footer>
</Woven::Drawer>