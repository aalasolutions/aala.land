<form
  data-test-signup-form
  class="nu-form w-full"
  novalidate
  {{on "submit" this.submit}}
>
  <div class="nu-form">
    <Nuvo::Field
      @label="Company Name"
      @required={{true}}
      @error={{this.fieldErrors.companyName}}
    >
      <Nuvo::Input
        id="signup-company"
        @type="text"
        @placeholder="Acme Real Estate"
        @value={{this.companyName}}
        @onInput={{fn this.updateField "companyName"}}
        required={{true}}
        data-test-company-name
      />
    </Nuvo::Field>

    <div class="flex col gap-1 signup-slug-field">
      <Nuvo::Field
        @label="Company URL Slug"
        @required={{true}}
        @error={{this.fieldErrors.companySlug}}
      >
        <Nuvo::Input
          id="signup-slug"
          @type="text"
          @placeholder="acme-real-estate"
          @value={{this.companySlug}}
          @onInput={{fn this.updateField "companySlug"}}
          required={{true}}
          data-test-company-slug
        />
      </Nuvo::Field>
      <p class="text-muted px-1 text-xs">Lowercase, numbers, and hyphens only.</p>
    </div>
  </div>

  <Nuvo::Field
    @label="Primary Operating Region"
    @error={{this.fieldErrors.region}}
  >
    <Nuvo::Dropdown
      @searchable={{true}}
      @align="start"
      @value={{this.selectedRegion}}
      @options={{this.regionOptions}}
      @onSelect={{this.selectRegion}}
      @placeholder="Select your region..."
      data-test-region-select
    />
  </Nuvo::Field>

  <Nuvo::Divider />

  <div class="grid cols-2 gap-4">
    <Nuvo::Field
      @label="Your Name"
      @required={{true}}
      @error={{this.fieldErrors.userName}}
    >
      <Nuvo::Input
        id="signup-name"
        @type="text"
        @placeholder="Jane Smith"
        @value={{this.userName}}
        @onInput={{fn this.updateField "userName"}}
        required={{true}}
        data-test-user-name
      />
    </Nuvo::Field>

    <Nuvo::Field
      @label="Email Address"
      @required={{true}}
      @error={{this.fieldErrors.email}}
    >
      <Nuvo::Input
        id="signup-email"
        @type="email"
        @placeholder="jane@company.com"
        @value={{this.email}}
        @autocomplete="email"
        @onInput={{fn this.updateField "email"}}
        required={{true}}
        data-test-email-input
      />
    </Nuvo::Field>
  </div>

  <div class="grid cols-2 gap-4">
    <Nuvo::Field
      @label="Password"
      @required={{true}}
      @error={{this.fieldErrors.password}}
    >
      <Nuvo::Input
        id="signup-password"
        @type="password"
        @placeholder="Min 8 characters"
        @value={{this.password}}
        @autocomplete="new-password"
        @onInput={{fn this.updateField "password"}}
        required={{true}}
        data-test-password-input
      />
    </Nuvo::Field>
    <Nuvo::Field
      @label="Confirm Password"
      @required={{true}}
      @error={{this.fieldErrors.confirmPassword}}
    >
      <Nuvo::Input
        id="signup-confirm"
        @type="password"
        @placeholder="••••••••"
        @value={{this.confirmPassword}}
        @autocomplete="new-password"
        @onInput={{fn this.updateField "confirmPassword"}}
        required={{true}}
        data-test-confirm-password
      />
    </Nuvo::Field>
  </div>

  {{#if this.errorMessage}}
    <Nuvo::Alert @variant="danger" @description={{this.errorMessage}} />
  {{/if}}

  <Nuvo::Button
    @variant="primary"
    @type="submit"
    @loading={{this.isLoading}}
    @disabled={{not this.canSubmit}}
    data-test-submit-button
  >
    {{if this.isLoading "Creating Account..." "Create Workspace with Email"}}
  </Nuvo::Button>

  {{#if this.googleAuth.isConfigured}}
    <Nuvo::Divider @label="OR" />

    {{#if this.canGoogleSignup}}
      <div
        class="google-signin-section
          {{unless this.isGoogleLoading 'auth-google-button'}}"
      >
        {{#if this.isGoogleLoading}}
          <button
            type="button"
            class="btn--google btn--google--loading"
            disabled
          >
            <span class="google-spinner"></span>
          </button>
        {{else}}
          <div
            id="google-signup-button"
            class="google-button-host"
            {{did-insert this.renderGoogleButton}}
          ></div>
        {{/if}}
      </div>
    {{else}}
      <button
        type="button"
        class="auth-google-button auth-google-button--blocked"
        aria-label="Continue with Google"
        {{on "click" this.showGoogleSignupRequirements}}
        data-test-google-signup-disabled
      ></button>
    {{/if}}
  {{/if}}
</form>