<form
  data-test-signup-form
  class="wu-form w-full"
  novalidate
  {{on "submit" this.submit}}
>
  <div class="grid cols-2 gap-4">
    <Woven::Field
      @label="Your Name"
      @required={{true}}
      @error={{this.fieldErrors.userName}}
    >
      <Woven::Input
        id="signup-name"
        @type="text"
        @placeholder="Jane Smith"
        @value={{this.userName}}
        @onInput={{fn this.updateField "userName"}}
        required={{true}}
        data-test-user-name
      />
    </Woven::Field>

    <Woven::Field
      @label="Email Address"
      @required={{true}}
      @error={{this.fieldErrors.email}}
    >
      <Woven::Input
        id="signup-email"
        @type="email"
        @placeholder="jane@company.com"
        @value={{this.email}}
        @autocomplete="email"
        @onInput={{fn this.updateField "email"}}
        required={{true}}
        data-test-email-input
      />
    </Woven::Field>
  </div>

  <div class="grid cols-2 gap-4">
    <Woven::Field
      @label="Password"
      @required={{true}}
      @error={{this.fieldErrors.password}}
    >
      <Woven::Input
        id="signup-password"
        @type="password"
        @placeholder="Min 8 characters"
        @value={{this.password}}
        @autocomplete="new-password"
        @onInput={{fn this.updateField "password"}}
        required={{true}}
        data-test-password-input
      />
    </Woven::Field>
    <Woven::Field
      @label="Confirm Password"
      @required={{true}}
      @error={{this.fieldErrors.confirmPassword}}
    >
      <Woven::Input
        id="signup-confirm"
        @type="password"
        @placeholder="••••••••"
        @value={{this.confirmPassword}}
        @autocomplete="new-password"
        @onInput={{fn this.updateField "confirmPassword"}}
        required={{true}}
        data-test-confirm-password
      />
    </Woven::Field>
  </div>

  {{#if this.errorMessage}}
    <Woven::Alert @variant="danger" @description={{this.errorMessage}} />
  {{/if}}

  <Woven::Button
    @variant="primary"
    @type="submit"
    @loading={{this.isLoading}}
    @disabled={{not this.canSubmit}}
    data-test-submit-button
  >
    {{if this.isLoading "Creating Account..." "Create Workspace with Email"}}
  </Woven::Button>

  {{#if this.googleAuth.isConfigured}}
    <Woven::Divider @label="OR" />

    <div
      class="google-signin-section
        {{unless this.isGoogleLoading 'auth-google-button'}}"
    >
      {{#if this.isGoogleLoading}}
        <button type="button" class="btn--google btn--google--loading" disabled>
          <span class="google-spinner"></span>
        </button>
      {{else}}
        <div
          id="google-signup-button"
          class="google-button-host"
          {{did-insert this.renderGoogleButton}}
        ></div>
      {{/if}}
    </div>
  {{/if}}
</form>