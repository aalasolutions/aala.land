<form
  data-test-signup-form
  class="flex col gap-4 w-full"
  {{on "submit" this.submit}}
>
  <div class="grid col gap-4">
    <Nuvo::Field @label="Company Name" @required={{true}}>
      <Nuvo::Input
        id="signup-company"
        @type="text"
        @placeholder="Acme Real Estate"
        @value={{this.companyName}}
        @onInput={{fn this.updateField "companyName"}}
        required={{true}}
        data-test-company-name
      />
    </Nuvo::Field>

    <div class="flex col gap-1 signup-slug-field">
      <Nuvo::Field @label="Company URL Slug" @required={{true}}>
        <Nuvo::Input
          id="signup-slug"
          @type="text"
          @placeholder="acme-real-estate"
          @value={{this.companySlug}}
          @onInput={{fn this.updateField "companySlug"}}
          required={{true}}
          data-test-company-slug
        />
      </Nuvo::Field>
      <p class="text-muted px-1 text-xs">Lowercase, numbers, and hyphens only.</p>
    </div>
  </div>

  <Nuvo::Field @label="Primary Operating Region">
    <Nuvo::Dropdown
      @searchable={{true}}
      @align="start"
      @value={{this.selectedRegion}}
      @options={{this.regionOptions}}
      @onSelect={{this.selectRegion}}
      @placeholder="Select your region..."
      data-test-region-select
    />
  </Nuvo::Field>

  <hr class="border-white@10 my-1" />

  <div class="grid cols-2 gap-4">
    <Nuvo::Field @label="Your Name" @required={{true}}>
      <Nuvo::Input
        id="signup-name"
        @type="text"
        @placeholder="Jane Smith"
        @value={{this.userName}}
        @onInput={{fn this.updateField "userName"}}
        required={{true}}
        data-test-user-name
      />
    </Nuvo::Field>

    <Nuvo::Field @label="Email Address" @required={{true}}>
      <Nuvo::Input
        id="signup-email"
        @type="email"
        @placeholder="jane@company.com"
        @value={{this.email}}
        @autocomplete="email"
        @onInput={{fn this.updateField "email"}}
        required={{true}}
        data-test-email-input
      />
    </Nuvo::Field>
  </div>

  <div class="grid cols-2 gap-4">
    <Nuvo::Field @label="Password" @required={{true}}>
      <Nuvo::Input
        id="signup-password"
        @type="password"
        @placeholder="Min 8 characters"
        @value={{this.password}}
        @autocomplete="new-password"
        @onInput={{fn this.updateField "password"}}
        required={{true}}
        data-test-password-input
      />
    </Nuvo::Field>
    <Nuvo::Field @label="Confirm Password" @required={{true}}>
      <Nuvo::Input
        id="signup-confirm"
        @type="password"
        @placeholder="••••••••"
        @value={{this.confirmPassword}}
        @autocomplete="new-password"
        @onInput={{fn this.updateField "confirmPassword"}}
        required={{true}}
        data-test-confirm-password
      />
    </Nuvo::Field>
  </div>

  {{#if this.errorMessage}}
    <div
      class="p-3 rounded-lg bg-danger@10 border border-danger@20 text-danger text-center text-sm"
    >
      {{this.errorMessage}}
    </div>
  {{/if}}

  <button
    data-test-submit-button
    type="submit"
    class="btn btn-primary btn-lg w-full py-4 rounded-xl font-bold mt-2"
    disabled={{or this.isLoading (not this.canSubmit)}}
  >
    {{#if this.isLoading}}
      <span class="flex x-center center gap-2">
        <Ui::Ph @icon="circle-notch" class="animate-spin" />
        Creating Account...
      </span>
    {{else}}
      Create Workspace with Email
    {{/if}}
  </button>

  {{#if this.googleAuth.isConfigured}}
    <div class="divider">
      <span class="text-muted text-sm">OR</span>
    </div>

    {{#if this.canGoogleSignup}}
      <div
        class="google-signin-section
          {{unless this.isGoogleLoading 'auth-google-button'}}"
      >
        {{#if this.isGoogleLoading}}
          <button
            type="button"
            class="btn btn--google btn--google--loading"
            disabled
          >
            <span class="google-spinner"></span>
          </button>
        {{else}}
          <div
            id="google-signup-button"
            class="google-button-host"
            {{did-insert this.renderGoogleButton}}
          ></div>
        {{/if}}
      </div>
    {{else}}
      <button
        type="button"
        class="auth-google-button auth-google-button--blocked"
        aria-label="Continue with Google"
        {{on "click" this.showGoogleSignupRequirements}}
        data-test-google-signup-disabled
      ></button>
    {{/if}}
  {{/if}}
</form>