<dl class={{this.classes}} data-test-nu-desc-list ...attributes>
  {{#if (has-block)}}
    {{yield}}
  {{else}}
    {{#each this.normalizedItems as |entry|}}
      <div class="nu-desc-list__group" data-test-nu-desc-list-group>
        <dt class="nu-desc-list__term" data-test-nu-desc-list-term>{{entry.term}}</dt>
        <dd class="nu-desc-list__description" data-test-nu-desc-list-description>{{entry.description}}</dd>
      </div>
    {{/each}}
  {{/if}}
</dl>
