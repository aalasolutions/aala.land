{{!
  @route renders a LinkTo, @href an anchor, otherwise a button.
  All three share their innards from button-inner.
}}
{{#if @route}}
  <LinkTo
    @route={{@route}}
    @models={{this.linkModels}}
    @query={{this.linkQuery}}
    class={{this.classes}}
    data-test-nu-button
    ...attributes
  >
    <Nuvo::ButtonInner
      @btn={{this}}
      @hasBlock={{has-block}}
      @text={{@text}}
    >{{yield}}</Nuvo::ButtonInner>
  </LinkTo>
{{else if @href}}
  <a href={{@href}} class={{this.classes}} ...attributes>
    <Nuvo::ButtonInner
      @btn={{this}}
      @hasBlock={{has-block}}
      @text={{@text}}
    >{{yield}}</Nuvo::ButtonInner>
  </a>
{{else}}
  <button
    type={{this.type}}
    class={{this.classes}}
    disabled={{this.isDisabled}}
    data-test-nu-button
    {{on "click" this.onClick}}
    ...attributes
  >
    <Nuvo::ButtonInner
      @btn={{this}}
      @hasBlock={{has-block}}
      @text={{@text}}
    >{{yield}}</Nuvo::ButtonInner>
  </button>
{{/if}}
