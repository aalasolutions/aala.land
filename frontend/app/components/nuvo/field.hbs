<div
  class={{this.classes}}
  data-test-nu-field
  {{this.linkControl}}
  ...attributes
>
  {{#if @label}}
    {{! The tooltip button sits OUTSIDE the label: anything inside a label is
    read as part of the control's own name. }}
    <span class="nu-field__label-row">
      <label class="nu-field__label" id={{this.labelId}} data-test-nu-field-label>
        {{@label}}
        {{#if @required}}
          <span
            class="nu-field__required"
            aria-hidden="true"
            data-test-nu-field-required
          >*</span>
        {{/if}}
      </label>
      {{#if @tooltip}}
        <button
          type="button"
          class="nu-field__info"
          aria-label="More information about {{@label}}"
          data-tooltip={{@tooltip}}
          data-tooltip-position={{if @tooltipPosition @tooltipPosition "top"}}
          data-test-nu-field-tooltip
        >
          <Ui::Ph @icon="question" />
        </button>
      {{/if}}
    </span>
  {{/if}}

  {{yield}}

  {{#if this.showError}}
    <span class="nu-field__error" data-test-nu-field-error>{{@error}}</span>
  {{else if this.showHint}}
    <span class="nu-field__hint" data-test-nu-field-hint>{{@hint}}</span>
  {{/if}}
</div>