<aside class={{this.classes}} data-test-nu-sidebar ...attributes>
  {{#if (has-block "brand")}}
    <div class="nu-sidebar__brand">{{yield to="brand"}}</div>
  {{else if @brandTitle}}
    <div class="nu-sidebar__brand">
      <div class="nu-sidebar__brand-title">{{@brandTitle}}</div>
      {{#if @brandSubtitle}}
        <div class="nu-sidebar__brand-subtitle">{{@brandSubtitle}}</div>
      {{/if}}
    </div>
  {{/if}}

  <nav class="nu-sidebar__nav">
    {{yield}}
  </nav>

  {{#if (has-block "footer")}}
    <div class="nu-sidebar__footer">{{yield to="footer"}}</div>
  {{/if}}
</aside>

{{#if @dismissible}}
  <div
    class={{this.backdropClasses}}
    data-test-nu-sidebar-backdrop
    {{on "click" this.dismiss}}
  ></div>
{{/if}}
