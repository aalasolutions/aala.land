<section class="record-sheet" data-test-lease-summary ...attributes>
  <div class="record-sheet__top">
    <p
      class="record-sheet__statement"
      data-test-lease-next-step
    >{{this.nextStep}}</p>
    {{#if this.countdown}}
      <span
        class="record-sheet__pill"
        data-test-lease-countdown
      >{{this.countdown}}</span>
    {{/if}}
  </div>

  <div class="record-sheet__trio">
    <div class="record-sheet__cell">
      <span class="record-sheet__label"><Ui::Ph @icon="user" /> Tenant</span>
      <span class="record-sheet__value" data-test-lease-tenant>
        {{#if this.tenantId}}
          <LinkTo
            @route="contacts.detail"
            @model={{this.tenantId}}
            class="text-primary"
            data-test-lease-tenant-link
          >{{this.tenantName}}</LinkTo>
        {{else}}
          {{this.tenantName}}
        {{/if}}
      </span>
      {{#if (contact-phone @lease.contact)}}
        <span class="record-sheet__sub" data-test-lease-tenant-phone><bdi
            dir="ltr"
          >{{contact-phone @lease.contact}}</bdi></span>
      {{/if}}
      {{#if (contact-email @lease.contact)}}
        <span
          class="record-sheet__sub"
          data-test-lease-tenant-email
        >{{contact-email @lease.contact}}</span>
      {{/if}}
      {{#if @lease.contact.nationality}}
        <span
          class="record-sheet__sub"
          data-test-lease-tenant-nationality
        >{{@lease.contact.nationality}}</span>
      {{/if}}
    </div>
    <div class="record-sheet__cell">
      <span class="record-sheet__label"><Ui::Ph @icon="house-line" />
        Home</span>
      <span class="record-sheet__value" data-test-lease-unit>
        {{#if @unit.areaId}}
          <LinkTo
            @route="properties.unit"
            @models={{array @unit.areaId @unit.id}}
            class="text-primary"
            data-test-lease-unit-link
          >{{@unit.label}}</LinkTo>
        {{else}}
          {{or @unit.label "-"}}
        {{/if}}
      </span>
      <span
        class="record-sheet__sub"
        data-test-lease-type
      >{{this.typeLabel}}</span>
    </div>
    <div class="record-sheet__cell">
      <span class="record-sheet__label"><Ui::Ph @icon="coins" /> Rent</span>
      <span class="record-sheet__amount" data-test-lease-rent>{{or
          (format-money @lease.monthlyRent currency=@lease.currency)
          "-"
        }}</span>
      <span class="record-sheet__sub">a month · deposit
        <span data-test-lease-deposit>{{or
            (format-money @lease.securityDeposit currency=@lease.currency)
            "-"
          }}</span></span>
    </div>
  </div>

  <div class="record-sheet__ribbon" data-test-lease-term>
    <span data-test-lease-start>{{format-date @lease.startDate}}</span>
    <Nuvo::Progress
      @value={{this.percent}}
      @size="sm"
      @variant={{this.urgency}}
      data-test-lease-progress
    />
    <span data-test-lease-end>{{format-date @lease.endDate}}</span>
  </div>

  <div class="record-sheet__foot">
    <span>Term <b data-test-lease-length>{{or this.length "-"}}</b></span>
    <span>Cheques
      <b data-test-lease-cheques>{{if
          (has-value @lease.numberOfCheques)
          @lease.numberOfCheques
          "-"
        }}</b>{{#if this.chequeAmount}}
        of
        {{format-money
          this.chequeAmount
          currency=@lease.currency
        }}{{/if}}</span>
    <span>Registration
      <b data-test-lease-registration>{{or
          @lease.tenancyRegistrationRef
          "-"
        }}</b></span>
    <span>Region
      <b data-test-lease-region>{{or
          (region-name @lease.regionCode)
          "-"
        }}</b></span>
    <span>Currency
      <b data-test-lease-currency>{{or @lease.currency "-"}}</b></span>
    <p class="record-sheet__notes">Notes
      <b data-test-lease-notes>{{or @lease.notes "-"}}</b></p>
  </div>
</section>