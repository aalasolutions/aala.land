{{#if this.rows.length}}
  <Woven::Panel data-test-record-summary={{@type}} ...attributes>
    {{#if this.isLimited}}
      <Woven::Tag
        @variant="secondary"
        @text="Limited"
        data-test-record-summary-limited
      />
    {{/if}}
    <Woven::DescList
      @items={{this.rows}}
      @horizontal={{true}}
      @compact={{true}}
    />
  </Woven::Panel>
{{/if}}
