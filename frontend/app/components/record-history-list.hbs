<div
  class="flex col gap-3"
  data-test-record-history
  {{this.reloadOn @reloadKey @entityType @entityId}}
>
  {{#if this.isLoading}}
    <div
      class="flex x-center gap-2 text-sm text-muted"
      role="status"
      data-test-record-history-loading
    >
      <Nuvo::Spinner @size="sm" />
      <span>Loading history...</span>
    </div>
  {{else if this.errorMessage}}
    <Nuvo::Alert
      @variant="danger"
      @description={{this.errorMessage}}
      data-test-record-history-error
    />
  {{else if this.rows.length}}
    <Nuvo::DataTable
      @columns={{this.columns}}
      @rows={{this.rows}}
      @pinColumns={{true}}
      @reorderable={{true}}
      @sortable={{true}}
      @showOptions={{true}}
      @tableId="record-history"
      data-test-record-history-table
      as |cell|
    >
      {{#if (eq cell.key "actionLabel")}}
        <Nuvo::Tag
          @variant={{cell.row.actionVariant}}
          @text={{cell.value}}
          data-test-record-history-action
        />
      {{else if (eq cell.key "entityTitle")}}
        <div class="flex col gap-1">
          <span
            class="font-bold"
            data-test-record-history-title
          >{{cell.value}}</span>
          {{#if cell.row.contextTitle}}
            <span
              class="text-xs text-muted"
              data-test-record-history-context
            >{{cell.row.contextTitle}}</span>
          {{/if}}
        </div>
      {{else if (eq cell.key "reason")}}
        <span class="text-sm" data-test-record-history-reason>{{if
            cell.value
            cell.value
            "-"
          }}</span>
      {{else if (eq cell.key "actorName")}}
        <span
          class="text-sm text-muted"
          data-test-record-history-actor
        >{{cell.value}}</span>
      {{else if (eq cell.key "createdAt")}}
        <span class="text-sm text-muted" data-test-record-history-date>{{format-date-time
            cell.value
            region=cell.row.regionCode
          }}</span>
      {{else}}
        {{cell.value}}
      {{/if}}
    </Nuvo::DataTable>

    {{#if this.hasPages}}
      <Nuvo::Pagination
        @page={{this.page}}
        @limit={{this.limit}}
        @total={{this.total}}
        @onPageChange={{this.goToPage}}
        data-test-record-history-pagination
      />
    {{/if}}
  {{else}}
    <Nuvo::EmptyState
      @size="sm"
      @title="No history yet"
      data-test-record-history-empty
    />
  {{/if}}
</div>