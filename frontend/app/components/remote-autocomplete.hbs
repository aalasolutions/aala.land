<Nuvo::Autocomplete
  @labelKey={{@labelKey}}
  @size={{@size}}
  @disabled={{@disabled}}
  @placeholder={{@placeholder}}
  @promptText={{@promptText}}
  @emptyText={{@emptyText}}
  @searchDebounce={{@searchDebounce}}
  @minChars={{@minChars}}
  @selectedName={{@selectedName}}
  @value={{@value}}
  @options={{this.options}}
  @filter={{if @listUrl this.filter}}
  @onSearch={{this.search}}
  @onCreate={{if @createUrl this.create}}
  @onSelect={{@onSelect}}
  @onClear={{@onClear}}
  data-test-remote-autocomplete
  {{this.loadList @listUrl}}
  ...attributes
/>
