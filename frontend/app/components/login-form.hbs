{{#if this.showForgotPassword}}
  {{#if this.resetSent}}
    <div data-test-reset-success class="flex col gap-5 w-full text-center">
      <div class="flex col gap-2">
        <Ui::Ph @icon="check-circle" @size="48px" />
        <p class="text-sm text-muted">
          If an account exists with that email, you will receive a password
          reset link.
        </p>
      </div>
      <Nuvo::Button
        @variant="link"
        data-test-back-to-login
        {{on "click" this.toggleForgotPassword}}
      >
        Sign in
      </Nuvo::Button>
    </div>
  {{else}}
    <form
      data-test-forgot-password-form
      class="flex col gap-5 w-full"
      {{on "submit" this.submitForgotPassword}}
    >
      <Nuvo::Field @label="Email" @required={{true}}>
        <Nuvo::Input
          id="reset-email"
          type="email"
          placeholder="you@company.com"
          @value={{this.resetEmail}}
          autocomplete="email"
          required={{true}}
          @onInput={{fn this.setFieldValue "resetEmail"}}
          data-test-reset-email-input
        />
      </Nuvo::Field>

      {{#if this.resetError}}
        <Nuvo::Alert
          @variant="danger"
          @description={{this.resetError}}
          data-test-reset-error
        />
      {{/if}}

      <Nuvo::Button
        @variant="primary"
        @type="submit"
        @loading={{this.resetLoading}}
        data-test-reset-submit
      >
        {{if this.resetLoading "Sending..." "Send Reset Link"}}
      </Nuvo::Button>

      <div class="text-center text-muted">
        <Nuvo::Button
          @variant="link"
          data-test-back-to-login
          {{on "click" this.toggleForgotPassword}}
        >
          Back to Sign In
        </Nuvo::Button>
      </div>
    </form>
  {{/if}}
{{else}}
  <form
    data-test-login-form
    class="flex col gap-5 w-full"
    {{on "submit" this.submit}}
  >
    <Nuvo::Field @label="Email" @required={{true}}>
      <Nuvo::Input
        id="login-email"
        type="email"
        placeholder="you@company.com"
        @value={{this.email}}
        autocomplete="email"
        required={{true}}
        @onInput={{fn this.setFieldValue "email"}}
        data-test-email-input
      />
    </Nuvo::Field>

    <Nuvo::Field @label="Password" @required={{true}}>
      <Nuvo::Input
        id="login-password"
        type="password"
        placeholder="••••••••"
        @value={{this.password}}
        autocomplete="current-password"
        required={{true}}
        @onInput={{fn this.setFieldValue "password"}}
        data-test-password-input
      />
    </Nuvo::Field>

    {{#if this.errorMessage}}
      <Nuvo::Alert
        @variant="danger"
        @description={{this.errorMessage}}
        data-test-error-message
      />
    {{/if}}

    <Nuvo::Button
      @variant="primary"
      @type="submit"
      @loading={{this.isLoading}}
      data-test-submit-button
    >
      {{if this.isLoading "Signing in..." "Sign In"}}
    </Nuvo::Button>

    <div class="text-center">
      <Nuvo::Button
        @variant="link"
        data-test-forgot-password-link
        {{on "click" this.toggleForgotPassword}}
      >
        Forgot Password?
      </Nuvo::Button>
    </div>

    {{#if this.googleAuth.isConfigured}}
      <Nuvo::Divider @label="OR" />

      <div
        class="google-signin-section
          {{unless this.isGoogleLoading 'auth-google-button'}}"
      >
        {{#if this.isGoogleLoading}}
          <button
            type="button"
            class="btn--google btn--google--loading"
            disabled
          >
            <span class="google-spinner"></span>
          </button>
        {{else}}
          <div
            id="google-signin-button"
            class="google-button-host"
            {{did-insert this.renderGoogleButton}}
          ></div>
        {{/if}}
      </div>
    {{/if}}
  </form>
{{/if}}