<Nuvo::Modal
  @open={{@open}}
  @title={{@title}}
  @size="sm"
  @onClose={{this.close}}
>
  <:body>
    {{#if @message}}
      <p class="text-muted">{{@message}}</p>
    {{/if}}
    {{yield}}
  </:body>

  <:footer>
    <Nuvo::Button @variant="secondary" {{on "click" this.close}}>
      {{@cancelText}}
    </Nuvo::Button>
    <Nuvo::Button
      @variant={{if @confirmVariant @confirmVariant "primary"}}
      @disabled={{@isConfirming}}
      @loading={{@isConfirming}}
      {{on "click" this.confirm}}
    >
      {{#if @isConfirming}}
        {{@confirmingText}}
      {{else}}
        {{@confirmText}}
      {{/if}}
    </Nuvo::Button>
  </:footer>
</Nuvo::Modal>
