<Woven::Drawer
  @open={{@open}}
  @title={{if this.isEdit "Edit Lead" "New Lead"}}
  @placement="end"
  @size="lg"
  @onClose={{this.close}}
  @onClosed={{this.reset}}
>
  <:body>
    <form
      id="lead-form"
      class="wu-form"
      novalidate
      {{this.loadOnOpen}}
      {{on "submit" this.save}}
    >
      {{#if this.showRegionField}}
        <Woven::Field
          @label="Region"
          @tooltip="The region that owns this record. Staff who work in other regions will not see it."
        >
          <Woven::Dropdown
            id="lead-region"
            @align="start"
            @value={{this.form.regionCode}}
            @onSelect={{this.setRegionCode}}
            @options={{this.regionOptions}}
            @placeholder="Select region..."
            data-test-region-select
          />
        </Woven::Field>
      {{/if}}
      {{#if this.isEdit}}
        {{! Identity lives on the contact; edit it on the Contacts page. }}
        <Woven::Field @label="Contact">
          <p class="text-sm flex gap-2 x-center wrap">
            {{contact-name @lead.contact}}
            {{#if (is-limited-contact @lead.contact)}}
              <Woven::Badge @size="sm" @text="Limited" data-test-limited-badge />
            {{/if}}
            {{#if (contact-email @lead.contact)}}
              <span class="text-muted">-
                {{contact-email @lead.contact}}</span>
            {{/if}}
            {{#if (contact-phone @lead.contact)}}
              <span class="text-muted">-
                <bdi dir="ltr">{{contact-phone @lead.contact}}</bdi></span>
            {{/if}}
          </p>
        </Woven::Field>
      {{else}}
        <Contact::Picker
          @label="Contact"
          @required={{true}}
          @contact={{this.contactSelection.contact}}
          @identity={{this.contactSelection.identity}}
          @onSelectContact={{this.contactSelection.attach}}
          @onClear={{this.contactSelection.clear}}
          @onIdentityChange={{this.contactSelection.setField}}
          @conflict={{this.contactSelection.conflict}}
          @verifyPhone={{this.contactSelection.verifyPhone}}
          @onVerifyPhoneChange={{this.contactSelection.setVerifyPhone}}
        />
      {{/if}}
      <div class="flex gap-4">
        <div class="grow">
          <Woven::Field @label="Status">
            <Woven::Dropdown
              id="lead-status"
              @align="start"
              @value={{this.form.status}}
              @onSelect={{fn this.setField "status"}}
              @options={{this.statusOptions}}
              @placeholder="Select status..."
              data-test-lead-status
            />
          </Woven::Field>
        </div>
        <div class="grow">
          <Woven::Field
            @label="Temperature"
            @tooltip="How close this lead is to buying or renting. Hot is ready now, warm is still looking, cold is months away, dead has gone quiet."
          >
            <Woven::Dropdown
              id="lead-temp"
              @align="start"
              @value={{this.form.temperature}}
              @onSelect={{fn this.setField "temperature"}}
              @options={{this.temperatureOptions}}
              @placeholder="Select temperature..."
              data-test-lead-temperature
            />
          </Woven::Field>
        </div>
      </div>
      <Woven::Field
        @label="Source"
        @tooltip="Where this lead came from. It shows you which channels bring in the most business."
      >
        <Woven::Dropdown
          id="lead-source"
          @align="start"
          @value={{this.form.source}}
          @onSelect={{fn this.setField "source"}}
          @options={{this.sourceOptions}}
          @placeholder="Select source..."
          data-test-lead-source
        />
      </Woven::Field>
      <Woven::Field @label="Location / Area">
        <Woven::Dropdown
          id="lead-locality"
          @align="start"
          @value={{this.form.localityId}}
          @onSelect={{this.setLocalityId}}
          @options={{this.localityOptions}}
          data-test-lead-locality
        />
      </Woven::Field>
      {{#if this.form.localityId}}
        <Woven::Field @label="Property">
          <Woven::Dropdown
            id="lead-unit"
            @align="start"
            @value={{this.form.unitId}}
            @onSelect={{fn this.setField "unitId"}}
            @options={{this.unitOptions}}
            data-test-lead-unit
          />
        </Woven::Field>
      {{/if}}
      {{#if this.errorMsg}}
        <p class="text-danger">{{this.errorMsg}}</p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Woven::Button
      @variant="secondary"
      @text="Cancel"
      @onClick={{this.close}}
      data-test-cancel-lead
    />
    <Woven::Button
      @variant="primary"
      @type="submit"
      form="lead-form"
      @text={{this.submitLabel}}
      @loading={{this.isSaving}}
      data-test-save-lead
    />
  </:footer>
</Woven::Drawer>