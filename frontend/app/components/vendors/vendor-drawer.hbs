<Woven::Drawer
  @open={{@open}}
  @title={{if this.isEdit "Edit Vendor" "New Vendor"}}
  @placement="end"
  @size="lg"
  @onClose={{this.close}}
  @onClosed={{this.reset}}
>
  <:body>
    <form id="vendor-form" class="wu-form" novalidate {{on "submit" this.save}}>
      {{#if this.showRegionField}}
        <Woven::Field
          @label="Region"
          @tooltip="The region this vendor works in. Staff in other regions cannot find or assign them."
        >
          <Woven::Dropdown
            id="vendor-region"
            @align="start"
            @value={{this.form.formRegionCode}}
            @onSelect={{fn this.setField "formRegionCode"}}
            @options={{this.regionOptions}}
            @placeholder="Select region..."
            data-test-region-select
          />
        </Woven::Field>
      {{/if}}

      <Woven::Field
        @label="Name"
        @required={{true}}
        @error={{this.fieldErrors.formName}}
      >
        <Woven::Input
          id="v-name"
          type="text"
          placeholder="Ahmed Al-Rashid"
          @value={{this.form.formName}}
          @onInput={{fn this.setField "formName"}}
          required={{true}}
          data-test-vendor-name
        />
      </Woven::Field>

      <Woven::FieldGroup
        @label="Specialty (select one or more)"
        @required={{true}}
        @error={{this.fieldErrors.formSpecialties}}
      >
        <div class="flex gap-2 wrap" data-test-vendor-specialty>
          {{#each this.specialtyOptions as |opt|}}
            <button
              type="button"
              class="wu-tag m-pill m-selectable vendor-specialty-chip tag-trade-{{lowercase
                  opt.value
                }}
                {{if
                  (includes this.form.formSpecialties opt.value)
                  'is-selected'
                }}"
              data-test-specialty-chip={{opt.value}}
              aria-pressed={{if
                (includes this.form.formSpecialties opt.value)
                "true"
                "false"
              }}
              {{on "click" (fn this.toggleSpecialty opt.value)}}
            >{{opt.label}}</button>
          {{/each}}
        </div>
      </Woven::FieldGroup>

      <div class="flex gap-4">
        <Woven::Field class="grow" @label="Email">
          <Woven::Input
            id="v-email"
            type="email"
            placeholder="vendor@example.com"
            @value={{this.form.formEmail}}
            @onInput={{fn this.setField "formEmail"}}
            data-test-vendor-email
          />
        </Woven::Field>
        <Woven::Field class="grow" @label="Phone">
          <Woven::Input
            id="v-phone"
            type="text"
            placeholder="+971501234567"
            @value={{this.form.formPhone}}
            @onInput={{fn this.setField "formPhone"}}
            data-test-vendor-phone
          />
        </Woven::Field>
      </div>

      <div class="flex gap-4">
        <Woven::Field class="grow" @label="Company Name">
          <Woven::Input
            id="v-company"
            type="text"
            placeholder="Al-Rashid Maintenance LLC"
            @value={{this.form.formCompanyName}}
            @onInput={{fn this.setField "formCompanyName"}}
            data-test-vendor-company
          />
        </Woven::Field>
        <Woven::Field class="grow" @label="Hourly Rate">
          <Woven::Input
            id="v-rate"
            type="number"
            placeholder="150"
            @value={{this.form.formHourlyRate}}
            @onInput={{fn this.setField "formHourlyRate"}}
            min="0"
            step="0.01"
            data-test-vendor-rate
          />
        </Woven::Field>
      </div>

      <div class="flex gap-4">
        <Woven::Field class="grow" @label="Address">
          <Woven::Input
            id="v-address"
            type="text"
            placeholder="e.g. Industrial Area, Karachi"
            @value={{this.form.formAddress}}
            @onInput={{fn this.setField "formAddress"}}
            data-test-vendor-address
          />
        </Woven::Field>
        <Woven::Field class="grow" @label="Rating (1-5)">
          <Woven::Input
            id="v-rating"
            type="number"
            placeholder="5"
            @value={{this.form.formRating}}
            @onInput={{fn this.setField "formRating"}}
            min="1"
            max="5"
            step="1"
            data-test-vendor-rating
          />
        </Woven::Field>
      </div>

      <Woven::Field @label="Notes">
        <Woven::Textarea
          id="v-notes"
          placeholder="Additional notes about this vendor..."
          rows="3"
          @value={{this.form.formNotes}}
          @onInput={{fn this.setField "formNotes"}}
          data-test-vendor-notes
        />
      </Woven::Field>

      {{#if this.errorMsg}}
        <p class="text-sm text-danger" data-test-error>{{this.errorMsg}}</p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Woven::Button
      @variant="secondary"
      @onClick={{this.close}}
      data-test-cancel-vendor-form
    >Cancel</Woven::Button>
    <Woven::Button
      @variant="primary"
      @type="submit"
      form="vendor-form"
      @loading={{this.isSaving}}
      data-test-save-vendor
    >{{this.submitLabel}}</Woven::Button>
  </:footer>
</Woven::Drawer>