<Woven::Drawer
  @open={{@open}}
  @title="New Commission"
  @placement="end"
  @size="lg"
  @onClose={{this.close}}
  @onClosed={{this.reset}}
>
  <:body>
    {{#if this.errorMsg}}
      <p class="text-danger" data-test-error>{{this.errorMsg}}</p>
    {{/if}}
    <form
      id="commission-form"
      class="wu-form"
      novalidate
      {{on "submit" this.save}}
    >
      <Woven::Field
        @label="Agent"
        @required={{true}}
        @error={{this.fieldErrors.agentId}}
      >
        <Woven::Dropdown
          id="commission-agent"
          @align="start"
          @value={{this.form.agentId}}
          @onSelect={{fn this.setField "agentId"}}
          @options={{this.agentOptions}}
          @placeholder="Select agent..."
          data-test-input-agent
        />
      </Woven::Field>

      <Woven::Field
        @label="Type"
        @required={{true}}
        @error={{this.fieldErrors.type}}
      >
        <Woven::Dropdown
          id="commission-type"
          @align="start"
          @value={{this.form.type}}
          @onSelect={{fn this.setField "type"}}
          @options={{this.commissionTypeOptions}}
          @placeholder="Select type..."
          data-test-input-type
        />
      </Woven::Field>

      <Woven::Field
        @label="Gross Amount"
        @required={{true}}
        @error={{this.fieldErrors.grossAmount}}
        @tooltip="The full value of the deal before any deductions. The commission is worked out from this, so it is not the payout."
      >
        <Woven::Input
          id="commission-gross"
          type="number"
          placeholder="e.g. 50000"
          @value={{this.form.grossAmount}}
          @onInput={{fn this.setField "grossAmount"}}
          required={{true}}
          data-test-input-amount
        />
      </Woven::Field>

      <Woven::Field
        @label="Commission Rate %"
        @required={{true}}
        @error={{this.fieldErrors.commissionRate}}
        @tooltip="The share of the gross amount paid as commission. A rate of 2 on a gross of 100,000 pays 2,000."
      >
        <Woven::Input
          id="commission-rate"
          type="number"
          step="0.01"
          min="0"
          max="100"
          placeholder="e.g. 2.5"
          @value={{this.form.commissionRate}}
          @onInput={{fn this.setField "commissionRate"}}
          required={{true}}
          data-test-input-rate
        />
      </Woven::Field>

      <Woven::Field @label="Notes">
        <Woven::Textarea
          id="commission-notes"
          placeholder="Optional notes..."
          @value={{this.form.notes}}
          @onInput={{fn this.setField "notes"}}
          data-test-input-notes
        />
      </Woven::Field>
    </form>
  </:body>
  <:footer>
    <Woven::Button
      @variant="secondary"
      @onClick={{this.close}}
      data-test-cancel-commission
    >Cancel</Woven::Button>
    <Woven::Button
      @variant="primary"
      @type="submit"
      form="commission-form"
      @loading={{this.isSaving}}
      data-test-save-commission
    >{{if this.isSaving "Saving..." "Create"}}</Woven::Button>
  </:footer>
</Woven::Drawer>