<Nuvo::Card
  data-test-contact-companies
  ...attributes
  {{this.reloadOnRegion this.region.regionCode}}
>
  {{#if this.isLoading}}
    <div class="flex center py-8">
      <Nuvo::Spinner />
    </div>
  {{else if this.error}}
    <p class="text-danger" data-test-contact-companies-error>{{this.error}}</p>
  {{else if this.companies.length}}
    <Nuvo::DataTable
      @columns={{this.columns}}
      @rows={{this.companies}}
      @pinColumns={{true}}
      @sortable={{true}}
      @tableId="contact-companies"
      data-test-contact-companies-table
      as |cell|
    >
      {{#if (eq cell.key "name")}}
        <LinkTo
          @route="contacts.index"
          @query={{hash tab="contacts" company=cell.value page=1}}
          class="text-primary font-bold whitespace-nowrap"
          data-test-contact-company={{cell.value}}
        >{{cell.value}}</LinkTo>
      {{else}}
        <span class="text-muted">{{cell.value}}</span>
      {{/if}}
    </Nuvo::DataTable>
  {{else}}
    <Nuvo::EmptyState
      @description="No contact in this region has a company yet."
      data-test-contact-companies-empty
    />
  {{/if}}

  {{#if this.total}}
    <Nuvo::Pagination
      @selectId="contact-companies-limit"
      @page={{this.page}}
      @limit={{this.limit}}
      @total={{this.total}}
      @perPageOptions={{array 20 50 100}}
      @onLimitChange={{this.setLimit}}
      @onPrevious={{this.previousPage}}
      @onNext={{this.nextPage}}
      @onPageChange={{this.goToPage}}
    />
  {{/if}}
</Nuvo::Card>