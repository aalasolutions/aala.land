<Woven::Drawer
  @open={{@open}}
  @title={{if this.isEdit "Edit Contact" "New Contact"}}
  @placement="end"
  @size="lg"
  @onClose={{this.close}}
  @onClosed={{this.reset}}
>
  <:body>
    <form
      id="contact-form"
      class="wu-form"
      novalidate
      {{on "submit" this.save}}
    >
      <div class="flex gap-4">
        <Woven::Field
          class="grow"
          @label="First Name"
          @required={{true}}
          @error={{this.fieldErrors.formFirstName}}
        >
          <Woven::Input
            id="c-fname"
            type="text"
            placeholder="Ahmed"
            @value={{this.form.formFirstName}}
            @onInput={{fn this.setField "formFirstName"}}
            data-test-input-first-name
          />
        </Woven::Field>
        <Woven::Field class="grow" @label="Last Name">
          <Woven::Input
            id="c-lname"
            type="text"
            placeholder="Al-Rashid"
            @value={{this.form.formLastName}}
            @onInput={{fn this.setField "formLastName"}}
            data-test-input-last-name
          />
        </Woven::Field>
      </div>

      <div class="flex gap-4">
        <Woven::Field class="grow" @label="Email">
          <Woven::Input
            id="c-email"
            type="email"
            placeholder="ahmed@example.com"
            @value={{this.form.formEmail}}
            @onInput={{fn this.setField "formEmail"}}
            data-test-input-email
          />
        </Woven::Field>
        <Woven::Field class="grow" @label="Nationality">
          <Woven::Input
            id="c-nationality"
            type="text"
            placeholder="e.g. Emirati"
            @value={{this.form.formNationality}}
            @onInput={{fn this.setField "formNationality"}}
            data-test-input-nationality
          />
        </Woven::Field>
      </div>

      <div class="flex gap-4">
        <Woven::Field
          class="grow"
          @label="Phone"
          @required={{true}}
          @error={{this.fieldErrors.formPhone}}
        >
          <Woven::Input
            id="c-phone"
            type="text"
            placeholder="+971501234567"
            @value={{this.form.formPhone}}
            @onInput={{fn this.setField "formPhone"}}
            data-test-input-phone
          />
        </Woven::Field>
        <Woven::Field class="grow" @label="National ID">
          <Woven::Input
            id="c-national-id"
            type="text"
            placeholder="EID / passport number"
            @value={{this.form.formNationalId}}
            @onInput={{fn this.setField "formNationalId"}}
            data-test-input-national-id
          />
        </Woven::Field>
      </div>

      <Woven::Checkbox
        @checked={{this.form.formIsWhatsapp}}
        @label="This phone number is on WhatsApp"
        @onChange={{fn this.setField "formIsWhatsapp"}}
        data-test-input-is-whatsapp
      />

      <div class="flex gap-4">
        <Woven::Field class="grow" @label="Company">
          <Woven::Input
            id="c-company"
            type="text"
            placeholder="Emaar Properties"
            @value={{this.form.formContactCompany}}
            @onInput={{fn this.setField "formContactCompany"}}
            data-test-input-company
          />
        </Woven::Field>
        <Woven::Field class="grow" @label="Job Title">
          <Woven::Input
            id="c-job"
            type="text"
            placeholder="Property Manager"
            @value={{this.form.formJobTitle}}
            @onInput={{fn this.setField "formJobTitle"}}
            data-test-input-job-title
          />
        </Woven::Field>
      </div>

      <Woven::Field @label="Address">
        <Woven::Input
          id="c-address"
          type="text"
          placeholder="e.g. Gulberg, Lahore"
          @value={{this.form.formAddress}}
          @onInput={{fn this.setField "formAddress"}}
          data-test-input-address
        />
      </Woven::Field>

      <Woven::Field @label="Notes">
        <Woven::Textarea
          id="c-notes"
          placeholder="Additional notes..."
          rows="3"
          @value={{this.form.formNotes}}
          @onInput={{fn this.setField "formNotes"}}
          data-test-input-notes
        />
      </Woven::Field>

      {{#if this.errorMsg}}
        <p class="text-sm text-danger" data-test-error>{{this.errorMsg}}</p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Woven::Button
      @variant="secondary"
      @onClick={{this.close}}
      data-test-cancel-contact-form
    >Cancel</Woven::Button>
    <Woven::Button
      @variant="primary"
      @type="submit"
      form="contact-form"
      @loading={{this.isSaving}}
      data-test-save-contact
    >{{this.submitLabel}}</Woven::Button>
  </:footer>
</Woven::Drawer>