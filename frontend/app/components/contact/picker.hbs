<div class="flex col gap-4" data-test-contact-picker>
  <Woven::Field @label={{this.label}} @required={{@required}}>
    <RemoteAutocomplete
      @searchUrl={{this.searchUrl}}
      @searchParam="search"
      @labelKey="pickerLabel"
      @mapItem={{this.mapItem}}
      @placeholder="Search name, phone or email..."
      @selectedName={{this.selectedName}}
      @value={{this.selectedId}}
      @searchOnOpen={{true}}
      @onSelect={{this.select}}
      @onClear={{this.clear}}
      @onCreate={{this.create}}
      data-test-contact-search
    />
  </Woven::Field>

  {{#if (and this.conflict (not this.isAttached))}}
    <Woven::Panel
      @compact={{true}}
      class="flex col gap-2"
      data-test-contact-conflict
    >
      <p class="text-sm font-bold">Contact already added</p>
      <div class="flex between x-center gap-3 wrap">
        <div class="flex col">
          <span data-test-contact-conflict-name>{{this.conflictName}}</span>
          {{#if this.conflictPhone}}
            <span
              class="text-muted text-sm"
              data-test-contact-conflict-phone
            ><bdi dir="ltr">{{this.conflictPhone}}</bdi></span>
          {{/if}}
          {{#if this.conflict.createdByName}}
            <span
              class="text-muted text-sm"
              data-test-contact-conflict-added-by
            >Added by {{this.conflict.createdByName}}</span>
          {{/if}}
        </div>
        <Woven::Button
          @variant="primary"
          @size="sm"
          @text="Use this contact"
          @onClick={{this.useConflict}}
          data-test-contact-use-existing
        />
      </div>
    </Woven::Panel>
  {{/if}}

  {{#unless this.isAttached}}
    {{#unless this.isCreating}}
      <Woven::Button
        @variant="secondary"
        @size="sm"
        @text="Not in contacts? Add a new one"
        @onClick={{this.startCreating}}
        data-test-contact-add-new
      />
    {{/unless}}
  {{/unless}}

  {{#if (or this.isAttached this.isCreating)}}
    <div class="flex gap-4">
      <div class="grow">
        <Woven::Field @label="First Name">
          <Woven::Input
            id="{{this.fieldPrefix}}-first-name"
            @type="text"
            @placeholder="e.g. Ahmed"
            @value={{if
              this.isAttached
              this.contact.firstName
              this.identity.firstName
            }}
            @onInput={{fn this.setIdentity "firstName"}}
            @readonly={{this.isAttached}}
            data-test-contact-first-name
          />
        </Woven::Field>
      </div>
      <div class="grow">
        <Woven::Field @label="Last Name">
          <Woven::Input
            id="{{this.fieldPrefix}}-last-name"
            @type="text"
            @placeholder="e.g. Al Mansouri"
            @value={{if
              this.isAttached
              this.attachedLastName
              this.identity.lastName
            }}
            @onInput={{fn this.setIdentity "lastName"}}
            @readonly={{this.isAttached}}
            data-test-contact-last-name
          />
        </Woven::Field>
      </div>
    </div>

    <div class="flex gap-4">
      <div class="grow">
        <Woven::Field @label="Phone">
          <Woven::Input
            id="{{this.fieldPrefix}}-phone"
            @type="text"
            @placeholder="+971501234567"
            @value={{if this.isAttached this.attachedPhone this.identity.phone}}
            @onInput={{fn this.setIdentity "phone"}}
            @readonly={{this.isAttached}}
            data-test-contact-phone
          />
        </Woven::Field>
      </div>
      {{#unless this.isLimited}}
        <div class="grow">
          <Woven::Field @label="Email">
            <Woven::Input
              id="{{this.fieldPrefix}}-email"
              @type="email"
              @placeholder="ahmed@example.com"
              @value={{if
                this.isAttached
                this.contact.email
                this.identity.email
              }}
              @onInput={{fn this.setIdentity "email"}}
              @readonly={{this.isAttached}}
              data-test-contact-email
            />
          </Woven::Field>
        </div>
      {{/unless}}
    </div>

    {{#if this.isLimited}}
      <Woven::Field @label="Enter their number to unlock details">
        <Woven::Input
          id="{{this.fieldPrefix}}-verify-phone"
          @type="tel"
          @placeholder="+971501234567"
          @value={{@verifyPhone}}
          @onInput={{this.setVerifyPhone}}
          data-test-contact-verify-phone
        />
      </Woven::Field>
    {{/if}}

    {{#if this.isAttached}}
      {{#if this.contact.isWhatsapp}}
        <p class="text-sm text-muted" data-test-contact-whatsapp-note>
          <Ui::Ph @icon="whatsapp-logo" />
          Reachable on WhatsApp
        </p>
      {{/if}}
    {{else}}
      <Woven::Checkbox
        @label="Reachable on WhatsApp"
        @checked={{this.identity.isWhatsapp}}
        @onChange={{this.toggleWhatsapp}}
        data-test-contact-whatsapp
      />
    {{/if}}

    {{#if this.notes}}
      <Woven::Field @label="Notes">
        <p class="text-sm text-muted" data-test-contact-notes>{{this.notes}}</p>
      </Woven::Field>
    {{/if}}
  {{/if}}
</div>