<div
  class="flex col gap-4"
  data-test-documents-panel
  {{this.reloadOn this.filtersKey this.page this.pageSize}}
>
  {{#if (has-block "header")}}
    {{yield
      (hash
        total=this.total
        isLoading=this.isLoading
        canUpload=this.canUpload
        openUpload=this.openUpload
      )
      to="header"
    }}
  {{else}}
    <div class="flex between x-center gap-3">
      <p class="text-sm text-muted" data-test-documents-count>
        {{format-number this.total unit="document"}}
      </p>
      {{#if this.canUpload}}
        <Woven::Button
          @variant="primary"
          @size="sm"
          @icon="upload-simple"
          data-test-documents-upload
          {{on "click" this.openUpload}}
        >
          Upload
        </Woven::Button>
      {{/if}}
    </div>
  {{/if}}

  <div class="flex col gap-3">
    {{#if this.showInitialLoading}}
      <div
        class="flex x-center gap-2 text-sm text-muted"
        role="status"
        data-test-documents-loading
      >
        <Woven::Spinner @size="sm" />
        <span>Loading documents...</span>
      </div>
    {{else if this.errorMessage}}
      <Woven::Alert
        @variant="danger"
        @description={{this.errorMessage}}
        data-test-documents-error
      />
    {{else if this.rows.length}}
      <Woven::DataTable
        @columns={{this.columns}}
        @rows={{this.rows}}
        @pinColumns={{true}}
        @reorderable={{true}}
        @sortable={{true}}
        @showOptions={{true}}
        @tableId={{this.tableId}}
        as |cell|
      >
        {{#if (eq cell.key "name")}}
          <div class="flex x-center gap-2" data-test-document-row>
            <Ui::Ph @icon="file-text" />
            <span>{{cell.value}}</span>
            {{#if cell.row.derivedLabel}}
              <Woven::Badge
                @variant="secondary"
                @size="sm"
                @quiet={{true}}
                @text={{cell.row.derivedLabel}}
                data-test-document-derived
              />
            {{/if}}
          </div>
        {{else if (eq cell.key "category")}}
          <Woven::Tag
            class="tag-doc-{{lowercase cell.value}}"
            @text={{this.categoryLabel cell.value}}
          />
        {{else if (eq cell.key "accessLevel")}}
          <Woven::Tag
            class="tag-access-{{lowercase cell.value}}"
            @text={{cell.value}}
          />
        {{else if (eq cell.key "unit.assetName")}}
          <span class="text-sm" data-test-document-property>
            {{#if cell.row.unit}}
              <LinkTo
                @route="properties.unit"
                @models={{array cell.row.unit.areaId cell.row.unit.id}}
                class="text-brand"
                data-test-document-property-link
              >{{cell.row.unit.assetName}}
                -
                {{cell.row.unit.unitNumber}}</LinkTo>
            {{else if cell.row.buildingName}}
              {{cell.row.buildingName}}
            {{else}}
              <span class="text-muted">-</span>
            {{/if}}
          </span>
        {{else if (eq cell.key "link.label")}}
          <div class="flex x-center gap-2 wrap" data-test-document-related>
            {{#if cell.row.link}}
              <Woven::Badge
                @variant="info"
                @text={{cell.row.relatedTypeLabel}}
                data-test-document-related-type
              />
              {{#if cell.row.relatedRoute}}
                <LinkTo
                  @route={{cell.row.relatedRoute.name}}
                  @models={{cell.row.relatedRoute.models}}
                  class="text-sm text-brand"
                  data-test-document-related-link
                >{{cell.row.relatedLabel}}</LinkTo>
              {{else}}
                <span
                  class="text-sm"
                  data-test-document-related-label
                >{{cell.row.relatedLabel}}</span>
              {{/if}}
            {{else}}
              <span
                class="text-sm text-muted"
                data-test-document-related-none
              >Library only</span>
            {{/if}}
          </div>
        {{else if (eq cell.key "fileSize")}}
          <span class="text-sm text-muted">{{format-bytes cell.value}}</span>
        {{else if (eq cell.key "uploadedByName")}}
          <span class="text-sm text-muted" data-test-document-uploader>
            {{#if (eq cell.row.uploadedBy this.currentUserId)}}
              ME
            {{else}}
              {{or cell.value "-"}}
            {{/if}}
          </span>
        {{else if (eq cell.key "createdAt")}}
          <span class="text-sm text-muted">{{format-date
              cell.value
              zone="region"
            }}</span>
        {{else if (eq cell.key "id")}}
          <div class="flex">
            <Woven::Button
              @subtle={{true}}
              @variant="secondary"
              @size="xs"
              aria-label="Download {{cell.row.name}}"
              data-tooltip="Download"
              data-test-download-btn
              @icon="download-simple"
              {{on "click" (fn this.downloadDocument cell.row)}}
            />
            {{#unless cell.row.isDerived}}
              {{#if (this.canEditRow cell.row)}}
                <Woven::Button
                  @subtle={{true}}
                  @variant="secondary"
                  @size="xs"
                  aria-label="Edit {{cell.row.name}}"
                  data-tooltip="Edit"
                  data-test-edit-btn
                  @icon="pencil-simple"
                  {{on "click" (fn this.openEdit cell.row)}}
                />
              {{/if}}
              {{#if this.canDelete}}
                <Woven::Button
                  @subtle={{true}}
                  @variant="danger"
                  @size="xs"
                  aria-label="Delete {{cell.row.name}}"
                  data-tooltip="Delete"
                  data-test-delete-btn
                  @icon="trash"
                  {{on "click" (fn this.openDelete cell.row)}}
                />
              {{/if}}
            {{/unless}}
          </div>
        {{else}}
          <span class="text-muted">{{cell.value}}</span>
        {{/if}}
      </Woven::DataTable>
    {{else if this.total}}
      <Woven::EmptyState
        @description="No documents on page {{this.page}}. Navigate back to find documents."
        data-test-documents-page-empty
      />
    {{else}}
      <div class="flex col x-center gap-2 py-8" data-test-documents-empty>
        <Ui::Ph
          @icon="file-arrow-up"
          @size="48px"
          @color="var(--wu-text-muted)"
        />
        <p class="text-muted">{{if
            @filtered
            "No documents match these filters."
            "No documents yet."
          }}</p>
      </div>
    {{/if}}
  </div>

  {{#if this.showPagination}}
    <Woven::Pagination
      @selectId="{{this.fieldPrefix}}-limit"
      @page={{this.page}}
      @limit={{this.pageSize}}
      @total={{this.total}}
      @onLimitChange={{@onPageSizeChange}}
      @onPageChange={{this.goToPage}}
      data-test-documents-pagination
    />
  {{/if}}
</div>

<Woven::Drawer
  @open={{this.showDrawer}}
  @title={{if this.editDocument "Update Document" "Upload Document"}}
  @placement="end"
  @size="lg"
  @onClose={{this.closeDrawer}}
  @onClosed={{this.resetDrawer}}
  data-test-documents-drawer
>
  <:body>
    <form
      id={{this.formId}}
      class="wu-form"
      novalidate
      {{on "submit" this.saveDocument}}
    >
      {{#if this.editDocument}}
        <Woven::Field @label="File">
          <div class="flex x-center gap-2" data-test-edit-file>
            <span
              class="text-sm grow"
              data-test-edit-file-name
            >{{this.editDocument.originalFileName}}
              <span class="text-muted">({{format-bytes
                  this.editDocument.fileSize
                }})</span></span>
            <Woven::Button
              @subtle={{true}}
              @variant="secondary"
              @size="xs"
              @icon="download-simple"
              aria-label="Download {{this.editDocument.originalFileName}}"
              data-tooltip="Download"
              data-test-edit-file-download
              {{on "click" (fn this.downloadDocument this.editDocument)}}
            />
          </div>
        </Woven::Field>
      {{else}}
        <Woven::Field
          @label="File"
          @required={{true}}
          @error={{this.fieldErrors.file}}
        >
          <input
            id="{{this.fieldPrefix}}-file"
            type="file"
            class="wu-input"
            data-test-file-input
            accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.rtf,.txt,.md,.csv,.jpg,.jpeg,.png,.webp,.gif"
            {{on "change" this.onFileSelect}}
          />
          {{#if this.selectedFile}}
            <p class="text-xs text-muted" data-test-selected-file>
              Selected:
              {{this.selectedFile.name}}
              ({{format-bytes this.selectedFile.size}})
            </p>
          {{/if}}
        </Woven::Field>
      {{/if}}

      <Woven::Field
        @label="Document Name"
        @required={{true}}
        @error={{this.fieldErrors.name}}
      >
        <Woven::Input
          id="{{this.fieldPrefix}}-name"
          type="text"
          placeholder="Lease Agreement Q1 2026"
          @value={{this.formName}}
          @onInput={{fn this.setFieldValue "formName"}}
          required={{true}}
          data-test-field-name
        />
      </Woven::Field>

      {{#if @presetLink}}
        <div class="flex gap-4">
          <Woven::Field class="grow" @label="Related To">
            <Woven::Input
              id="{{this.fieldPrefix}}-related-type"
              @value={{this.presetTypeLabel}}
              @readonly={{true}}
              data-test-related-type-readonly
            />
          </Woven::Field>
          <Woven::Field class="grow" @label="Record">
            <Woven::Input
              id="{{this.fieldPrefix}}-related-record"
              @value={{@presetLink.label}}
              @readonly={{true}}
              data-test-related-record-readonly
            />
          </Woven::Field>
        </div>
      {{else}}
        <Woven::Field
          @label="Related To"
          @tooltip="Link the file to one record, or keep it in the library only."
        >
          <Woven::Dropdown
            id="{{this.fieldPrefix}}-related-type"
            @align="start"
            @value={{this.formRelatedType}}
            @onSelect={{this.setRelatedType}}
            @options={{this.relatedTypeOptions}}
            data-test-field-related-type
          />
        </Woven::Field>
        {{#each this.recordPickers key="type" as |picker|}}
          <Woven::Field
            @label={{picker.fieldLabel}}
            @required={{true}}
            @error={{this.fieldErrors.record}}
          >
            <RemoteAutocomplete
              @listUrl={{picker.listUrl}}
              @searchUrl={{picker.searchUrl}}
              @searchParam={{picker.searchParam}}
              @mapItem={{picker.mapItem}}
              @labelKey="label"
              @placeholder={{picker.placeholder}}
              @value={{this.formRecord.id}}
              @selectedName={{this.formRecord.label}}
              @onSelect={{this.selectRecord}}
              @onClear={{this.clearRecord}}
              data-test-field-related-record
            />
          </Woven::Field>
          <RecordSummary @type={{picker.type}} @record={{this.formRecord}} />
        {{/each}}
      {{/if}}

      <div class="flex gap-4">
        <Woven::Field class="grow" @label="Category">
          <Woven::Dropdown
            id="{{this.fieldPrefix}}-category"
            @align="start"
            @value={{this.formCategory}}
            @onSelect={{fn this.setFieldValue "formCategory"}}
            @options={{this.categoryOptions}}
            @placeholder="Select category..."
            data-test-field-category
          />
        </Woven::Field>
        <Woven::Field
          class="grow"
          @label="Access Level"
          @tooltip="Team means every staff member can open this file. Admin means only admins can."
        >
          <Woven::Dropdown
            id="{{this.fieldPrefix}}-access"
            @align="start"
            @value={{this.formAccessLevel}}
            @onSelect={{fn this.setFieldValue "formAccessLevel"}}
            @options={{this.accessLevelOptions}}
            @placeholder="Select access level..."
            data-test-field-access
          />
        </Woven::Field>
      </div>

      {{#if this.isSaving}}
        {{#unless this.editDocument}}
          <div data-test-upload-progress>
            <Woven::Progress @value={{this.uploadProgress}} @showText={{true}} />
          </div>
        {{/unless}}
      {{/if}}

      {{#if this.errorMsg}}
        <p class="text-sm text-danger" data-test-error>{{this.errorMsg}}</p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Woven::Button
      @variant="secondary"
      @onClick={{this.closeDrawer}}
      data-test-cancel-btn
    >Cancel</Woven::Button>
    <Woven::Button
      @variant="primary"
      @type="submit"
      form={{this.formId}}
      @loading={{this.isSaving}}
      data-test-save-btn
    >{{if
        this.isSaving
        "Uploading..."
        (if this.editDocument "Update" "Upload")
      }}</Woven::Button>
  </:footer>
</Woven::Drawer>

<ConfirmModal
  @open={{this.showDeleteModal}}
  @title="Delete Document"
  @message="Delete {{this.documentToDelete.name}}? This cannot be undone."
  @confirmText="Delete"
  @confirmVariant="danger"
  @isConfirming={{this.isDeleting}}
  @confirmingText="Deleting..."
  @onClose={{this.closeDeleteModal}}
  @onConfirm={{this.confirmDelete}}
/>