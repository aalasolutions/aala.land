<Nuvo::Drawer
  @open={{@open}}
  @title={{this.title}}
  @placement="end"
  @size="lg"
  @onClose={{this.close}}
  @onClosed={{this.reset}}
>
  <:body>
    <form id="property-form" class="nu-form" novalidate {{on "submit" this.save}}>
      {{#if this.isList}}
        <Nuvo::Field
          @label="City"
          @required={{true}}
          @error={{this.fieldErrors.city}}
        >
          <RemoteAutocomplete
            @listUrl={{this.cityListUrl}}
            @searchUrl={{this.citySearchUrl}}
            @createUrl="/locations/cities"
            @createPayload={{this.cityCreatePayload}}
            @placeholder="Search city..."
            @selectedName={{this.form.city.name}}
            @onSelect={{this.selectCity}}
            @onClear={{this.clearCity}}
          />
        </Nuvo::Field>
        {{#if this.form.city}}
          <Nuvo::Field
            @label="Location / Area"
            @required={{true}}
            @error={{this.fieldErrors.locality}}
          >
            <RemoteAutocomplete
              @listUrl={{this.localityListUrl}}
              @searchUrl={{this.localitySearchUrl}}
              @createUrl="/locations/localities"
              @createPayload={{this.localityCreatePayload}}
              @placeholder="Search location..."
              @selectedName={{this.form.locality.name}}
              @onSelect={{this.selectLocality}}
              @onClear={{this.clearLocality}}
            />
          </Nuvo::Field>
        {{/if}}
        {{#if this.form.locality}}
          <Nuvo::Field
            @label="Asset"
            @required={{true}}
            @error={{this.fieldErrors.asset}}
          >
            <RemoteAutocomplete
              @listUrl={{this.assetListUrl}}
              @searchUrl={{this.assetSearchUrl}}
              @createUrl="/properties/assets"
              @createPayload={{this.assetCreatePayload}}
              @placeholder="Search asset (tower, villa, mall...)"
              @selectedName={{this.form.asset.name}}
              @onSelect={{this.selectAsset}}
              @onClear={{this.clearAsset}}
            />
          </Nuvo::Field>
        {{/if}}
        {{#if this.form.asset}}
          <hr class="border-t border-light" />
        {{/if}}
      {{/if}}

      {{#if this.showFields}}
        <div class="flex gap-4">
          <Nuvo::Field
            @label="Property Number"
            @required={{true}}
            @error={{this.fieldErrors.unitNumber}}
            class="grow"
          >
            <Nuvo::Input
              id="unit-number"
              @type="text"
              @placeholder="e.g. 101"
              @value={{this.form.unitNumber}}
              @onInput={{fn this.setField "unitNumber"}}
              required={{not this.isUnit}}
              data-test-unit-number
            />
          </Nuvo::Field>
          <Nuvo::Field @label="Status" class="grow">
            <Nuvo::Dropdown
              id="unit-status"
              @align="start"
              @value={{this.form.status}}
              @onSelect={{fn this.setField "status"}}
              @options={{this.statusOptions}}
              @placeholder="Select status..."
              data-test-unit-status
            />
          </Nuvo::Field>
        </div>

        <Nuvo::Field
          @label="Property Kind"
          @required={{true}}
          @error={{this.fieldErrors.subType}}
          @tooltip="Sets the lease type: homes take residential leases; offices, shops and warehouses take commercial ones."
        >
          <Nuvo::Dropdown
            id="unit-sub-type"
            @align="start"
            @value={{this.form.subType}}
            @onSelect={{fn this.setField "subType"}}
            @options={{this.subTypeOptions}}
            @placeholder="Select kind..."
            data-test-unit-kind
          />
        </Nuvo::Field>
        <Nuvo::Field
          @label="Property Listing Type"
          @tooltip="Choose how this property is listed. For Rent and For Sale make it searchable. Not Listed keeps it hidden."
        >
          <Nuvo::Dropdown
            id="unit-property-type"
            @align="start"
            @value={{this.form.propertyType}}
            @onSelect={{fn this.setField "propertyType"}}
            @options={{this.propertyTypeOptions}}
            @placeholder="Not Listed"
            data-test-unit-listing-type
          />
        </Nuvo::Field>

        <div class="flex gap-4">
          <Nuvo::Field
            @label="Price"
            class="grow"
            @tooltip="For a rental, enter the rent per month. For a sale, enter the full asking price."
          >
            <Nuvo::Input
              id="unit-price"
              @type="number"
              @placeholder="e.g. 150000"
              @value={{this.form.price}}
              @onInput={{fn this.setField "price"}}
              min="0"
              data-test-unit-price
            />
          </Nuvo::Field>
          {{#unless this.isList}}
            <Nuvo::Field @label="Sq Ft" class="grow">
              <Nuvo::Input
                id="unit-sqft"
                @type="number"
                @placeholder="e.g. 850"
                @value={{this.form.sqFt}}
                @onInput={{fn this.setField "sqFt"}}
                min="0"
                data-test-unit-sqft
              />
            </Nuvo::Field>
          {{/unless}}
        </div>

        <div class="flex gap-4">
          <Nuvo::Field @label="Bedrooms" class="grow">
            <Nuvo::Input
              id="unit-beds"
              @type="number"
              @placeholder="e.g. 2"
              @value={{this.form.bedrooms}}
              @onInput={{fn this.setField "bedrooms"}}
              min="0"
              data-test-unit-beds
            />
          </Nuvo::Field>
          <Nuvo::Field @label="Bathrooms" class="grow">
            <Nuvo::Input
              id="unit-baths"
              @type="number"
              @placeholder="e.g. 2"
              @value={{this.form.bathrooms}}
              @onInput={{fn this.setField "bathrooms"}}
              min="0"
              step="0.5"
              data-test-unit-baths
            />
          </Nuvo::Field>
        </div>

        {{#if this.isUnit}}
          <Nuvo::Field @label="Floor">
            <Nuvo::Input
              @type="number"
              @placeholder="e.g. 5"
              @value={{this.form.floor}}
              @onInput={{fn this.setField "floor"}}
              min="0"
              data-test-unit-floor
            />
          </Nuvo::Field>

          <Nuvo::Field @label="Description">
            <Nuvo::Textarea
              rows="3"
              placeholder="Property description..."
              @value={{this.form.description}}
              @onInput={{fn this.setField "description"}}
              data-test-unit-description
            />
          </Nuvo::Field>
        {{/if}}

        {{#if this.isList}}
          <hr class="border-t border-light" />
        {{/if}}
        <Contact::Picker
          @label="Owner"
          @required={{true}}
          @contact={{this.ownerSelection.contact}}
          @identity={{this.ownerSelection.identity}}
          @onSelectContact={{this.ownerSelection.attach}}
          @onClear={{this.ownerSelection.clear}}
          @onIdentityChange={{this.ownerSelection.setField}}
          @conflict={{this.ownerSelection.conflict}}
          @verifyPhone={{this.ownerSelection.verifyPhone}}
          @onVerifyPhoneChange={{this.ownerSelection.setVerifyPhone}}
        />

        {{#unless this.isList}}
          <div class="flex col gap-2">
            <span
              id="property-amenities-label"
              class="text-sm text-muted"
            >Amenities</span>
            <div
              class="flex wrap gap-2"
              role="group"
              aria-labelledby="property-amenities-label"
              data-test-amenities-picker
            >
              {{#each this.amenityOptions as |opt|}}
                <button
                  type="button"
                  class="nu-tag m-pill m-selectable
                    {{if (includes this.form.amenities opt.key) 'is-selected'}}"
                  data-test-amenity={{opt.key}}
                  aria-pressed={{if
                    (includes this.form.amenities opt.key)
                    "true"
                    "false"
                  }}
                  {{on "click" (fn this.toggleAmenity opt.key)}}
                >
                  <Ui::Ph @icon={{opt.icon}} />
                  {{opt.label}}
                </button>
              {{/each}}
            </div>
          </div>
        {{/unless}}
      {{/if}}

      {{#if this.errorMsg}}
        <p class="text-sm text-danger" data-test-error>{{this.errorMsg}}</p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Nuvo::Button
      @variant="secondary"
      @text="Cancel"
      @onClick={{this.close}}
      data-test-unit-cancel
    />
    {{#if this.showFields}}
      <Nuvo::Button
        @variant="primary"
        @type="submit"
        form="property-form"
        @text={{this.submitLabel}}
        @loading={{this.isSaving}}
        data-test-unit-save
      />
    {{/if}}
  </:footer>
</Nuvo::Drawer>