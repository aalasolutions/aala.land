<Woven::Drawer
  @open={{@open}}
  @title={{if this.isEdit "Edit Asset" "New Asset"}}
  @placement="end"
  @size="lg"
  @onClose={{this.close}}
  @onClosed={{this.reset}}
>
  <:body>
    <form id="asset-form" class="wu-form" novalidate {{on "submit" this.save}}>
      {{#unless this.isEdit}}
        <Woven::Field
          @label="City"
          @required={{true}}
          @error={{this.fieldErrors.city}}
        >
          <RemoteAutocomplete
            @listUrl={{this.cityListUrl}}
            @searchUrl={{this.citySearchUrl}}
            @createUrl="/locations/cities"
            @createPayload={{this.cityCreatePayload}}
            @placeholder="Search city..."
            @selectedName={{this.form.city.name}}
            @onSelect={{this.selectCity}}
            @onClear={{this.clearCity}}
          />
        </Woven::Field>
        {{#if this.form.city}}
          <Woven::Field
            @label="Location / Area"
            @required={{true}}
            @error={{this.fieldErrors.locality}}
          >
            <RemoteAutocomplete
              @listUrl={{this.localityListUrl}}
              @searchUrl={{this.localitySearchUrl}}
              @createUrl="/locations/localities"
              @createPayload={{this.localityCreatePayload}}
              @placeholder="Search location..."
              @selectedName={{this.form.locality.name}}
              @onSelect={{this.selectLocality}}
              @onClear={{this.clearLocality}}
            />
          </Woven::Field>
        {{/if}}
      {{/unless}}
      <Woven::Field
        @label="Asset Name"
        @required={{true}}
        @error={{this.fieldErrors.name}}
      >
        <Woven::Input
          data-test-asset-name
          id="b-name"
          @type="text"
          @placeholder="e.g. Tower A"
          @value={{this.form.name}}
          @onInput={{fn this.setField "name"}}
          required={{true}}
        />
      </Woven::Field>
      <Woven::Field @label="Address">
        <Woven::Input
          data-test-asset-address
          id="b-address"
          @type="text"
          @placeholder="e.g. 123 Sheikh Zayed Road"
          @value={{this.form.address}}
          @onInput={{fn this.setField "address"}}
        />
      </Woven::Field>
      {{#if this.errorMsg}}
        <p class="text-sm text-danger">{{this.errorMsg}}</p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Woven::Button
      data-test-asset-cancel
      @variant="secondary"
      {{on "click" this.close}}
    >Cancel</Woven::Button>
    <Woven::Button
      data-test-asset-save
      @type="submit"
      form="asset-form"
      @variant="primary"
      @disabled={{this.isSaving}}
      @loading={{this.isSaving}}
    >
      {{this.submitLabel}}
    </Woven::Button>
  </:footer>
</Woven::Drawer>