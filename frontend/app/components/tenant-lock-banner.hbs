{{! Lock blocks writes server-side; lifted grants expire at the lift date and it re-locks. }}
{{#if @lockState.locked}}
  <Woven::Alert
    @variant="danger"
    role="status"
    class="tenant-lock-banner"
    data-test-tenant-lock-banner
  >
    <p>You are over your limits. Reduce or pay to continue. Your data is safe
      and stays readable and exportable.</p>
  </Woven::Alert>
{{else if @lockState.lifted}}
  <Woven::Alert
    @variant="warning"
    role="status"
    class="tenant-lock-banner"
    data-test-tenant-grace-banner
  >
    <p>Your account is active until
      {{format-date @lockState.liftUntil}}. Settle before then to keep access.</p>
  </Woven::Alert>
{{/if}}