<Woven::Alert
  @variant="danger"
  @title={{@title}}
  @description={{@description}}
  ...attributes
>
  <:actions>
    <Woven::Button
      @variant="secondary"
      @size="sm"
      {{on "click" @onRetry}}
      data-test-load-error-retry
    >
      Try again
    </Woven::Button>
  </:actions>
</Woven::Alert>