<Woven::Alert
  @variant="danger"
  @title={{@title}}
  @description={{@description}}
  ...attributes
>
  <:actions>
    <Woven::Button
      @variant="subtle"
      @size="sm"
      {{on "click" @onRetry}}
      data-test-load-error-retry
    >
      {{if @retryLabel @retryLabel "Try again"}}
    </Woven::Button>
  </:actions>
</Woven::Alert>