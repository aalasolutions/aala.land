<Woven::Drawer
  @open={{@open}}
  @title={{if this.isEdit "Edit Work Order" "New Work Order"}}
  @placement="end"
  @size="lg"
  @onClose={{this.close}}
  @onClosed={{this.reset}}
>
  <:body>
    <form
      id="work-order-form"
      class="wu-form"
      novalidate
      {{this.loadOnOpen}}
      {{on "submit" this.save}}
    >
      <Woven::Field
        @label="Property"
        @required={{true}}
        @error={{this.fieldErrors.unitId}}
      >
        <Woven::Dropdown
          id="wo-unit"
          @align="start"
          @value={{this.form.unitId}}
          @onSelect={{fn this.setField "unitId"}}
          @options={{this.unitOptions}}
          @placeholder="Select a property..."
          data-test-wo-unit
        />
      </Woven::Field>

      <Woven::Field
        @label="Title"
        @required={{true}}
        @error={{this.fieldErrors.title}}
      >
        <Woven::Input
          id="wo-title"
          type="text"
          placeholder="e.g. Fix leaking pipe in property 302"
          @value={{this.form.title}}
          @onInput={{fn this.setField "title"}}
          required={{true}}
          data-test-wo-title
        />
      </Woven::Field>

      <Woven::Field
        @label="Description"
        @required={{true}}
        @error={{this.fieldErrors.description}}
      >
        <Woven::Textarea
          id="wo-desc"
          placeholder="Describe the issue in detail..."
          rows="3"
          @value={{this.form.description}}
          @onInput={{fn this.setField "description"}}
          required={{true}}
          data-test-wo-description
        />
      </Woven::Field>

      <div class="flex gap-4">
        <div class="grow">
          <Woven::Field @label="Priority">
            <Woven::Dropdown
              id="wo-priority"
              @align="start"
              @value={{this.form.priority}}
              @onSelect={{fn this.setField "priority"}}
              @options={{this.priorityOptions}}
              @placeholder="Select priority..."
              data-test-wo-priority
            />
          </Woven::Field>
        </div>
        <div class="grow">
          <Woven::Field @label="Category">
            <Woven::Dropdown
              id="wo-category"
              @align="start"
              @value={{this.form.category}}
              @onSelect={{fn this.setField "category"}}
              @options={{this.categoryOptions}}
              @placeholder="Select category..."
              data-test-wo-category
            />
          </Woven::Field>
        </div>
      </div>

      {{#if this.isEdit}}
        <Woven::Field @label="Status">
          <Woven::Dropdown
            id="wo-status"
            @align="start"
            @value={{this.form.status}}
            @onSelect={{fn this.setField "status"}}
            @options={{this.statusOptions}}
            @placeholder="Select status..."
            data-test-wo-status
          />
        </Woven::Field>
        {{#if this.isCancelling}}
          <Woven::Field
            @label="Cancellation Reason"
            @required={{true}}
            @error={{this.reasonError}}
          >
            <Woven::Textarea
              id="wo-cancel-reason"
              rows="2"
              maxlength="500"
              placeholder="e.g. Tenant resolved the issue"
              @value={{this.form.reason}}
              @onInput={{fn this.setField "reason"}}
              @invalid={{if this.reasonError true false}}
              aria-label="Reason"
              data-test-reason-input
            />
          </Woven::Field>
        {{/if}}
      {{/if}}

      {{#if this.isEdit}}
        <Woven::Field @label="Estimated Cost">
          <Woven::Input
            id="wo-est-cost"
            type="number"
            placeholder="e.g. 500"
            @value={{this.form.estimatedCost}}
            @onInput={{fn this.setField "estimatedCost"}}
            min="0"
            step="0.01"
            data-test-wo-est-cost
          />
        </Woven::Field>
      {{else}}
        <div class="flex gap-4">
          <div class="grow">
            <Woven::Field @label="Reported By">
              <Woven::Input
                id="wo-reported-by"
                type="text"
                placeholder="Tenant or staff name"
                @value={{this.form.reportedBy}}
                @onInput={{fn this.setField "reportedBy"}}
                data-test-wo-reported-by
              />
            </Woven::Field>
          </div>
          <div class="grow">
            <Woven::Field @label="Estimated Cost">
              <Woven::Input
                id="wo-est-cost"
                type="number"
                placeholder="e.g. 500"
                @value={{this.form.estimatedCost}}
                @onInput={{fn this.setField "estimatedCost"}}
                min="0"
                step="0.01"
                data-test-wo-est-cost
              />
            </Woven::Field>
          </div>
        </div>
      {{/if}}

      <div class="flex gap-4">
        <div class="grow">
          <Woven::Field @label="Actual Cost">
            <Woven::Input
              id="wo-act-cost"
              type="number"
              placeholder="e.g. 450"
              @value={{this.form.actualCost}}
              @onInput={{fn this.setField "actualCost"}}
              min="0"
              step="0.01"
              data-test-wo-act-cost
            />
          </Woven::Field>
        </div>
        <div class="grow">
          <Woven::Field @label="Cost Notes">
            <Woven::Input
              id="wo-cost-notes"
              type="text"
              placeholder="e.g. Parts + labor"
              @value={{this.form.costNotes}}
              @onInput={{fn this.setField "costNotes"}}
              data-test-wo-cost-notes
            />
          </Woven::Field>
        </div>
      </div>

      <div class="flex gap-4">
        <div class="grow min-w-0">
          <Woven::Field @label="Scheduled Date">
            <Woven::Input
              id="wo-scheduled"
              type="date"
              @value={{this.form.scheduledDate}}
              @onInput={{fn this.setField "scheduledDate"}}
              data-test-wo-scheduled
            />
          </Woven::Field>
        </div>
        <div class="grow min-w-0">
          <Woven::Field @label="Vendor">
            <Woven::Dropdown
              id="wo-vendor"
              @align="start"
              @value={{this.form.vendorId}}
              @onSelect={{fn this.setField "vendorId"}}
              @options={{this.vendorOptions}}
              @placeholder="No vendor assigned"
              data-test-wo-vendor
            />
          </Woven::Field>
        </div>
      </div>

      {{#if this.errorMsg}}
        <p class="text-sm text-danger" data-test-error>{{this.errorMsg}}</p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Woven::Button
      @variant="secondary"
      data-test-cancel-work-order
      {{on "click" this.close}}
    >
      Cancel
    </Woven::Button>
    <Woven::Button
      @variant="primary"
      @type="submit"
      form="work-order-form"
      @loading={{this.isSaving}}
      data-test-save-work-order
    >
      {{if this.isEdit "Update" "Create Work Order"}}
    </Woven::Button>
  </:footer>
</Woven::Drawer>