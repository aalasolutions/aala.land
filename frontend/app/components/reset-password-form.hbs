{{#if this.isSuccess}}
  <div
    data-test-reset-password-success
    class="flex col gap-5 w-full text-center"
  >
    <div class="flex col gap-2">
      <Ui::Ph @icon="check-circle" @size="48px" />
      <p class="text-sm text-muted">Password updated successfully.</p>
    </div>

    <p class="text-sm text-muted">
      Ready to continue?
      <LinkTo
        @route="login"
        class="text-primary"
        data-test-reset-password-login-link
      >
        Sign in
      </LinkTo>
    </p>
  </div>
{{else}}
  {{#if this.hasToken}}
    <form
      data-test-reset-password-form
      class="flex col gap-4 w-full"
      {{on "submit" this.submit}}
    >
      <Nuvo::Field @label="New Password" @required={{true}}>
        <Nuvo::Input
          id="reset-password"
          @type="password"
          @placeholder="Min 8 characters"
          @value={{this.password}}
          @autocomplete="new-password"
          @onInput={{fn this.updateField "password"}}
          required={{true}}
          data-test-reset-password-input
        />
      </Nuvo::Field>

      <Nuvo::Field @label="Confirm Password" @required={{true}}>
        <Nuvo::Input
          id="reset-password-confirm"
          @type="password"
          @placeholder="Repeat your password"
          @value={{this.confirmPassword}}
          @autocomplete="new-password"
          @onInput={{fn this.updateField "confirmPassword"}}
          required={{true}}
          data-test-reset-password-confirm-input
        />
      </Nuvo::Field>

      {{#if this.errorMessage}}
        <div
          data-test-reset-password-error
          class="p-3 rounded-lg bg-danger@10 border border-danger@20 text-danger text-center text-sm"
        >
          {{this.errorMessage}}
        </div>
      {{/if}}

      <Nuvo::Button
        @variant="primary"
        @type="submit"
        @text={{if this.isLoading "Updating Password..." "Update Password"}}
        @loading={{this.isLoading}}
        @disabled={{not this.canSubmit}}
        @size="lg"
        data-test-reset-password-submit
        class="w-full py-4 rounded-xl font-bold"
      />
    </form>
  {{else}}
    <div
      data-test-reset-password-token-error
      class="flex col gap-4 w-full text-center"
    >
      <p class="text-sm text-danger">Invalid reset link.</p>
      <LinkTo
        @route="login"
        class="text-primary"
        data-test-reset-password-login-link
      >
        Sign in
      </LinkTo>
    </div>
  {{/if}}
{{/if}}