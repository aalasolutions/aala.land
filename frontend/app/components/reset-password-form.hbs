{{#if this.isSuccess}}
  <div
    data-test-reset-password-success
    class="flex col gap-5 w-full text-center"
  >
    <div class="flex col gap-2">
      <Ui::Ph @icon="check-circle" @size="48px" />
      <p class="text-sm text-muted">Password updated successfully.</p>
    </div>

    <p class="text-sm text-muted">
      Ready to continue?
      <LinkTo
        @route="login"
        class="text-brand"
        data-test-reset-password-login-link
      >
        Sign in
      </LinkTo>
    </p>
  </div>
{{else}}
  {{#if this.hasToken}}
    <form
      data-test-reset-password-form
      class="wu-form w-full"
      novalidate
      {{on "submit" this.submit}}
    >
      <Woven::Field
        @label="New Password"
        @required={{true}}
        @error={{this.fieldErrors.password}}
      >
        <Woven::Input
          id="reset-password"
          @type="password"
          @placeholder="Min 8 characters"
          @value={{this.password}}
          @autocomplete="new-password"
          @onInput={{fn this.updateField "password"}}
          required={{true}}
          data-test-reset-password-input
        />
      </Woven::Field>

      <Woven::Field
        @label="Confirm Password"
        @required={{true}}
        @error={{this.fieldErrors.confirmPassword}}
        data-test-reset-password-confirm-field
      >
        <Woven::Input
          id="reset-password-confirm"
          @type="password"
          @placeholder="Repeat your password"
          @value={{this.confirmPassword}}
          @autocomplete="new-password"
          @onInput={{fn this.updateField "confirmPassword"}}
          required={{true}}
          data-test-reset-password-confirm-input
        />
      </Woven::Field>

      {{#if this.errorMessage}}
        <Woven::Alert
          @variant="danger"
          @description={{this.errorMessage}}
          data-test-reset-password-error
        />
      {{/if}}

      <Woven::Button
        @variant="primary"
        @type="submit"
        @text={{if this.isLoading "Updating Password..." "Update Password"}}
        @loading={{this.isLoading}}
        @disabled={{not this.canSubmit}}
        data-test-reset-password-submit
      />
    </form>
  {{else}}
    <div
      data-test-reset-password-token-error
      class="flex col gap-4 w-full text-center"
    >
      <Woven::Alert @variant="danger" @description="Invalid reset link." />
      <LinkTo
        @route="login"
        class="text-brand"
        data-test-reset-password-login-link
      >
        Sign in
      </LinkTo>
    </div>
  {{/if}}
{{/if}}