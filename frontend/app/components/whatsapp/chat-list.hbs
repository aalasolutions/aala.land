<div class="wa-chat-list">
  {{#each @chats as |chat|}}
    <button
      type="button"
      class="wa-chat-item {{if (eq @currentChatId chat.chatId) 'is-active'}}"
      data-test-wa-chat={{chat.chatId}}
      {{on "click" (fn @onSelect chat.chatId)}}
    >
      <Nuvo::Avatar
        @initials={{initials chat.chatName}}
        @size="lg"
        aria-hidden="true"
        data-test-wa-chat-avatar
      />
      <div class="wa-chat-body">
        <div class="flex between x-center">
          <span class="wa-chat-name">
            {{#if chat.isGroup}}
              <Nuvo::Tag @size="sm" @text="group" />
            {{/if}}
            {{chat.chatName}}
          </span>
          <span class="wa-chat-time">
            {{#let (this.windowFor chat) as |window|}}
              {{#if window}}
                <span
                  class="wa-chat-window
                    {{if window.open 'is-open' 'is-closed'}}"
                  data-tooltip={{window.tooltip}}
                  data-test-wa-chat-window={{if window.open "open" "closed"}}
                ><Ui::Ph @icon="clock" /></span>
              {{/if}}
            {{/let}}
            <span
              title={{format-date-time chat.lastTs}}
              data-test-wa-chat-time
            >{{format-chat-time chat.lastTs now=@now}}</span>
          </span>
        </div>
        <div class="wa-chat-preview-row">
          <p class="wa-chat-preview" dir="auto" data-test-wa-chat-preview>
            {{#if chat.lastFromMe}}You: {{/if}}{{chat.lastBody}}
          </p>
          {{#let (this.unreadCountFor chat.chatId) as |unreadCount|}}
            {{#if unreadCount}}
              <Nuvo::Badge
                class="wa-chat-unread"
                @count={{true}}
                @value={{unreadCount}}
                @max={{99}}
                data-test-wa-chat-unread
              />
            {{/if}}
          {{/let}}
        </div>
      </div>
    </button>
  {{else}}
    <Nuvo::EmptyState @title="No chats yet" />
  {{/each}}
</div>