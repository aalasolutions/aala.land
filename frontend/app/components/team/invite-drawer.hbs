<Woven::Drawer
  @open={{@open}}
  @title="Invite Team Member"
  @placement="end"
  @size="lg"
  @onClose={{this.close}}
  @onClosed={{this.reset}}
>
  <:body>
    <p class="text-muted text-sm">Send an invitation with a temporary password.
      The new member will receive login credentials.</p>
    <SeatNote @seatInfo={{@seatInfo}} />
    <form
      id="team-invite-form"
      class="wu-form"
      novalidate
      {{on "submit" this.send}}
    >
      <div class="flex gap-4">
        <Woven::Field
          class="grow"
          @label="First Name"
          @required={{true}}
          @error={{this.fieldErrors.inviteFirstName}}
        >
          <Woven::Input
            id="i-fname"
            type="text"
            placeholder="e.g. Jane"
            @value={{this.form.inviteFirstName}}
            @onInput={{fn this.setField "inviteFirstName"}}
            data-test-invite-first
          />
        </Woven::Field>
        <Woven::Field
          class="grow"
          @label="Last Name"
          @required={{true}}
          @error={{this.fieldErrors.inviteLastName}}
        >
          <Woven::Input
            id="i-lname"
            type="text"
            placeholder="e.g. Smith"
            @value={{this.form.inviteLastName}}
            @onInput={{fn this.setField "inviteLastName"}}
            data-test-invite-last
          />
        </Woven::Field>
      </div>

      <Woven::Field
        @label="Email"
        @required={{true}}
        @error={{this.fieldErrors.inviteEmail}}
      >
        <Woven::Input
          id="i-email"
          type="email"
          placeholder="e.g. jane@company.com"
          @value={{this.form.inviteEmail}}
          @onInput={{fn this.setField "inviteEmail"}}
          data-test-invite-email
        />
      </Woven::Field>

      <Woven::Field
        @label="Role"
        @tooltip="What this person can do. Company admins manage billing, team and settings. Agents work only on their own records."
      >
        <Woven::Dropdown
          id="i-role"
          @align="start"
          @value={{this.form.inviteRole}}
          @onSelect={{fn this.setField "inviteRole"}}
          @options={{this.roles}}
          @placeholder="Select role..."
          data-test-invite-role
        />
      </Woven::Field>

      {{#if this.errorMsg}}
        <p
          class="text-sm text-danger"
          data-test-invite-error
        >{{this.errorMsg}}</p>
        {{#if this.existingUser}}
          <Woven::Button
            @variant="secondary"
            @size="xs"
            @disabled={{@isReactivating}}
            data-test-invite-reactivate
            {{on "click" this.reactivateExisting}}
          >
            {{if
              @isReactivating
              "Reactivating..."
              "Reactivate this user instead"
            }}
          </Woven::Button>
        {{/if}}
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Woven::Button
      @variant="secondary"
      data-test-cancel-invite
      {{on "click" this.close}}
    >Cancel</Woven::Button>
    <Woven::Button
      @variant="primary"
      @type="submit"
      form="team-invite-form"
      @disabled={{or this.isInviting @isReactivating}}
      @loading={{this.isInviting}}
      data-test-send-invite
    >{{if this.isInviting "Sending..." "Send Invitation"}}</Woven::Button>
  </:footer>
</Woven::Drawer>