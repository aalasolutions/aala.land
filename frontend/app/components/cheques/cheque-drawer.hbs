<Woven::Drawer
  @open={{@open}}
  @title={{if this.isEdit "Edit Cheque" "New Cheque"}}
  @placement="end"
  @size="lg"
  @onClose={{this.close}}
  @onClosed={{this.reset}}
>
  <:body>
    <form
      id="cheque-form"
      class="wu-form"
      novalidate
      {{this.loadOnOpen}}
      {{on "submit" this.save}}
    >
      <div class="flex gap-4">
        <Woven::Field
          @label="Cheque Number"
          @required={{true}}
          @error={{this.fieldErrors.chequeNumber}}
          class="grow"
        >
          <Woven::Input
            id="chq-number"
            type="text"
            placeholder="e.g. 000123"
            @value={{this.form.chequeNumber}}
            @onInput={{fn this.setField "chequeNumber"}}
            data-test-input-cheque-number
          />
        </Woven::Field>
        <Woven::Field @label="Type" class="grow">
          <Woven::Dropdown
            id="chq-type"
            @align="start"
            @value={{this.form.type}}
            @onSelect={{fn this.setField "type"}}
            @options={{this.chequeTypeOptions}}
            @placeholder="Select type..."
            data-test-input-type
          />
        </Woven::Field>
      </div>
      <Woven::Field
        @label="Bank Name"
        @required={{true}}
        @error={{this.fieldErrors.bankName}}
      >
        <Woven::Input
          id="chq-bank"
          type="text"
          placeholder="e.g. Emirates NBD"
          @value={{this.form.bankName}}
          @onInput={{fn this.setField "bankName"}}
          data-test-input-bank
        />
      </Woven::Field>
      <Woven::Field
        @label="Account Holder"
        @required={{true}}
        @error={{this.fieldErrors.accountHolder}}
      >
        <Woven::Input
          id="chq-holder"
          type="text"
          placeholder="e.g. Ahmed Al Mansouri"
          @value={{this.form.accountHolder}}
          @onInput={{fn this.setField "accountHolder"}}
          data-test-input-holder
        />
      </Woven::Field>
      <Woven::Field @label="Property">
        <Woven::Dropdown
          id="chq-unit"
          @align="start"
          @value={{this.form.unitId}}
          @onSelect={{fn this.setField "unitId"}}
          @options={{this.unitOptions}}
          @placeholder="No property linked"
          data-test-input-unit
        />
      </Woven::Field>
      <div class="flex gap-4">
        <Woven::Field
          @label="Amount"
          @required={{true}}
          @error={{this.fieldErrors.amount}}
          class="grow"
        >
          <Woven::Input
            id="chq-amount"
            type="number"
            min="0"
            step="0.01"
            placeholder="e.g. 8500"
            @value={{this.form.amount}}
            @onInput={{fn this.setField "amount"}}
            data-test-input-amount
          />
        </Woven::Field>
        <Woven::Field
          @label="Due Date"
          @required={{true}}
          @error={{this.fieldErrors.dueDate}}
          class="grow"
        >
          <input
            id="chq-due"
            type="date"
            class="wu-input"
            value={{this.form.dueDate}}
            data-test-input-due-date
            {{on "input" (fn this.setFieldFromEvent "dueDate")}}
          />
        </Woven::Field>
      </div>
      {{#if this.errorMsg}}
        <p class="text-sm text-danger" data-test-error>{{this.errorMsg}}</p>
      {{/if}}
    </form>
  </:body>
  <:footer>
    <Woven::Button
      @variant="secondary"
      data-test-cancel-edit
      @onClick={{this.close}}
    >Cancel</Woven::Button>
    <Woven::Button
      @variant="primary"
      @type="submit"
      form="cheque-form"
      @loading={{this.isSaving}}
      data-test-save-cheque
    >{{if this.isEdit "Update" "Create Cheque"}}</Woven::Button>
  </:footer>
</Woven::Drawer>