# AALA.LAND backend environment
# Uncommented keys are required. Commented keys are optional and show their default.
# Sections follow the deploy order: stack, database, cache, auth, storage, WhatsApp, AI, email, billing.

# ---------------------------------------------------------------------------
# Stack and ports
# ---------------------------------------------------------------------------
# PORT is the port inside the container (nginx proxies to backend:3010, keep 3010).
# BACKEND_HOST_PORT is the port published on the host; compose maps "${BACKEND_HOST_PORT:-3010}:${PORT:-3010}".
PORT=3010
BACKEND_HOST_PORT=3010
NODE_ENV=production
# STACK_NAME namespaces project, containers, network and volumes. Unset means prod (aala-land).
# Set it on a second stack on the same host (staging) and give that stack free host ports.
# STACK_NAME=aala-staging
# API docs at /docs; always on when NODE_ENV is not production.
# ENABLE_SWAGGER=false

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Docker deploy targets below. Local host dev (pnpm start:dev): DB_HOST=localhost DB_PORT=5480.
# Run `pnpm run db:migration:run` before starting against a new or empty database.
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_DATABASE=aala_land
# Postgres host port (default 5480); set a free one on staging.
# DB_HOST_PORT=5481
# TypeORM synchronize. Keep false: the schema comes from migrations only.
# DB_SYNC=false

# ---------------------------------------------------------------------------
# Valkey (BullMQ and caching, Redis-compatible)
# ---------------------------------------------------------------------------
# Docker deploy targets below. Local host dev: REDIS_HOST=localhost REDIS_PORT=6470.
REDIS_HOST=valkey
REDIS_PORT=6379
# Valkey host port (default 6470); set a free one on staging.
# REDIS_HOST_PORT=6471
# Set when Valkey requires auth (--requirepass). Unset means no auth.
# REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Auth, CORS and links
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_MINIMUM_64_CHARS_RANDOM_STRING
# Access token lifetime (e.g. 1d, 24h). Unset means 24h.
JWT_EXPIRES_IN=1d
# Web client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Comma-separated allowed origins, e.g. https://app.aala.land,https://admin.aala.land
CORS_ORIGIN=https://app.aala.land
# Used in invite emails and other transactional links.
APP_URL=http://localhost:4200

# ---------------------------------------------------------------------------
# Storage (S3-compatible). One key pair per bucket, no fallbacks.
# ---------------------------------------------------------------------------
S3_ENDPOINT=CHANGE_ME
AWS_REGION=ap-south-1
# Public bucket: property photos and thumbnails only. Key scoped to this bucket.
AWS_S3_BUCKET=aala-land-media
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# Private bucket: documents only (leases, ID copies, title deeds). Must NOT be public-read.
# Document upload and download throw until both keys are set.
AWS_S3_DOCUMENTS_BUCKET=aala-land-documents
AWS_DOCUMENTS_ACCESS_KEY_ID=CHANGE_ME
AWS_DOCUMENTS_SECRET_ACCESS_KEY=CHANGE_ME
# Private bucket: WhatsApp media, served only by short-lived signed URLs. Must NOT be public-read.
# Set the bucket lifecycle to keep only the last version of each file.
AWS_S3_WHATSAPP_BUCKET=aala-land-whatsapp
AWS_WHATSAPP_ACCESS_KEY_ID=CHANGE_ME
AWS_WHATSAPP_SECRET_ACCESS_KEY=CHANGE_ME

# ---------------------------------------------------------------------------
# WhatsApp (Meta Cloud API)
# ---------------------------------------------------------------------------
# Webhook GET handshake token; the webhook answers 403 to everything while unset.
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
# Meta app secret for webhook HMAC validation; fails closed while unset.
WHATSAPP_APP_SECRET=CHANGE_ME
# Public by design: the browser needs it for Embedded Signup; unset only disables Connect.
WHATSAPP_APP_ID=CHANGE_ME
# FB Login for Business config id; needs whatsapp_business_* and business_management permissions.
WHATSAPP_ES_CONFIG_ID=CHANGE_ME
# 32-byte base64 AES-256-GCM key. Changing it orphans every stored token; agents must reconnect.
WHATSAPP_TOKEN_ENC_KEY=CHANGE_ME
# Optional timings and limits.
# WHATSAPP_SEND_TIMEOUT_MS=15000
# WHATSAPP_MEDIA_UPLOAD_TIMEOUT_MS=120000
# WHATSAPP_MEDIA_URL_TTL_SECONDS=600
# WHATSAPP_MEDIA_CONCURRENCY=3

# ---------------------------------------------------------------------------
# AI auto-reply (any OpenAI-compatible chat completions endpoint)
# ---------------------------------------------------------------------------
AI_BASE_URL=https://your-llm-host/v1  # base URL of an OpenAI-compatible chat completions endpoint, required
AI_API_KEY=your-api-key-here  # bearer key for that API; unset disables AI replies
AI_MODEL=your-model-name  # model name sent with every request, required
# Optional tuning; defaults shown.
# AI_ENABLED=true  # default AI switch for a company that never saved one
# AI_TEMPERATURE=0.7  # sampling temperature
# AI_TOP_P=0.9  # nucleus sampling
# AI_MAX_TOKENS=2048  # reply token cap per request
# AI_MAX_TOKENS_FIELD=max_tokens  # request field for that cap: max_tokens or max_completion_tokens
# AI_PROVIDER_PROFILE=openai-compatible  # request shape: openai-compatible, gemma-vllm, anthropic-openai-compat or mistral
# AI_EXTRA_BODY={}  # JSON object added to every request; only the profile's allowed keys are kept, others are dropped with a startup warning
# AI_RETRY_FREQUENCY_PENALTY=0.5  # frequency_penalty on the one retry after an empty reply; 0 sends none
# AI_REQUEST_TIMEOUT_MS=300000  # timeout of one request
# AI_TOTAL_BUDGET_MS=120000  # deadline for a whole turn, retries and tool calls included
# AI_HELD_CHECK_TIMEOUT_MS=60000  # wait for the held-message classification on paused, opted-out and staff-window chats
# AI_GATE_CHECK_TIMEOUT_MS=45000  # wait for the classification that runs beside the reply on a normal chat
# AI_CLASSIFIER_MAX_TOKENS=96  # max tokens of one classification call
# AI_HOLDING_REPLY_AFTER_MIN=120  # minutes paused without a staff reply before one fixed holding line is sent
# AI_ESCALATION_REMINDER_AFTER_MIN=1440  # minutes before one second staff notification for an unanswered escalation
# AI_MAX_RETRIES=2  # retries of a request after HTTP 429/5xx or a network error
# AI_MAX_STEPS=4  # model calls per turn; the last one is sent without tools
# AI_MAX_TOOL_CALLS=6  # tool calls run per turn; extra calls are answered "Not run"
# AI_MAX_CARDS=10  # most listing cards code appends to one reply
# AI_DEBOUNCE_MS=10000  # quiet time before buffered customer messages are answered together
# AI_DEBOUNCE_MAX_MS=60000  # longest wait from the first buffered message
# AI_PENDING_MAX=20  # most buffered messages per chat
# AI_LOCK_TTL_MS=30000  # per-chat turn lock lifetime
# AI_LOCK_WAIT_MS=20000  # wait for a busy chat lock
# AI_HUMAN_SILENCE_MINUTES=20  # AI stays silent this long after a team member replies
# AI_MESSAGE_MAX_AGE_S=86400  # older inbound messages are not answered; capped at the 24 h reply window
# AI_MESSAGE_MAX_CHARS=4000  # customer messages are cut to this length
# AI_LATE_MESSAGE_S=120  # a message delivered this late, behind newer ones waiting for a turn, is kept as context and not answered
# AI_TURN_MAX_CHARS=8000  # the merged customer messages of one turn keep head and tail within this; never above half of AI_HISTORY_MAX_CHARS
# AI_HISTORY_LIMIT=80  # most messages kept in AI history
# AI_HISTORY_MAX_CHARS=64000  # most characters kept in AI history and sent per request
# AI_HISTORY_KEEP_STAFF=10  # newest staff lines the history trim always keeps
# AI_EVENTS_KEEP_STAFF=30  # staff lines held between turns, newest kept
# AI_EVENTS_KEEP_CUSTOMER=30  # unanswered customer lines held between turns, newest kept
# AI_HISTORY_SEED_LIMIT=20  # messages read from the store when history has expired; 0 disables
# AI_HISTORY_SEED_MAX_CHARS=8000  # character cap of that rebuilt history

# ---------------------------------------------------------------------------
# Email (SendGrid first, SMTP as the fallback)
# ---------------------------------------------------------------------------
# Display name on all outgoing mail, both transports.
MAIL_FROM_NAME=AALA.LAND
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@aala.land
# SMTP is used only when SendGrid is not configured.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@aala.land

# ---------------------------------------------------------------------------
# Cheque OCR
# ---------------------------------------------------------------------------
# Unset returns empty OCR data with a logged warning.
OCR_API_KEY=

# ---------------------------------------------------------------------------
# Billing (provider-agnostic)
# ---------------------------------------------------------------------------
BILLING_PROVIDER=paddle
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret. Local dev: printed by `stripe listen`. Production: Stripe Dashboard webhook config.
STRIPE_WEBHOOK_SECRET=whsec_...

# Paddle. sandbox or production; keys from Developer tools > Authentication.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
# Client-side token for Paddle.js checkout; safe to expose to the browser.
PADDLE_CLIENT_TOKEN=
# Optional full URL of the checkout page on the Paddle-approved domain; unset uses <app origin>/checkout.
PADDLE_CHECKOUT_URL=
# Secret key of the notification destination that posts to /v1/billing/webhook.
PADDLE_WEBHOOK_SECRET=
