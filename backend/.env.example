# AALA.LAND backend environment
# Uncommented keys are required. Commented keys are optional and show their default.
# Sections follow the deploy order: stack, database, cache, auth, storage, WhatsApp, AI, email, billing.

# ---------------------------------------------------------------------------
# Stack and ports
# ---------------------------------------------------------------------------
# PORT is the port inside the container (nginx proxies to backend:3010, keep 3010).
# BACKEND_HOST_PORT is the port published on the host; compose maps "${BACKEND_HOST_PORT:-3010}:${PORT:-3010}".
PORT=3010
BACKEND_HOST_PORT=3010
NODE_ENV=production
# STACK_NAME namespaces project, containers, network and volumes. Unset means prod (aala-land).
# Set it on a second stack on the same host (staging) and give that stack free host ports.
# STACK_NAME=aala-staging
# API docs at /docs; always on when NODE_ENV is not production.
# ENABLE_SWAGGER=false

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Docker deploy targets below. Local host dev (pnpm start:dev): DB_HOST=localhost DB_PORT=5480.
# Run `pnpm run db:migration:run` before starting against a new or empty database.
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_DATABASE=aala_land
# Postgres host port (default 5480); set a free one on staging.
# DB_HOST_PORT=5481
# TypeORM synchronize. Keep false: the schema comes from migrations only.
# DB_SYNC=false

# ---------------------------------------------------------------------------
# Valkey (BullMQ and caching, Redis-compatible)
# ---------------------------------------------------------------------------
# Docker deploy targets below. Local host dev: REDIS_HOST=localhost REDIS_PORT=6470.
REDIS_HOST=valkey
REDIS_PORT=6379
# Valkey host port (default 6470); set a free one on staging.
# REDIS_HOST_PORT=6471
# Set when Valkey requires auth (--requirepass). Unset means no auth.
# REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Auth, CORS and links
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_MINIMUM_64_CHARS_RANDOM_STRING
# Access token lifetime (e.g. 1d, 24h). Unset means 24h.
JWT_EXPIRES_IN=1d
# Web client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Comma-separated allowed origins, e.g. https://app.aala.land,https://admin.aala.land
CORS_ORIGIN=https://app.aala.land
# Used in invite emails and other transactional links.
APP_URL=http://localhost:4200

# ---------------------------------------------------------------------------
# Storage (S3-compatible, Backblaze B2). One key pair per bucket, no fallbacks.
# ---------------------------------------------------------------------------
S3_ENDPOINT=CHANGE_ME
AWS_REGION=ap-south-1
# Public bucket: property photos and thumbnails only. Key scoped to this bucket.
AWS_S3_BUCKET=aala-land-media
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# Private bucket: documents only (leases, ID copies, title deeds). Must NOT be public-read.
# Document upload and download throw until both keys are set.
AWS_S3_DOCUMENTS_BUCKET=aala-land-documents
AWS_DOCUMENTS_ACCESS_KEY_ID=CHANGE_ME
AWS_DOCUMENTS_SECRET_ACCESS_KEY=CHANGE_ME
# Private bucket: WhatsApp media, served only by short-lived signed URLs. Must NOT be public-read.
# Set the bucket lifecycle to keep only the last version of each file.
AWS_S3_WHATSAPP_BUCKET=aala-land-whatsapp
AWS_WHATSAPP_ACCESS_KEY_ID=CHANGE_ME
AWS_WHATSAPP_SECRET_ACCESS_KEY=CHANGE_ME

# ---------------------------------------------------------------------------
# WhatsApp (Meta Cloud API)
# ---------------------------------------------------------------------------
# Webhook GET handshake token; the webhook answers 403 to everything while unset.
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
# Meta app secret for webhook HMAC validation; fails closed while unset.
WHATSAPP_APP_SECRET=CHANGE_ME
# Public by design: the browser needs it for Embedded Signup; unset only disables Connect.
WHATSAPP_APP_ID=CHANGE_ME
# FB Login for Business config id; needs whatsapp_business_* and business_management permissions.
WHATSAPP_ES_CONFIG_ID=CHANGE_ME
# 32-byte base64 AES-256-GCM key. Changing it orphans every stored token; agents must reconnect.
WHATSAPP_TOKEN_ENC_KEY=CHANGE_ME
# Optional timings and limits.
# WHATSAPP_SEND_TIMEOUT_MS=15000
# WHATSAPP_MEDIA_UPLOAD_TIMEOUT_MS=120000
# WHATSAPP_MEDIA_URL_TTL_SECONDS=600
# WHATSAPP_MEDIA_CONCURRENCY=3

# ---------------------------------------------------------------------------
# AI auto-reply (OpenAI-compatible endpoint: Ollama, OpenAI, ...)
# ---------------------------------------------------------------------------
OLLAMA_HOST=https://your-llm-host/v1
OLLAMA_API_KEY=your-api-key-here
OLLAMA_MODEL=your-model-name
# Optional tuning; defaults shown.
# AI_ENABLED=true
# AI_TEMPERATURE=0.7
# AI_TOP_P=0.9
# AI_REQUEST_TIMEOUT_MS=300000
# AI_TOTAL_BUDGET_MS=120000
# AI_MAX_RETRIES=2
# AI_DEBOUNCE_MS=10000
# AI_DEBOUNCE_MAX_MS=60000
# AI_PENDING_MAX=20
# AI_LOCK_TTL_MS=30000
# AI_LOCK_WAIT_MS=20000
# AI_HUMAN_SILENCE_MINUTES=20
# AI_MESSAGE_MAX_AGE_S=120
# AI_MESSAGE_MAX_CHARS=4000
# AI_HISTORY_LIMIT=40
# AI_HISTORY_SEED_LIMIT=20
# AI_HISTORY_SEED_MAX_CHARS=8000

# ---------------------------------------------------------------------------
# Email (SendGrid first, SMTP as the fallback)
# ---------------------------------------------------------------------------
# Display name on all outgoing mail, both transports.
MAIL_FROM_NAME=AALA.LAND
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@aala.land
# SMTP is used only when SendGrid is not configured.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@aala.land

# ---------------------------------------------------------------------------
# Cheque OCR
# ---------------------------------------------------------------------------
# Unset returns empty OCR data with a logged warning.
OCR_API_KEY=

# ---------------------------------------------------------------------------
# Billing (provider-agnostic; only the Stripe adapter exists today)
# ---------------------------------------------------------------------------
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret. Local dev: printed by `stripe listen`. Production: Stripe Dashboard webhook config.
STRIPE_WEBHOOK_SECRET=whsec_...
